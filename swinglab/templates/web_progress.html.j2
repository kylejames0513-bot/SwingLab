{% extends "web_layout.html.j2" %}
{% block title %}{{ brand.name }} — Progress{% endblock %}
{% block style %}
  {# The densest instrument in the app: one ruled panel per metric, each with
     a chart in a well and four measured values in a bordered grid. Nothing
     here is decoration — every amber string on this page is a number the
     engine produced. #}
  main { max-width: 980px; }
  {# The shell sets .hint at 0.88rem, which is off the type scale. Pull it
     onto the nearest rung for this page rather than inventing a size. #}
  main .hint { font-size: var(--sl-text-sm); }

  /* ------------------------------------------------------------- masthead
     A nameplate, not a landing hero: left-ruled, the title on the display
     face, everything under it measured. Centred text reads as marketing;
     this page is a readout. */
  .lead {
    max-width: none;
    margin: 0 0 var(--sl-space-6);
    padding-bottom: var(--sl-space-5);
    border-bottom: 1px solid var(--sl-border);
    text-align: left;
  }
  .lead h1 {
    margin: 0;
    color: var(--sl-green);
    font-family: var(--sl-font-display);
    font-size: var(--sl-heading-display);
    line-height: 0.98;
    letter-spacing: -0.02em;
    text-transform: uppercase;
  }
  .lead .hint { max-width: 68ch; margin: var(--sl-space-3) 0 0; }
  /* The generated trend sentence is this page's one spoken verdict, so it
     gets a well of its own instead of sitting in the paragraph flow. */
  .sentence {
    max-width: 68ch;
    margin: var(--sl-space-4) 0 0;
    padding: var(--sl-space-3) var(--sl-space-4);
    border: 1px solid var(--sl-border);
    border-left: 2px solid var(--sl-border-strong);
    border-radius: var(--sl-radius-sm);
    background: var(--sl-night);
    color: var(--sl-ink);
    font-size: var(--sl-text-sm);
    text-align: left;
  }
  .context {
    max-width: 68ch;
    margin: var(--sl-space-3) 0 0;
    color: var(--sl-ink-soft);
    font-size: var(--sl-text-sm);
    text-align: left;
  }
  .context strong {
    color: var(--sl-ink);
    font-family: var(--sl-font-mono);
    font-weight: 500;
  }

  /* ---------------------------------------------------------- club filter
     A segmented control drawn as a 1px-gap strip: one hairline frame with
     the rules BETWEEN the options, so the filter reads as a single
     instrument rather than a row of loose pills. */
  .club-filter {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-start;
    gap: 1px;
    margin: 0 0 var(--sl-space-6);
    padding: 1px;
    background: var(--sl-border);
    border: 1px solid var(--sl-border);
    border-radius: var(--sl-radius-sm);
  }
  .club-filter a {
    /* 44px minimum: this is the one control on the page a thumb uses. */
    min-height: 44px;
    flex: 1 1 auto;
    padding: 0 var(--sl-space-4);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 0;
    border-radius: 0;
    background: var(--sl-bg-card);
    color: var(--sl-ink-soft);
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-xs);
    letter-spacing: var(--sl-eyebrow-track);
    text-transform: uppercase;
    text-decoration: none;
  }
  .club-filter a:hover {
    background: rgba(var(--sl-wash-rgb), .06);
    color: var(--sl-ink);
  }
  /* The selected club is a filled bone chip with field-dark ink. It was
     var(--sl-green) with `color: white`, which after the inversion is bone
     on bone at 1.06:1 — an invisible label on the only stateful control
     here. */
  .club-filter a.active {
    background: var(--sl-green-btn);
    color: var(--sl-green-ink);
    font-weight: 500;
  }

  /* ------------------------------------------------------------ the proof
     The verified verdict in panel language: hairline frame, mono kicker,
     and the amber wash held back for the one state that needs attention. */
  .proof-note {
    margin: 0 0 var(--sl-space-6);
    padding: var(--sl-space-4) var(--sl-space-5);
    border: 1px solid var(--sl-border);
    border-radius: var(--sl-radius-md);
    background: var(--sl-bg-card);
    box-shadow: var(--sl-shadow-sm);
  }
  .proof-note[data-proof-state="attention"] {
    border-color: rgba(var(--sl-accent-rgb), .34);
    background: var(--sl-orange-soft);
  }
  .proof-note h2 {
    margin: var(--sl-space-2) 0;
    color: var(--sl-green);
    font-family: var(--sl-font-display);
    font-size: var(--sl-text-xl);
    text-transform: uppercase;
  }
  .proof-note p {
    margin: var(--sl-space-2) 0 0;
    color: var(--sl-ink-soft);
    font-size: var(--sl-text-sm);
  }
  .proof-note p strong { color: var(--sl-ink); }
  /* Scoped to .proof-note deliberately. `.proof-kicker` alone is (0,1,0) and
     loses to the `.proof-note p` above it at (0,1,1), so the kicker has been
     rendering as ordinary soft body copy — the eyebrow never got its mono,
     its tracking, or its colour. Same eyebrow treatment the shell's
     .sl-eyebrow uses, on the same amber-as-small-text rung. */
  .proof-note .proof-kicker {
    margin: 0;
    color: var(--sl-orange-text);
    font-family: var(--sl-font-mono);
    font-size: var(--sl-eyebrow-size);
    font-weight: 500;
    letter-spacing: var(--sl-eyebrow-track);
    text-transform: uppercase;
  }
  /* The measured pair (baseline -> latest accepted re-film) is the loudest
     number on the page and both halves are engine measurements, so amber
     mono. Scoped like .proof-kicker: bare .proof-pair at (0,1,0) would lose
     to `.proof-note p` at (0,1,1). */
  .proof-note .proof-pair {
    margin: var(--sl-space-2) 0 0;
    color: var(--sl-orange-text);
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-xl);
    font-weight: 500;
    line-height: 1.2;
  }
  .proof-note .proof-pair .arrow { color: var(--sl-ink-muted); }
  /* N of M confirmations: N is measured, M is persisted policy — the
     numbers carry the amber; the connective copy stays chrome. */
  .proof-note .proof-count {
    margin: var(--sl-space-1) 0 0;
    color: var(--sl-ink-soft);
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-xs);
    letter-spacing: var(--sl-eyebrow-track);
    text-transform: uppercase;
  }
  .proof-note .proof-count b {
    color: var(--sl-orange-text);
    font-weight: 500;
  }

  /* ------------------------------------------------------ the stat strip
     1c's four instrument tiles and 1d's four-cell grid are the same DOM:
     the same 1px-gap bordered grid the per-metric stats use, standalone.
     Rendered only for an exact matched context (club + hand + angle
     pinned), because "matched sessions" is a claim, not a caption. */
  .stat-strip {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    margin: 0 0 var(--sl-space-6);
    background: var(--sl-border);
    border: 1px solid var(--sl-border);
    border-radius: var(--sl-radius-sm);
    overflow: hidden;
  }
  @media (min-width: 750px) {
    .stat-strip { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }
  /* The tile sub-line is context, not a measurement — never amber. */
  .stat .s {
    display: block;
    margin-top: var(--sl-space-1);
    color: var(--sl-ink-muted);
    font-size: var(--sl-text-xs);
  }

  /* ----------------------------------------------------------- the panels */
  .metric-card {
    margin: 0 0 var(--sl-space-4);
    padding: clamp(16px, 2.4vw, 24px);
    border: 1px solid var(--sl-border);
    border-radius: var(--sl-radius-lg);
    background: var(--sl-bg-card);
    box-shadow: var(--sl-shadow-sm);
  }
  .metric-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--sl-space-2);
    flex-wrap: wrap;
    padding-bottom: var(--sl-space-3);
    border-bottom: 1px solid var(--sl-border);
  }
  .metric-head h2 {
    margin: 0;
    color: var(--sl-green);
    font-family: var(--sl-font-display);
    font-size: var(--sl-text-lg);
    text-transform: uppercase;
  }
  /* The benchmark line quotes a measured threshold, so it is amber mono —
     the same rule the storefront readout grid follows. */
  .bench {
    color: var(--sl-orange-text);
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-xs);
  }

  /* The chart is an EVIDENCE TILE — the field under the 115deg hatch, the
     same object the report's clip thumbnails and the drill diagrams are. It
     had been a well on --sl-night, which is the paper recess now, and it was
     still declaring `background-size: 16px 16px, 16px 16px, auto` for a grid
     image that no longer existed: three layer sizes against no layers. */
  .trend-svg {
    width: 100%;
    height: auto;
    display: block;
    margin: var(--sl-space-4) 0;
    border: 1px solid var(--sl-border-strong);
    border-radius: var(--sl-radius-sm);
    background-color: var(--sl-field);
    background-image: var(--sl-hatch);
  }
  /* The 320x120 viewBox scales to whatever width it is given, so a full-width
     panel renders a ~340px-tall chart and pushes the numbers out of the same
     glance. Capping the width keeps chart and stats readable together, which
     is the only reason a dashboard exists. */
  @media (min-width: 560px) {
    .trend-svg { max-width: 620px; }
  }
  /* The chart is server-rendered by swinglab/diagrams.py with brand colours
     baked into presentation attributes: brand primary for the trend line and
     the in-spec dots, brand accent for the flag band and the dots that
     crossed it. Brand primary is a dark green that lands at ~1.6:1 on this
     panel, so the inversion left the line carrying the entire chart
     effectively invisible.

     Presentation attributes lose to any CSS rule, so the chart is re-inked
     here rather than in the generator — which also feeds the emailed digest
     and the report, neither of which is on this field.

     The flagged dots are matched by the exact string the generator wrote,
     interpolated from the same brand dict it reads, so the selector cannot
     drift from the markup the way a copied literal would. */
  /* Re-inked for the FIELD. The chart is a measured object on a dark ground,
     so it follows the field's rule: the trend line and its in-spec dots are
     paper, and the benchmark band is the trace — the live mark the sessions
     are being read against. The signal is 3.00:1 here and would sink. */
  .trend-svg polyline { stroke: var(--sl-field-ink); stroke-width: 2; }
  .trend-svg line { stroke: var(--sl-trace); opacity: .75; }
  .trend-svg circle { fill: var(--sl-field-ink); }
  .trend-svg rect { fill: var(--sl-trace); opacity: .12; }
  /* A session that crossed the benchmark. Matched by the exact string the
     generator wrote, interpolated from the same brand dict it reads, so the
     selector cannot drift from the markup the way a copied literal would. */
  .trend-svg circle[fill="{{ brand.accent_color }}"] { fill: var(--sl-trace); }
  /* The noise-floor band: baseline ± the exact MDE the proof engine used,
     drawn only on the active target's chart. It is a measured bound on the
     FIELD, so it follows the field's rule — field ink, not the trace the
     benchmark band already means. Attribute-matched at (0,1,1) so the bare
     `rect` re-ink above cannot claim it. */
  .trend-svg rect[data-band="noise"] {
    fill: var(--sl-field-ink);
    opacity: .12;
  }

  /* Session ordinals under the headline chart — spec labels, mono chrome,
     capped to the same width as the chart they index. */
  .chart-axis--positioned { position: relative; height: 1.1rem; display: block; }
    .chart-axis--positioned span { position: absolute; top: 0; }
    .chart-axis {
    display: flex;
    justify-content: space-between;
    margin: calc(-1 * var(--sl-space-3)) 0 var(--sl-space-2);
    padding: 0 4px;
    color: var(--sl-ink-muted);
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-xs);
  }
  @media (min-width: 560px) {
    .chart-axis { max-width: 620px; }
  }
  /* Legend: each swatch is a chip of the field carrying the mark exactly as
     the chart draws it, because the marks are field-side colours a paper
     swatch could not show. A row renders only when its mark actually
     exists in the SVG. */
  .chart-legend {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sl-space-2) var(--sl-space-4);
    margin: 0 0 var(--sl-space-2);
  }
  .chart-legend .lg {
    display: inline-flex;
    align-items: center;
    gap: var(--sl-space-2);
    color: var(--sl-ink-soft);
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-xs);
    letter-spacing: var(--sl-eyebrow-track);
    text-transform: uppercase;
  }
  .chart-legend .sw {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 18px;
    height: 12px;
    background: var(--sl-field);
    border: 1px solid var(--sl-border-strong);
  }
  .chart-legend .sw > span { display: block; }
  /* Mirrors the SVG's session dot, band rect, and dashed pass-mark line. */
  .chart-legend .sw-measure > span {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--sl-field-ink);
  }
  .chart-legend .sw-band > span {
    width: 12px;
    height: 6px;
    background: rgba(var(--sl-cream-rgb), .25);
  }
  .chart-legend .sw-pass > span {
    width: 12px;
    border-top: 1px dashed var(--sl-trace);
  }
  /* Non-headline panels compact their charts so the page reads as one full
     instrument plus supporting meters — same data, tighter drawing. */
  @media (min-width: 560px) {
    .metric-card--compact .trend-svg { max-width: 460px; }
  }

  /* A 1px-gap bordered grid: the rules between cells are the container's
     background showing through. Two columns on a phone, four once there is
     room — the old 480px stop is not a breakpoint this system has. */
  .stats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    margin-top: var(--sl-space-4);
    background: var(--sl-border);
    border: 1px solid var(--sl-border);
    border-radius: var(--sl-radius-sm);
    overflow: hidden;
  }
  @media (min-width: 560px) {
    .stats { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }
  .stat { padding: var(--sl-space-3); background: var(--sl-bg-card); }
  .stat .k {
    display: block;
    margin-bottom: var(--sl-space-1);
    color: var(--sl-ink-muted);
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-xs);
    font-weight: 500;
    letter-spacing: var(--sl-eyebrow-track);
    text-transform: uppercase;
  }
  /* Every one of these is a number the engine measured, so every one of them
     is amber mono. */
  .stat .v {
    display: inline-block;
    color: var(--sl-orange-text);
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-lg);
    font-weight: 500;
    line-height: 1.2;
  }
  /* Vs first is the only stat carrying a direction, and it used to encode
     that in hue alone — brand green for better, orange for worse. Two
     problems the inversion made unavoidable: that green is 1.6:1 here, and
     hue alone was never a sufficient signal to begin with. The value stays
     amber like every other measurement; a delta that moved the WRONG way
     carries a rule under it as a second, non-colour channel. The .good rule
     holds the same 1px so the two never sit on different baselines. */
  .stat .v.good { padding-bottom: 1px; border-bottom: 1px solid transparent; }
  .stat .v.bad { padding-bottom: 1px; border-bottom: 1px solid rgba(var(--sl-accent-rgb), .6); }

  details.mx { margin-top: var(--sl-space-4); border-top: 1px solid var(--sl-border); }
  details.mx > summary {
    min-height: 44px;
    display: flex;
    align-items: center;
    color: var(--sl-ink-soft);
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-xs);
    letter-spacing: var(--sl-eyebrow-track);
    text-transform: uppercase;
    cursor: pointer;
  }
  details.mx > summary:hover,
  details.mx[open] > summary { color: var(--sl-ink); }
  details.mx p {
    margin: 0 0 var(--sl-space-2);
    color: var(--sl-ink-soft);
    font-size: var(--sl-text-sm);
  }
  details.mx p:last-child { margin-bottom: var(--sl-space-3); }
  details.mx .mx-unit { color: var(--sl-ink-muted); font-style: italic; }

  /* ------------------------------------------------------------ the flags
     Each chip is a recurrence count, so the count is amber mono and the chip
     sits in a well: the strip reads as data, not as tags. */
  .flags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sl-space-2);
    margin-top: var(--sl-space-4);
  }
  .flag-chip {
    padding: var(--sl-space-2) var(--sl-space-3);
    border: 1px solid var(--sl-border);
    border-radius: var(--sl-radius-sm);
    background: var(--sl-night);
    color: var(--sl-ink-soft);
    font-size: var(--sl-text-sm);
  }
  .flag-chip b {
    color: var(--sl-orange-text);
    font-family: var(--sl-font-mono);
    font-weight: 500;
  }
  .cta {
    margin-top: var(--sl-space-6);
    padding-top: var(--sl-space-5);
    border-top: 1px solid var(--sl-border);
    text-align: left;
  }
  /* 1d's block film button: the same CTA, full-width where a thumb is the
     pointer. Not a duplicate control — CSS only. */
  @media (max-width: 559px) {
    .cta a.button {
      display: flex;
      width: 100%;
      min-height: 44px;
      align-items: center;
      justify-content: center;
    }
  }

  /* ------------------------------------------------- priority history
     One ruled row per past proof target. The state tags are entitlement-
     style markers, NOT measurements — no amber anywhere in them. Active is
     the one filled chip (same solid-object rule as the primary button);
     Held sits in a well; Unproven is dashed, the frame itself saying "no
     verdict". */
  .prio-list { list-style: none; margin: var(--sl-space-4) 0 0; padding: 0; }
  .prio-row {
    display: flex;
    align-items: baseline;
    gap: var(--sl-space-3);
    padding: var(--sl-space-3) 0;
    border-top: 1px solid var(--sl-border);
  }
  .prio-ord {
    flex: 0 0 auto;
    min-width: 3ch;
    color: var(--sl-ink-muted);
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-xs);
    font-weight: 500;
  }
  .prio-main { flex: 1 1 auto; min-width: 0; }
  .prio-name {
    display: block;
    color: var(--sl-ink);
    font-size: var(--sl-text-sm);
    font-weight: 500;
  }
  .prio-sub {
    display: block;
    margin-top: var(--sl-space-1);
    color: var(--sl-ink-soft);
    font-size: var(--sl-text-xs);
  }
  .prio-tag {
    flex: 0 0 auto;
    padding: var(--sl-space-1) var(--sl-space-3);
    border: 1px solid var(--sl-control-border);
    border-radius: var(--sl-radius-sm);
    color: var(--sl-ink);
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-xs);
    font-weight: 500;
    letter-spacing: var(--sl-eyebrow-track);
    text-transform: uppercase;
  }
  .prio-tag--active {
    background: var(--sl-green-btn);
    border-color: var(--sl-green-btn);
    color: var(--sl-green-ink);
  }
  .prio-tag--held { background: var(--sl-night); }
  .prio-tag--unproven {
    border-style: dashed;
    color: var(--sl-ink-soft);
  }

  /* --------------------------------------------------------- the Pro gate */
  main .card h2 {
    margin-top: 0;
    font-family: var(--sl-font-display);
    font-size: var(--sl-text-xl);
    text-transform: uppercase;
  }
  main .card p { color: var(--sl-ink-soft); font-size: var(--sl-text-sm); }
  .locked-card {
    max-width: 620px;
    margin: 0;
    /* Dashed, still: the frame itself says "not yours yet". */
    border: 1px dashed var(--sl-control-border);
    text-align: left;
  }
  {# Two classes on purpose: `main .card h2` above is (0,1,2) and zeroes the
     top margin, which would pull this heading up against the badge. #}
  .card.locked-card h2 { margin: var(--sl-space-4) 0 var(--sl-space-3); }
  /* An entitlement marker, not a measurement — so bone in a well behind a
     hairline, never the amber that means "the engine measured this". It was
     white on var(--primary); the brand green is the logo mark's colour now
     and does not belong on an interface chip. */
  .lock-badge {
    display: inline-block;
    padding: var(--sl-space-1) var(--sl-space-3);
    border: 1px solid var(--sl-control-border);
    border-radius: var(--sl-radius-sm);
    background: var(--sl-night);
    color: var(--sl-ink);
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-xs);
    font-weight: 500;
    letter-spacing: var(--sl-eyebrow-track);
    text-transform: uppercase;
  }

  /* The shell still paints a.button bone-on-bone — background
     var(--sl-green-btn) with `color: white`, 1.06:1 — a light-surface rule
     the inversion left behind. Corrected page-locally because this file is
     the only one in scope; the hover follows the storefront hero, where a
     bone button goes to the trace on hover and never to amber. */
  main a.button {
    color: var(--sl-green-ink);
    box-shadow: none;
  }
  main a.button:hover {
    background: var(--sl-ink-hi);
    border-color: var(--sl-ink-hi);
    color: var(--sl-green-ink);
    box-shadow: none;
  }
{% endblock %}
{% block main %}
  {% if locked %}
  {# Pro gate (billing.progress_pro_only): the teaser names exactly what the
     dashboard does — no trend data is computed or leaked for a locked view. #}
  <div class="lead">
    <p class="sl-eyebrow">Measured over time</p>
    <h1>Progress</h1>
  </div>
  <div class="card locked-card">
    <span class="lock-badge">&#128274; Included with Pro</span>
    <h2>Your swing, session over session</h2>
    <p>The progress dashboard turns every analysis into a dot on a line:
      tempo ratio, head sway, hip slide, and the rest, charted oldest to
      newest against the flag thresholds. Each metric shows your latest,
      your best, and the change since your first session — plus a strip of
      what keeps getting flagged, so you can see a fix actually stick.</p>
    <p class="hint">Your reports keep every number either way — the
      dashboard is the week-over-week view across them.</p>
    <a class="button" href="/pricing">See Pro plans</a>
  </div>
  {% else %}
  <div class="lead">
    <p class="sl-eyebrow">Measured over time</p>
    <h1>Progress</h1>
    {% if club_aware_enabled and context_label %}
    <p class="context"><strong>Tracking context:</strong> {{ context_label }}.
      Every point and recurrence count below uses only this exact context.</p>
    {% endif %}
    {% if session_count >= 2 %}
    <p class="hint">{{ session_count }} measured sessions{% if span %} ·
      {{ span }}{% endif %}{% if club_selected and not club_aware_enabled %} ·
      {{ club_labels.get(club_selected, club_selected) }} only{% endif %}.
      Each dot is one session's mean, oldest to newest;
      the dashed line is the flag threshold, and the tinted side of it is the
      flag zone.</p>
    {% if sentence %}<p class="sentence">{{ sentence }}.</p>{% endif %}
    {% endif %}
  </div>

  {% if club_aware_enabled and clubs_present %}
  <div class="club-filter">
    {% for c in clubs_present %}
    <a href="/progress?club={{ c }}" {% if club_selected == c %}class="active"{% endif %}>{{ club_labels.get(c, c) }}</a>
    {% endfor %}
  </div>
  {% elif clubs_present and clubs_present|length > 1 %}
  <div class="club-filter">
    <a href="/progress" {% if not club_selected %}class="active"{% endif %}>All clubs</a>
    {% for c in clubs_present %}
    <a href="/progress?club={{ c }}" {% if club_selected == c %}class="active"{% endif %}>{{ club_labels.get(c, c) }}</a>
    {% endfor %}
  </div>
  {% endif %}

  {% if progress_proof %}
  {# The same verified verdict /today shows, in the cross-session view that
     sells "proof the fix held" — same tone rules, never raw reason codes. #}
  <aside class="proof-note" data-proof-state="{{ progress_proof.tone }}" aria-labelledby="progress-proof-title">
    <p class="proof-kicker">Proof cycle · {{ progress_proof.target_name }}</p>
    <h2 id="progress-proof-title">{{ progress_proof.heading }}</h2>
    {% if proof_numbers %}
    {# Only a comparison-stage artifact with an accepted matched re-film
       reaches here: baseline value, latest re-film value, and accepted
       count are persisted measurements; the required count is persisted
       policy. A baseline-stage cycle keeps the words-only card. #}
    <p class="proof-pair">{{ proof_numbers.baseline }}
      <span class="arrow">&#8594;</span> {{ proof_numbers.latest }}</p>
    <p class="proof-count"><b>{{ proof_numbers.count }}</b> of
      <b>{{ proof_numbers.required }}</b> matched re-film
      confirmations{% if proof_numbers.verdict_word %} &middot;
      {{ proof_numbers.verdict_word }}{% endif %}</p>
    {% endif %}
    <p><strong>{{ progress_proof.summary }}</strong></p>
    <p>{{ progress_proof.detail }}</p>
    <p><strong>Next:</strong> {{ progress_proof.next_step }}</p>
  </aside>
  {% endif %}

  {% if stat_strip %}
  {# 1c's tile row / 1d's four-cell grid. Only rendered for an exact matched
     context — the view passes an empty list otherwise. #}
  <div class="stat-strip">
    {% for tile in stat_strip %}
    <div class="stat">
      <span class="k">{{ tile.k }}</span>
      <span class="v">{{ tile.v }}</span>
      {% if tile.sub %}<span class="s">{{ tile.sub }}</span>{% endif %}
    </div>
    {% endfor %}
  </div>
  {% endif %}

  {% if session_count == 0 %}
  <div class="card">
    <h2>Nothing to chart yet</h2>
    <p>Progress starts with a baseline. Film a few swings, upload the clip,
      and every session after that lands here as a dot on the line — tempo,
      sway, and the rest, tracked honestly across weeks. No numbers get
      invented in the meantime.</p>
    <a class="button" href="/">Film your baseline</a>
  </div>
  {% elif session_count == 1 %}
  <div class="card">
    <h2>Baseline on the books</h2>
    <p>One measured session so far — its numbers are on
      <a href="/session/{{ latest_job_id }}/report">its report</a>. A trend
      needs a second point: re-film this week (same club, same camera height,
      same angle) and the lines start here.</p>
    <a class="button" href="/">Re-film this week</a>
  </div>
  {% else %}
    {% for c in cards %}
    <div class="metric-card{% if not c.is_headline %} metric-card--compact{% endif %}">
      <div class="metric-head">
        <h2>{{ c.label }}</h2>
        {% if c.benchmark_text %}<span class="bench">{{ c.benchmark_text }}</span>{% endif %}
      </div>
      {{ c.chart | safe }}
      {% if c.axis_labels %}
      {# Which sessions the dots are: the ordinal of each contributing
         session among the trend samples, thinned like the mockup thins
         S01…S14. Decorative index for sighted scanning; the chart's own
         aria-label stays the accessible description. #}
      <div class="chart-axis chart-axis--positioned" aria-hidden="true">
        {% for l in c.axis_labels %}<span style="left: {{ l.pct }}%; transform: translateX({{ '0' if l.pct == 0 else ('-100%' if l.pct == 100 else '-50%') }});">{{ l.text }}</span>{% endfor %}
      </div>
      {% endif %}
      {% if c.is_headline %}
      <div class="chart-legend">
        <span class="lg"><span class="sw sw-measure"><span></span></span>Matched measurement</span>
        {% if c.has_band %}<span class="lg"><span class="sw sw-band"><span></span></span>Noise floor band</span>{% endif %}
        {% if c.benchmark_text %}<span class="lg"><span class="sw sw-pass"><span></span></span>Pass mark</span>{% endif %}
      </div>
      {% endif %}
      <div class="stats">
        <div class="stat"><span class="k">Latest</span><span class="v">{{ c.latest }}</span></div>
        <div class="stat"><span class="k">Best</span><span class="v">{{ c.best }}</span></div>
        <div class="stat"><span class="k">Vs first</span><span class="v {{ c.delta_class }}">{{ c.delta }}</span></div>
        <div class="stat"><span class="k">Sessions</span><span class="v">{{ c.sessions }}</span></div>
      </div>
      {% if c.explainer %}
      <details class="mx">
        <summary>What is this?</summary>
        <p>{{ c.explainer.text }}</p>
        {% if c.explainer.how %}<p>How it's measured:
          {{ c.explainer.how }}</p>{% endif %}
        <p class="mx-unit">{{ c.explainer.unit_gloss }}</p>
      </details>
      {% endif %}
    </div>
    {% endfor %}

    {% if proof_history %}
    {# One row per past proof target in this exact context, newest first,
       from stored sidecars only — pre-sidecar sessions contribute nothing,
       so the section hides itself rather than backfilling. Held means
       matched re-films cleared the pass mark outside the noise floor;
       worked-but-never-re-filmed stays Unproven. #}
    <div class="card history-card">
      <h2>Priority history</h2>
      <ol class="prio-list">
        {% for row in proof_history %}
        <li class="prio-row">
          <span class="prio-ord">{{ row.ordinal or "" }}</span>
          <span class="prio-main">
            <span class="prio-name">{{ row.name }}</span>
            <span class="prio-sub">{{ row.subline }}</span>
          </span>
          <span class="prio-tag prio-tag--{{ row.state | lower }}">{{ row.state }}</span>
        </li>
        {% endfor %}
      </ol>
      <p class="hint">A priority only earns Held after matched re-films clear
        its pass mark outside the noise floor. No verdict is invented for
        anything else.</p>
    </div>
    {% endif %}

    <div class="card">
      <h2>What keeps getting flagged</h2>
      {% if flags_strip %}
      <div class="flags">
        {% for f in flags_strip %}
        <span class="flag-chip">{{ f.label }} <b>&times;{{ f.count }}</b> of {{ session_count }}</span>
        {% endfor %}
      </div>
      <p class="hint">Counted once per session it fired in. The practice plan
        on each report targets these, with a re-film number that says when
        it's fixed.</p>
      {% else %}
      <p class="hint">No flags across these sessions — keep the baseline
        current so drift shows up early.</p>
      {% endif %}
      <div class="cta">
        {# The number is derived, not decorative: this context holds
           session_count measured sessions, so the next film is N+1. #}
        <a class="button" href="/">Film session {{ session_count + 1 }}</a>
        <p class="hint">The chart only moves when you film — same club, same
          camera height, same angle.</p>
      </div>
    </div>
  {% endif %}
  {% endif %}

  <p class="disclaimer">{{ brand.disclaimer }}</p>
{% endblock %}
