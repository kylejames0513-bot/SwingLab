<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="caddieinsight-report-format" content="{{ report_format_version }}">
  <meta name="caddieinsight-report-presentation" content="{{ view.presentation_version }}">
  <meta name="caddieinsight-report-outcome" content="{{ view.outcome }}">
  <meta name="caddieinsight-coaching-priority-rule"
        content="{{ priority_rule_version }}">
  <title>{{ brand.name }} — Swing report</title>
  <style>
    /* ROOT-RELATIVE font faces, not remote ones.

       This document is self-contained and may be saved to disk, so it fetches
       nothing from a third party — that rule is unchanged. But it is also
       SERVED, at /sample-report/, where it is a public marketing page the
       storefront links to, and it was rendering in a system grotesk while
       every other surface rendered in Barlow.

       A /static path costs nothing to the saved-file case: opened from disk
       these 404 silently and the stacks below fall back exactly as they
       already document. Served, they are the same byte-identical faces the
       app shell loads. */
    @font-face {
      font-family: "Barlow";
      font-style: normal;
      font-weight: 400;
      font-display: swap;
      src: url("/static/barlow-latin-400.woff2") format("woff2");
    }
    @font-face {
      font-family: "Barlow";
      font-style: normal;
      font-weight: 500;
      font-display: swap;
      src: url("/static/barlow-latin-500.woff2") format("woff2");
    }
    @font-face {
      font-family: "Barlow Condensed";
      font-style: normal;
      font-weight: 600;
      font-display: swap;
      src: url("/static/barlow-condensed-latin-600.woff2") format("woff2");
    }
    @font-face {
      font-family: "DM Mono";
      font-style: normal;
      font-weight: 400;
      font-display: swap;
      src: url("/static/dm-mono-latin-400.woff2") format("woff2");
    }
    @font-face {
      font-family: "DM Mono";
      font-style: normal;
      font-weight: 500;
      font-display: swap;
      src: url("/static/dm-mono-latin-500.woff2") format("woff2");
    }
    :root {
      /* INDUSTRY, on screen. This report keeps its own private token names
         rather than the --sl-* ones because it must survive being saved to
         disk and opened with no stylesheet beside it — but the VALUES are the
         app's, so the deliverable and the product it came from look like one
         company.

         The ground is PAPER again, which is where this palette started before
         the 2026-08-10 inversion. That is not a round trip to where it began:
         the type is Barlow, the geometry is square, and the signal is steel
         rather than amber. What it does mean is that the @media print block
         below has almost nothing left to do — screen and print finally agree
         on the ground, and print only has to reach pure white and drop the
         casts.

         THE NAMES DID NOT CHANGE. --amber is steel now, exactly as --sl-green
         is ink on the other two surfaces, because renaming would touch every
         call site in a 1,900-line file to buy nothing — and because
         tests/test_signal_colour_discipline.py polices these names. The rule
         they enforce is unchanged: the signal marks a value the ENGINE
         MEASURED and the trace marks the LIVE READOUT. */
      --brand-primary: {{ brand.primary_color }};
      --brand-accent: {{ brand.accent_color }};
      --ink: #1d1f20;
      --muted: #626265;
      --paper: #f2f2f3;
      --canvas: #f2f2f3;
      --accent-text: #375169;
      --accent-bright: #416180;
      --control-border: #6e6e71;
      --focus: #416180;
      --line: #d0d1d1;
      --soft: #e9e9ea;
      --green: #1d1f20;
      --green-btn: #2c455d;
      --green-ink: #f2f2f3;
      --amber: #416180;
      --amber-soft: #eef6ff;
      --night: #e9e9ea;
      /* THE FIELD — the one reversed ground, carrying the swing clip, the
         evidence tiles and the priority panel. It used to be the whole page,
         which is why --surface-dark was the only name for it. */
      --surface-dark: #070f0b;
      --field-ink: #f2f2f3;
      --field-soft: #a8b3ac;
      --field-muted: #8f9a93;
      --field-rule: #243229;
      --trace: #94bce3;
      /* RGB triplets for alpha-derivations. Both were raw literals of the
         RETIRED palette — 22 uses of amber and 11 of bone, scattered through
         the sheet where the token names could not see them. That is how a
         palette forks: the named colours move and the hand-written washes
         made from them do not.

         Every bone wash in this file is on a PAPER surface, so it tints
         downward. If a field panel ever needs one it takes --cream-rgb. */
      --amber-rgb: 65, 97, 128;
      --wash-rgb: 29, 31, 32;
      --cream-rgb: 242, 242, 243;
      /* A panel is a line drawing on paper, so there is no lit top edge to
         gradient down from — the hairline does that work now. Kept as a token
         because ~40 rules gradient from it. */
      --paper-lift: #f2f2f3;
      --shadow-sm: none;
      --shadow-md: 0 1px 2px rgba(29, 31, 32, .14);
      --shadow-theater: 0 12px 32px rgba(29, 31, 32, .22);
      /* Offline self-contained reports cannot fetch remote faces, so every
         stack degrades to something installed. Barlow Condensed leads the
         display stack and falls back to Barlow at normal width — the right
         typeface at the wrong width beats a system grotesk. That fallback
         matters more than it did: Barlow ships no variable font, so a missed
         load cannot be covered by a nearby weight of the same file. */
      --font-display: "Barlow Condensed", "Barlow", "Segoe UI Condensed", "Helvetica Neue", Helvetica, Arial, sans-serif;
      --font-sans: "Barlow", "Segoe UI", "Helvetica Neue", Helvetica, Arial, sans-serif;
      --font-mono: "DM Mono", ui-monospace, SFMono-Regular, Menlo, Consolas, "Liberation Mono", monospace;
    }
    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body {
      margin: 0;
      color: var(--ink);
      /* Plain paper. The 8px grid and the two signal-tinted glows are gone
         with the dark ground they were painted for — and a report is the one
         surface where that matters twice, because this is also what gets
         printed. A page-wide wash of the signal colour was teaching a reader
         that amber meant "background", on the document where amber had to
         mean "measured". */
      background: var(--canvas);
      font-family: var(--font-sans);
      line-height: 1.55;
      overflow-wrap: anywhere;
      -webkit-font-smoothing: antialiased;
    }
    a {
      color: var(--ink);
      text-decoration: underline;
      text-decoration-color: rgba(var(--wash-rgb), .32);
      text-underline-offset: .2em;
    }
    a:hover { text-decoration-color: currentColor; }
    img, video, svg { max-width: 100%; height: auto; }
    img { display: block; }
    .report-control,
    details > summary {
      display: inline-flex;
      min-width: 44px;
      min-height: 44px;
      align-items: center;
    }
    :where(a, button, summary):focus-visible {
      outline: 3px solid var(--focus);
      outline-offset: 3px;
    }
    .skip-link {
      position: absolute;
      left: 1rem;
      top: -5rem;
      z-index: 10;
      padding: .65rem 1rem;
      color: var(--paper);
      background: var(--ink);
      font-weight: 500;
      text-decoration: none;
      border-radius: .4rem;
    }
    .skip-link:focus { top: 1rem; }
    .sample-banner,
    .report-header,
    main { width: min(calc(100% - 2rem), 68rem); margin-inline: auto; }
    .sample-banner {
      display: flex;
      justify-content: space-between;
      gap: 1rem;
      margin-top: 1rem;
      padding: .75rem 1rem;
      background: var(--amber-soft);
      border: 1px solid var(--line);
      border-radius: .75rem;
      font-size: .95rem;
    }
    .report-header {
      display: grid;
      gap: .85rem;
      padding: 1.15rem 0 .7rem;
      animation: report-rise .6s ease both;
    }
    .report-brand-row {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: .55rem 1rem;
    }
    .report-brand {
      display: inline-flex;
      align-items: center;
      gap: .75rem;
      margin: 0;
      color: var(--ink);
      text-decoration: none;
    }
    .report-brand__mark {
      display: grid;
      place-items: center;
      width: 2.2rem;
      height: 2.2rem;
      border-radius: .55rem;
      background: linear-gradient(145deg, var(--surface-dark), var(--green));
      box-shadow: var(--shadow-sm);
      flex: 0 0 auto;
    }
    .report-brand__mark svg { width: 1.25rem; height: 1.25rem; }
    .report-brand__text {
      display: grid;
      gap: .14rem;
    }
    .report-brand__name {
      font-family: var(--font-display);
      font-size: .82rem;
      font-weight: 600;
      letter-spacing: .18em;
      text-transform: uppercase;
    }
    .report-brand__tag {
      color: var(--muted);
      font-family: var(--font-mono);
      font-size: .68rem;
      letter-spacing: .1em;
      text-transform: uppercase;
    }
    .session-framing {
      max-width: 54ch;
      margin: 0;
      color: var(--muted);
      font-size: .88rem;
      line-height: 1.35;
    }
    .trust-chip {
      display: inline-flex;
      align-items: center;
      gap: .4rem;
      padding: .35rem .7rem;
      color: var(--green);
      background: rgba(var(--wash-rgb), .05);
      border: 1px solid transparent;
      border-radius: 999px;
      font-family: var(--font-mono);
      font-size: .68rem;
      font-weight: 500;
      letter-spacing: .08em;
      text-transform: uppercase;
    }
    .trust-chip::before {
      content: "";
      width: .45rem;
      height: .45rem;
      border-radius: 50%;
      background: var(--green-btn);
    }
    .context-list {
      display: flex;
      flex-wrap: wrap;
      gap: .45rem .85rem;
      margin: 0;
      padding: 0;
    }
    .context-list div {
      display: inline-flex;
      align-items: baseline;
      gap: .35rem;
      min-width: 0;
      padding: 0;
      background: transparent;
      border: 0;
      border-radius: 0;
    }
    .context-list dt {
      color: var(--muted);
      font-family: var(--font-mono);
      font-size: .66rem;
      font-weight: 500;
      letter-spacing: .1em;
      text-transform: uppercase;
    }
    .context-list dd {
      margin: 0;
      font-size: .92rem;
      font-weight: 500;
    }
    .context-list dt::after { content: ""; }
    main { padding-bottom: 4.5rem; }
    [data-report-block] {
      margin-top: 1rem;
      padding: clamp(1rem, 2.6vw, 1.85rem);
      background:
        linear-gradient(180deg, var(--paper-lift), var(--paper));
      border: 1px solid var(--line);
      border-radius: 1.1rem;
      box-shadow: var(--shadow-md);
    }
    .report-block--enter {
      animation: report-rise .55s ease both;
    }
    /* THE PRIORITY PANEL SITS ON THE FIELD. It is one of the four sanctioned
       reversed surfaces (video, evidence, capture, priority), and the 1a
       spec-sheet puts it on the right rail as the report's one dark plate.
       GROUNDS TRAP: every heading and label inside declares its own colour
       below — element rules in shared CSS beat inheritance, and this exact
       bug has shipped twice. @media print flips --surface-dark to white and
       --field-ink to ink, so the panel prints as a bordered white plate. */
    .next-move {
      position: relative;
      overflow: hidden;
      color: var(--field-ink);
      border-color: var(--field-rule);
      border-top: .3rem solid var(--brand-accent, var(--accent-bright));
      background:
        linear-gradient(135deg, rgba(var(--cream-rgb), .05), transparent 44%),
        var(--surface-dark);
      animation: report-rise .65s ease both;
    }
    .next-move .eyebrow,
    .next-move .priority-count,
    .next-move .strength-label { color: var(--field-soft); }
    .next-move h1 { color: var(--field-ink); }
    .next-move .observation { color: var(--field-ink); }
    .next-move .coach-cue {
      color: var(--field-ink);
      background: rgba(var(--cream-rgb), .07);
      border: 1px solid var(--field-rule);
      border-left: .34rem solid var(--accent-bright);
      box-shadow: none;
    }
    .next-move .coach-cue strong { color: var(--field-soft); }
    .next-move a {
      color: var(--field-ink);
      text-decoration-color: rgba(var(--cream-rgb), .4);
    }
    .next-move .journey-preview a {
      color: var(--field-ink);
      background: rgba(var(--cream-rgb), .05);
      border-color: var(--field-rule);
    }
    .next-move .journey-preview a:hover {
      background: rgba(var(--cream-rgb), .1);
      border-color: var(--field-soft);
    }
    .priority-count {
      margin: 0 0 .5rem;
      font-family: var(--font-mono);
      font-size: .7rem;
      font-weight: 500;
      letter-spacing: .14em;
      text-transform: uppercase;
    }
    .next-move::before {
      content: "";
      position: absolute;
      inset: 0 auto 0 0;
      width: .2rem;
      background: linear-gradient(180deg, var(--green-btn), var(--accent-bright));
      transform-origin: top;
      animation: cue-bar .75s ease both;
    }
    /* Labels take the muted ink, not the signal. An eyebrow announces a
       measured value; it is not itself one, and spending amber on every
       section heading is how a reader learns amber means "heading". */
    .eyebrow,
    .step-label,
    .strength-label {
      margin: 0 0 .35rem;
      color: var(--muted);
      font-family: var(--font-mono);
      font-size: .72rem;
      font-weight: 500;
      letter-spacing: .12em;
      text-transform: uppercase;
    }
    .strength-label { color: var(--green-btn); }
    h1, h2, h3 {
      font-family: var(--font-display);
      line-height: 1.12;
      letter-spacing: -.025em;
    }
    h1 { max-width: 18ch; margin: .15rem 0 .55rem; font-size: clamp(1.8rem, 5.5vw, 3.2rem); }
    h2 { margin: .25rem 0 1rem; font-size: clamp(1.45rem, 3.8vw, 2.1rem); }
    h3 { margin: 1rem 0 .45rem; font-size: 1.08rem; }
    .observation {
      max-width: 62ch;
      margin: 0 0 .75rem;
      color: var(--ink);
      font-size: 1.04rem;
    }
    .coach-cue {
      max-width: 62ch;
      margin: 0;
      padding: .85rem 1rem .85rem 1.05rem;
      background:
        linear-gradient(90deg, rgba(var(--amber-rgb), .12), var(--soft));
      border: 1px solid rgba(var(--amber-rgb), .26);
      border-left: .34rem solid var(--accent-bright);
      border-radius: .7rem;
      font-size: 1.02rem;
      box-shadow: inset 0 1px 0 rgba(var(--wash-rgb), .06);
      animation: cue-soft .7s ease both .12s;
    }
    .coach-cue strong {
      display: block;
      margin-bottom: .28rem;
      color: var(--muted);
      font-family: var(--font-mono);
      font-size: .7rem;
      font-weight: 500;
      letter-spacing: .12em;
      text-transform: uppercase;
    }
    .journey-preview {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: .45rem;
      margin: .9rem 0 0;
      padding: 0;
      list-style: none;
    }
    .journey-preview a {
      display: flex;
      align-items: center;
      justify-content: center;
      padding: .55rem .55rem;
      color: var(--green);
      text-align: center;
      text-decoration: none;
      background: rgba(var(--wash-rgb), .04);
      border: 1px solid var(--line);
      border-radius: .7rem;
      font-size: .92rem;
      font-weight: 500;
      transition: border-color .2s ease, background .2s ease, transform .2s ease;
    }
    .journey-preview a:hover {
      background: rgba(var(--wash-rgb), .07);
      border-color: var(--green-btn);
      transform: translateY(-1px);
    }
    .focused-evidence {
      display: grid;
      grid-template-columns: minmax(0, 1.25fr) minmax(16rem, .85fr);
      gap: 1rem;
      margin: 0;
      padding: 1rem;
      background: var(--soft);
      border-radius: .95rem;
    }
    .focused-evidence img { width: 100%; border-radius: .65rem; }
    .evidence-meta,
    .evidence-counts,
    .refilm-confirmations { margin: .75rem 0; }
    .evidence-counts {
      display: flex;
      flex-wrap: wrap;
      gap: .45rem;
    }
    .evidence-counts div {
      padding: .4rem .6rem;
      background: var(--paper);
      border: 1px solid var(--line);
      border-radius: .5rem;
      font-size: .92rem;
    }
    .evidence-counts dt,
    .evidence-counts dd { display: inline; margin: 0; }
    .visual-unavailable {
      padding: 1rem 1.1rem;
      background: var(--soft);
      border: 1px dashed var(--control-border);
      border-radius: .95rem;
    }
    .evidence-boundary { color: var(--muted); font-size: .92rem; }
    .event-timeline { padding-left: 1.25rem; }
    .event-timeline li {
      display: grid;
      grid-template-columns: minmax(5rem, .6fr) minmax(4.5rem, .35fr) minmax(12rem, 1fr);
      gap: .6rem;
      padding: .45rem 0;
      border-bottom: 1px solid var(--line);
    }
    .media-theater {
      margin-top: 1.45rem;
      padding: 1.15rem 1.15rem 1.3rem;
      color: var(--green-ink);
      /* The washes were raw literals of the RETIRED amber palette; they now
         derive from the live signal triplet so the next palette move carries
         them automatically. */
      background:
        radial-gradient(720px 240px at 10% -8%, rgba(var(--amber-rgb), .2), transparent 58%),
        radial-gradient(520px 180px at 92% 110%, rgba(26, 92, 56, .35), transparent 55%),
        linear-gradient(148deg, var(--night) 0%, var(--surface-dark) 52%, var(--green) 100%);
      border-radius: 1.05rem;
      box-shadow: var(--shadow-theater);
      animation: theater-in .7s ease both;
    }
    .media-theater__eyebrow {
      margin: 0 0 .4rem;
      color: rgba(230, 242, 234, .72);
      font-family: var(--font-mono);
      font-size: .68rem;
      letter-spacing: .14em;
      text-transform: uppercase;
    }
    .media-theater__title {
      margin: 0 0 .4rem;
      color: #fff;
      font-family: var(--font-display);
      font-size: clamp(1.3rem, 3.1vw, 1.7rem);
      letter-spacing: -.015em;
    }
    .media-theater__lead {
      margin: 0 0 1.1rem;
      max-width: 54ch;
      color: rgba(230, 242, 234, .88);
      font-size: .96rem;
    }
    .media-theater__grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(15.5rem, 1fr));
      gap: .95rem;
    }
    .media-theater__card {
      position: relative;
      margin: 0;
      padding: .75rem;
      background: rgba(255, 255, 255, .045);
      border: 1px solid rgba(230, 242, 234, .16);
      border-radius: .85rem;
      overflow: hidden;
    }
    .media-theater__badge {
      display: inline-block;
      margin: 0 0 .55rem;
      color: rgba(230, 242, 234, .9);
      font-family: var(--font-mono);
      font-size: .62rem;
      letter-spacing: .14em;
      text-transform: uppercase;
    }
    .media-theater__card video {
      width: 100%;
      height: auto;
      border-radius: .55rem;
      background: #000;
      /* Preserve natural phone-video framing — never crop evidence. */
      object-fit: contain;
    }
    .media-theater__card figcaption,
    .media-theater__card p {
      margin: .55rem .1rem 0;
      color: rgba(230, 242, 234, .86);
      font-size: .88rem;
    }
    .media-theater__card--locked {
      border-style: dashed;
      border-color: rgba(var(--amber-rgb), .5);
      background: rgba(var(--amber-rgb), .07);
    }
    .media-theater__poster { position: relative; }
    .media-theater__poster img {
      width: 100%;
      border-radius: .55rem;
      /* Dimmed, not blurred: it is the golfer's own frame and stays
         recognisable as one — the lock, not the image, says it is withheld. */
      filter: brightness(.5) saturate(.65);
    }
    .media-theater__lock {
      position: absolute;
      inset: 0;
      display: grid;
      place-items: center;
      font-size: 1.7rem;
    }
    .media-theater__card--locked a {
      color: var(--accent-text);
      font-weight: 500;
    }
    .replay-locked-note {
      display: grid;
      justify-items: start;
      gap: .65rem;
      margin-top: .35rem;
      padding: .95rem 1.05rem;
      background:
        linear-gradient(90deg, rgba(var(--amber-rgb), .12), var(--soft));
      border: 1px solid rgba(var(--amber-rgb), .28);
      border-left: .34rem solid var(--accent-bright);
      border-radius: .8rem;
    }
    .replay-locked-note p { max-width: 62ch; margin: 0; }
    .replay-locked-note .lock-badge {
      padding: .3rem .75rem;
      color: var(--green-ink);
      background: var(--green);
      border-radius: 999px;
      font-family: var(--font-mono);
      font-size: .66rem;
      font-weight: 500;
      letter-spacing: .1em;
      text-transform: uppercase;
    }
    .replay-locked-note a { font-weight: 500; }
    .phase-list { display: grid; gap: .65rem; margin-top: 1.2rem; }
    .phase-card {
      padding: .1rem 1rem;
      background: var(--paper);
      border: 1px solid var(--line);
      border-radius: .75rem;
    }
    .phase-card[open] { border-color: var(--green-btn); }
    .phase-card summary {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      gap: 1rem;
      padding: .85rem 0;
      cursor: pointer;
      font-weight: 500;
    }
    .status { white-space: nowrap; color: var(--muted); font-weight: 500; }
    details > summary { cursor: pointer; }
    .measurement-detail,
    .video-limitations,
    .practice-detail,
    .alternatives,
    .optional-card {
      margin-top: 1rem;
      padding: .75rem 1rem;
      background: var(--soft);
      border-radius: .7rem;
    }
    .capture-correction {
      padding: .9rem 1.05rem;
      background: linear-gradient(90deg, rgba(var(--wash-rgb), .06), var(--soft));
      border-left: .28rem solid var(--green-btn);
      border-radius: .75rem;
    }
    .capture-actions { display: flex; flex-wrap: wrap; gap: .7rem; align-items: center; }
    .capture-playback { margin: 1rem 0 0; }
    .capture-playback video,
    .optional-card video,
    .media-theater__card video { width: min(100%, 42rem); }
    .optional-depth { margin-top: 1rem; }
    .optional-card > summary { font-weight: 500; }
    .table-scroll {
      max-width: 100%;
      overflow-x: auto;
      overscroll-behavior-inline: contain;
    }
    table { width: 100%; border-collapse: collapse; }
    th, td { padding: .55rem; border-bottom: 1px solid var(--line); text-align: left; vertical-align: top; }
    .practice-lead {
      max-width: 62ch;
      margin: 0 0 1rem;
      font-size: 1.02rem;
    }
    .practice-summary,
    .refilm-checklist { padding-left: 1.35rem; }
    .practice-summary li,
    .refilm-checklist li { margin: .55rem 0; }
    .practice-summary {
      margin: 0 0 1.1rem;
      padding: 0 0 0 1.15rem;
      list-style: none;
      counter-reset: drill-step;
    }
    .practice-summary li {
      position: relative;
      margin: .7rem 0;
      padding-left: 2.1rem;
      counter-increment: drill-step;
    }
    .practice-summary li::before {
      content: counter(drill-step);
      position: absolute;
      left: 0;
      top: .05rem;
      display: grid;
      place-items: center;
      width: 1.55rem;
      height: 1.55rem;
      color: var(--green-ink);
      background: var(--green);
      border-radius: .45rem;
      font-family: var(--font-mono);
      font-size: .72rem;
      font-weight: 500;
    }
    .practice-facts,
    .refilm-confirmations {
      display: grid;
      grid-template-columns: minmax(8rem, .4fr) 1fr;
      gap: .55rem .9rem;
      margin: 0;
      padding: 1rem;
      background: rgba(var(--wash-rgb), .035);
      border: 1px solid var(--line);
      border-radius: .85rem;
    }
    .practice-facts dt,
    .refilm-confirmations dt {
      color: var(--muted);
      font-family: var(--font-mono);
      font-size: .68rem;
      font-weight: 500;
      letter-spacing: .1em;
      text-transform: uppercase;
    }
    .practice-facts dd,
    .refilm-confirmations dd { margin: 0; font-weight: 500; }
    .practice-facts dt:nth-of-type(3),
    .practice-facts dd:nth-of-type(3) {
      color: inherit;
    }
    .training-deck {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: .7rem;
      margin: 0 0 1.15rem;
    }
    .training-card {
      margin: 0;
      padding: .85rem .95rem;
      background: var(--paper);
      border: 1px solid var(--line);
      border-radius: .8rem;
      box-shadow: var(--shadow-sm);
    }
    .training-card--dosage {
      border-color: rgba(var(--amber-rgb), .32);
      background:
        linear-gradient(180deg, rgba(var(--amber-rgb), .08), var(--paper) 55%);
    }
    .training-card--feel {
      border-color: rgba(var(--wash-rgb), .18);
      background:
        linear-gradient(180deg, rgba(var(--wash-rgb), .05), var(--paper) 55%);
    }
    .training-card--pass {
      grid-column: 1 / -1;
    }
    .training-card__label {
      display: block;
      margin-bottom: .3rem;
      color: var(--muted);
      font-family: var(--font-mono);
      font-size: .66rem;
      letter-spacing: .11em;
      text-transform: uppercase;
    }
    .training-card--feel .training-card__label {
      color: var(--green-btn);
    }
    .training-card p {
      margin: 0;
      font-size: .98rem;
      font-weight: 500;
      line-height: 1.4;
    }
    .training-card a {
      color: var(--green);
      font-weight: 500;
      text-decoration: none;
      border-bottom: 1px solid rgba(var(--wash-rgb), .22);
    }
    .practice-dosage-callout {
      grid-column: 1 / -1;
      display: grid;
      gap: .2rem;
      margin-top: .15rem;
      padding: .75rem .85rem;
      background: var(--paper);
      border: 1px solid rgba(var(--amber-rgb), .28);
      border-radius: .65rem;
    }
    .practice-dosage-callout span {
      color: var(--accent-text);
      font-family: var(--font-mono);
      font-size: .66rem;
      letter-spacing: .1em;
      text-transform: uppercase;
    }
    .drill-illustration { max-width: 36rem; margin: 1rem 0; }
    .drill-illustration figcaption { margin-top: .4rem; color: var(--muted); }
    .pass-mark {
      margin: 0;
      padding: 1rem 1.05rem;
      background:
        linear-gradient(90deg, rgba(var(--amber-rgb), .12), var(--soft));
      border: 1px solid rgba(var(--amber-rgb), .28);
      border-left: .34rem solid var(--accent-bright);
      border-radius: .8rem;
      font-size: 1.06rem;
      font-weight: 600;
      animation: cue-soft .65s ease both;
    }
    /* SESSION LINE — the frozen "Session NNN · date · time" spec line. */
    .session-line {
      margin: 0;
      color: var(--muted);
      font-family: var(--font-mono);
      font-size: .72rem;
      font-weight: 500;
      letter-spacing: .14em;
      text-transform: uppercase;
    }
    .header-action {
      display: inline-flex;
      align-items: center;
      padding: .55rem .95rem;
      color: var(--paper);
      background: var(--ink);
      border-radius: .55rem;
      font-weight: 500;
      text-decoration: none;
      transition: background .2s ease;
    }
    .header-action:hover { background: var(--green-btn); }
    /* THE SPEC-SHEET COLUMNS — evidence left, priority + capture context
       right, from 64rem up. Below that the DOM order stands: one job first,
       evidence on demand. */
    @media (min-width: 64rem) {
      .report-columns {
        display: grid;
        grid-template-columns: minmax(0, 1.45fr) minmax(20rem, .85fr);
        gap: 0 1rem;
        align-items: start;
      }
      .report-evidence { order: 1; min-width: 0; }
      .report-rail { order: 2; min-width: 0; }
    }
    /* CAPTURE CONTEXT — the bordered spec block beside the priority panel. */
    .capture-context {
      margin-top: 1rem;
      padding: 1rem 1.15rem;
      background: linear-gradient(180deg, var(--paper-lift), var(--paper));
      border: 1px solid var(--line);
      border-radius: 1.1rem;
      box-shadow: var(--shadow-md);
    }
    .capture-context__title {
      margin: 0 0 .6rem;
      font-size: 1.02rem;
      letter-spacing: .02em;
    }
    .capture-context__list { display: grid; gap: .1rem; margin: 0; }
    .capture-context__list div {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: baseline;
      padding: .35rem 0;
      border-bottom: 1px solid var(--soft);
    }
    .capture-context__list div:last-child { border-bottom: 0; }
    .capture-context__list dt {
      color: var(--muted);
      font-family: var(--font-mono);
      font-size: .66rem;
      font-weight: 500;
      letter-spacing: .1em;
      text-transform: uppercase;
    }
    .capture-context__list dd {
      margin: 0;
      font-family: var(--font-mono);
      font-size: .92rem;
      font-weight: 500;
    }
    /* PASS-MARK METER — NOW against MARK. The fill restates the measured
       session mean against the configured threshold: on the field panel it
       takes the trace (the lit readout tuned for the dark ground), on paper
       it takes the signal steel. DM Mono throughout: every number here is a
       measured value or a configured spec. */
    .pass-meter {
      display: grid;
      gap: .45rem;
      margin: 1rem 0 0;
      padding: .9rem 1rem;
      background: rgba(var(--cream-rgb), .05);
      border: 1px solid var(--field-rule);
      border-radius: .8rem;
    }
    .pass-meter__label {
      margin: 0;
      color: var(--field-soft);
      font-family: var(--font-mono);
      font-size: .66rem;
      font-weight: 500;
      letter-spacing: .12em;
      text-transform: uppercase;
    }
    .pass-meter__target {
      margin: 0;
      color: var(--field-ink);
      font-family: var(--font-mono);
      font-size: 1.15rem;
      font-weight: 500;
    }
    .pass-meter__unit { font-size: .82rem; }
    .pass-meter__track {
      height: .45rem;
      background: rgba(var(--cream-rgb), .14);
      border-radius: 999px;
      overflow: hidden;
    }
    .pass-meter__fill {
      height: 100%;
      background: var(--trace);
      border-radius: inherit;
    }
    .pass-meter__readout {
      display: flex;
      justify-content: space-between;
      gap: .75rem;
      margin: 0;
      color: var(--field-ink);
      font-family: var(--font-mono);
      font-size: .78rem;
      font-weight: 500;
      letter-spacing: .08em;
      text-transform: uppercase;
    }
    .pass-meter--paper {
      background: var(--soft);
      border-color: var(--line);
    }
    .pass-meter--paper .pass-meter__label { color: var(--muted); }
    .pass-meter--paper .pass-meter__target { color: var(--accent-text); }
    .pass-meter--paper .pass-meter__track { background: rgba(var(--wash-rgb), .12); }
    .pass-meter--paper .pass-meter__fill { background: var(--amber); }
    .pass-meter--paper .pass-meter__readout { color: var(--ink); }
    /* MEASURED THIS SESSION — the spec table. Values are DM Mono; the
       This-clip column takes the text-safe signal because every cell in it
       is a value the engine measured. Cells with nothing measured or no
       configured floor render an em dash, never an invented number. */
    .measured-table table { font-variant-numeric: tabular-nums; }
    .measured-table th[scope="row"] {
      min-width: 9rem;
      font-weight: 500;
      /* The global overflow-wrap: anywhere shatters metric names one letter
         per line when the value columns refuse to wrap; break at spaces. */
      overflow-wrap: break-word;
    }
    .measured-value,
    .measured-prior,
    .measured-delta,
    .measured-floor {
      font-family: var(--font-mono);
      font-size: .92rem;
      white-space: nowrap;
    }
    td.measured-value { color: var(--accent-text); }
    .measured-floor,
    .measured-delta--noise { color: var(--muted); }
    .measured-footnote {
      margin: .7rem 0 0;
      color: var(--muted);
      font-size: .88rem;
    }
    .measured-rows { display: none; }
    .measured-row {
      padding: .1rem .85rem;
      background: var(--paper);
      border: 1px solid var(--line);
      border-radius: .75rem;
    }
    .measured-row summary {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: .75rem;
      padding: .6rem 0;
      font-weight: 500;
    }
    .measured-row__label { overflow-wrap: break-word; }
    .measured-row__reading {
      display: inline-flex;
      align-items: baseline;
      gap: .6rem;
    }
    .measured-row__detail { display: grid; gap: .3rem; margin: 0 0 .7rem; }
    .measured-row__detail div {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      gap: .75rem;
    }
    .measured-row__detail dt {
      color: var(--muted);
      font-family: var(--font-mono);
      font-size: .66rem;
      font-weight: 500;
      letter-spacing: .1em;
      text-transform: uppercase;
    }
    .measured-row__detail dd {
      margin: 0;
      font-family: var(--font-mono);
      font-size: .88rem;
    }
    /* P-SYSTEM LABELS — only the four measured events carry one. Labels take
       muted ink (a label announces a measured value; it is not itself one). */
    .position-chip {
      position: absolute;
      top: 1.45rem;
      left: 1.45rem;
      z-index: 1;
      padding: .3rem .6rem;
      color: var(--field-ink);
      background: var(--surface-dark);
      border: 1px solid var(--field-rule);
      border-radius: .45rem;
      font-family: var(--font-mono);
      font-size: .68rem;
      font-weight: 500;
      letter-spacing: .12em;
      text-transform: uppercase;
    }
    .focused-evidence { position: relative; }
    .event-p {
      display: inline-block;
      margin-right: .4rem;
      padding: .05rem .4rem;
      color: var(--muted);
      border: 1px solid var(--line);
      border-radius: .4rem;
      font-family: var(--font-mono);
      font-size: .7rem;
      font-weight: 500;
      letter-spacing: .08em;
    }
    /* DRILL TAGS + inline gear line. */
    .drill-tags { display: flex; flex-wrap: wrap; gap: .45rem; margin: 0 0 .9rem; }
    .drill-tag {
      padding: .3rem .65rem;
      color: var(--green);
      background: rgba(var(--wash-rgb), .05);
      border: 1px solid var(--line);
      border-radius: 999px;
      font-family: var(--font-mono);
      font-size: .68rem;
      font-weight: 500;
      letter-spacing: .08em;
      text-transform: uppercase;
    }
    .drill-tag--priority {
      color: var(--accent-text);
      border-color: rgba(var(--amber-rgb), .4);
    }
    .drill-gear { margin: 1rem 0 0; font-size: .95rem; }
    /* MOBILE ACTION BAR — hidden except on small screens. */
    .action-bar { display: none; }
    .primary-action {
      display: inline-flex;
      margin-top: 1rem;
      padding: .8rem 1.15rem;
      color: var(--paper);
      background: var(--ink);
      border-radius: .65rem;
      font-weight: 500;
      text-decoration: none;
      transition: transform .2s ease, background .2s ease;
    }
    .primary-action:hover {
      background: var(--green);
      transform: translateY(-1px);
    }
    .print-only { display: none; }
    @keyframes report-rise {
      from { opacity: 0; transform: translateY(.55rem); }
      to { opacity: 1; transform: translateY(0); }
    }
    @keyframes cue-bar {
      from { transform: scaleY(0); }
      to { transform: scaleY(1); }
    }
    @keyframes cue-soft {
      from { opacity: 0; transform: translateY(.3rem); }
      to { opacity: 1; transform: translateY(0); }
    }
    @keyframes theater-in {
      from { opacity: 0; transform: translateY(.65rem) scale(.985); }
      to { opacity: 1; transform: translateY(0) scale(1); }
    }
    @media (max-width: 40rem) {
      .sample-banner,
      .report-header,
      main { width: min(calc(100% - 20px), 68rem); }
      .sample-banner { align-items: flex-start; flex-direction: column; }
      .report-header {
        gap: .55rem;
        padding: .7rem 0 .45rem;
      }
      .session-framing { display: none; }
      .context-list {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        gap: .15rem;
      }
      .context-list div {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        align-items: baseline;
        min-height: 0;
        padding: .12rem 0;
        border-bottom: 1px solid rgba(30, 44, 37, .8);
      }
      .context-list dd { margin-top: 0; justify-self: end; font-size: .86rem; }
      .focused-evidence { grid-template-columns: 1fr; }
      .journey-preview { grid-template-columns: 1fr; gap: .35rem; margin-top: .65rem; }
      .journey-preview a { padding: .45rem .5rem; font-size: .88rem; }
      .event-timeline li { grid-template-columns: 1fr; gap: .1rem; }
      .practice-facts,
      .refilm-confirmations { grid-template-columns: 1fr; }
      .training-deck { grid-template-columns: 1fr; }
      [data-report-block] { margin-top: .75rem; padding: .85rem; }
      .next-move { padding-top: .9rem; }
      h1 { max-width: 20ch; margin: .1rem 0 .4rem; font-size: clamp(1.55rem, 7.5vw, 2.15rem); }
      .observation { margin: 0 0 .5rem; font-size: .98rem; }
      .coach-cue { padding: .6rem .75rem .6rem .85rem; font-size: .95rem; }
      .focused-evidence { margin-inline: 0; }
    }
    /* 1b — one job first, evidence collapsed, the re-film action pinned.
       Screen-scoped so print always keeps the desktop table and no bar. */
    @media screen and (max-width: 40rem) {
      .header-action { display: none; }
      .measured-table { display: none; }
      .measured-rows { display: grid; gap: .55rem; }
      .position-chip { top: 1.2rem; left: 1.2rem; }
      .action-bar {
        position: fixed;
        inset: auto 0 0 0;
        z-index: 6;
        display: flex;
        padding: .6rem 10px calc(.6rem + env(safe-area-inset-bottom, 0px));
        background: var(--paper);
        border-top: 1px solid var(--line);
        box-shadow: 0 -1px 2px rgba(var(--wash-rgb), .14);
      }
      .action-bar__link {
        display: inline-flex;
        flex: 1;
        align-items: center;
        justify-content: center;
        padding: .75rem 1rem;
        color: var(--paper);
        background: var(--ink);
        border-radius: .65rem;
        font-weight: 500;
        text-decoration: none;
      }
    }
    @media (prefers-reduced-motion: reduce) {
      html { scroll-behavior: auto; }
      *, *::before, *::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
      }
    }
    @media print {
      @page { margin: 12mm 11mm 14mm; }
      html { scroll-behavior: auto; }
      /* PRINT PUTS THE PALETTE BACK ON PAPER.
         A report is a document: it gets printed, saved to PDF and handed to a
         coach. A near-black page is unreadable on paper and empties a
         cartridge, so the screen palette is inverted here rather than only on
         a handful of rules — every existing rule and every future one follows
         from the token, so nothing has to be restated and nothing can be
         forgotten. Contrast on paper is the light system these values came
         from, unchanged.

         This block used to invert the WHOLE palette, because the screen was
         near-black and paper is not. Industry's screen ground is already
         paper, so almost all of that is gone and what is left is the handful
         of things a printer genuinely needs:

           - pure white, not #f2f2f3. Screen paper is a tone; printed paper is
             the absence of ink, and tinting every sheet costs a cartridge.
           - THE FIELD MUST NOT PRINT. The swing clip, evidence tiles and the
             priority panel are a near-black ground on screen and would come
             out as solid black rectangles — the single most expensive thing
             this block prevents. Flipping --surface-dark also means
             --field-ink has to flip with it, or the type inside those panels
             prints white on white.
           - the trace is a LIT steel, tuned for a dark ground; on white it is
             1.78 and vanishes, so it deepens.

         The signal needs no reset. It is steel now rather than amber, and
         5.78 on white is the same reading it gives on screen. */
      :root {
        --paper: #ffffff;
        --paper-lift: #ffffff;
        --canvas: #ffffff;
        --surface-dark: #ffffff;
        --field-ink: #1d1f20;
        --field-soft: #5d5d60;
        --field-muted: #626265;
        --field-rule: #d0d1d1;
        --trace: #2c455d;
        --shadow-sm: none;
        --shadow-md: none;
        --shadow-theater: none;
      }
      body {
        background: white;
        color: var(--ink);
        font-size: 10pt;
      }
      .sample-banner,
      .report-header,
      main { width: 100%; }
      .sample-banner { box-shadow: none; }
      [data-report-block] {
        box-shadow: none;
        border-radius: 0;
      }
      .media-theater {
        color: var(--ink);
        background: #fff;
        border: 1px solid var(--line);
        box-shadow: none;
      }
      .media-theater__title,
      .media-theater__lead,
      .media-theater__eyebrow,
      .media-theater__card figcaption,
      .media-theater__card p { color: var(--ink); }
      .screen-only,
      .report-actions,
      .report-control,
      video { display: none !important; }
      .print-only { display: block !important; }
      details > summary { display: none !important; }
      details:not([open]) > :not(summary) { display: block !important; }
      details::details-content {
        content-visibility: visible !important;
        height: auto !important;
      }
      .table-scroll { overflow: visible; }
      table { width: 100%; font-size: 8pt; }
      tr, img, figure, .phase-card, .practice-card, .refilm-card, .media-theater__card {
        break-inside: avoid;
        page-break-inside: avoid;
      }
      h1, h2, h3 {
        break-after: avoid;
        page-break-after: avoid;
      }
    }
  </style>
</head>
<body>
  {% if sample_banner %}
  <aside class="sample-banner" aria-label="Sample report">
    <span>{{ sample_banner.text }}</span>
    <a class="screen-only report-control" href="{{ sample_banner.cta_url }}">{{ sample_banner.cta_label }}</a>
  </aside>
  {% endif %}
  <a class="skip-link report-control" href="#report-main">Skip to report</a>
  <header class="report-header">
    <div class="report-brand-row">
      <div class="report-brand">
        <span class="report-brand__mark" aria-hidden="true">
          {# The drawn iron, emitted by store-assets/brand_mark.py's mark_svg()
             at 24px with no tile. Inlined because the report is a
             self-contained offline document and may not fetch an asset — but
             GENERATED and pasted, never hand-drawn: the previous version was a
             hand-inlined copy of the retired Tour Caddie dial, which is exactly
             the drift one-geometry-two-renderers exists to prevent, and it
             outlived the mark it copied by a whole brand.

             It renders at 20px, below the size rule's groove threshold, so
             groove_count() emits the silhouette alone. Fills are var() so the
             @media print inversion carries it without a second copy. #}
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" role="img" aria-label="CaddieInsight">
          <polygon points="12.94,2.43 16.34,2.43 16.14,8.04 13.14,8.04" fill="var(--ink)"/>
          <polygon points="13.54,7.71 15.74,7.71 15.54,17.94 13.74,17.94" fill="var(--ink)"/>
          <polygon points="13.54,15.96 15.74,15.96 15.94,17.94 12.64,17.94" fill="var(--ink)"/>
          <polygon points="15.63,17.94 15.63,22.56 14.91,22.66 14.19,22.73 13.48,22.78 12.76,22.81 12.04,22.82 11.32,22.81 10.61,22.78 9.89,22.73 9.17,22.66 8.45,22.56 7.76,21.90 7.61,21.81 7.48,21.69 7.41,21.53 7.38,21.36 7.41,21.18 7.48,21.02 7.61,20.90 7.76,20.81 9.20,18.63" fill="var(--ink)"/>
          <rect x="13.57" y="2.43" width="2.14" height="0.99" rx="0.49" fill="var(--ink)"/>
          <line x1="8.54" y1="21.24" x2="14.14" y2="21.24" stroke="var(--amber)" stroke-width="1.00"/>
          </svg>
        </span>
        <span class="report-brand__text">
          <span class="report-brand__name">{{ brand.name | upper }}</span>
          <span class="report-brand__tag">Private AI tour caddie</span>
        </span>
      </div>
      <span class="trust-chip">{{ view.trust.label }}</span>
      {% if view.outcome == "coaching_ready" and navigation.app_url %}
      <a class="header-action report-control screen-only"
         href="{{ navigation.app_url }}">{{ view.refilm.primary_action_label }}</a>
      {% endif %}
    </div>
    {% if depth.session_label %}
    <p class="session-line" data-field="session-label">{{ depth.session_label }}</p>
    {% endif %}
    <p class="session-framing">
      One priority. Matched evidence. A training block you can repeat under the same setup.
    </p>
    <dl class="context-list" aria-label="Swing context">
      {% if view.context.club_label %}
      <div><dt>Club</dt><dd>{{ view.context.club_label }}</dd></div>
      {% endif %}
      <div><dt>Hand</dt><dd>{{ view.context.hand | title }}</dd></div>
      <div><dt>Camera</dt><dd>{{ view.context.angle_label }}</dd></div>
      <div><dt>Detected</dt><dd>{{ view.context.detected_swings }}</dd></div>
      <div>
        <dt>Priority readable</dt>
        <dd>{{ view.context.priority_readable_swings }}</dd>
      </div>
      <div><dt>Trust</dt><dd>{{ view.trust.label }}</dd></div>
    </dl>
  </header>
  <main id="report-main">
    {% if view.outcome == "coaching_ready" %}
    {% set evidence = view.visual_evidence %}
    {% set measurement = evidence.supporting_measurement %}
    {# The P-system labels only the four events the engine measured
       (address, top, impact, finish). P2/P6/P9 are not measured and are
       never rendered — fabricating them would break the product's claim. #}
    {% set p_positions = {
      "address": "P1", "top": "P4", "impact": "P7", "finish": "P10",
    } %}
    {% set source_fps_rows = depth.session_details
       | selectattr("key", "equalto", "source_fps") | list %}
    {% set source_fps_value = source_fps_rows[0].value if source_fps_rows else none %}
    {% macro pass_meter_block(meter, extra_class="") %}
    <div class="pass-meter{{ extra_class }}" data-field="pass-meter">
      <p class="pass-meter__label">Pass mark · next matched re-film</p>
      <p class="pass-meter__target">
        <span aria-hidden="true">{{ meter.comparator }}</span>
        <span class="pass-meter__mark">{{ meter.mark_text }}</span>
        {% if meter.unit_label %}<span class="pass-meter__unit">{{ meter.unit_label }}</span>{% endif %}
      </p>
      <div class="pass-meter__track" role="img"
           aria-label="Measured now {{ meter.now_text }} against the pass mark {{ meter.mark_text }}">
        <div class="pass-meter__fill" style="width: {{ meter.fill_percent }}%"></div>
      </div>
      <p class="pass-meter__readout">
        <span>Now {{ meter.now_text }}</span>
        <span>Mark {{ meter.mark_text }}</span>
      </p>
    </div>
    {% endmacro %}
    <div class="report-columns">
    <div class="report-rail">
    <section class="next-move report-block--enter" data-report-block="next-move"
             data-canonical="priority" aria-labelledby="report-title">
      <p class="eyebrow">{{ view.next_move.eyebrow }}</p>
      {% if view.next_move.mode == "improve" %}
      <p class="priority-count" data-field="priority-count">
        Priority 01 · of {{ "%02d" | format(1 + depth.secondary_findings | length) }} findings
      </p>
      {% endif %}
      {% if view.next_move.mode == "protect" %}
      <p class="strength-label">Strength to protect</p>
      {% endif %}
      <h1 id="report-title" data-field="priority">{{ view.next_move.title }}</h1>
      <p class="observation" data-field="observation">{{ view.next_move.observation }}</p>
      <p class="coach-cue" data-field="cue">
        <strong>Caddie cue:</strong> {{ view.next_move.cue }}
      </p>
      {% if depth.pass_meter %}{{ pass_meter_block(depth.pass_meter) }}{% endif %}
      {% if measurement and view.next_move.measurement_detail_id == measurement.id %}
      <p><a class="report-control" href="#{{ measurement.id }}">See measurement</a></p>
      {% endif %}
      <ol class="journey-preview" aria-label="Your report journey">
        <li><a class="report-control" href="#understand">Understand</a></li>
        <li><a class="report-control" href="#practice">Practice</a></li>
        <li><a class="report-control" href="#refilm">Re-film</a></li>
      </ol>
    </section>

    <aside class="capture-context" aria-label="Capture context">
      <h2 class="capture-context__title">Capture context</h2>
      <dl class="capture-context__list">
        {% if view.context.club_label %}
        <div><dt>Club</dt><dd>{{ view.context.club_label }}</dd></div>
        {% endif %}
        <div><dt>View</dt><dd>{{ view.context.angle_label }}</dd></div>
        <div><dt>Handedness</dt><dd>{{ view.context.hand | title }}</dd></div>
        <div>
          <dt>Swings found</dt>
          <dd>{{ view.context.priority_readable_swings }} of {{ view.context.detected_swings }}</dd>
        </div>
      </dl>
    </aside>
    </div>

    <div class="report-evidence">
    <section id="understand" data-report-block="understand"
             aria-labelledby="understand-heading">
      <p class="step-label">1 · Evidence theater</p>
      <h2 id="understand-heading">See it in your swing</h2>
      {% if evidence.state == "rendered" %}
      {% set position_chip = namespace(text=none) %}
      {% for event in evidence.events %}
        {% if event.event in p_positions and evidence.timestamp_ms is not none
              and event.timestamp_ms == evidence.timestamp_ms %}
          {% set position_chip.text = p_positions[event.event] ~ " · " ~ event.label %}
        {% endif %}
      {% endfor %}
      <figure class="focused-evidence">
        {% if position_chip.text %}
        <span class="position-chip" data-field="position-chip">{{ position_chip.text }}</span>
        {% endif %}
        <img src="{{ media_path(evidence.media_key) }}" alt="{{ evidence.alt_text }}">
        <figcaption>
          <p class="evidence-meta">
            Swing {{ evidence.swing }} ·
            {{ evidence.phase | replace("_", " ") | title }} ·
            {{ phase_method_labels[evidence.phase_method] }}
          </p>
          <p><strong>Observed:</strong> {{ evidence.observed_label }}</p>
          {% if evidence.reference_label %}
          <p><strong>Starting reference:</strong> {{ evidence.reference_label }}</p>
          {% endif %}
          {% if evidence.boundary_label %}
          <p><strong>Coaching boundary:</strong> {{ evidence.boundary_label }}</p>
          {% endif %}
          <p data-evidence-tracking="{{ evidence.tracking_state }}">
            <strong>Tracking:</strong>
            {{ evidence.tracking_state | replace("_", " ") | title }}
          </p>
          <p>{{ evidence.observation }}</p>
        </figcaption>
      </figure>
      {% else %}
      <article class="visual-unavailable" role="note">
        <h3>Visual unavailable</h3>
        <p><strong>Observed:</strong> {{ evidence.observed_label }}</p>
        {% if evidence.reference_label %}
        <p><strong>Starting reference:</strong> {{ evidence.reference_label }}</p>
        {% endif %}
        {% if evidence.boundary_label %}
        <p><strong>Coaching boundary:</strong> {{ evidence.boundary_label }}</p>
        {% endif %}
        <p>{{ evidence.observation }}</p>
        <p><strong>Phase selected by:</strong> {{ phase_method_labels[evidence.phase_method] }}</p>
        <p data-evidence-tracking="{{ evidence.tracking_state }}">
          <strong>Tracking:</strong>
          {{ evidence.tracking_state | replace("_", " ") | title }}
        </p>
        {% if evidence.render_reasons %}
        <ul aria-label="Why the visual is unavailable">
          {% for reason in evidence.render_reasons %}
          <li>{{ reason | replace("_", " ") | capitalize }}</li>
          {% endfor %}
        </ul>
        {% endif %}
        {% if view.trust.explanation %}<p>{{ view.trust.explanation }}</p>{% endif %}
      </article>
      {% endif %}

      <p class="evidence-boundary">
        Observed and reference marks are 2D phone-video evidence, not a personalized ideal pose.
      </p>

      <dl class="evidence-counts" aria-label="Evidence coverage summary">
        <div><dt>Detected:</dt> <dd data-evidence-count="detected">{{ view.context.detected_swings }}</dd></div>
        <div><dt>Readable:</dt> <dd data-evidence-count="readable">{{ evidence.readable_swings }}</dd></div>
        {% if evidence.triggered_swings is not none %}
        <div><dt>Triggered:</dt> <dd data-evidence-count="triggered">{{ evidence.triggered_swings }}</dd></div>
        {% endif %}
      </dl>

      {% if evidence.events %}
      <ol class="event-timeline" aria-label="Detected swing events">
        {% for event in evidence.events %}
        <li data-event="{{ event.event }}">
          <strong>{% if event.event in p_positions %}<span class="event-p">{{ p_positions[event.event] }}</span>{% endif %}{{ event.label }}</strong>
          <time data-event-timestamp="{{ event.timestamp_ms }}">{{ event.timestamp_ms }} ms</time>
          <span>{{ phase_method_labels[event.method] }}</span>
        </li>
        {% endfor %}
      </ol>
      {% endif %}

      {# The panel's heading and its cards must be decided by the same data.
         Opening on `view.capabilities` (derived from the media manifest) while
         the cards loop over `depth.swings` let a free report render the premium
         dark panel, its eyebrow, title and lead, and then nothing at all: every
         card was skipped as `replay_locked` even though the slow motion the
         golfer is entitled to was sitting right there. Decide from the swings. #}
      {% set theater = namespace(playable=false, locked=false, locked_poster=none) %}
      {% for swing in depth.swings %}
        {% if swing.slow_motion_media_key or swing.coach_replay_media_key %}{% set theater.playable = true %}{% endif %}
        {% if swing.replay_locked %}
          {% set theater.locked = true %}
          {% if theater.locked_poster is none %}{% set theater.locked_poster = swing.video_poster_media_key %}{% endif %}
        {% endif %}
      {% endfor %}
      {% if theater.playable %}
      <aside class="media-theater" aria-label="Evidence theater playback">
        <p class="media-theater__eyebrow">Evidence theater</p>
        <h3 class="media-theater__title">Slow-mo and replay</h3>
        <p class="media-theater__lead">
          Study your own clip before you train. Slow motion shows the priority window; coach replay keeps the full motion honest. This is phone-video playback — not a 3D model or ball-flight estimate.
        </p>
        <div class="media-theater__grid">
          {% for swing in depth.swings %}
            {# Slow motion is a Free feature — only the annotated replay is
               gated, so the lock is checked per figure, never per swing. #}
            {% if swing.slow_motion_media_key %}
            <figure class="media-theater__card screen-only">
              <span class="media-theater__badge">Slow motion{% if playback_speed_label %} · {{ playback_speed_label }}{% endif %}{% if source_fps_value %} · {{ source_fps_value }} source{% endif %}</span>
              <video controls preload="metadata"
                     src="{{ media_path(swing.slow_motion_media_key) }}"
                     {% if swing.video_poster_media_key %}poster="{{ media_path(swing.video_poster_media_key) }}"{% endif %}
                     aria-label="{{ swing.slow_motion_caption }}"></video>
              <figcaption>{{ swing.slow_motion_caption }}</figcaption>
            </figure>
            {% if swing.video_poster_media_key %}
            <figure class="media-theater__card print-only">
              <span class="media-theater__badge">Slow motion</span>
              <img src="{{ media_path(swing.video_poster_media_key) }}"
                   alt="{{ swing.video_poster_alt_text }}">
              <figcaption>{{ swing.slow_motion_caption }} · {{ swing.print_playback_reference }}</figcaption>
            </figure>
            {% else %}
            <p class="print-only">{{ swing.slow_motion_caption }} · {{ swing.print_playback_reference }}</p>
            {% endif %}
            {% endif %}
            {% if swing.coach_replay_media_key %}
            <figure class="media-theater__card screen-only">
              <span class="media-theater__badge">Coach replay</span>
              <video controls preload="metadata"
                     src="{{ media_path(swing.coach_replay_media_key) }}"
                     {% if swing.video_poster_media_key %}poster="{{ media_path(swing.video_poster_media_key) }}"{% endif %}
                     aria-label="{{ swing.coach_replay_caption }}"></video>
              <figcaption>{{ swing.coach_replay_caption }}</figcaption>
            </figure>
            {% if swing.video_poster_media_key %}
            <figure class="media-theater__card print-only">
              <span class="media-theater__badge">Coach replay</span>
              <img src="{{ media_path(swing.video_poster_media_key) }}"
                   alt="{{ swing.video_poster_alt_text }}">
              <figcaption>{{ swing.coach_replay_caption }} · {{ swing.print_playback_reference }}</figcaption>
            </figure>
            {% else %}
            <p class="print-only">{{ swing.coach_replay_caption }} · {{ swing.print_playback_reference }}</p>
            {% endif %}
            {% endif %}
          {% endfor %}
          {% if theater.locked %}
          {# One card for the whole session, not one per swing: this is an
             offer, and repeating it beside every clip turns the panel into a
             wall of locks. Screen-only, because a printed page cannot be
             clicked — the same call the legacy report makes. #}
          <figure class="media-theater__card media-theater__card--locked screen-only">
            <span class="media-theater__badge">Coach replay · locked</span>
            {% if theater.locked_poster %}
            <div class="media-theater__poster">
              {# The golfer's own unannotated frame, dimmed under a lock. It is
                 never dressed up to look like the annotated replay — implying
                 a render that was not produced would be fabricated proof. The
                 alt is empty because this exact frame already carries its alt
                 text on the slow-motion card above; the caption is the content. #}
              <img src="{{ media_path(theater.locked_poster) }}" alt="">
              <span class="media-theater__lock" aria-hidden="true">&#128274;</span>
            </div>
            {% endif %}
            <figcaption>
              Your own footage played back with the tracked body, the hand path, and the measured numbers appearing at each swing event.
              <a class="report-control" href="/pricing">See the plans that include it</a>
            </figcaption>
          </figure>
          {% endif %}
        </div>
      </aside>
      {% endif %}

      {% if measurement %}
      <details class="measurement-detail" id="{{ measurement.id }}">
        <summary>See measurement</summary>
        <p><strong>{{ measurement.label }}:</strong> {{ measurement.plain_value }}</p>
        {% if measurement.benchmark_label %}<p>{{ measurement.benchmark_label }}</p>{% endif %}
        <p>{{ measurement.explanation }}</p>
        {% if measurement.limitation %}<p>{{ measurement.limitation }}</p>{% endif %}
      </details>
      {% endif %}

      <div class="phase-list" aria-label="Whole-swing breakdown">
        {% for phase in view.phases %}
        <details class="phase-card phase-card--{{ phase.status }}"
                 data-phase-id="{{ phase.id }}"
                 {% if phase.expanded_by_default %}open{% endif %}>
          <summary>
            <span>{{ phase.label }}</span>
            <span class="status">
              <span aria-hidden="true">{{ status_icons[phase.status] }}</span>
              {{ phase.status_label }}
            </span>
          </summary>
          <p>{{ phase.summary }}</p>
          <p>{{ phase.readable_swings }} readable swing{% if phase.readable_swings != 1 %}s{% endif %}</p>
          {% if phase.unavailable_reasons %}
          <ul aria-label="Why this phase was not measured">
            {% for reason in phase.unavailable_reasons %}
            <li>{{ reason | replace("_", " ") | capitalize }}</li>
            {% endfor %}
          </ul>
          {% endif %}
        </details>
        {% endfor %}
      </div>

      <details class="video-limitations">
        <summary>What this video can measure</summary>
        <ul>
          {% for limitation in depth.limitations %}<li>{{ limitation }}</li>{% endfor %}
        </ul>
      </details>
    </section>

    {% if depth.measured_rows %}
    {% set has_prior = depth.measured_rows | selectattr("prior_value") | list | length > 0 %}
    <section id="measured" data-report-block="measured"
             aria-labelledby="measured-heading">
      <h2 id="measured-heading">Measured this session</h2>
      <div class="table-scroll measured-table" role="region"
           aria-label="Measured this session" tabindex="0">
        <table>
          <thead>
            <tr>
              <th scope="col">Metric</th>
              <th scope="col">This clip</th>
              {% if has_prior %}
              <th scope="col">Last matched{% if depth.measured_prior_label %} · {{ depth.measured_prior_label }}{% endif %}</th>
              <th scope="col" aria-label="Change"><span aria-hidden="true">Δ</span></th>
              {% endif %}
              <th scope="col">Noise floor</th>
            </tr>
          </thead>
          <tbody>
            {% for row in depth.measured_rows %}
            <tr data-measured-metric="{{ row.metric_id }}">
              <th scope="row">{{ row.label }}</th>
              <td class="measured-value">{{ row.value }}</td>
              {% if has_prior %}
              <td class="measured-prior">{{ row.prior_value if row.prior_value is not none else "—" }}</td>
              <td class="measured-delta{% if row.in_noise %} measured-delta--noise{% endif %}">
                {%- if row.delta is not none %}{{ row.delta }}{% if row.in_noise %} · in noise{% endif %}{% else %}—{% endif -%}
              </td>
              {% endif %}
              <td class="measured-floor">{{ row.noise_floor if row.noise_floor is not none else "—" }}</td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
      {# The same measured rows, collapsed for one-hand phone reading.
         Exactly one of the two renderings is displayed at any width; print
         always keeps the table. #}
      <div class="measured-rows">
        {% for row in depth.measured_rows %}
        <details class="measured-row" data-measured-metric="{{ row.metric_id }}">
          <summary>
            <span class="measured-row__label">{{ row.label }}</span>
            <span class="measured-row__reading">
              <span class="measured-value">{{ row.value }}</span>
              {% if row.delta is not none %}
              <span class="measured-delta{% if row.in_noise %} measured-delta--noise{% endif %}">{{ "in noise" if row.in_noise else row.delta }}</span>
              {% endif %}
            </span>
          </summary>
          <dl class="measured-row__detail">
            {% if row.prior_value is not none %}
            <div>
              <dt>Last matched{% if depth.measured_prior_label %} · {{ depth.measured_prior_label }}{% endif %}</dt>
              <dd>{{ row.prior_value }}</dd>
            </div>
            {% endif %}
            {% if row.delta is not none %}
            <div><dt>Change</dt><dd>{{ row.delta }}{% if row.in_noise %} · in noise{% endif %}</dd></div>
            {% endif %}
            <div><dt>Noise floor</dt><dd>{{ row.noise_floor if row.noise_floor is not none else "—" }}</dd></div>
          </dl>
        </details>
        {% endfor %}
      </div>
      {% set uses_sw = namespace(found=false) %}
      {% for row in depth.measured_rows %}
        {% if " sw" in row.value %}{% set uses_sw.found = true %}{% endif %}
      {% endfor %}
      <p class="measured-footnote">
        {% if uses_sw.found %}sw = shoulder widths. {% endif %}Changes inside the noise floor are shown but not called improved.
      </p>
    </section>
    {% endif %}
    </div>
    </div>

    <section id="practice" data-report-block="practice"
             data-canonical="practice" aria-labelledby="practice-heading">
      <p class="step-label">2 · Today's training</p>
      <h2 id="practice-heading" data-field="drill-name">{{ view.practice.name }}</h2>
      {# Tags restate context the report already owns: the selected priority's
         display name, and the golfer-supplied experience level when present.
         The drill itself has no difficulty field, so none is invented. #}
      {% set level_rows = depth.session_details
         | selectattr("key", "equalto", "level") | list %}
      <div class="drill-tags" aria-label="Drill context">
        <span class="drill-tag drill-tag--priority">{{ view.next_move.title }}</span>
        {% if level_rows %}<span class="drill-tag">{{ level_rows[0].value }}</span>{% endif %}
      </div>
      <p class="practice-lead">{{ view.practice.aim }}</p>
      <ol class="practice-summary" aria-label="Drill steps">
        {% for step in view.practice.summary_steps %}<li>{{ step }}</li>{% endfor %}
      </ol>
      <div class="training-deck" aria-label="Training essentials">
        <article class="training-card training-card--dosage">
          <span class="training-card__label">Dosage</span>
          <p>{{ view.practice.dosage }}</p>
        </article>
        <article class="training-card training-card--feel">
          <span class="training-card__label">Feel cue</span>
          <p>{{ view.practice.feel_cue }}</p>
        </article>
        <article class="training-card training-card--pass">
          <span class="training-card__label">Pass mark</span>
          <p><a class="report-control" href="#refilm">Confirm the matched re-film target</a></p>
        </article>
      </div>
      <dl class="practice-facts">
        <dt>Setup</dt><dd>{{ view.practice.setup }}</dd>
        <dt>Feel cue</dt><dd>{{ view.practice.feel_cue }}</dd>
        <dt>Dosage</dt>
        <dd>
          <div class="practice-dosage-callout">
            <span>Session dosage</span>
            {{ view.practice.dosage }}
          </div>
        </dd>
        {% if view.practice.equipment %}<dt>Equipment</dt><dd>{{ view.practice.equipment }}</dd>{% endif %}
      </dl>
      {# The report bundle carries no product name and no price — only the
         matched gear collection link — and it must not fetch at render time,
         so this line names the link and nothing more. The priced product
         line belongs to the live status page. #}
      {% set inline_gear = optional_by_id.get("gear") %}
      {% if inline_gear and inline_gear.available and not inline_gear.locked and depth.gear %}
      <p class="drill-gear" data-field="drill-gear">
        Optional aid for this drill:
        <a class="report-control" href="{{ depth.gear[0].url }}">{{ depth.gear[0].label }}</a>
      </p>
      {% endif %}
      {% if view.practice.illustration_media_key %}
      <figure class="drill-illustration">
        <img src="{{ media_path(view.practice.illustration_media_key) }}"
             alt="Instructional illustration — not your measured pose">
        <figcaption>Instructional illustration — not your measured pose</figcaption>
      </figure>
      {% endif %}
      {% if view.practice.full_steps != view.practice.summary_steps %}
      <details class="practice-detail">
        <summary>Full drill steps</summary>
        <ol>{% for step in view.practice.full_steps %}<li>{{ step }}</li>{% endfor %}</ol>
      </details>
      {% endif %}
      {% set alternative_section = optional_by_id.get("alternative_drills") %}
      {% if alternative_section and (alternative_section.available or alternative_section.locked) %}
      {# A locked section's item count is structurally 0 — the gate removes the
         items before the template sees them — so the suffix only ever reads as
         "· 0" and makes a paywall look like a failure. Show it when there is
         something to count. #}
      <details class="alternatives" data-optional-section="alternative_drills">
        <summary>{{ alternative_section.label }}{% if not alternative_section.locked %} · {{ alternative_section.item_count }}{% endif %}</summary>
        {% if alternative_section.locked %}
        <p>This section is locked.</p>
        {% else %}
        {% for alternative in view.practice.alternatives %}
        <article>
          <h3>{{ alternative.name }}</h3>
          <p>{{ alternative.aim }}</p>
        </article>
        {% endfor %}
        {% endif %}
      </details>
      {% endif %}
      <p><a class="report-control" href="#refilm">Ready to re-film</a></p>
    </section>

    <section id="refilm" data-report-block="refilm"
             data-canonical="refilm" aria-labelledby="refilm-heading">
      <p class="step-label">3 · Prove it</p>
      <h2 id="refilm-heading">Repeat the same test</h2>
      <ol class="refilm-checklist">
        {% for item in view.refilm.checklist %}<li>{{ item }}</li>{% endfor %}
      </ol>
      <h3>Pass mark</h3>
      <p class="pass-mark" data-field="pass-mark">{{ view.refilm.target.text }}</p>
      {% if depth.pass_meter %}{{ pass_meter_block(depth.pass_meter, " pass-meter--paper") }}{% endif %}
      <dl class="refilm-confirmations" aria-label="Re-film controls">
        <dt>Same club</dt><dd>{{ "Confirmed" if view.refilm.preserves_club else "Use the club named above" }}</dd>
        <dt>Same hand</dt><dd>{{ "Confirmed" if view.refilm.preserves_hand else "Match the original hand" }}</dd>
        <dt>Same camera angle</dt><dd>{{ "Confirmed" if view.refilm.preserves_angle else "Match the original angle" }}</dd>
        <dt>Same camera height</dt><dd>{{ "Confirmed" if view.refilm.preserves_camera_height else "Match the original height" }}</dd>
        <dt>Same framing</dt><dd>{{ "Confirmed" if view.refilm.preserves_framing else "Match the original framing" }}</dd>
        <dt>Same effort</dt><dd>{{ "Confirmed" if view.refilm.preserves_effort else "Match the original effort" }}</dd>
      </dl>
      {% if navigation.app_url %}
      <a class="primary-action report-control" href="{{ navigation.app_url }}">{{ view.refilm.primary_action_label }}</a>
      {% else %}
      <p class="primary-action" role="note" data-offline-action="true">{{ view.refilm.primary_action_label }}</p>
      {% endif %}
    </section>

    <section class="optional-depth" aria-label="More report detail">
      {% set section = optional_by_id.get("every_swing") %}
      {% if section and (section.available or section.locked) %}
      <details class="optional-card" data-optional-section="every_swing">
        <summary>{{ section.label }}{% if not section.locked %} · {{ section.item_count }}{% endif %}</summary>
        {% if section.locked %}
        <p>This section is locked.</p>
        {% else %}
        {% for swing in depth.swings %}
        <article>
          <h3>{{ swing.summary }}</h3>
          {% if swing.key_positions_media_key %}
          <img src="{{ media_path(swing.key_positions_media_key) }}" alt="{{ swing.key_positions_alt_text }}">
          {% endif %}
          {% if swing.notes %}<ul>{% for note in swing.notes %}<li>{{ note }}</li>{% endfor %}</ul>{% endif %}
          {% if swing.measurements %}
          <dl>{% for item in swing.measurements %}<dt>{{ item.label }}</dt><dd>{{ item.value }}</dd>{% endfor %}</dl>
          {% endif %}
        </article>
        {% endfor %}
        {% endif %}
      </details>
      {% endif %}

      {% set section = optional_by_id.get("replay") %}
      {% if section and (section.available or section.locked) %}
      <details class="optional-card" data-optional-section="replay">
        <summary>{{ section.label }}{% if not section.locked %} · {{ section.item_count }}{% endif %}</summary>
        {% if section.locked %}
          {# billing.replay_pro_only strips every COACH_REPLAY entry from the
             media manifest upstream, so the count is structurally 0 and used
             to render as "Coach replay · 0" over one sentence repeated per
             detected swing — which reads as a broken section, not an offer.
             Say what the replay is once, name no price and no tier (the
             annotated replay is moving between tiers), and send the golfer to
             /pricing, the one page allowed to quote a number. #}
          {% set locked_notes = depth.swings | map(attribute="locked_replay_explanation") | select | list %}
          <div class="replay-locked-note">
            <span class="lock-badge">&#128274; Coach replay is locked</span>
            {# Promise exactly what annotate.py draws, in the same words the
               unlocked caption uses: the tracked body, the hand path (wrist
               centroid — an image-plane measurement, never a club path), and
               the metric chips that appear at each swing event. #}
            <p>The coach replay is this same footage played back with your
            tracked body, your hand path, and the measured numbers appearing at
            each swing event — your own swing, annotated like a lesson.</p>
            <p>It is rendered at analysis time rather than on demand, so a plan
            that includes it has to be active before you re-film.</p>
            {% if locked_notes %}<p>{{ locked_notes[0] }}</p>{% endif %}
            <a class="report-control" href="/pricing">See the plans that include coach replay →</a>
          </div>
        {% else %}
          {% for swing in depth.swings %}
          <article>
            <h3>{{ swing.summary }}</h3>
            {% if swing.replay_locked %}
            <p>{{ swing.locked_replay_explanation }}</p>
            {% else %}
              {% if swing.slow_motion_media_key %}
              <div class="screen-only">
                <video controls preload="metadata"
                       src="{{ media_path(swing.slow_motion_media_key) }}"
                       {% if swing.video_poster_media_key %}poster="{{ media_path(swing.video_poster_media_key) }}"{% endif %}
                       aria-label="{{ swing.slow_motion_caption }}"></video>
                <p>{{ swing.slow_motion_caption }}</p>
              </div>
              {% if swing.video_poster_media_key %}
              <figure class="print-only playback-print">
                <img src="{{ media_path(swing.video_poster_media_key) }}"
                     alt="{{ swing.video_poster_alt_text }}">
                <figcaption>{{ swing.slow_motion_caption }} · {{ swing.print_playback_reference }}</figcaption>
              </figure>
              {% else %}
              <p class="print-only">{{ swing.slow_motion_caption }} · {{ swing.print_playback_reference }}</p>
              {% endif %}
              {% endif %}
              {% if swing.coach_replay_media_key %}
              <div class="screen-only">
                <video controls preload="metadata"
                       src="{{ media_path(swing.coach_replay_media_key) }}"
                       {% if swing.video_poster_media_key %}poster="{{ media_path(swing.video_poster_media_key) }}"{% endif %}
                       aria-label="{{ swing.coach_replay_caption }}"></video>
                <p>{{ swing.coach_replay_caption }}</p>
              </div>
              {% if swing.video_poster_media_key %}
              <figure class="print-only playback-print">
                <img src="{{ media_path(swing.video_poster_media_key) }}"
                     alt="{{ swing.video_poster_alt_text }}">
                <figcaption>{{ swing.coach_replay_caption }} · {{ swing.print_playback_reference }}</figcaption>
              </figure>
              {% else %}
              <p class="print-only">{{ swing.coach_replay_caption }} · {{ swing.print_playback_reference }}</p>
              {% endif %}
              {% endif %}
            {% endif %}
          </article>
          {% endfor %}
        {% endif %}
      </details>
      {% endif %}

      {% set section = optional_by_id.get("swing_pattern") %}
      {% if section and (section.available or section.locked) %}
      <details class="optional-card" data-optional-section="swing_pattern">
        <summary>{{ section.label }}{% if not section.locked %} · {{ section.item_count }}{% endif %}</summary>
        {% if section.locked %}
          {# Same contract as the replay lock: name what the section is,
             quote no tier and no price (this HTML is written once and
             kept), and send the golfer to /pricing. A locked pattern is
             never computed upstream, so there is nothing to leak here. #}
          <div class="replay-locked-note">
            <span class="lock-badge">&#128274; Swing Pattern is locked</span>
            <p>The Swing Pattern names how this swing is built, from the same
            measurements shown above: whether the pelvis turn or the lead arm
            peaks first in the downswing, how far the lower body travels going
            back, how steady the head stays, the tempo character, and whether
            the finish holds still.</p>
            <p>Nothing in the coaching above is withheld — the priority, the
            drill, the pass mark and every measurement here are complete.</p>
            <a class="report-control" href="/pricing">See the plans that include the Swing Pattern →</a>
          </div>
        {% elif depth.swing_pattern %}
          <article class="swing-pattern">
            <h3>{{ depth.swing_pattern.name }}</h3>
            <p>{{ depth.swing_pattern.summary }}</p>
            <dl>
              {% for axis in depth.swing_pattern.axes %}
              <dt>{{ axis.label }}</dt>
              <dd><strong>{{ axis.display }}</strong> — {{ axis.detail }}</dd>
              {% endfor %}
            </dl>
            {% if depth.swing_pattern.unreadable %}
            <p>Not readable from this clip: {{ depth.swing_pattern.unreadable | join(", ") }}.</p>
            {% endif %}
            {% if depth.swing_pattern.note %}<p>{{ depth.swing_pattern.note }}</p>{% endif %}
          </article>
        {% endif %}
      </details>
      {% endif %}

      {% set section = optional_by_id.get("secondary_findings") %}
      {% if section and (section.available or section.locked) %}
      <details class="optional-card" data-optional-section="secondary_findings">
        <summary>{{ section.label }}{% if not section.locked %} · {{ section.item_count }}{% endif %}</summary>
        {% if section.locked %}<p>This section is locked.</p>{% else %}
        {% for finding in depth.secondary_findings %}
        <article><h3>{{ finding.title }}</h3><p>{{ finding.summary }}</p><p>{{ finding.why }}</p><p><strong>Cue:</strong> {{ finding.cue }}</p></article>
        {% endfor %}
        {% endif %}
      </details>
      {% endif %}

      {% set section = optional_by_id.get("more_strengths") %}
      {% if section and (section.available or section.locked) %}
      <details class="optional-card" data-optional-section="more_strengths">
        <summary>{{ section.label }}{% if not section.locked %} · {{ section.item_count }}{% endif %}</summary>
        {% if section.locked %}<p>This section is locked.</p>{% else %}
        {% for strength in depth.strengths %}<article><h3>{{ strength.title }}</h3><p>{{ strength.summary }}</p></article>{% endfor %}
        {% endif %}
      </details>
      {% endif %}

      {% set section = optional_by_id.get("measurements") %}
      {% if section and (section.available or section.locked) %}
      <details class="optional-card" data-optional-section="measurements">
        <summary>{{ section.label }}{% if not section.locked %} · {{ section.item_count }}{% endif %}</summary>
        {% if section.locked %}<p>This section is locked.</p>{% else %}
        <div class="table-scroll" role="region" aria-label="Session measurements" tabindex="0">
          <table>
            <caption>Session details and measurements</caption>
            <thead><tr><th scope="col">Item</th><th scope="col">Value</th></tr></thead>
            <tbody>
              {% for item in depth.session_details %}<tr><th scope="row">{{ item.label }}</th><td>{{ item.value }}</td></tr>{% endfor %}
              {% for item in depth.measurements %}<tr><th scope="row">{{ item.label }}</th><td>{{ item.value }}</td></tr>{% endfor %}
            </tbody>
          </table>
        </div>
        {% for phase in view.phases %}{% for detail in phase.measurements %}
        <article><h3>{{ detail.label }}</h3><p>{{ detail.plain_value }}</p><p>{{ detail.explanation }}</p><p>{{ detail.limitation }}</p></article>
        {% endfor %}{% endfor %}
        <ul>{% for limitation in depth.limitations %}<li>{{ limitation }}</li>{% endfor %}</ul>
        {% endif %}
      </details>
      {% endif %}

      {% set section = optional_by_id.get("glossary") %}
      {% if section and (section.available or section.locked) %}
      <details class="optional-card" data-optional-section="glossary">
        <summary>{{ section.label }}{% if not section.locked %} · {{ section.item_count }}{% endif %}</summary>
        {% if section.locked %}<p>This section is locked.</p>{% else %}
        <dl>{% for entry in depth.glossary %}<dt>{{ entry.term }}</dt><dd>{{ entry.definition }}</dd>{% endfor %}</dl>
        {% endif %}
      </details>
      {% endif %}

      {% set section = optional_by_id.get("gear") %}
      {% if section and section.available and not section.locked %}
      <details class="optional-card" data-optional-section="gear">
        <summary>{{ section.label }}{% if not section.locked %} · {{ section.item_count }}{% endif %}</summary>
        {% if section.locked %}<p>This section is locked.</p>{% else %}
        {% for item in depth.gear %}<article><h3>{{ item.label }}</h3><p>{{ item.description }}</p><a class="report-control" href="{{ item.url }}">View gear</a></article>{% endfor %}
        {% endif %}
      </details>
      {% endif %}
    </section>

    {% if navigation.app_url %}
    {# 1b's sticky footer: the same server-owned re-film action, pinned on
       small screens only. Carries no state of its own. #}
    <div class="action-bar screen-only">
      <a class="action-bar__link report-control"
         href="{{ navigation.app_url }}">{{ view.refilm.primary_action_label }}</a>
    </div>
    {% endif %}
    {% else %}
    <section class="capture-recovery" data-report-block="capture-recovery" aria-labelledby="report-title">
      <p class="eyebrow">{{ view.trust.label }}</p>
      <h1 id="report-title">{{ view.capture_guidance.reason_label }}</h1>
      <p>{{ view.capture_guidance.explanation }}</p>
      <div class="capture-correction">
        <h2>Change this for the next video</h2>
        <p>{{ view.capture_guidance.correction }}</p>
      </div>
      <section aria-labelledby="capture-checklist">
        <h2 id="capture-checklist">Quick filming checklist</h2>
        <ul>{% for item in view.capture_guidance.checklist %}<li>{{ item }}</li>{% endfor %}</ul>
      </section>
      {% for swing in depth.swings %}
        {% if swing.slow_motion_media_key and swing.slow_motion_media_key in view.capture_guidance.safe_media_keys %}
        <aside class="media-theater" aria-label="Evidence theater playback">
          <p class="media-theater__eyebrow">Evidence theater</p>
          <h3 class="media-theater__title">Check the capture before you re-film</h3>
          <p class="media-theater__lead">
            Use this clip to verify framing and setup. It is your phone video — not a coaching diagnosis.
          </p>
          <figure class="capture-playback media-theater__card screen-only" data-capture-playback="{{ swing.slow_motion_media_key }}">
            <video controls preload="metadata" src="{{ media_path(swing.slow_motion_media_key) }}"
                   {% if swing.video_poster_media_key and swing.video_poster_media_key in view.capture_guidance.safe_media_keys %}poster="{{ media_path(swing.video_poster_media_key) }}"{% endif %}
                   aria-label="{{ swing.video_poster_alt_text or swing.slow_motion_caption }}"></video>
            <figcaption>{{ swing.slow_motion_caption }}</figcaption>
          </figure>
          {% if swing.video_poster_media_key and swing.video_poster_media_key in view.capture_guidance.safe_media_keys %}
          <figure class="capture-playback print-only">
            <img src="{{ media_path(swing.video_poster_media_key) }}"
                 alt="{{ swing.video_poster_alt_text }}">
            <figcaption>{{ swing.slow_motion_caption }} · {{ swing.print_playback_reference }}</figcaption>
          </figure>
          {% else %}
          <p class="print-only">{{ swing.slow_motion_caption }} · {{ swing.print_playback_reference }}</p>
          {% endif %}
        </aside>
        {% endif %}
      {% endfor %}
      <div class="capture-actions">
        {% if navigation.app_url %}
        <a class="primary-action report-control" data-capture-action="primary" href="{{ navigation.app_url }}">{{ view.capture_guidance.primary_action_label }}</a>
        {% if view.capture_guidance.secondary_action_label %}<a class="report-control" data-capture-action="secondary" href="{{ navigation.app_url }}">{{ view.capture_guidance.secondary_action_label }}</a>{% endif %}
        {% else %}
        <p role="note">{{ view.capture_guidance.primary_action_label }}</p>
        {% endif %}
      </div>
    </section>
    {% endif %}
  </main>
</body>
</html>
