{% extends "web_layout.html.j2" %}
{% block title %}{{ brand.name }} — Account{% endblock %}
{% block style %}
  main { max-width: 1120px; }
  .account-shell { display: grid; gap: var(--sl-space-5); }

  {# The masthead is a well, not a hero. It used to be a green gradient with a
     warm radial bloom and white ink — a light-era "premium" flourish that on
     the dark field just reads as a second, muddier background. It is the
     deepest surface on the page now, with the same 8px technical grid the
     shell paints under everything, so the ruled panels below sit ON something
     rather than float. #}
  .account-header {
    position: relative;
    overflow: hidden;
    padding: clamp(var(--sl-space-5), 4vw, var(--sl-space-7));
    border: 1px solid var(--sl-border-strong);
    border-radius: var(--sl-radius-lg);
    background: var(--sl-night);
    color: var(--sl-ink);
    box-shadow: var(--sl-shadow-lg);
  }
  .account-header__copy { position: relative; z-index: 1; max-width: 760px; }
  {# Eyebrows on this page are muted bone, not the shell's amber. Amber marks a
     value the engine measured; a section label is decoration, and spending the
     signal colour on five of them leaves nothing to mark the one real
     measurement on the page (the monthly allowance). #}
  .account-shell .sl-eyebrow {
    margin: 0 0 var(--sl-space-2);
    color: var(--sl-ink-muted);
    font-family: var(--sl-font-mono);
    font-size: var(--sl-eyebrow-size);
    font-weight: 500;
    letter-spacing: var(--sl-eyebrow-track);
    text-transform: uppercase;
  }
  .account-header h1 {
    margin: 0;
    color: var(--sl-ink);
    font-family: var(--sl-font-display);
    font-size: var(--sl-heading-display);
    letter-spacing: -.02em;
    line-height: 1;
    text-transform: uppercase;
  }
  {# Identity line: the account this instrument is reading. Mono, because it is
     a fixed identifier, and ruled off the title so it reads as a readout head. #}
  .account-header__summary {
    margin: var(--sl-space-4) 0 0;
    padding-top: var(--sl-space-4);
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--sl-space-2);
    border-top: 1px solid var(--sl-border-strong);
    color: var(--sl-ink-soft);
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-sm);
    overflow-wrap: anywhere;
  }
  .account-header__summary [aria-hidden="true"] { color: var(--sl-ink-muted); }
  .account-plan {
    display: inline-flex;
    align-items: center;
    padding: 4px 9px;
    border: 1px solid transparent;
    border-radius: var(--sl-radius-control);
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-xs);
    font-weight: 500;
    letter-spacing: .1em;
    line-height: 1.25;
    text-transform: uppercase;
  }
  {# Pro is a filled bone stamp; Free is the same chip left hollow. Neither is
     amber — a plan is a state, not a measurement. #}
  .account-header .account-plan--pro,
  .account-card .account-plan--pro { border-color: var(--sl-ink); background: var(--sl-ink); color: var(--sl-night); }
  .account-header .account-plan--free,
  .account-card .account-plan--free { border-color: var(--sl-control-border); background: transparent; color: var(--sl-ink-soft); }

  {# Flash notices: a flagged row, marked by a bone rule on the leading edge
     rather than by a pale green wash that no longer exists on this field. #}
  .account-notice {
    padding: var(--sl-space-3) var(--sl-space-4);
    border: 1px solid var(--sl-border);
    border-left: 3px solid var(--sl-ink);
    border-radius: var(--sl-radius-sm);
    background: var(--sl-orange-soft);
    color: var(--sl-ink);
    font-size: var(--sl-text-sm);
  }
  .account-notice strong { color: var(--sl-ink); font-weight: 500; }

  {# The panel matrix. One shared rule colour behind the grid and an opaque
     card in every cell, so the 1px gaps ARE the hairlines — no card ever draws
     its own border, and no two adjacent borders double up into 2px. #}
  .account-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1px;
    align-items: stretch;
    overflow: hidden;
    border: 1px solid var(--sl-border);
    border-radius: var(--sl-radius-lg);
    background: var(--sl-border);
    box-shadow: var(--sl-shadow-sm), var(--sl-shadow-md);
  }
  .account-card {
    min-width: 0;
    height: 100%;
    padding: clamp(var(--sl-space-4), 3vw, var(--sl-space-6));
    display: flex;
    flex-direction: column;
    background: var(--sl-bg-card);
  }
  .account-card--wide { grid-column: 1 / -1; }
  .account-card__header {
    margin-bottom: var(--sl-space-4);
    padding-bottom: var(--sl-space-3);
    border-bottom: 1px solid var(--sl-border);
  }
  .account-card__header h2 {
    margin: 0;
    color: var(--sl-ink);
    font-family: var(--sl-font-display);
    font-size: var(--sl-text-xl);
    letter-spacing: -.02em;
  }
  .account-card__header p { margin: var(--sl-space-2) 0 0; color: var(--sl-ink-soft); font-size: var(--sl-text-sm); }

  {# Fact cells. auto-fit rather than a fixed two-column track: these lists run
     one to four rows long, and a fixed grid leaves an empty cell that paints as
     a solid block of rule colour. auto-fit lets the last cell take the slack. #}
  .account-facts {
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
    gap: 1px;
    overflow: hidden;
    border: 1px solid var(--sl-border);
    border-radius: var(--sl-radius-sm);
    background: var(--sl-border);
  }
  .account-row {
    display: grid;
    align-content: start;
    gap: var(--sl-space-1);
    padding: var(--sl-space-3);
    background: var(--sl-bg-card);
  }
  .account-row dt {
    color: var(--sl-ink-muted);
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-xs);
    font-weight: 500;
    letter-spacing: .12em;
    text-transform: uppercase;
  }
  .account-row dd {
    min-width: 0;
    margin: 0;
    color: var(--sl-ink);
    font-size: var(--sl-text-sm);
    font-weight: 500;
    line-height: 1.4;
    overflow-wrap: anywhere;
  }
  .account-row dd a { white-space: nowrap; }
  {# The one measured value on this page: how much of the month's allowance the
     engine has counted against this account. Amber mono, per the colour rule —
     nothing else here earns it. #}
  .account-row--metric dd {
    color: var(--sl-orange);
    font-family: var(--sl-font-mono);
    font-weight: 500;
    letter-spacing: .01em;
  }

  .account-subsection {
    margin-top: var(--sl-space-5);
    padding-top: var(--sl-space-4);
    border-top: 1px solid var(--sl-border);
  }
  {# .account-facts and .hub-sync both take .account-subsection as a spacer on
     the store-hub card. Both already carry their own frame and inner pad, and
     .account-subsection's padding-top would land INSIDE that frame — on
     .account-facts, whose background is the rule colour, it paints a solid band
     of it above the first cell. Keep the separating margin, drop the pad. The
     border-top is left alone: it resolves to the frame's own top edge. #}
  .account-facts.account-subsection { padding-top: 0; }
  .account-subsection h3 {
    margin: 0 0 var(--sl-space-2);
    color: var(--sl-ink);
    font-family: var(--sl-font-display);
    font-size: var(--sl-text-lg);
  }
  .account-subsection p { margin: var(--sl-space-2) 0; color: var(--sl-ink-soft); font-size: var(--sl-text-sm); }
  .account-shell .hint { color: var(--sl-ink-soft); font-size: var(--sl-text-sm); }
  .account-shell .hint strong { color: var(--sl-ink); font-weight: 500; }

  .account-card form { margin: 0; }
  .account-card form + form,
  .account-card form + .hint,
  .account-card .button + .hint { margin-top: var(--sl-space-2); }
  .account-card form[action="/account/password"] { display: grid; gap: var(--sl-space-2); margin-top: var(--sl-space-3); }
  .account-card form[action="/account/password"] label {
    color: var(--sl-ink-muted);
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-xs);
    font-weight: 500;
    letter-spacing: .12em;
    text-transform: uppercase;
  }
  {# The field is a well cut into the panel. The shell's control baseline still
     fills inputs with white — a light-era value that survives in a :where()
     rule — so an unstyled password box would be a white slab on near-black.
     The edge is --sl-control-border, not --sl-border: --sl-border is 1.33:1
     and fails WCAG 1.4.11 for anything a finger has to find. #}
  .account-card form[action="/account/password"] input {
    width: 100%;
    min-height: 46px;
    padding: 11px 13px;
    border: 1px solid var(--sl-control-border);
    border-radius: var(--sl-radius-control);
    background: var(--sl-night);
    color: var(--sl-ink);
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-base);
    letter-spacing: .04em;
  }
  {# The shell's input :focus ring is a translucent light-surface green that is
     invisible here, and it only loses to :focus-visible — a pointer focus would
     show nothing at all. #}
  .account-card form[action="/account/password"] input:focus {
    border-color: var(--sl-ink);
    outline: 2px solid var(--sl-focus-dark);
    outline-offset: 1px;
  }
  .account-card form[action="/account/password"] button { width: fit-content; margin-top: var(--sl-space-1); }

  {# Buttons are bone on the field. The shell's main-button baseline sets
     white ink on --sl-green-btn, which after the inversion is bone on bone
     (1.05:1) — every action on this page would have been an unreadable slab.
     Hover goes to the trace colour, never to amber: an action is not a
     measurement. #}
  .account-shell button,
  .account-shell a.button {
    min-height: 46px;
    border: 1px solid var(--sl-green-btn);
    border-radius: var(--sl-radius-control);
    background: var(--sl-green-btn);
    color: var(--sl-green-ink);
    font-family: var(--sl-font-sans);
    font-weight: 500;
    box-shadow: none;
  }
  .account-shell button:hover,
  .account-shell a.button:hover {
    border-color: var(--sl-ink-hi);
    background: var(--sl-ink-hi);
    color: var(--sl-night);
    transform: none;
    box-shadow: none;
  }
  .account-shell button:active,
  .account-shell a.button:active { transform: none; box-shadow: none; }
  {# Secondary keeps the hairline and drops the fill. --sl-border-strong (the
     shell's choice) is 1.9:1 against the field and is not a legal control
     edge; --sl-control-border is 4.29:1. #}
  .account-shell a.button.secondary {
    border-color: var(--sl-control-border);
    background: transparent;
    color: var(--sl-ink);
  }
  .account-shell a.button.secondary:hover {
    border-color: var(--sl-ink);
    background: rgba(var(--sl-wash-rgb), .06);
    color: var(--sl-ink);
  }
  .account-actions { display: flex; align-items: center; flex-wrap: wrap; gap: var(--sl-space-3); margin-top: var(--sl-space-4); }
  .account-actions > *, .account-actions .button, .account-actions button { margin-top: 0; }
  .account-actions--stack { align-items: flex-start; flex-direction: column; }
  .quiet button {
    border-color: var(--sl-control-border);
    background: transparent;
    color: var(--sl-ink);
  }
  .quiet button:hover { border-color: var(--sl-ink); background: rgba(var(--sl-wash-rgb), .06); color: var(--sl-ink); }
  {# Leaving is not destructive, but it is the one control here that ends the
     session, so it keeps the warning ink it has always had — retoned to the
     token that is actually readable on the field (7.2:1; the old #8a2820 was a
     light-surface red). #}
  .logout button {
    border-color: var(--sl-control-border);
    background: transparent;
    color: var(--sl-danger);
  }
  .logout button:hover { border-color: var(--sl-danger); background: transparent; color: var(--sl-danger); }

  {# Notes and status lines are wells cut into the panel — one recessed
     surface, one hairline, no wash of colour. #}
  .security-note,
  .store-status {
    margin: 0;
    padding: var(--sl-space-3) var(--sl-space-4);
    border: 1px solid var(--sl-border);
    border-radius: var(--sl-radius-sm);
    background: var(--sl-night);
    color: var(--sl-ink-soft);
    font-size: var(--sl-text-sm);
  }
  .store-status strong { color: var(--sl-ink); }

  .hub-sync {
    margin: 0 0 var(--sl-space-1);
    padding: var(--sl-space-3) var(--sl-space-4);
    display: grid;
    gap: var(--sl-space-2);
    border: 1px solid var(--sl-border);
    border-left: 3px solid var(--sl-border-strong);
    border-radius: var(--sl-radius-sm);
    background: var(--sl-night);
  }
  .hub-sync.account-subsection { padding-top: var(--sl-space-3); }
  .hub-sync__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sl-space-3);
    flex-wrap: wrap;
  }
  .hub-sync__label {
    color: var(--sl-ink-muted);
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-xs);
    font-weight: 500;
    letter-spacing: .14em;
    text-transform: uppercase;
  }
  {# The pill is a hollow chip whose edge and ink carry the tone. Filled
     rectangles of green/orange/red were the light-era pattern; on near-black
     they read as three unrelated blocks of colour. The word inside always says
     the state too, so tone is never the only signal. #}
  .hub-sync__pill {
    display: inline-flex;
    align-items: center;
    padding: 4px 10px;
    border: 1px solid var(--sl-control-border);
    border-radius: var(--sl-radius-control);
    background: transparent;
    color: var(--sl-ink);
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-xs);
    font-weight: 500;
    letter-spacing: .1em;
    line-height: 1.25;
    text-transform: uppercase;
  }
  {# Trace, because this row is a live read: role="status" on a link the server
     just re-checked. It is the only cyan on the page, and it never marks a
     value — the values on this page are bone or amber. #}
  .hub-sync--synced { border-left-color: var(--sl-trace-dim); }
  .hub-sync--synced .hub-sync__pill { border-color: var(--sl-trace-dim); color: var(--sl-trace); }
  .hub-sync--pending { border-left-color: var(--sl-control-border); }
  .hub-sync--failed,
  .hub-sync--requires_review { border-left-color: var(--sl-danger); }
  .hub-sync--failed .hub-sync__pill,
  .hub-sync--requires_review .hub-sync__pill { border-color: var(--sl-danger); color: var(--sl-danger); }
  .hub-sync--empty { border-left-style: dashed; }
  .hub-sync--empty .hub-sync__pill { border-color: var(--sl-border-strong); color: var(--sl-ink-muted); }
  .hub-sync__detail { margin: 0; color: var(--sl-ink-soft); font-size: var(--sl-text-sm); line-height: 1.45; }
  .hub-sync__error { margin: 0; color: var(--sl-danger); font-size: var(--sl-text-sm); line-height: 1.4; }

  {# The one irreversible control on the page gets the deepest surface in the
     matrix, so it is legible as a different KIND of cell before the words are
     read. #}
  .danger-card { background: var(--sl-night); }
  .danger-card .sl-eyebrow { color: var(--sl-danger); }
  .danger-card h2 { color: var(--sl-ink); }
  .danger-card__content { display: grid; gap: var(--sl-space-5); align-items: center; }
  .danger-card__content p { margin: 0; color: var(--sl-ink-soft); font-size: var(--sl-text-sm); }
  {# It was a bare inline link — a ~20px tall target for the one action that
     deletes data. It is a 44px control now. #}
  .danger-link {
    min-height: 44px;
    padding: var(--sl-space-2) 0;
    display: inline-flex;
    align-items: center;
    color: var(--sl-danger);
    font-weight: 500;
    white-space: nowrap;
  }
  .danger-link:hover { color: var(--sl-danger); }
  .error {
    margin: var(--sl-space-3) 0;
    padding: var(--sl-space-3);
    border: 1px solid var(--sl-danger);
    border-radius: var(--sl-radius-sm);
    background: var(--sl-night);
    color: var(--sl-danger);
    font-size: var(--sl-text-sm);
  }

  @media (min-width: 1000px) {
    .account-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .danger-card__content { grid-template-columns: minmax(0, 1fr) auto; }
  }
  @media (max-width: 749px) {
    .account-shell { gap: var(--sl-space-4); }
    .danger-link { white-space: normal; }
    .account-actions { align-items: stretch; flex-direction: column; }
    .account-actions > *, .account-actions .button, .account-actions button { width: 100%; text-align: center; }
    .account-actions .quiet button, .account-actions .logout button { width: 100%; }
    .account-card form[action="/account/password"] button { width: 100%; }
  }
  @media (prefers-reduced-motion: reduce) {
    .account-shell *, .account-shell *::before, .account-shell *::after {
      transition: none !important;
      animation: none !important;
    }
    .account-shell button, .account-shell a.button { transform: none !important; }
  }
{% endblock %}
{% block main %}
  <div class="account-shell">
    {% if upgraded %}
      <div class="account-notice" role="status">Thanks — your payment went through! Your plan updates to <strong>Pro</strong> the moment your payment provider confirms it (usually seconds). Refresh if you don't see it yet.</div>
    {% endif %}
    {% if password_added %}
      <div class="account-notice" role="status">Password added — you can now log in with it as well as with an emailed code.</div>
    {% endif %}
    {% if shopify_connected %}
      <div class="account-notice" role="status">Shopify sign-in is connected. Your Shopify customer identity is linked without copying a password.</div>
    {% endif %}
    {% if history_reset_flash %}
      <div class="account-notice" role="status">
        Your swing history has been deleted. Removed
        {{ history_reset_flash.deleted_jobs }} swing
        {{ "session" if history_reset_flash.deleted_jobs == 1 else "sessions" }},
        including their reports and linked practice evidence. Your account,
        golfer setup, Pro access, purchases, connected devices, and this month's
        allowance are unchanged.
        {% if history_reset_flash.cleanup_pending %}
          Secure file cleanup is pending and will retry when the app restarts.
        {% endif %}
      </div>
    {% endif %}

    <header class="account-header" aria-labelledby="account-title">
      <div class="account-header__copy">
        <p class="sl-eyebrow">Member settings</p>
        <h1 id="account-title">Account</h1>
        <p class="account-header__summary"><span>{{ user.email }}</span><span aria-hidden="true">·</span><span class="account-plan account-plan--{{ 'pro' if user.is_pro else 'free' }}">{{ "Pro member" if user.is_pro else "Free plan" }}</span></p>
      </div>
    </header>

    <div class="account-grid">
      <section class="account-card" aria-labelledby="profile-heading">
        <header class="account-card__header">
          <p class="sl-eyebrow">Coaching context</p>
          <h2 id="profile-heading">Profile</h2>
          <p>The saved details your caddie uses to frame practical guidance.</p>
        </header>
        <dl class="account-facts">
          <div class="account-row"><dt>Caddie name</dt><dd>{{ golfer_profile.display_name if golfer_profile and golfer_profile.display_name else "Not set" }} · <a href="/onboarding">Edit</a></dd></div>
          <div class="account-row"><dt>Golfer setup</dt><dd>{% if golfer_profile and golfer_profile.is_complete %}Ready{% else %}Needs a few choices{% endif %} · <a href="/onboarding">Edit</a></dd></div>
        </dl>
      </section>

      <section class="account-card" aria-labelledby="membership-heading">
        <header class="account-card__header">
          <p class="sl-eyebrow">Access</p>
          <h2 id="membership-heading">Membership &amp; allowance</h2>
          <p>Your current analysis access and membership status.</p>
        </header>
        <dl class="account-facts">
          <div class="account-row"><dt>Plan</dt><dd><span class="account-plan account-plan--{{ 'pro' if user.is_pro else 'free' }}">{{ "Pro" if user.is_pro else "Free" }}</span></dd></div>
          <div class="account-row account-row--metric"><dt>Allowance used this month</dt><dd>{{ usage }}{% if quota_left is not none %} — {{ quota_left }} left{% endif %}</dd></div>
          {% if pro_lifetime %}
            <div class="account-row"><dt>Pro access</dt><dd>Lifetime — never expires</dd></div>
          {% elif pro_until_date %}
            <div class="account-row"><dt>Pro access until</dt><dd>{{ pro_until_date }}</dd></div>
          {% endif %}
        </dl>
        <div class="account-subsection">
          {% if user.is_pro %}
            {% if pro_store_url and pro_until_date %}
              <a class="button" href="{{ pro_store_url }}">Extend Pro on the store</a>
            {% else %}
              <p>Your Pro access is active.</p>
            {% endif %}
          {% elif pro_store_url %}
            <a class="button" href="{{ pro_store_url }}">Upgrade to Pro</a>
            <p class="hint">Pro is unlimited analyses{% if replay_pro_only and progress_pro_only %}, the annotated coach replay of every swing, and the progress dashboard{% elif replay_pro_only %} and the annotated coach replay of every swing{% elif progress_pro_only %} and the progress dashboard{% endif %}. Check out with <strong>{{ user.email }}</strong> — it unlocks on this account automatically.</p>
          {% else %}
            <p class="hint">Pro memberships are coming soon.</p>
          {% endif %}
        </div>
      </section>

      <section class="account-card" aria-labelledby="security-heading">
        <header class="account-card__header">
          <p class="sl-eyebrow">Account access</p>
          <h2 id="security-heading">Sign-in &amp; security</h2>
          <p>Keep a reliable way back into your private coaching history.</p>
        </header>
        <dl class="account-facts">
          <div class="account-row"><dt>Email</dt><dd>{{ user.email }}</dd></div>
        </dl>

        {% if not user.has_password %}
          <div class="account-subsection">
            <h3>Add a password (optional)</h3>
            <p class="hint">You sign in with a code emailed to {{ user.email }}.{% if mail_enabled %} That keeps working — a password is just a second way in.{% else %} Email isn't set up on this server right now, so adding a password is the only way back in after you log out.{% endif %}</p>
            {% if password_error %}<p class="error" role="alert">{{ password_error }}</p>{% endif %}
            <form action="/account/password" method="post">
              <label for="ap-password">New password</label>
              <input id="ap-password" name="password" type="password" required minlength="8" autocomplete="new-password">
              <button type="submit">Add password</button>
            </form>
          </div>
        {% elif mail_enabled %}
          <div class="account-subsection">
            <h3>Password and sign-in</h3>
            <p class="hint">You can keep using emailed codes, change your password, or recover it if you forget it.</p>
            <a class="button secondary" href="/reset">Change or reset password</a>
          </div>
        {% endif %}

        <div class="account-subsection">
          <p class="security-note">Logging out ends this browser session. It does not delete your account, membership, or swing history.</p>
          <div class="account-actions">
            <form class="logout" action="{% if shopify_customer_accounts_enabled and user.shopify_account_migration_state == 'shopify_authenticated' %}/auth/shopify/logout{% else %}/logout{% endif %}" method="post"><button type="submit">Log out</button></form>
          </div>
        </div>
      </section>

      <section class="account-card" aria-labelledby="preferences-heading">
        <header class="account-card__header">
          <p class="sl-eyebrow">Communication</p>
          <h2 id="preferences-heading">Preferences</h2>
          <p>Control coaching reminders and optional product news.</p>
        </header>
        <dl class="account-facts">
          <div class="account-row"><dt>Weekly drill email</dt><dd>{{ "On" if user.digest_opt_in else "Off" }}</dd></div>
          <div class="account-row"><dt>Product updates</dt><dd>{{ "On" if golfer_profile and golfer_profile.marketing_email_opt_in else "Off" }} · <a href="/onboarding">Edit</a></dd></div>
        </dl>
        <div class="account-subsection">
          {% if user.digest_opt_in %}
            <form class="quiet" action="/account/digest" method="post"><button type="submit">Turn off the weekly drill email</button></form>
            {% if not mail_enabled %}<p class="hint">Email isn't set up on this server yet — nothing sends until it is, but your choice is saved.</p>{% endif %}
          {% else %}
            <form action="/account/digest" method="post"><input type="hidden" name="enabled" value="on"><button type="submit">Email me one drill a week</button></form>
            <p class="hint">One email a week: the drills for your latest session's flags, with the pass marks. Unsubscribe any time.</p>
          {% endif %}
        </div>
      </section>

      {%- set sync_status = user.shopify_sync_status|default('not_started') -%}
      {%- set show_store_hub = user.shopify_customer_id or shopify_customer_accounts_enabled or (sync_status and sync_status != 'not_started') -%}
      {% if show_store_hub %}
        {% if sync_status == 'synced' %}
          {% set sync_label = 'Synced' %}
          {% set sync_tone = 'synced' %}
          {% set sync_detail = 'Store identity and qualifying purchases are linked to this CaddieInsight account.' %}
        {% elif sync_status == 'pending' %}
          {% set sync_label = 'Pending' %}
          {% set sync_tone = 'pending' %}
          {% set sync_detail = 'Hub sync is in progress. Orders and membership updates usually appear within a few minutes.' %}
        {% elif sync_status == 'failed' %}
          {% set sync_label = 'Failed' %}
          {% set sync_tone = 'failed' %}
          {% if storefront_url %}
            {% set sync_detail = 'We could not finish hub sync. Your golf data is safe here — open store orders below, then try again later.' %}
          {% else %}
            {% set sync_detail = 'We could not finish hub sync. Your golf data is safe here — try again later.' %}
          {% endif %}
        {% elif sync_status == 'requires_review' %}
          {% set sync_label = 'Needs review' %}
          {% set sync_tone = 'requires_review' %}
          {% set sync_detail = 'Hub sync needs a quick review before store identity can finish linking to this account.' %}
        {% else %}
          {% set sync_label = 'Not started' %}
          {% set sync_tone = 'empty' %}
          {% if user.shopify_customer_id %}
            {% set sync_detail = 'Store customer is linked. Outbound hub sync has not run yet for this account.' %}
          {% else %}
            {% set sync_detail = 'No outbound hub sync yet. Connect a store purchase or Shopify sign-in when you are ready.' %}
          {% endif %}
        {% endif %}
        <section class="account-card account-card--wide" aria-labelledby="shopify-heading">
          <header class="account-card__header">
            <p class="sl-eyebrow">Store hub</p>
            <h2 id="shopify-heading">Shopify connection</h2>
            <p>Store identity, order history, and CaddieInsight sign-in stay explicit and separate from your golf data. Passwords are never synced.</p>
          </header>
          {% if user.shopify_customer_id %}
            <p class="store-status"><strong>Connected to the {{ brand.name }} store.</strong> Qualifying purchases can apply access to this CaddieInsight account; no store password is copied here.</p>
          {% endif %}
          <div class="hub-sync hub-sync--{{ sync_tone }}{% if user.shopify_customer_id %} account-subsection{% endif %}" role="status">
            <div class="hub-sync__row">
              <span class="hub-sync__label">Hub sync</span>
              <span class="hub-sync__pill">{{ sync_label }}</span>
            </div>
            <p class="hub-sync__detail">{{ sync_detail }}</p>
            {% if user.shopify_sync_error and sync_status in ['failed', 'requires_review', 'pending'] %}
              <p class="hub-sync__error">{{ user.shopify_sync_error }}</p>
            {% endif %}
          </div>
          {% if shopify_customer_accounts_enabled or user.shopify_customer_id or sync_status == 'not_started' %}
          <dl class="account-facts account-subsection">
            {% if shopify_customer_accounts_enabled %}
              <div class="account-row"><dt>Shopify sign-in</dt><dd>{% if user.shopify_account_migration_state == 'shopify_authenticated' %}Connected{% elif user.shopify_account_migration_state == 'linked_pending_first_sign_in' %}Linked — sign in once to finish{% else %}Not connected{% endif %}</dd></div>
            {% endif %}
            {% if user.shopify_customer_id %}
              <div class="account-row"><dt>Store customer</dt><dd>Linked</dd></div>
            {% elif sync_status == 'not_started' %}
              <div class="account-row"><dt>Store customer</dt><dd>Not linked yet</dd></div>
            {% endif %}
          </dl>
          {% endif %}
          {% if storefront_url %}
            <div class="account-subsection account-actions">
              <a class="button secondary" href="{{ storefront_url }}/account">View store orders</a>
              <a class="button secondary" href="{{ storefront_url }}">Store home</a>
            </div>
          {% endif %}
          {% if shopify_customer_accounts_enabled %}
            {% if user.shopify_account_migration_state == 'shopify_authenticated' %}
              <p class="hint">Your Shopify Customer Account is the sign-in currently used in this browser. Your CaddieInsight golf data stays here.</p>
            {% else %}
              <div class="account-subsection">
                <h3>Connect Shopify sign-in</h3>
                <p class="hint">Connect the Shopify account you control. We use its verified customer identity—not an email guess—and never copy a password.</p>
                <a class="button secondary" href="/auth/shopify/start">Connect Shopify sign-in</a>
              </div>
            {% endif %}
          {% endif %}
          <p class="hint">Passwords are never synced between the store and CaddieInsight.</p>
        </section>
      {% endif %}

      {% if history_reset_enabled %}
        <section class="account-card account-card--wide danger-card" aria-labelledby="history-controls-heading">
          <header class="account-card__header">
            <p class="sl-eyebrow">Data controls</p>
            <h2 id="history-controls-heading">Swing history controls</h2>
          </header>
          <div class="danger-card__content">
            <p>Want a clean coaching baseline? Delete your swing sessions, reports, practice check-ins, and Proof Cycle evidence while keeping your account, golfer setup, membership, purchases, connected devices, and monthly allowance.</p>
            <a class="danger-link" href="/account/history/delete">Delete swing history / Start over</a>
          </div>
        </section>
      {% endif %}
    </div>
  </div>
{% endblock %}
