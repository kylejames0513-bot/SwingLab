{% extends "web_layout.html.j2" %}
{% block title %}{{ brand.name }} — Today{% endblock %}
{% block style %}
  /* ------------------------------------------------------------------ today
     The signed-in front panel. Everything here is RULED rather than floated:
     on a near-black field a drop shadow renders as nothing at all, so the
     hierarchy is carried by hairlines, a deeper well, and mono labels sitting
     directly above the values they name. Amber appears only on a reading the
     engine holds; cyan only where something is being read live. */
  main {
    /* The shell centres --sl-content INSIDE --sl-pad-x for both the header and
       the footer, so matching it means ADDING the padding to the max-width,
       not subtracting it. At the old fixed 1160px the dashboard rules sat
       ~60px inboard of the logo directly above them, and a rule that nearly
       lines up reads as a misprint on an instrument. */
    max-width: calc(var(--sl-content) + var(--sl-pad-x) * 2);
    padding-inline: var(--sl-pad-x);
  }
  .today-shell { display: grid; gap: var(--sl-space-4); }

  /* --- masthead ---------------------------------------------------------- */
  .today-intro {
    position: relative;
    overflow: hidden;
    padding: clamp(22px, 4vw, 40px);
    border: 1px solid var(--sl-border);
    border-radius: var(--sl-radius-lg);
    background: var(--sl-night);
    box-shadow: var(--sl-shadow-sm);
  }
  /* The 8px measuring grid, brightening toward the trailing edge — the same
     device the storefront hero uses to say "this surface is an instrument".
     It replaces an outlined circle that carried no meaning and a premium
     gradient that no longer exists on a dark field. */
  .today-intro::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image:
      linear-gradient(rgba(var(--sl-cream-rgb), .035) 1px, transparent 1px),
      linear-gradient(90deg, rgba(var(--sl-cream-rgb), .035) 1px, transparent 1px);
    background-size: 8px 8px;
    -webkit-mask-image: linear-gradient(90deg, transparent, rgba(var(--sl-night-rgb), 1) 92%);
    mask-image: linear-gradient(90deg, transparent, rgba(var(--sl-night-rgb), 1) 92%);
  }
  .today-intro__copy { position: relative; z-index: 1; max-width: 64ch; }
  .today-kicker {
    margin: 0 0 var(--sl-space-3);
    display: flex;
    align-items: center;
    gap: var(--sl-space-3);
    color: var(--sl-ink-muted);
    font-family: var(--sl-font-mono);
    font-size: var(--sl-eyebrow-size);
    font-weight: 500;
    letter-spacing: var(--sl-eyebrow-track);
    line-height: 1;
    text-transform: uppercase;
  }
  /* A hairline carries on from the label to the panel edge, the way a printed
     label sits on a rule. It is the cheapest way to make a heading read as
     part of a panel rather than as a paragraph. */
  .today-kicker::after {
    content: "";
    flex: 1 1 auto;
    height: 1px;
    background: var(--sl-border-strong);
  }
  .today-intro h1 {
    margin: 0;
    color: var(--sl-green);
    font-family: var(--sl-font-display);
    font-size: var(--sl-heading-display);
    font-weight: 600;
    letter-spacing: -.02em;
    line-height: .96;
    text-transform: uppercase;
  }
  .today-welcome {
    margin: var(--sl-space-4) 0 var(--sl-space-2);
    color: var(--sl-ink);
    font-size: var(--sl-text-xl);
    font-weight: 500;
    line-height: 1.25;
  }
  .today-intro__detail { margin: 0; max-width: 58ch; color: var(--sl-ink-soft); }

  /* --- the three context readings ---------------------------------------- */
  /* One instrument block, not three cards: a 1px lattice with the border
     colour showing through the gaps. */
  .today-metrics {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    overflow: hidden;
    border: 1px solid var(--sl-border);
    border-radius: var(--sl-radius-sm);
    background: var(--sl-border);
  }
  .today-metric {
    min-width: 0;
    height: 100%;
    padding: var(--sl-space-4);
    background: var(--sl-bg-card);
  }
  .today-metric__label {
    margin: 0 0 var(--sl-space-2);
    color: var(--sl-ink-muted);
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-xs);
    font-weight: 500;
    letter-spacing: var(--sl-eyebrow-track);
    line-height: 1.2;
    text-transform: uppercase;
  }
  /* Amber, and mono, because these are the readings the engine holds for this
     golfer and sizes every piece of its advice against — the same role the
     storefront readout gives its club / priority / target values. Amber is
     never spent on emphasis or on a button anywhere on this page. */
  .today-metric__value {
    margin: 0;
    color: var(--sl-accent);
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-lg);
    font-weight: 500;
    line-height: 1.2;
  }
  /* Hidden by default and restored at 560px: below that the third column
     cannot hold a readable sentence, so the tiles keep the reading and drop
     the explanation of it rather than shipping a two-word-per-line column. */
  .today-metric__detail { display: none; margin: var(--sl-space-2) 0 0; color: var(--sl-ink-soft); font-size: var(--sl-text-sm); }

  /* --- the one priority --------------------------------------------------- */
  .next-move {
    display: grid;
    gap: var(--sl-space-5);
    align-items: start;
    padding: clamp(20px, 3.5vw, 34px);
    border: 1px solid var(--sl-border-strong);
    border-radius: var(--sl-radius-lg);
    background: var(--sl-bg-card);
    /* The only surface on the page carrying the deeper shadow: it is the one
       block a golfer must read first, and on a dark field a lit top edge is
       the only separation that is actually visible. */
    box-shadow: var(--sl-shadow-sm), var(--sl-shadow-md);
  }
  /* Display face, but NOT uppercased like the panel nameplates below. This
     heading is a full sentence the engine wrote about one swing, and expanded
     800-weight caps at sentence length stop being readable. */
  .next-move h2 {
    margin: var(--sl-space-3) 0 var(--sl-space-2);
    color: var(--sl-green);
    font-family: var(--sl-font-display);
    font-size: var(--sl-heading-support);
    letter-spacing: -.02em;
    line-height: 1.06;
  }
  .next-move p { margin: var(--sl-space-2) 0 0; color: var(--sl-ink-soft); }
  .next-move p strong { color: var(--sl-ink); font-weight: 500; }
  .next-move__actions { display: grid; gap: var(--sl-space-2); align-content: start; justify-items: stretch; }
  /* Sits directly under the primary action, so it needs the same 44px target
     even though it is a text link rather than a button. */
  .next-move__secondary {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: var(--sl-text-sm);
    font-weight: 500;
    text-align: center;
  }

  /* --- state pills -------------------------------------------------------- */
  .state-pill {
    display: inline-flex;
    align-items: center;
    gap: var(--sl-space-2);
    width: fit-content;
    padding: 5px 9px;
    border: 1px solid var(--sl-border-strong);
    border-radius: var(--sl-radius-sm);
    background: var(--sl-night);
    color: var(--sl-ink-soft);
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-xs);
    font-weight: 500;
    letter-spacing: var(--sl-eyebrow-track);
    line-height: 1.2;
    text-transform: uppercase;
  }
  /* A square tick rather than a dot: state is never carried by colour alone,
     and the tick reads at a glance in the recent-session list too. */
  .state-pill::before {
    content: "";
    flex: 0 0 auto;
    width: 5px;
    height: 5px;
    background: currentColor;
  }
  /* Cyan is the LIVE READ and nothing else, which is exactly what these two
     states are: the engine has the clip and is working on it right now. */
  .state-pill--queued, .state-pill--processing { color: var(--sl-trace); border-color: rgba(var(--sl-trace-rgb), .38); }
  /* --sl-danger, not the retired light-card red: that one lands at 2.97:1 on
     this field, which would have made the pill a golfer most needs to read
     the least readable thing on the page. No literal is spelled out here —
     naming a dead colour is how one gets pinned back into the file. */
  .state-pill--failed, .state-pill--refilm { color: var(--sl-danger); border-color: rgba(var(--sl-cream-rgb), .18); }
  .state-pill--coaching_ready { color: var(--sl-ink); border-color: rgba(var(--sl-cream-rgb), .26); }
  @media (prefers-reduced-motion: no-preference) {
    .state-pill--queued::before,
    .state-pill--processing::before { animation: today-live 2.4s ease-in-out infinite; }
  }
  @keyframes today-live {
    0%, 100% { opacity: 1; }
    50% { opacity: .34; }
  }

  /* --- panels -------------------------------------------------------------- */
  .dashboard-grid { display: grid; gap: var(--sl-space-4); align-items: start; }
  .dashboard-panel {
    min-width: 0;
    padding: clamp(18px, 3vw, 28px);
    border: 1px solid var(--sl-border);
    border-radius: var(--sl-radius-lg);
    background: var(--sl-bg-card);
    box-shadow: var(--sl-shadow-sm);
  }
  .dashboard-panel__header {
    display: flex;
    justify-content: space-between;
    gap: var(--sl-space-4);
    align-items: baseline;
    margin-bottom: var(--sl-space-4);
    padding-bottom: var(--sl-space-3);
    border-bottom: 1px solid var(--sl-border);
  }
  /* Panel nameplates ARE short enough for the expanded caps. */
  .dashboard-panel__header h2 {
    margin: 0;
    color: var(--sl-green);
    font-family: var(--sl-font-display);
    font-size: var(--sl-text-2xl);
    letter-spacing: -.01em;
    text-transform: uppercase;
  }
  /* A 12px mono link is a legible label but a 16px-tall tap target, so the
     box is grown to 44px around it and the text stays on the heading's
     baseline. */
  .dashboard-panel__header a {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    color: var(--sl-ink-soft);
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-xs);
    font-weight: 500;
    letter-spacing: var(--sl-eyebrow-track);
    text-transform: uppercase;
    white-space: nowrap;
  }
  .dashboard-panel h3 {
    margin: 0 0 var(--sl-space-2);
    color: var(--sl-green);
    font-family: var(--sl-font-sans);
    font-size: var(--sl-text-lg);
    font-weight: 600;
    letter-spacing: -.01em;
    line-height: 1.25;
  }
  .practice-lead { margin: 0 0 var(--sl-space-4); color: var(--sl-ink-soft); }
  .practice-lead strong { color: var(--sl-ink); }
  /* The bare follow-up links in this panel are standalone controls, not links
     inside a sentence, so they get a real 44px target rather than the 24px a
     line box gives them. */
  .dashboard-panel > a:not(.button),
  .today-actions > a:not(.button) {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    font-size: var(--sl-text-sm);
    font-weight: 500;
  }

  /* --- proof cycle callout ------------------------------------------------- */
  .proof-note {
    margin: 0 0 var(--sl-space-5);
    padding: var(--sl-space-4);
    border: 1px solid var(--sl-border-strong);
    border-left-width: 2px;
    border-radius: var(--sl-radius-sm);
    background: var(--sl-orange-soft);
  }
  .proof-note[data-proof-state="attention"] { border-left-color: var(--sl-danger); }
  .proof-note h3 { margin: 0 0 var(--sl-space-2); }
  .proof-note p { margin: var(--sl-space-2) 0 0; color: var(--sl-ink-soft); font-size: var(--sl-text-sm); }
  .proof-note p strong { color: var(--sl-ink); }

  /* --- practice options ---------------------------------------------------- */
  .practice-options { display: grid; gap: var(--sl-space-2); margin: var(--sl-space-4) 0; }
  /* These are controls, so they take the control edge (4.29:1) and not the
     decorative hairline (1.33:1, which fails WCAG 1.4.11 for a control). */
  .practice-option {
    min-width: 0;
    height: 100%;
    padding: var(--sl-space-3);
    display: flex;
    flex-direction: column;
    border: 1px solid var(--sl-control-border);
    border-radius: var(--sl-radius-sm);
    background: var(--sl-night);
  }
  /* The selected edge is drawn as an inset ring rather than by widening the
     border to 2px: growing the border re-measures the box and nudged every
     line inside it by a pixel each time the radio changed. */
  .practice-option.selected {
    border-color: var(--sl-green-btn);
    box-shadow: inset 0 0 0 1px var(--sl-green-btn);
    background: var(--sl-orange-soft);
  }
  .structured-practice .practice-option { flex-direction: row; gap: var(--sl-space-3); cursor: pointer; }
  .structured-practice .practice-option input { flex: 0 0 auto; margin-top: 6px; }
  .structured-practice label[for="practice-outcome"] {
    display: block;
    margin: var(--sl-space-4) 0 var(--sl-space-2);
    color: var(--sl-ink-muted);
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-xs);
    font-weight: 500;
    letter-spacing: var(--sl-eyebrow-track);
    text-transform: uppercase;
  }
  .structured-practice select {
    width: 100%;
    max-width: 420px;
    min-height: 44px;
    padding: 10px 12px;
    border: 1px solid var(--sl-control-border);
    border-radius: var(--sl-radius-control);
    background: var(--sl-night);
    color: var(--sl-ink);
    font: inherit;
  }
  .structured-practice select:focus { border-color: var(--sl-green-btn); }
  .practice-option h3, .practice-option h4 {
    margin: 0 0 var(--sl-space-2);
    color: var(--sl-green);
    font-family: var(--sl-font-sans);
    font-size: var(--sl-text-sm);
    font-weight: 600;
    letter-spacing: 0;
    line-height: 1.35;
  }
  .practice-option p { margin: var(--sl-space-2) 0 0; color: var(--sl-ink-soft); font-size: var(--sl-text-sm); }
  .practice-option p strong { color: var(--sl-ink); font-weight: 500; }
  /* The pass mark is a measured threshold, so it is the one line in the card
     that gets the signal colour and the mono face; its label stays muted so
     the number is what the eye lands on. */
  .practice-option__mark {
    color: var(--sl-orange-text);
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-sm);
    font-weight: 500;
  }
  .practice-option__mark strong,
  .practice-option.selected .practice-option__mark strong {
    color: var(--sl-ink-muted);
    font-weight: 500;
    letter-spacing: var(--sl-eyebrow-track);
    text-transform: uppercase;
  }

  /* --- actions ------------------------------------------------------------- */
  .today-actions { display: flex; flex-wrap: wrap; gap: var(--sl-space-3); align-items: center; margin-top: var(--sl-space-4); }
  .today-actions form { margin: 0; }
  /* Bone on the field with a hairline, never amber: amber marks a measured
     value and a call to action is not one. The shell's base rule paints these
     white-on-bone (it was written for the light field), so the ink token is
     restated here rather than left to render as an invisible label. */
  .today-shell button,
  .today-shell a.button {
    min-height: 46px;
    margin: 0;
    padding: 11px 20px;
    border: 1px solid var(--sl-green-btn);
    border-radius: var(--sl-radius-control);
    background: var(--sl-green-btn);
    color: var(--sl-green-ink);
    font-weight: 500;
    box-shadow: none;
  }
  .today-shell button:hover,
  .today-shell a.button:hover {
    border-color: var(--sl-ink-hi);
    background: var(--sl-ink-hi);
    color: var(--sl-green-ink);
    transform: none;
    box-shadow: none;
  }
  .today-shell a.button.secondary {
    border-color: var(--sl-control-border);
    background: transparent;
    color: var(--sl-ink);
  }
  .today-shell a.button.secondary:hover {
    border-color: var(--sl-green-btn);
    background: rgba(var(--sl-cream-rgb), .06);
    color: var(--sl-ink);
  }
  .success {
    margin: 0;
    padding: var(--sl-space-3) var(--sl-space-4);
    border: 1px solid var(--sl-border-strong);
    border-left: 2px solid var(--sl-green-btn);
    border-radius: var(--sl-radius-sm);
    background: var(--sl-orange-soft);
    color: var(--sl-ink);
    font-size: var(--sl-text-sm);
  }

  /* --- the log ------------------------------------------------------------- */
  .recent-list {
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1px;
    overflow: hidden;
    border: 1px solid var(--sl-border);
    border-radius: var(--sl-radius-sm);
    background: var(--sl-border);
    list-style: none;
  }
  .recent-session { padding: var(--sl-space-3) var(--sl-space-4); background: var(--sl-bg-card); }
  .recent-session__top { display: flex; justify-content: space-between; gap: var(--sl-space-3); align-items: flex-start; }
  .recent-session__link { color: var(--sl-green); font-weight: 500; }
  .recent-session__meta {
    margin: var(--sl-space-1) 0 0;
    color: var(--sl-ink-muted);
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-xs);
  }
  .recent-session__detail { margin: var(--sl-space-2) 0 0; color: var(--sl-ink-soft); font-size: var(--sl-text-sm); }
  .empty-note {
    margin: 0;
    padding: var(--sl-space-4);
    border: 1px dashed var(--sl-border-strong);
    border-radius: var(--sl-radius-sm);
    background: var(--sl-night);
    color: var(--sl-ink-soft);
    font-size: var(--sl-text-sm);
  }

  /* --- the loop legend ------------------------------------------------------ */
  .loop-strip {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--sl-space-2);
    padding-top: var(--sl-space-4);
    border-top: 1px solid var(--sl-border);
    color: var(--sl-ink-muted);
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-xs);
    font-weight: 500;
    letter-spacing: var(--sl-eyebrow-track);
    text-transform: uppercase;
  }
  .loop-strip strong { color: var(--sl-ink); font-weight: 500; }
  /* The arrows diagram a process; they are not a reading, so they stay muted.
     Amber here would spend the signal colour on decoration. */
  .loop-strip__arrow { color: var(--sl-ink-muted); }

  @media (min-width: 560px) {
    .today-metric__detail { display: block; }
  }
  @media (min-width: 1000px) {
    .today-shell { gap: var(--sl-space-5); }
    .next-move { grid-template-columns: minmax(0, 1fr) minmax(200px, 250px); gap: var(--sl-space-6); align-items: center; }
    .dashboard-grid { grid-template-columns: minmax(0, 1.65fr) minmax(290px, .85fr); gap: var(--sl-space-5); }
    .practice-options { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  @media (max-width: 749px) {
    /* The three context readings stay a ROW on phones. Stacking them turned
       three short facts into three full-width cards of mostly dead space —
       the single biggest reason Today read like a web page rather than an
       app. They are readings on a panel, so they keep panel proportions. */
    .today-metric { padding: var(--sl-space-3) var(--sl-space-2); }
    /* Two of the three labels wrap at this width and one does not, which left
       the readings sitting at three different heights. Reserving two lines
       lands every value on the same baseline. */
    .today-metric__label { min-height: 2.3em; margin-bottom: var(--sl-space-1); line-height: 1.15; }
    .dashboard-panel__header { align-items: flex-start; }
    .today-actions { align-items: stretch; }
    .today-actions > *, .today-actions .button, .today-actions button { width: 100%; text-align: center; }
    .next-move__actions { width: 100%; }
  }
{% endblock %}
{% block main %}
  {% macro refilm_cta() %}
    {# The proof-loop CTA never dead-ends: with allowance left it points at
       the upload form, with the free matched re-film open it says so, and
       only when both are truly gone does it name the honest ways out. #}
    {% if analyses_left is not none and analyses_left <= 0 %}
      {% if refilm_credit and refilm_credit.available %}
        <a class="button secondary" href="/#upload-form">Re-film free — same club, same view</a>
      {% elif user and not user.is_pro and pro_available %}
        <a class="button secondary" href="/pricing">Allowance used — see Pro plans</a>
      {% else %}
        <span class="hint">Allowance used — your re-film unlocks on the 1st.</span>
      {% endif %}
    {% else %}
      <a class="button secondary" href="/#upload-form">Practice, then re-film</a>
    {% endif %}
  {% endmacro %}
  <div class="today-shell">
    {% if setup_saved %}<p class="success" role="status">Your setup is saved. Your caddie will use it to keep the next step clear and practical.</p>{% endif %}
    {% if practice_done %}<p class="success" role="status">Practice check-in saved. When you re-film, we’ll compare the next session to this focus.</p>{% endif %}

    <header class="today-intro" aria-labelledby="today-title">
      <div class="today-intro__copy">
        <p class="today-kicker">{% if user and user.is_pro %}CaddieInsight Pro member{% else %}Personal coaching dashboard{% endif %}</p>
        <h1 id="today-title">Today</h1>
        {% if user and user.is_pro %}
          <p class="today-welcome">Welcome back{% if header_profile and header_profile.display_name %}, {{ header_profile.display_name }}{% endif %}.</p>
          <p class="today-intro__detail">Let’s work on your swing—one clear next move, one focused practice block, and evidence you can revisit.</p>
        {% else %}
          <p class="today-welcome">Your clearest next move, ready when you are.</p>
          <p class="today-intro__detail">Turn one swing into a focused practice decision without digging through a wall of numbers.</p>
        {% endif %}
      </div>
    </header>

    <section class="today-metrics" aria-label="Golfer setup and plan">
      {% for tile in today_tiles %}
        <article class="today-metric">
          <p class="today-metric__label">{{ tile.label }}</p>
          <p class="today-metric__value">{{ tile.value }}</p>
          <p class="today-metric__detail">{{ tile.detail }}</p>
        </article>
      {% endfor %}
    </section>

    <section class="next-move" data-today-state="{{ today_state }}" aria-labelledby="next-move-title">
      <div>
        <p class="today-kicker">Today’s next move</p>
        {% if today_state == 'setup' %}
          <span class="state-pill state-pill--setup">Setup needed</span>
          <h2 id="next-move-title">Set up your first coaching loop</h2>
          <p>You can film right away — the upload asks for the club and camera angle it needs. Finishing your golfer setup (goal, practice block) makes the guidance fit your game.</p>
        {% elif today_state == 'empty' %}
          <span class="state-pill state-pill--empty">Ready to start</span>
          <h2 id="next-move-title">Film a baseline</h2>
          <p>Use one phone clip. Your first Caddie Brief will identify one priority, one drill, a pass mark, and a re-film target.</p>
        {% elif today_state == 'queued' %}
          <span class="state-pill state-pill--queued">Queued</span>
          <h2 id="next-move-title">Your swing is queued</h2>
          <p>It is safely in line for analysis. You can leave this page and return when the coaching result is ready.</p>
        {% elif today_state == 'processing' %}
          <span class="state-pill state-pill--processing">Analyzing</span>
          <h2 id="next-move-title">Analysis in progress</h2>
          <p>{% if latest_job.swings_total %}{{ latest_job.swings_done }} of {{ latest_job.swings_total }} swings analyzed so far.{% else %}CaddieInsight is reading your uploaded swing now.{% endif %} Your coaching card will appear after the evidence is processed.</p>
        {% elif today_state == 'failed' %}
          <span class="state-pill state-pill--failed">Needs attention</span>
          <h2 id="next-move-title">Let’s get you back on track</h2>
          <p>This analysis did not finish. Try a fresh upload; the private technical details are intentionally kept out of your dashboard.</p>
        {% elif today_state == 'refilm' %}
          <span class="state-pill state-pill--refilm">Re-film needed</span>
          <h2 id="next-move-title">Re-film before practicing a change</h2>
          <p>{% if caddie_brief %}{{ caddie_brief.warning or caddie_brief.why }}{% else %}This capture is available for review, but it could not support a trustworthy coaching card. Use the session guidance and film again before changing your swing.{% endif %}</p>
        {% elif today_state == 'coaching_ready' %}
          <span class="state-pill state-pill--coaching_ready">Coaching ready</span>
          <h2 id="next-move-title">{{ caddie_brief.focus_name }}</h2>
          <p><strong>Why it matters:</strong> {{ caddie_brief.why }}</p>
          <p><strong>Your cue:</strong> {{ caddie_brief.fix }}</p>
        {% elif latest_report_available %}
          <span class="state-pill state-pill--legacy">Saved session</span>
          <h2 id="next-move-title">Review your saved session</h2>
          <p>The report is preserved, but its structured coaching card is unavailable here. Open the session to review what can still be shown.</p>
        {% else %}
          <span class="state-pill state-pill--legacy">Needs review</span>
          <h2 id="next-move-title">Start with a fresh coaching card</h2>
          <p>This session does not have a current coaching card or a preserved report. A new analysis is the honest next step.</p>
        {% endif %}
      </div>
      <div class="next-move__actions">
        {% if today_state == 'setup' %}
          <a class="button" data-primary-next-move href="/#upload-form">Film your first swing</a>
          <a class="next-move__secondary" href="/onboarding">Finish golfer setup</a>
        {% elif today_state == 'empty' %}
          <a class="button" data-primary-next-move href="/#upload-form">Analyze my swing free</a>
        {% elif today_state in ('queued', 'processing') %}
          <a class="button" data-primary-next-move href="/session/{{ latest_job.id }}">See analysis status</a>
        {% elif today_state == 'failed' %}
          <a class="button" data-primary-next-move href="/#upload-form">Try a fresh upload</a>
          <a class="next-move__secondary" href="/session/{{ latest_job.id }}">Open session</a>
        {% elif today_state == 'refilm' %}
          <a class="button" data-primary-next-move href="/#upload-form">Re-film with the checklist</a>
          <a class="next-move__secondary" href="/session/{{ latest_job.id }}">See capture guidance</a>
        {% elif today_state == 'coaching_ready' %}
          <a class="button" data-primary-next-move href="#practice-plan">Start today’s practice</a>
          <a class="next-move__secondary" href="/session/{{ latest_job.id }}">See full Caddie Brief</a>
        {% elif latest_report_available %}
          <a class="button" data-primary-next-move href="/session/{{ latest_job.id }}">Open saved result</a>
        {% else %}
          <a class="button" data-primary-next-move href="/#upload-form">Analyze a new swing</a>
        {% endif %}
      </div>
    </section>

    <div class="dashboard-grid">
      <section class="dashboard-panel" id="practice-plan" aria-labelledby="practice-title">
        <div class="dashboard-panel__header">
          <h2 id="practice-title">Practice</h2>
          {% if profile %}<a href="/onboarding">Adjust setup</a>{% endif %}
        </div>

        {% if today_proof %}
          <aside class="proof-note" data-proof-state="{{ today_proof.tone }}" aria-labelledby="proof-title">
            <p class="today-kicker">Proof cycle · {{ today_proof.target_name }}</p>
            <h3 id="proof-title">{{ today_proof.heading }}</h3>
            <p><strong>{{ today_proof.summary }}</strong></p>
            <p>{{ today_proof.detail }}</p>
            <p><strong>Next:</strong> {{ today_proof.next_step }}</p>
          </aside>
        {% endif %}

        {% if today_state == 'coaching_ready' %}
          {% if proof_cycle_practice_assignment %}
            <h3>Continue {{ proof_cycle_practice_assignment.drill_name }}</h3>
            <p class="practice-lead"><strong>Matched target:</strong> {{ proof_cycle_practice_assignment.target_name }}. This receipt is self-reported practice context, not proof of a result.</p>
            <form action="/practice/checkins" method="post" class="structured-practice">
              <input type="hidden" name="session_id" value="{{ latest_job.id }}">
              <div class="practice-options">
                {% for choice in practice_choices %}
                  <label class="practice-option{% if (proof_cycle_practice_receipt and proof_cycle_practice_receipt.minutes == choice.minutes) or (not proof_cycle_practice_receipt and choice.selected) %} selected{% endif %}">
                    <input type="radio" name="practice_minutes" value="{{ choice.minutes }}" {% if (proof_cycle_practice_receipt and proof_cycle_practice_receipt.minutes == choice.minutes) or (not proof_cycle_practice_receipt and choice.selected) %}checked{% endif %} required>
                    <div>
                      <h4>{{ choice.minutes }} minutes · {{ choice.title }}</h4>
                      <p>{{ choice.detail }}</p>
                      <p><strong>Drill:</strong> {{ choice.dosage }}</p>
                      <p class="practice-option__mark"><strong>Pass mark:</strong> {{ choice.pass_mark }}</p>
                    </div>
                  </label>
                {% endfor %}
              </div>
              <label for="practice-outcome">How did this block go?</label>
              <select id="practice-outcome" name="practice_outcome" required>
                <option value="completed" {% if not proof_cycle_practice_receipt or proof_cycle_practice_receipt.outcome == 'completed' %}selected{% endif %}>Completed the planned block</option>
                <option value="still_working" {% if proof_cycle_practice_receipt and proof_cycle_practice_receipt.outcome == 'still_working' %}selected{% endif %}>Still working on the cue</option>
              </select>
              <p class="hint">One receipt is kept per target each day, so you can update it after another focused block without double-counting.</p>
              <div class="today-actions">
                <button type="submit">{{ "Update today's practice receipt" if proof_cycle_practice_receipt else "Save practice receipt" }}</button>
                {% if proof_cycle_practice_receipt %}<span class="success" role="status">Today's practice receipt is saved</span>{% endif %}
                {{ refilm_cta() }}
                <a class="button secondary" href="/session/{{ latest_job.id }}">See full Caddie Brief</a>
              </div>
            </form>
          {% else %}
            <h3>Practice {{ caddie_brief.drill.name }}</h3>
            <p class="practice-lead">{{ caddie_brief.drill.aim }}</p>
            <div class="practice-options">
              {% for choice in practice_choices %}
                <article class="practice-option{% if choice.selected %} selected{% endif %}">
                  <h4>{{ choice.minutes }} minutes · {{ choice.title }}</h4>
                  <p>{{ choice.detail }}</p>
                  <p><strong>Drill:</strong> {{ choice.dosage }}</p>
                  <p class="practice-option__mark"><strong>Pass mark:</strong> {{ choice.pass_mark }}</p>
                </article>
              {% endfor %}
            </div>
            <div class="today-actions">
              {% if latest_practiced %}<span class="success" role="status">Practice logged</span>{% else %}<form action="/practice/checkins" method="post"><input type="hidden" name="session_id" value="{{ latest_job.id }}"><button type="submit">I practiced this</button></form>{% endif %}
              {{ refilm_cta() }}
              <a class="button secondary" href="/session/{{ latest_job.id }}">See full Caddie Brief</a>
            </div>
          {% endif %}
        {% elif today_state == 'refilm' %}
          <h3>Protect the signal</h3>
          <p class="practice-lead">Practice waits for a trustworthy capture. Re-film with the guidance above before changing your swing.</p>
          <a class="button secondary" href="/#upload-form">Re-film this swing</a>
        {% elif today_state in ('queued', 'processing') %}
          <h3>Your practice card is on the way</h3>
          <p class="practice-lead">The drill and pass mark will appear here after this analysis finishes.</p>
          <a href="/session/{{ latest_job.id }}">Check analysis status</a>
        {% elif today_state == 'failed' %}
          <h3>No guesswork after a failed analysis</h3>
          <p class="practice-lead">Upload a fresh clip before choosing a swing change.</p>
          <a href="/#upload-form">Start a fresh analysis</a>
        {% elif today_state == 'setup' %}
          <h3>Set your practice context first</h3>
          <p class="practice-lead">A required club and realistic practice block help shape advice you can actually use.</p>
          <a href="/onboarding">Finish golfer setup</a>
        {% elif today_state == 'empty' %}
          <h3>Your first plan starts with a baseline</h3>
          <p class="practice-lead">Film one swing to unlock a focused drill and pass mark.</p>
          <a href="/#upload-form">Film a baseline</a>
        {% else %}
          <h3>{% if latest_report_available %}Open the preserved result{% else %}Build a new practice plan{% endif %}</h3>
          <p class="practice-lead">{% if latest_report_available %}The report remains available, but its structured practice card cannot be shown here. Review it or begin a new analysis.{% else %}There is no trustworthy practice card attached to this session. Begin a new analysis before changing your swing.{% endif %}</p>
          <div class="today-actions">
            {% if latest_report_available %}<a class="button secondary" href="/session/{{ latest_job.id }}">Open saved result</a>{% endif %}
            <a href="/#upload-form">Analyze a new swing</a>
          </div>
        {% endif %}
      </section>

      <section class="dashboard-panel" aria-labelledby="recent-title">
        <div class="dashboard-panel__header">
          <h2 id="recent-title">Recent sessions</h2>
          <a href="/sessions">View history</a>
        </div>
        {% if recent_sessions %}
          <ol class="recent-list">
            {% for session in recent_sessions %}
              <li class="recent-session" data-session-state="{{ session.state }}">
                <div class="recent-session__top">
                  <div>
                    <a class="recent-session__link" href="/session/{{ session.id }}">{{ session.position }} swing</a>
                    <p class="recent-session__meta">{{ session.club }}{% if session.when %} · {{ session.when }}{% endif %}</p>
                  </div>
                  <span class="state-pill state-pill--{{ session.state }}">{{ session.label }}</span>
                </div>
                <p class="recent-session__detail">{{ session.detail }}</p>
              </li>
            {% endfor %}
          </ol>
        {% else %}
          <p class="empty-note">No sessions yet. Your first analysis will appear here without exposing upload details.</p>
        {% endif %}
      </section>
    </div>

    <div class="loop-strip" aria-label="CaddieInsight coaching loop">
      <strong>Film</strong><span class="loop-strip__arrow" aria-hidden="true">→</span>
      <span>Caddie Brief</span><span class="loop-strip__arrow" aria-hidden="true">→</span>
      <strong>One drill</strong><span class="loop-strip__arrow" aria-hidden="true">→</span>
      <span>Matched re-film</span>
    </div>
  </div>
{% endblock %}
