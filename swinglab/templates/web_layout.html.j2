<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#07130d">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="default">
<title>{% block title %}{{ brand.name }}{% endblock %}</title>
<link rel="manifest" href="/app.webmanifest">
<link rel="icon" href="/static/pwa-icon.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="/static/pwa-icon.svg">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
<style>
  :root {
    --primary: {{ brand.primary_color }};
    --accent: {{ brand.accent_color }};
    --sl-bg: #f7f5f0;
    --sl-bg-card: #fffdf9;
    --sl-surface-soft: #edf3ee;
    --sl-surface-dark: #103c27;
    --sl-night: #07130d;
    --sl-ink: #17201a;
    --sl-ink-soft: #4a544c;
    --sl-ink-muted: #5f6b62;
    --sl-green: #14472c;
    --sl-green-btn: #1a5c38;
    --sl-green-ink: #e9f2ec;
    --sl-orange: #e8720c;
    --sl-orange-text: #a94708;
    --sl-orange-soft: #fff3e4;
    --sl-premium-accent: #ffad62;
    --sl-premium-gradient: linear-gradient(135deg, #07130d 0%, #103c27 62%, #14472c 100%);
    --sl-border: #e3ded3;
    --sl-border-strong: #c9c3b8;
    --sl-control-border: #7a867c;
    --sl-radius-sm: 8px;
    --sl-radius-md: 14px;
    --sl-radius-lg: 22px;
    --sl-radius-xl: 32px;
    --sl-shadow-sm: 0 1px 2px rgba(15, 42, 27, .05);
    --sl-shadow-md: 0 12px 30px -14px rgba(15, 42, 27, .18);
    --sl-shadow-lg: 0 34px 80px -42px rgba(8, 35, 21, .5);
    --sl-content: 1280px;
    --sl-pad-x: clamp(20px, 5vw, 56px);
    --sl-font-sans: "Archivo", Helvetica, Arial, sans-serif;
    --sl-font-mono: ui-monospace, SFMono-Regular, Consolas, "Liberation Mono", monospace;
    --sl-text-xs: 12px;
    --sl-text-sm: clamp(13.5px, 13px + .15vw, 14.5px);
    --sl-text-base: clamp(15.5px, 15px + .2vw, 17px);
    --sl-text-lg: clamp(17px, 16.2px + .35vw, 19px);
    --sl-text-xl: clamp(20px, 18.8px + .55vw, 23px);
  }
  * { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; }
  body {
    margin: 0;
    min-height: 100vh;
    background: var(--sl-bg);
    color: var(--sl-ink);
    font-family: var(--sl-font-sans);
    font-size: var(--sl-text-base);
    line-height: 1.55;
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }
  a { color: var(--sl-green-btn); }
  a:hover { color: var(--sl-orange-text); }
  img { max-width: 100%; }
  ::selection { background: rgba(232, 114, 12, .22); }
  :focus-visible {
    outline: 3px solid var(--sl-orange);
    outline-offset: 3px;
    border-radius: 3px;
  }
  .sl-skip {
    position: absolute;
    left: -9999px;
    top: 0;
    z-index: 100;
    background: var(--sl-green);
    color: var(--sl-green-ink);
    padding: 10px 18px;
    border-radius: 0 0 10px 0;
    text-decoration: none;
    font-weight: 600;
  }
  .sl-skip:focus-visible { left: 0; outline-color: var(--sl-orange); outline-offset: -3px; }
  html.sl-menu-open { overflow: hidden; }
  .sl-app-banner {
    position: relative;
    z-index: 42;
    min-height: 36px;
    padding: 8px var(--sl-pad-x);
    display: flex;
    align-items: center;
    background: #050d09;
    border-bottom: 1px solid rgba(245, 242, 233, .1);
    color: rgba(245, 242, 233, .7);
    font-size: 12.5px;
  }
  .sl-app-banner__inner {
    width: 100%;
    max-width: var(--sl-content);
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    overflow: hidden;
    text-align: center;
  }
  .sl-app-banner__status {
    flex: 0 0 auto;
    color: #ffad62;
    font-family: var(--sl-font-mono);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: .13em;
    text-transform: uppercase;
  }
  .sl-app-banner__detail {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .sl-app-banner__dot {
    width: 6px;
    height: 6px;
    flex: 0 0 auto;
    border-radius: 50%;
    background: #75d59b;
    box-shadow: 0 0 0 5px rgba(117, 213, 155, .1);
  }
  .sl-app-banner a {
    color: #f5f2e9;
    font-weight: 700;
    text-underline-offset: 3px;
    white-space: nowrap;
  }
  .sl-app-banner a:hover { color: #ffad62; }
  .sl-header {
    position: sticky;
    top: 0;
    z-index: 40;
    min-height: 72px;
    padding: 0 var(--sl-pad-x);
    background: rgba(245, 244, 239, 0.92);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--sl-border);
  }
  .sl-header--premium {
    min-height: 76px;
    background: rgba(7, 19, 13, .96);
    border-bottom-color: rgba(239, 241, 232, .12);
    box-shadow: 0 18px 48px -32px rgba(0, 0, 0, .85);
  }
  .sl-header__inner {
    width: 100%;
    max-width: 1280px;
    max-width: var(--sl-content);
    min-height: 72px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    gap: clamp(16px, 2.5vw, 28px);
  }
  .sl-header--premium .sl-header__inner { min-height: 76px; }
  .sl-header__logo {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    color: var(--sl-green);
    font-size: 22px;
    font-weight: 900;
    letter-spacing: -0.02em;
    text-decoration: none;
  }
  .sl-header__logo-img { display: block; width: auto; height: 38px; }
  .sl-header--premium .sl-header__logo { color: #f5f2e9; }
  .sl-header--premium .sl-header__logo-img { filter: brightness(0) invert(1); opacity: .96; }
  .sl-header__desktop-nav {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-left: auto;
  }
  .sl-header__link,
  .sl-header__dropdown-trigger {
    min-height: 38px;
    padding: 9px 12px;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    border-radius: 999px;
    color: var(--sl-ink);
    font-size: 14px;
    font-weight: 600;
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
  }
  .sl-header__link:hover,
  .sl-header__dropdown-trigger:hover,
  .sl-header__dropdown[open] > .sl-header__dropdown-trigger {
    background: var(--sl-bg-card);
    color: var(--sl-green-btn);
  }
  .sl-header__link.is-current,
  .sl-header__dropdown-trigger.is-current {
    background: var(--sl-orange-soft);
    color: var(--sl-green);
  }
  .sl-header--premium .sl-header__link,
  .sl-header--premium .sl-header__dropdown-trigger { color: rgba(245, 242, 233, .78); }
  .sl-header--premium .sl-header__link:hover,
  .sl-header--premium .sl-header__dropdown-trigger:hover,
  .sl-header--premium .sl-header__dropdown[open] > .sl-header__dropdown-trigger {
    background: rgba(255, 255, 255, .08);
    color: #fff;
  }
  .sl-header--premium .sl-header__link.is-current,
  .sl-header--premium .sl-header__dropdown-trigger.is-current {
    background: rgba(232, 114, 12, .16);
    color: #ffad62;
  }
  .sl-header__member {
    min-height: 40px;
    padding: 7px 13px 7px 8px;
    display: inline-flex;
    align-items: center;
    gap: 9px;
    border: 1px solid #b9cdbf;
    border-radius: 999px;
    background: #edf6ef;
    color: var(--sl-green);
    font-size: 13px;
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
  }
  .sl-header__member:hover { border-color: var(--sl-green-btn); background: #e3f1e7; color: var(--sl-green); }
  .sl-header--premium .sl-header__member {
    border-color: rgba(117, 213, 155, .42);
    background: rgba(117, 213, 155, .1);
    color: #dff5e7;
  }
  .sl-header--premium .sl-header__member:hover {
    border-color: #75d59b;
    background: rgba(117, 213, 155, .17);
    color: #fff;
  }
  .sl-header__member > span:last-child {
    max-width: clamp(130px, 17vw, 230px);
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .sl-header__member-badge {
    padding: 4px 7px;
    border-radius: 999px;
    background: var(--sl-green);
    color: #fff;
    font-family: var(--sl-font-mono);
    font-size: 10px;
    letter-spacing: .08em;
  }
  .sl-header--premium .sl-header__member-badge { background: #75d59b; color: #07130d; }
  .sl-header__dropdown { position: relative; }
  .sl-header__dropdown summary { list-style: none; }
  .sl-header__dropdown summary::-webkit-details-marker { display: none; }
  .sl-header__chevron {
    width: 7px;
    height: 7px;
    border-right: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    transform: translateY(-2px) rotate(45deg);
    transition: transform .18s ease;
  }
  .sl-header__dropdown[open] .sl-header__chevron { transform: translateY(2px) rotate(225deg); }
  .sl-header__dropdown-menu {
    position: absolute;
    top: calc(100% + 10px);
    left: 0;
    z-index: 45;
    width: max-content;
    min-width: 210px;
    padding: 8px;
    display: grid;
    gap: 2px;
    background: var(--sl-bg-card);
    border: 1px solid var(--sl-border);
    border-radius: 14px;
    box-shadow: 0 18px 42px -24px rgba(15, 42, 27, 0.42);
  }
  .sl-header__dropdown-menu--right { right: 0; left: auto; }
  .sl-header__dropdown-menu a,
  .sl-header__logout {
    width: 100%;
    padding: 10px 12px;
    display: block;
    border: 0;
    border-radius: 9px;
    background: transparent;
    color: var(--sl-ink);
    font-family: inherit;
    font-size: 14px;
    font-weight: 600;
    text-align: left;
    text-decoration: none;
    cursor: pointer;
  }
  .sl-header__dropdown-menu form { margin: 0; }
  .sl-header__dropdown-menu a:hover,
  .sl-header__logout:hover {
    background: var(--sl-orange-soft);
    color: var(--sl-green);
  }
  .sl-header--premium .sl-header__dropdown-menu {
    background: rgba(10, 28, 19, .99);
    border-color: rgba(239, 241, 232, .14);
    box-shadow: 0 24px 54px -22px rgba(0, 0, 0, .78);
  }
  .sl-header--premium .sl-header__dropdown-menu a,
  .sl-header--premium .sl-header__logout { color: rgba(245, 242, 233, .86); }
  .sl-header--premium .sl-header__dropdown-menu a:hover,
  .sl-header--premium .sl-header__logout:hover {
    background: rgba(255, 255, 255, .08);
    color: #fff;
  }
  .sl-header__actions {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-shrink: 0;
  }
  .sl-header__cta,
  .sl-header__cart {
    min-height: 40px;
    padding: 7px 16px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1.5px solid var(--sl-green);
    border-radius: 999px;
    font-size: 14px;
    font-weight: 700;
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;
  }
  .sl-header__cta { background: var(--sl-green); color: var(--sl-green-ink); }
  .sl-header__cta:hover { background: var(--sl-green-btn); color: #fff; }
  .sl-header__cart { background: transparent; color: var(--sl-green); }
  .sl-header__cart:hover { border-color: var(--sl-orange); color: var(--sl-orange-text); }
  .sl-header--premium .sl-header__cta {
    min-height: 44px;
    border-color: #f07a18;
    background: #f07a18;
    color: #07130d;
    box-shadow: 0 12px 30px -18px rgba(240, 122, 24, .9);
  }
  .sl-header--premium .sl-header__cta:hover {
    border-color: #ff9a42;
    background: #ff9a42;
    color: #07130d;
  }
  .sl-header--premium .sl-header__cart {
    border-color: rgba(245, 242, 233, .48);
    color: #f5f2e9;
  }
  .sl-header--premium .sl-header__cart:hover { border-color: #ff9a42; color: #ffb06b; }
  .sl-header__toggle {
    display: none;
    width: 44px;
    height: 44px;
    margin: 0;
    padding: 10px;
    flex-direction: column;
    align-items: stretch;
    justify-content: center;
    gap: 5px;
    border: 1.5px solid var(--sl-green);
    border-radius: 50%;
    background: transparent;
    color: var(--sl-green);
    cursor: pointer;
  }
  .sl-header__toggle:hover { background: var(--sl-bg-card); color: var(--sl-green-btn); }
  .sl-header--premium .sl-header__toggle {
    border-color: rgba(245, 242, 233, .5);
    color: #f5f2e9;
  }
  .sl-header--premium .sl-header__toggle:hover { background: rgba(255, 255, 255, .08); color: #fff; }
  .sl-header__toggle span {
    display: block;
    width: 100%;
    height: 2px;
    border-radius: 2px;
    background: currentColor;
  }
  .sl-menu {
    width: 100vw;
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    overflow: hidden;
  }
  .sl-menu::backdrop { background: rgba(10, 28, 18, 0.46); }
  .sl-menu__panel {
    width: min(88vw, 360px);
    height: 100dvh;
    margin-left: auto;
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 20px;
    background: var(--sl-bg);
    border-left: 1px solid var(--sl-border);
    overflow-y: auto;
    overscroll-behavior: contain;
    box-shadow: -24px 0 60px -34px rgba(15, 42, 27, 0.55);
  }
  .sl-menu[open] .sl-menu__panel { animation: sl-menu-in .22s ease-out both; }
  @keyframes sl-menu-in {
    from { opacity: .85; transform: translateX(28px); }
    to { opacity: 1; transform: translateX(0); }
  }
  .sl-menu__head {
    min-height: 44px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .sl-menu__title {
    margin: 0;
    color: var(--sl-green);
    font-size: 20px;
    font-weight: 800;
    letter-spacing: -0.02em;
  }
  .sl-menu__close {
    position: relative;
    width: 44px;
    height: 44px;
    margin: 0;
    padding: 0;
    border: 1.5px solid var(--sl-border);
    border-radius: 50%;
    background: var(--sl-bg-card);
    color: var(--sl-ink);
    cursor: pointer;
  }
  .sl-menu__close:hover { background: var(--sl-orange-soft); color: var(--sl-green); }
  .sl-menu__close span {
    position: absolute;
    top: 20px;
    left: 11px;
    width: 20px;
    height: 2px;
    border-radius: 2px;
    background: currentColor;
  }
  .sl-menu__close span:first-child { transform: rotate(45deg); }
  .sl-menu__close span:last-child { transform: rotate(-45deg); }
  .sl-menu__nav {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .sl-menu__cta {
    width: 100%;
    min-height: 48px;
    justify-content: center;
  }
  .sl-menu__group {
    padding-top: 18px;
    display: grid;
    gap: 2px;
    border-top: 1px solid var(--sl-border);
  }
  .sl-menu__eyebrow {
    margin: 0 0 7px;
    color: var(--sl-ink-muted);
    font-family: var(--sl-font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: .12em;
    text-transform: uppercase;
  }
  .sl-menu__link {
    min-height: 46px;
    padding: 10px 4px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    border-radius: 8px;
    color: var(--sl-ink);
    font-size: 17px;
    font-weight: 650;
    text-decoration: none;
  }
  .sl-menu__link:hover { color: var(--sl-green-btn); }
  .sl-menu__logout {
    width: 100%;
    border: 0;
    background: transparent;
    font-family: inherit;
    text-align: left;
    cursor: pointer;
  }
  .sl-menu__group form { margin: 0; }
  .sl-menu__link.is-current {
    padding-inline: 10px;
    background: var(--sl-orange-soft);
    color: var(--sl-green);
  }
  .sl-premium-chrome .sl-menu .sl-menu__panel {
    background: #091811;
    border-left-color: rgba(245, 242, 233, .14);
    box-shadow: -28px 0 70px -32px rgba(0, 0, 0, .86);
  }
  .sl-premium-chrome .sl-menu .sl-menu__title,
  .sl-premium-chrome .sl-menu .sl-menu__link { color: #f5f2e9; }
  .sl-premium-chrome .sl-menu .sl-menu__close {
    background: rgba(255, 255, 255, .06);
    border-color: rgba(245, 242, 233, .24);
    color: #f5f2e9;
  }
  .sl-premium-chrome .sl-menu .sl-menu__group { border-top-color: rgba(245, 242, 233, .14); }
  .sl-premium-chrome .sl-menu .sl-menu__eyebrow { color: rgba(245, 242, 233, .55); }
  .sl-premium-chrome .sl-menu .sl-menu__link:hover { color: #ffad62; }
  .sl-premium-chrome .sl-menu .sl-menu__link.is-current {
    background: rgba(232, 114, 12, .16);
    color: #ffad62;
  }
  .sl-premium-chrome .sl-menu .sl-menu__cta { color: #07130d; }
  main { width: 100%; max-width: 720px; margin: 52px auto; padding: 0 24px; }
  .card {
    background: var(--sl-bg-card);
    border: 1px solid var(--sl-border);
    border-radius: var(--sl-radius-lg);
    padding: clamp(22px, 4vw, 32px);
    box-shadow: var(--sl-shadow-sm), var(--sl-shadow-md);
  }
  .sl-eyebrow {
    margin: 0 0 12px;
    color: var(--sl-orange-text);
    font-family: var(--sl-font-mono);
    font-size: .75rem;
    font-weight: 500;
    letter-spacing: .14em;
    text-transform: uppercase;
  }
  .sl-cluster { display: flex; align-items: center; flex-wrap: wrap; gap: 12px; }
  .sl-panel {
    background: var(--sl-bg-card);
    border: 1px solid var(--sl-border);
    border-radius: var(--sl-radius-lg);
    box-shadow: var(--sl-shadow-sm), var(--sl-shadow-md);
  }
  main button, a.button {
    min-height: 46px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-top: 20px;
    background: var(--sl-green-btn);
    color: white;
    border: 1.5px solid var(--sl-green-btn);
    padding: 11px 22px;
    font: inherit;
    font-weight: 700;
    line-height: 1.2;
    border-radius: 999px;
    cursor: pointer;
    text-decoration: none;
    box-shadow: 0 10px 24px -16px rgba(9, 50, 29, .65);
    transition: background-color .18s ease, border-color .18s ease,
                color .18s ease, transform .18s ease, box-shadow .18s ease;
  }
  main button:hover, a.button:hover {
    background: var(--sl-green);
    color: white;
    transform: translateY(-1px);
    box-shadow: 0 14px 28px -16px rgba(9, 50, 29, .72);
  }
  main button:disabled { background: #bbb; border-color: #bbb; box-shadow: none; cursor: default; transform: none; }
  a.button.secondary { background: transparent; color: var(--sl-green); border-color: var(--sl-border-strong); box-shadow: none; }
  a.button.secondary:hover { background: var(--sl-bg-card); border-color: var(--sl-green); color: var(--sl-green); }
  .hint { color: var(--sl-ink-soft); font-size: 0.88rem; margin-top: 4px; }
  .bar { background: #e6e3dc; border-radius: 6px; height: 14px; margin: 14px 0 6px; }
  .bar > div { background: var(--accent); border-radius: 6px; height: 100%;
               transition: width 0.4s; min-width: 6px; }
  .bar-label { color: var(--sl-ink-soft); font-size: 0.9rem; }
  .error { color: #b3261e; white-space: pre-wrap; }
  .sl-profile-reminder {
    padding: 10px var(--sl-pad-x);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    background: #fff3e4;
    border-bottom: 1px solid #efd3b3;
    color: var(--sl-ink-soft);
    font-size: .9rem;
  }
  .sl-profile-reminder a { font-weight: 750; white-space: nowrap; }
  .disclaimer { color: var(--sl-ink-muted); font-style: italic; font-size: 0.85rem; margin-top: 24px; }
  .sl-app-footer {
    margin-top: clamp(48px, 8vw, 96px);
    padding: clamp(40px, 6vw, 68px) var(--sl-pad-x) 28px;
    background: #0f1712;
    color: #9fb0a4;
    font-size: .86rem;
  }
  .sl-app-footer__inner {
    width: 100%;
    max-width: var(--sl-content);
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(240px, 1.5fr) repeat(2, minmax(150px, .7fr));
    gap: clamp(28px, 6vw, 72px);
  }
  .sl-app-footer__logo {
    display: inline-flex;
    color: #f5f2e9;
    font-size: 22px;
    font-weight: 900;
    letter-spacing: -.02em;
    text-decoration: none;
  }
  .sl-app-footer__logo:hover { color: #fff; }
  .sl-app-footer__brand p { max-width: 38ch; margin: 14px 0 0; line-height: 1.65; }
  .sl-app-footer__nav { display: grid; align-content: start; gap: 9px; }
  .sl-app-footer__nav strong {
    margin-bottom: 4px;
    color: #f5f2e9;
    font-family: var(--sl-font-mono);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: .15em;
    text-transform: uppercase;
  }
  .sl-app-footer__nav a { color: #b8c5bb; text-decoration: none; }
  .sl-app-footer__nav a:hover { color: #ffad62; }
  .sl-app-footer__bottom {
    max-width: var(--sl-content);
    margin: 34px auto 0;
    padding-top: 22px;
    display: flex;
    justify-content: space-between;
    gap: 18px;
    border-top: 1px solid rgba(245, 242, 233, .12);
    color: #7f9184;
  }
  .sl-app-footer__bottom p { margin: 0; }
  @media (max-width: 980px) {
    .sl-header { min-height: 64px; }
    .sl-header__inner,
    .sl-header--premium .sl-header__inner { min-height: 64px; gap: 10px; }
    .sl-header__desktop-nav,
    .sl-header__account,
    .sl-header__app { display: none; }
    .sl-header__actions { margin-left: auto; gap: 8px; }
    .sl-header__toggle { display: flex; }
    .sl-header__logo { font-size: 18px; }
    .sl-header__logo-img { height: 28px; max-width: 175px; object-fit: contain; }
    .sl-header__cart { min-height: 38px; }
    main { margin-top: 32px; padding: 0 18px; }
    .sl-app-footer__inner { grid-template-columns: 1fr 1fr; }
    .sl-app-footer__brand { grid-column: 1 / -1; }
  }
  @media (max-width: 560px) {
    .sl-app-banner { padding-inline: 14px; }
    .sl-app-banner__inner { gap: 8px; }
    .sl-app-banner__detail { display: none; }
  }
  @media (max-width: 390px) {
    .sl-header { padding-inline: 12px; }
    .sl-header__logo-img { height: 24px; max-width: 142px; }
    .sl-header__cart { padding: 5px 10px; }
    .sl-profile-reminder { align-items: flex-start; flex-direction: column; gap: 3px; }
    .sl-app-footer__inner { grid-template-columns: 1fr; }
    .sl-app-footer__brand { grid-column: auto; }
    .sl-app-footer__bottom { flex-direction: column; }
  }
  body.sl-reduced-motion *,
  body.sl-reduced-motion *::before,
  body.sl-reduced-motion *::after {
    animation-duration: .01ms !important;
    animation-iteration-count: 1 !important;
    scroll-behavior: auto !important;
    transition-duration: .01ms !important;
  }
  body.sl-reduced-motion .sl-menu[open] .sl-menu__panel { animation: none; }
  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
    *, *::before, *::after {
      animation-duration: .01ms !important;
      animation-iteration-count: 1 !important;
      scroll-behavior: auto !important;
      transition-duration: .01ms !important;
    }
    .sl-menu[open] .sl-menu__panel { animation: none; }
  }
  {% block style %}{% endblock %}
</style>
</head>
<body class="sl-premium-chrome{% if header_profile and header_profile.reduced_motion %} sl-reduced-motion{% endif %}">
{% set member_name = header_profile.display_name if header_profile and header_profile.display_name else '' %}
{% set free_limit = free_per_month|default(1) %}
<a class="sl-skip" href="#MainContent">Skip to content</a>
<aside class="sl-app-banner{% if user and user.is_pro %} sl-app-banner--pro{% endif %}" aria-label="Membership status">
  <div class="sl-app-banner__inner">
    <span class="sl-app-banner__dot" aria-hidden="true"></span>
    {% if user and user.is_pro %}
      <span class="sl-app-banner__status">Pro member</span>
      <span class="sl-app-banner__detail">{{ "Welcome back, " ~ member_name ~ "." if member_name else "Your game plan is ready." }}</span>
      <a href="/">Let&rsquo;s work on your swing &rarr;</a>
    {% elif user %}
      <span class="sl-app-banner__status">Free plan</span>
      <span>{% if free_limit <= 0 %}Unlimited complete reports{% else %}{{ free_limit }} complete report{% if free_limit != 1 %}s{% endif %} each month{% endif %}</span>
      <span class="sl-app-banner__detail">&middot; club context saved</span>
    {% else %}
      <span class="sl-app-banner__status">Start free</span>
      <span>{% if free_limit <= 0 %}Unlimited full reports{% else %}{{ free_limit }} full report{% if free_limit != 1 %}s{% endif %} / month{% endif %}</span>
      <span class="sl-app-banner__detail">&middot; no card &middot; club context saved</span>
    {% endif %}
  </div>
</aside>
<header class="sl-header sl-header--premium" data-sl-header data-menu-id="sl-mobile-menu">
  <div class="sl-header__inner">
    <a class="sl-header__logo" href="{{ storefront_url or '/' }}" aria-label="{{ brand.name }} home">
      {% if brand.logo_url %}
        <img class="sl-header__logo-img" src="{{ brand.logo_url }}" alt="{{ brand.name }}">
      {% else %}
        {{ brand.name | upper }}
      {% endif %}
    </a>

    <nav class="sl-header__desktop-nav" aria-label="Main navigation">
      {% if user or not require_account %}
      <details class="sl-header__dropdown" data-header-dropdown>
        <summary class="sl-header__dropdown-trigger{% if current_path == '/today' or current_path == '/sessions' or current_path == '/progress' or current_path == '/drills' %} is-current{% endif %}">
          My Game
          <span class="sl-header__chevron" aria-hidden="true"></span>
        </summary>
        <div class="sl-header__dropdown-menu">
          {% if require_account %}<a href="/today" {% if current_path == '/today' %}aria-current="page"{% endif %}>Today</a>{% endif %}
          <a href="/sessions" {% if current_path == '/sessions' %}aria-current="page"{% endif %}>History</a>
          {% if require_account %}
            <a href="/progress" {% if current_path == '/progress' %}aria-current="page"{% endif %}>Progress{% if user and progress_pro_only and not user.is_pro %} <span aria-label="Included with Pro" title="Included with Pro">&#128274;</span>{% endif %}</a>
          {% endif %}
          <a href="/drills" {% if current_path == '/drills' %}aria-current="page"{% endif %}>Drills</a>
        </div>
      </details>
      {% else %}
      <a class="sl-header__link{% if current_path == '/drills' %} is-current{% endif %}" href="/drills" {% if current_path == '/drills' %}aria-current="page"{% endif %}>Drills</a>
      {% endif %}
      {% if shop_enabled %}<a class="sl-header__link{% if current_path == '/shop' %} is-current{% endif %}" href="/shop" {% if current_path == '/shop' %}aria-current="page"{% endif %}>Gear</a>{% endif %}
      {% if user and user.is_pro %}
      <a class="sl-header__member" href="/today" data-pro-member-nav>
        <span class="sl-header__member-badge">PRO</span>
        <span>{{ "Welcome back, " ~ member_name if member_name else "Your Pro game plan" }}</span>
      </a>
      {% else %}
      <a class="sl-header__link{% if current_path == '/pricing' %} is-current{% endif %}" href="/pricing" {% if current_path == '/pricing' %}aria-current="page"{% endif %}>Pro</a>
      {% endif %}
    </nav>

    <div class="sl-header__actions">
      {% if require_account or storefront_url %}
      <details class="sl-header__dropdown sl-header__account" data-header-dropdown>
        <summary class="sl-header__dropdown-trigger{% if current_path == '/account' or current_path == '/login' or current_path == '/signup' %} is-current{% endif %}">
          Account
          <span class="sl-header__chevron" aria-hidden="true"></span>
        </summary>
        <div class="sl-header__dropdown-menu sl-header__dropdown-menu--right">
          {% if require_account and user %}
            <a href="/account" {% if current_path == '/account' %}aria-current="page"{% endif %}>{{ brand.name }} profile</a>
            <form action="{% if shopify_customer_accounts_enabled and user.shopify_account_migration_state == 'shopify_authenticated' %}/auth/shopify/logout{% else %}/logout{% endif %}" method="post">
              <button class="sl-header__logout" type="submit">Log out</button>
            </form>
          {% elif require_account %}
            <a href="/login" {% if current_path == '/login' %}aria-current="page"{% endif %}>Sign in</a>
            <a href="/signup" {% if current_path == '/signup' %}aria-current="page"{% endif %}>Create free account</a>
          {% endif %}
          {% if storefront_url %}<a href="{{ storefront_url }}/account">Orders &amp; subscriptions</a>{% endif %}
        </div>
      </details>
      {% endif %}

      {% if storefront_url %}<a class="sl-header__cart" href="{{ storefront_url }}/cart">Cart</a>{% endif %}
      <a class="sl-header__cta sl-header__app" href="{% if user or not require_account %}/{% else %}/signup{% endif %}">{% if user or not require_account %}Analyze a swing{% else %}Analyze free{% endif %}</a>
      <button class="sl-header__toggle" type="button"
              aria-label="Menu"
              aria-expanded="false"
              aria-haspopup="dialog"
              aria-controls="sl-mobile-menu"
              data-menu-open>
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
</header>
{% if require_account and user and (not header_profile or not header_profile.is_complete) and current_path != '/onboarding' %}
<aside class="sl-profile-reminder" aria-label="Profile setup reminder">
  <span><strong>Make {{ brand.name }} yours.</strong> Add your name, goal, and primary club{% if not user.has_password %}, and choose whether to add a backup password{% endif %}.</span>
  <a href="/onboarding">Finish golfer profile</a>
</aside>
{% endif %}

<dialog class="sl-menu" id="sl-mobile-menu" aria-labelledby="sl-mobile-menu-title" data-sl-menu>
  <div class="sl-menu__panel">
    <div class="sl-menu__head">
      <h2 class="sl-menu__title" id="sl-mobile-menu-title">Menu</h2>
      <button class="sl-menu__close" type="button" aria-label="Close menu" data-menu-close>
        <span aria-hidden="true"></span>
        <span aria-hidden="true"></span>
      </button>
    </div>

    <nav class="sl-menu__nav" aria-label="Main navigation">
        <a class="sl-header__cta sl-menu__cta" href="{% if user or not require_account %}/{% else %}/signup{% endif %}" data-menu-link>{% if user or not require_account %}Analyze a swing{% else %}Analyze free{% endif %}</a>

      <div class="sl-menu__group">
        <p class="sl-menu__eyebrow">Practice</p>
        {% if require_account and user %}
        <a class="sl-menu__link{% if current_path == '/today' %} is-current{% endif %}" href="/today" data-menu-link {% if current_path == '/today' %}aria-current="page"{% endif %}>
          <span>Today</span><span aria-hidden="true">&rarr;</span>
        </a>
        {% endif %}
        {% if user or not require_account %}
        <a class="sl-menu__link{% if current_path == '/sessions' %} is-current{% endif %}" href="/sessions" data-menu-link {% if current_path == '/sessions' %}aria-current="page"{% endif %}>
          <span>History</span><span aria-hidden="true">&rarr;</span>
        </a>
        {% endif %}
        {% if require_account and user %}
        <a class="sl-menu__link{% if current_path == '/progress' %} is-current{% endif %}" href="/progress" data-menu-link {% if current_path == '/progress' %}aria-current="page"{% endif %}>
          <span>Progress{% if user and progress_pro_only and not user.is_pro %} <span aria-label="Included with Pro" title="Included with Pro">&#128274;</span>{% endif %}</span><span aria-hidden="true">&rarr;</span>
        </a>
        {% endif %}
        <a class="sl-menu__link{% if current_path == '/drills' %} is-current{% endif %}" href="/drills" data-menu-link {% if current_path == '/drills' %}aria-current="page"{% endif %}>
          <span>Drills</span><span aria-hidden="true">&rarr;</span>
        </a>
        {% if user and user.is_pro %}
        <a class="sl-menu__link" href="/today" data-menu-link data-pro-member-nav>
          <span>{{ "Welcome back, " ~ member_name if member_name else "Your Pro game plan" }}</span><span class="sl-header__member-badge">PRO</span>
        </a>
        {% endif %}
      </div>

      {% if shop_enabled or not (user and user.is_pro) %}
      <div class="sl-menu__group">
        <p class="sl-menu__eyebrow">Shop</p>
        {% if shop_enabled %}
        <a class="sl-menu__link{% if current_path == '/shop' %} is-current{% endif %}" href="/shop" data-menu-link {% if current_path == '/shop' %}aria-current="page"{% endif %}>
          <span>Gear</span><span aria-hidden="true">&rarr;</span>
        </a>
        {% endif %}
        {% if not (user and user.is_pro) %}
        <a class="sl-menu__link{% if current_path == '/pricing' %} is-current{% endif %}" href="/pricing" data-menu-link {% if current_path == '/pricing' %}aria-current="page"{% endif %}>
          <span>Pro</span><span aria-hidden="true">&rarr;</span>
        </a>
        {% endif %}
      </div>
      {% endif %}

      {% if require_account or storefront_url %}
      <div class="sl-menu__group">
        <p class="sl-menu__eyebrow">Account</p>
        {% if require_account and user %}
        <a class="sl-menu__link{% if current_path == '/account' %} is-current{% endif %}" href="/account" data-menu-link {% if current_path == '/account' %}aria-current="page"{% endif %}>
          <span>{{ brand.name }} profile</span><span aria-hidden="true">&rarr;</span>
        </a>
        <form action="{% if shopify_customer_accounts_enabled and user.shopify_account_migration_state == 'shopify_authenticated' %}/auth/shopify/logout{% else %}/logout{% endif %}" method="post">
          <button class="sl-menu__link sl-menu__logout" type="submit">
            <span>Log out</span><span aria-hidden="true">&rarr;</span>
          </button>
        </form>
        {% elif require_account %}
        <a class="sl-menu__link{% if current_path == '/login' %} is-current{% endif %}" href="/login" data-menu-link {% if current_path == '/login' %}aria-current="page"{% endif %}>
          <span>Sign in</span><span aria-hidden="true">&rarr;</span>
        </a>
        <a class="sl-menu__link{% if current_path == '/signup' %} is-current{% endif %}" href="/signup" data-menu-link {% if current_path == '/signup' %}aria-current="page"{% endif %}>
          <span>Create free account</span><span aria-hidden="true">&rarr;</span>
        </a>
        {% endif %}
        {% if storefront_url %}
        <a class="sl-menu__link" href="{{ storefront_url }}/account" data-menu-link>
          <span>Orders &amp; subscriptions</span><span aria-hidden="true">&rarr;</span>
        </a>
        {% endif %}
      </div>
      {% endif %}
    </nav>
  </div>
</dialog>
<main id="MainContent">
{% block main %}{% endblock %}
</main>
<footer class="sl-app-footer">
  <div class="sl-app-footer__inner">
    <div class="sl-app-footer__brand">
      <a class="sl-app-footer__logo" href="{{ storefront_url or '/' }}">{{ brand.name }}</a>
      <p>One priority. One practice plan. Proof when you re-film.</p>
    </div>
    <nav class="sl-app-footer__nav" aria-label="Practice links">
      <strong>Practice</strong>
      <a href="{% if user or not require_account %}/{% else %}/signup{% endif %}">{% if user or not require_account %}Analyze a swing{% else %}Analyze free{% endif %}</a>
      {% if user or not require_account %}<a href="/sessions">History</a>{% endif %}
      {% if require_account and user %}<a href="/progress">Progress</a>{% endif %}
      <a href="/drills">Drills</a>
    </nav>
    <nav class="sl-app-footer__nav" aria-label="Account and shop links">
      <strong>{{ brand.name }}</strong>
      {% if require_account and user %}
        <a href="/account">Your profile</a>
      {% elif require_account %}
        <a href="/login">Sign in</a>
        <a href="/signup">Create free account</a>
      {% endif %}
      {% if shop_enabled %}<a href="/shop">Training gear</a>{% endif %}
      {% if not (user and user.is_pro) %}<a href="/pricing">Pro membership</a>{% endif %}
      {% if storefront_url %}<a href="{{ storefront_url }}">Visit the storefront</a>{% endif %}
    </nav>
  </div>
  <div class="sl-app-footer__bottom">
    <p>{{ brand.footer_text }}</p>
    <p>Supported 2D movement and timing estimates from phone video.</p>
  </div>
</footer>
<script>
  (function () {
    var header = document.querySelector('[data-sl-header]');
    if (!header) return;

    var menu = document.getElementById(header.getAttribute('data-menu-id'));
    var openButton = header.querySelector('[data-menu-open]');
    var closeButton = menu && menu.querySelector('[data-menu-close]');
    var menuLinks = menu ? menu.querySelectorAll('[data-menu-link]') : [];
    var desktopMenus = header.querySelectorAll('[data-header-dropdown]');
    var restoreMenuFocus = false;

    function finishMenuClose() {
      openButton.setAttribute('aria-expanded', 'false');
      document.documentElement.classList.remove('sl-menu-open');
      if (restoreMenuFocus) openButton.focus();
      restoreMenuFocus = false;
    }

    function closeMenu(restoreFocus) {
      if (!menu || !menu.hasAttribute('open')) return;
      restoreMenuFocus = restoreFocus;
      if (typeof menu.close === 'function') {
        menu.close();
      } else {
        menu.removeAttribute('open');
        finishMenuClose();
      }
    }

    function openMenu() {
      if (!menu || menu.hasAttribute('open')) return;
      if (typeof menu.showModal === 'function') {
        menu.showModal();
      } else {
        menu.setAttribute('open', '');
      }
      openButton.setAttribute('aria-expanded', 'true');
      document.documentElement.classList.add('sl-menu-open');
      if (closeButton) closeButton.focus();
    }

    if (menu && openButton) {
      openButton.addEventListener('click', openMenu);
      if (closeButton) closeButton.addEventListener('click', function () { closeMenu(true); });
      menu.addEventListener('cancel', function (event) {
        event.preventDefault();
        closeMenu(true);
      });
      menu.addEventListener('close', finishMenuClose);
      menu.addEventListener('click', function (event) {
        if (event.target === menu) closeMenu(true);
      });
      for (var i = 0; i < menuLinks.length; i++) {
        menuLinks[i].addEventListener('click', function () { closeMenu(false); });
      }
      var desktopQuery = window.matchMedia('(min-width: 981px)');
      var closeOnBreakpointChange = function (event) {
        for (var i = 0; i < desktopMenus.length; i++) {
          desktopMenus[i].removeAttribute('open');
        }
        if (event.matches) closeMenu(false);
      };
      if (desktopQuery.addEventListener) desktopQuery.addEventListener('change', closeOnBreakpointChange);
    }

    for (var j = 0; j < desktopMenus.length; j++) {
      desktopMenus[j].addEventListener('toggle', function (event) {
        if (!event.currentTarget.open) return;
        for (var k = 0; k < desktopMenus.length; k++) {
          if (desktopMenus[k] !== event.currentTarget) desktopMenus[k].removeAttribute('open');
        }
      });
      desktopMenus[j].addEventListener('focusout', function (event) {
        if (!event.currentTarget.contains(event.relatedTarget)) {
          event.currentTarget.removeAttribute('open');
        }
      });
    }
    document.addEventListener('click', function (event) {
      for (var i = 0; i < desktopMenus.length; i++) {
        if (!desktopMenus[i].contains(event.target)) desktopMenus[i].removeAttribute('open');
      }
    });
    document.addEventListener('keydown', function (event) {
      if (event.key !== 'Escape') return;
      for (var i = 0; i < desktopMenus.length; i++) {
        if (!desktopMenus[i].hasAttribute('open')) continue;
        desktopMenus[i].removeAttribute('open');
        var summary = desktopMenus[i].querySelector('summary');
        if (summary) summary.focus();
      }
    });
  })();
</script>
<script>
  if ("serviceWorker" in navigator) {
    window.addEventListener("load", function () {
      navigator.serviceWorker.register("/service-worker.js").catch(function () {
        // Offline support is progressive enhancement; a failed registration
        // must never affect account, report, or upload behavior.
      });
    });
  }
</script>
{% block script %}{% endblock %}
</body>
</html>
