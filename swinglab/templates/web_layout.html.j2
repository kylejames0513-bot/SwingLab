  </a>
  {% endif %}

  {% if user or not require_account %}
  <a class="sl-tabbar__item{% if current_path == '/sessions' %} is-current{% endif %}"
     href="/sessions" {% if current_path == '/sessions' %}aria-current="page"{% endif %}>
    <svg class="sl-tabbar__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor"
         stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M3.6 12a8.4 8.4 0 1 0 2.2-5.7"/>
      <path d="M3.4 4.4v3.6h3.6"/>
      <path d="M12 7.6V12l3 1.9"/>
    </svg>
    <span class="sl-tabbar__label">History</span>
  </a>
  {% endif %}

