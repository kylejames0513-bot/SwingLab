    <strong>Install {{ brand.name }}</strong>
    <span>Add it to your home screen so a range session is one tap from the camera roll.</span>
  </div>
  <button class="sl-install__go" type="button" data-install-accept>Install</button>
  <button class="sl-install__dismiss" type="button" data-install-dismiss>Not now</button>
</aside>
<main id="MainContent">
{% block main %}{% endblock %}
</main>
