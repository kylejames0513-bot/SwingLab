<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
{# viewport-fit=cover lets the installed app paint under the notch and the
   home indicator; every edge is then re-inset with env(safe-area-inset-*)
   below, so nothing lands under the hardware. #}
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#070f0b">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-title" content="{{ brand.name }}">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<title>{% block title %}{{ brand.name }}{% endblock %}</title>
{# Share and search metadata.

   Every tag below resolves with no extra render context, because the most
   shared thing in this product is a link somebody pasted into a group chat
   and there is no page where a bare grey preview is acceptable. A caller
   that knows better overrides any of it by passing meta_description,
   og_title, og_type, canonical_url or og_image_url — no template change.

   The absolute-URL tags (canonical, og:url, og:image) are emitted only when
   an origin is known. A wrong canonical is worse than none: it hands the
   page to another site. #}
{% block meta %}
{% set site_origin = brand.site_url | default('', true) | trim('/') %}
{% set page_description = meta_description | default(brand.meta_description, true) %}
{% set page_url = canonical_url | default(site_origin ~ current_path if site_origin and current_path else site_origin, true) %}
{% set share_image = og_image_url | default(site_origin ~ '/static/og-caddieinsight.png' if site_origin else '', true) %}
{% if page_description %}<meta name="description" content="{{ page_description }}">{% endif %}
<meta property="og:site_name" content="{{ brand.name }}">
<meta property="og:type" content="{{ og_type | default('website', true) }}">
{# self.title() reuses the page's own <title> block, so every page gets its
   real name in a preview instead of one shared brand string. #}
<meta property="og:title" content="{{ og_title | default(self.title(), true) }}">
{% if page_description %}<meta property="og:description" content="{{ page_description }}">{% endif %}
{% if page_url %}<meta property="og:url" content="{{ page_url }}">{% endif %}
{% if share_image %}<meta property="og:image" content="{{ share_image }}">{% endif %}
<meta name="twitter:card" content="summary_large_image">
{% if share_image %}<meta name="twitter:image" content="{{ share_image }}">{% endif %}
{% if page_url %}<link rel="canonical" href="{{ page_url }}">{% endif %}
{% endblock %}
<link rel="manifest" href="/app.webmanifest">
<link rel="icon" href="/static/pwa-icon.svg" type="image/svg+xml">
{# caddieinsight-*, not the retired swinglab-* mark of the same geometry —
   new code never binds a v3 filename (CLAUDE.md). #}
<link rel="icon" href="/static/caddieinsight-favicon.png" sizes="512x512" type="image/png">
{# iOS ignores SVG touch icons — this PNG is generated from the same mark
   by store-assets/make_brand.py (opaque, 180x180). #}
<link rel="apple-touch-icon" sizes="180x180" href="/static/apple-touch-icon.png">
{# The same self-hosted faces the storefront ships, byte for byte (they are
   written by store-assets/make_fonts.py into both surfaces in one pass):
   Archivo variable 400-800 for interface, a static Archivo Expanded
   wdth-125/wght-800 for display, and two DM Mono weights for every measured
   value. ~79 KB total, latin subset, no third-party origin at runtime.

   The display face is a separate static rather than the dual-axis variable
   because wdth 125 is a NAMED instance in Archivo's STAT table and therefore
   ships pre-built at 14,536 bytes, where the dual-axis file costs 90,104.

   The guided report asks for Archivo first and relies on the shell having
   loaded it. Only the two faces above the fold are preloaded. #}
<link rel="preload" href="/static/barlow-latin-400.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/static/barlow-condensed-latin-600.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/static/dm-mono-latin-500.woff2" as="font" type="font/woff2" crossorigin>
<style>
  @font-face {
    font-family: "Barlow";
    font-style: normal;
    font-weight: 400;
    font-display: swap;
    src: url("/static/barlow-latin-400.woff2") format("woff2");
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
  }
  @font-face {
    font-family: "Barlow";
    font-style: normal;
    font-weight: 500;
    font-display: swap;
    src: url("/static/barlow-latin-500.woff2") format("woff2");
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
  }
  @font-face {
    font-family: "Barlow Condensed";
    font-style: normal;
    font-weight: 600;
    font-display: swap;
    src: url("/static/barlow-condensed-latin-600.woff2") format("woff2");
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
  }
  @font-face {
    font-family: "DM Mono";
    font-style: normal;
    font-weight: 400;
    font-display: swap;
    src: url("/static/dm-mono-latin-400.woff2") format("woff2");
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
  }
  @font-face {
    font-family: "DM Mono";
    font-style: normal;
    font-weight: 500;
    font-display: swap;
    src: url("/static/dm-mono-latin-500.woff2") format("woff2");
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
  }
</style>
<style>
  :root {
    --primary: {{ brand.primary_color }};
    --accent: {{ brand.accent_color }};
    {# INDUSTRY, 2026-08-11: the ground is PAPER on both surfaces and the deep
       green survives as the one reversed FIELD. Every token below whose name
       is shared with storefront-theme/assets/base.css is spelled EXACTLY as
       that file spells it — the parity contract compares text, not numbers.

       The names still did not change, for the reason they did not change in
       the 2026-08-10 inversion: --sl-green is referenced 131 times across the
       two surfaces and --sl-border 90, and renaming would have touched ~1,400
       call sites to buy nothing. The tokens were already used for the role
       their name describes, so redefining in place inverts the system at
       once. #}
    --sl-bg: #f2f2f3;
    --sl-bg-card: #f2f2f3;
    --sl-surface-soft: #eef6ff;
    --sl-surface-dark: #e9e9ea;
    --sl-night: #e9e9ea;
    --sl-ink: #1d1f20;
    {# Deliberately DARKER than the storefront's #6a6a6d, for the same reason
       it used to be lighter: this surface sets small interface text where the
       storefront sets display prose, so it needs the extra headroom. The
       rationale has now survived two inversions; only the direction flips.
       5.43 on paper against the storefront's 4.82. #}
    --sl-ink-soft: #5d5d60;
    --sl-ink-muted: #626265;
    --sl-green: #1d1f20;
    --sl-green-btn: #2c455d;
    --sl-green-ink: #f2f2f3;
    --sl-orange: #416180;
    {# The signal at app-text headroom: 7.38 against the storefront's 5.78. #}
    --sl-orange-text: #375169;
    --sl-orange-soft: #eef6ff;
    --sl-cream: #f2f2f3;
    --sl-accent: #416180;
    --sl-accent-hover: #2c455d;
    --sl-steel: #5980a6;
    --sl-focus: #416180;
    --sl-focus-dark: #94bce3;
    --sl-arc: rgba(89, 128, 166, 0.28);
    --sl-trace: #94bce3;
    --sl-trace-dim: #5980a6;
    --sl-field: #070f0b;
    --sl-field-lift: #0b1712;
    --sl-field-ink: #f2f2f3;
    --sl-field-soft: #a8b3ac;
    --sl-field-muted: #8f9a93;
    --sl-field-rule: #243229;
    --sl-field-control: #66756c;
    --sl-band: #1d2d3d;
    --sl-band-ink: #f2f2f3;
    --sl-paper: #f2f2f3;
    --sl-paper-ink: #1d1f20;
    --sl-paper-soft: #5d5d60;
    --sl-paper-line: #d0d1d1;
    --sl-brand-green: #0f3d28;
    {# Error text returns to the light-surface red it originally was. The
       2026-08-10 comment here recorded that #b3261e lands at 2.97 on a dark
       field and had to be replaced; on paper it is 5.84 and correct again. #}
    --sl-danger: #b3261e;
    {# Hover for an ink control — see base.css. It deepens on paper where it
       lifted on the field. Neither signal is ever interaction feedback. #}
    --sl-ink-hi: #0b0c0c;
    {# Wash on paper, cream on field — pick by ground. See base.css. #}
    --sl-wash-rgb: 29, 31, 32;
    --sl-cream-rgb: 242, 242, 243;
    --sl-night-rgb: 233, 233, 234;
    --sl-accent-rgb: 65, 97, 128;
    --sl-steel-rgb: 89, 128, 166;
    --sl-green-rgb: 29, 31, 32;
    --sl-trace-rgb: 148, 188, 227;
    --sl-field-rgb: 7, 15, 11;
    --sl-border: #d0d1d1;
    --sl-border-strong: #b7b7ba;
    {# 4.54 on paper. Darker than the storefront's #7a7a7d (3.82) for the same
       headroom reason — an app control edge is smaller than a storefront one.
       Both clear WCAG 1.4.11's 3:1 for non-text contrast; --sl-border at 1.37
       does not, and is decorative only. #}
    --sl-control-border: #6e6e71;
    {# Blueprint objects are square — see base.css. #}
    --sl-radius-sm: 0;
    --sl-radius-md: 0;
    --sl-radius-lg: 0;
    --sl-radius-xl: 0;
    --sl-radius-control: 0;
    {# Elevation inverts with the ground: a soft ink cast is legible on paper
       where the lit top edge did the work on the field. Shallow on purpose —
       Industry's objects are line drawings, and a card that floats stops
       reading as a drawing. #}
    --sl-shadow-sm: 0 1px 2px rgba(29, 31, 32, .14);
    --sl-shadow-md: 0 3px 10px rgba(29, 31, 32, .16);
    --sl-shadow-lg: 0 12px 32px rgba(29, 31, 32, .22);
    --sl-content: 1280px;
    --sl-maxw: var(--sl-content);
    --sl-pad-x: clamp(24px, 5vw, 64px);
    {# The spacing scale, same nine rungs as the storefront. #}
    --sl-space-1: 4px;
    --sl-space-2: 8px;
    --sl-space-3: 12px;
    --sl-space-4: 16px;
    --sl-space-5: 24px;
    --sl-space-6: 32px;
    --sl-space-7: 48px;
    --sl-space-8: 64px;
    --sl-space-9: 96px;
    {# The display rungs the storefront defines, spelled the same. The app
       used to stop before these and every big app heading was a hand-rolled
       clamp() — which is how two surfaces that share a typeface end up not
       sharing a scale. They came DOWN when display moved to the expanded
       face and go back UP now that it is condensed: the same point size
       occupies far less line. #}
    --sl-heading-display: clamp(40px, 5vw, 64px);
    --sl-heading-support: clamp(30px, 3.8vw, 44px);
    --sl-eyebrow-size: 12px;
    --sl-eyebrow-track: 0.16em;
    --sl-font-sans: "Barlow", "Helvetica Neue", Helvetica, Arial, sans-serif;
    --sl-font-display: "Barlow Condensed", "Barlow", "Helvetica Neue", Helvetica, sans-serif;
    --sl-font-mono: "DM Mono", ui-monospace, SFMono-Regular, Consolas, "Liberation Mono", monospace;
    {# The three weights that ship. Barlow has no variable font, so anything
       else is synthesised — a rule that wants bolder takes the display FACE. #}
    --sl-weight-body: 400;
    --sl-weight-medium: 500;
    --sl-weight-display: 600;
    {# Spelled exactly as storefront-theme/assets/base.css spells them —
       leading zeros included. The values were already numerically identical,
       but `.15vw` versus `0.15vw` is a textual difference, and a parity test
       that has to normalise before it can compare is a test that will one day
       normalise away a real divergence. #}
    --sl-text-xs: 12px;
    --sl-text-sm: clamp(13.5px, 13px + 0.15vw, 14.5px);
    --sl-text-base: clamp(15.5px, 15px + 0.2vw, 17px);
    --sl-text-lg: clamp(17px, 16.2px + 0.35vw, 19px);
    --sl-text-xl: clamp(20px, 18.8px + 0.55vw, 23px);
    --sl-text-2xl: clamp(24px, 21.8px + 1vw, 30px);
    --sl-text-3xl: clamp(24px, 21px + 1.4vw, 32px);
    --sl-text-4xl: clamp(28px, 23.5px + 2.1vw, 42px);
    /* Hardware insets, resolved once so every edge can reference them.
       They are 0 in a browser tab and non-zero on a notched installed app. */
    --sl-safe-top: env(safe-area-inset-top, 0px);
    --sl-safe-right: env(safe-area-inset-right, 0px);
    --sl-safe-bottom: env(safe-area-inset-bottom, 0px);
    --sl-safe-left: env(safe-area-inset-left, 0px);
    --sl-tabbar-h: 0px;
  }
  * { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; }
  body {
    margin: 0;
    min-height: 100vh;
    {# Plain paper — the same ground the storefront paints. The 8px technical
       grid is GONE: it existed to stop a near-black page reading as a dark
       theme, and under Industry the texture belongs to the objects instead
       (the 115deg hatch on .sl-field, the vertical rules on a hero). #}
    background: var(--sl-bg);
    color: var(--sl-ink);
    font-family: var(--sl-font-sans);
    font-size: var(--sl-text-base);
    font-weight: var(--sl-weight-body);
    line-height: 1.55;
    letter-spacing: 0;
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }
  h1, h2, h3 {
    font-family: var(--sl-font-display);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.04;
    text-wrap: balance;
    color: var(--sl-green);
  }
  {# Links are bone like body text, so the underline is the second signal
     that keeps them distinguishable, and it is not optional. Hover goes to
     the trace colour, never to amber: amber means a measured value. #}
  a {
    color: var(--sl-green-btn);
    text-decoration: underline;
    text-decoration-color: rgba(var(--sl-wash-rgb), .32);
    text-underline-offset: 0.2em;
    text-decoration-thickness: 1px;
  }
  a:hover { color: var(--sl-ink-hi); text-decoration-color: currentColor; }
  img { max-width: 100%; }
  ::selection { background: rgba(var(--sl-trace-rgb), .26); color: var(--sl-ink); }
  :focus-visible {
    outline: 2px solid var(--sl-focus-dark);
    outline-offset: 3px;
    border-radius: 2px;
  }
  .sl-skip {
    position: absolute;
    left: -9999px;
    top: 0;
    z-index: 100;
    background: var(--sl-green);
    color: var(--sl-green-ink);
    padding: 10px 18px;
    border-radius: 0 0 10px 0;
    text-decoration: none;
    font-weight: 600;
  }
  .sl-skip:focus-visible { left: 0; outline-color: var(--sl-orange); outline-offset: -3px; }
  html.sl-menu-open { overflow: hidden; }
  .sl-app-banner {
    position: relative;
    z-index: 42;
    min-height: 36px;
    padding: 8px var(--sl-pad-x);
    display: flex;
    align-items: center;
    background: var(--sl-band);
    border-bottom: 0;
    color: rgba(var(--sl-cream-rgb), .78);
    font-size: 12.5px;
  }
  .sl-app-banner--pro {
    background: var(--sl-band);
    box-shadow: inset 0 -2px 0 rgba(var(--sl-trace-rgb), .5);
  }
  .sl-app-banner__inner {
    width: 100%;
    max-width: var(--sl-content);
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    overflow: hidden;
    text-align: center;
    flex-wrap: nowrap;
  }
  .sl-app-banner__status {
    flex: 0 0 auto;
    color: var(--sl-focus-dark);
    font-family: var(--sl-font-mono);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: .13em;
    text-transform: uppercase;
  }
  .sl-app-banner--pro .sl-app-banner__status { color: var(--sl-trace); }
  .sl-app-banner__allowance,
  .sl-app-banner__detail {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .sl-app-banner__allowance { flex: 0 1 auto; max-width: min(42vw, 280px); }
  .sl-app-banner__detail { flex: 0 1 auto; }
  .sl-app-banner__dot {
    width: 6px;
    height: 6px;
    flex: 0 0 auto;
    border-radius: 50%;
    background: var(--sl-trace);
    box-shadow: 0 0 0 5px rgba(var(--sl-trace-rgb), .1);
  }
  .sl-app-banner a {
    flex: 0 0 auto;
    color: var(--sl-cream);
    font-weight: 500;
    text-underline-offset: 3px;
    white-space: nowrap;
  }
  .sl-app-banner a:hover { color: var(--sl-focus-dark); }
  {# ONE HEADER, ON PAPER. There used to be a whole parallel dark treatment
     under .sl-header--premium, and the app applied it unconditionally — so
     the "premium" variant WAS the app header and this base rule was
     unreachable, still carrying rgba(238,242,239,.92) from before the field
     inversion. Mockups 1a and 1c draw one paper header with a hairline rule
     under it, so the 31 override rules are gone and this is the only one
     left. The premium_chrome flag survives on the storefront, where it still
     selects which navigation a page shows — that is product logic and has
     nothing to do with the colour it used to also carry. #}
  .sl-header {
    position: sticky;
    top: 0;
    z-index: 40;
    min-height: 72px;
    padding: 0 var(--sl-pad-x);
    background: rgba(var(--sl-cream-rgb), 0.94);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--sl-border-strong);
  }
  .sl-header__inner {
    width: 100%;
    max-width: 1280px;
    max-width: var(--sl-content);
    min-height: 72px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    gap: clamp(16px, 2.5vw, 28px);
  }
  .sl-header__logo {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    color: var(--sl-green);
    font-size: 22px;
    font-weight: 600;
    letter-spacing: -0.02em;
    text-decoration: none;
  }
  .sl-header__logo-img { display: block; width: auto; height: 38px; }
  .sl-header__desktop-nav {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-left: auto;
  }
  .sl-header__link,
  .sl-header__dropdown-trigger {
    min-height: 38px;
    padding: 9px 12px;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    border-radius: var(--sl-radius-control);
    color: var(--sl-ink);
    font-size: 14px;
    font-weight: 600;
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
  }
  .sl-header__link:hover,
  .sl-header__dropdown-trigger:hover,
  .sl-header__dropdown[open] > .sl-header__dropdown-trigger {
    background: var(--sl-night);
    color: var(--sl-green-btn);
  }
  {# The current page is marked with bone and an underline, not amber. "You
     are here" is navigation state, not a value the engine measured — and the
     nav is on every screen, so amber here is the most repeated wrong use of
     the signal in the product. The underline carries the state without
     colour, which is also what keeps it legible to anyone who cannot
     separate the two hues. #}
  .sl-header__link.is-current,
  .sl-header__dropdown-trigger.is-current {
    background: var(--sl-night);
    color: var(--sl-ink);
    box-shadow: inset 0 -2px 0 var(--sl-steel);
  }
  .sl-header__member {
    min-height: 40px;
    max-width: min(188px, 22vw);
    min-width: 0;
    padding: 7px 12px 7px 8px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    flex: 0 1 auto;
    border: 1px solid var(--sl-control-border);
    border-radius: var(--sl-radius-control);
    background: transparent;
    color: var(--sl-green);
    font-size: 13px;
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
    overflow: hidden;
  }
  .sl-header__member:hover { border-color: var(--sl-ink); background: var(--sl-night); color: var(--sl-green); }
  .sl-header__member > span:last-child {
    min-width: 0;
    max-width: clamp(56px, 9vw, 104px);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .sl-header__member-badge {
    flex: 0 0 auto;
    padding: 4px 7px;
    border-radius: var(--sl-radius-control);
    background: var(--sl-green);
    color: var(--sl-bg);
    font-family: var(--sl-font-mono);
    font-size: 10px;
    letter-spacing: .08em;
  }
  .sl-header__account > summary,
  .sl-header__account .sl-header__dropdown-trigger {
    max-width: 136px;
    min-width: 0;
    overflow: hidden;
  }
  .sl-header__dropdown { position: relative; }
  .sl-header__dropdown summary { list-style: none; }
  .sl-header__dropdown summary::-webkit-details-marker { display: none; }
  .sl-header__chevron {
    width: 7px;
    height: 7px;
    border-right: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    transform: translateY(-2px) rotate(45deg);
    transition: transform .18s ease;
  }
  .sl-header__dropdown[open] .sl-header__chevron { transform: translateY(2px) rotate(225deg); }
  .sl-header__dropdown-menu {
    position: absolute;
    top: calc(100% + 10px);
    left: 0;
    z-index: 45;
    width: max-content;
    min-width: 210px;
    padding: 8px;
    display: grid;
    gap: 2px;
    background: var(--sl-bg-card);
    border: 1px solid var(--sl-border);
    border-radius: 14px;
    box-shadow: 0 18px 42px -24px rgba(15, 42, 27, 0.42);
  }
  .sl-header__dropdown-menu--right { right: 0; left: auto; }
  .sl-header__dropdown-menu a,
  .sl-header__logout {
    width: 100%;
    padding: 10px 12px;
    display: block;
    border: 0;
    border-radius: 9px;
    background: transparent;
    color: var(--sl-ink);
    font-family: inherit;
    font-size: 14px;
    font-weight: 600;
    text-align: left;
    text-decoration: none;
    cursor: pointer;
  }
  .sl-header__dropdown-menu form { margin: 0; }
  .sl-header__dropdown-menu a:hover,
  .sl-header__logout:hover {
    background: var(--sl-orange-soft);
    color: var(--sl-green);
  }
  .sl-header__actions {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-shrink: 0;
  }
  .sl-header__cta,
  .sl-header__cart {
    min-height: 40px;
    padding: 7px 16px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1.5px solid var(--sl-green);
    border-radius: var(--sl-radius-control);
    font-size: 14px;
    font-weight: 500;
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;
  }
  .sl-header__cta { background: var(--sl-green); color: var(--sl-green-ink); }
  .sl-header__cta:hover { background: var(--sl-ink-hi); color: var(--sl-green-ink); }
  .sl-header__cart { background: transparent; color: var(--sl-green); }
  .sl-header__cart:hover { border-color: var(--sl-ink); color: var(--sl-ink-hi); }
  {# Bone, not amber. This was the loudest violation of the palette's one
     rule left on either surface: amber marks a value the ENGINE MEASURED,
     and the single most prominent amber object in the product was a button.
     Bone on a near-black field is also simply louder than amber was. #}
  .sl-header__toggle {
    display: none;
    width: 44px;
    height: 44px;
    margin: 0;
    padding: 10px;
    flex-direction: column;
    align-items: stretch;
    justify-content: center;
    gap: 5px;
    border: 1.5px solid var(--sl-green);
    border-radius: 50%;
    background: transparent;
    color: var(--sl-green);
    cursor: pointer;
  }
  .sl-header__toggle:hover { background: var(--sl-bg-card); color: var(--sl-green-btn); }
  .sl-header__toggle span {
    display: block;
    width: 100%;
    height: 2px;
    border-radius: 2px;
    background: currentColor;
  }
  .sl-menu {
    width: 100vw;
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    overflow: hidden;
  }
  .sl-menu::backdrop { background: rgba(10, 28, 18, 0.46); }
  .sl-menu__panel {
    width: min(420px, 100vw);
    height: 100dvh;
    margin-left: auto;
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 20px;
    background: var(--sl-bg);
    border-left: 1px solid var(--sl-border);
    overflow-y: auto;
    overscroll-behavior: contain;
    box-shadow: -24px 0 60px -34px rgba(15, 42, 27, 0.55);
  }
  .sl-menu[open] .sl-menu__panel { animation: sl-menu-in .22s ease-out both; }
  @keyframes sl-menu-in {
    from { opacity: .85; transform: translateX(28px); }
    to { opacity: 1; transform: translateX(0); }
  }
  .sl-menu__head {
    min-height: 44px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .sl-menu__title {
    margin: 0;
    color: var(--sl-green);
    font-size: 20px;
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  .sl-menu__close {
    position: relative;
    width: 44px;
    height: 44px;
    margin: 0;
    padding: 0;
    border: 1.5px solid var(--sl-border);
    border-radius: 50%;
    background: var(--sl-bg-card);
    color: var(--sl-ink);
    cursor: pointer;
  }
  .sl-menu__close:hover { background: var(--sl-orange-soft); color: var(--sl-green); }
  .sl-menu__close span {
    position: absolute;
    top: 20px;
    left: 11px;
    width: 20px;
    height: 2px;
    border-radius: 2px;
    background: currentColor;
  }
  .sl-menu__close span:first-child { transform: rotate(45deg); }
  .sl-menu__close span:last-child { transform: rotate(-45deg); }
  .sl-menu__nav {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .sl-menu__cta {
    width: 100%;
    min-height: 48px;
    justify-content: center;
  }
  .sl-menu__group {
    padding-top: 18px;
    display: grid;
    gap: 2px;
    border-top: 1px solid var(--sl-border);
  }
  .sl-menu__eyebrow {
    margin: 0 0 7px;
    color: var(--sl-ink-muted);
    font-family: var(--sl-font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: .12em;
    text-transform: uppercase;
  }
  .sl-menu__link {
    min-height: 46px;
    padding: 10px 4px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    border-radius: 8px;
    color: var(--sl-ink);
    font-size: 17px;
    font-weight: 500;
    text-decoration: none;
  }
  .sl-menu__link:hover { color: var(--sl-green-btn); }
  .sl-menu__logout {
    width: 100%;
    border: 0;
    background: transparent;
    font-family: inherit;
    text-align: left;
    cursor: pointer;
  }
  .sl-menu__group form { margin: 0; }
  /* iOS install hint. Safari never fires beforeinstallprompt, so the install
     card below can never appear there and an iPhone visitor would otherwise
     get no install affordance at all. Revealed by the script only on iOS
     Safari outside standalone — hidden by default so no other platform is
     told to look for a Share menu it does not have. */
  .sl-menu__ios-install { display: none; }
  .sl-menu__ios-install.is-available { display: grid; }
  .sl-menu__ios-hint {
    margin: 0;
    padding: 11px 12px;
    border: 1px solid var(--sl-border);
    border-radius: var(--sl-radius-md);
    background: var(--sl-bg-card);
    color: var(--sl-ink-soft);
    font-size: 14.5px;
    line-height: 1.5;
  }
  .sl-menu__ios-hint strong { color: var(--sl-green); }
  .sl-menu__ios-share {
    display: inline-block;
    width: 15px;
    height: 15px;
    margin-bottom: -2px;
    vertical-align: baseline;
  }
  .sl-menu__link.is-current {
    padding-inline: 10px;
    background: var(--sl-orange-soft);
    color: var(--sl-green);
  }
  /* The mobile menu CTA is field ink on bone — the same treatment as the
     header action, for the same reason: a call to action is not a measured
     value, so it does not take the signal colour.

     This rule previously set only the ink and left the base green background
     underneath, putting var(--sl-night) on var(--sl-brand-green): 1.57:1 and
     effectively unreadable. It carries its own background now (16.75:1), and
     tests/test_premium_accessibility.py computes that ratio rather than
     trusting the declaration. */
  main { width: 100%; max-width: 720px; margin: 52px auto; padding: 0 24px; }
  .card {
    background: var(--sl-bg-card);
    border: 1px solid var(--sl-border);
    border-radius: var(--sl-radius-lg);
    padding: clamp(22px, 4vw, 32px);
    box-shadow: var(--sl-shadow-sm), var(--sl-shadow-md);
  }
  {# A label, not a measurement — the same reasoning as base.css. Amber is
     reserved for values the engine produced, and an eyebrow is chrome. #}
  .sl-eyebrow {
    margin: 0 0 12px;
    color: var(--sl-ink-soft);
    font-family: var(--sl-font-mono);
    font-size: .75rem;
    font-weight: 500;
    letter-spacing: .14em;
    text-transform: uppercase;
  }
  .sl-cluster { display: flex; align-items: center; flex-wrap: wrap; gap: 12px; }
  .sl-panel {
    background: var(--sl-bg-card);
    border: 1px solid var(--sl-border);
    border-radius: var(--sl-radius-lg);
    box-shadow: var(--sl-shadow-sm), var(--sl-shadow-md);
  }
  main button, a.button {
    min-height: 46px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-top: 20px;
    background: var(--sl-green-btn);
    color: white;
    border: 1.5px solid var(--sl-green-btn);
    padding: 11px 22px;
    font: inherit;
    font-weight: 500;
    line-height: 1.2;
    border-radius: var(--sl-radius-control);
    cursor: pointer;
    text-decoration: none;
    box-shadow: 0 10px 24px -16px rgba(9, 50, 29, .65);
    transition: background-color .18s ease, border-color .18s ease,
                color .18s ease, transform .18s ease, box-shadow .18s ease;
  }
  main button:hover, a.button:hover {
    background: var(--sl-green);
    color: white;
    transform: translateY(-1px);
    box-shadow: 0 14px 28px -16px rgba(9, 50, 29, .72);
  }
  main button:disabled { background: #bbb; border-color: #bbb; box-shadow: none; cursor: default; transform: none; }
  main button:active, a.button:active { transform: translateY(0); box-shadow: 0 6px 16px -12px rgba(9, 50, 29, .6); }
  a.button.secondary { background: transparent; color: var(--sl-green); border-color: var(--sl-border-strong); box-shadow: none; }
  a.button.secondary:hover { background: var(--sl-bg-card); border-color: var(--sl-green); color: var(--sl-green); }
  {# Zero-specificity control baseline: every page inherits one input/select
     look, and any page-level rule (even a bare element selector) still wins. #}
  :where(main input[type=text], main input[type=email], main input[type=password],
         main input[type=search], main input[type=number], main select, main textarea) {
    width: 100%;
    min-height: 48px;
    padding: 11px 13px;
    box-sizing: border-box;
    border: 1.5px solid var(--sl-control-border);
    border-radius: 10px;
    background: #fff;
    color: var(--sl-ink);
    font: inherit;
  }
  :where(main input:focus, main select:focus, main textarea:focus) {
    border-color: var(--sl-green-btn);
    outline: 3px solid rgba(26, 92, 56, .16);
    outline-offset: 1px;
  }
  :where(main input[type=checkbox], main input[type=radio]) { accent-color: var(--sl-green-btn); }
  .hint { color: var(--sl-ink-soft); font-size: 0.88rem; margin-top: 4px; }
  .bar { background: var(--sl-ink-soft); border-radius: 6px; height: 14px; margin: 14px 0 6px; }
  .bar > div { background: var(--accent); border-radius: 6px; height: 100%;
               transition: width 0.4s; min-width: 6px; }
  .bar-label { color: var(--sl-ink-soft); font-size: 0.9rem; }
  .error { color: var(--sl-danger); white-space: pre-wrap; }
  .sl-profile-reminder {
    padding: 10px var(--sl-pad-x);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    background: var(--sl-orange-soft);
    border-bottom: 1px solid var(--sl-focus-dark);
    color: var(--sl-ink-soft);
    font-size: .9rem;
  }
  .sl-profile-reminder a { font-weight: 500; white-space: nowrap; }
  .disclaimer { color: var(--sl-ink-muted); font-style: italic; font-size: 0.85rem; margin-top: 24px; }
  .sl-app-footer {
    margin-top: clamp(48px, 8vw, 96px);
    padding: clamp(40px, 6vw, 68px) var(--sl-pad-x) 28px;
    background: var(--sl-bg-card);
    color: var(--sl-ink-soft);
    font-size: .86rem;
  }
  .sl-app-footer__inner {
    width: 100%;
    max-width: var(--sl-content);
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(240px, 1.5fr) repeat(2, minmax(150px, .7fr));
    gap: clamp(28px, 6vw, 72px);
  }
  .sl-app-footer__logo {
    display: inline-flex;
    color: var(--sl-cream);
    font-size: 22px;
    font-weight: 600;
    letter-spacing: -.02em;
    text-decoration: none;
  }
  .sl-app-footer__logo:hover { color: #fff; }
  .sl-app-footer__brand p { max-width: 38ch; margin: 14px 0 0; line-height: 1.65; }
  .sl-app-footer__nav { display: grid; align-content: start; gap: 9px; }
  .sl-app-footer__nav strong {
    margin-bottom: 4px;
    color: var(--sl-cream);
    font-family: var(--sl-font-mono);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: .15em;
    text-transform: uppercase;
  }
  .sl-app-footer__nav a { color: var(--sl-ink-soft); text-decoration: none; }
  .sl-app-footer__nav a:hover { color: var(--sl-focus-dark); }
  .sl-app-footer__bottom {
    max-width: var(--sl-content);
    margin: 34px auto 0;
    padding-top: 22px;
    display: flex;
    justify-content: space-between;
    gap: 18px;
    border-top: 1px solid rgba(var(--sl-wash-rgb), .12);
    color: var(--sl-ink-muted);
  }
  .sl-app-footer__bottom p { margin: 0; }
  /* ---------------------------------------------------------------- app
     Bottom tab bar. This is what turns the installed PWA from "a website in
     a window" into something that navigates like an app: the four routes a
     golfer actually moves between, plus the existing menu dialog behind
     More. Hidden entirely at desktop widths, where the header nav leads. */
  .sl-tabbar { display: none; }
  .sl-tabbar__item {
    flex: 1 1 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 3px;
    /* 44px is the accessible minimum target; the bar is taller than that so
       the label never crowds the icon. */
    min-height: 52px;
    padding: 6px 2px 4px;
    border: 0;
    background: none;
    color: rgba(var(--sl-cream-rgb), .62);
    font: inherit;
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: -.005em;
    text-decoration: none;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }
  .sl-tabbar__icon { display: block; width: 23px; height: 23px; }
  .sl-tabbar__icon path,
  .sl-tabbar__icon circle,
  .sl-tabbar__icon line,
  .sl-tabbar__icon ellipse,
  .sl-tabbar__icon rect { vector-effect: non-scaling-stroke; }
  .sl-tabbar__label {
    max-width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .sl-tabbar__item:hover { color: rgba(var(--sl-cream-rgb), .86); }
  .sl-tabbar__item.is-current { color: var(--sl-cream); }
  /* The active tab is marked by a short rule above the icon, not by color
     alone — color is not a sufficient state signal on its own. */
  .sl-tabbar__item.is-current::before {
    content: "";
    position: absolute;
    top: 0;
    width: 26px;
    height: 3px;
    border-radius: 0 0 3px 3px;
    background: var(--sl-steel);
  }
  .sl-tabbar__item { position: relative; }
  .sl-tabbar__item:focus-visible { outline-offset: -4px; border-radius: 10px; }
  .sl-tabbar__badge {
    position: absolute;
    top: 7px;
    left: calc(50% + 7px);
    min-width: 7px;
    height: 7px;
    border-radius: 999px;
    background: var(--sl-steel);
  }

  /* Install affordance. Chromium fires beforeinstallprompt and the script
     below reveals this; iOS never fires it, so the card stays hidden there
     and the Share-sheet route is explained in the menu instead. */
  .sl-install {
    display: none;
    align-items: center;
    gap: 12px;
    max-width: var(--sl-content);
    margin: 18px auto 0;
    padding: 13px 16px;
    border: 1px solid var(--sl-border);
    border-radius: var(--sl-radius-lg);
    background: var(--sl-bg-card);
    box-shadow: var(--sl-shadow-sm);
  }
  .sl-install.is-available { display: flex; }
  .sl-install__text { flex: 1 1 auto; min-width: 0; font-size: var(--sl-text-sm); }
  .sl-install__text strong { display: block; color: var(--sl-green); }
  .sl-install__text span { color: var(--sl-ink-soft); }
  .sl-install__go,
  .sl-install__dismiss {
    flex: 0 0 auto;
    min-height: 40px;
    padding: 9px 15px;
    border-radius: var(--sl-radius-control);
    border: 1px solid transparent;
    font: inherit;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
  }
  .sl-install__go { background: var(--sl-green); color: var(--sl-green-ink); }
  .sl-install__go:hover { background: var(--sl-green-btn); }
  .sl-install__dismiss {
    background: transparent;
    border-color: var(--sl-border-strong);
    color: var(--sl-ink-soft);
  }
  .sl-install__dismiss:hover { border-color: var(--sl-control-border); color: var(--sl-ink); }

  @media (min-width: 1000px) and (max-width: 1279px) {
    .sl-header__desktop-nav { gap: 4px; }
    .sl-header__link,
    .sl-header__dropdown-trigger { padding-inline: 9px; }
    .sl-header__actions { gap: 6px; }
    .sl-header__member { max-width: 148px; }
    .sl-header__member > span:last-child { max-width: 64px; }
    .sl-header__account .sl-header__dropdown-trigger { max-width: 112px; }
    .sl-app-banner__detail { display: none; }
    .sl-app-banner__allowance { max-width: min(36vw, 200px); }
  }
  @media (max-width: 999px) {
    .sl-header { min-height: 64px; }
    .sl-header__inner,
    .sl-header__desktop-nav,
    .sl-header__account,
    .sl-header__app { display: none; }
    .sl-header__actions { margin-left: auto; gap: 8px; }
    .sl-header__toggle { display: flex; }
    .sl-header__logo { font-size: 18px; }
    .sl-header__logo-img { height: 28px; max-width: 175px; object-fit: contain; }
    .sl-header__cart { min-height: 44px; }
    main { margin-top: 32px; padding: 0 18px; }
    .sl-app-footer__inner { grid-template-columns: 1fr 1fr; }
    .sl-app-footer__brand { grid-column: 1 / -1; }
    .sl-app-banner__allowance { max-width: min(48vw, 220px); }

    /* The tab bar owns the bottom edge below the 1000px stop. */
    :root { --sl-tabbar-h: 56px; }
    .sl-tabbar {
      position: fixed;
      z-index: 44;
      inset: auto 0 0 0;
      display: flex;
      align-items: stretch;
      padding-left: var(--sl-safe-left);
      padding-right: var(--sl-safe-right);
      /* The home indicator sits in this padding, so the row of targets stays
         above it instead of fighting the system gesture. */
      padding-bottom: var(--sl-safe-bottom);
      background: rgba(var(--sl-night-rgb), .97);
      border-top: 1px solid rgba(var(--sl-wash-rgb), .13);
      -webkit-backdrop-filter: saturate(150%) blur(12px);
      backdrop-filter: saturate(150%) blur(12px);
    }
    /* Reserve the bar's height plus the inset so the last card, the footer,
       and any sticky CTA all clear it. */
    .sl-app-footer {
      padding-bottom: calc(38px + var(--sl-tabbar-h) + var(--sl-safe-bottom));
    }
    .sl-header { padding-top: var(--sl-safe-top); }
    .sl-app-banner { padding-left: max(14px, var(--sl-safe-left)); padding-right: max(14px, var(--sl-safe-right)); }
    .sl-install { margin-inline: 18px; }
  }
  /* An installed app has no browser chrome to fall back on, so the banner —
     which only restates plan status — gives its room back to the content. */
  @media (display-mode: standalone), (display-mode: minimal-ui) {
    .sl-app-banner { display: none; }
    .sl-install { display: none !important; }
  }
  @media (max-width: 560px) {
    {# The compact phone header. This lived on the dark-chrome selector and
       was nearly lost with it — the treatment was cosmetic, the 8px it takes
       back off a 72px bar at the top of every phone screen is not. #}
    .sl-header, .sl-header__inner { min-height: 64px; }
    .sl-app-banner { padding-inline: 14px; }
    .sl-app-banner__inner {
      min-width: 0;
      flex-wrap: wrap;
      justify-content: center;
      gap: 8px;
    }
    .sl-app-banner__detail,
    .sl-app-banner__allowance { display: none; }
  }
  @media (max-width: 390px) {
    .sl-header { padding-inline: 12px; }
    .sl-header__logo-img { height: 24px; max-width: 142px; }
    .sl-header__cart { padding: 5px 10px; }
    .sl-profile-reminder { align-items: flex-start; flex-direction: column; gap: 3px; }
    .sl-app-footer__inner { grid-template-columns: 1fr; }
    .sl-app-footer__brand { grid-column: auto; }
    .sl-app-footer__bottom { flex-direction: column; }
  }
  body.sl-reduced-motion *,
  body.sl-reduced-motion *::before,
  body.sl-reduced-motion *::after {
    animation-duration: .01ms !important;
    animation-iteration-count: 1 !important;
    scroll-behavior: auto !important;
    transition-duration: .01ms !important;
  }
  body.sl-reduced-motion .sl-menu[open] .sl-menu__panel { animation: none; }
  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
    *, *::before, *::after {
      animation-duration: .01ms !important;
      animation-iteration-count: 1 !important;
      scroll-behavior: auto !important;
      transition-duration: .01ms !important;
    }
    .sl-menu[open] .sl-menu__panel { animation: none; }
  }
  {% block style %}{% endblock %}
</style>
</head>
<body{% if header_profile and header_profile.reduced_motion %} class="sl-reduced-motion"{% endif %}>
{% set member_name = header_profile.display_name if header_profile and header_profile.display_name else '' %}
{% set member_chip_label = 'Game plan' %}
{% if member_name %}
  {% set member_chip_label = member_name[:16] ~ ('…' if member_name|length > 16 else '') %}
{% endif %}
{% set free_limit = free_per_month|default(1) %}
<a class="sl-skip" href="#MainContent">Skip to content</a>
<aside class="sl-app-banner{% if user and user.is_pro %} sl-app-banner--pro{% endif %}" aria-label="Membership status">
  <div class="sl-app-banner__inner">
    <span class="sl-app-banner__dot" aria-hidden="true"></span>
    {% if user and user.is_pro %}
      <span class="sl-app-banner__status">Pro member</span>
      <span class="sl-app-banner__detail">{{ "Welcome back, " ~ member_name ~ "." if member_name else "Your game plan is ready." }}</span>
      <a href="/">Let&rsquo;s work on your swing &rarr;</a>
    {% elif user %}
      <span class="sl-app-banner__status">Free plan</span>
