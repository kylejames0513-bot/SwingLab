<script>
  (function () {
    var header = document.querySelector('[data-sl-header]');
    if (!header) return;

    var menu = document.getElementById(header.getAttribute('data-menu-id'));
    /* Both the header hamburger and the bottom tab bar's More button open the
       same dialog, so the openers are collected document-wide. Focus returns
       to whichever one was actually used. */
    var openButtons = document.querySelectorAll('[data-menu-open]');
    var openButton = openButtons[0];
    var lastOpener = null;
    var closeButton = menu && menu.querySelector('[data-menu-close]');
    var menuLinks = menu ? menu.querySelectorAll('[data-menu-link]') : [];
    var desktopMenus = header.querySelectorAll('[data-header-dropdown]');
    var restoreMenuFocus = false;

    function setOpenerState(expanded) {
      for (var i = 0; i < openButtons.length; i++) {
        openButtons[i].setAttribute('aria-expanded', expanded ? 'true' : 'false');
      }
    }

    function finishMenuClose() {
      setOpenerState(false);
      document.documentElement.classList.remove('sl-menu-open');
      if (restoreMenuFocus && lastOpener) lastOpener.focus();
      restoreMenuFocus = false;
    }

    function closeMenu(restoreFocus) {
      if (!menu || !menu.hasAttribute('open')) return;
      restoreMenuFocus = restoreFocus;
      if (typeof menu.close === 'function') {
        menu.close();
      } else {
        menu.removeAttribute('open');
        finishMenuClose();
      }
    }

    function openMenu(event) {
      if (!menu || menu.hasAttribute('open')) return;
      if (event && event.currentTarget) lastOpener = event.currentTarget;
      if (typeof menu.showModal === 'function') {
        menu.showModal();
      } else {
        menu.setAttribute('open', '');
      }
      setOpenerState(true);
      document.documentElement.classList.add('sl-menu-open');
      if (closeButton) closeButton.focus();
    }

    if (menu && openButton) {
      for (var o = 0; o < openButtons.length; o++) {
        openButtons[o].addEventListener('click', openMenu);
      }
      if (closeButton) closeButton.addEventListener('click', function () { closeMenu(true); });
      menu.addEventListener('cancel', function (event) {
        event.preventDefault();
        closeMenu(true);
      });
      menu.addEventListener('close', finishMenuClose);
      menu.addEventListener('click', function (event) {
        if (event.target === menu) closeMenu(true);
      });
      for (var i = 0; i < menuLinks.length; i++) {
        menuLinks[i].addEventListener('click', function () { closeMenu(false); });
      }
      var desktopQuery = window.matchMedia('(min-width: 981px)');
      var closeOnBreakpointChange = function (event) {
        for (var i = 0; i < desktopMenus.length; i++) {
          desktopMenus[i].removeAttribute('open');
        }
        if (event.matches) closeMenu(false);
      };
      if (desktopQuery.addEventListener) desktopQuery.addEventListener('change', closeOnBreakpointChange);
    }

    for (var j = 0; j < desktopMenus.length; j++) {
      desktopMenus[j].addEventListener('toggle', function (event) {
        if (!event.currentTarget.open) return;
        for (var k = 0; k < desktopMenus.length; k++) {
          if (desktopMenus[k] !== event.currentTarget) desktopMenus[k].removeAttribute('open');
        }
      });
      desktopMenus[j].addEventListener('focusout', function (event) {
        if (!event.currentTarget.contains(event.relatedTarget)) {
          event.currentTarget.removeAttribute('open');
        }
      });
    }
    document.addEventListener('click', function (event) {
      for (var i = 0; i < desktopMenus.length; i++) {
        if (!desktopMenus[i].contains(event.target)) desktopMenus[i].removeAttribute('open');
      }
    });
    document.addEventListener('keydown', function (event) {
      if (event.key !== 'Escape') return;
      for (var i = 0; i < desktopMenus.length; i++) {
        if (!desktopMenus[i].hasAttribute('open')) continue;
        desktopMenus[i].removeAttribute('open');
        var summary = desktopMenus[i].querySelector('summary');
        if (summary) summary.focus();
      }
    });
  })();
</script>
<script>
  if ("serviceWorker" in navigator) {
    window.addEventListener("load", function () {
      navigator.serviceWorker.register("/service-worker.js").catch(function () {
        // Offline support is progressive enhancement; a failed registration
        // must never affect account, report, or upload behavior.
      });
    });
  }

  // Install affordance. Chromium hands us the deferred prompt; we surface our
  // own card rather than letting the mini-infobar interrupt an upload. Safari
  // never fires this event, so iOS simply never sees the card — the Share
  // sheet is the install route there and needs no scripting.
  (function () {
    var card = document.getElementById("sl-install");
    if (!card) return;
    var DISMISSED = "ci-install-dismissed";
    var deferred = null;

    function stored(key) {
      // Private-mode Safari throws on storage access; a missing preference is
      // not worth breaking the page over.
      try { return window.localStorage.getItem(key); } catch (e) { return null; }
    }
    function remember(key) {
      try { window.localStorage.setItem(key, "1"); } catch (e) { /* ignore */ }
    }
    function hide() {
      card.classList.remove("is-available");
      card.hidden = true;
    }

    window.addEventListener("beforeinstallprompt", function (event) {
      event.preventDefault();
      if (stored(DISMISSED)) return;
      deferred = event;
      card.hidden = false;
      card.classList.add("is-available");
    });

    card.querySelector("[data-install-accept]").addEventListener("click", function () {
      if (!deferred) return hide();
      var prompt = deferred;
      deferred = null;
      hide();
      prompt.prompt();
    });

    card.querySelector("[data-install-dismiss]").addEventListener("click", function () {
      deferred = null;
      remember(DISMISSED);
      hide();
    });

    window.addEventListener("appinstalled", function () {
      deferred = null;
      remember(DISMISSED);
      hide();
    });
  })();
</script>
{% block script %}{% endblock %}
</body>
</html>
