{% extends "web_layout.html.j2" %}
{% block title %}{{ brand.name }} — Drill library{% endblock %}
{% block style %}
  .lead { text-align: center; margin-bottom: 24px; }
  .lead h2 { font-size: 1.8rem; margin: 0 0 8px; }
  .lead p { color: #555; font-size: 1.02rem; max-width: 560px; margin: 0 auto; }
  .path { background: #e5f3ea; border-left: 4px solid var(--primary);
          padding: 16px 20px; border-radius: 4px; margin-bottom: 28px; }
  .path h3 { margin: 0 0 6px; }
  .path ol { margin: 10px 0 0; padding-left: 20px; color: #333; }
  .path li { margin: 8px 0; }
  .path .why { color: #555; font-size: 0.9rem; }
  .family { margin-bottom: 30px; }
  .family > h3 { border-bottom: 2px solid var(--primary);
                 padding-bottom: 6px; }
  .drill { background: white; border: 1px solid #e0e0e0; border-radius: 8px;
           padding: 16px 20px; margin: 14px 0; }
  .drill h4 { margin: 0 0 4px; }
  .aim { color: #555; margin: 0 0 8px; }
  .drill ol { padding-left: 20px; color: #444; }
  .drill li { margin: 6px 0; }
  .drill-media { display: flex; gap: 16px; flex-wrap: wrap;
                 align-items: flex-start; margin: 10px 0; }
  .drill-media figure { margin: 0; }
  .drill-media figcaption { color: #777; font-size: 0.8rem; }
  .drill-media details > summary { cursor: pointer; color: var(--primary);
                                   font-size: 0.9rem; }
  .dose { color: #333; font-size: 0.92rem; }
  .gear-note { color: #666; font-size: 0.85rem; }
  .gear-link { text-align: center; margin: 24px 0; }
  .cta { text-align: center; margin: 28px 0; }
{% endblock %}
{% block main %}
  <div class="lead">
    <h2>The drill library</h2>
    <p>Every drill our practice plans prescribe, free to read — each with a
      setup diagram, a step-by-step protocol, a dosage, and a measurable
      pass mark in the same numbers your report prints. Film a swing and
      your report picks the drills your numbers actually call for.</p>
  </div>

  <div class="path" id="beginner-path">
    <h3>New to golf? The four-week Beginner Path</h3>
    <p class="why">You don't need all of this at once. One family a week,
      in this order, builds the swing from the ground up — and a re-film at
      the end shows the change in numbers, not vibes.</p>
    <ol>
      <li><strong>Week 1 — <a href="#family-tempo">Tempo</a>.</strong>
        Rhythm first: every other fix is easier inside a repeating beat.</li>
      <li><strong>Week 2 — <a href="#family-balance">Finish balance</a> and
        <a href="#family-sway">head sway</a>.</strong> Learn to stay
        centered and end in balance — the base the swing turns on.</li>
      <li><strong>Week 3 — <a href="#family-hip-slide">Hip motion</a>.</strong>
        Turn the trail hip instead of sliding it, so the downswing has
        something to push from.</li>
      <li><strong>Week 4 — <a href="#family-consistency">Consistency</a>,
        then re-film.</strong> Groove one count for every swing, film a
        session, and let the report show what moved.</li>
    </ol>
    <p class="why">Each drill below says exactly what number tells you it
      worked{% if user or not require_account %} — upload a clip to get
      yours{% else %} — <a href="/signup">a free account</a> gets
      {{ free_per_month }} full analys{% if free_per_month == 1 %}is{% else %}es{% endif %}
      every month{% endif %}.</p>
  </div>

  {% for fam in families %}
  <div class="family" id="family-{{ fam.key }}">
    <h3>{{ fam.title }}</h3>
    {% for d in fam.drills %}
    <div class="drill" id="drill-{{ d.id }}">
      <h4>{{ d.name }}</h4>
      <p class="aim">{{ d.aim }}</p>
      <ol>
        {% for step in d.protocol %}<li>{{ step }}</li>{% endfor %}
      </ol>
      {% if d.id in drill_media %}
      <div class="drill-media">
        <figure>{{ drill_media[d.id].diagram|safe }}<figcaption>Setup</figcaption></figure>
        <details>
          <summary>Show the motion</summary>
          <figure>{{ drill_media[d.id].animation|safe }}<figcaption>Loops
          through the drill's key positions; holds the setup pose when your
          device asks for reduced motion.</figcaption></figure>
        </details>
      </div>
      {% endif %}
      <p class="dose"><strong>Dosage:</strong> {{ d.dosage }}<br>
        <strong>Pass mark</strong> — {{ d.success_metric }}</p>
      {% if d.gear_note %}<p class="gear-note">{{ d.gear_note }}</p>{% endif %}
    </div>
    {% endfor %}
  </div>
  {% endfor %}

  {% if gear_url %}
  <p class="gear-link"><a href="{{ gear_url }}">Matched training aids</a> —
    the gear these drills are built around.</p>
  {% endif %}

  <div class="cta">
    <a class="button" href="/">Film a swing — see which drills are yours</a>
    <p class="hint">A report reads your numbers and picks from this library
      for you, with a re-film target per drill.</p>
  </div>

  <p class="disclaimer">{{ brand.disclaimer }}</p>
{% endblock %}
