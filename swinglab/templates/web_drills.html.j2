{% extends "web_layout.html.j2" %}
{% block title %}{{ brand.name }} — Drill library{% endblock %}
{% block style %}
  {# ------------------------------------------------------------------ page
     The drill library is a reference instrument, not a landing page: ten
     families, twenty protocols, each with a dosage and a pass mark the engine
     re-checks on the next clip. It is read by scanning, so the page is ruled
     panels and mono labels rather than a stack of soft cards.

     NOTE ON SPACING TOKENS: --sl-card-inset / --sl-dense-inset exist only in
     storefront-theme/assets/base.css, NOT in this app's :root. Using them here
     would resolve to nothing and silently drop the padding, so every inset on
     this page comes off the --sl-space-* rungs the shell actually defines. #}
  main {
    max-width: var(--sl-content);
    margin-block: var(--sl-space-7) var(--sl-space-8);
    {# The shell's 24/18px gutter is sized for a 720px prose column. This page
       runs a grid to the edge, so it takes the instrument gutter — and the
       safe-area inset with it, because a landscape notch otherwise clips the
       first column of the drill grid. #}
    padding-inline:
      max(var(--sl-pad-x), var(--sl-safe-left))
      max(var(--sl-pad-x), var(--sl-safe-right));
  }

  {# ---- masthead ---- #}
  .lead {
    max-width: none;
    margin: 0 0 var(--sl-space-7);
    padding-bottom: var(--sl-space-5);
    border-bottom: 1px solid var(--sl-border-strong);
    text-align: left;
  }
  .lead h1 {
    max-width: 15ch;
    margin: 0;
    color: var(--sl-green);
    font-family: var(--sl-font-display);
    font-size: var(--sl-heading-display);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 0.98;
    text-transform: uppercase;
    text-wrap: balance;
  }
  {# Scoped to its own class rather than `.lead p`, which would outrank the
     shell's .sl-eyebrow and repaint the eyebrow as body copy. #}
  .lead__lede {
    max-width: 58ch;
    margin: var(--sl-space-4) 0 0;
    color: var(--sl-ink-soft);
    font-size: var(--sl-text-lg);
    line-height: 1.55;
    text-wrap: pretty;
  }

  {# ---- the beginner path ---- #}
  .path {
    margin: 0 0 var(--sl-space-7);
    border: 1px solid var(--sl-border);
    border-radius: var(--sl-radius-lg);
    background: var(--sl-night);
    box-shadow: var(--sl-shadow-sm), var(--sl-shadow-md);
    {# The week grid is full-bleed inside the panel; without this its square
       cells punch through the panel's own tight corners. #}
    overflow: hidden;
  }
  .path__head { padding: var(--sl-space-5); }
  .path h2 {
    margin: 0;
    color: var(--sl-green);
    font-family: var(--sl-font-display);
    font-size: var(--sl-text-2xl);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.06;
    text-transform: uppercase;
  }
  .path .why {
    max-width: 68ch;
    margin: var(--sl-space-3) 0 0;
    color: var(--sl-ink-soft);
    font-size: var(--sl-text-sm);
    line-height: 1.55;
  }
  {# max-width: none, because .why's prose measure would otherwise shrink this
     paragraph's BOX and take its top rule with it — a hairline that stops
     two-thirds of the way across the panel reads as a rendering fault. The
     note is one line here, so the panel width is a fine measure for it. #}
  .path__foot {
    max-width: none;
    padding: var(--sl-space-4) var(--sl-space-5) var(--sl-space-5);
    border-top: 1px solid var(--sl-border);
  }
  {# A 1px-gap bordered grid: the container paints the rules, the cells paint
     the surface. Four weeks divide evenly at 1, 2 and 4 columns, so the row
     never ends on a bare strip of border colour. #}
  .path__weeks {
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1px;
    list-style: none;
    background: var(--sl-border);
    border-block: 1px solid var(--sl-border);
  }
  .path__weeks > li {
    margin: 0;
    padding: var(--sl-space-4) var(--sl-space-5) var(--sl-space-5);
    background: var(--sl-bg-card);
    color: var(--sl-ink-soft);
    font-size: var(--sl-text-sm);
    line-height: 1.55;
  }
  {# The ordinal already lives in the copy ("Week 1 — Tempo"), so the cell gets
     a tick instead of a second, competing number. Bone, not amber: an index
     is not something the engine measured. #}
  .path__weeks > li strong {
    position: relative;
    display: block;
    margin-bottom: var(--sl-space-2);
    padding-top: var(--sl-space-4);
    color: var(--sl-ink);
    font-size: var(--sl-text-base);
    font-weight: 500;
  }
  .path__weeks > li strong::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 18px;
    height: 2px;
    background: var(--sl-green-btn);
  }

  {# ---- families ---- #}
  .family { margin: 0 0 var(--sl-space-8); }
  .family__head {
    margin: 0 0 var(--sl-space-5);
    display: flex;
    align-items: center;
    gap: var(--sl-space-4);
  }
  {# --primary is the raw brand green the shell interpolates straight from
     config (#1a5c38). It lands at 1.3:1 on the field, so the old 2px rule
     under every family title was invisible the moment the design inverted.
     A hairline in a real border token is the instrument answer anyway. #}
  .family__rule {
    flex: 1 1 auto;
    height: 1px;
    background: var(--sl-border-strong);
  }
  .family > .family__head h2 {
    margin: 0;
    color: var(--sl-green);
    font-family: var(--sl-font-display);
    font-size: var(--sl-text-xl);
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.1;
    text-transform: uppercase;
    text-wrap: balance;
  }

  {# ---- drill panels ---- #}
  .drill-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--sl-space-4);
  }
  .drill {
    display: flex;
    flex-direction: column;
    gap: var(--sl-space-4);
    margin: 0;
    padding: var(--sl-space-5);
    background: var(--sl-bg-card);
    border: 1px solid var(--sl-border);
    border-radius: var(--sl-radius-lg);
    box-shadow: var(--sl-shadow-sm);
  }
  {# Sans, not the display face the shell gives every h3. Twenty drill names
     set in expanded uppercase would weigh exactly as much as the page title
     and flatten the hierarchy the reader scans by. #}
  .drill h3 {
    margin: 0;
    color: var(--sl-green);
    font-family: var(--sl-font-sans);
    font-size: var(--sl-text-lg);
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.2;
  }
  .aim {
    margin: calc(var(--sl-space-2) * -1) 0 0;
    color: var(--sl-ink-soft);
    font-size: var(--sl-text-sm);
    line-height: 1.55;
  }
  {# decimal-leading-zero markers, styled through ::marker rather than replaced
     by a counter on a list-style:none list — the list keeps its semantics in
     Safari, and no ::marker `content` is set, which is the one part of the
     pseudo-element with uneven support. #}
  .drill__steps {
    margin: 0;
    {# Normal block flow, not a grid: an outside marker on a grid item is the
       kind of thing that renders in three browsers and vanishes in the
       fourth, and the step numbers are the whole point of a protocol. #}
    padding-left: var(--sl-space-6);
    list-style: decimal-leading-zero;
    color: var(--sl-ink-soft);
    font-size: var(--sl-text-sm);
    line-height: 1.55;
  }
  .drill__steps > li { margin: 0; padding-left: var(--sl-space-1); }
  .drill__steps > li + li { margin-top: var(--sl-space-2); }
  .drill__steps > li::marker {
    color: var(--sl-ink-muted);
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-xs);
    font-weight: 500;
  }

  {# ---- setup plate and motion loop ---- #}
  .drill-media {
    display: flex;
    gap: var(--sl-space-4);
    flex-wrap: wrap;
    align-items: flex-start;
    margin: 0;
  }
  .drill-media figure { margin: 0; }
  {# THE PLATE IS A FIELD TILE, and this is the one place brand.primary_color
     forces the ground rather than the other way round.

     The server bakes that colour into the SVG (swinglab/diagrams.py), so no
     token on this page can re-tint the strokes — the plate has to suit the
     colour. Under INSTRUMENT the colour was a dark green, 1.3:1 on a dark
     field, so the plate was made paper. Industry inverts both: the tint is
     field-side (it also draws overlays onto phone video, which is dark), and
     on paper it would be 1.78:1 — the same disappearance, mirrored.

     A field tile is also the right answer on its own terms. A drawn figure is
     evidence, and every other piece of evidence in this system — clip
     thumbnails, the hero trace, the report's theater — is the green ground
     under the hatch. The drill library now matches them. #}
  .drill-media .drill-svg {
    display: block;
    width: 168px;
    height: auto;
    background-color: var(--sl-field);
    background-image: var(--sl-hatch);
    border: 1px solid var(--sl-border-strong);
    border-radius: var(--sl-radius-sm);
  }
  {# Prop and count labels ship at the generator's grey, which is 2.2:1 on the
     plate. Overridden here, and the value follows the plate: it is a field
     tile now, so the label reverses with it. #}
  .drill-svg text { fill: var(--sl-field-soft); }
  {# The plate caption is a LABEL, so it is mono and tracks with the plate. #}
  .drill-media figcaption {
    max-width: 168px;
    margin-top: var(--sl-space-2);
    color: var(--sl-ink-muted);
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-xs);
    font-weight: 500;
    letter-spacing: 0.06em;
    line-height: 1.45;
    text-transform: uppercase;
  }
  {# The disclosure's caption is a SENTENCE, not a label. Left on the label
     rule it set seven lines of tracked mono in a 168px column, which is how a
     reduced-motion disclosure ends up unreadable. #}
  .drill-media details figcaption {
    max-width: 30ch;
    font-family: var(--sl-font-sans);
    font-weight: 400;
    letter-spacing: normal;
    line-height: 1.5;
    text-transform: none;
  }
  .drill-media details { min-width: 0; }
  {# A real control, so a real control edge (--sl-control-border, 4.29:1) and a
     44px target — the old summary was --primary text on the field, both
     invisible and untappable. #}
  .drill-media details > summary {
    min-height: 44px;
    padding: 11px var(--sl-space-4);
    display: inline-flex;
    align-items: center;
    gap: var(--sl-space-2);
    border: 1px solid var(--sl-control-border);
    border-radius: var(--sl-radius-control);
    background: transparent;
    color: var(--sl-ink);
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-xs);
    font-weight: 500;
    letter-spacing: var(--sl-eyebrow-track);
    line-height: 1;
    text-transform: uppercase;
    list-style: none;
    cursor: pointer;
    transition: border-color .18s ease, background-color .18s ease;
  }
  .drill-media details > summary::-webkit-details-marker { display: none; }
  .drill-media details > summary:hover {
    border-color: var(--sl-green-btn);
    background: rgba(var(--sl-wash-rgb), .06);
  }
  .drill-media details > summary::after {
    content: "";
    width: 6px;
    height: 6px;
    border-right: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    transform: translateY(-2px) rotate(45deg);
    transition: transform .18s ease;
  }
  .drill-media details[open] > summary::after { transform: translateY(1px) rotate(225deg); }
  .drill-media details[open] > summary { margin-bottom: var(--sl-space-3); }

  {# ---- the readout: dosage and pass mark ---- #}
  .drill__spec {
    {# Pinned to the foot of the panel so specs line up across a row of cards
       whose protocols differ in length. #}
    margin: auto 0 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1px;
    background: var(--sl-border-strong);
    border: 1px solid var(--sl-border-strong);
    border-radius: var(--sl-radius-sm);
    overflow: hidden;
  }
  .drill__spec > div {
    padding: var(--sl-space-3) var(--sl-space-4);
    background: var(--sl-night);
  }
  .drill__spec dt {
    margin: 0 0 var(--sl-space-1);
    color: var(--sl-ink-muted);
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-xs);
    font-weight: 500;
    letter-spacing: var(--sl-eyebrow-track);
    line-height: 1;
    text-transform: uppercase;
  }
  .drill__spec dd {
    margin: 0;
    color: var(--sl-ink);
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-sm);
    font-weight: 500;
    line-height: 1.45;
  }
  {# THE amber on this page. The pass mark is the number the engine measures on
     the next clip — the one thing here that is a measured value rather than
     instruction. --sl-orange-text, not --sl-orange, because this is small
     text (10.6:1 on the well). #}
  .drill__spec dd.is-pass { color: var(--sl-orange-text); }
  .gear-note {
    margin: 0;
    color: var(--sl-ink-muted);
    font-size: var(--sl-text-xs);
    line-height: 1.5;
  }

  {# ---- closing ---- #}
  .gear-link {
    margin: var(--sl-space-6) 0 0;
    padding: var(--sl-space-4) var(--sl-space-5);
    border: 1px solid var(--sl-border);
    border-radius: var(--sl-radius-md);
    background: var(--sl-bg-card);
    color: var(--sl-ink-soft);
    font-size: var(--sl-text-sm);
    line-height: 1.55;
    text-align: left;
  }
  .cta {
    margin: var(--sl-space-7) 0 0;
    padding: var(--sl-space-6) var(--sl-space-5);
    border: 1px solid var(--sl-border);
    border-radius: var(--sl-radius-lg);
    background: var(--sl-night);
    box-shadow: var(--sl-shadow-sm), var(--sl-shadow-md);
    text-align: center;
  }
  {# The shell paints a.button bone and then sets `color: white` on top of it —
     1.06:1, which is a primary action nobody can read after the inversion.
     The shell is not this file's to edit, so the page states the ink the bone
     surface actually needs. Bone with dark ink, never amber: a call to action
     is not a measured value. Hover goes to the trace colour, matching the
     storefront hero's primary. #}
  .cta a.button {
    margin-top: 0;
    background: var(--sl-green-btn);
    border-color: var(--sl-green-btn);
    color: var(--sl-green-ink);
    box-shadow: none;
  }
  .cta a.button:hover {
    background: var(--sl-ink-hi);
    border-color: var(--sl-ink-hi);
    color: var(--sl-green-ink);
    box-shadow: none;
  }
  .cta a.button:active { box-shadow: none; }
  .cta .hint {
    max-width: 52ch;
    margin: var(--sl-space-4) auto 0;
    color: var(--sl-ink-soft);
    font-size: var(--sl-text-sm);
    line-height: 1.55;
  }
  {# Full width for the same reason as .path__foot: a prose measure here would
     shorten the closing rule, not the sentence. #}
  .disclaimer {
    max-width: none;
    margin: var(--sl-space-6) 0 0;
    padding-top: var(--sl-space-4);
    border-top: 1px solid var(--sl-border);
    color: var(--sl-ink-muted);
    font-size: var(--sl-text-xs);
    line-height: 1.5;
  }

  @media (min-width: 560px) {
    .path__weeks { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (min-width: 1000px) {
    {# Masthead as a two-part instrument head: the title left, the lede in its
       own column, both sitting on the same baseline rule. #}
    .lead {
      display: grid;
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      gap: var(--sl-space-7);
      align-items: end;
    }
    .lead .sl-eyebrow { grid-column: 1 / -1; }
    .lead__lede { margin-top: 0; }
    .path__weeks { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    .drill-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (min-width: 1280px) {
    .drill-grid { gap: var(--sl-space-5); }
    .drill { padding: var(--sl-space-6); }
  }
  {# The shell already disables transitions globally under reduced motion, but
     this page states it for its own controls too: the disclosure chevron is
     the only thing here that moves, and it must not. #}
  @media (prefers-reduced-motion: reduce) {
    .drill-media details > summary,
    .drill-media details > summary::after,
    .cta a.button { transition: none; }
  }
{% endblock %}
{% block main %}
  <header class="lead">
    <p class="sl-eyebrow">Practice with a pass mark</p>
    <h1>The drill library</h1>
    <p class="lead__lede">Every drill our practice plans prescribe, free to read — each with a
      setup diagram, a step-by-step protocol, a dosage, and a measurable
      pass mark in the same numbers your report prints. Film a swing and
      your report picks the drills your numbers actually call for.</p>
  </header>

  <section class="path" id="beginner-path">
    <div class="path__head">
      <h2>New to golf? The four-week Beginner Path</h2>
      <p class="why">You don't need all of this at once. One family a week,
        in this order, builds the swing from the ground up — and a re-film at
        the end shows the change in numbers, not vibes.</p>
    </div>
    {# role="list" restores the list semantics Safari drops from a
       list-style:none list; the ordinal is carried by the copy in each cell. #}
    <ol class="path__weeks" role="list">
      <li><strong>Week 1 — <a href="#family-tempo">Tempo</a>.</strong>
        Rhythm first: every other fix is easier inside a repeating beat.</li>
      <li><strong>Week 2 — <a href="#family-balance">Finish balance</a> and
        <a href="#family-sway">head sway</a>.</strong> Learn to stay
        centered and end in balance — the base the swing turns on.</li>
      <li><strong>Week 3 — <a href="#family-hip-slide">Hip motion</a>.</strong>
        Turn the trail hip instead of sliding it, so the downswing has
        something to push from.</li>
      <li><strong>Week 4 — <a href="#family-consistency">Consistency</a>,
        then re-film.</strong> Groove one count for every swing, film a
        session, and let the report show what moved.</li>
    </ol>
    <p class="why path__foot">Each drill below says exactly what number tells you it
      worked{% if user or not require_account %} — upload a clip to get
      yours{% else %} — <a href="/signup">a free account</a> gets
      {% if free_per_month <= 0 %}unlimited full analyses{% else %}{{ free_per_month }} full analys{% if free_per_month == 1 %}is{% else %}es{% endif %}
      every month{% endif %}{% endif %}.</p>
  </section>

  {% for fam in families %}
  <section class="family" id="family-{{ fam.key }}">
    <div class="family__head">
      <h2>{{ fam.title }}</h2>
      <span class="family__rule" aria-hidden="true"></span>
    </div>
    <div class="drill-grid">
    {% for d in fam.drills %}
      <article class="drill" id="drill-{{ d.id }}">
        <h3>{{ d.name }}</h3>
        <p class="aim">{{ d.aim }}</p>
        <ol class="drill__steps">
          {% for step in d.protocol %}<li>{{ step }}</li>{% endfor %}
        </ol>
        {% if d.id in drill_media %}
        <div class="drill-media">
          <figure>{{ drill_media[d.id].diagram|safe }}<figcaption>Setup</figcaption></figure>
          <details>
            <summary>Show the motion</summary>
            <figure>{{ drill_media[d.id].animation|safe }}<figcaption>Loops
            through the drill's key positions; holds the setup pose when your
            device asks for reduced motion.</figcaption></figure>
          </details>
        </div>
        {% endif %}
        {# Mono label over mono value, the pass mark in amber: the same readout
           shape the report prints, so the library and the report read as one
           instrument. #}
        <dl class="drill__spec">
          <div>
            <dt>Dosage</dt>
            <dd>{{ d.dosage }}</dd>
          </div>
          <div>
            <dt>Pass mark</dt>
            <dd class="is-pass">{{ d.success_metric }}</dd>
          </div>
        </dl>
        {% if d.gear_note %}<p class="gear-note">{{ d.gear_note }}</p>{% endif %}
      </article>
    {% endfor %}
    </div>
  </section>
  {% endfor %}

  {% if gear_url %}
  <p class="gear-link"><a href="{{ gear_url }}">Matched training aids</a> —
    the gear these drills are built around.</p>
  {% endif %}

  <div class="cta">
    <a class="button" href="/">Film a swing — see which drills are yours</a>
    <p class="hint">A report reads your numbers and picks from this library
      for you, with a re-film target per drill.</p>
  </div>

  <p class="disclaimer">{{ brand.disclaimer }}</p>
{% endblock %}
