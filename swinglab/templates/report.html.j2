{% macro num(v, fmt="%.2f", flagged=false) -%}
  {%- if v != v %}<td>—</td>
  {%- else %}<td{% if flagged %} class="flag"{% endif %}>{{ fmt|format(v) }}</td>{% endif -%}
{%- endmacro -%}
{% macro mhead(key, label) -%}
  <th scope="col">{% if explainers and key in explainers -%}
    <details class="mx"><summary>{{ label }}</summary>
      <div class="mx-body"><p>{{ explainers[key].text }}</p>
        {% if explainers[key].how %}<p class="mx-how">How it's measured:
          {{ explainers[key].how }}</p>{% endif %}
        <p class="mx-unit">{{ explainers[key].unit_gloss }}</p></div>
    </details>
  {%- else %}{{ label }}{% endif %}</th>
{%- endmacro -%}
{% macro issue_card(c, extra_class="") -%}
  <div class="card sev-{{ c.severity }}{% if extra_class %} {{ extra_class }}{% endif %}" role="article">
    <div class="card-head"><h3>{{ c.display_name }}</h3>
      <span class="sev">{{ "Main priority" if c.severity == "major" else "Watch" }}</span></div>
    <p class="card-val">{{ c.session_label }}:
      <strong>{{ c.session_text }}</strong>
      <span class="bench">({{ c.benchmark_text }})</span></p>
    {{ c.sparkline|safe }}
    <p class="why">{{ c.why }}</p>
    <p class="fixline"><strong>Fix:</strong> {{ c.fix }}
      {% if c.drill_ids %}<span class="meta">Drills:
        {% for did in c.drill_ids %}<a href="#drill-{{ did }}">{{ c.drill_names[loop.index0] }}</a>{% if not loop.last %}, {% endif %}{% endfor %}</span>{% endif %}</p>
  </div>
{%- endmacro -%}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="caddieinsight-report-format" content="{{ report_format_version }}">
<meta name="caddieinsight-report-presentation" content="{{ report_presentation_version }}">
<meta name="caddieinsight-report-outcome" content="{{ report_outcome }}">
<meta name="caddieinsight-coaching-priority-rule" content="{{ priority_rule_version }}">
<title>{{ brand.name }} — Swing Report</title>
<style>
  :root {
    --primary: {{ brand.primary_color }};
    --accent: {{ brand.accent_color }};
  }
  body { font-family: Arial, Helvetica, sans-serif;
         margin: 0; color: #101a14; background: #eef2ef; }
  .sample-banner { background: #944600; color: white; padding: 10px 32px;
                   display: flex; align-items: center; justify-content: center;
                   gap: 14px; flex-wrap: wrap; font-size: 0.95rem; }
  .sample-banner a { color: white; font-weight: 500; text-decoration: underline;
                     white-space: nowrap; }
  .report-header { background: rgba(238,242,239,.94); color: #101a14;
           min-height: 72px; padding: 0 clamp(20px,5vw,56px);
           display: flex; align-items: center; gap: 16px; flex-wrap: wrap;
           border-bottom: 1px solid #e3ded3; }
  .report-header img.logo { height: 36px; }
  .report-brand { color: var(--primary); font-size: 21px; font-weight: 600;
                  letter-spacing: -.025em; text-decoration: none; }
  .report-label { color: #7a8279; font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
                  font-size: 11px; letter-spacing: .14em; text-transform: uppercase; }
  .report-actions { display: flex; align-items: center; gap: 12px; margin-left: auto;
                    flex-wrap: wrap; }
  .report-nav { display: flex; align-items: center; gap: 20px; }
  .report-nav a { color: #101a14; font-size: 14px; font-weight: 600;
                  text-decoration: none; white-space: nowrap; }
  .report-nav a:hover { color: var(--primary); }
  .print-report { appearance: none; background: var(--primary); border: 1px solid var(--primary);
                  border-radius: var(--sl-radius-control); color: white; cursor: pointer; font: inherit;
                  font-size: 0.85rem; font-weight: 500; padding: 8px 13px;
                  white-space: nowrap; }
  .print-report:hover, .print-report:focus-visible { background: white; color: var(--primary); }
  .print-report:focus-visible { outline: 3px solid var(--accent); outline-offset: 2px; }
  .hchip { background: rgba(255,255,255,0.18); border: 1px solid rgba(255,255,255,0.45);
           border-radius: var(--sl-radius-control); padding: 3px 12px; font-size: 0.8rem;
           color: var(--primary); border-color: rgba(20,71,44,.28); }
  main { max-width: 1100px; margin: 0 auto; padding: 24px 32px 48px; }
  h2 { color: var(--primary); border-bottom: 2px solid var(--accent); padding-bottom: 4px; }
  table { border-collapse: collapse; width: 100%; background: white; }
  /* Wide metric tables scroll inside their own box on narrow screens so the
     page body itself never scrolls sideways. */
  .table-scroll { overflow-x: auto; -webkit-overflow-scrolling: touch; }
  th, td { border: 1px solid #ddd; padding: 8px 10px; text-align: right; }
  th { background: var(--primary); color: white; text-align: center;
       vertical-align: top; }
  /* Tap a metric name to read what it is — no JS, works on phones. */
  .mx summary { cursor: pointer; list-style: none; }
  .mx summary::after { content: " ⓘ"; font-weight: 400; opacity: 0.75;
                       font-size: 0.8em; }
  .mx summary::-webkit-details-marker { display: none; }
  .mx-body { font-weight: 400; text-align: left; font-size: 0.8rem;
             min-width: 220px; max-width: 300px; margin-top: 6px;
             color: rgba(255,255,255,0.95); }
  .mx-body p { margin: 4px 0; }
  .mx-how { opacity: 0.9; }
  .mx-unit { opacity: 0.85; font-style: italic; }
  tr.mean-row td { font-weight: bold; background: #f0f0f0; }
  tr.bench-row td { color: #555; font-size: 0.85rem; background: #fafafa; }
  .meta { color: #555; font-size: 0.9rem; }
  table.meta td, table.meta th { text-align: left; border: none; padding: 2px 12px 2px 0; background: none; color: inherit; }
  table.meta td { overflow-wrap: anywhere; } /* long video paths must not widen the page */
  .swing { background: white; border: 1px solid #e0e0e0; border-radius: 8px;
           padding: 16px 20px; margin: 20px 0; }
  .swing img, .swing video { max-width: 100%; border-radius: 4px; margin-top: 10px; }
  .notes li { margin: 6px 0; }
  .flag { color: var(--accent); font-weight: 600; }
  .video-row { display: flex; gap: 16px; flex-wrap: wrap; align-items: flex-start; }
  .video-row figure { margin: 0; flex: 1 1 320px; min-width: 0; }
  .video-row video { width: 100%; }
{%- if replay_locked %}
  .replay-locked-note { background: #f4f4f4; border: 1px dashed #bbb;
                        border-radius: 8px; padding: 16px 18px; margin-top: 10px; }
  .replay-locked-note p { margin: 0 0 10px; color: #444; }
  .replay-locked-note a { color: var(--primary); font-weight: 600; }
  .replay-locked-note .lock-badge { display: inline-block;
    background: var(--primary); color: white; border-radius: var(--sl-radius-control);
    padding: 3px 12px; font-size: 0.75rem; font-weight: 500;
    letter-spacing: 0.02em; margin-bottom: 10px; }
{%- endif %}
  .tips { background: #eef6f0; border-left: 4px solid var(--primary);
          padding: 12px 16px; border-radius: 4px; }
  .brief { background: white; border: 1px solid #d9e5dd;
           border-top: 5px solid var(--primary); border-radius: 8px;
           padding: 18px 22px; margin-bottom: 22px; }
  .brief h2 { margin-top: 0; }
  .brief-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
                gap: 14px; }
  .brief-block { background: #f2f8f4; border-radius: 6px; padding: 12px 14px; }
  .brief-block.focus { background: #fff7ef; }
  .brief-block h3 { color: var(--primary); font-size: 0.95rem; margin: 0 0 6px; }
  .brief-block p { margin: 5px 0; }
  .brief-value { font-size: 1.05rem; }
  .brief .bench { color: #666; font-size: 0.85rem; }
  .brief-warning { border: 1px solid #e7c45d; background: #fffbea;
                   border-radius: 6px; padding: 10px 14px; color: #54440b; }
  details.measurements { margin: 18px 0 26px; }
  details.measurements > summary { cursor: pointer; color: var(--primary);
                                   font-weight: 500; padding: 10px 0; }
  .praise { background: #e5f3ea; border-left: 4px solid var(--primary);
            border-radius: 4px; padding: 12px 16px; }
  .praise ul { margin: 6px 0 0; padding-left: 20px; }
  .praise li { margin: 6px 0; }
  .start-lead { font-size: 1.05rem; color: #333; }
  .card.start-here { max-width: 640px; border-width: 1px 1px 1px 6px; }
  details.more-issues { margin-top: 18px; }
  details.more-issues > summary { cursor: pointer; color: var(--primary);
                                  font-weight: 600; padding: 6px 0; }
  details.more-issues .cards { margin-top: 12px; }
  .cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 16px; }
  .card { background: white; border: 1px solid #e0e0e0; border-left: 4px solid var(--primary);
          border-radius: 8px; padding: 14px 16px; }
  .card.sev-major { border-left-color: var(--accent); }
  .card-head { display: flex; justify-content: space-between; align-items: baseline; }
  .card-head h3 { margin: 0; color: var(--primary); font-size: 1.05rem; }
  .card .sev { font-size: 0.75rem; text-transform: uppercase; color: #777; }
  .card.sev-major .sev { color: var(--accent); font-weight: 500; }
  .card .bench { color: #777; font-size: 0.85rem; }
  .card .fixline .meta a { color: var(--primary); }
  .plan { background: white; border: 1px solid #e0e0e0; border-radius: 8px;
          padding: 16px 20px; margin: 20px 0; }
  .plan > h3 { margin: 0 0 4px; color: var(--primary); }
  .drill { border-top: 1px solid #eee; padding: 12px 0 4px; }
  .drill h4 { margin: 0 0 2px; font-size: 1rem; }
  .drill .aim { color: #555; margin: 0 0 6px; }
  .drill ol { margin: 6px 0; padding-left: 22px; }
  .drill ol li { margin: 3px 0; }
  .drill .dose { margin: 6px 0 4px; font-size: 0.92rem; }
  .drill .gear-note { color: #666; font-size: 0.85rem; margin: 4px 0; }
  .drill-media { display: flex; gap: 16px; margin: 8px 0; flex-wrap: wrap; }
  .drill-media figure { margin: 0; }
  .drill-media .drill-svg { width: 200px; height: auto; background: #fff;
                            border: 1px solid #eee; border-radius: 6px; }
  .drill-svg text { fill: #5f6368; } /* darken prop/count labels for legibility */
  .drill-media figcaption { text-align: center; color: #777; font-size: 0.8rem;
                            max-width: 200px; }
  .drill-media details summary { cursor: pointer; color: var(--primary);
                                 font-size: 0.9rem; padding: 2px 0; }
  .gear-link { color: #666; font-size: 0.9rem; }
  .gear-link a { color: var(--primary); }
  .disclaimer { color: #666; font-style: italic; margin-top: 32px;
                border-top: 1px solid #ddd; padding-top: 12px; }
  .trust-note { background: #f4f8f5; border: 1px solid #d4e2d8;
                border-radius: 8px; color: #30443a; margin: 0 0 18px;
                padding: 12px 14px; }
  footer { text-align: center; color: #777; font-size: 0.85rem; padding: 16px; }
  @media (max-width: 640px) {
    .report-header { align-items: flex-start; flex-direction: column;
                     gap: 8px; padding: 16px 20px; }
    .report-actions { gap: 10px; margin: 4px 0 0; width: 100%; }
    .report-nav { gap: 16px; }
    main { padding: 16px 16px 40px; }
  }
  /* Keep the browser's built-in print dialog useful as a report export:
     navigation and video controls are screen-only, while the closed detail
     sections expand so a saved PDF carries the full coaching record. */
  @media print {
    @page { margin: 12mm; }
    body { background: white; color: #101a14; font-size: 10pt; }
    .report-actions, .video-row, .replay-locked-note { display: none !important; }
    .report-header { background: white; border-bottom: 2px solid var(--primary);
                     min-height: 0; padding: 0 0 5mm; }
    main { max-width: none; padding: 5mm 0 0; }
    .table-scroll { overflow: visible; }
    th, td { padding: 4px 5px; }
    table { font-size: 8pt; }
    details.measurements > summary,
    details.more-issues > summary,
    .drill-media details > summary { display: none; }
    details.measurements:not([open]) > *:not(summary),
    details.more-issues:not([open]) > *:not(summary),
    .drill-media details:not([open]) > *:not(summary) { display: block; }
    .brief, .swing, .card, .plan, .tips, table, figure { break-inside: avoid;
                                                         page-break-inside: avoid; }
    h2, h3, h4 { break-after: avoid; page-break-after: avoid; }
  }

  /* Premium evidence-first presentation. This layer deliberately keeps the
     report self-contained: no remote fonts, assets, scripts, or runtime UI. */
  :root {
    --ink: #101a14;
    --ink-soft: #4d5850;
    --ink-muted: #5d685f;
    --accent-ink: #944600;
    --paper: #fffdf8;
    --canvas: #f3f1eb;
    --line: #ddd8cc;
    --green-wash: #edf5ef;
    --warm-wash: #e8f0ea;
    --shadow: 0 22px 55px -40px rgba(15, 42, 27, .55);
  }
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body {
    color: var(--ink);
    background:
      radial-gradient(circle at 88% 3%, rgba(232, 114, 12, .08), transparent 25rem),
      var(--canvas);
    font-family: Arial, Helvetica, sans-serif;
    line-height: 1.55;
  }
  .report-skip {
    position: fixed;
    top: 10px;
    left: 10px;
    z-index: 100;
    padding: 10px 14px;
    border-radius: 8px;
    background: var(--primary);
    color: white;
    font-weight: 500;
    transform: translateY(-150%);
  }
  .report-skip:focus { transform: translateY(0); }
  .sample-banner { padding-block: 11px; }
  .report-header {
    min-height: 76px;
    background: rgba(255, 253, 248, .96);
    border-bottom-color: var(--line);
    box-shadow: 0 8px 30px -26px rgba(15, 42, 27, .65);
  }
  .report-brand { font-size: 20px; }
  .report-label { padding-left: 14px; border-left: 1px solid var(--line); color: var(--ink-muted); }
  .hchip {
    padding: 5px 10px;
    border-color: rgba(20, 71, 44, .22);
    background: var(--green-wash);
    font-weight: 500;
  }
  main {
    max-width: 1160px;
    margin-inline: auto;
    padding: 34px clamp(18px, 4vw, 42px) 64px;
  }
  .report-intro {
    position: relative;
    overflow: hidden;
    margin-bottom: 18px;
    padding: clamp(28px, 5vw, 52px);
    border-radius: 22px;
    background: var(--primary);
    background:
      radial-gradient(circle at 92% 18%, rgba(255, 255, 255, .11), transparent 25%),
      linear-gradient(135deg, #0d2e20, var(--primary));
    box-shadow: 0 30px 70px -48px rgba(6, 31, 19, .9);
    color: white;
  }
  .report-intro::after {
    content: "";
    position: absolute;
    right: -70px;
    bottom: -130px;
    width: 300px;
    height: 300px;
    border: 1px solid rgba(255, 255, 255, .12);
    border-radius: 50%;
    box-shadow: 0 0 0 42px rgba(255, 255, 255, .035),
                0 0 0 82px rgba(255, 255, 255, .025);
    pointer-events: none;
  }
  .section-kicker {
    margin: 0 0 7px;
    color: var(--accent-ink);
    font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
    font-size: .7rem;
    font-weight: 500;
    letter-spacing: .13em;
    text-transform: uppercase;
  }
  .report-intro .section-kicker { color: #ffc98f; }
  .report-intro h1 {
    position: relative;
    z-index: 1;
    max-width: 780px;
    margin: 0;
    color: white;
    font-size: clamp(2.25rem, 6vw, 4.5rem);
    line-height: .98;
    letter-spacing: -.05em;
  }
  .report-intro__lede {
    position: relative;
    z-index: 1;
    max-width: 720px;
    margin: 17px 0 0;
    color: rgba(255, 255, 255, .8);
    font-size: clamp(.98rem, 1.8vw, 1.12rem);
  }
  .report-context {
    position: relative;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    gap: 9px;
    margin: 24px 0 0;
  }
  .report-context div {
    min-width: 120px;
    padding: 9px 12px;
    border: 1px solid rgba(255, 255, 255, .18);
    border-radius: 11px;
    background: rgba(255, 255, 255, .075);
  }
  .report-context dt {
    color: #ffc98f;
    font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
    font-size: .62rem;
    letter-spacing: .08em;
    text-transform: uppercase;
  }
  .report-context dd { margin: 2px 0 0; color: white; font-size: .86rem; font-weight: 500; }
  h2 {
    margin: 0 0 13px;
    padding: 0;
    border: 0;
    color: var(--primary);
    font-size: clamp(1.35rem, 3vw, 1.9rem);
    letter-spacing: -.025em;
  }
  .trust-note {
    margin: 0 0 22px;
    padding: 14px 17px;
    border: 1px solid #d0dfd4;
    border-radius: 12px;
    background: var(--green-wash);
    color: #30443a;
    font-size: .9rem;
  }
  .brief {
    position: relative;
    margin-bottom: 24px;
    padding: clamp(22px, 4vw, 36px);
    border: 1px solid #d3ded6;
    border-top: 0;
    border-radius: 18px;
    background: var(--paper);
    box-shadow: var(--shadow);
  }
  .brief::before {
    content: "";
    position: absolute;
    top: 0;
    right: 0;
    left: 0;
    height: 5px;
    border-radius: 18px 18px 0 0;
    background: linear-gradient(90deg, var(--primary), var(--accent));
  }
  .brief > p:not(.section-kicker):not(.brief-warning) { color: var(--ink-soft); }
  .brief-grid {
    grid-template-columns: minmax(0, 1.35fr) minmax(240px, .8fr);
    gap: 13px;
  }
  .brief-block {
    padding: 17px 18px;
    border: 1px solid #dce5de;
    border-radius: 12px;
    background: var(--green-wash);
  }
  .brief-block.focus {
    grid-column: 1 / -1;
    order: -2;
    padding: 20px;
    border-color: #e5c39d;
    background: var(--warm-wash);
  }
  .brief-block h3 {
    color: var(--ink-muted);
    font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
    font-size: .68rem;
    letter-spacing: .09em;
    text-transform: uppercase;
  }
  .brief-value { margin-top: 7px; color: var(--ink); font-size: 1.2rem; }
  .brief-steps { margin: 10px 0 12px; padding-left: 22px; color: var(--ink-soft); }
  .brief-steps li { margin: 5px 0; }
  .flag,
  .card.sev-major .sev { color: var(--accent-ink); }
  .card .sev,
  .card .bench,
  .drill-media figcaption { color: var(--ink-muted); }
  .brief-warning { border-radius: 10px; }
  .brief-refilm,
  .refilm-target {
    margin-top: 12px;
    padding: 11px 13px;
    border-left: 3px solid var(--accent);
    border-radius: 7px;
    background: rgba(255, 255, 255, .72);
  }
  .target-label {
    display: block;
    margin-bottom: 4px;
    color: var(--ink-muted);
    font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
    font-size: .64rem;
    font-weight: 500;
    letter-spacing: .09em;
    text-transform: uppercase;
  }
  .swing-breakdown {
    margin: 30px 0 26px;
  }
  .breakdown-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
  }
  .breakdown-card {
    display: flex;
    min-height: 100%;
    flex-direction: column;
    padding: 19px;
    border: 1px solid var(--line);
    border-top: 4px solid var(--primary);
    border-radius: 14px;
    background: var(--paper);
    box-shadow: 0 16px 38px -34px rgba(15, 42, 27, .65);
  }
  .breakdown-card--warning { border-top-color: var(--accent); }
  .breakdown-card--context { border-top-color: #537463; }
  .breakdown-card--unavailable { border-top-color: #929b94; background: #f8f7f3; }
  .breakdown-card__head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 12px;
  }
  .breakdown-card__evidence {
    margin: 0 0 5px;
    color: var(--ink-muted);
    font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
    font-size: .62rem;
    font-weight: 500;
    letter-spacing: .08em;
    text-transform: uppercase;
  }
  .breakdown-card h3 { margin: 0; color: var(--ink); font-size: 1.12rem; }
  .breakdown-card__status {
    flex: 0 0 auto;
    padding: 5px 9px;
    border-radius: var(--sl-radius-control);
    background: var(--green-wash);
    color: var(--primary);
    font-size: .7rem;
    font-weight: 500;
  }
  .breakdown-card--warning .breakdown-card__status {
    background: var(--warm-wash);
    color: var(--accent-ink);
  }
  .breakdown-card--context .breakdown-card__status,
  .breakdown-card--unavailable .breakdown-card__status {
    background: #ecefea;
    color: #465249;
  }
  .breakdown-card__summary { margin: 0 0 13px; color: var(--ink); line-height: 1.55; }
  .breakdown-card__why { margin: auto 0 0; color: var(--ink-soft); font-size: .9rem; }
  .breakdown-card__limit {
    margin: 12px 0 0;
    padding-top: 11px;
    border-top: 1px solid var(--line);
    color: var(--ink-muted);
    font-size: .82rem;
  }
  .measurement-guide {
    margin: 0 20px 18px;
    padding: 14px 16px;
    border: 1px solid #d8ddd8;
    border-radius: 10px;
    background: #f7f8f5;
    color: var(--ink-soft);
    font-size: .88rem;
  }
  .measurement-guide p { margin: 5px 0; }
  details.measurements {
    overflow: hidden;
    margin: 22px 0 28px;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--paper);
    box-shadow: 0 14px 38px -34px rgba(15, 42, 27, .5);
  }
  details.measurements > summary {
    padding: 16px 19px;
    border-bottom: 0;
    background: #f8f6f1;
    color: var(--primary);
    font-weight: 500;
  }
  details.measurements[open] > summary { border-bottom: 1px solid var(--line); }
  details.measurements > h2,
  details.measurements > h3,
  details.measurements > p,
  details.measurements > ul,
  details.measurements > .table-scroll,
  details.measurements > table { margin-inline: 20px; width: calc(100% - 40px); }
  details.measurements > h2 { margin-top: 24px; }
  details.measurements > h3 { margin-top: 22px; color: var(--primary); }
  details.measurements > :last-child { margin-bottom: 24px; }
  table { border: 1px solid var(--line); border-radius: 8px; background: white; }
  caption { padding: 0 0 8px; color: var(--ink-soft); font-weight: 500; text-align: left; }
  th, td { border-color: #e0ddd5; padding: 9px 10px; }
  th { background: var(--primary); }
  table.meta { border: 0; }
  table.meta th { width: 145px; color: var(--ink-muted); font-weight: 500; }
  tr.mean-row td { background: var(--green-wash); }
  tr.spread-row td { background: #f6f4ee; color: var(--ink-soft); }
  tr.bench-row td { background: #faf8f3; }
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
  .swing-evidence { margin: 34px 0 30px; }
  .section-heading { max-width: 720px; margin-bottom: 16px; }
  .section-heading p:last-child { margin: 0; color: var(--ink-soft); }
  .swing {
    margin: 16px 0;
    padding: clamp(18px, 3vw, 26px);
    border-color: var(--line);
    border-radius: 15px;
    background: var(--paper);
    box-shadow: var(--shadow);
  }
  .swing > h2 { font-size: 1.25rem; }
  .swing img,
  .swing video { border: 1px solid #dedbd3; border-radius: 9px; background: #111; }
  .video-row { gap: 20px; }
  .video-row figure {
    padding: 13px;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: #f8f6f1;
  }
  .video-row figure h3 { margin: 0; color: var(--primary); font-size: 1rem; }
  .coaching-followthrough {
    margin-top: 38px;
    padding-top: 28px;
    border-top: 1px solid var(--line);
  }
  .strengths-section,
  .priority-detail,
  .practice-section { margin-top: 28px; }
  .praise {
    padding: 17px 19px;
    border: 1px solid #cfe1d3;
    border-left: 5px solid var(--primary);
    border-radius: 11px;
    background: var(--green-wash);
  }
  .card {
    border-color: var(--line);
    border-radius: 12px;
    background: var(--paper);
    box-shadow: 0 14px 34px -32px rgba(15, 42, 27, .6);
  }
  .card.start-here {
    max-width: none;
    padding: 20px;
    border-width: 1px 1px 1px 6px;
    background: var(--warm-wash);
  }
  details.more-issues {
    margin-top: 14px;
    padding: 12px 15px;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: #f8f6f1;
  }
  details.more-issues > summary { padding: 3px 0; }
  .plan {
    margin: 15px 0;
    padding: 20px;
    border-color: var(--line);
    border-radius: 14px;
    background: var(--paper);
    box-shadow: var(--shadow);
  }
  .plan > h3 { font-size: 1.13rem; }
  .drill { padding-top: 16px; }
  .drill h4 { color: var(--ink); font-size: 1.05rem; }
  .drill .aim { color: var(--ink-soft); }
  .drill-media { gap: 20px; }
  .drill-media figure {
    padding: 9px;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: white;
  }
  .gear-link {
    padding: 13px 15px;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: #f8f6f1;
  }
  .tips {
    margin-top: 34px;
    padding: 17px 19px;
    border: 1px solid #cfe1d3;
    border-left: 5px solid var(--primary);
    border-radius: 11px;
    background: var(--green-wash);
  }
  .disclaimer { color: var(--ink-muted); }
  footer { padding: 20px; color: var(--ink-muted); }
  @media (max-width: 760px) {
    .report-header { align-items: flex-start; flex-direction: column; gap: 8px; padding: 16px 18px; }
    .report-label { padding-left: 0; border-left: 0; }
    .report-actions { width: 100%; margin: 5px 0 0; }
    main { padding: 20px 14px 44px; }
    .report-intro { padding: 28px 22px; border-radius: 17px; }
    .report-intro h1 { font-size: 2.45rem; }
    .brief-grid { grid-template-columns: 1fr; }
    .brief-block.focus { grid-column: auto; }
    .breakdown-grid { grid-template-columns: 1fr; }
    .breakdown-card { padding: 17px; }
    .measurement-guide { margin-inline: 14px; }
    details.measurements > h2,
    details.measurements > h3,
    details.measurements > p,
    details.measurements > ul,
    details.measurements > .table-scroll,
    details.measurements > table { margin-inline: 14px; width: calc(100% - 28px); }
  }
  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
    *, *::before, *::after {
      animation-duration: .01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: .01ms !important;
    }
  }
  @media print {
    @page { size: auto; margin: 12mm 11mm 14mm; }
    html { scroll-behavior: auto; }
    body {
      background: white !important;
      color: #101a14;
      font-size: 9.5pt;
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }
    .report-skip,
    .report-actions, .video-row, .replay-locked-note { display: none !important; }
    .sample-banner {
      display: flex !important;
      padding: 3mm 5mm;
      border: 2px solid #944600;
      background: white !important;
      color: #944600 !important;
    }
    .sample-banner a { display: none !important; }
    .report-header { box-shadow: none; }
    main { padding-top: 5mm; }
    .report-intro {
      margin-bottom: 5mm;
      padding: 8mm;
      border: 2px solid var(--primary);
      border-radius: 0;
      background: white !important;
      color: #101a14;
      box-shadow: none;
    }
    .report-intro .section-kicker,
    .report-intro h1 { color: var(--primary); }
    .report-intro h1 { font-size: 25pt; }
    .report-intro__lede { color: #36423a; }
    .report-context div { border-color: #cfd5d0; background: white; }
    .report-context dt { color: var(--primary); }
    .report-context dd { color: #101a14; }
    .report-intro::after { display: none; }
    .brief,
    .breakdown-card,
    .swing,
    .card,
    .plan { box-shadow: none; }
    .brief-grid { display: block; }
    .brief-block { margin-bottom: 3mm; }
    .swing-evidence,
    .coaching-followthrough { margin-top: 6mm; }
    details.measurements { overflow: visible; box-shadow: none; }
    details.measurements > h2,
    details.measurements > h3,
    details.measurements > p,
    details.measurements > ul,
    details.measurements > .table-scroll,
    details.measurements > table { margin-inline: 0; width: 100%; }
    tr, img, .brief-block, .breakdown-card, .drill { break-inside: avoid; page-break-inside: avoid; }
    .section-heading,
    .target-label { break-after: avoid; page-break-after: avoid; }
  }
</style>
</head>
<body>
<a class="report-skip" href="#report-main">Skip to report</a>
{% if sample_banner %}
<div class="sample-banner">
  <span>{{ sample_banner.text }}</span>
  <a href="{{ sample_banner.cta_url }}">{{ sample_banner.cta_label }}</a>
</div>
{% endif %}
<header class="report-header">
  {% if brand.logo_path %}<img class="logo" src="{{ brand.logo_path }}" alt="{{ brand.name }}">{% endif %}
  {% if storefront_url %}
    <a class="report-brand" href="{{ storefront_url }}">{{ brand.name | upper }}</a>
  {% else %}
    <span class="report-brand">{{ brand.name | upper }}</span>
  {% endif %}
  <span class="report-label">Swing report</span>
  {% if club_label %}<span class="hchip">{{ club_label }}</span>{% endif %}
  {% if level_label %}<span class="hchip">{{ level_label }}</span>{% endif %}
  {% if dtl %}<span class="hchip">Down the line — tempo &amp; rhythm only</span>{% endif %}
  <div class="report-actions">
  {% if app_url %}
    <nav class="report-nav" aria-label="Report navigation">
      {% if storefront_url %}<a href="{{ storefront_url }}">Home</a>{% endif %}
      <a href="{{ app_url }}/">Analyze</a>
      <a href="{{ app_url }}/sessions">History</a>
    </nav>
  {% endif %}
    <button class="print-report" type="button" onclick="window.print()"
      aria-label="Print this swing report or save it as a PDF">Print / Save PDF</button>
  </div>
</header>
<main id="report-main">

<section class="report-intro" aria-labelledby="report-title">
  <p class="section-kicker">Evidence-first swing review</p>
  <h1 id="report-title">Swing report</h1>
  {% if caddie_brief and caddie_brief.refilm_required %}
  <p class="report-intro__lede">This capture review leads with what prevented
    trustworthy coaching, then keeps the available session evidence and a clear
    re-film instruction together.</p>
  {% else %}
  <p class="report-intro__lede">This report organizes phone-video timing and
    supported 2D movement into a plain-English swing breakdown, one coaching
    priority, a practice prescription, and a comparable re-film target.</p>
  {% endif %}
  <dl class="report-context" aria-label="Swing context">
    {% if club_label %}<div><dt>Club</dt><dd>{{ club_label }}</dd></div>{% endif %}
    <div><dt>Handedness</dt><dd>{{ hand }}</dd></div>
    <div><dt>Camera</dt><dd>{% if dtl %}Down the line{% else %}Face-on{% endif %}</dd></div>
    {% if level_label %}<div><dt>Experience</dt><dd>{{ level_label }}</dd></div>{% endif %}
    <div><dt>Swings</dt><dd>{{ swings|length }} detected</dd></div>
  </dl>
</section>

{% if club_aware_enabled %}
<p class="trust-note" aria-label="Club-aware measurement scope">
  <strong>Club-aware scope.</strong>
  {% if dtl %}
  This down-the-line report remains tempo-and-rhythm only; club does not
  change its priority.
  {% elif club_priority_changes_ties %}
  The selected {{ club_label }} is used only to order issues with the same
  severity; measurements and thresholds do not change.
  {% else %}
  Club context does not change the legacy tie order for this report.
  {% endif %}
  Supported measurements are phone-video timing and, from supported face-on
  clips, 2D body movement in the camera view. {{ brand.name }} does not measure
  clubhead speed, ball speed, club path, face angle, attack angle, dynamic
  loft, launch, spin, carry, strike location, or ball flight.
</p>
{% endif %}

<p class="trust-note" aria-label="Matched re-film protocol">
  <strong>Make the follow-up comparable.</strong> Re-film with the same club,
  handedness, camera angle and height, framing, and a similar swing effort.
  Matching the setup improves the phone-video comparison; it does not establish
  cause or measure ball flight.
</p>

{% if caddie_brief %}
<section class="brief">
  {% if caddie_brief.refilm_required %}
  <p class="section-kicker">Capture quality</p>
  <h2>Re-film before coaching</h2>
  <p>Your caddie needs a trustworthy view before choosing a swing change.</p>
  <p class="brief-warning"><strong>Why this session stopped:</strong>
    {{ caddie_brief.warning }}</p>
  <div class="brief-block focus">
    <h3>Do this first</h3>
    <p class="brief-value"><strong>{{ caddie_brief.focus_name }}</strong></p>
    <p>{{ caddie_brief.why }}</p>
    <p><strong>Next:</strong> {{ caddie_brief.fix }}</p>
  </div>
  {% else %}
  <p class="section-kicker">Primary read</p>
  <h2>Your caddie's read</h2>
  <p>Start with one thing. The measurements and full drill library stay below
    when you want the detail.</p>
  {% if caddie_brief.warning %}
  <p class="brief-warning"><strong>Measurement note:</strong>
    {{ caddie_brief.warning }}</p>
  {% endif %}
  <div class="brief-grid">
    <div class="brief-block focus">
      <h3>{{ "Protect" if caddie_brief.clean else "Fix first" }}</h3>
      <p class="brief-value"><strong>{{ caddie_brief.focus_name }}</strong>
        {% if caddie_brief.focus_value %} — {{ caddie_brief.focus_value }}
          {% if caddie_brief.benchmark_text %}
          <span class="bench">({{ caddie_brief.benchmark_text }})</span>
          {% endif %}
        {% endif %}
      </p>
      <p>{{ caddie_brief.why }}</p>
      <p><strong>Coach's cue:</strong> {{ caddie_brief.fix }}</p>
    </div>
    <div class="brief-block">
      <h3>Practice this</h3>
      <p><strong><a href="#drill-{{ caddie_brief.drill.id }}">{{
        caddie_brief.drill.name }}</a></strong> —
        {{ caddie_brief.drill.aim }}</p>
      <ol class="brief-steps" aria-label="Practice steps">
        {% for step in caddie_brief.drill.protocol %}<li>{{ step }}</li>{% endfor %}
      </ol>
      <p><strong>Dosage:</strong> {{ caddie_brief.drill.dosage }}</p>
      <p class="brief-refilm"><span class="target-label">Matched re-film target</span>
        <strong>Pass mark:</strong> {{ caddie_brief.drill.success_metric }}</p>
    </div>
    {% if caddie_brief.strength %}
    <div class="brief-block">
      <h3>Keep</h3>
      <p>{{ caddie_brief.strength }}</p>
    </div>
    {% endif %}
  </div>
  {% endif %}
</section>
{% endif %}

{% set refilm_required = caddie_brief and caddie_brief.refilm_required %}
{% if swing_breakdown and not refilm_required %}
<section class="swing-breakdown" aria-labelledby="swing-breakdown-heading">
  <header class="section-heading">
    <p class="section-kicker">Plain-English swing breakdown</p>
    <h2 id="swing-breakdown-heading">What your video showed</h2>
    <p>Read the status first, then the explanation. Each card separates what
      the video observed from what it cannot measure.</p>
  </header>
  <div class="breakdown-grid">
    {% for item in swing_breakdown %}
    <article class="breakdown-card breakdown-card--{{ item.tone }}">
      <div class="breakdown-card__head">
        <div>
          <p class="breakdown-card__evidence">{{ item.evidence }}</p>
          <h3>{{ item.title }}</h3>
        </div>
        <span class="breakdown-card__status">{{ item.status }}</span>
      </div>
      <p class="breakdown-card__summary">{{ item.summary }}</p>
      <p class="breakdown-card__why"><strong>Why it matters:</strong>
        {{ item.why }}</p>
      {% if item.limit %}
      <p class="breakdown-card__limit"><strong>What it cannot tell us:</strong>
        {{ item.limit }}</p>
      {% endif %}
    </article>
    {% endfor %}
  </div>
</section>
{% endif %}

<details class="measurements">
<summary>{% if refilm_required %}See capture details{% else %}See the measurements and session details{% endif %}</summary>
<h2>Session</h2>
<table class="meta">
  <caption class="visually-hidden">Session context and source details</caption>
  {# Filename only — the full path is server internals (web uploads live at
     <session>/source.mov) and means nothing to the reader. #}
  <tr><th scope="row">Video</th><td>{{ video.path.name }}</td></tr>
  <tr><th scope="row">Duration</th><td>{{ "%.1f"|format(video.duration_s) }} s</td></tr>
  <tr><th scope="row">Resolution</th><td>{{ video.display_width }}×{{ video.display_height }}
      {% if video.rotation %}(rotation metadata: {{ video.rotation }}°){% endif %}</td></tr>
  <tr><th scope="row">Frame rate</th><td>{{ "%.2f"|format(video.fps) }} fps</td></tr>
  {% if analysis_fps %}<tr><th scope="row">Analyzed at</th><td>{{ "%g"|format(analysis_fps) }} fps</td></tr>{% endif %}
  {% if video.creation_time %}<tr><th scope="row">Recorded</th><td>{{ video.creation_time }}</td></tr>{% endif %}
  <tr><th scope="row">Swings detected</th><td>{{ swings|length }}</td></tr>
  <tr><th scope="row">Handedness</th><td>{{ hand }}</td></tr>
  <tr><th scope="row">Camera angle</th><td>{% if dtl %}Down the line (tempo &amp; rhythm only){% else %}Face-on{% endif %}</td></tr>
  {% if club_label %}<tr><th scope="row">Club</th><td>{{ club_label }}</td></tr>{% endif %}
  {% if level_label %}<tr><th scope="row">Experience</th><td>{{ level_label }}</td></tr>{% endif %}
</table>

{% if not refilm_required %}
<h2>Measurements and glossary</h2>
{% if level_note %}
{# One framing line per declared experience level (swinglab.levels) —
   reframing for the reader, never a change to any number below. #}
<p class="meta">{{ level_note }}</p>
{% endif %}
<div class="measurement-guide" aria-label="How to read the measurements">
  <p><strong>How to read this section.</strong> A highlighted number crossed a
    coaching line; it is a place to investigate, not a diagnosis.</p>
  <p><strong>Shoulder-width (SW)</strong> makes movement easier to compare:
    0.25 SW means one-quarter of your shoulder width at setup.</p>
  <p><strong>Session average</strong> is the usual value across readable swings.
    <strong>Swing-to-swing spread</strong> shows how much those swings differed;
    a smaller spread means the motion was more repeatable.</p>
  <p><strong>—</strong> means the value was not readable or this camera view
    cannot support it. It never means zero. Tap a column name for its full
    plain-English definition and measurement method.</p>
  <p><strong>Benchmarks are references, not day-one targets.</strong> Moving
    toward a useful reference matters more than matching it immediately.</p>
</div>

<h3>Timing and rhythm</h3>
<div class="table-scroll" role="region" aria-label="Swing timing measurements" tabindex="0">
<table>
  <caption class="visually-hidden">Swing timing and rhythm measurements</caption>
  <tr>
    <th scope="col">Swing</th>
    {{ mhead("strike_s", "Impact time in clip (s)") }}
    {{ mhead("backswing_s", "Time going back (s)") }}
    {{ mhead("downswing_s", "Time coming down (s)") }}
    {{ mhead("tempo_ratio", "Swing rhythm (reference %.1f-to-1)"|format(coaching.tempo_target)) }}
  </tr>
  {% for s in swings %}
  <tr>
    <td>{{ s.metrics.swing }}</td>
    {{ num(s.metrics.strike_s) }}
    {{ num(s.metrics.backswing_s) }}
    {{ num(s.metrics.downswing_s) }}
    {{ num(s.metrics.tempo_ratio, "%.2f", s.metrics.tempo_ratio < coaching.tempo_warn_below) }}
  </tr>
  {% endfor %}
  {% if stats %}
  <tr class="mean-row"><td>Session average</td><td>—</td>
    {% for key in ["backswing_s", "downswing_s", "tempo_ratio"] %}
      {% set st = stats.get(key) %}
      <td>{% if st %}{{ "%.2f"|format(st.mean) }}{% else %}—{% endif %}</td>
    {% endfor %}
  </tr>
  <tr class="spread-row"><td>Swing-to-swing spread</td><td>—</td>
    {% for key in ["backswing_s", "downswing_s", "tempo_ratio"] %}
      {% set st = stats.get(key) %}
      <td>{% if st %}{{ "%.2f"|format(st.std) }}{% else %}—{% endif %}</td>
    {% endfor %}
  </tr>
  {% endif %}
</table>
</div>

{% if not dtl %}
<h3>Body movement</h3>
<div class="table-scroll" role="region" aria-label="Body movement measurements" tabindex="0">
<table>
  <caption class="visually-hidden">Body movement measurements</caption>
  <tr><th scope="col">Swing</th>
    {{ mhead("head_sway_backswing_sw", "Head drift going back (SW)") }}
    {{ mhead("head_sway_downswing_sw", "Head move into impact (SW)") }}
    {{ mhead("hip_slide_backswing_sw", "Hip drift going back (SW)") }}
    {{ mhead("hip_slide_downswing_sw", "Hip move into impact (SW)") }}
  </tr>
  {% for s in swings %}{% set m = s.metrics %}
  <tr><td>{{ m.swing }}</td>
    {{ num(m.head_sway_backswing_sw, "%.2f", m.head_sway_backswing_sw > coaching.sway_warn_sw) }}
    {{ num(m.head_sway_downswing_sw) }}
    {{ num(m.hip_slide_backswing_sw, "%.2f", m.hip_slide_backswing_sw > coaching.sway_warn_sw) }}
    {{ num(m.hip_slide_downswing_sw) }}
  </tr>{% endfor %}
  {% if stats %}
  <tr class="mean-row"><td>Session average</td>
    {% for key in ["head_sway_backswing_sw", "head_sway_downswing_sw",
                   "hip_slide_backswing_sw", "hip_slide_downswing_sw"] %}
      {% set st = stats.get(key) %}
      <td>{% if st %}{{ "%.2f"|format(st.mean) }}{% else %}—{% endif %}</td>
    {% endfor %}
  </tr>
  <tr class="spread-row"><td>Swing-to-swing spread</td>
    {% for key in ["head_sway_backswing_sw", "head_sway_downswing_sw",
                   "hip_slide_backswing_sw", "hip_slide_downswing_sw"] %}
      {% set st = stats.get(key) %}
      <td>{% if st %}{{ "%.2f"|format(st.std) }}{% else %}—{% endif %}</td>
    {% endfor %}
  </tr>
  <tr class="bench-row"><td>Coaching line</td>
    <td>≤ {{ "%.2f"|format(coaching.sway_warn_sw) }}</td>
    <td>Context only</td>
    <td>≤ {{ "%.2f"|format(coaching.sway_warn_sw) }}</td>
    <td>Context only</td>
  </tr>
  {% endif %}
</table>
</div>
<p class="meta">Positive sideways movement is away from the target; negative
movement is toward it. The into-impact columns are context, not grades.</p>

<h3>Setup and movement context</h3>
<div class="table-scroll" role="region" aria-label="Setup and movement context" tabindex="0">
<table>
  <caption class="visually-hidden">Setup and movement context measurements</caption>
  <tr><th scope="col">Swing</th>
    {{ mhead("stance_width_sw", "Stance width (SW)") }}
    {{ mhead("downswing_hand_speed_sw_s", "Downswing hand movement (SW/s)") }}
  </tr>
  {% for s in swings %}{% set m = s.metrics %}
  <tr><td>{{ m.swing }}</td>
    {{ num(m.stance_width_sw) }}
    {{ num(m.downswing_hand_speed_sw_s) }}
  </tr>{% endfor %}
  {% if stats %}
  <tr class="mean-row"><td>Session average</td>
    {% for key in ["stance_width_sw", "downswing_hand_speed_sw_s"] %}
      {% set st = stats.get(key) %}
      <td>{% if st %}{{ "%.2f"|format(st.mean) }}{% else %}—{% endif %}</td>
    {% endfor %}
  </tr>
  <tr class="spread-row"><td>Swing-to-swing spread</td>
    {% for key in ["stance_width_sw", "downswing_hand_speed_sw_s"] %}
      {% set st = stats.get(key) %}
      <td>{% if st %}{{ "%.2f"|format(st.std) }}{% else %}—{% endif %}</td>
    {% endfor %}
  </tr>
  <tr class="bench-row"><td>How to use it</td>
    <td>Setup baseline</td><td>Matched re-films only</td>
  </tr>
  {% endif %}
</table>
</div>
<p class="meta">These are context measurements, not scores. Hand movement is
a body-normalized camera-view estimate — never clubhead speed, ball speed, or mph.</p>

<h3>Impact body shape and finish</h3>
<div class="table-scroll" role="region" aria-label="Impact and finish measurements" tabindex="0">
<table>
  <caption class="visually-hidden">Impact and finish measurements</caption>
  <tr><th scope="col">Swing</th>
    {{ mhead("head_dip_sw", "Head height lost by impact (SW)") }}
    {{ mhead("lead_arm_angle_deg", "Lead-arm straightness (°)") }}
    {{ mhead("shoulder_tilt_impact_deg", "Impact shoulder angle (°)") }}
    {{ mhead("shoulder_tilt_delta_deg", "Shoulder angle gained or lost (°)") }}
    {{ mhead("finish_balance_sw", "Stance-center drift at finish (SW)") }}</tr>
  {% for s in swings %}{% set m = s.metrics %}
  <tr><td>{{ m.swing }}</td>
    {{ num(m.head_dip_sw, flagged=(m.head_dip_sw > coaching.head_dip_warn_sw)) }}
    {{ num(m.lead_arm_angle_deg, "%.0f", m.lead_arm_angle_deg < coaching.lead_arm_warn_deg) }}
    {{ num(m.shoulder_tilt_impact_deg, "%.0f", m.shoulder_tilt_impact_deg < coaching.shoulder_tilt_impact_min_deg) }}
    {{ num(m.shoulder_tilt_delta_deg, "%.0f", m.shoulder_tilt_delta_deg < 0) }}
    {{ num(m.finish_balance_sw, flagged=(m.finish_balance_sw > coaching.finish_balance_warn_sw)) }}
  </tr>{% endfor %}
  {% if stats %}
  <tr class="mean-row"><td>Session average</td>
    {% for key, fmt in [("head_dip_sw", "%.2f"), ("lead_arm_angle_deg", "%.0f"),
                        ("shoulder_tilt_impact_deg", "%.0f"),
                        ("shoulder_tilt_delta_deg", "%.0f"),
                        ("finish_balance_sw", "%.2f")] %}
      {% set st = stats.get(key) %}
      <td>{% if st %}{{ fmt|format(st.mean) }}{% else %}—{% endif %}</td>
    {% endfor %}
  </tr>
  <tr class="spread-row"><td>Swing-to-swing spread</td>
    {% for key, fmt in [("head_dip_sw", "%.2f"), ("lead_arm_angle_deg", "%.0f"),
                        ("shoulder_tilt_impact_deg", "%.0f"),
                        ("shoulder_tilt_delta_deg", "%.0f"),
                        ("finish_balance_sw", "%.2f")] %}
      {% set st = stats.get(key) %}
      <td>{% if st %}{{ fmt|format(st.std) }}{% else %}—{% endif %}</td>
    {% endfor %}
  </tr>
  <tr class="bench-row"><td>Coaching line</td>
    <td>≤ {{ "%.2f"|format(coaching.head_dip_warn_sw) }}</td>
    <td>≥ {{ "%.0f"|format(coaching.lead_arm_warn_deg) }}</td>
    <td>≥ {{ "%.0f"|format(coaching.shoulder_tilt_impact_min_deg) }}</td>
    <td>≥ 0</td>
    <td>≤ {{ "%.2f"|format(coaching.finish_balance_warn_sw) }}</td>
  </tr>
  {% endif %}
</table>
</div>
<p class="meta">Angles are measured in the camera's view (face-on). Head dip is
setup to impact; a positive shoulder angle means the trail shoulder is lower.
Finish drift tracks the midpoint between the ankles while the finish is held;
it does not measure every movement of either foot.</p>
{% endif %}

{% if session_notes %}
<h2>Session notes</h2>
<ul class="notes">
  {% for note in session_notes %}<li>{{ note }}</li>{% endfor %}
</ul>
{% endif %}
{% endif %}
</details>

<section class="swing-evidence" aria-labelledby="swing-evidence-heading">
  <header class="section-heading">
    <p class="section-kicker">Session evidence</p>
    <h2 id="swing-evidence-heading">Swing evidence</h2>
    <p>Review the captured positions and available playback for each detected
      swing. These are the source views behind the {% if refilm_required %}capture-quality
      decision{% else %}coaching summary{% endif %} above.</p>
  </header>
{% for s in swings %}
<article class="swing" aria-label="Swing {{ s.metrics.swing }} evidence">
  <h2>Swing {{ s.metrics.swing }}</h2>
  {% if not refilm_required %}
  <ul class="notes">
    {% for note in s.notes %}<li>{{ note }}</li>{% endfor %}
  </ul>
  {% endif %}
  {% if not refilm_required and s.strip %}
  <h3>Key positions</h3>
  <img src="{{ s.strip }}" alt="Key positions, swing {{ s.metrics.swing }}">
  {% endif %}
  {% if not refilm_required and s.overlay %}
  <h3>Centerline overlay</h3>
  <img src="{{ s.overlay }}" alt="Centerline overlay, swing {{ s.metrics.swing }}">
  {% endif %}
  {% if s.slowmo or (not refilm_required and (s.replay or replay_locked)) %}
  <div class="video-row">
    {% if s.slowmo %}
    <figure>
      <h3>Slow motion ({{ slowmo_factor }}× slower)</h3>
      <video controls muted playsinline src="{{ s.slowmo }}"
        aria-label="Slow motion playback for swing {{ s.metrics.swing }}"></video>
    </figure>
    {% endif %}
    {% if not refilm_required and s.replay %}
    <figure>
      <h3>Coach replay</h3>
      <video controls muted playsinline src="{{ s.replay }}"
        aria-label="Coach replay for swing {{ s.metrics.swing }}"></video>
      <figcaption class="meta">Your own footage, annotated: the tracked body,
      the hand path (wrist centroid), and the numbers appearing at each swing
      event — same window as the slow motion.</figcaption>
    </figure>
    {% elif not refilm_required and replay_locked %}
    {# billing.replay_pro_only: the replay was not rendered for this session
       (free plan at analysis time). Say what it is, honestly, in its slot. #}
    <figure>
      <h3>Coach replay</h3>
      <div class="replay-locked-note">
        <span class="lock-badge">&#128274; Included with Pro</span>
        {# Promise exactly what annotate.py draws: the skeleton, the hand
           path, and the numbers appearing at each swing event — the same
           wording as the unlocked replay's caption. #}
        <p>The coach replay is this swing played back with your tracked
        body, your hand path, and the numbers appearing at each swing
        event — the same footage you filmed,
        annotated like a lesson. It's rendered at analysis time, so
        upgrade and re-film to get yours.</p>
        <a href="/pricing">See Pro plans →</a>
      </div>
    </figure>
    {% endif %}
  </div>
  {% endif %}
</article>
{% endfor %}
</section>

{% if not (caddie_brief and caddie_brief.refilm_required) %}
<section class="coaching-followthrough" aria-label="Coaching detail and practice prescription">
{% if praise_notes %}
<section class="strengths-section" aria-label="Strengths to protect">
<p class="section-kicker">Strengths to protect</p>
<h2>What's working</h2>
<div class="praise">
  <strong>Keep these — they're already inside the reference lines.</strong>
  <ul>
    {% for note in praise_notes %}<li>{{ note }}</li>{% endfor %}
</ul>
</div>
</section>
{% endif %}

<section class="priority-detail" aria-label="Priority detail">
<p class="section-kicker">Priority detail</p>
{% if issue_cards %}
<h2>Start here</h2>
<p class="start-lead">Fix one thing at a time. This week:
  <strong>{{ issue_cards[0].display_name }}</strong></p>
{{ issue_card(issue_cards[0], "start-here") }}
{% if issue_cards|length > 1 %}
<details class="more-issues">
  <summary>More to work on later ({{ issue_cards|length - 1 }})</summary>
  <p class="meta">Real, but not this week's job. They'll still be measured on
  every re-film.</p>
  <div class="cards">
    {% for c in issue_cards[1:] %}{{ issue_card(c) }}{% endfor %}
  </div>
</details>
{% endif %}
{% else %}
<h2>What to work on</h2>
{% if limited_baseline %}
<p class="meta">No readable value crossed its line, but this session did not
  produce a complete baseline. Use the focused capture plan below.</p>
{% else %}
<p class="meta">Nothing flagged this session — see the maintenance plan below.</p>
{% endif %}
{% endif %}
</section>

<section class="practice-section" aria-label="Practice prescription">
<p class="section-kicker">Practice prescription</p>
<h2>Practice plan</h2>
{% if flags %}
<p class="meta">Built from what this session flagged. Run the drills for two
weeks, then re-film — the targets below are the pass marks, in the same
numbers as the table above.</p>
{% else %}
{% if limited_baseline %}
<p class="meta">Built only from what this session could read. The next
re-film should complete the baseline before broader maintenance targets
are used.</p>
{% else %}
<p class="meta">Nothing flagged this session. The plan below protects the
baseline.</p>
{% endif %}
{% endif %}
{% for block in practice_plan %}
<div class="plan">
  <h3>{{ block.title }}</h3>
  {% for d in block.drills %}
  <div class="drill">
    <h4 id="drill-{{ d.id }}" tabindex="-1">{{ d.name }}</h4>
    <p class="aim">{{ d.aim }}</p>
    <ol>
      {% for step in d.protocol %}<li>{{ step }}</li>{% endfor %}
    </ol>
    {% if d.id in drill_media %}
    <div class="drill-media">
      <figure aria-label="{{ d.name }} setup diagram">{{ drill_media[d.id].diagram|safe }}<figcaption>Setup</figcaption></figure>
      <details>
        <summary>Show the motion</summary>
        <figure aria-label="{{ d.name }} motion guide">{{ drill_media[d.id].animation|safe }}<figcaption>Loops
        through the drill's key positions; holds the setup pose when your
        device asks for reduced motion.</figcaption></figure>
      </details>
    </div>
    {% endif %}
    {# Success metrics are self-contained sentences that open with their own
       "Re-film…:" lead-in, so the label must not repeat the word (avoids
       "Re-film target: Re-film: …"). The sentence is kept verbatim. #}
    <p class="dose"><strong>Dosage:</strong> {{ d.dosage }}</p>
    <p class="refilm-target"><span class="target-label">Matched follow-up</span>
      <strong>Pass mark</strong> — {{ d.success_metric }}</p>
    {% if d.gear_note %}<p class="gear-note">{{ d.gear_note }}</p>{% endif %}
  </div>
  {% endfor %}
</div>
{% endfor %}
{% if gear_url and caddie_brief and caddie_brief.focus_flag %}
<p class="gear-link">No purchase is required—the drill above is complete as
written. <a href="{{ gear_url }}">Browse optional training aids</a> tagged to
measured coaching issues.</p>
{% endif %}
</section>
</section>
{% endif %}

<aside class="tips" aria-label="Filming tips">
  <strong>Filming tips for best results</strong>
  <ul>
    <li>Phone at hip height, sound on.</li>
    <li>Film face-on (chest toward the camera) — that's the angle every
      number here is measured from. A down-the-line clip gets tempo &amp;
      rhythm only for now.</li>
    <li>Whole body in frame, ball on a tee, and don't trim the clip.</li>
  </ul>
</aside>

<p class="disclaimer" role="note">{{ brand.disclaimer }}</p>
</main>
<footer>{{ brand.footer_text }}</footer>
</body>
</html>
