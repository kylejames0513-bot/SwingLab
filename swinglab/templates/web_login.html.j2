{% extends "web_layout.html.j2" %}
{% block title %}{{ brand.name }} — {% if landing %}Swing analysis from your phone{% elif auth_view == "signup" %}Create a free account{% else %}Sign in{% endif %}{% endblock %}
{% block style %}
  {% if landing %}
  /* The landing page is the one full-bleed surface in the app: the hero runs
     edge to edge and the footer butts straight onto it. */
  main { max-width: none; margin: 0; padding: 0; }
  .sl-app-footer { margin-top: 0; }
  {% else %}
  main { max-width: 620px; margin-top: clamp(40px, 7vw, 76px); }
  {% endif %}
  .landing { background: var(--sl-bg); }

  /* ------------------------------------------------------------------ hero
     The photograph is atmosphere, not the subject — but atmosphere still has
     to be visible. Desaturated and dimmed so the readout beside it stays the
     brightest object on the page, and no further: the previous pass
     (grayscale .72 / brightness .66 under a .72–.94 scrim) measured as solid
     black at both 1440 and 390, which is not atmosphere, it is a 95 KB layer
     nobody can see. Same treatment as
     storefront-theme/sections/hero.liquid gives the identical frame, so a
     visitor crossing from the store lands on the same picture in the same
     key — change one and change the other. */
  .landing-hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: var(--sl-bg);
    color: var(--sl-ink);
    border-bottom: 1px solid var(--sl-border);
  }
  .landing-hero::before,
  .landing-hero::after {
    position: absolute;
    inset: 0;
    pointer-events: none;
    content: "";
  }
  /* The scrim works where the type is, not everywhere: heavy down the left
     edge under the copy column, clearing through the middle and right where
     the golfer and the sunset are. */
  .landing-hero::before {
    z-index: 1;
    background:
      linear-gradient(180deg, rgba(var(--sl-field-rgb), .58) 0%, rgba(var(--sl-field-rgb), .14) 42%, rgba(var(--sl-field-rgb), .82) 100%),
      linear-gradient(90deg, rgba(var(--sl-field-rgb), .93) 0%, rgba(var(--sl-field-rgb), .66) 30%, rgba(var(--sl-field-rgb), .08) 62%, rgba(var(--sl-field-rgb), .2) 100%);
  }
  /* The 8px instrument grid the shell paints under the whole app, continued
     across the photograph so the hero reads as one ruled surface rather than
     as a picture with a panel dropped on it. Brightest at the readout edge. */
  .landing-hero::after {
    z-index: 2;
    opacity: .34;
    background-image:
      linear-gradient(rgba(var(--sl-cream-rgb), .03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(var(--sl-cream-rgb), .03) 1px, transparent 1px);
    background-size: 8px 8px;
    {# A mask reads the alpha channel only, so the opaque stop just means
       "keep" — it is derived from a token rather than written as a literal
       black so this file holds no raw colour at all. #}
    -webkit-mask-image: linear-gradient(90deg, transparent, rgba(var(--sl-cream-rgb), 1) 62%);
    mask-image: linear-gradient(90deg, transparent, rgba(var(--sl-cream-rgb), 1) 62%);
  }
  .landing-hero__backdrop,
  .landing-hero__backdrop picture {
    position: absolute;
    inset: 0;
    margin: 0;
  }
  .landing-hero__image {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    object-position: center;
    filter: grayscale(.22) contrast(1.05) brightness(.94);
  }
  .landing-hero__inner {
    position: relative;
    z-index: 4;
    width: 100%;
    max-width: var(--sl-content);
    margin: 0 auto;
    padding: clamp(64px, 9vw, 116px) var(--sl-pad-x) clamp(56px, 7vw, 92px);
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: center;
    gap: clamp(32px, 5vw, 56px);
  }
  .hero-copy { width: 100%; max-width: 620px; }
  /* The wordmark used to be set as a second headline competing with the H1.
     It is a mono eyebrow now — the instrument states what it is in small
     caps and lets the measurement have the display type. */
  .hero-copy .hero-brand {
    margin: 0 0 clamp(18px, 2vw, 26px);
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--sl-field-soft);
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-xs);
    font-weight: 500;
    letter-spacing: var(--sl-eyebrow-track);
    line-height: 1;
    text-transform: uppercase;
  }
  /* Cyan, because this dot is the "instrument is reading" light. */
  .hero-copy .hero-brand::before {
    width: 7px;
    height: 7px;
    flex: 0 0 auto;
    border-radius: 50%;
    background: var(--sl-trace);
    box-shadow: 0 0 0 4px rgba(var(--sl-trace-rgb), .14);
    content: "";
  }
  .hero-copy h1 {
    max-width: 13ch;
    margin: 0;
    color: var(--sl-field-ink);
    font-family: var(--sl-font-display);
    font-size: var(--sl-heading-display);
    font-weight: 600;
    letter-spacing: -.02em;
    line-height: .98;
    text-transform: uppercase;
    text-wrap: balance;
  }
  .hero-lead {
    max-width: 42ch;
    margin: clamp(18px, 2vw, 24px) 0 0;
    color: var(--sl-field-soft);
    font-size: var(--sl-text-lg);
    line-height: 1.55;
    text-wrap: pretty;
  }
  .hero-ctas {
    width: min(100%, 480px);
    margin: clamp(26px, 3vw, 34px) 0 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--sl-space-3);
  }
  .hero-ctas a.button {
    min-height: 52px;
    margin: 0;
    padding: 14px 22px;
    gap: 10px;
    border-radius: var(--sl-radius-control);
  }
  /* Bone on the field, never amber: amber marks a value the engine measured,
     and a call to action is not one. The shell's base button paints white ink
     on what is now a bone fill, so every button on this page restates its ink
     rather than inheriting an invisible one. */
  .hero-ctas a.button.landing-primary {
    border: 1.5px solid var(--sl-field-ink);
    background: var(--sl-field-ink);
    color: var(--sl-field);
    box-shadow: none;
  }
  /* Hover inverts the fill instead of reaching for a signal colour — both
     signal colours already mean something specific on this page. */
  .hero-ctas a.button.landing-primary:hover {
    border-color: var(--sl-field-ink);
    background: transparent;
    color: var(--sl-field-ink);
    box-shadow: none;
  }
  .landing-primary span { margin-left: 0; transition: transform .2s ease; }
  .hero-ctas a.button.landing-primary:hover span { transform: translateX(4px); }
  .hero-ctas .hero-secondary {
    border: 1.5px solid var(--sl-field-control);
    background: transparent;
    color: var(--sl-field-ink);
    box-shadow: none;
  }
  .hero-ctas .hero-secondary:hover {
    border-color: var(--sl-field-ink);
    background: rgba(var(--sl-cream-rgb), .06);
    color: var(--sl-field-ink);
  }
  .hero-signin-note {
    margin: var(--sl-space-4) 0 0;
    color: var(--sl-field-muted);
    font-size: var(--sl-text-sm);
  }
  .hero-signin-note a { color: var(--sl-field-ink); font-weight: 500; }
  .hero-proof-points {
    margin: clamp(22px, 2.5vw, 28px) 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--sl-space-2) var(--sl-space-5);
    list-style: none;
  }
  .hero-proof-points li {
    position: relative;
    padding-left: 14px;
    color: var(--sl-field-muted);
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-xs);
    font-weight: 500;
    letter-spacing: .12em;
    text-transform: uppercase;
  }
  /* A square tick, not a bullet — the whole surface is ruled, not rounded. */
  .hero-proof-points li::before {
    position: absolute;
    top: .44em;
    left: 0;
    width: 5px;
    height: 5px;
    background: var(--sl-trace);
    content: "";
  }
  .hero-fine {
    max-width: 46ch;
    margin: var(--sl-space-4) 0 0;
    color: var(--sl-field-muted);
    font-size: var(--sl-text-xs);
  }

  /* --------------------------------------------------------- the readout
     The example session, built as an instrument panel: mono head, a ruled
     well for the trace, and a 1px-gap bordered grid of measured values. */
  .hero-signal {
    width: 100%;
    margin: 0;
    padding: clamp(16px, 1.6vw, 22px);
    align-self: stretch;
    border: 1px solid var(--sl-border-strong);
    border-radius: var(--sl-radius-lg);
    background: rgba(var(--sl-night-rgb), .72);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
    box-shadow: var(--sl-shadow-lg);
  }
  .hero-signal__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sl-space-3);
    padding-bottom: var(--sl-space-3);
    border-bottom: 1px solid var(--sl-field-rule);
    color: var(--sl-field-muted);
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-xs);
    font-weight: 500;
    letter-spacing: .14em;
    text-transform: uppercase;
  }
  /* Cyan is the live read and nothing else — this is the one place on the
     page entitled to it besides the trace itself. */
  .hero-signal__ready {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--sl-trace);
  }
  .hero-signal__ready::before {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: currentColor;
    box-shadow: 0 0 0 4px rgba(var(--sl-trace-rgb), .12);
    content: "";
  }
  .hero-trace {
    position: relative;
    margin-top: var(--sl-space-3);
    aspect-ratio: 5 / 4;
    overflow: hidden;
    border: 1px solid var(--sl-field-rule);
    border-radius: var(--sl-radius-sm);
    background:
      linear-gradient(rgba(var(--sl-cream-rgb), .028) 1px, transparent 1px),
      linear-gradient(90deg, rgba(var(--sl-cream-rgb), .028) 1px, transparent 1px),
      var(--sl-night);
    background-size: 16px 16px;
  }
  .hero-trace__line {
    position: absolute;
    left: 17%;
    top: 22%;
    width: 70%;
    height: 92%;
    border-top: 2px solid var(--sl-trace);
    border-radius: 50%;
    opacity: .85;
    transform: rotate(-8deg);
  }
  .hero-trace__dot {
    position: absolute;
    width: 6px;
    height: 6px;
    background: rgba(var(--sl-cream-rgb), .5);
  }
  .hero-trace__dot--one { left: 22%; top: 57%; }
  /* The middle mark is the one the engine called: amber. */
  .hero-trace__dot--two { left: 52%; top: 30%; background: var(--sl-accent); }
  .hero-trace__dot--three { right: 14%; top: 50%; }
  /* 1px-gap bordered grid: the rules between cells are the panel background
     showing through, so the whole block is one ruled instrument face. */
  .hero-signal dl {
    margin: var(--sl-space-4) 0 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1px;
    background: var(--sl-field-rule);
    border: 1px solid var(--sl-field-rule);
  }
  .hero-signal dl > div {
    min-width: 0;
    padding: var(--sl-space-3);
    background: var(--sl-field-lift);
  }
  .hero-signal dt {
    margin: 0 0 6px;
    color: var(--sl-field-muted);
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-xs);
    font-weight: 500;
    letter-spacing: .12em;
    text-transform: uppercase;
  }
  /* These three ARE the readout's values, so they are the amber. */
  .hero-signal dd {
    margin: 0;
    color: var(--sl-accent);
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-sm);
    font-weight: 500;
    line-height: 1.3;
  }
  .hero-signal__note {
    margin: var(--sl-space-3) 0 0;
    color: var(--sl-field-muted);
    font-size: var(--sl-text-xs);
    line-height: 1.5;
  }
  .hero-signal__link { color: var(--sl-field-ink); font-weight: 500; }

  /* ------------------------------------------------------------ the body */
  .landing-body {
    width: 100%;
    max-width: var(--sl-content);
    margin: 0 auto;
    padding: clamp(56px, 8vw, 104px) var(--sl-pad-x);
    display: grid;
    gap: clamp(56px, 8vw, 100px);
  }
  .report-proof {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: center;
    gap: clamp(32px, 6vw, 72px);
  }
  .report-proof__copy h2,
  .landing-section-head h2 {
    margin: 0;
    color: var(--sl-green);
    font-family: var(--sl-font-display);
    font-size: var(--sl-heading-support);
    letter-spacing: -.02em;
    line-height: 1.02;
    text-transform: uppercase;
    text-wrap: balance;
  }
  .report-proof__copy > p:not(.sl-eyebrow),
  .landing-section-head p:last-child {
    max-width: 54ch;
    margin: var(--sl-space-4) 0 0;
    color: var(--sl-ink-soft);
  }
  /* The shell's secondary button is a hairline control, so it takes the
     interactive border token rather than the decorative one (1.33:1 would
     fail WCAG 1.4.11 as a control edge). */
  .report-proof__copy .button.secondary {
    margin-top: var(--sl-space-5);
    min-height: 48px;
    border: 1.5px solid var(--sl-control-border);
    color: var(--sl-ink);
  }
  .report-proof__copy .button.secondary:hover {
    border-color: var(--sl-green-btn);
    background: rgba(var(--sl-cream-rgb), .06);
    color: var(--sl-ink);
  }
  .preview-figure { margin: 0; }
  .preview-shell {
    overflow: hidden;
    background: var(--sl-field-lift);
    border: 1px solid var(--sl-border-strong);
    border-radius: var(--sl-radius-lg);
    box-shadow: var(--sl-shadow-lg);
  }
  .preview-topbar {
    min-height: 44px;
    padding: var(--sl-space-3) var(--sl-space-4);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sl-space-4);
    background: var(--sl-night);
    border-bottom: 1px solid var(--sl-field-rule);
    color: var(--sl-field-muted);
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-xs);
    letter-spacing: .12em;
    text-transform: uppercase;
  }
  /* Registration ticks, not window-chrome buttons. They are decoration, so
     they take neither signal colour. */
  .preview-dots { display: inline-flex; gap: 5px; }
  .preview-dots span {
    width: 5px;
    height: 5px;
    background: rgba(var(--sl-cream-rgb), .22);
  }
  .preview-dots span:first-child { background: rgba(var(--sl-cream-rgb), .45); }
  .preview-media {
    display: block;
    padding: clamp(12px, 2.4vw, 20px);
    background: var(--sl-night);
    text-decoration: none;
  }
  .preview-media:hover { background: var(--sl-bg); }
  .preview-media img {
    width: 100%;
    aspect-ratio: 16 / 8;
    display: block;
    object-fit: contain;
    background: var(--sl-night);
    border: 1px solid var(--sl-field-rule);
    border-radius: var(--sl-radius-sm);
  }
  .preview-read {
    padding: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1px;
    background: var(--sl-field-rule);
    border-top: 1px solid var(--sl-field-rule);
  }
  .preview-read div {
    min-width: 0;
    padding: var(--sl-space-4);
    background: var(--sl-field-lift);
  }
  .preview-read span {
    display: block;
    margin-bottom: 6px;
    color: var(--sl-field-muted);
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-xs);
    font-weight: 500;
    letter-spacing: .12em;
    text-transform: uppercase;
  }
  /* Bone, not amber: these name the report's structure. Nothing here was
     measured. */
  .preview-read strong { color: var(--sl-field-ink); font-size: var(--sl-text-sm); }
  .preview-caption {
    margin: var(--sl-space-3) 0 0;
    color: var(--sl-field-muted);
    font-size: var(--sl-text-xs);
    line-height: 1.5;
  }
  .preview-caption a { font-weight: 500; }
  .landing-section-head { max-width: 690px; }
  .flow-club-note {
    max-width: 690px;
    margin: var(--sl-space-5) 0 0;
    padding: var(--sl-space-3) var(--sl-space-4);
    border: 1px solid var(--sl-border);
    border-left: 2px solid var(--sl-border-strong);
    border-radius: 0 var(--sl-radius-sm) var(--sl-radius-sm) 0;
    background: var(--sl-orange-soft);
    color: var(--sl-ink-soft);
    font-size: var(--sl-text-sm);
  }
  .flow-club-note strong {
    color: var(--sl-ink);
    font-family: var(--sl-font-mono);
    font-weight: 500;
    letter-spacing: .04em;
  }
  .flow-library-link {
    margin: var(--sl-space-5) 0 0;
    color: var(--sl-field-soft);
    font-size: var(--sl-text-sm);
  }
  .flow-library-link a { font-weight: 500; }
  .proof-cycle-strip {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: center;
    gap: clamp(32px, 6vw, 72px);
  }
  .proof-verdict {
    position: relative;
    overflow: hidden;
    padding: clamp(20px, 3vw, 30px);
    background: var(--sl-bg-card);
    border: 1px solid var(--sl-border-strong);
    border-radius: var(--sl-radius-lg);
    box-shadow: var(--sl-shadow-lg);
  }
  /* The dial arc behind the verdict. It is decoration, so it is a hairline
     in the decorative border token — the amber ring it used to be claimed a
     measurement that was not there. */
  .proof-verdict::after {
    content: "";
    position: absolute;
    right: -84px;
    top: -118px;
    width: 240px;
    height: 240px;
    border: 1px solid var(--sl-border);
    border-radius: 50%;
    pointer-events: none;
  }
  .proof-verdict__head {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sl-space-3);
    padding-bottom: var(--sl-space-3);
    border-bottom: 1px solid var(--sl-border);
    color: var(--sl-ink-muted);
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-xs);
    font-weight: 500;
    letter-spacing: .12em;
    text-transform: uppercase;
  }
  /* A pass mark IS a measured result, so the badge is the amber. It takes
     --sl-orange-text rather than --sl-orange: the fill token is the signal at
     display size, and this is nine-pixel-tracked mono on a wash. Naming the
     token instead of its value is deliberate — a comment that quotes a hex
     goes stale the next time the palette moves. */
  .proof-verdict__badge {
    position: relative;
    z-index: 1;
    flex: 0 0 auto;
    padding: 4px 10px;
    border: 1px solid rgba(var(--sl-accent-rgb), .38);
    border-radius: var(--sl-radius-sm);
    background: var(--sl-orange-soft);
    color: var(--sl-orange-text);
    font-weight: 500;
    letter-spacing: .12em;
  }
  .proof-verdict__reading {
    position: relative;
    z-index: 1;
    margin: var(--sl-space-4) 0 0;
    color: var(--sl-orange-text);
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-2xl);
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    letter-spacing: -.01em;
    line-height: 1.18;
  }
  .proof-verdict__detail {
    position: relative;
    z-index: 1;
    margin: var(--sl-space-2) 0 0;
    color: var(--sl-ink-soft);
    font-size: var(--sl-text-sm);
  }
  .proof-verdict__note {
    position: relative;
    z-index: 1;
    margin: var(--sl-space-4) 0 0;
    padding-top: var(--sl-space-3);
    border-top: 1px solid var(--sl-border);
    color: var(--sl-ink-muted);
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-xs);
    line-height: 1.55;
  }
  /* The four steps as one ruled block: 1px gaps filled by the border colour
     rather than four floating cards. */
  .flow-list {
    margin: var(--sl-space-6) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1px;
    align-items: stretch;
    background: var(--sl-border);
    border: 1px solid var(--sl-border);
    list-style: none;
    counter-reset: journey;
  }
  .flow-list li {
    padding: clamp(18px, 2.2vw, 24px);
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--sl-bg-card);
    counter-increment: journey;
  }
  /* The step index is an ordinal, not a measurement — mono, but muted bone.
     Amber here would claim the engine had read something. */
  .flow-list li::before {
    display: block;
    margin-bottom: var(--sl-space-5);
    color: var(--sl-ink-muted);
    content: "0" counter(journey);
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-xs);
    font-weight: 500;
    letter-spacing: .12em;
  }
  .flow-list li:not(:last-child)::after {
    position: absolute;
    top: clamp(18px, 2.2vw, 24px);
    right: clamp(18px, 2.2vw, 24px);
    color: var(--sl-border-strong);
    content: "\2193";
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-sm);
    line-height: 1;
  }
  .flow-list h3 {
    margin: 0;
    color: var(--sl-green);
    font-family: var(--sl-font-display);
    font-size: var(--sl-text-lg);
    letter-spacing: -.01em;
    line-height: 1.15;
  }
  .flow-list p {
    margin: var(--sl-space-3) 0 0;
    color: var(--sl-ink-soft);
    font-size: var(--sl-text-sm);
  }
  /* The scope statement sits in the well — the darkest surface in the
     system — because it is the page's most load-bearing honesty. */
  .scope-panel {
    padding: clamp(24px, 4vw, 44px);
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(24px, 5vw, 56px);
    color: var(--sl-ink);
    background: var(--sl-night);
    border: 1px solid var(--sl-border-strong);
    border-radius: var(--sl-radius-lg);
    box-shadow: var(--sl-shadow-lg);
  }
  .scope-panel h2 {
    margin: 0;
    font-family: var(--sl-font-display);
    font-size: var(--sl-heading-support);
    line-height: 1.02;
    letter-spacing: -.02em;
    text-transform: uppercase;
  }
  .scope-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1px;
    background: var(--sl-border);
    border: 1px solid var(--sl-border);
  }
  .scope-grid div {
    height: 100%;
    padding: var(--sl-space-4);
    background: var(--sl-bg-card);
  }
  .scope-grid h3 {
    margin: 0;
    color: var(--sl-ink);
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-xs);
    font-weight: 500;
    letter-spacing: .12em;
    text-transform: uppercase;
  }
  .scope-grid p {
    margin: var(--sl-space-3) 0 0;
    color: var(--sl-ink-soft);
    font-size: var(--sl-text-sm);
  }

  /* -------------------------------------------------------------- the auth
     Same instrument, one column wide. */
  .auth-shell { max-width: 470px; margin: 0 auto; }
  .auth-shell > h1 {
    color: var(--sl-green);
    font-family: var(--sl-font-display);
    font-size: var(--sl-heading-support);
    line-height: 1.02;
    letter-spacing: -.02em;
    text-transform: uppercase;
    margin: 0 0 var(--sl-space-2);
  }
  .auth-shell .lead { color: var(--sl-ink-soft); margin: 0 0 var(--sl-space-5); }
  label {
    display: block;
    margin: var(--sl-space-4) 0 6px;
    color: var(--sl-ink-muted);
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-xs);
    font-weight: 500;
    letter-spacing: .12em;
    text-transform: uppercase;
  }
  /* Fields are wells cut into the panel. The shell's zero-specificity
     baseline still fills them with a light surface, which after the inversion
     put bone ink on near-white: every input on this page was unreadable until
     this rule restated the fill AND the ink together. Restating only one is
     how that defect happened in the first place. */
  input[type=email], input[type=password], input[type=text] {
    width: 100%; min-height: 48px; padding: 12px 13px;
    border: 1.5px solid var(--sl-control-border); border-radius: var(--sl-radius-control);
    background: var(--sl-night); color: var(--sl-ink); font: inherit;
    box-sizing: border-box; }
  /* Six-digit codes are read back character by character, so they get the
     mono face and real tracking. */
  input[inputmode=numeric] {
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-lg);
    letter-spacing: .34em;
  }
  input:focus {
    border-color: var(--sl-green-btn);
    outline: 2px solid var(--sl-focus-dark);
    outline-offset: 1px;
  }
  /* The shell's button paints white ink on the bone fill — invisible on the
     inverted palette. Dark ink on bone is 15:1. */
  .card button {
    width: 100%;
    border: 1.5px solid var(--sl-green-btn);
    background: var(--sl-green-btn);
    color: var(--sl-green-ink);
    box-shadow: none;
  }
  .card button:hover {
    border-color: var(--sl-green-btn);
    background: transparent;
    color: var(--sl-green-btn);
    box-shadow: none;
  }
  .free-note {
    color: var(--sl-ink-muted);
    font-size: var(--sl-text-sm);
    margin-top: var(--sl-space-4);
    text-align: center;
  }
  .opt {
    display: flex; gap: 10px; align-items: flex-start;
    margin: var(--sl-space-4) 0 0;
    color: var(--sl-ink-soft);
    font-family: var(--sl-font-sans);
    font-size: var(--sl-text-sm);
    font-weight: 400;
    letter-spacing: normal;
    text-transform: none;
  }
  .opt input { width: 20px; height: 20px; margin-top: 2px; flex: 0 0 auto; }
  .notice {
    margin-top: var(--sl-space-5);
    padding: var(--sl-space-3) var(--sl-space-4);
    background: var(--sl-orange-soft);
    border: 1px solid var(--sl-border);
    border-left: 2px solid var(--sl-border-strong);
    border-radius: 0 var(--sl-radius-sm) var(--sl-radius-sm) 0;
    color: var(--sl-ink-soft);
    font-size: var(--sl-text-sm);
  }
  /* An error is the one string a reader most needs to be able to read, so it
     gets a panel of its own rather than a line of loose red text. */
  .auth-shell .error {
    margin: 0 0 var(--sl-space-4);
    padding: var(--sl-space-3) var(--sl-space-4);
    background: var(--sl-bg-card);
    border: 1px solid var(--sl-border-strong);
    border-left: 2px solid var(--sl-danger);
    border-radius: 0 var(--sl-radius-sm) var(--sl-radius-sm) 0;
    color: var(--sl-danger);
    font-size: var(--sl-text-sm);
  }
  .aux-links {
    align-items: center; display: flex; flex-wrap: wrap; gap: var(--sl-space-2) var(--sl-space-4);
    justify-content: center; margin-top: var(--sl-space-4);
  }
  .aux-link {
    color: var(--sl-ink-soft);
    font-size: var(--sl-text-sm);
    text-align: center;
  }
  /* 44px minimum target, and only on the anchors: one .aux-link is a
     paragraph of fallback prose, which must stay a normal wrapping block. */
  a.aux-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
  a.back-home { display: flex; justify-content: center; margin: var(--sl-space-5) auto 0; }
  /* The resend is the secondary action of the pair: hairline, not filled. */
  .resend button {
    background: transparent;
    color: var(--sl-ink);
    border: 1.5px solid var(--sl-control-border);
    margin-top: var(--sl-space-3);
    box-shadow: none;
  }
  .resend button:hover {
    background: rgba(var(--sl-cream-rgb), .06);
    border-color: var(--sl-green-btn);
    color: var(--sl-ink);
  }
  .account-note {
    background: var(--sl-orange-soft);
    border: 1px solid var(--sl-border);
    border-radius: var(--sl-radius-sm);
    color: var(--sl-ink-soft);
    font-size: var(--sl-text-sm);
    margin-top: var(--sl-space-5);
    padding: var(--sl-space-3) var(--sl-space-4);
  }

  @media (min-width: 560px) {
    .flow-list { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .flow-list li:not(:last-child)::after { content: "\2192"; }
    .preview-read,
    .scope-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .hero-ctas { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .hero-signal dl { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  @media (min-width: 1000px) {
    /* Asymmetric on purpose: the copy takes five columns and the readout six,
       so the instrument is still the larger object on the page. It was seven,
       which left the photograph nothing but the gutters. */
    .landing-hero__inner {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      gap: clamp(40px, 4vw, 72px);
      /* Taller than it was (620/74svh/800): object-fit: cover ties the
         golfer's rendered height to the section's, so this is literally a
         bigger swing rather than more padding. */
      min-height: clamp(700px, 88svh, 960px);
    }
    .hero-trace { aspect-ratio: 16 / 11; }
    .report-proof { grid-template-columns: minmax(0, .86fr) minmax(390px, 1.14fr); }
    .proof-cycle-strip { grid-template-columns: minmax(0, 1.05fr) minmax(300px, .95fr); }
    .scope-panel { grid-template-columns: minmax(0, .86fr) minmax(0, 1.14fr); }
    .flow-list { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }
  @media (max-width: 999px) {
    .preview-figure { max-width: 680px; }
    .proof-verdict { max-width: 560px; }
  }
  @media (max-width: 749px) {
    /* The photograph is a portrait crop here and the copy sits on top of it,
       so the wash runs top-to-bottom instead of left-to-right. Every stop sits
       at the legibility boundary and no darker — the scrim is simultaneously
       what makes the type readable and what flattens the golfer back into a
       silhouette, so it eases off wherever nothing reads on top of it (the
       button band, and everything below the signal card). Mirrors
       storefront-theme/sections/hero.liquid; move one, move both. */
    .landing-hero::before {
      background:
        linear-gradient(180deg,
          rgba(var(--sl-field-rgb), .78) 0%,
          rgba(var(--sl-field-rgb), .82) 22%,
          rgba(var(--sl-field-rgb), .72) 36%,
          rgba(var(--sl-field-rgb), .8) 48%,
          rgba(var(--sl-field-rgb), .76) 56%,
          rgba(var(--sl-field-rgb), .42) 72%,
          rgba(var(--sl-field-rgb), .5) 100%);
    }
    .landing-hero::after {
      opacity: .2;
      -webkit-mask-image: linear-gradient(180deg, transparent, rgba(var(--sl-cream-rgb), 1) 58%);
      mask-image: linear-gradient(180deg, transparent, rgba(var(--sl-cream-rgb), 1) 58%);
    }
    /* --sl-ink-muted's AA guarantee is measured against --sl-bg, and below
       this breakpoint the background is a lit dusk sky rather than the flat
       field. One rung up the ink ramp, phone only. */
    .hero-proof-points li,
    .hero-fine { color: var(--sl-field-soft); }
    {# 32% cropped the golfer clean out of frame: he stands right of centre in
       the portrait companion, and the phone box is narrow enough that cover
       shows only about a third of the image width. On the -v2 crop 80% lands
       that window on the golfer, his arc, and the tripod. #}
    .landing-hero__image { object-position: 80% center; }
    .landing-hero__inner { padding-top: clamp(48px, 8vw, 64px); }
    .hero-ctas { width: 100%; }
    .hero-ctas a.button { width: 100%; min-height: 48px; padding: 12px 18px; }
    .hero-proof-points { gap: var(--sl-space-2) var(--sl-space-4); }
  }
  @media (prefers-reduced-motion: reduce) {
    .landing-primary span,
    .hero-ctas a.button.landing-primary:hover span { transition: none; transform: none; }
  }
{% endblock %}
{% block main %}
  {% if landing %}
  <div class="landing">
    <section class="landing-hero" aria-labelledby="landing-title">
      <picture class="landing-hero__backdrop">
        {# The -v2 phone crop (1122x932), not the v1 frame (1122x1402): two
           thirds of v1 was empty sky, and cover crops the WIDTH on a phone, so
           every dead row rendered and the golfer came out a third of the
           height he is now. store-assets/phone_hero_crop.py. width/height are
           declared because the candidates have different aspect ratios. #}
        <source media="(max-width: 749px)" width="1122" height="932"
                srcset="/static/caddieinsight-range-hero-mobile-v2.webp">
        <img class="landing-hero__image" src="/static/caddieinsight-range-hero.webp"
             alt="Golfer completing a driver swing beside a phone on a tripod at a dusk driving range"
             width="1672" height="941" decoding="async" fetchpriority="high">
      </picture>
      <div class="landing-hero__inner">
        <div class="hero-copy">
          <p class="hero-brand">{{ brand.name }}</p>
          <h1 id="landing-title">Practice the move that matters.</h1>
          <p class="hero-lead">Choose the club, film one repeatable view, and get one prioritized coaching plan with a pass mark for your next clip.{% if free_per_month <= 0 %} Your free account includes unlimited full analyses, with no card required.{% endif %}</p>
          <div class="hero-ctas" aria-label="Get started">
            <a class="button landing-primary" href="/signup">Analyze a swing free <span aria-hidden="true">&rarr;</span></a>
            <a class="button hero-secondary" href="/sample-report/">Explore the sample report</a>
          </div>
          <p class="hero-signin-note">Already have an account? <a href="/login">Sign in to continue your coaching loop.</a></p>
          <ul class="hero-proof-points" aria-label="Free-plan proof points">
            <li>{% if free_per_month <= 0 %}Unlimited reports{% else %}{{ free_per_month }} report{% if free_per_month != 1 %}s{% endif %} / month{% endif %}</li>
            <li>No card</li>
            <li>Club saved</li>
          </ul>
          <p class="hero-fine">Supported 2D movement and timing estimates from phone video.</p>
        </div>
        <aside class="hero-signal" aria-label="{{ brand.name }} example analysis">
          <div class="hero-signal__head">
            <span>Example session</span>
            <span class="hero-signal__ready">Plan ready</span>
          </div>
          <div class="hero-trace" role="img" aria-label="Illustrative movement trace for the example session">
            <span class="hero-trace__line" aria-hidden="true"></span>
            <span class="hero-trace__dot hero-trace__dot--one" aria-hidden="true"></span>
            <span class="hero-trace__dot hero-trace__dot--two" aria-hidden="true"></span>
            <span class="hero-trace__dot hero-trace__dot--three" aria-hidden="true"></span>
          </div>
          <dl>
            <div><dt>Selected club</dt><dd>Iron</dd></div>
            <div><dt>Coaching priority</dt><dd>Lead-hip control</dd></div>
            <div><dt>Practice target</dt><dd>One pass mark</dd></div>
          </dl>
          <p class="hero-signal__note">Example interface using demonstration data. <a class="hero-signal__link" href="/sample-report/">Open the full report.</a></p>
        </aside>
      </div>
    </section>

    <div class="landing-body">
      <section class="report-proof" aria-labelledby="preview-title">
        <div class="report-proof__copy">
          <p class="sl-eyebrow">Inside the report</p>
          <h2 id="preview-title">See what your next range session is really for.</h2>
          <p>The complete sample uses the same report engine as a customer session: required club context, one supported priority, and one measured plan for the next clip.</p>
          <a class="button secondary" href="/sample-report/">Open the full sample report</a>
        </div>
        <figure class="preview-figure">
          <div class="preview-shell">
            <div class="preview-topbar">
              <span class="preview-dots" aria-hidden="true"><span></span><span></span><span></span></span>
              <span>Illustrated swing report</span>
            </div>
            <a class="preview-media" href="/sample-report/" aria-label="Open the full illustrated sample report">
              <img src="/sample-report/media/strip_s1.png"
                   alt="Illustrated key-position strip from the {{ brand.name }} sample swing report"
                   width="960" height="480" loading="lazy" decoding="async">
            </a>
            <div class="preview-read" aria-label="Report structure">
              <div><span>Coach</span><strong>One priority first</strong></div>
              <div><span>Practice</span><strong>One plan with a pass mark</strong></div>
            </div>
          </div>
          <figcaption class="preview-caption">Illustrated demonstration report built through the same report engine. It is not a customer result or testimonial.</figcaption>
        </figure>
      </section>

      <section aria-labelledby="journey-title">
        <div class="landing-section-head">
          <p class="sl-eyebrow">The {{ brand.name }} method</p>
          <h2 id="journey-title">Film. Coach. Practice. Prove it.</h2>
          <p>Four deliberate steps turn a phone clip into a range session with one clear job.</p>
        </div>
        <ol class="flow-list" aria-label="Film, Coach, Practice, Re-film">
          <li>
            <h3>Choose the club</h3>
            <p>Select the club before upload. It stays with the report so iron and driver swings are coached in the right context.</p>
          </li>
          <li>
            <h3>Film a repeatable view</h3>
            <p>Record the full body from hip height. Face-on supports movement coaching; down the line supports timing and rhythm only.</p>
          </li>
          <li>
            <h3>Work one plan</h3>
            <p>See one supported priority, a focused drill, and a measurable pass mark instead of disconnected swing tips.</p>
          </li>
          <li>
            <h3>Re-film to prove it</h3>
            <p>Use the same club, handedness, and camera angle so the next clip can test whether the measured pattern changed.</p>
          </li>
        </ol>
        <p class="flow-club-note"><strong>Club-aware coaching:</strong> your driver and your 7-iron get different coaching priorities.</p>
        <p class="flow-library-link">Every drill is free to read before you film anything — <a href="/drills">browse the drill library and the four-week Beginner Path</a>.</p>
      </section>

      <section class="proof-cycle-strip" aria-labelledby="proof-cycle-title">
        <div class="landing-section-head">
          <p class="sl-eyebrow">The Proof Cycle</p>
          <h2 id="proof-cycle-title">Matched re-films, verified — not vibes.</h2>
          <p>Every priority ships with a pass mark. Film again with the same
            club, handedness, and camera angle, and {{ brand.name }} compares
            the matched measurements against their noise floors — a change is
            only called improved after two matched re-films hold it.</p>
        </div>
        <div class="proof-verdict" role="group" aria-label="Example Proof Cycle verdict using demonstration data">
          <div class="proof-verdict__head">
            <span>Proof cycle &middot; Head sway</span>
            <span class="proof-verdict__badge">Improved</span>
          </div>
          <p class="proof-verdict__reading">0.41 &rarr; 0.29 shoulder widths</p>
          <p class="proof-verdict__detail">Held across 2 matched re-films with
            the same club, handedness, and camera angle.</p>
          <p class="proof-verdict__note">Demonstration data — your verdicts are
            measured from your own matched re-films, never invented.</p>
        </div>
      </section>

      <section class="scope-panel" aria-labelledby="scope-title">
        <div>
          <p class="sl-eyebrow">Trust the scope</p>
          <h2 id="scope-title">Useful because it is specific about what it can see.</h2>
        </div>
        <div class="scope-grid">
          <div>
            <h3>Supported measurements</h3>
            <p>Phone-video timing plus 2D body movement in the camera view from supported face-on footage.</p>
          </div>
          <div>
            <h3>Not measured</h3>
            <p>Club path, face angle, attack angle, dynamic loft, launch, spin, carry, strike location, and ball flight.</p>
          </div>
        </div>
      </section>
    </div>
  </div>

  {% else %}
  {% if error %}<div class="auth-shell"><p class="error">{{ error }}</p></div>{% endif %}
  {% if stub_notice %}
  <div class="notice">This email already has a {{ brand.name }} store account —
    <a href="/signup?password=1">create your password</a> to finish setup.
    Everything you've bought is waiting on it.</div>
  {% endif %}
  {% if code_notice %}
  <div class="notice">This account doesn't use a password — it signs in with
    an emailed code. Enter your email below and we'll send one. (You can add
    a password afterwards, from your account page.)</div>
  {% endif %}

  {% if verify_email %}
  <div class="card auth-shell">
    <h1>Check your email</h1>
    <p>This email already has something waiting on it, so we sent a
       6-digit code to <strong>{{ verify_email }}</strong> to confirm
       it's yours. The code expires in 10 minutes.</p>
    <form action="/signup" method="post">
      <input type="hidden" name="signup_intent" value="{{ verify_intent }}">
      <label for="su-code">Verification code</label>
      <input id="su-code" name="code" type="text" inputmode="numeric"
             pattern="[0-9]{6}" maxlength="6" required
             autocomplete="one-time-code" autofocus>
      <button type="submit">Verify and finish setup</button>
    </form>
    <p class="free-note">Nothing arriving? Check spam, or go
      <a href="/signup?password=1">back</a> and sign up again for a fresh code.</p>
  </div>

  {% elif reset_stage == "request" %}
  <div class="card auth-shell">
    <h1>Reset your password</h1>
    <p class="lead">If you previously added a password, we’ll email you a
       verification code. You can always sign in with an email code instead.</p>
    <form action="/reset/request" method="post">
      <label for="rs-email">Email</label>
      <input id="rs-email" name="email" type="email" required autocomplete="email">
      <button type="submit">Email me a code</button>
    </form>
    <a class="aux-link" href="/login">Back to log in</a>
  </div>

  {% elif reset_stage == "confirm" %}
  <div class="card auth-shell">
    <h1>Enter your code</h1>
    <p>If an account exists for <strong>{{ reset_email }}</strong>, a 6-digit
       code is on its way (it expires in 10 minutes).</p>
    <form action="/reset/confirm" method="post">
      <input type="hidden" name="email" value="{{ reset_email }}">
      <label for="rc-code">Verification code</label>
      <input id="rc-code" name="code" type="text" inputmode="numeric"
             pattern="[0-9]{6}" maxlength="6" required
             autocomplete="one-time-code" autofocus>
      <label for="rc-password">New password</label>
      <input id="rc-password" name="password" type="password" required
             minlength="8" autocomplete="new-password">
      <button type="submit">Set new password</button>
    </form>
    <a class="aux-link" href="/reset">Need another code?</a>
  </div>

  {% elif code_email %}
  <div class="card auth-shell">
    <h1>{% if auth_view == "signup" %}Verify your email{% else %}Check your email{% endif %}</h1>
    <p>We sent a six-digit code to <strong>{{ code_email }}</strong>.
       Enter it below — it expires in 10 minutes.{% if auth_view == "signup" %}
       Your free account is created only after the code is verified.{% endif %}</p>
    <form action="/login/code" method="post">
      <input type="hidden" name="email" value="{{ code_email }}">
      <input type="hidden" name="auth_intent" value="{{ auth_view }}">
      <label for="lc-code">Sign-in code</label>
      <input id="lc-code" name="code" type="text" inputmode="numeric"
             pattern="[0-9]{6}" maxlength="6" required
             autocomplete="one-time-code" autofocus>
      <button type="submit">{% if auth_view == "signup" %}Create free account{% else %}Sign in{% endif %}</button>
    </form>
    <form class="resend" action="/login/email" method="post">
      <input type="hidden" name="email" value="{{ code_email }}">
      <input type="hidden" name="auth_intent" value="{{ auth_view }}">
      <button type="submit">Send a new code</button>
    </form>
    <p class="free-note">Nothing arriving? Check spam — a fresh code can go
      out once a minute.</p>
    <div class="aux-links">
      {% if auth_view == "signup" %}
      <a class="aux-link" href="/signup">Use a different email</a>
      {% else %}
      <a class="aux-link" href="/login?password=1">Use your password instead</a>
      <a class="aux-link" href="/reset">Forgot your password?</a>
      {% endif %}
    </div>
  </div>

  {% elif passwordless_login and not show_password %}
  <div class="card auth-shell">
    {% if auth_view == "signup" %}
    <h1>Create your free account</h1>
    <p class="lead">We’ll send a six-digit verification code. Entering it
      creates your {{ brand.name }} account with
      {% if free_per_month <= 0 %}unlimited free analyses{% else %}{{ free_per_month }} free analys{% if free_per_month == 1 %}is{% else %}es{% endif %} every month{% endif %}.</p>
    {% else %}
    <h1>Welcome back</h1>
    <p class="lead">Enter your {{ brand.name }} email and we’ll send a secure
      six-digit sign-in code. No password required.</p>
    {% endif %}
    <form action="/login/email" method="post">
      <input type="hidden" name="auth_intent" value="{{ auth_view }}">
      <label for="ce-email">Email</label>
      <input id="ce-email" name="email" type="email" required
             autocomplete="email" value="{{ prefill_email or '' }}">
      <button type="submit">{% if auth_view == "signup" %}Send my setup code{% else %}Send my sign-in code{% endif %}</button>
    </form>
    {% if auth_view == "signup" %}
    <p class="account-note">This creates a free {{ brand.name }} app account.
      New here after buying Pro? Use your Shopify checkout email. If you
      already have a {{ brand.name }} account, sign in with its current email
      instead.</p>
    <div class="aux-links">
      <a class="aux-link" href="/login">Already have an account? Sign in</a>
      <a class="aux-link" href="/signup?password=1">Create it with a password</a>
    </div>
    {% else %}
    <div class="aux-links">
      {% if shopify_customer_accounts_enabled %}<a class="aux-link" href="/auth/shopify/start">Sign in with Shopify</a>{% endif %}
      <a class="aux-link" href="/login?password=1">Use your password</a>
      <a class="aux-link" href="/reset">Forgot or reset your password?</a>
    </div>
    <p class="free-note">New to {{ brand.name }}?
      <a href="/signup">Create a free account</a>.</p>
    {% endif %}
  </div>

  {% else %}
  <div class="card auth-shell">
    {% if auth_view == "signup" %}
      <h1>Create your free account</h1>
      <p class="lead">{% if free_per_month <= 0 %}Unlimited full analyses{% else %}{{ free_per_month }} full analys{% if free_per_month == 1 %}is{% else %}es{% endif %} every month{% endif %}. No card required.</p>
      <form action="/signup" method="post">
        <label for="su-email">Email</label>
        <input id="su-email" name="email" type="email" required
               autocomplete="email" value="{{ prefill_email or '' }}">
        <label for="su-password">Password</label>
        <input id="su-password" name="password" type="password" required
               minlength="8" autocomplete="new-password">
        <label class="opt"><input type="checkbox" name="digest" value="on">
          Email me one drill a week — your latest session's practice plan,
          weekly. Unsubscribe any time.</label>
        <button type="submit">Sign up free</button>
      </form>
      <div class="aux-links">
        {% if passwordless_login %}<a class="aux-link" href="/signup">Use an email code instead</a>{% endif %}
        <a class="aux-link" href="/login">Already have an account? Sign in</a>
      </div>
    {% else %}
      <h1>Sign in with your password</h1>
      <form action="/login" method="post">
        <label for="li-email">Email</label>
        <input id="li-email" name="email" type="email" required autocomplete="email">
        <label for="li-password">Password</label>
        <input id="li-password" name="password" type="password" required
               autocomplete="current-password">
        <button type="submit">Log in</button>
      </form>
      {% if mail_enabled %}
      <a class="aux-link" href="/reset">Forgot your password?</a>
      {% else %}
      <p class="aux-link">Forgot your password? Password reset requires the
        operator to configure email, and it isn't set up yet —
        {{ brand.support_text or "contact whoever runs this " + brand.name + " instance for help" }}.</p>
      {% endif %}
      {% if passwordless_login %}
      <a class="aux-link" href="/login">Email me a sign-in code instead</a>
      {% endif %}
      {% if shopify_customer_accounts_enabled %}
      <a class="aux-link" href="/auth/shopify/start">Sign in with Shopify</a>
      {% endif %}
      <p class="free-note">New to {{ brand.name }}?
        <a href="/signup">Create a free account</a>.</p>
    {% endif %}
  </div>
  {% endif %}

  <a class="aux-link back-home" href="{{ storefront_url or '/' }}">Back to {{ brand.name }} home</a>
  {% endif %}
  <p class="disclaimer">{{ brand.disclaimer }}</p>
{% endblock %}
