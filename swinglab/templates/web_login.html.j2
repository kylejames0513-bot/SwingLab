{% extends "web_layout.html.j2" %}
{% block title %}{{ brand.name }} — {% if landing %}Swing analysis from your phone{% elif auth_view == "signup" %}Create a free account{% else %}Sign in{% endif %}{% endblock %}
{% block style %}
  main { max-width: 780px; }
  .hero { text-align: center; margin: 0 auto 30px; max-width: 660px; }
  .hero .eyebrow { color: var(--sl-orange); font-family: var(--sl-font-mono);
                   font-size: 0.75rem; font-weight: 500; letter-spacing: .16em;
                   margin: 0 0 12px; text-transform: uppercase; }
  .hero h2 { color: var(--sl-green); font-size: clamp(2rem, 6vw, 3.4rem);
             letter-spacing: -.035em; line-height: 1.04; margin: 0 0 14px; }
  .hero p { color: var(--sl-ink-soft); font-size: 1.05rem; margin: 0 auto; max-width: 590px; }
  .steps { display: flex; gap: 12px; margin: 24px 0 0; flex-wrap: wrap; }
  .steps div { flex: 1 1 150px; background: var(--sl-bg-card); border: 1px solid var(--sl-border);
               border-radius: 12px; padding: 16px; font-size: 0.9rem; color: var(--sl-ink-soft); }
  .steps strong { display: block; color: var(--sl-green); margin-bottom: 4px; }
  .choice-grid { display: grid; gap: 16px; grid-template-columns: repeat(2, minmax(0, 1fr));
                 margin: 28px auto 0; max-width: 700px; }
  .choice { display: flex; flex-direction: column; align-items: flex-start; text-align: left; }
  .choice h3 { color: var(--sl-green); font-size: 1.25rem; margin: 0 0 8px; }
  .choice p { color: var(--sl-ink-soft); margin: 0; }
  .choice .button { margin-top: auto; width: 100%; text-align: center; }
  .choice--primary { border-top: 4px solid var(--sl-orange); }
  .auth-shell { max-width: 470px; margin: 0 auto; }
  .auth-shell h2 { color: var(--sl-green); font-size: 1.8rem; margin: 0 0 8px; }
  .auth-shell .lead { color: var(--sl-ink-soft); margin: 0 0 20px; }
  label { display: block; margin: 12px 0 4px; font-weight: 600; font-size: 0.9rem; }
  input[type=email], input[type=password], input[type=text] {
    width: 100%; padding: 12px 13px; border: 1.5px solid var(--sl-border); border-radius: 8px;
    background: #fff; color: var(--sl-ink); font: inherit;
    box-sizing: border-box; }
  input:focus { border-color: var(--sl-green-btn); outline: 2px solid rgba(26,92,56,.18); }
  .card button { width: 100%; }
  .free-note { color: var(--sl-ink-muted); font-size: 0.86rem; margin-top: 12px; text-align: center; }
  .hero-ctas { margin-top: 16px; }
  .hero-ctas a.button { margin-top: 0; }
  .opt { display: flex; gap: 8px; align-items: flex-start; font-weight: 400;
         font-size: 0.85rem; color: var(--sl-ink-soft); margin: 14px 0 0; }
  .opt input { margin-top: 2px; }
  .notice { background: #e5f3ea; border-left: 4px solid var(--sl-green);
            padding: 12px 16px; border-radius: 4px; margin-top: 20px; }
  .aux-links { align-items: center; display: flex; flex-wrap: wrap; gap: 8px 16px;
               justify-content: center; margin-top: 16px; }
  .aux-link { color: var(--sl-ink-soft); font-size: 0.86rem; text-align: center; }
  .back-home { display: block; margin: 20px auto 0; text-align: center; }
  .resend button { background: white; color: var(--sl-ink); border: 1px solid var(--sl-border);
                   margin-top: 12px; }
  .account-note { background: var(--sl-orange-soft); border-radius: 10px;
                  color: var(--sl-ink-soft); font-size: .88rem; margin-top: 18px;
                  padding: 12px 14px; }
  @media (max-width: 640px) {
    .choice-grid { grid-template-columns: 1fr; }
    .steps { display: none; }
  }
{% endblock %}
{% block main %}
  {% if landing %}
  <div class="hero">
    <p class="eyebrow">Swing analysis from one phone video</p>
    <h2>Make every range session count.</h2>
    <p>Create a free {{ brand.name }} account for {{ free_per_month }} full analys{% if free_per_month == 1 %}is{% else %}es{% endif %} every month,
       or sign in to continue where you left off.</p>
    <div class="steps">
      <div><strong>1. Film</strong> Phone at hip height, face-on (down the line: tempo &amp; rhythm only for now).</div>
      <div><strong>2. Upload</strong> Straight from your camera roll — no editing.</div>
      <div><strong>3. Improve</strong> A full visual report for every swing in the clip.</div>
    </div>
  </div>
  <div class="choice-grid">
    <section class="card choice choice--primary">
      <h3>Create a free account</h3>
      <p>{{ free_per_month }} full swing analys{% if free_per_month == 1 %}is{% else %}es{% endif %} every month — no card required,
         no purchase, and no Shopify account needed.</p>
      <a class="button" href="/signup">Start free</a>
    </section>
    <section class="card choice">
      <h3>Already have an account?</h3>
      <p>Sign in with an emailed code, or use the password you added
         previously.</p>
      <a class="button secondary" href="/login">Sign in</a>
    </section>
  </div>
  <div class="hero-ctas" style="text-align:center">
    <a class="button secondary" href="/sample-report/">See a sample report first</a>
  </div>

  {% else %}
  {% if error %}<div class="auth-shell"><p class="error">{{ error }}</p></div>{% endif %}
  {% if stub_notice %}
  <div class="notice">This email already has a {{ brand.name }} store account —
    <a href="/signup?password=1">create your password</a> to finish setup.
    Everything you've bought is waiting on it.</div>
  {% endif %}
  {% if code_notice %}
  <div class="notice">This account doesn't use a password — it signs in with
    an emailed code. Enter your email below and we'll send one. (You can add
    a password afterwards, from your account page.)</div>
  {% endif %}

  {% if verify_email %}
  <div class="card auth-shell">
    <h2>Check your email</h2>
    <p>This email already has something waiting on it, so we sent a
       6-digit code to <strong>{{ verify_email }}</strong> to confirm
       it's yours. The code expires in 10 minutes.</p>
    <form action="/signup" method="post">
      <input type="hidden" name="signup_intent" value="{{ verify_intent }}">
      <label for="su-code">Verification code</label>
      <input id="su-code" name="code" type="text" inputmode="numeric"
             pattern="[0-9]{6}" maxlength="6" required
             autocomplete="one-time-code" autofocus>
      <button type="submit">Verify and finish setup</button>
    </form>
    <p class="free-note">Nothing arriving? Check spam, or go
      <a href="/signup?password=1">back</a> and sign up again for a fresh code.</p>
  </div>

  {% elif reset_stage == "request" %}
  <div class="card auth-shell">
    <h2>Reset your password</h2>
    <p class="lead">If you previously added a password, we’ll email you a
       verification code. You can always sign in with an email code instead.</p>
    <form action="/reset/request" method="post">
      <label for="rs-email">Email</label>
      <input id="rs-email" name="email" type="email" required autocomplete="email">
      <button type="submit">Email me a code</button>
    </form>
    <a class="aux-link" href="/login">Back to log in</a>
  </div>

  {% elif reset_stage == "confirm" %}
  <div class="card auth-shell">
    <h2>Enter your code</h2>
    <p>If an account exists for <strong>{{ reset_email }}</strong>, a 6-digit
       code is on its way (it expires in 10 minutes).</p>
    <form action="/reset/confirm" method="post">
      <input type="hidden" name="email" value="{{ reset_email }}">
      <label for="rc-code">Verification code</label>
      <input id="rc-code" name="code" type="text" inputmode="numeric"
             pattern="[0-9]{6}" maxlength="6" required
             autocomplete="one-time-code" autofocus>
      <label for="rc-password">New password</label>
      <input id="rc-password" name="password" type="password" required
             minlength="8" autocomplete="new-password">
      <button type="submit">Set new password</button>
    </form>
    <a class="aux-link" href="/reset">Need another code?</a>
  </div>

  {% elif code_email %}
  <div class="card auth-shell">
    <h2>{% if auth_view == "signup" %}Verify your email{% else %}Check your email{% endif %}</h2>
    <p>We sent a six-digit code to <strong>{{ code_email }}</strong>.
       Enter it below — it expires in 10 minutes.{% if auth_view == "signup" %}
       Your free account is created only after the code is verified.{% endif %}</p>
    <form action="/login/code" method="post">
      <input type="hidden" name="email" value="{{ code_email }}">
      <input type="hidden" name="auth_intent" value="{{ auth_view }}">
      <label for="lc-code">Sign-in code</label>
      <input id="lc-code" name="code" type="text" inputmode="numeric"
             pattern="[0-9]{6}" maxlength="6" required
             autocomplete="one-time-code" autofocus>
      <button type="submit">{% if auth_view == "signup" %}Create free account{% else %}Sign in{% endif %}</button>
    </form>
    <form class="resend" action="/login/email" method="post">
      <input type="hidden" name="email" value="{{ code_email }}">
      <input type="hidden" name="auth_intent" value="{{ auth_view }}">
      <button type="submit">Send a new code</button>
    </form>
    <p class="free-note">Nothing arriving? Check spam — a fresh code can go
      out once a minute.</p>
    <div class="aux-links">
      {% if auth_view == "signup" %}
      <a class="aux-link" href="/signup">Use a different email</a>
      {% else %}
      <a class="aux-link" href="/login?password=1">Use your password instead</a>
      <a class="aux-link" href="/reset">Forgot your password?</a>
      {% endif %}
    </div>
  </div>

  {% elif passwordless_login and not show_password %}
  <div class="card auth-shell">
    {% if auth_view == "signup" %}
    <h2>Create your free account</h2>
    <p class="lead">We’ll send a six-digit verification code. Entering it
      creates your {{ brand.name }} account with
      {{ free_per_month }} free analys{% if free_per_month == 1 %}is{% else %}es{% endif %} every month.</p>
    {% else %}
    <h2>Welcome back</h2>
    <p class="lead">Enter your {{ brand.name }} email and we’ll send a secure
      six-digit sign-in code. No password required.</p>
    {% endif %}
    <form action="/login/email" method="post">
      <input type="hidden" name="auth_intent" value="{{ auth_view }}">
      <label for="ce-email">Email</label>
      <input id="ce-email" name="email" type="email" required
             autocomplete="email" value="{{ prefill_email or '' }}">
      <button type="submit">{% if auth_view == "signup" %}Send my setup code{% else %}Send my sign-in code{% endif %}</button>
    </form>
    {% if auth_view == "signup" %}
    <p class="account-note">This creates a free {{ brand.name }} app account.
      New here after buying Pro? Use your Shopify checkout email. If you
      already have a {{ brand.name }} account, sign in with its current email
      instead.</p>
    <div class="aux-links">
      <a class="aux-link" href="/login">Already have an account? Sign in</a>
      <a class="aux-link" href="/signup?password=1">Create it with a password</a>
    </div>
    {% else %}
    <div class="aux-links">
      {% if shopify_customer_accounts_enabled %}<a class="aux-link" href="/auth/shopify/start">Sign in with Shopify</a>{% endif %}
      <a class="aux-link" href="/login?password=1">Use your password</a>
      <a class="aux-link" href="/reset">Forgot or reset your password?</a>
    </div>
    <p class="free-note">New to {{ brand.name }}?
      <a href="/signup">Create a free account</a>.</p>
    {% endif %}
  </div>

  {% else %}
  <div class="card auth-shell">
    {% if auth_view == "signup" %}
      <h2>Create your free account</h2>
      <p class="lead">{{ free_per_month }} full analys{% if free_per_month == 1 %}is{% else %}es{% endif %} every month. No card required.</p>
      <form action="/signup" method="post">
        <label for="su-email">Email</label>
        <input id="su-email" name="email" type="email" required
               autocomplete="email" value="{{ prefill_email or '' }}">
        <label for="su-password">Password</label>
        <input id="su-password" name="password" type="password" required
               minlength="8" autocomplete="new-password">
        <label class="opt"><input type="checkbox" name="digest" value="on">
          Email me one drill a week — your latest session's practice plan,
          weekly. Unsubscribe any time.</label>
        <button type="submit">Sign up free</button>
      </form>
      <div class="aux-links">
        {% if passwordless_login %}<a class="aux-link" href="/signup">Use an email code instead</a>{% endif %}
        <a class="aux-link" href="/login">Already have an account? Sign in</a>
      </div>
    {% else %}
      <h2>Sign in with your password</h2>
      <form action="/login" method="post">
        <label for="li-email">Email</label>
        <input id="li-email" name="email" type="email" required autocomplete="email">
        <label for="li-password">Password</label>
        <input id="li-password" name="password" type="password" required
               autocomplete="current-password">
        <button type="submit">Log in</button>
      </form>
      {% if mail_enabled %}
      <a class="aux-link" href="/reset">Forgot your password?</a>
      {% else %}
      <p class="aux-link">Forgot your password? Password reset requires the
        operator to configure email, and it isn't set up yet —
        {{ brand.support_text or "contact whoever runs this " + brand.name + " instance for help" }}.</p>
      {% endif %}
      {% if passwordless_login %}
      <a class="aux-link" href="/login">Email me a sign-in code instead</a>
      {% endif %}
      {% if shopify_customer_accounts_enabled %}
      <a class="aux-link" href="/auth/shopify/start">Sign in with Shopify</a>
      {% endif %}
      <p class="free-note">New to {{ brand.name }}?
        <a href="/signup">Create a free account</a>.</p>
    {% endif %}
  </div>
  {% endif %}

  <a class="aux-link back-home" href="{{ storefront_url or '/' }}">Back to {{ brand.name }} home</a>
  {% endif %}
  <p class="disclaimer">{{ brand.disclaimer }}</p>
{% endblock %}
