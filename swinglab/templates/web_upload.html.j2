{% extends "web_layout.html.j2" %}
{% block title %}{{ brand.name }} — Analyze your swing{% endblock %}
{% block style %}
  .hero { text-align: center; margin: 0 0 18px; }
  .hero h2 { font-size: 1.7rem; margin: 0 0 6px; }
  .hero p { color: #555; margin: 0 auto; max-width: 470px; }
  .steps { display: flex; gap: 10px; margin: 18px 0 8px; flex-wrap: wrap; }
  .steps div { flex: 1 1 130px; background: white; border: 1px solid #e0e0e0;
               border-radius: 8px; padding: 10px 12px; font-size: 0.85rem;
               color: #444; text-align: left; }
  .steps strong { display: block; color: var(--primary); margin-bottom: 2px; }
  .free-note { text-align: center; color: #666; font-size: 0.85rem;
               margin: 0 0 20px; }
  .hero-ctas { margin-top: 14px; }
  .hero-ctas a.button { margin-top: 0; }
  label { display: block; margin: 16px 0 6px; font-weight: 600; }
  .radio-row { display: flex; flex-direction: column; gap: 6px; margin-top: 4px; }
  .radio-row label { display: flex; gap: 8px; align-items: flex-start;
                     margin: 0; font-weight: 400; }
  .radio-row input { margin-top: 3px; }
  details.advanced { margin-top: 18px; }
  details.advanced > summary { cursor: pointer; color: var(--primary);
                               font-weight: 600; padding: 4px 0; }
  input[type=text], select {
    width: 100%; padding: 10px; border: 1px solid #ccc; border-radius: 6px;
    box-sizing: border-box; background: white; }
  .drop { border: 2px dashed #bbb; border-radius: 8px; padding: 28px 16px;
          text-align: center; color: #555; cursor: pointer; margin-top: 6px;
          transition: border-color 0.15s, background 0.15s; }
  .drop.dragover { border-color: var(--accent); background: #fff7ef; }
  .drop.has-file { border-style: solid; border-color: var(--primary);
                   background: #f2f8f4; color: #1c1c1c; }
  .drop input[type=file] { display: none; }
  .drop .filename { font-weight: 600; }
  .check { display: flex; align-items: flex-start; gap: 10px; margin-top: 16px; }
  .check input { margin-top: 3px; }
  .check label { margin: 0; }
  .tips { background: #eef6f0; border-left: 4px solid var(--primary);
          padding: 12px 16px; border-radius: 4px; margin-top: 28px; }
  .trend-note { background: #fff7ef; border-left: 4px solid var(--accent);
                padding: 10px 14px; border-radius: 4px; font-size: 0.92rem;
                color: #444; }
  #upload-progress { display: none; }
{% endblock %}
{% block main %}
  <div class="hero">
    {% if first_analysis and charged_refilm_attempts %}
    <h2>Your baseline still needs a clear clip.</h2>
    <p>Your first rejected clip did not use an analysis. Later uploads use
      the normal monthly allowance, even when the footage still cannot
      produce trustworthy coaching.</p>
    {% elif first_analysis %}
    <h2>Build your swing baseline.</h2>
    <p>Your first clip gives your caddie something real to coach: one strength,
      one priority, one drill, and a re-film target that tests the change.</p>
    {% else %}
    <h2>Your next coaching check-in.</h2>
    <p>One phone, honest numbers, one clear next step, and a re-film that
      tests whether the matched measurement is moving.</p>
    {% endif %}
    <div class="steps">
      <div><strong>1. Film</strong> Phone at hip height, face-on (down the line: tempo &amp; rhythm only for now).</div>
      <div><strong>2. Upload</strong> Straight off the camera roll — every swing in the clip gets measured.</div>
      <div><strong>3. Retrain</strong> Each flag comes with drills and a number that says when it's fixed.</div>
    </div>
    {% if not user %}
    <div class="hero-ctas">
      <a class="button secondary" href="/sample-report/">See a sample report first</a>
    </div>
    {% endif %}
  </div>
  {% if require_account and (not user or not user.is_pro) %}
  <p class="free-note">{{ free_per_month }} full analys{% if free_per_month == 1 %}is{% else %}es{% endif %} a month, free —
    no card required.</p>
  {% elif user and user.is_pro %}
  {# The just-signed-in store customer's proof their purchase landed —
     without it, nothing on this page says Pro until they find /account. #}
  <p class="free-note"><strong>Pro</strong> is active on this
    account{% if quota_left is none %} — unlimited analyses{% else %} —
    {{ quota_left }} left this month{% endif %}.</p>
  {% endif %}

  {% if first_run %}
  <div class="tips" id="first-run">
    <strong>Your first swing check — three steps</strong>
    <ul>
      <li><strong>Film</strong> a few swings with the
        <a href="#filming-checklist">filming checklist</a> below — phone at
        hip height, face-on, sound on.</li>
      <li><strong>Upload</strong> the clip straight off your camera roll.
        Every strike in it becomes its own analyzed swing.</li>
      <li><strong>Read the "Start here" box first.</strong> Your report
        measures a lot; that box is the one thing worth working on this
        week. Not sure what a report looks like?
        <a href="/sample-report/">See a sample first</a>.</li>
    </ul>
  </div>
  {% endif %}

  <div class="card">
    <h2>Analyze your swing</h2>
    {% if quota_left is defined and quota_left is not none %}
      {% if quota_left > 0 %}
      <p class="hint">{{ quota_left }} analys{{ "es" if quota_left != 1 else "is" }} left
        this month{% if user and not user.is_pro and pro_available %} —
        <a href="/pricing">{% if pro_per_month <= 0 %}go unlimited with Pro{% else %}go Pro for up to {{ pro_per_month }} analyses a month{% endif %}</a>{% endif %}.</p>
      {% if refilm_rejections %}
      <p class="hint">Your first rejected clip this month did not use an
        analysis. Your next upload uses the normal allowance whether it
        produces coaching or needs another re-film.</p>
      {% endif %}
      {% if charged_refilm_attempts %}
      <p class="hint">{{ charged_refilm_attempts }} additional unusable
        re-film{{ "s have" if charged_refilm_attempts != 1 else " has" }}
        counted toward this month's allowance. The first rejected clip did
        not.</p>
      {% endif %}
      {% elif baseline_blocked %}
      <p class="error">Your baseline still needs a clear clip, and this
        month's allowance has been used.</p>
      <p class="hint">The first rejected clip did not use an analysis.
        Every later upload uses the normal allowance, whether it produces
        coaching or needs another re-film. Review the filming checklist,
        then try again after the reset on the 1st{% if user and not user.is_pro and pro_available %}
        or <a href="/pricing">see Pro options</a>{% endif %}.</p>
      {% elif trend_line %}
      {# The conversion moment: their own numbers, never invented ones.
         Only free users reach this branch (trend_line is computed for
         non-Pro users), so "free" is the right label here. #}
      <p class="error">You've used this month's free analys{% if free_per_month == 1 %}is{% else %}es{% endif %}.</p>
      <p class="trend-note">{{ trend_line }}.</p>
      {% if pro_available %}
      <a class="button" href="/pricing">Keep the film rolling —
        {% if pro_per_month <= 0 %}unlimited analyses{% else %}up to
        {{ pro_per_month }} analyses a month{% endif %}</a>
      {% else %}
      <p class="hint">They reset on the 1st.</p>
      {% endif %}
      {% else %}
      {# A Pro account only lands here when the operator capped Pro too
         (billing.pro_per_month > 0) — its allowance isn't "free". #}
      {% if user and user.is_pro %}
      <p class="error">You've used this month's analyses. They reset on
        the 1st.</p>
      {% else %}
      <p class="error">You've used this month's free analys{% if free_per_month == 1 %}is{% else %}es{% endif %}.
        {% if user and not user.is_pro and pro_available %}
        <a href="/pricing">Upgrade to Pro</a> for
        {% if pro_per_month <= 0 %}unlimited swings{% else %}up to
        {{ pro_per_month }} analyses a month{% endif %}, or come back
        on the 1st.{% else %}They reset on the 1st.{% endif %}</p>
      {% endif %}
      {% endif %}
    {% endif %}
    <form id="upload-form" action="/upload" method="post" enctype="multipart/form-data">
      <label for="video">Swing video</label>
      <div class="drop" id="drop" tabindex="0" role="button"
           aria-label="Choose or drop a swing video">
        <input id="video" name="video" type="file"
               accept="video/*,.mov,.mp4,.m4v,.avi,.mkv" required>
        <span id="drop-text">Drop a clip here, or tap to choose one</span>
      </div>
      <p class="hint">.mov, .mp4, .m4v, .avi, or .mkv — straight off your phone is fine{% if max_upload_mb %},
        up to {{ max_upload_mb | int }} MB{% endif %}.</p>

      <label for="hand">Handedness</label>
      <select id="hand" name="hand">
        <option value="right" {% if not golfer_profile or golfer_profile.handedness == 'right' %}selected{% endif %}>Right-handed</option>
        <option value="left" {% if golfer_profile and golfer_profile.handedness == 'left' %}selected{% endif %}>Left-handed</option>
      </select>

      <label>Camera angle</label>
      <div class="radio-row">
        <label><input type="radio" name="angle" value="face-on" {% if not golfer_profile or golfer_profile.camera_angle == 'face-on' %}checked{% endif %} required>
          <span><strong>Face-on</strong> (recommended — full report). Camera
          in front of you, chest toward the lens.</span></label>
        <label><input type="radio" name="angle" value="dtl" {% if golfer_profile and golfer_profile.camera_angle == 'dtl' %}checked{% endif %} required>
          <span><strong>Down the line</strong> — tempo &amp; rhythm only for
          now. Body-drift and angle numbers are measured face-on, so they're
          honestly left out.</span></label>
      </div>

      <label for="club">Club</label>
      <select id="club" name="club" required>
        <option value="" disabled{% if not golfer_profile or not golfer_profile.preferred_club %} selected{% endif %}>Choose a club</option>
        <option value="driver" {% if golfer_profile and golfer_profile.preferred_club == 'driver' %}selected{% endif %}>Driver</option>
        <option value="fairway-wood" {% if golfer_profile and golfer_profile.preferred_club == 'fairway-wood' %}selected{% endif %}>Fairway wood</option>
        <option value="hybrid" {% if golfer_profile and golfer_profile.preferred_club == 'hybrid' %}selected{% endif %}>Hybrid</option>
        <option value="iron" {% if golfer_profile and golfer_profile.preferred_club == 'iron' %}selected{% endif %}>Iron</option>
        <option value="wedge" {% if golfer_profile and golfer_profile.preferred_club == 'wedge' %}selected{% endif %}>Wedge</option>
      </select>
      <p class="hint">Shown on the report and history so sessions compare
        cleanly — it doesn't change any thresholds yet.</p>

      {% if upload_transfer_assignment %}
      <div class="check">
        <input id="transfer-check" name="transfer_check" type="checkbox" value="on">
        <label for="transfer-check"><strong>Normal-swing transfer check</strong> —
          I practiced {{ upload_transfer_assignment.drill_name }} for
          {{ upload_transfer_assignment.target_name }}, and this clip is normal
          swings rather than drill rehearsals.</label>
      </div>
      <p class="hint">CaddieInsight will re-check the same club, handedness,
        and camera angle when you upload. This declaration adds context; it
        never changes the measurement result or proves that practice caused it.</p>
      {% endif %}

      <label>Where's your game? (optional)</label>
      <div class="radio-row">
        {# "Not set" mirrors the club select's blank first option — a radio
           group can't be un-picked, so unset needs its own button. #}
        <label><input type="radio" name="level" value="" {% if not golfer_profile %}checked{% endif %}>
          <span><strong>Not set</strong> — no framing either way.</span></label>
        <label><input type="radio" name="level" value="new" {% if golfer_profile and golfer_profile.experience_mode == 'start' %}checked{% endif %}>
          <span><strong>New to golf</strong> — the report frames benchmarks
          as references to move toward, not day-one targets.</span></label>
        <label><input type="radio" name="level" value="improving" {% if golfer_profile and golfer_profile.experience_mode == 'improve' %}checked{% endif %}>
          <span><strong>Improving</strong> — the standard report
          voice.</span></label>
        <label><input type="radio" name="level" value="experienced" {% if golfer_profile and golfer_profile.experience_mode == 'compete' %}checked{% endif %}>
          <span><strong>Experienced</strong> — benchmarks stated plainly,
          numbers first.</span></label>
      </div>
      <p class="hint">Framing only — the same metrics get measured either
        way, and no threshold moves.</p>

      <details class="advanced">
        <summary>Advanced options</summary>
        <div class="check">
          <input id="fast" name="fast" type="checkbox"{% if first_analysis %} checked{% endif %}>
          <label for="fast">Fast mode — results in a fraction of the time; the
            slow-motion clips are slightly less smooth.</label>
        </div>

        <label for="strikes">Strike times (optional)</label>
        <input id="strikes" name="strikes" type="text" placeholder='e.g. 12.5, 31.0'>
        <p class="hint">Only needed if automatic detection misses — seconds into the video,
          comma separated.</p>
      </details>

      <button id="submit" type="submit">Upload &amp; analyze</button>
      <p class="hint">Most clips take a few minutes to analyze; fast mode is
        usually under a minute. You can leave the page — the link keeps
        working.</p>
      <div id="upload-progress">
        <div class="bar"><div id="upload-bar" style="width: 0%"></div></div>
        <p class="bar-label" id="upload-label">Uploading…</p>
      </div>
      <p class="error" id="upload-error"></p>
    </form>
  </div>

  <div class="tips" id="filming-checklist">
    <strong>Filming checklist — this is what makes the numbers good</strong>
    <ul>
      <li><strong>Sound ON.</strong> Swings are found by the crack of impact —
        a muted clip can't be analyzed.</li>
      <li><strong>Whole body in frame</strong>, head to feet, from setup
        through the finish.</li>
      <li><strong>Phone at hip height</strong>, a few steps back.</li>
      <li><strong>Ball on a tee</strong> (or a clean strike off a mat) so the
        strike is clearly audible.</li>
      <li><strong>Don't trim the clip</strong> — dead time between swings is
        fine, and every strike becomes its own swing.</li>
      <li><strong>Film face-on</strong> for the full report. Down-the-line
        clips get tempo &amp; rhythm only for now.</li>
    </ul>
  </div>

  <p class="disclaimer">{{ brand.disclaimer }}</p>
{% endblock %}
{% block script %}
<script>
(function () {
  var maxMB = {{ max_upload_mb or 0 }};
  var okExt = [".mov", ".mp4", ".m4v", ".avi", ".mkv"];
  var form = document.getElementById("upload-form");
  var drop = document.getElementById("drop");
  var input = document.getElementById("video");
  var dropText = document.getElementById("drop-text");
  var submit = document.getElementById("submit");
  var progress = document.getElementById("upload-progress");
  var bar = document.getElementById("upload-bar");
  var label = document.getElementById("upload-label");
  var errorEl = document.getElementById("upload-error");

  function fmtMB(bytes) { return (bytes / 1048576).toFixed(1) + " MB"; }

  function setError(message) {
    errorEl.textContent = message || "";
    submit.disabled = false;
    progress.style.display = "none";
  }

  function checkFile(file) {
    if (!file) return false;
    var name = file.name.toLowerCase();
    if (!okExt.some(function (ext) { return name.endsWith(ext); })) {
      setError("Unsupported file type — use " + okExt.join(", ") + ".");
      return false;
    }
    if (maxMB && file.size > maxMB * 1048576) {
      setError("That clip is " + fmtMB(file.size) + " — the limit is " + maxMB + " MB. "
        + "Trim it to just the swings and try again.");
      return false;
    }
    setError("");
    return true;
  }

  function showFile(file) {
    drop.classList.add("has-file");
    dropText.innerHTML = "";
    var span = document.createElement("span");
    span.className = "filename";
    span.textContent = file.name;
    dropText.appendChild(span);
    dropText.appendChild(document.createTextNode(" (" + fmtMB(file.size) + ") — tap to change"));
  }

  drop.addEventListener("click", function () { input.click(); });
  drop.addEventListener("keydown", function (e) {
    if (e.key === "Enter" || e.key === " ") { e.preventDefault(); input.click(); }
  });
  input.addEventListener("change", function () {
    if (input.files[0] && checkFile(input.files[0])) showFile(input.files[0]);
  });
  ["dragover", "dragenter"].forEach(function (name) {
    drop.addEventListener(name, function (e) {
      e.preventDefault(); drop.classList.add("dragover");
    });
  });
  ["dragleave", "drop"].forEach(function (name) {
    drop.addEventListener(name, function (e) {
      e.preventDefault(); drop.classList.remove("dragover");
    });
  });
  drop.addEventListener("drop", function (e) {
    if (e.dataTransfer.files.length) {
      input.files = e.dataTransfer.files;
      if (checkFile(input.files[0])) showFile(input.files[0]);
    }
  });

  form.addEventListener("submit", function (e) {
    e.preventDefault();
    var file = input.files[0];
    if (!file) { setError("Choose a swing video first."); return; }
    if (!checkFile(file)) return;
    submit.disabled = true;
    progress.style.display = "block";
    errorEl.textContent = "";

    var xhr = new XMLHttpRequest();
    xhr.open("POST", form.action);
    xhr.setRequestHeader("Accept", "application/json");
    xhr.upload.onprogress = function (ev) {
      if (!ev.lengthComputable) return;
      var pct = Math.round(100 * ev.loaded / ev.total);
      bar.style.width = pct + "%";
      label.textContent = pct < 100
        ? "Uploading… " + pct + "%"
        : "Upload complete — starting analysis…";
    };
    xhr.onerror = function () {
      setError("Upload failed — check your connection and try again.");
    };
    xhr.onload = function () {
      var data = {};
      try { data = JSON.parse(xhr.responseText); } catch (err) {}
      if (xhr.status >= 200 && xhr.status < 300 && data.url) {
        window.location = data.url;
      } else {
        setError(data.detail || "Upload failed (HTTP " + xhr.status + "). Try again.");
      }
    };
    xhr.send(new FormData(form));
  });
})();
</script>
{% endblock %}
