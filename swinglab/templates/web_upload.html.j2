<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ brand.name }} — Analyze your swing</title>
<style>
  :root { --primary: {{ brand.primary_color }}; --accent: {{ brand.accent_color }}; }
  body { font-family: -apple-system, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
         margin: 0; background: #fafafa; color: #1c1c1c; }
  header { background: var(--primary); color: white; padding: 20px 32px; }
  header h1 { margin: 0; font-size: 1.5rem; }
  main { max-width: 640px; margin: 40px auto; padding: 0 24px; }
  .card { background: white; border: 1px solid #e0e0e0; border-radius: 8px; padding: 24px; }
  label { display: block; margin: 16px 0 6px; font-weight: 600; }
  input[type=file], input[type=text], select {
    width: 100%; padding: 10px; border: 1px solid #ccc; border-radius: 6px;
    box-sizing: border-box; background: white; }
  button { margin-top: 20px; background: var(--accent); color: white; border: none;
           padding: 12px 28px; font-size: 1rem; border-radius: 6px; cursor: pointer; }
  button:hover { filter: brightness(1.08); }
  .hint { color: #666; font-size: 0.85rem; margin-top: 4px; }
  .tips { background: #eef6f0; border-left: 4px solid var(--primary);
          padding: 12px 16px; border-radius: 4px; margin-top: 28px; }
  .disclaimer { color: #666; font-style: italic; font-size: 0.85rem; margin-top: 24px; }
  footer { text-align: center; color: #777; font-size: 0.85rem; padding: 24px; }
</style>
</head>
<body>
<header><h1>{{ brand.name }}</h1></header>
<main>
  <div class="card">
    <h2>Analyze your swing</h2>
    <form action="/upload" method="post" enctype="multipart/form-data">
      <label for="video">Swing video</label>
      <input id="video" name="video" type="file" accept="video/*" required>
      <p class="hint">.mov, .mp4, .m4v, .avi, or .mkv — straight off your phone is fine.</p>

      <label for="hand">Handedness</label>
      <select id="hand" name="hand">
        <option value="right" selected>Right-handed</option>
        <option value="left">Left-handed</option>
      </select>

      <label for="strikes">Strike times (optional)</label>
      <input id="strikes" name="strikes" type="text" placeholder='e.g. 12.5, 31.0'>
      <p class="hint">Only needed if automatic detection misses — seconds into the video,
        comma separated.</p>

      <button type="submit">Upload &amp; analyze</button>
    </form>
  </div>

  <div class="tips">
    <strong>Filming tips for best results</strong>
    <ul>
      <li>Phone at hip height.</li>
      <li>Film one clip face-on and one down the line.</li>
      <li>Ball on a tee.</li>
    </ul>
  </div>

  <p class="disclaimer">{{ brand.disclaimer }}</p>
</main>
<footer>{{ brand.footer_text }}</footer>
</body>
</html>
