{% extends "web_layout.html.j2" %}
{% set allowance_spent = quota_left is defined and quota_left is not none and quota_left <= 0 %}
{% set refilm_credit_active = allowance_spent and refilm_credit is defined and refilm_credit and refilm_credit.available %}
{% set allowance_used = allowance_spent and not refilm_credit_active %}
{% block title %}{{ brand.name }} — Analyze your swing{% endblock %}
{% block style %}
  {# ---------------------------------------------------------------- page
     The capture flow is the instrument's INPUT panel: hairline-ruled
     sections, a mono channel index on every field, ruled option rows, and
     one bone action at the end. The only amber text on the page is the
     allowance count, because that is the only number here the engine
     actually measured. #}
  main#MainContent {
    width: 100%;
    max-width: var(--sl-content);
    margin: clamp(24px, 4vw, 42px) auto var(--sl-space-8);
    {# The shell paints under the notch (viewport-fit=cover), so the content
       column re-insets itself instead of trusting the page padding alone. #}
    padding-left: max(var(--sl-pad-x), var(--sl-safe-left));
    padding-right: max(var(--sl-pad-x), var(--sl-safe-right));
  }
  .upload-page {
    {# Native selects, checkboxes and radios draw their own chrome. Without a
       declared scheme the field goes dark but the <select>'s dropdown popup
       stays light — the one surface page CSS cannot reach. #}
    color-scheme: dark;
    color: var(--sl-ink);
  }

  {# ------------------------------------------------------------- masthead
     This was a 24px-radius card with a drop shadow and a decorative ring.
     A drop shadow is invisible on near-black, so separation is now a
     hairline plus the 8px technical grid both surfaces run under
     everything. #}
  .upload-hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--sl-space-5);
    margin-bottom: var(--sl-space-5);
    padding: clamp(24px, 4vw, 40px);
    border: 1px solid var(--sl-border-strong);
    border-radius: var(--sl-radius-lg);
    background:
      radial-gradient(620px 320px at 92% 6%, rgba(var(--sl-accent-rgb), .09), transparent 62%),
      radial-gradient(700px 380px at 2% 0%, rgba(var(--sl-trace-rgb), .06), transparent 58%),
      var(--sl-premium-gradient);
    box-shadow: var(--sl-shadow-sm), var(--sl-shadow-md);
    color: var(--sl-ink);
  }
  {# Replaces the decorative ring with the instrument ruling, masked so it
     builds toward the status readout and never crosses the headline. #}
  .upload-hero::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 0;
    opacity: .55;
    background-image:
      linear-gradient(rgba(var(--sl-cream-rgb), .03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(var(--sl-cream-rgb), .03) 1px, transparent 1px);
    background-size: 8px 8px;
    -webkit-mask-image: linear-gradient(90deg, transparent, rgba(var(--sl-night-rgb), 1) 62%);
    mask-image: linear-gradient(90deg, transparent, rgba(var(--sl-night-rgb), 1) 62%);
    pointer-events: none;
  }
  .upload-hero__copy,
  .upload-status { position: relative; z-index: 1; }
  {# Was --sl-premium-accent, i.e. amber. Amber marks a value the engine
     measured; a section label is not one, so the eyebrow is mono bone-muted
     like every other label on the page. #}
  .upload-eyebrow {
    margin: 0 0 var(--sl-space-3);
    color: var(--sl-ink-muted);
    font-family: var(--sl-font-mono);
    font-size: var(--sl-eyebrow-size);
    font-weight: 500;
    letter-spacing: var(--sl-eyebrow-track);
    line-height: 1;
    text-transform: uppercase;
  }
  .upload-hero h1 {
    max-width: 18ch;
    margin: 0;
    color: var(--sl-ink);
    font-family: var(--sl-font-display);
    font-size: var(--sl-heading-display);
    font-weight: 600;
    letter-spacing: -.02em;
    line-height: .98;
    text-transform: uppercase;
    text-wrap: balance;
  }
  .upload-hero__lede {
    max-width: 46ch;
    margin: var(--sl-space-4) 0 0;
    color: var(--sl-ink-soft);
    font-size: var(--sl-text-lg);
    line-height: 1.55;
    text-wrap: pretty;
  }
  {# 1px-gap bordered grid: the gap IS the rule, so the three steps read as
     three cells of one instrument instead of three floating pills. #}
  .journey {
    margin-top: var(--sl-space-6);
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1px;
    border: 1px solid var(--sl-border);
    background: var(--sl-border);
  }
  .journey span {
    display: flex;
    align-items: center;
    gap: var(--sl-space-3);
    padding: var(--sl-space-3);
    background: var(--sl-bg-card);
    color: var(--sl-ink);
    font-size: var(--sl-text-sm);
    font-weight: 600;
  }
  .journey b {
    color: var(--sl-ink-muted);
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-xs);
    font-weight: 500;
    letter-spacing: .1em;
  }

  {# ------------------------------------------------------------- readout #}
  .upload-status {
    padding: var(--sl-space-4);
    border: 1px solid var(--sl-border-strong);
    border-radius: var(--sl-radius-md);
    background: rgba(var(--sl-night-rgb), .74);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
  }
  .upload-status__label {
    display: flex;
    align-items: center;
    gap: var(--sl-space-2);
    margin: 0 0 var(--sl-space-3);
    padding-bottom: var(--sl-space-3);
    border-bottom: 1px solid var(--sl-border);
    color: var(--sl-ink-muted);
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-xs);
    font-weight: 500;
    letter-spacing: var(--sl-eyebrow-track);
    text-transform: uppercase;
  }
  {# Trace, never amber: this dot reports the machine's live state. It is the
     same signal the shell's banner dot carries. #}
  .upload-status__dot {
    width: 7px;
    height: 7px;
    flex: 0 0 auto;
    border-radius: 50%;
    background: var(--sl-trace);
    box-shadow: 0 0 0 4px rgba(var(--sl-trace-rgb), .14);
  }
  .upload-status strong {
    display: block;
    color: var(--sl-ink);
    font-size: var(--sl-text-lg);
    font-weight: 500;
    line-height: 1.25;
  }
  .upload-status p {
    margin: var(--sl-space-2) 0 0;
    color: var(--sl-ink-soft);
    font-size: var(--sl-text-sm);
  }
  {# The shell already gives links bone plus an underline; overriding the
     colour here (it used to be a hard `white`) would only weaken it. #}
  .upload-status a { font-weight: 500; }

  .upload-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(280px, 340px);
    gap: var(--sl-space-5);
    align-items: start;
  }

  {# ---------------------------------------------------------- input panel #}
  .analysis-card {
    overflow: hidden;
    padding: 0;
    border-radius: var(--sl-radius-lg);
  }
  .analysis-card__head {
    padding: clamp(20px, 3vw, 32px);
    border-bottom: 1px solid var(--sl-border);
    background: rgba(var(--sl-night-rgb), .55);
  }
  .analysis-card__head h2 {
    margin: var(--sl-space-2) 0 var(--sl-space-3);
    color: var(--sl-green);
    font-family: var(--sl-font-display);
    font-size: var(--sl-text-3xl);
    letter-spacing: -.02em;
    text-transform: uppercase;
  }
  .analysis-card__head p:last-child {
    max-width: 62ch;
    margin: 0;
    color: var(--sl-ink-soft);
    font-size: var(--sl-text-sm);
    line-height: 1.6;
  }
  .section-kicker {
    margin: 0;
    color: var(--sl-ink-muted);
    font-family: var(--sl-font-mono);
    font-size: var(--sl-eyebrow-size);
    font-weight: 500;
    letter-spacing: var(--sl-eyebrow-track);
    text-transform: uppercase;
  }

  {# ------------------------------------------------------- allowance meter
     The dark wash callout, and the one panel on this page that reports a
     measured quantity. #}
  .usage-panel {
    margin: 0;
    padding: var(--sl-space-4) clamp(20px, 3vw, 32px);
    border-bottom: 1px solid var(--sl-border);
    background: var(--sl-orange-soft);
  }
  .usage-panel p,
  .usage-panel .hint { margin: 0; }
  .usage-panel p + p { margin-top: var(--sl-space-2); }
  .usage-panel__kicker { margin: 0 0 var(--sl-space-2); }
  .usage-panel .hint { color: var(--sl-ink-soft); font-size: var(--sl-text-sm); }
  {# "3 analyses left" is a count the account meter measured, so it is the
     one string here that earns the signal colour and the mono face. 10.3:1
     on the wash. #}
  .usage-panel .hint strong {
    color: var(--sl-orange-text);
    font-family: var(--sl-font-mono);
    font-weight: 500;
  }
  .usage-panel .error { font-weight: 500; }
  {# The amber rule flags engine-derived content: trend_line is computed from
     the golfer's own sessions, not written by us. #}
  .trend-note {
    padding: var(--sl-space-3);
    border: 1px solid var(--sl-border);
    border-left: 3px solid var(--sl-orange);
    border-radius: 0 var(--sl-radius-sm) var(--sl-radius-sm) 0;
    background: rgba(var(--sl-night-rgb), .6);
    color: var(--sl-ink-soft);
    font-size: var(--sl-text-sm);
  }
  {# The shell still paints main buttons bone-on-`white` — a light-era
     declaration that survived the inversion and renders the label invisible.
     Every action on this page therefore states its own ink. Bone on the
     field with a hairline; amber would claim a measurement. #}
  .usage-panel .button,
  #submit {
    background: var(--sl-green-btn);
    border: 1px solid var(--sl-green-btn);
    color: var(--sl-green-ink);
    box-shadow: var(--sl-shadow-sm);
  }
  .usage-panel .button:hover,
  #submit:hover {
    background: var(--sl-ink-hi);
    border-color: var(--sl-ink-hi);
    color: var(--sl-green-ink);
  }

  #upload-form { padding: 0 clamp(20px, 3vw, 32px) clamp(24px, 3vw, 34px); }
  .flow-section {
    padding: clamp(24px, 3vw, 32px) 0;
    border-bottom: 1px solid var(--sl-border);
  }
  .flow-section:last-of-type { border-bottom: 0; }
  .flow-section__head { margin-bottom: var(--sl-space-5); }
  .flow-section__head h3 {
    margin: var(--sl-space-2) 0 var(--sl-space-1);
    color: var(--sl-green);
    font-family: var(--sl-font-display);
    font-size: var(--sl-text-lg);
    letter-spacing: -.01em;
    text-transform: uppercase;
  }
  .flow-section__head p:last-child {
    margin: 0;
    color: var(--sl-ink-soft);
    font-size: var(--sl-text-sm);
  }
  .field-block + .field-block { margin-top: var(--sl-space-5); }
  .field-label,
  .angle-group legend {
    width: 100%;
    margin: 0 0 var(--sl-space-2);
    padding: 0;
    display: flex;
    align-items: center;
    gap: var(--sl-space-3);
    color: var(--sl-ink);
    font-size: var(--sl-text-base);
    font-weight: 500;
  }
  {# A mono index in a tight box rather than a filled circle: these are
     positions in a sequence, so they should read like channel labels. #}
  .field-number {
    width: 28px;
    height: 28px;
    flex: 0 0 28px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--sl-border-strong);
    border-radius: var(--sl-radius-sm);
    background: var(--sl-night);
    color: var(--sl-ink-soft);
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-xs);
    font-weight: 500;
  }
  {# Was burnt-orange ink on a peach chip — a light-surface pair, and
     amber-adjacent for a flag that marks no measurement at all. Bone-muted
     in a hairline box instead. #}
  .required-badge {
    margin-left: auto;
    padding: 3px var(--sl-space-2);
    border: 1px solid var(--sl-border-strong);
    border-radius: var(--sl-radius-sm);
    background: var(--sl-night);
    color: var(--sl-ink-muted);
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-xs);
    font-weight: 500;
    letter-spacing: .08em;
    text-transform: uppercase;
  }
  {# Bare element selectors on purpose: the shell's control baseline is
     wrapped in :where(), and it still fills every input with opaque white.
     Left alone, this form would show white wells on a near-black field. #}
  input[type=text], select {
    width: 100%;
    min-height: 48px;
    padding: 12px 13px;
    box-sizing: border-box;
    border: 1.5px solid var(--sl-control-border);
    border-radius: var(--sl-radius-control);
    background: var(--sl-night);
    color: var(--sl-ink);
    font: inherit;
  }
  input[type=text]::placeholder { color: var(--sl-ink-muted); }
  input[type=text]:focus,
  select:focus {
    border-color: var(--sl-ink);
    outline: 2px solid var(--sl-focus-dark);
    outline-offset: 2px;
  }
  .club-block {
    padding: var(--sl-space-4);
    border: 1px solid var(--sl-border-strong);
    border-radius: var(--sl-radius-md);
    background: rgba(var(--sl-night-rgb), .6);
  }
  .field-help {
    margin: var(--sl-space-2) 0 0;
    color: var(--sl-ink-soft);
    font-size: var(--sl-text-sm);
    line-height: 1.55;
  }
  .field-help strong { color: var(--sl-ink); }
  .angle-group { min-width: 0; margin: var(--sl-space-5) 0 0; padding: 0; border: 0; }
  {# Ruled option rows: one hairline grid, one cell per choice, no floating
     rounded cards. #}
  .radio-row {
    display: grid;
    gap: 1px;
    margin-top: var(--sl-space-3);
    border: 1px solid var(--sl-border);
    background: var(--sl-border);
  }
  .radio-row label {
    min-height: 48px;
    margin: 0;
    padding: var(--sl-space-3) var(--sl-space-4);
    display: flex;
    gap: var(--sl-space-3);
    align-items: flex-start;
    background: var(--sl-bg-card);
    color: var(--sl-ink-soft);
    font-size: var(--sl-text-sm);
    font-weight: 400;
    line-height: 1.45;
    cursor: pointer;
    transition: background-color .15s ease, box-shadow .15s ease;
  }
  .radio-row label strong { color: var(--sl-ink); font-weight: 500; }
  .radio-row label:hover { background: var(--sl-orange-soft); }
  .radio-row input {
    width: 20px;
    height: 20px;
    flex: 0 0 auto;
    margin: 2px 0 0;
    accent-color: var(--sl-green-btn);
  }
  {# The selected row carries an inset bone rule as well as the wash, so the
     state never rests on colour alone. #}
  .radio-row label:has(input:checked) {
    background: var(--sl-orange-soft);
    box-shadow: inset 3px 0 0 var(--sl-green-btn);
    color: var(--sl-ink);
  }

  {# ---------------------------------------------------------- capture well
     The 16px ruling is the same one the storefront's trace panel uses, so an
     empty target still reads as part of the machine rather than a blank box. #}
  .drop {
    min-height: 150px;
    margin-top: var(--sl-space-3);
    padding: var(--sl-space-6) var(--sl-space-4);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--sl-space-2);
    box-sizing: border-box;
    border: 1.5px dashed var(--sl-control-border);
    border-radius: var(--sl-radius-md);
    background:
      linear-gradient(rgba(var(--sl-cream-rgb), .028) 1px, transparent 1px),
      linear-gradient(90deg, rgba(var(--sl-cream-rgb), .028) 1px, transparent 1px),
      var(--sl-night);
    background-size: 16px 16px, 16px 16px, auto;
    color: var(--sl-ink-soft);
    font-size: var(--sl-text-sm);
    text-align: center;
    cursor: pointer;
    transition: border-color .15s ease, background-color .15s ease, transform .15s ease;
  }
  .drop::before {
    content: "\2191";
    width: 38px;
    height: 38px;
    display: grid;
    place-items: center;
    border: 1px solid var(--sl-control-border);
    border-radius: var(--sl-radius-sm);
    color: var(--sl-ink);
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-lg);
    font-weight: 500;
  }
  {# Every drop state is bone. An amber edge would read as a measurement and
     a trace edge is reserved for the live meter below. #}
  .drop:hover,
  .drop:focus-visible { border-color: var(--sl-ink); color: var(--sl-ink); }
  .drop.dragover {
    border-color: var(--sl-ink);
    background-color: var(--sl-orange-soft);
    transform: translateY(-2px);
  }
  .drop.has-file {
    border-style: solid;
    border-color: var(--sl-ink);
    background-color: var(--sl-orange-soft);
    color: var(--sl-ink);
  }
  .drop input[type=file] { display: none; }
  .drop .filename { color: var(--sl-ink); font-family: var(--sl-font-mono); font-weight: 500; }

  .transfer-option {
    margin-top: var(--sl-space-5);
    padding: var(--sl-space-4);
    border: 1px solid var(--sl-border);
    border-radius: var(--sl-radius-md);
    background: var(--sl-orange-soft);
  }
  .check {
    display: flex;
    align-items: flex-start;
    gap: var(--sl-space-3);
    margin-top: var(--sl-space-4);
  }
  .transfer-option .check { margin-top: 0; }
  {# 20px, not the 13px default: the box is its own target and has to clear
     WCAG 2.2's minimum on a phone. #}
  .check input {
    width: 20px;
    height: 20px;
    flex: 0 0 auto;
    margin-top: 2px;
    accent-color: var(--sl-green-btn);
  }
  .check label {
    margin: 0;
    color: var(--sl-ink-soft);
    font-size: var(--sl-text-sm);
    line-height: 1.5;
  }
  .check label strong { color: var(--sl-ink); }
  details.advanced {
    margin-top: var(--sl-space-5);
    border: 1px solid var(--sl-control-border);
    border-radius: var(--sl-radius-md);
    background: rgba(var(--sl-night-rgb), .55);
  }
  details.advanced > summary {
    min-height: 48px;
    padding: var(--sl-space-3) var(--sl-space-4);
    display: flex;
    align-items: center;
    color: var(--sl-ink);
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-sm);
    font-weight: 500;
    letter-spacing: .08em;
    text-transform: uppercase;
    cursor: pointer;
  }
  details.advanced[open] > summary { border-bottom: 1px solid var(--sl-border); }
  .advanced__body { padding: var(--sl-space-1) var(--sl-space-4) var(--sl-space-5); }
  .advanced__body > label {
    display: block;
    margin: var(--sl-space-5) 0 var(--sl-space-2);
    color: var(--sl-ink);
    font-weight: 500;
  }

  {# ------------------------------------------------------------- the action #}
  .submit-zone { padding-top: var(--sl-space-6); }
  #submit {
    width: 100%;
    min-height: 54px;
    margin: 0;
    border-radius: var(--sl-radius-control);
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-sm);
    font-weight: 500;
    letter-spacing: .1em;
    text-transform: uppercase;
  }
  {# The shell disables buttons to a mid-grey fill on the same mid-grey edge
     — a light-era value that is far brighter than the field and therefore
     reads as ENABLED here. A blocked action is an empty outline instead. #}
  #submit:disabled,
  #submit:disabled:hover {
    background: transparent;
    border-color: var(--sl-control-border);
    color: var(--sl-ink-muted);
    box-shadow: none;
    transform: none;
    cursor: not-allowed;
  }
  .submit-note {
    margin: var(--sl-space-3) 0 0;
    color: var(--sl-ink-muted);
    font-size: var(--sl-text-sm);
    text-align: center;
  }
  #upload-progress { display: none; margin-top: var(--sl-space-4); }
  {# The live meter. Trace, because upload progress is the one thing on this
     page that is a live readout of the machine working — the shell's default
     fill is var(--accent), which is brand-configured and could be anything. #}
  #upload-progress .bar {
    height: 10px;
    margin: var(--sl-space-3) 0 var(--sl-space-2);
    overflow: hidden;
    border: 1px solid var(--sl-border-strong);
    border-radius: var(--sl-radius-sm);
    background: var(--sl-night);
  }
  #upload-progress .bar > div {
    height: 100%;
    min-width: 4px;
    border-radius: 0;
    background: var(--sl-trace);
    transition: width .4s ease;
  }
  #upload-progress .bar-label {
    margin: 0;
    color: var(--sl-trace-dim);
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-xs);
    font-weight: 500;
    letter-spacing: .08em;
    text-transform: uppercase;
  }
  #upload-error:empty { display: none; }
  {# The error keeps the shell's --sl-danger ink (7.62:1) and gains a well so
     a failed upload is a panel, not a stray red line. #}
  #upload-error {
    margin: var(--sl-space-4) 0 0;
    padding: var(--sl-space-3);
    border: 1px solid var(--sl-border);
    border-left: 3px solid var(--sl-danger);
    border-radius: 0 var(--sl-radius-sm) var(--sl-radius-sm) 0;
    background: rgba(var(--sl-night-rgb), .6);
    font-size: var(--sl-text-sm);
  }

  {# --------------------------------------------------------- reference rail #}
  .upload-sidebar { display: grid; gap: var(--sl-space-4); }
  .sidebar-card {
    padding: var(--sl-space-5);
    border: 1px solid var(--sl-border);
    border-radius: var(--sl-radius-lg);
    background: var(--sl-bg-card);
    box-shadow: var(--sl-shadow-sm);
  }
  .sidebar-card h2,
  .sidebar-card h3 {
    margin: var(--sl-space-2) 0 var(--sl-space-3);
    color: var(--sl-green);
    font-family: var(--sl-font-display);
    font-size: var(--sl-text-lg);
    letter-spacing: -.01em;
    text-transform: uppercase;
  }
  .sidebar-card p {
    margin: 0;
    color: var(--sl-ink-soft);
    font-size: var(--sl-text-sm);
    line-height: 1.55;
  }
  .sidebar-card ul {
    margin: var(--sl-space-4) 0 0;
    padding-left: var(--sl-space-4);
    color: var(--sl-ink-soft);
    font-size: var(--sl-text-sm);
  }
  .sidebar-card li { padding-left: 3px; line-height: 1.5; }
  .sidebar-card li + li { margin-top: var(--sl-space-3); }
  .sidebar-card strong { color: var(--sl-ink); }
  {# Ruled rows, not a dashed list: the checklist is a procedure, and each
     step gets its own hairline-separated line. #}
  .sidebar-card .checklist {
    margin: var(--sl-space-4) 0 0;
    padding: 0;
    list-style: none;
    counter-reset: filmstep;
    border-top: 1px solid var(--sl-border);
  }
  .sidebar-card .checklist li {
    position: relative;
    margin: 0;
    padding: var(--sl-space-3) 0 var(--sl-space-3) 34px;
    border-bottom: 1px solid var(--sl-border);
    color: var(--sl-ink-soft);
    font-size: var(--sl-text-sm);
    line-height: 1.5;
    counter-increment: filmstep;
  }
  .sidebar-card .checklist li + li { margin-top: 0; }
  {# These counters were amber. They are step numbers, not measurements, so
     they drop to mono bone-muted with the rest of the index type. #}
  .sidebar-card .checklist li::before {
    content: "0" counter(filmstep);
    position: absolute;
    left: 0;
    top: var(--sl-space-3);
    color: var(--sl-ink-muted);
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-xs);
    font-weight: 500;
    letter-spacing: .08em;
  }
  {# "--dark" meant a green fill on a light page. On the field the equivalent
     emphasis is depth: the well surface behind a stronger edge. #}
  .sidebar-card--dark {
    border-color: var(--sl-border-strong);
    background: var(--sl-night);
  }
  .sidebar-card--dark .section-kicker { color: var(--sl-ink-muted); }
  .sidebar-card--dark h3 { color: var(--sl-ink); }
  .sidebar-card--dark p,
  .sidebar-card--dark ul { color: var(--sl-ink-soft); }
  .sidebar-card--dark strong { color: var(--sl-ink); }

  .first-run {
    margin: 0 0 var(--sl-space-5);
    padding: var(--sl-space-4);
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--sl-space-3);
    align-items: start;
    border: 1px solid var(--sl-border-strong);
    border-radius: var(--sl-radius-md);
    background: var(--sl-orange-soft);
  }
  .first-run__mark {
    width: 32px;
    height: 32px;
    display: grid;
    place-items: center;
    border: 1px solid var(--sl-border-strong);
    border-radius: var(--sl-radius-sm);
    background: var(--sl-night);
    color: var(--sl-ink-soft);
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-xs);
    font-weight: 500;
  }
  .first-run strong { color: var(--sl-ink); }
  .first-run p {
    margin: var(--sl-space-1) 0 0;
    color: var(--sl-ink-soft);
    font-size: var(--sl-text-sm);
    line-height: 1.5;
  }
  .disclaimer { max-width: 76ch; margin: var(--sl-space-6) auto 0; text-align: center; }

  @media (min-width: 560px) {
    .journey { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  @media (min-width: 1000px) {
    .upload-hero {
      grid-template-columns: minmax(0, 1fr) minmax(240px, 300px);
      gap: clamp(32px, 5vw, 72px);
      align-items: end;
      padding: clamp(32px, 4vw, 52px);
    }
    {# The reference rail follows the form down a long page. #}
    .upload-sidebar { position: sticky; top: 88px; }
  }
  {# 900px is not one of the system's stops, but tests/test_premium_upload.py
     pins this query and the single-column rule inside it — and it is the
     honest number: a form plus a 340px reference column is exactly what
     stops fitting here. #}
  @media (max-width: 900px) {
    .upload-layout { grid-template-columns: 1fr; }
  }
  @media (max-width: 999px) {
    main#MainContent { margin-top: var(--sl-space-5); }
    .upload-status { max-width: 420px; }
  }
  @media (max-width: 749px) {
    main#MainContent { margin-top: var(--sl-space-4); }
    .upload-hero { padding: var(--sl-space-5) var(--sl-space-4); }
    .analysis-card__head,
    .usage-panel,
    #upload-form { padding-inline: var(--sl-space-4); }
    .club-block { padding: var(--sl-space-3); }
    .sidebar-card { padding: var(--sl-space-4); }
  }
  @media (prefers-reduced-motion: reduce) {
    .drop,
    .radio-row label,
    #upload-progress .bar > div { transition: none; }
    .drop.dragover { transform: none; }
    .bar > div { transition: none; }
  }
{% endblock %}
{% block main %}
  <div class="upload-page">
    <section class="upload-hero" aria-labelledby="upload-title">
      <div class="upload-hero__copy">
        <p class="upload-eyebrow">Club-aware swing analysis</p>
        {% if first_analysis and charged_refilm_attempts %}
        <h1 id="upload-title">Your baseline still needs a clear clip.</h1>
        <p class="upload-hero__lede">Your first rejected clip did not use an
          analysis. Later uploads use the normal monthly allowance, even when
          the footage still cannot produce trustworthy coaching.</p>
        {% elif first_analysis %}
        <h1 id="upload-title">Build your swing baseline.</h1>
        <p class="upload-hero__lede">Your first clip gives your caddie
          something real to coach: one strength, one priority, one drill, and
          a re-film target that tests the change.</p>
        {% else %}
        <h1 id="upload-title">Your next coaching check-in.</h1>
        <p class="upload-hero__lede">One phone, honest numbers, one clear next
          step, and a re-film that tests whether the matched measurement is
          moving.</p>
        {% endif %}
        <div class="journey" aria-label="Analysis journey">
          <span><b>01</b> Set club and setup</span>
          <span><b>02</b> Add your clip</span>
          <span><b>03</b> Get one clear priority</span>
        </div>
      </div>
      <aside class="upload-status" aria-label="Account analysis status">
        <p class="upload-status__label"><span class="upload-status__dot" aria-hidden="true"></span> {{ "Allowance used" if allowance_used else ("Matched re-film free" if refilm_credit_active else "Ready to analyze") }}</p>
        {% if allowance_used %}
        <strong>No analyses left this month</strong>
        <p>Your allowance resets on the 1st.</p>
        {% elif refilm_credit_active %}
        <strong>Your matched re-film is free this month</strong>
        <p>Same club, same view: {{ refilm_credit.label }}.</p>
        {% elif require_account and (not user or not user.is_pro) %}
        <strong>{% if free_per_month <= 0 %}Unlimited full analyses{% else %}{{ free_per_month }} full analys{% if free_per_month == 1 %}is{% else %}es{% endif %} each month{% endif %}</strong>
        <p>Free, no card required.</p>
        {% elif user and user.is_pro %}
        <strong>Pro is active</strong>
        <p>{% if quota_left is none %}Unlimited analyses on this account.{% else %}{{ quota_left }} left this month.{% endif %}</p>
        {% else %}
        <strong>Your swing, in context</strong>
        <p>Choose the club and camera setup before adding a clip.</p>
        {% endif %}
        {% if not user %}
        <p><a href="/sample-report/">See a sample report first</a></p>
        {% endif %}
      </aside>
    </section>

    {% if first_run %}
    <aside class="first-run" id="first-run">
      <span class="first-run__mark" aria-hidden="true">1</span>
      <div>
        <strong>Your first swing check</strong>
        <p>Use the <a href="#filming-checklist">filming checklist</a>, upload
          straight from your camera roll, then start with the single priority
          at the top of your report. <a href="/sample-report/">See a sample first</a>.</p>
      </div>
    </aside>
    {% endif %}

    <div class="upload-layout">
      <section class="card analysis-card" aria-labelledby="analysis-heading">
        <header class="analysis-card__head">
          <p class="section-kicker">New analysis</p>
          <h2 id="analysis-heading">Analyze your swing</h2>
          <p>Set the golf context first, then add the clip. That keeps the
            coaching recommendation and your future comparisons grounded in
            the swing you actually filmed.</p>
        </header>

        {% if quota_left is defined and quota_left is not none %}
        <div class="usage-panel" role="status">
          <p class="section-kicker usage-panel__kicker">Monthly allowance</p>
          {% if quota_left > 0 %}
          <p class="hint"><strong>{{ quota_left }} analys{{ "es" if quota_left != 1 else "is" }} left</strong>
            this month{% if user and not user.is_pro and pro_available %} —
            <a href="/pricing">{% if pro_per_month <= 0 %}go unlimited with Pro{% else %}go Pro for up to {{ pro_per_month }} analyses a month{% endif %}</a>{% endif %}.</p>
          {% if refilm_rejections %}
          <p class="hint">Your first rejected clip this month did not use an
            analysis. Your next upload uses the normal allowance whether it
            produces coaching or needs another re-film.</p>
          {% endif %}
          {% if charged_refilm_attempts %}
          <p class="hint">{{ charged_refilm_attempts }} additional unusable
            re-film{{ "s have" if charged_refilm_attempts != 1 else " has" }}
            counted toward this month's allowance. The first rejected clip did
            not.</p>
          {% endif %}
          {% elif refilm_credit_active %}
          <p class="hint"><strong>Your matched re-film is free this month</strong>
            — same club, same view.</p>
          <p class="hint">You've used this month's allowance, but the proof
            loop stays open: film {{ refilm_credit.label }} to match your
            coaching-ready baseline and this upload consumes nothing. A
            different club, handedness, or camera angle would need the normal
            allowance, so only the matched re-film goes through.</p>
          {% elif baseline_blocked %}
          <p class="error">Your baseline still needs a clear clip, and this
            month's allowance has been used.</p>
          <p class="hint">The first rejected clip did not use an analysis.
            Every later upload uses the normal allowance, whether it produces
            coaching or needs another re-film. Review the filming checklist,
            then try again after the reset on the 1st{% if user and not user.is_pro and pro_available %}
            or <a href="/pricing">see Pro options</a>{% endif %}.</p>
          {% elif trend_line %}
          {# This line is computed from the golfer's own sessions. #}
          <p class="error">You've used this month's free analys{% if free_per_month == 1 %}is{% else %}es{% endif %}.</p>
          <p class="trend-note">{{ trend_line }}.</p>
          {% if pro_available %}
          <a class="button" href="/pricing">Keep the film rolling —
            {% if pro_per_month <= 0 %}unlimited analyses{% else %}up to
            {{ pro_per_month }} analyses a month{% endif %}</a>
          {% else %}
          <p class="hint">They reset on the 1st.</p>
          {% endif %}
          {% else %}
          {% if user and user.is_pro %}
          <p class="error">You've used this month's analyses. They reset on
            the 1st.</p>
          {% else %}
          <p class="error">You've used this month's free analys{% if free_per_month == 1 %}is{% else %}es{% endif %}.
            {% if user and not user.is_pro and pro_available %}
            <a href="/pricing">Upgrade to Pro</a> for
            {% if pro_per_month <= 0 %}unlimited swings{% else %}up to
            {{ pro_per_month }} analyses a month{% endif %}, or come back
            on the 1st.{% else %}They reset on the 1st.{% endif %}</p>
          {% endif %}
          {% endif %}
          {% if pending_pass_mark %}
          {# The golfer's own re-film target, straight from their last
             coaching session — never a generic upgrade line. #}
          <p class="hint">Your pending pass mark is still waiting:
            {{ pending_pass_mark }}
            {% if user and not user.is_pro and pro_available %}<a href="/pricing">Go
            Pro</a> to film the proof now, or test it after the reset on
            the 1st.{% else %}Test it after the reset on the 1st.{% endif %}</p>
          {% endif %}
        </div>
        {% endif %}

        <form id="upload-form" action="/upload" method="post" enctype="multipart/form-data">
          <section class="flow-section" aria-labelledby="context-heading">
            <header class="flow-section__head">
              <p class="section-kicker">First · Swing context</p>
              <h3 id="context-heading">Tell us what you filmed</h3>
              <p>These three choices establish the right coaching and comparison context.</p>
            </header>

            <div class="field-block club-block">
              <label class="field-label" for="club">
                <span class="field-number" aria-hidden="true">1</span>
                Golf club
                <span class="required-badge">Required</span>
              </label>
              <select id="club" name="club" required>
                <option value="" disabled{% if not golfer_profile or not golfer_profile.preferred_club %} selected{% endif %}>Choose a club</option>
                <option value="driver" {% if golfer_profile and golfer_profile.preferred_club == 'driver' %}selected{% endif %}>Driver</option>
                <option value="fairway-wood" {% if golfer_profile and golfer_profile.preferred_club == 'fairway-wood' %}selected{% endif %}>Fairway wood</option>
                <option value="hybrid" {% if golfer_profile and golfer_profile.preferred_club == 'hybrid' %}selected{% endif %}>Hybrid</option>
                <option value="iron" {% if golfer_profile and golfer_profile.preferred_club == 'iron' %}selected{% endif %}>Iron</option>
                <option value="wedge" {% if golfer_profile and golfer_profile.preferred_club == 'wedge' %}selected{% endif %}>Wedge</option>
              </select>
              <p class="field-help" id="club-help"><strong>Golf club is required</strong>
                because coaching recommendations depend on the club you choose.
                It also keeps history and re-films comparable.</p>
            </div>

            <div class="field-block">
              <label class="field-label" for="hand">
                <span class="field-number" aria-hidden="true">2</span>
                Handedness
              </label>
              <select id="hand" name="hand">
                <option value="right" {% if not golfer_profile or golfer_profile.handedness == 'right' %}selected{% endif %}>Right-handed</option>
                <option value="left" {% if golfer_profile and golfer_profile.handedness == 'left' %}selected{% endif %}>Left-handed</option>
              </select>
            </div>

            <fieldset class="angle-group">
              <legend>
                <span class="field-number" aria-hidden="true">3</span>
                Camera angle
              </legend>
              <div class="radio-row">
                <label><input type="radio" name="angle" value="face-on" {% if not golfer_profile or golfer_profile.camera_angle == 'face-on' %}checked{% endif %} required>
                  <span><strong>Face-on</strong> (recommended — full report).
                    Camera in front of you, chest toward the lens.</span></label>
                <label><input type="radio" name="angle" value="dtl" {% if golfer_profile and golfer_profile.camera_angle == 'dtl' %}checked{% endif %} required>
                  <span><strong>Down the line</strong> — tempo &amp; rhythm only
                    for now. Body-drift and angle numbers are measured face-on,
                    so they're honestly left out.</span></label>
              </div>
            </fieldset>
          </section>

          <section class="flow-section" aria-labelledby="video-heading">
            <header class="flow-section__head">
              <p class="section-kicker">Next · Video</p>
              <h3 id="video-heading">Add your swing clip</h3>
              <p>Use the original camera file when possible and keep every swing in frame.</p>
            </header>
            <label class="field-label" for="video">
              <span class="field-number" aria-hidden="true">4</span>
              Swing video
              <span class="required-badge">Required</span>
            </label>
            <div class="drop" id="drop" tabindex="0" role="button"
                 aria-label="Choose or drop a swing video" aria-describedby="video-help">
              <input id="video" name="video" type="file"
                     accept="video/*,.mov,.mp4,.m4v,.avi,.mkv" required>
              <span id="drop-text">Drop a clip here, or tap to choose one</span>
            </div>
            <p class="field-help" id="video-help">.mov, .mp4, .m4v, .avi, or
              .mkv — straight off your phone is fine{% if max_upload_mb %}, up to
              {{ max_upload_mb | int }} MB{% endif %}.</p>

            {% if user and mail_enabled %}
            <div class="check">
              <input id="notify" name="notify" type="checkbox" value="on" checked>
              <label for="notify"><strong>Email me when my coaching is ready</strong>
                — one email for this clip when the analysis finishes (or needs
                another attempt), sent to {{ user.email }}. Nothing else joins it.</label>
            </div>
            {% endif %}

            {% if upload_transfer_assignment %}
            <div class="transfer-option">
              <div class="check">
                <input id="transfer-check" name="transfer_check" type="checkbox" value="on">
                <label for="transfer-check"><strong>Normal-swing transfer check</strong> —
                  I practiced {{ upload_transfer_assignment.drill_name }} for
                  {{ upload_transfer_assignment.target_name }}, and this clip is
                  normal swings rather than drill rehearsals.</label>
              </div>
              <p class="field-help">CaddieInsight will re-check the same club,
                handedness, and camera angle when you upload. This declaration
                adds context; it never changes the measurement result or proves
                that practice caused it.</p>
            </div>
            {% endif %}

            <details class="advanced">
              <summary>Advanced options</summary>
              <div class="advanced__body">
                <fieldset class="angle-group">
                  <legend>Where's your game? (optional)</legend>
                  <div class="radio-row">
                    {# An explicit blank keeps this optional radio group reversible. #}
                    <label><input type="radio" name="level" value="" {% if not golfer_profile %}checked{% endif %}>
                      <span><strong>Not set</strong> — no framing either way.</span></label>
                    <label><input type="radio" name="level" value="new" {% if golfer_profile and golfer_profile.experience_mode == 'start' %}checked{% endif %}>
                      <span><strong>New to golf</strong> — the report frames
                        benchmarks as references to move toward, not day-one targets.</span></label>
                    <label><input type="radio" name="level" value="improving" {% if golfer_profile and golfer_profile.experience_mode == 'improve' %}checked{% endif %}>
                      <span><strong>Improving</strong> — the standard report voice.</span></label>
                    <label><input type="radio" name="level" value="experienced" {% if golfer_profile and golfer_profile.experience_mode == 'compete' %}checked{% endif %}>
                      <span><strong>Experienced</strong> — benchmarks stated
                        plainly, numbers first.</span></label>
                  </div>
                </fieldset>
                <p class="field-help">Framing only — the same metrics get
                  measured either way, and no threshold moves.</p>

                <div class="check">
                  <input id="fast" name="fast" type="checkbox"{% if first_analysis %} checked{% endif %}>
                  <label for="fast"><strong>Fast mode</strong> — prioritizes
                    quicker processing; slow-motion clips may look less smooth.</label>
                </div>

                <label for="strikes">Strike times (optional)</label>
                <input id="strikes" name="strikes" type="text" placeholder='e.g. 12.5, 31.0'>
                <p class="field-help">Only needed if automatic detection misses —
                  seconds into the video, comma separated.</p>
              </div>
            </details>
          </section>

          <div class="submit-zone">
            <button id="submit" type="submit"{% if allowance_used %} disabled aria-disabled="true" aria-describedby="allowance-blocked-note"{% endif %}>{{ "Allowance used" if allowance_used else "Upload & analyze" }}</button>
            {% if allowance_used %}
            <p class="hint submit-note" id="allowance-blocked-note">A new upload cannot start until your allowance resets on the 1st{% if user and not user.is_pro and pro_available %}, or <a href="/pricing">you activate Pro</a>{% endif %}.</p>
            {% else %}
            {% if refilm_credit_active %}
            <p class="hint submit-note">This upload is your free matched
              re-film — {{ refilm_credit.label }}, and it consumes no
              allowance.</p>
            {% endif %}
            <p class="hint submit-note">Analysis time varies with clip length.
              You can leave the page while it runs — the result link keeps working.</p>
            {% endif %}
            <div id="upload-progress" aria-live="polite">
              <div class="bar"><div id="upload-bar" style="width: 0%"></div></div>
              <p class="bar-label" id="upload-label">Uploading…</p>
            </div>
            <p class="error" id="upload-error" role="alert"></p>
          </div>
        </form>
      </section>

      <aside class="upload-sidebar" aria-label="Filming and report guidance">
        <section class="sidebar-card sidebar-card--dark">
          <p class="section-kicker">Coaching-ready result</p>
          <h3>Know what to work on next</h3>
          <p>A usable clip gives you a focused starting point instead of a wall
            of disconnected swing data.</p>
          <ul>
            <li><strong>One priority</strong> selected from the measured swing</li>
            <li><strong>One practice drill</strong> tied to that priority</li>
            <li><strong>One re-film target</strong> for a comparable follow-up</li>
          </ul>
        </section>

        <section class="sidebar-card" id="filming-checklist">
          <p class="section-kicker">Before you upload</p>
          <h2>Filming checklist</h2>
          <ol class="checklist">
            <li><strong>Sound on.</strong> Swings are found by the crack of impact.</li>
            <li><strong>Whole body in frame</strong>, head to feet, through the finish.</li>
            <li><strong>Phone at hip height</strong>, a few steps back.</li>
            <li><strong>Use a tee or clean mat strike</strong> so impact is audible.</li>
            <li><strong>Keep the full clip.</strong> Dead time between swings is fine.</li>
            <li><strong>Film face-on</strong> for the full report. Down-the-line
              clips receive tempo and rhythm only for now.</li>
          </ol>
        </section>
      </aside>
    </div>

    <p class="disclaimer">{{ brand.disclaimer }}</p>
  </div>
{% endblock %}
{% block script %}
<script>
(function () {
  var maxMB = {{ max_upload_mb or 0 }};
  var uploadAllowed = {{ 'false' if allowance_used else 'true' }};
  var okExt = [".mov", ".mp4", ".m4v", ".avi", ".mkv"];
  var form = document.getElementById("upload-form");
  var drop = document.getElementById("drop");
  var input = document.getElementById("video");
  var dropText = document.getElementById("drop-text");
  var submit = document.getElementById("submit");
  var progress = document.getElementById("upload-progress");
  var bar = document.getElementById("upload-bar");
  var label = document.getElementById("upload-label");
  var errorEl = document.getElementById("upload-error");

  function fmtMB(bytes) { return (bytes / 1048576).toFixed(1) + " MB"; }

  function setError(message) {
    errorEl.textContent = message || "";
    submit.disabled = !uploadAllowed;
    progress.style.display = "none";
  }

  function checkFile(file) {
    if (!file) return false;
    var name = file.name.toLowerCase();
    if (!okExt.some(function (ext) { return name.endsWith(ext); })) {
      setError("Unsupported file type — use " + okExt.join(", ") + ".");
      return false;
    }
    if (maxMB && file.size > maxMB * 1048576) {
      setError("That clip is " + fmtMB(file.size) + " — the limit is " + maxMB + " MB. "
        + "Trim it to just the swings and try again.");
      return false;
    }
    setError("");
    return true;
  }

  function showFile(file) {
    drop.classList.add("has-file");
    dropText.innerHTML = "";
    var span = document.createElement("span");
    span.className = "filename";
    span.textContent = file.name;
    dropText.appendChild(span);
    dropText.appendChild(document.createTextNode(" (" + fmtMB(file.size) + ") — tap to change"));
  }

  drop.addEventListener("click", function () { input.click(); });
  drop.addEventListener("keydown", function (e) {
    if (e.key === "Enter" || e.key === " ") { e.preventDefault(); input.click(); }
  });
  input.addEventListener("change", function () {
    if (input.files[0] && checkFile(input.files[0])) showFile(input.files[0]);
  });
  ["dragover", "dragenter"].forEach(function (name) {
    drop.addEventListener(name, function (e) {
      e.preventDefault(); drop.classList.add("dragover");
    });
  });
  ["dragleave", "drop"].forEach(function (name) {
    drop.addEventListener(name, function (e) {
      e.preventDefault(); drop.classList.remove("dragover");
    });
  });
  drop.addEventListener("drop", function (e) {
    if (e.dataTransfer.files.length) {
      input.files = e.dataTransfer.files;
      if (checkFile(input.files[0])) showFile(input.files[0]);
    }
  });

  form.addEventListener("submit", function (e) {
    e.preventDefault();
    if (!uploadAllowed) {
      errorEl.textContent = "Your monthly allowance is used. Refresh after it resets on the 1st.";
      submit.disabled = true;
      progress.style.display = "none";
      return;
    }
    var file = input.files[0];
    if (!file) { setError("Choose a swing video first."); return; }
    if (!checkFile(file)) return;
    submit.disabled = true;
    progress.style.display = "block";
    errorEl.textContent = "";

    var xhr = new XMLHttpRequest();
    xhr.open("POST", form.action);
    xhr.setRequestHeader("Accept", "application/json");
    xhr.upload.onprogress = function (ev) {
      if (!ev.lengthComputable) return;
      var pct = Math.round(100 * ev.loaded / ev.total);
      bar.style.width = pct + "%";
      label.textContent = pct < 100
        ? "Uploading… " + pct + "%"
        : "Upload complete — starting analysis…";
    };
    xhr.onerror = function () {
      setError("Upload failed — check your connection and try again.");
    };
    xhr.onload = function () {
      var data = {};
      try { data = JSON.parse(xhr.responseText); } catch (err) {}
      if (xhr.status >= 200 && xhr.status < 300 && data.url) {
        window.location = data.url;
      } else {
        setError(data.detail || "Upload failed (HTTP " + xhr.status + "). Try again.");
      }
    };
    xhr.send(new FormData(form));
  });
})();
</script>
{% endblock %}
