{% extends "web_layout.html.j2" %}
{% block title %}{{ brand.name }} — Pricing{% endblock %}
{% block style %}
  .lead { text-align: center; margin-bottom: 24px; }
  .lead h2 { font-size: 1.8rem; margin: 0 0 8px; }
  .lead p { color: #555; font-size: 1.02rem; max-width: 560px; margin: 0 auto; }
  table.compare { width: 100%; border-collapse: collapse; background: white;
                  border: 1px solid #e0e0e0; border-radius: 8px;
                  margin: 24px 0 28px; overflow: hidden; }
  .compare th, .compare td { padding: 10px 14px; border-bottom: 1px solid #eee;
                             text-align: center; font-size: 0.95rem; }
  .compare th { background: var(--primary); color: white; }
  .compare td:first-child { text-align: left; color: #444; }
  .compare tr:last-child td { border-bottom: none; }
  .compare .yes { color: var(--primary); font-weight: 600; }
  .compare .no { color: #999; }
  .plans { display: flex; gap: 20px; flex-wrap: wrap; }
  .plans .card { flex: 1 1 220px; display: flex; flex-direction: column; }
  .plans .card.hero { border: 2px solid var(--primary); position: relative; }
  .badge { display: inline-block; background: var(--primary); color: white;
           border-radius: 999px; padding: 3px 12px; font-size: 0.75rem;
           font-weight: 700; letter-spacing: 0.02em; margin-bottom: 8px;
           align-self: flex-start; }
  .plans h2 { margin-top: 0; }
  .plans .card.hero h2 { margin-top: 4px; }
  .price { font-size: 1.6rem; font-weight: 700; color: var(--primary); }
  ul { padding-left: 20px; color: #444; flex: 1; }
  li { margin: 8px 0; }
  .card form, .card a.button { margin-top: auto; }
  .card button { width: 100%; }
  .fineprint { color: #666; font-size: 0.85rem; margin-top: 20px; text-align: center; }
  .personal { text-align: center; color: #555; font-size: 0.92rem;
              margin: -6px 0 20px; }
{% endblock %}
{% block main %}
  <div class="lead">
    <h2>One analysis engine. Two ways to use it.</h2>
    <p>Free and Pro run the same analysis and get the same report — the
      metrics table, key-position frames, slow motion, centerline overlays,
      coaching notes, and a practice plan with re-film targets. Free is
      {{ free_per_month }} full report{% if free_per_month != 1 %}s{% endif %}
      a month. Pro is unlimited filming{% if replay_pro_only %}, plus the
      annotated coach replay — your own footage played back with your
      tracked body, your hand path, and the key numbers appearing at each
      swing event{% endif %}{% if progress_pro_only %},
      plus the progress dashboard that charts every metric session over
      session so you can watch a fix stick{% endif %}.</p>
  </div>

  <table class="compare">
    <tr><th></th><th>Free</th><th>Pro</th></tr>
    <tr>
      <td>Swing analyses per month</td>
      <td>{{ free_per_month }}</td>
      <td class="yes">Unlimited</td>
    </tr>
    <tr>
      <td>Tempo, head-sway and hip-slide metrics, benchmarked</td>
      <td class="yes">Included</td><td class="yes">Included</td>
    </tr>
    <tr>
      <td>Key-position frames, slow motion, centerline overlays</td>
      <td class="yes">Included</td><td class="yes">Included</td>
    </tr>
    <tr>
      <td>Coaching notes and a practice plan per session</td>
      <td class="yes">Included</td><td class="yes">Included</td>
    </tr>
    <tr>
      <td>Private session history</td>
      <td class="yes">Included</td><td class="yes">Included</td>
    </tr>
    {% if replay_pro_only %}
    <tr>
      <td>&#128274; Annotated coach replay video</td>
      <td class="no">&mdash;</td><td class="yes">Included</td>
    </tr>
    {% endif %}
    {% if progress_pro_only %}
    <tr>
      <td>&#128274; Progress dashboard &amp; trends</td>
      <td class="no">&mdash;</td><td class="yes">Included</td>
    </tr>
    {% endif %}
  </table>

  {% if trend_line %}
  {# Their own numbers, shown only when two sessions of real data exist. #}
  <p class="personal">{{ trend_line }}.</p>
  {% endif %}

  {% macro pro_cta() -%}
      {% if user and user.is_pro %}
      <p class="hint">You're on Pro — thanks for the support!</p>
      {% elif user and pro_store_url %}
      <a class="button" href="{{ pro_store_url }}">Get Pro on the {{ brand.name }} store</a>
      <p class="hint">Check out with <strong>{{ user.email }}</strong> —
        Pro unlocks on this account automatically.</p>
      {% elif user and billing_enabled %}
      <form action="/billing/checkout" method="post">
        <button type="submit">Upgrade to Pro</button>
      </form>
      {% elif not billing_enabled and not pro_store_url %}
      <p class="hint">Coming soon.</p>
      {% else %}
      <a class="button" href="/login">Log in to upgrade</a>
      {% endif %}
  {%- endmacro %}
  <div class="plans">
    <div class="card hero">
      {% if pro_annual_badge_text %}<span class="badge">{{ pro_annual_badge_text }}</span>{% endif %}
      <h2>Pro — yearly</h2>
      <p class="price">{{ pro_price_annual_text or "Unlimited" }}</p>
      <ul>
        <li>Unlimited swing analyses for a year</li>
        <li>Everything Pro includes, all season</li>
        <li>One checkout covers the whole year — no monthly decision to remake</li>
      </ul>
      {{ pro_cta() }}
    </div>
    <div class="card">
      <h2>Pro — monthly</h2>
      <p class="price">{{ pro_price_monthly_text or "Unlimited" }}</p>
      <ul>
        <li>Unlimited swing analyses</li>
        <li>Everything Pro includes</li>
        {% if store_subscriptions %}
        <li>Subscribe, or buy a single month at a time</li>
        {% else %}
        <li>One month at a time — it simply expires, nothing renews</li>
        {% endif %}
      </ul>
      {{ pro_cta() }}
    </div>
    {% if pro_store_url %}
    {# The lifetime tier exists only as a store purchase (SL-PRO-LIFE) —
       a Stripe-only install has no one-payment product to sell, so the
       card would promise something its checkout can't deliver. #}
    <div class="card">
      <h2>Pro — lifetime</h2>
      <p class="price">{{ pro_price_lifetime_text or "One payment" }}</p>
      <ul>
        <li>One payment — Pro for as long as {{ brand.name }} runs</li>
        <li>Everything Pro includes, forever</li>
        <li>Never renews, never expires</li>
      </ul>
      {{ pro_cta() }}
    </div>
    {% endif %}
    <div class="card">
      <h2>Free</h2>
      <p class="price">$0</p>
      <ul>
        <li>{{ free_per_month }} full swing analys{% if free_per_month == 1 %}is{% else %}es{% endif %}
          every month, forever</li>
        <li>Full report: metrics, key positions, slow motion, overlays</li>
        <li>Coaching notes and a practice plan for every session</li>
        <li>No card required</li>
      </ul>
      {% if not user %}<a class="button" href="/">Sign up free</a>{% endif %}
    </div>
  </div>

  {% if pro_store_url and store_subscriptions %}
  <p class="fineprint">How renewal works: bought as a subscription on the
    {{ brand.name }} store, monthly and yearly Pro renew automatically —
    cancel anytime and Pro keeps running to the end of the period you've
    paid for. Bought as a one-time pass, a month is 31 days and a year is
    365, and they simply expire. Lifetime is a single payment and never
    renews. Prices shown here are display text; the store checkout is
    always the source of truth.</p>
  {% elif pro_store_url %}
  <p class="fineprint">How it works: nothing auto-renews. On the
    {{ brand.name }} store a month is a fixed 31-day pass and a year is
    365 days — they simply expire, and quantities stack. Lifetime is a
    single payment and never ends. Prices shown here are display text;
    the store checkout is always the source of truth.</p>
  {% else %}
  <p class="fineprint">Prices shown here are display text — checkout is
    always the source of truth for what is charged and how it renews.</p>
  {% endif %}
  <p class="fineprint">Unused Pro purchases are refundable within 14 days.</p>

  <p class="disclaimer">{{ brand.disclaimer }}</p>
{% endblock %}
