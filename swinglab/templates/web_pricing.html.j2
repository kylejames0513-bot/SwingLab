{% extends "web_layout.html.j2" %}
{% block title %}{{ brand.name }} — Pricing{% endblock %}
{% block style %}
  .lead { text-align: center; margin-bottom: 24px; }
  .lead h2 { font-size: 1.8rem; margin: 0 0 8px; }
  .lead p { color: #555; font-size: 1.02rem; max-width: 520px; margin: 0 auto; }
  table.compare { width: 100%; border-collapse: collapse; background: white;
                  border: 1px solid #e0e0e0; border-radius: 8px;
                  margin: 24px 0 28px; overflow: hidden; }
  .compare th, .compare td { padding: 10px 14px; border-bottom: 1px solid #eee;
                             text-align: center; font-size: 0.95rem; }
  .compare th { background: var(--primary); color: white; }
  .compare td:first-child { text-align: left; color: #444; }
  .compare tr:last-child td { border-bottom: none; }
  .compare .yes { color: var(--primary); font-weight: 600; }
  .plans { display: flex; gap: 20px; flex-wrap: wrap; }
  .plans .card { flex: 1 1 240px; display: flex; flex-direction: column; }
  .plans h2 { margin-top: 0; }
  .price { font-size: 1.6rem; font-weight: 700; color: var(--primary); }
  ul { padding-left: 20px; color: #444; flex: 1; }
  li { margin: 8px 0; }
  .card form, .card a.button { margin-top: auto; }
  .card button { width: 100%; }
  .fineprint { color: #666; font-size: 0.85rem; margin-top: 20px; text-align: center; }
  .personal { text-align: center; color: #555; font-size: 0.92rem;
              margin: -6px 0 20px; }
{% endblock %}
{% block main %}
  <div class="lead">
    <h2>Every analysis is the full analysis</h2>
    <p>Free and Pro get the same report — the metrics table, key-position
      frames, slow motion, centerline overlays, coaching notes, and a
      practice plan with re-film targets. The only difference is how often
      you can film.</p>
  </div>

  <table class="compare">
    <tr><th></th><th>Free</th><th>Pro</th></tr>
    <tr>
      <td>Swing analyses per month</td>
      <td>{{ free_per_month }}</td>
      <td class="yes">Unlimited</td>
    </tr>
    <tr>
      <td>Tempo, head-sway and hip-slide metrics, benchmarked</td>
      <td class="yes">Included</td><td class="yes">Included</td>
    </tr>
    <tr>
      <td>Key-position frames, slow motion, centerline overlays</td>
      <td class="yes">Included</td><td class="yes">Included</td>
    </tr>
    <tr>
      <td>Coaching notes and a practice plan per session</td>
      <td class="yes">Included</td><td class="yes">Included</td>
    </tr>
    <tr>
      <td>Private session history</td>
      <td class="yes">Included</td><td class="yes">Included</td>
    </tr>
  </table>

  {% if trend_line %}
  {# Their own numbers, shown only when two sessions of real data exist. #}
  <p class="personal">{{ trend_line }}.</p>
  {% endif %}

  {% macro pro_cta() -%}
      {% if user and user.is_pro %}
      <p class="hint">You're on Pro — thanks for the support!</p>
      {% elif user and pro_store_url %}
      <a class="button" href="{{ pro_store_url }}">Get Pro on the {{ brand.name }} store</a>
      <p class="hint">Check out with <strong>{{ user.email }}</strong> —
        Pro unlocks on this account automatically.</p>
      {% elif user and billing_enabled %}
      <form action="/billing/checkout" method="post">
        <button type="submit">Upgrade to Pro</button>
      </form>
      {% elif not billing_enabled and not pro_store_url %}
      <p class="hint">Coming soon.</p>
      {% else %}
      <a class="button" href="/login">Log in to upgrade</a>
      {% endif %}
  {%- endmacro %}
  <div class="plans">
    <div class="card">
      <h2>Pro — annual</h2>
      <p class="price">{{ pro_price_annual_text or "Unlimited" }}</p>
      <ul>
        <li>Unlimited swing analyses for a year</li>
        <li>Everything in Free</li>
        <li>One checkout covers the whole year — no monthly decision to remake</li>
      </ul>
      {{ pro_cta() }}
    </div>
    <div class="card">
      <h2>Pro — monthly</h2>
      <p class="price">{{ pro_price_monthly_text or "Unlimited" }}</p>
      <ul>
        <li>Unlimited swing analyses</li>
        <li>Everything in Free</li>
        <li>Nothing renews behind your back — see the note below</li>
      </ul>
      {{ pro_cta() }}
    </div>
    <div class="card">
      <h2>Free</h2>
      <p class="price">$0</p>
      <ul>
        <li>{{ free_per_month }} swing analyses every month, forever</li>
        <li>Full report: metrics, key positions, slow motion, overlays</li>
        <li>Coaching notes and a practice plan for every session</li>
        <li>No card required</li>
      </ul>
      {% if not user %}<a class="button" href="/">Sign up free</a>{% endif %}
    </div>
  </div>

  <p class="fineprint">Honest note on the monthly option: on the
    {{ brand.name }} store it's a fixed-length 31-day pass that simply
    expires — nothing auto-renews unless the store's subscription setup (or
    Stripe billing, where configured) handles renewal. Prices shown here are
    display text; the store checkout is always the source of truth.</p>
  <p class="fineprint">Cancel anytime — Pro keeps running to the end of what
    you've paid for. Unused Pro purchases are refundable within 14 days.</p>

  <p class="disclaimer">{{ brand.disclaimer }}</p>
{% endblock %}
