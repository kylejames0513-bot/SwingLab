{% extends "web_layout.html.j2" %}
{% block title %}{{ brand.name }} — Pricing{% endblock %}
{% block style %}
  main { max-width: 1120px; }
  .lead { max-width: 780px; margin: 0 auto 30px; text-align: center; }
  .lead h1 { margin: 0 0 12px; color: var(--sl-green); font-size: clamp(2.25rem, 6vw, 4.25rem); line-height: .98; letter-spacing: -.052em; }
  .lead p { color: var(--sl-ink-soft); font-size: 1.02rem; max-width: 720px; margin: 0 auto; }
  .compare-scroll { margin: 24px 0 32px; overflow-x: auto; border: 1px solid var(--sl-border); border-radius: var(--sl-radius-lg); background: #fff; box-shadow: var(--sl-shadow-sm); }
  table.compare { width: 100%; min-width: 680px; border-collapse: collapse; background: white; }
  .compare th, .compare td { padding: 10px 14px; border-bottom: 1px solid #eee;
                             text-align: center; font-size: 0.95rem; }
  .compare thead th { background: var(--primary); color: white; }
  .compare tbody th { background: white; color: var(--sl-ink-soft); font-weight: 600; text-align: left; }
  .compare tr:last-child td, .compare tr:last-child th { border-bottom: none; }
  .compare .yes { color: var(--primary); font-weight: 600; }
  .compare .no { color: var(--sl-ink-muted); }
  .plans { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px; }
  .plans .card { min-width: 0; display: flex; flex-direction: column; }
  .plans .card.hero { border: 2px solid var(--sl-green-btn); position: relative; box-shadow: var(--sl-shadow-lg); }
  .badge { display: inline-block; background: var(--sl-green); color: white;
           border-radius: 999px; padding: 3px 12px; font-size: 0.75rem;
           font-weight: 700; letter-spacing: 0.02em; margin-bottom: 8px;
           align-self: flex-start; }
  .plans h2 { margin-top: 0; }
  .plans .card.hero h2 { margin-top: 4px; }
  .price { font-size: 1.75rem; font-weight: 800; color: var(--sl-green); }
  ul { padding-left: 20px; color: var(--sl-ink-soft); flex: 1; }
  li { margin: 8px 0; }
  .card form, .card a.button { margin-top: auto; }
  .card button { width: 100%; }
  .fineprint { color: var(--sl-ink-muted); font-size: 0.85rem; margin-top: 20px; text-align: center; }
  .personal { text-align: center; color: var(--sl-ink-soft); font-size: 0.92rem;
              margin: -6px 0 20px; }
  @media (max-width: 760px) { .plans { grid-template-columns: 1fr; } }
{% endblock %}
{% block main %}
  <div class="lead">
    <p class="sl-eyebrow">Choose your coaching pace</p>
    <h1>One analysis engine. Two ways to use it.</h1>
    <p>Free and Pro run the same analysis and get the same report — the
      metrics table, key-position frames, slow motion, centerline overlays,
      coaching notes, and a practice plan with re-film targets. Free is
      {% if free_per_month <= 0 %}unlimited full reports{% else %}{{ free_per_month }} full report{% if free_per_month != 1 %}s{% endif %}{% if free_matched_refilm %}
      plus a matched re-film{% endif %}
      a month{% endif %}. Pro is {% if pro_per_month <= 0 %}unlimited filming{% else %}up to
      {{ pro_per_month }} analyses a month{% endif %}{% if replay_pro_only %}, plus the
      annotated coach replay — your own footage played back with your
      tracked body, your hand path, and the key numbers appearing at each
      swing event{% endif %}{% if progress_pro_only %},
      plus the progress dashboard that charts every metric session over
      session so you can watch a fix stick{% endif %}.</p>
  </div>

  <div class="compare-scroll" role="region" aria-label="Free and Pro feature comparison" tabindex="0">
  <table class="compare">
    <thead><tr><th scope="col">Feature</th><th scope="col">Free</th><th scope="col">Pro</th></tr></thead>
    <tbody>
    <tr>
      <th scope="row">Swing analyses per month</th>
      <td>{% if free_per_month <= 0 %}Unlimited{% elif free_matched_refilm %}{{ free_per_month }} + 1 matched re-film{% else %}{{ free_per_month }}{% endif %}</td>
      <td class="yes">{{ "Unlimited" if pro_per_month <= 0 else pro_per_month }}</td>
    </tr>
    <tr>
      <th scope="row">Coaching-ready clip: benchmarked motion metrics</th>
      <td class="yes">Included</td><td class="yes">Included</td>
    </tr>
    <tr>
      <th scope="row">Coaching-ready clip: key frames, slow motion, overlays</th>
      <td class="yes">Included</td><td class="yes">Included</td>
    </tr>
    <tr>
      <th scope="row">Coaching notes and a practice plan per coaching-ready session</th>
      <td class="yes">Included</td><td class="yes">Included</td>
    </tr>
    <tr>
      <th scope="row">Private session history</th>
      <td class="yes">Included</td><td class="yes">Included</td>
    </tr>
    {% if replay_pro_only %}
      <tr>
        <th scope="row">&#128274; Annotated coach replay video</th>
        <td>Upgrade and re-film</td><td class="yes">Included</td>
      </tr>
    {% endif %}
    {% if progress_pro_only %}
    <tr>
      <th scope="row">&#128274; Progress dashboard &amp; trends</th>
      <td class="no">&mdash;</td><td class="yes">Included</td>
    </tr>
    {% endif %}
    </tbody>
  </table>
  </div>

  {% if trend_line %}
  {# Their own numbers, shown only when two sessions of real data exist. #}
  <p class="personal">{{ trend_line }}.</p>
  {% endif %}

  {% macro pro_cta(store_href=None) -%}
      {# store_href deep-links the card's own variant so checkout opens on
         the plan that was clicked; without one, the plain product page. #}
      {% if user and user.is_pro %}
      <p class="hint">You're on Pro — thanks for the support!</p>
      {% elif user and pro_store_url %}
      <a class="button" href="{{ store_href or pro_store_url }}" data-pro-click>Get Pro on the {{ brand.name }} store</a>
      <p class="hint">Check out with <strong>{{ user.email }}</strong> —
        Pro unlocks on this account automatically.</p>
      {% elif user and billing_enabled %}
      <form action="/billing/checkout" method="post" data-pro-click>
        <button type="submit">Upgrade to Pro</button>
      </form>
      {% elif not billing_enabled and not pro_store_url %}
      <p class="hint">Coming soon.</p>
      {% else %}
      <a class="button" href="/login" data-pro-click>Log in to upgrade</a>
      {% endif %}
  {%- endmacro %}
  <div class="plans">
    <div class="card hero">
      {% if pro_annual_badge_text %}<span class="badge">{{ pro_annual_badge_text }}</span>{% endif %}
      <h2>Pro — Season Pass</h2>
      <p class="price">{{ pro_price_annual_text or "Unlimited" }}</p>
      <ul>
        <li>{% if pro_per_month <= 0 %}Unlimited swing analyses for a year{% else %}
          Up to {{ pro_per_month }} analyses a month for a year{% endif %}</li>
        <li>Everything Pro includes, all season — and the off-season too</li>
        {% if replay_pro_only %}<li>Upgrade and re-film with your annotated coach replay</li>{% endif %}
        <li>One checkout covers the whole year — no monthly decision to remake</li>
      </ul>
      {{ pro_cta(pro_store_url_yearly) }}
    </div>
    <div class="card">
      <h2>Pro — monthly</h2>
      <p class="price">{{ pro_price_monthly_text or "Unlimited" }}</p>
      <ul>
        <li>{% if pro_per_month <= 0 %}Unlimited swing analyses{% else %}
          Up to {{ pro_per_month }} analyses a month{% endif %}</li>
        <li>Everything Pro includes</li>
        {% if store_subscriptions %}
        <li>Subscribe, or buy a single month at a time</li>
        {% else %}
        <li>One month at a time — it simply expires, nothing renews</li>
        {% endif %}
      </ul>
      {{ pro_cta(pro_store_url_monthly) }}
      {% if pro_store_url %}
      <p class="hint">The store shows the available terms, renewal details,
        and total price before payment.</p>
      {% elif billing_enabled %}
      <p class="hint">Stripe shows the exact price, billing interval, and
        renewal details before payment.</p>
      {% endif %}
    </div>
    {% if pro_store_url %}
    {# The Founders Pass exists only as a store purchase (it matches on
       SKU SL-PRO-LIFE, never the variant title) — a Stripe-only install
       has no one-payment product to sell, so the card would promise
       something its checkout can't deliver. #}
    <div class="card">
      <h2>Pro — Founders Pass</h2>
      <p class="price">{{ pro_price_lifetime_text or "One payment" }}</p>
      <ul>
        <li>One payment — everything Pro includes, for as long as
          {{ brand.name }} runs</li>
        <li>Capped at the first 100 members — a lifetime product is only
          honest if we can afford to keep running it, so we limit how
          many exist</li>
        <li>Never renews, never expires</li>
      </ul>
      {{ pro_cta(pro_store_url_lifetime) }}
    </div>
    {% endif %}
    <div class="card">
      <h2>Free</h2>
      <p class="price">$0</p>
      <ul>
        <li>{% if free_per_month <= 0 %}Unlimited full swing analyses{% elif free_matched_refilm %}{{ free_per_month }} full analys{% if free_per_month == 1 %}is{% else %}es{% endif %}
          + 1 matched re-film each month{% else %}{{ free_per_month }} full swing analys{% if free_per_month == 1 %}is{% else %}es{% endif %}
          every month{% endif %}, forever</li>
        <li>Full report: metrics, key positions, slow motion, overlays</li>
        <li>Coaching notes and a practice plan for every coaching-ready session</li>
        <li>Capture guidance when a clip needs re-filming</li>
        <li>No card required</li>
      </ul>
      {% if not user %}<a class="button" href="/">Sign up free</a>{% endif %}
    </div>
  </div>

  {% if pro_store_url and store_subscriptions %}
  <p class="fineprint">How renewal works: bought as a subscription on the
    {{ brand.name }} store, monthly and yearly Pro renew automatically —
    cancel anytime and Pro keeps running to the end of the period you've
    paid for. Bought as a one-time pass, a month is 31 days and a year is
    365, and they simply expire. The Founders Pass is a single payment and
    never renews. Prices shown here are display text; the store checkout is
    always the source of truth.</p>
  {% elif pro_store_url %}
  <p class="fineprint">How it works: nothing auto-renews. On the
    {{ brand.name }} store a month is a fixed 31-day pass and a year is
    365 days — they simply expire, and quantities stack. The Founders Pass
    is a single payment and never ends. Prices shown here are display text;
    the store checkout is always the source of truth.</p>
  {% else %}
  <p class="fineprint">Prices shown here are display text — checkout is
    always the source of truth for what is charged and how it renews.</p>
  {% endif %}
  <p class="fineprint">Unused Pro purchases are refundable within 14 days.</p>
  <p class="disclaimer">{{ brand.disclaimer }}</p>
{% endblock %}
{% block script %}
<script>
  (function () {
    var ctas = document.querySelectorAll('[data-pro-click]');
    function track() {
      fetch('/api/v1/events', {
        method: 'POST', credentials: 'same-origin',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ event: 'pro_clicked' })
      }).catch(function () { /* checkout must continue even if telemetry is down */ });
    }
    for (var i = 0; i < ctas.length; i++) {
      ctas[i].addEventListener(ctas[i].tagName === 'FORM' ? 'submit' : 'click', track);
    }
  })();
</script>
{% endblock %}
