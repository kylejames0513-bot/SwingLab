{% extends "web_layout.html.j2" %}
{% block title %}{{ brand.name }} — Pricing{% endblock %}
{% block style %}
  main { max-width: 1160px; }
  .lead { max-width: 800px; margin: 0 auto 34px; text-align: center; }
  .lead h1 { margin: 0 0 12px; color: var(--sl-green); font-size: clamp(2.25rem, 6vw, 4.25rem); line-height: .98; letter-spacing: -.052em; }
  .lead p { color: var(--sl-ink-soft); font-size: 1.02rem; max-width: 720px; margin: 0 auto; }
  .personal { text-align: center; color: var(--sl-ink-soft); font-size: 0.92rem;
              margin: -12px 0 24px; }
  .plans { display: flex; flex-wrap: wrap; gap: 16px; align-items: stretch; }
  .plans .card {
    flex: 1 1 250px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    padding: clamp(22px, 3.5vw, 30px);
  }
  .plans h2 { margin: 0 0 6px; color: var(--sl-green); font-size: 1.28rem; letter-spacing: -.02em; }
  .price {
    margin: 0 0 10px;
    color: var(--sl-green);
    font-size: 1.45rem;
    font-weight: 800;
    letter-spacing: -.025em;
    font-variant-numeric: tabular-nums;
  }
  .plans ul {
    flex: 1;
    margin: 4px 0 16px;
    padding: 0;
    list-style: none;
    align-content: start;
    color: var(--sl-ink-soft);
  }
  .plans li {
    position: relative;
    margin: 0;
    padding: 9px 0 9px 19px;
    font-size: .92rem;
    line-height: 1.5;
  }
  .plans li + li { border-top: 1px dashed var(--sl-border); }
  .plans li::before {
    content: "";
    position: absolute;
    left: 2px;
    top: 1.28em;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--sl-green-btn);
  }
  .badge {
    display: inline-flex;
    width: fit-content;
    margin: 0 0 14px;
    padding: 5px 12px;
    border-radius: var(--sl-radius-control);
    background: #75d59b;
    color: #06110c;
    font-family: var(--sl-font-mono);
    font-size: .66rem;
    font-weight: 700;
    letter-spacing: .08em;
    text-transform: uppercase;
  }
  .plans .card.hero {
    flex-basis: 100%;
    position: relative;
    overflow: hidden;
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(260px, .6fr);
    gap: clamp(24px, 4vw, 56px);
    align-items: center;
    padding: clamp(26px, 4.5vw, 44px);
    border: 1px solid rgba(255, 255, 255, .14);
    border-radius: var(--sl-radius-xl);
    background:
      radial-gradient(circle at 86% 10%, rgba(255, 204, 142, .16), transparent 20rem),
      var(--sl-premium-gradient);
    color: #cfe0d5;
    box-shadow: var(--sl-shadow-lg);
  }
  .plans .card.hero::after {
    content: "";
    position: absolute;
    left: -84px;
    bottom: -152px;
    width: 300px;
    height: 300px;
    border: 1px solid rgba(255, 255, 255, .12);
    border-radius: 50%;
    pointer-events: none;
  }
  .card.hero .hero-plan__copy,
  .card.hero .hero-plan__buy { position: relative; z-index: 1; }
  .card.hero h2 { margin: 0 0 4px; color: #fff; font-size: clamp(1.6rem, 3vw, 2.2rem); letter-spacing: -.03em; }
  .card.hero ul { margin-bottom: 0; color: #cfe0d5; }
  .card.hero li + li { border-top-color: rgba(245, 242, 233, .16); }
  .card.hero li::before { background: #75d59b; }
  .hero-plan__buy {
    padding: clamp(18px, 2.5vw, 24px);
    border: 1px solid rgba(245, 242, 233, .2);
    border-radius: var(--sl-radius-lg);
    background: rgba(5, 16, 10, .6);
    -webkit-backdrop-filter: blur(16px);
    backdrop-filter: blur(16px);
    box-shadow: 0 28px 60px -34px rgba(0, 0, 0, .85);
  }
  .hero-plan__label {
    margin: 0 0 8px;
    color: #ffad62;
    font-family: var(--sl-font-mono);
    font-size: .66rem;
    font-weight: 500;
    letter-spacing: .13em;
    text-transform: uppercase;
  }
  .card.hero .price {
    margin: 0;
    color: #fff;
    font-size: clamp(1.45rem, 2.4vw, 1.85rem);
    line-height: 1.2;
  }
  .card.hero a.button,
  .card.hero button {
    width: 100%;
    margin-top: 16px;
    border-color: #f07a18;
    background: #f07a18;
    color: #06110c;
    box-shadow: 0 16px 34px -20px rgba(240, 122, 24, .9);
  }
  .card.hero a.button:hover,
  .card.hero button:hover {
    border-color: #ff9a42;
    background: #ff9a42;
    color: #06110c;
  }
  .card.hero .hint { margin-top: 12px; color: rgba(245, 242, 233, .74); }
  .card.hero .hint strong,
  .card.hero .hint a { color: #fff; }
  .card.founders { border-color: #d9c8b2; background: linear-gradient(180deg, #fffdfa, #fff7ec); }
  .founders-cap {
    width: fit-content;
    margin: 0 0 12px;
    padding: 5px 10px;
    border: 1px solid #e5c9a4;
    border-radius: var(--sl-radius-control);
    background: #e8f0ea;
    color: var(--sl-orange-text);
    font-family: var(--sl-font-mono);
    font-size: .64rem;
    font-weight: 500;
    letter-spacing: .1em;
    text-transform: uppercase;
  }
  .founders-note {
    margin: 16px 0 0;
    padding-top: 12px;
    border-top: 1px dashed var(--sl-border-strong);
    color: var(--sl-ink-muted);
    font-size: .8rem;
    line-height: 1.55;
  }
  .plans .card.quiet { background: transparent; border-color: var(--sl-border-strong); box-shadow: none; }
  .plans .card form,
  .plans .card:not(.hero) a.button { margin-top: auto; }
  .plans .card a.button { text-align: center; }
  .card button { width: 100%; }
  .compare-section { margin-top: clamp(40px, 6vw, 64px); }
  .compare-head { max-width: 680px; margin: 0 0 18px; }
  .compare-head h2 { margin: 0; color: var(--sl-green); font-size: clamp(1.5rem, 3vw, 2.1rem); letter-spacing: -.035em; line-height: 1.08; }
  .compare-scroll {
    overflow-x: auto;
    border: 1px solid var(--sl-border-strong);
    border-radius: var(--sl-radius-lg);
    background: var(--sl-bg-card);
    box-shadow: var(--sl-shadow-sm);
  }
  table.compare { width: 100%; min-width: 680px; border-collapse: collapse; }
  .compare th, .compare td { padding: 13px 18px; border-bottom: 1px solid var(--sl-border);
                             text-align: center; font-size: 0.92rem; }
  .compare thead th {
    padding: 12px 18px;
    background: var(--sl-green);
    color: var(--sl-green-ink);
    font-family: var(--sl-font-mono);
    font-size: .68rem;
    font-weight: 500;
    letter-spacing: .14em;
    text-transform: uppercase;
  }
  .compare thead th:first-child { text-align: left; }
  .compare tbody th { background: transparent; color: var(--sl-ink); font-weight: 600; text-align: left; font-size: .9rem; }
  .compare tbody tr:nth-child(even) { background: rgba(20, 71, 44, .04); }
  .compare td {
    color: var(--sl-ink-soft);
    font-family: var(--sl-font-mono);
    font-size: .8rem;
    font-variant-numeric: tabular-nums;
  }
  .compare .yes { color: var(--sl-green-btn); font-weight: 700; }
  .compare .no { color: var(--sl-ink-muted); }
  .compare tr:last-child td, .compare tr:last-child th { border-bottom: none; }
  .fineprint { max-width: 780px; margin: 16px auto 0; color: var(--sl-ink-muted); font-size: 0.82rem; text-align: center; line-height: 1.6; }
  .compare-section + .fineprint { margin-top: 26px; padding-top: 18px; border-top: 1px dashed var(--sl-border-strong); }
  @media (max-width: 999px) {
    .plans .card.hero { grid-template-columns: 1fr; align-items: stretch; }
  }
  @media (max-width: 640px) {
    .plans { flex-direction: column; }
    .plans .card { flex-basis: auto; }
  }
{% endblock %}
{% block main %}
  <div class="lead">
    <p class="sl-eyebrow">Choose your coaching pace</p>
    <h1>One analysis engine. {{ "Three" if coach_tier_enabled else "Two" }} ways to use it.</h1>
    <p>Free and Pro run the same analysis and get the same report — the
      metrics table, key-position frames, slow motion, centerline overlays,
      coaching notes, and a practice plan with re-film targets. Free is
      {% if free_per_month <= 0 %}unlimited full reports{% else %}{{ free_per_month }} full report{% if free_per_month != 1 %}s{% endif %}{% if free_matched_refilm %}
      plus a matched re-film{% endif %}
      a month{% endif %}. Pro is {% if pro_per_month <= 0 %}unlimited filming{% else %}up to
      {{ pro_per_month }} analyses a month{% endif %}{% if not coach_tier_enabled %}{% if replay_pro_only %}, plus the
      annotated coach replay — your own footage played back with your
      tracked body, your hand path, and the key numbers appearing at each
      swing event{% endif %}{% if progress_pro_only %},
      plus the progress dashboard that charts every metric session over
      session so you can watch a fix stick{% endif %}{% endif %}.
      {% if coach_tier_enabled %}Coach adds the part nobody else
      does{% if replay_pro_only %}: the annotated replay of every
      swing{% endif %}{% if progress_pro_only %}, the progress dashboard that
      charts every metric session over session{% endif %}, and the proof cycle
      that refuses to call a fix real until a matched re-film says so.
      {# The approved positioning line — the ladder's one-sentence honest
         summary (two-tier design spec, 2026-08-09). Rendered only with the
         ladder itself, and only when both display prices exist, so the
         sentence can never quote a number the cards don't. #}
      {% if coach_price_monthly_text and pro_price_monthly_text %}
      <strong>{{ pro_price_monthly_text.split("/")[0] }} gets you what other
      swing apps sell. {{ coach_price_monthly_text.split("/")[0] }} gets you
      proof that the fix held.</strong>{% endif %}{% endif %}</p>
  </div>

  {% if trend_line %}
  {# Their own numbers, shown only when two sessions of real data exist. #}
  <p class="personal">{{ trend_line }}.</p>
  {% endif %}

  {% macro pro_cta(store_href=None, label=None, owned=None) -%}
      {# store_href deep-links the card's own variant so checkout opens on
         the plan that was clicked; without one, the plain product page.
         `owned` says whether this viewer already holds THIS card's plan —
         passed in rather than read off the user, because with two tiers a
         Pro subscriber must still see a live Coach CTA. #}
      {% set already = user.is_pro if owned is none else owned %}
      {% if user and already %}
      <p class="hint">You're on {{ label or "Pro" }} — thanks for the support!</p>
      {% elif user and pro_store_url %}
      <a class="button" href="{{ store_href or pro_store_url }}" data-pro-click>Get {{ label or "Pro" }} on the {{ brand.name }} store</a>
      <p class="hint">Check out with <strong>{{ user.email }}</strong> —
        it unlocks on this account automatically.</p>
      {% elif pro_store_url %}
      {# Anonymous visitor, store configured: send them to checkout.
         Every branch above is gated on `user`, so cold traffic from an ad
         or a shared link fell through to "Log in to upgrade" and converted
         at zero — and that link carried no `next`, so the plan they clicked
         was lost even if they did sign in. Buying first is safe:
         claim_pending_pro attaches a purchase made before the account
         existed, matched on the checkout email. #}
      <a class="button" href="{{ store_href or pro_store_url }}" data-pro-click>Get {{ label or "Pro" }} on the {{ brand.name }} store</a>
      <p class="hint">No account needed to buy — check out, then sign in
        with the same email and it unlocks automatically.</p>
      {% else %}
      {# Purchases go through the Shopify store, and only the store — with
         no store configured there is deliberately nothing to sell here. #}
      <p class="hint">Coming soon.</p>
      {% endif %}
  {%- endmacro %}
  <div class="plans">
    <div class="card hero">
      <div class="hero-plan__copy">
        {% if pro_annual_badge_text %}<span class="badge">{{ pro_annual_badge_text }}</span>{% endif %}
        <h2>Pro — Season Pass</h2>
        <ul>
          <li>{% if pro_per_month <= 0 %}Unlimited swing analyses for a year{% else %}
            Up to {{ pro_per_month }} analyses a month for a year{% endif %}</li>
          <li>Everything Pro includes, all season — and the off-season too</li>
          {% if replay_pro_only and not coach_tier_enabled %}<li>Upgrade and re-film with your annotated coach replay</li>{% endif %}
          <li>One checkout covers the whole year — no monthly decision to remake</li>
        </ul>
      </div>
      <div class="hero-plan__buy">
        <p class="hero-plan__label">A full year of Pro</p>
        <p class="price">{{ pro_price_annual_text or "Unlimited" }}</p>
        {{ pro_cta(pro_store_url_yearly) }}
      </div>
    </div>
    <div class="card">
      <h2>Pro — monthly</h2>
      <p class="price">{{ pro_price_monthly_text or "Unlimited" }}</p>
      <ul>
        <li>{% if pro_per_month <= 0 %}Unlimited swing analyses{% else %}
          Up to {{ pro_per_month }} analyses a month{% endif %}</li>
        <li>Everything Pro includes</li>
        {% if store_subscriptions %}
        <li>Subscribe, or buy a single month at a time</li>
        {% else %}
        <li>One month at a time — it simply expires, nothing renews</li>
        {% endif %}
      </ul>
      {{ pro_cta(pro_store_url_monthly) }}
      {% if pro_store_url %}
      <p class="hint">The store shows the available terms, renewal details,
        and total price before payment.</p>
      {% endif %}
    </div>
    {% if pro_store_url %}
    {# The Founders Pass exists only as a store purchase (it matches on
       SKU SL-PRO-LIFE, never the variant title) — an install without the
       store configured has no one-payment product to sell, so the card
       would promise something its checkout can't deliver. #}
    <div class="card founders">
      <p class="founders-cap">Capped at the first 100 members</p>
      <h2>Pro — Founders Pass</h2>
      <p class="price">{{ pro_price_lifetime_text or "One payment" }}</p>
      <ul>
        <li>One payment — everything Pro includes, for as long as
          {{ brand.name }} runs</li>
        <li>Never renews, never expires — Founders stay grandfathered
          through every future price change</li>
      </ul>
      {{ pro_cta(pro_store_url_lifetime) }}
      <p class="founders-note">A lifetime product is only honest if we can
        afford to keep running it, so we limit how many Founders Passes
        exist.</p>
    </div>
    {% endif %}
    {% if coach_tier_enabled %}
    {# Coach: the upper rung. Rendered only once the ladder is rolled out,
       so the page never offers a plan the store cannot sell. #}
    <div class="card coach">
      <h2>Coach — monthly</h2>
      <p class="price">{{ coach_price_monthly_text or "Everything, proven" }}</p>
      <ul>
        <li>Everything in Pro</li>
        {% if replay_pro_only %}<li>The annotated coach replay of every swing —
          your own footage with your tracked body, hand path, and the numbers
          at each swing event</li>
        <li>The Swing Pattern — your report names how your swing is built:
          body-led or arm-led, centered or lateral, steady-headed or mobile,
          read straight from your measurements</li>{% endif %}
        {% if progress_pro_only %}<li>The progress dashboard: every metric
          charted session over session, so you can watch a fix hold</li>{% endif %}
        <li>The proof cycle — a pass mark, a matched re-film, and a verdict
          that only counts a change once it survives two checks</li>
      </ul>
      {{ pro_cta(coach_store_url_monthly, "Coach", user.has_coach if user else false) }}
    </div>
    {% if coach_store_url_yearly or coach_price_annual_text %}
    <div class="card coach">
      <h2>Coach — yearly</h2>
      <p class="price">{{ coach_price_annual_text or "Everything, proven" }}</p>
      <ul>
        <li>Everything in Coach, all season — and the off-season too</li>
        <li>One checkout covers the whole year</li>
      </ul>
      {{ pro_cta(coach_store_url_yearly, "Coach", user.has_coach if user else false) }}
    </div>
    {% endif %}
    {% endif %}
    <div class="card quiet">
      <h2>Free</h2>
      <p class="price">$0</p>
      <ul>
        <li>{% if free_per_month <= 0 %}Unlimited full swing analyses{% elif free_matched_refilm %}{{ free_per_month }} full analys{% if free_per_month == 1 %}is{% else %}es{% endif %}
          + 1 matched re-film each month{% else %}{{ free_per_month }} full swing analys{% if free_per_month == 1 %}is{% else %}es{% endif %}
          every month{% endif %}, forever</li>
        <li>Full report: metrics, key positions, slow motion, overlays</li>
        <li>Coaching notes and a practice plan for every coaching-ready session</li>
        <li>Capture guidance when a clip needs re-filming</li>
        <li>No card required</li>
      </ul>
      {% if not user %}<a class="button" href="/">Sign up free</a>{% endif %}
    </div>
  </div>

  <section class="compare-section" aria-labelledby="compare-title">
    <div class="compare-head">
      <p class="sl-eyebrow">Side by side</p>
      <h2 id="compare-title">The same report engine on every plan.</h2>
    </div>
    <div class="compare-scroll" role="region" aria-label="Free and Pro feature comparison" tabindex="0">
    <table class="compare">
      <thead><tr><th scope="col">Feature</th><th scope="col">Free</th><th scope="col">Pro</th>{% if coach_tier_enabled %}<th scope="col">Coach</th>{% endif %}</tr></thead>
      <tbody>
      <tr>
        <th scope="row">Swing analyses per month</th>
        <td>{% if free_per_month <= 0 %}Unlimited{% elif free_matched_refilm %}{{ free_per_month }} + 1 matched re-film{% else %}{{ free_per_month }}{% endif %}</td>
        <td class="yes">{{ "Unlimited" if pro_per_month <= 0 else pro_per_month }}</td>
        {% if coach_tier_enabled %}<td class="yes">{{ "Unlimited" if pro_per_month <= 0 else pro_per_month }}</td>{% endif %}
      </tr>
      <tr>
        <th scope="row">Coaching-ready clip: benchmarked motion metrics</th>
        <td class="yes">Included</td><td class="yes">Included</td>{% if coach_tier_enabled %}<td class="yes">Included</td>{% endif %}
      </tr>
      <tr>
        <th scope="row">Coaching-ready clip: key frames, slow motion, overlays</th>
        <td class="yes">Included</td><td class="yes">Included</td>{% if coach_tier_enabled %}<td class="yes">Included</td>{% endif %}
      </tr>
      <tr>
        <th scope="row">Coaching notes and a practice plan per coaching-ready session</th>
        <td class="yes">Included</td><td class="yes">Included</td>{% if coach_tier_enabled %}<td class="yes">Included</td>{% endif %}
      </tr>
      <tr>
        <th scope="row">Private session history</th>
        <td class="yes">Included</td><td class="yes">Included</td>{% if coach_tier_enabled %}<td class="yes">Included</td>{% endif %}
      </tr>
      {% if replay_pro_only %}
        <tr>
          <th scope="row">&#128274; Annotated coach replay video</th>
          {% if coach_tier_enabled %}
          <td class="no">&mdash;</td><td class="no">&mdash;</td><td class="yes">Included</td>
          {% else %}
          <td>Upgrade and re-film</td><td class="yes">Included</td>
          {% endif %}
        </tr>
        {# The Swing Pattern shares the replay's entitlement gate — the two
           are the Coach tier's report-level features, and this row must
           never advertise a section the report does not render. #}
        <tr>
          <th scope="row">&#128274; Swing Pattern: how your swing is built</th>
          {% if coach_tier_enabled %}
          <td class="no">&mdash;</td><td class="no">&mdash;</td><td class="yes">Included</td>
          {% else %}
          <td class="no">&mdash;</td><td class="yes">Included</td>
          {% endif %}
        </tr>
      {% endif %}
      {% if progress_pro_only %}
      <tr>
        <th scope="row">&#128274; Progress dashboard &amp; trends</th>
        {% if coach_tier_enabled %}
        <td class="no">&mdash;</td><td class="no">&mdash;</td><td class="yes">Included</td>
        {% else %}
        <td class="no">&mdash;</td><td class="yes">Included</td>
        {% endif %}
      </tr>
      {% endif %}
      {% if coach_tier_enabled %}
      <tr>
        <th scope="row">&#128274; Proof cycle: pass marks and verified changes</th>
        <td class="no">&mdash;</td><td class="no">&mdash;</td><td class="yes">Included</td>
      </tr>
      {% endif %}
      </tbody>
    </table>
    </div>
  </section>

  {% if pro_store_url and store_subscriptions %}
  <p class="fineprint">How renewal works: bought as a subscription on the
    {{ brand.name }} store, monthly and yearly Pro renew automatically —
    cancel anytime and Pro keeps running to the end of the period you've
    paid for. Bought as a one-time pass, a month is 31 days and a year is
    365, and they simply expire. The Founders Pass is a single payment and
    never renews. Prices shown here are display text; the store checkout is
    always the source of truth.</p>
  {% elif pro_store_url %}
  <p class="fineprint">How it works: nothing auto-renews. On the
    {{ brand.name }} store a month is a fixed 31-day pass and a year is
    365 days — they simply expire, and quantities stack. The Founders Pass
    is a single payment and never ends. Prices shown here are display text;
    the store checkout is always the source of truth.</p>
  {% else %}
  <p class="fineprint">Prices shown here are display text — checkout is
    always the source of truth for what is charged and how it renews.</p>
  {% endif %}
  <p class="fineprint">Unused Pro purchases are refundable within 14 days.</p>
  <p class="disclaimer">{{ brand.disclaimer }}</p>
{% endblock %}
{% block script %}
<script>
  (function () {
    var ctas = document.querySelectorAll('[data-pro-click]');
    function track() {
      fetch('/api/v1/events', {
        method: 'POST', credentials: 'same-origin',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ event: 'pro_clicked' })
      }).catch(function () { /* checkout must continue even if telemetry is down */ });
    }
    for (var i = 0; i < ctas.length; i++) {
      ctas[i].addEventListener(ctas[i].tagName === 'FORM' ? 'submit' : 'click', track);
    }
  })();
</script>
{% endblock %}
