{% extends "web_layout.html.j2" %}
{% block title %}{{ brand.name }} — Session history{% endblock %}
{% block style %}
  table { width: 100%; border-collapse: collapse; margin-top: 8px; }
  th, td { text-align: left; padding: 10px 8px; border-bottom: 1px solid #eee;
           font-size: 0.95rem; }
  th { color: #555; font-weight: 600; font-size: 0.85rem;
       text-transform: uppercase; letter-spacing: 0.03em; }
  tr:hover td { background: #fafafa; }
  a.session { color: var(--primary); font-weight: 600; text-decoration: none; }
  a.session:hover { text-decoration: underline; }
  .chip { display: inline-block; padding: 2px 10px; border-radius: 999px;
          font-size: 0.8rem; font-weight: 600; }
  .chip.done { background: #e5f3ea; color: #1a5c38; }
  .chip.refilm { background: #fff3e0; color: #8a4b08; }
  .chip.failed { background: #fbe9e7; color: #b3261e; }
  .chip.processing, .chip.queued { background: #fff3e0; color: #a35406; }
  .chip.club { background: #eef1f4; color: #33414e; font-weight: 500; }
{% endblock %}
{% block main %}
  <div class="card">
    <h2>Session history</h2>
    {% if sessions %}
      <table>
        <tr><th>When</th><th>Clip</th><th>Club</th><th>Status</th><th>Swings</th></tr>
        {% for s in sessions %}
        <tr>
          <td>{{ s.as_dict().created_at[:16].replace("T", " ") }}</td>
          <td><a class="session" href="/session/{{ s.id }}">{{ s.source_name or s.id }}</a></td>
          <td>{% if s.club %}<span class="chip club">{{ club_labels.get(s.club, s.club) }}</span>{% else %}—{% endif %}</td>
          <td>
            {% if s.id in refilm_ids %}
            <span class="chip refilm">Re-film needed</span>
            {% else %}
            <span class="chip {{ s.status }}">{{ s.status }}</span>
            {% endif %}
          </td>
          <td>{{ s.swings_total if s.swings_total else "—" }}</td>
        </tr>
        {% endfor %}
      </table>
    {% else %}
      <p>No sessions yet — <a href="/">analyze your first clip</a>.</p>
    {% endif %}
    {% if user and require_account %}
    <p style="margin-bottom: 0"><a href="/progress">See your progress across
      sessions &rarr;</a></p>
    {% endif %}
  </div>
{% endblock %}
