{% extends "web_layout.html.j2" %}
{% block title %}{{ brand.name }} — Start over{% endblock %}
{% block style %}
  /* ------------------------------------------------------- start over
     The only customer-facing page in the app that destroys data, so every
     decision here works against the reader's momentum rather than with it.

     There is no amber and no cyan on this page, on purpose. Amber marks a
     value the engine measured and cyan marks a live read; this page measures
     nothing and reads nothing. Borrowing either one to make a warning "pop"
     is exactly the emphasis creep the two colour rules exist to stop, so the
     only signal colour here is --sl-danger, and it is spent on the two
     things that carry risk: the scope of the deletion and the button that
     performs it. */
  main { max-width: 850px; }

  /* One ruled instrument face instead of three floating cards. The 1px gaps
     ARE the hairlines — the shell's border colour sits behind the grid and
     shows through where the panels do not paint. */
  .reset-shell {
    display: grid;
    gap: 1px;
    border: 1px solid var(--sl-border-strong);
    border-radius: var(--sl-radius-sm);
    background: var(--sl-border);
    box-shadow: var(--sl-shadow-md);
  }

  /* The headline sits on the well, a step deeper than the panels below it,
     so the page opens on its own darkest surface. */
  .reset-header {
    padding: clamp(26px, 5vw, 42px);
    background:
      radial-gradient(circle at 92% 6%, rgba(var(--sl-cream-rgb), .05), transparent 15rem),
      var(--sl-night);
  }
  /* The shell paints .sl-eyebrow amber. Amber is the measured-value colour
     and "Danger zone" is not a measurement — the single thing this line
     carries is risk, so it takes the risk colour. */
  .reset-header .sl-eyebrow {
    margin-bottom: var(--sl-space-4);
    display: inline-flex;
    align-items: center;
    gap: var(--sl-space-2);
    color: var(--sl-danger);
    font-size: var(--sl-eyebrow-size);
    letter-spacing: var(--sl-eyebrow-track);
  }
  .reset-header .sl-eyebrow::before {
    content: "";
    width: 6px;
    height: 6px;
    flex: 0 0 auto;
    background: currentColor;
  }
  .reset-header h1 {
    max-width: 17ch;
    margin: 0;
    color: var(--sl-green);
    font-family: var(--sl-font-display);
    font-size: var(--sl-heading-display);
    font-weight: 600;
    letter-spacing: -.02em;
    line-height: .98;
    text-transform: uppercase;
  }
  .reset-header > p:last-child {
    max-width: 58ch;
    margin: var(--sl-space-5) 0 0;
    color: var(--sl-ink-soft);
    font-size: var(--sl-text-lg);
    line-height: 1.55;
    text-wrap: pretty;
  }

  /* The scope table: two panels butted against one hairline, same 1px-gap
     construction as the storefront readout grid. Reading "what goes" beside
     "what stays" is the whole point of the page, so they must sit on one
     rule rather than float apart. */
  .reset-scope {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    background: var(--sl-border);
  }
  .scope-card {
    padding: clamp(20px, 3vw, 28px);
    background: var(--sl-bg-card);
  }
  /* The edge bar restates what the heading already says in words — it is a
     second signal, never the only one, because a reader who cannot separate
     these two colours must still be able to tell the panels apart. */
  .scope-card--delete { box-shadow: inset 3px 0 0 var(--sl-danger); }
  .scope-card--keep { box-shadow: inset 3px 0 0 var(--sl-ink-muted); }
  /* Mono label above the values, not a display heading: these two headings
     name a column of scope, they do not open a section. */
  .scope-card h2 {
    margin: 0;
    color: var(--sl-ink-muted);
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-xs);
    font-weight: 500;
    letter-spacing: var(--sl-eyebrow-track);
    line-height: 1.2;
    text-transform: uppercase;
  }
  .scope-card--delete h2 { color: var(--sl-danger); }
  /* Ruled rows rather than bullets: each line is one item of scope, and a
     hairline between them counts them for the reader. */
  .scope-card ul {
    margin: var(--sl-space-4) 0 0;
    padding: 0;
    list-style: none;
  }
  .scope-card li {
    padding: var(--sl-space-3) 0;
    border-top: 1px solid var(--sl-border);
    color: var(--sl-ink-soft);
    font-size: var(--sl-text-sm);
    line-height: 1.45;
  }
  .scope-card li:last-child { padding-bottom: 0; }

  .reset-card {
    padding: clamp(24px, 4vw, 34px);
    background: var(--sl-bg-card);
  }
  .reset-card h2 {
    margin: 0;
    color: var(--sl-green);
    font-family: var(--sl-font-display);
    font-size: var(--sl-text-xl);
    font-weight: 600;
    letter-spacing: -.02em;
    text-transform: uppercase;
  }
  /* There is deliberately no `.reset-card > p` rule here. The previous one
     set body ink at (0,1,1) and outranked `.reset-error` at (0,1,0), so
     every failed confirmation rendered in ordinary ink on the one page where
     the error IS the message — and since .reset-card never has a plain <p>
     child in the markup below, the rule was doing nothing else. */

  .reset-error {
    margin: var(--sl-space-4) 0 0;
    padding: var(--sl-space-3) var(--sl-space-4);
    border: 1px solid var(--sl-danger);
    border-left-width: 3px;
    border-radius: var(--sl-radius-sm);
    background: var(--sl-night);
    color: var(--sl-danger);
    font-size: var(--sl-text-sm);
  }
  .reauth-note {
    margin: var(--sl-space-4) 0 0;
    padding: var(--sl-space-4);
    border: 1px solid var(--sl-border);
    border-left: 3px solid var(--sl-control-border);
    border-radius: var(--sl-radius-sm);
    background: var(--sl-night);
    color: var(--sl-ink-soft);
    font-size: var(--sl-text-sm);
  }

  .reset-form {
    margin-top: var(--sl-space-5);
    padding-top: var(--sl-space-5);
    border-top: 1px solid var(--sl-border);
  }
  .reset-form label {
    display: block;
    margin: var(--sl-space-5) 0 var(--sl-space-2);
    color: var(--sl-ink-muted);
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-xs);
    font-weight: 500;
    letter-spacing: var(--sl-eyebrow-track);
    text-transform: uppercase;
  }
  /* The shell's zero-specificity control baseline still paints inputs #fff —
     a white slab on a near-black page. Both fields take the well instead,
     edged in --sl-control-border (4.29:1): --sl-border is 1.33:1 and is
     decorative only, never an interactive edge. Mono because what goes in
     the first field is a literal that has to match character for
     character. */
  .reset-form input {
    width: 100%;
    max-width: 460px;
    min-height: 48px;
    padding: var(--sl-space-3);
    border: 1px solid var(--sl-control-border);
    border-radius: var(--sl-radius-control);
    background: var(--sl-night);
    color: var(--sl-ink);
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-base);
    font-weight: 400;
    letter-spacing: .04em;
  }
  /* Was --sl-orange. A focused field is not a measured value, and the shell
     already draws the amber focus ring around it. */
  .reset-form input:focus-visible { border-color: var(--sl-ink); }
  .reset-code {
    padding: 3px var(--sl-space-2);
    border: 1px solid var(--sl-control-border);
    border-radius: var(--sl-radius-sm);
    background: var(--sl-night);
    color: var(--sl-ink);
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-xs);
    font-weight: 500;
    letter-spacing: .06em;
    /* The label above is uppercased for the instrument look; this chip must
       NOT inherit that. The server compares the typed phrase case-sensitively
       against HISTORY_RESET_CONFIRMATION, so a CSS transform here would be
       free to lie about what to type the moment that constant stops being
       upper case. Bone, not amber — it is a string to retype, not a
       reading. */
    text-transform: none;
  }

  .reset-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sl-space-3);
    margin-top: var(--sl-space-5);
  }
  .reset-actions form { margin: 0; }
  /* The shell's main-button baseline is bone on bone (background
     var(--sl-green-btn), color white) — an unreadable label since the
     inversion. Every button on this page states its own ink. This is the
     SAFE action of the pair: re-authenticating is the bone primary. */
  .reset-actions button {
    min-height: 48px;
    margin: 0;
    padding: var(--sl-space-3) var(--sl-space-5);
    border: 1px solid var(--sl-green-btn);
    border-radius: var(--sl-radius-control);
    background: var(--sl-green-btn);
    color: var(--sl-green-ink);
    box-shadow: none;
    font-family: var(--sl-font-sans);
    font-size: var(--sl-text-sm);
    font-weight: 500;
  }
  .reset-actions button:hover {
    border-color: var(--sl-ink-hi);
    background: var(--sl-ink-hi);
    color: var(--sl-green-ink);
    box-shadow: none;
    transform: none;
  }
  /* The irreversible control, and pointedly NOT the bone primary: on a page
     whose whole job is to slow the reader down, the destructive action must
     not also be the brightest, easiest object to hit. It is outlined in the
     risk colour and only fills once a pointer or the keyboard has committed
     to it (7.18:1 outlined, 7.88:1 filled). Amber was never a candidate — a
     call to action is not a measurement. */
  .reset-actions .danger-button {
    border-color: var(--sl-danger);
    background: transparent;
    color: var(--sl-danger);
  }
  .reset-actions .danger-button:hover,
  .reset-actions .danger-button:focus-visible {
    border-color: var(--sl-danger);
    background: var(--sl-danger);
    color: var(--sl-night);
    transform: none;
  }
  /* The way out is a full-size target beside the destructive one, not a word
     tucked underneath it. Bordered, so the underline the shell gives links
     is not the thing holding it together. */
  .reset-cancel {
    min-height: 48px;
    display: inline-flex;
    align-items: center;
    padding: var(--sl-space-3) var(--sl-space-4);
    border: 1px solid var(--sl-control-border);
    border-radius: var(--sl-radius-control);
    color: var(--sl-ink);
    font-size: var(--sl-text-sm);
    font-weight: 500;
    text-decoration: none;
  }
  .reset-cancel:hover {
    border-color: var(--sl-ink);
    background: rgba(var(--sl-cream-rgb), .06);
    color: var(--sl-ink);
  }

  @media (max-width: 749px) {
    .reset-scope { grid-template-columns: minmax(0, 1fr); }
    .reset-form input { max-width: none; }
    /* Stacked full-width targets, and the destructive one still reads as the
       outlined control rather than as the default thumb lands on. */
    .reset-actions { align-items: stretch; flex-direction: column; }
    .reset-actions > *, .reset-actions button { width: 100%; text-align: center; }
    .reset-cancel { justify-content: center; }
  }
  @media (prefers-reduced-motion: reduce) {
    .reset-shell *,
    .reset-shell *::before,
    .reset-shell *::after {
      animation-duration: .01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: .01ms !important;
    }
  }
{% endblock %}
{% block main %}
  <div class="reset-shell">
    <header class="reset-header" aria-labelledby="reset-title">
      <p class="sl-eyebrow">Danger zone</p>
      <h1 id="reset-title">Delete swing history and start over</h1>
      <p>This permanently removes your uploaded swing sessions, generated reports, practice check-ins, and Proof Cycle evidence. It cannot be undone.</p>
    </header>

    <div class="reset-scope" aria-label="Deletion scope">
      <section class="scope-card scope-card--delete" aria-labelledby="removed-heading">
        <h2 id="removed-heading">What is deleted</h2>
        <ul>
          <li>Uploaded swing sessions and generated reports</li>
          <li>Practice check-ins and Proof Cycle evidence</li>
        </ul>
      </section>
      <section class="scope-card scope-card--keep" aria-labelledby="stays-heading">
        <h2 id="stays-heading">What stays</h2>
        <ul>
          <li>Your account and golfer profile</li>
          <li>Your Free or Pro membership and purchases</li>
          <li>Shopify connection and connected-device sign-ins</li>
          <li>This month's analysis allowance and security records</li>
        </ul>
      </section>
    </div>

    <section class="reset-card" aria-labelledby="confirmation-heading">
      <h2 id="confirmation-heading">Confirm this reset</h2>
      {% if error %}<p class="reset-error" role="alert">{{ error }}</p>{% endif %}

      {% if recent_auth_required %}
        <p class="reauth-note">To protect a signed-in browser that may have been left open, authenticate again before deleting its history.</p>
        <div class="reset-actions">
          <form action="{% if shopify_customer_accounts_enabled and user.shopify_account_migration_state == 'shopify_authenticated' %}/auth/shopify/logout{% else %}/logout{% endif %}" method="post">
            <button type="submit">Sign out to authenticate again</button>
          </form>
          <a class="reset-cancel" href="/account">Cancel</a>
        </div>
      {% else %}
        <form class="reset-form" action="/account/history/delete" method="post">
          <input type="hidden" name="nonce" value="{{ nonce }}">
          <label for="history-confirmation">Type <code class="reset-code">{{ confirmation_phrase }}</code> exactly</label>
          <input id="history-confirmation" name="confirmation" type="text" required autocomplete="off" spellcheck="false">
          {% if user.has_password %}
            <label for="history-password">Current password</label>
            <input id="history-password" name="password" type="password" required autocomplete="current-password">
          {% endif %}
          <div class="reset-actions">
            <button class="danger-button" type="submit">Delete swing history</button>
            <a class="reset-cancel" href="/account">Cancel</a>
          </div>
        </form>
      {% endif %}
    </section>
  </div>
{% endblock %}
