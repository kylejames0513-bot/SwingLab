{% extends "web_layout.html.j2" %}
{% block title %}{{ brand.name }} — Gear{% endblock %}
{% block style %}
  main { max-width: 900px; }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
          gap: 20px; margin-top: 24px; }
  a.product { background: white; border: 1px solid #e0e0e0; border-radius: 8px;
              padding: 16px; text-decoration: none; color: inherit;
              display: flex; flex-direction: column; }
  a.product:hover { border-color: var(--primary); }
  a.product img { width: 100%; aspect-ratio: 1; object-fit: cover;
                  border-radius: 6px; background: #f0f0f0; }
  a.product h3 { margin: 12px 0 4px; font-size: 1rem; color: var(--primary); }
  .price { font-weight: 600; margin: 0 0 8px; }
  .desc { color: #555; font-size: 0.88rem; margin: 0; }
  .sold-out { color: #b3261e; font-size: 0.85rem; }
{% endblock %}
{% block main %}
  <h2>Golf gear</h2>
  <p class="hint">Browse the broader store here. When an available training aid
    directly matches a measured swing priority, CaddieInsight explains that
    match after your coaching brief. Your drills work without a purchase;
    checkout happens in our Shopify store.</p>
  {% if products %}
    <div class="grid">
      {% for p in products %}
        <a class="product" href="{{ p.url }}">
          {% if p.image %}<img src="{{ p.image }}" alt="{{ p.image_alt or p.title }}" loading="lazy">{% endif %}
          <h3>{{ p.title }}</h3>
          <p class="price">{{ p.price_display }}
            {%- if not p.available %} <span class="sold-out">— sold out</span>{% endif %}</p>
          {% if p.description %}<p class="desc">{{ p.description }}</p>{% endif %}
        </a>
      {% endfor %}
    </div>
  {% else %}
    <div class="card"><p>The shop is being restocked—check back soon. Your
      report's drills still include everything needed to practice.</p></div>
  {% endif %}
{% endblock %}
