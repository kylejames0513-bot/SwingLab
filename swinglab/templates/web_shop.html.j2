{% extends "web_layout.html.j2" %}
{% block title %}{{ brand.name }} — Gear{% endblock %}
{% block style %}
  main { max-width: 1040px; }
  .shop-intro { max-width: 720px; margin-bottom: 30px; }
  .shop-intro h1 { margin: 0 0 10px; color: var(--sl-green); font-size: clamp(2.2rem, 6vw, 3.8rem); line-height: 1; letter-spacing: -.048em; }
  .shop-intro .hint { max-width: 680px; font-size: .98rem; }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
          gap: 20px; align-items: stretch; margin-top: 24px; }
  a.product { background: var(--sl-bg-card); border: 1px solid var(--sl-border); border-radius: var(--sl-radius-lg);
              height: 100%; overflow: hidden; text-decoration: none; color: inherit;
              display: flex; flex-direction: column; box-shadow: var(--sl-shadow-sm); transition: border-color .18s ease, transform .18s ease, box-shadow .18s ease; }
  a.product:hover { border-color: var(--sl-green-btn); transform: translateY(-2px); box-shadow: var(--sl-shadow-md); }
  a.product img { width: 100%; aspect-ratio: 20 / 13; object-fit: cover; background: #f0f0f0; }
  .product__body { padding: 18px; display: flex; flex: 1; flex-direction: column; }
  a.product h2 { margin: 0 0 7px; font-size: 1rem; color: var(--sl-green); }
  .price { order: 3; font-weight: 700; margin: 16px 0 0; color: var(--sl-green); }
  .desc { flex: 1; color: var(--sl-ink-soft); font-size: 0.88rem; margin: 0; }
  .sold-out { color: #b3261e; font-size: 0.85rem; }
  @media (prefers-reduced-motion: reduce) { a.product:hover { transform: none; } }
{% endblock %}
{% block main %}
  <header class="shop-intro">
    <p class="sl-eyebrow">Optional tools for the work</p>
    <h1>Golf gear</h1>
    <p class="hint">Browse the broader store here. When an available training aid
      directly matches a measured swing priority, CaddieInsight explains that
      match after your coaching brief. Your drills work without a purchase;
      checkout happens in our Shopify store.</p>
  </header>
  {% if products %}
    <div class="grid">
      {% for p in products %}
        <a class="product" href="{{ p.url }}">
          {% if p.image %}<img src="{{ p.image }}" alt="{{ p.image_alt or p.title }}" loading="lazy">{% endif %}
          <div class="product__body">
            <h2>{{ p.title }}</h2>
            {% if p.description %}<p class="desc">{{ p.description }}</p>{% endif %}
            <p class="price">{{ p.price_display }}
              {%- if not p.available %} <span class="sold-out">— sold out</span>{% endif %}</p>
          </div>
        </a>
      {% endfor %}
    </div>
  {% else %}
    <div class="card"><p>{% if first_sale_gate_active %}Practice aids are
      shown here only after sample-tested fulfillment, tracking, and return
      evidence are verified. Check back soon.{% else %}The shop is being
      restocked—check back soon.{% endif %} Your report's drills still include
      everything needed to practice.</p></div>
  {% endif %}
{% endblock %}
