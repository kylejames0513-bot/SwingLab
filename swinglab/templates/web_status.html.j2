{% extends "web_layout.html.j2" %}
{% block title %}{{ brand.name }} — {{ "Results ready" if done else ("Analysis failed" if failed else "Analyzing…") }}{% endblock %}
{% block style %}
  .spinner { width: 28px; height: 28px; border: 4px solid #ddd;
             border-top-color: var(--accent); border-radius: 50%;
             animation: spin 0.9s linear infinite; display: inline-block;
             vertical-align: middle; margin-right: 12px; }
  @keyframes spin { to { transform: rotate(360deg); } }
  .log { background: #f4f4f4; border-radius: 6px; padding: 12px 16px;
         font-family: ui-monospace, monospace; font-size: 0.85rem;
         white-space: pre-wrap; margin-top: 16px; max-height: 240px; overflow-y: auto; }
{% endblock %}
{% block main %}
  <div class="card">
    {% if done %}
      <h2>Results ready</h2>
      <p>Your swing analysis is finished{% if job.swings_total %} —
        {{ job.swings_total }} swing{{ "s" if job.swings_total != 1 }} analyzed{% endif %}.</p>
      <a class="button" href="/session/{{ job.id }}/report">View report</a>
      <a class="button secondary" href="/">Analyze another clip</a>
    {% elif failed %}
      <h2>Analysis failed</h2>
      <p class="error">{{ job.error }}</p>
      <p>If your clip does contain swings, try uploading again with manual
         strike times filled in.</p>
      <a class="button" href="/">Try again</a>
    {% else %}
      <h2 id="live-title"><span class="spinner"></span>{% if queue_position %}Waiting in line…{% else %}Analyzing your swing…{% endif %}</h2>
      <div class="bar" id="live-bar-wrap" {% if not job.swings_total %}style="display:none"{% endif %}>
        <div id="live-bar" style="width: {{ (100 * job.swings_done / job.swings_total) | round(0, 'floor') | int if job.swings_total else 0 }}%"></div>
      </div>
      <p class="bar-label" id="live-label">
        {%- if queue_position -%}
          You are #{{ queue_position }} in line — the analysis starts automatically.
        {%- elif job.swings_total -%}
          Swing {{ [job.swings_done + 1, job.swings_total] | min }} of {{ job.swings_total }}
          {{- " — fast mode." if job.fast else " — slow motion rendering is the long step." }}
        {%- else -%}
          Reading the video and listening for ball strikes…
        {%- endif -%}
      </p>
      <p class="hint">This page updates live — no need to reload. You can also
        come back later; the link keeps working.</p>
    {% endif %}
    {% if job.log %}<div class="log" id="live-log">{{ job.log | join("\n") }}</div>
    {% else %}<div class="log" id="live-log" style="display:none"></div>{% endif %}
  </div>
{% endblock %}
{% block script %}
{% if not done and not failed %}
<script>
(function () {
  var title = document.getElementById("live-title");
  var barWrap = document.getElementById("live-bar-wrap");
  var bar = document.getElementById("live-bar");
  var label = document.getElementById("live-label");
  var logEl = document.getElementById("live-log");

  function apply(data) {
    if (data.status === "done" || data.status === "failed") {
      window.location.reload();  // server renders the final page
      return;
    }
    if (data.status === "queued" && data.queue_position) {
      title.innerHTML = '<span class="spinner"></span>Waiting in line…';
      label.textContent = "You are #" + data.queue_position
        + " in line — the analysis starts automatically.";
    } else {
      title.innerHTML = '<span class="spinner"></span>Analyzing your swing…';
      if (data.swings_total) {
        barWrap.style.display = "";
        bar.style.width = Math.floor(100 * data.swings_done / data.swings_total) + "%";
        var current = Math.min(data.swings_done + 1, data.swings_total);
        label.textContent = "Swing " + current + " of " + data.swings_total
          + (data.fast ? " — fast mode." : " — slow motion rendering is the long step.");
      } else {
        label.textContent = "Reading the video and listening for ball strikes…";
      }
    }
    if (data.log && data.log.length) {
      logEl.style.display = "";
      logEl.textContent = data.log.join("\n");
      logEl.scrollTop = logEl.scrollHeight;
    }
  }

  function poll() {
    fetch("/api/session/{{ job.id }}", { headers: { "Accept": "application/json" } })
      .then(function (resp) { return resp.json(); })
      .then(apply)
      .catch(function () { /* transient network/restart hiccup — keep polling */ });
  }
  poll();
  setInterval(poll, 1500);
})();
</script>
{% endif %}
{% endblock %}
