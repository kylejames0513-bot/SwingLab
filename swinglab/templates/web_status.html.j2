{% extends "web_layout.html.j2" %}
{% block title %}{{ brand.name }} — {{ "Re-film needed" if refilm_needed else ("Results ready" if done else ("Analysis failed" if failed else "Analyzing…")) }}{% endblock %}
{% block style %}
  {# This page is the instrument's live face. One panel: a ruled verdict band
     that states where the machine currently stands, then a body that is either
     a live readout or the measured result. Every surface below is a hairline
     rule or a well — the light-era build leaned on tinted blocks and drop
     shadows, and neither survives on a near-black field. #}
  main { max-width: 940px; }
  .status-surface {
    overflow: hidden;
    padding: 0;
    border-radius: var(--sl-radius-lg);
  }

  {# ----------------------------------------------------------- the band
     The verdict band is a well, not a hero: darker than the panel around it
     and carrying the same 8px technical grid the shell paints under the page,
     so the header reads as part of one instrument instead of a coloured
     banner bolted on top.

     State used to be a background tint (#633117 for attention, #173b2a for
     waiting). On the field a tinted block is just a smudge — indistinguishable
     from the panel at a glance and impossible to keep on the contrast rungs.
     State is now a 2px rule along the top edge plus the kicker colour, which
     survives at any brightness and never touches the body text. #}
  .state-hero {
    position: relative;
    padding: var(--sl-space-5);
    background:
      radial-gradient(circle at 92% 0, rgba(var(--sl-wash-rgb), .05), transparent 20rem),
      var(--sl-night);
    background-size: 8px 8px, 8px 8px, auto, auto;
    border-bottom: 1px solid var(--sl-border-strong);
    color: var(--sl-ink);
    box-shadow: inset 0 2px 0 var(--sl-border-strong);
  }
  {# CYAN IS THE LIVE READ. Queued and analyzing are the only moments this page
     is actually reading something, so they are the only states that take the
     trace colour — on the top rule, the kicker, the spinner and the bar. #}
  .state-hero--waiting { box-shadow: inset 0 2px 0 var(--sl-trace); }
  {# A stopped run and an unusable clip are error states, so they take the
     error token. Amber is not available here: amber means the engine measured
     something, and "we could not finish" is the absence of a measurement. #}
  .state-hero--attention { box-shadow: inset 0 2px 0 var(--sl-danger); }
  .result-kicker {
    margin: 0 0 var(--sl-space-3);
    color: var(--sl-ink-muted);
    font-family: var(--sl-font-mono);
    font-size: var(--sl-eyebrow-size);
    font-weight: 500;
    letter-spacing: var(--sl-eyebrow-track);
    line-height: 1;
    text-transform: uppercase;
  }
  .state-hero--waiting .result-kicker { color: var(--sl-trace); }
  .state-hero--attention .result-kicker { color: var(--sl-danger); }
  .state-hero h1 {
    max-width: 20ch;
    margin: 0;
    color: var(--sl-ink);
    font-family: var(--sl-font-display);
    font-size: var(--sl-heading-display);
    font-weight: 600;
    letter-spacing: -.02em;
    line-height: .98;
    text-transform: uppercase;
    text-wrap: balance;
  }
  .state-summary {
    max-width: 56ch;
    margin: var(--sl-space-4) 0 0;
    color: var(--sl-ink-soft);
    font-size: var(--sl-text-lg);
    line-height: 1.55;
    text-wrap: pretty;
  }
  .state-body { padding: var(--sl-space-5); }

  {# Sized in em rather than px so the ring tracks the display heading it sits
     inside — at the top of the clamp the old fixed 24px read as a speck next
     to a 54px line. #}
  .spinner {
    display: inline-block;
    width: .48em;
    height: .48em;
    margin-right: .28em;
    vertical-align: .04em;
    border: 2px solid rgba(var(--sl-trace-rgb), .22);
    border-top-color: var(--sl-trace);
    border-radius: 50%;
    animation: spin .9s linear infinite;
  }
  @keyframes spin { to { transform: rotate(360deg); } }

  {# The bar IS the live readout, so it is trace and nothing else on the page
     competes for that colour. The track is a well so the fill reads as light
     coming through rather than a block painted onto a card. #}
  .status-progress {
    width: 100%;
    height: 10px;
    margin: 0;
    overflow: hidden;
    background: var(--sl-night);
    border: 1px solid var(--sl-border-strong);
    border-radius: var(--sl-radius-sm);
  }
  .status-progress__fill {
    height: 100%;
    min-width: 0;
    background: var(--sl-trace);
    transition: width .35s ease;
  }
  .status-progress.is-indeterminate .status-progress__fill {
    width: 38% !important;
    background: linear-gradient(90deg, transparent, var(--sl-trace), transparent);
    animation: status-indeterminate 1.4s ease-in-out infinite;
  }
  @keyframes status-indeterminate {
    from { transform: translateX(-105%); }
    to { transform: translateX(265%); }
  }
  {# The count under the bar is a readout, not a heading: mono, trace, sitting
     directly under the thing it describes. #}
  .bar-label {
    margin: var(--sl-space-3) 0 0;
    color: var(--sl-trace);
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-sm);
    font-weight: 500;
    letter-spacing: .04em;
  }
  .processing-note { margin-bottom: 0; }

  {# ------------------------------------------------------- the result
     A 1px-gap bordered grid: the gap IS the rule, so adjacent panels share one
     hairline instead of stacking two and drifting to 2px. #}
  .coach-intro {
    max-width: 62ch;
    margin: 0 0 var(--sl-space-5);
    color: var(--sl-ink-soft);
  }
  .result-path {
    display: grid;
    gap: 1px;
    overflow: hidden;
    background: var(--sl-border);
    border: 1px solid var(--sl-border);
    border-radius: var(--sl-radius-md);
  }
  .coach-block {
    margin: 0;
    padding: var(--sl-space-5);
    background: var(--sl-bg-card);
  }
  {# The priority panel is the one thing this page exists to deliver, so it
     takes the dark amber wash — the only surface on the page that is not the
     panel colour. #}
  .coach-block.focus { background: var(--sl-orange-soft); }
  .coach-block h2,
  .coach-block h3 {
    margin: 0 0 var(--sl-space-3);
    color: var(--sl-ink-muted);
    font-family: var(--sl-font-mono);
    font-size: var(--sl-eyebrow-size);
    font-weight: 500;
    letter-spacing: var(--sl-eyebrow-track);
    line-height: 1;
    text-transform: uppercase;
  }
  {# "Fix first" / "Protect" is the engine's verdict on a measurement, which is
     what amber is for. 9.43:1 on the wash. #}
  .coach-block.focus h2 { color: var(--sl-orange-text); }
  .coach-block p { margin: var(--sl-space-2) 0; }
  .coach-block p strong { color: var(--sl-ink); }
  {# The focus name is a label and the value after the em dash is what the
     engine measured, so only the number is amber. Colouring the whole line
     would spend the signal on a heading and leave nothing to mark the reading
     itself. #}
  .coach-value {
    color: var(--sl-orange);
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-lg);
    font-weight: 500;
  }
  .coach-value strong {
    color: var(--sl-ink);
    font-family: var(--sl-font-display);
    font-weight: 600;
    letter-spacing: -.01em;
    text-transform: uppercase;
  }
  .coach-value .bench {
    color: var(--sl-ink-muted);
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-xs);
    font-weight: 400;
  }
  {# A caveat about measurement quality, not a system error — dark wash and a
     hairline, with the lead-in carrying the amber because it qualifies a
     reading. The old #fff8df on #5b420c was a light-surface callout and would
     have shipped as a glare panel. #}
  .coach-warning {
    margin: 0 0 var(--sl-space-5);
    padding: var(--sl-space-4);
    color: var(--sl-ink);
    background: var(--sl-orange-soft);
    border: 1px solid var(--sl-border-strong);
    border-radius: var(--sl-radius-md);
  }
  .coach-warning strong { color: var(--sl-orange-text); }
  .coach-trend {
    margin: var(--sl-space-5) 0 0;
    color: var(--sl-ink-soft);
    font-size: var(--sl-text-sm);
  }
  .coach-trend strong { color: var(--sl-ink); }
  .coach-actions {
    margin-top: var(--sl-space-5);
    display: flex;
    flex-wrap: wrap;
    gap: var(--sl-space-3);
    align-items: center;
  }
  .coach-actions .button { margin-top: 0; }
  {# DEFECT, fixed here rather than in the shell. The shell's button rule still
     carries `color: white` from the light era; --sl-green-btn is bone now, so
     that pairs white on near-white at 1.06:1 — an invisible label on every
     primary action this page renders. The shell is out of scope for this pass,
     so the ink it was always meant to carry is pinned locally.

     Bone on the field with a hairline. A button is never amber: amber means
     the engine measured something, and an action is not a measurement. The
     lift-and-drop-shadow is dropped too — a drop shadow is invisible on
     near-black, and an instrument does not bounce. #}
  .coach-actions .button,
  .coach-actions .button:hover,
  .coach-actions .button:active {
    color: var(--sl-green-ink);
    box-shadow: var(--sl-shadow-sm);
    transform: none;
  }
  .coach-actions .button:hover {
    background: var(--sl-ink);
    border-color: var(--sl-ink);
  }
  {# --sl-control-border, never --sl-border: this is an interactive edge and
     the decorative hairline sits at 1.33:1, under WCAG 1.4.11's 3:1. #}
  .coach-actions .button.secondary {
    background: transparent;
    border-color: var(--sl-control-border);
    color: var(--sl-ink);
  }
  .coach-actions .button.secondary:hover {
    background: rgba(var(--sl-wash-rgb), .06);
    border-color: var(--sl-ink);
    color: var(--sl-ink);
  }

  {# ------------------------------------------------------ the proof cycle #}
  .proof-stack {
    margin-top: var(--sl-space-5);
    display: grid;
    gap: 1px;
    overflow: hidden;
    background: var(--sl-border);
    border: 1px solid var(--sl-border);
    border-radius: var(--sl-radius-md);
  }
  .proof-cycle {
    margin: 0;
    padding: var(--sl-space-5);
    background: var(--sl-bg-card);
    border-left: 2px solid var(--sl-border-strong);
  }
  {# Tone rides the left rule, not a tinted panel. Both signal colours are
     already spoken for — amber is a measured value, cyan is the live read — so
     a confirmed cycle takes bone (the instrument's own ink), an unresolved one
     takes the control hairline, and a regression takes the error token. #}
  .proof-cycle.positive { border-left-color: var(--sl-ink); }
  .proof-cycle.neutral { border-left-color: var(--sl-control-border); }
  .proof-cycle.attention { border-left-color: var(--sl-danger); }
  .proof-cycle-kicker {
    margin: 0 0 var(--sl-space-2);
    color: var(--sl-ink-muted);
    font-family: var(--sl-font-mono);
    font-size: var(--sl-eyebrow-size);
    font-weight: 500;
    letter-spacing: var(--sl-eyebrow-track);
    line-height: 1;
    text-transform: uppercase;
  }
  .proof-cycle h2 {
    margin: 0 0 var(--sl-space-2);
    color: var(--sl-ink);
    font-family: var(--sl-font-display);
    font-size: var(--sl-text-lg);
    font-weight: 600;
    text-transform: uppercase;
  }
  .proof-cycle p { margin: var(--sl-space-2) 0; }
  .proof-cycle p strong { color: var(--sl-ink); }

  {# ---------------------------------------------------------- failure
     A well with an error rule down its edge. The message inside keeps the
     shell's .error token (7.62:1); the old #fff3ef on #e9b7a8 was a
     light-surface pink and reads as a bright bruise on the field. #}
  .failure-panel {
    padding: var(--sl-space-5);
    background: var(--sl-night);
    border: 1px solid var(--sl-border-strong);
    border-left: 2px solid var(--sl-danger);
    border-radius: var(--sl-radius-md);
  }
  .failure-panel h2 {
    margin: 0 0 var(--sl-space-3);
    color: var(--sl-ink-muted);
    font-family: var(--sl-font-mono);
    font-size: var(--sl-eyebrow-size);
    font-weight: 500;
    letter-spacing: var(--sl-eyebrow-track);
    line-height: 1;
    text-transform: uppercase;
  }
  .failure-panel .error { margin-top: 0; font-size: var(--sl-text-base); font-style: normal; }
  .failure-panel ul { margin: var(--sl-space-2) 0 0; padding-left: 1.15em; }
  .failure-panel li { margin: var(--sl-space-1) 0; color: var(--sl-ink-soft); }

  {# ------------------------------------------------------------ the log #}
  .technical-details {
    margin-top: var(--sl-space-6);
    padding-top: var(--sl-space-2);
    border-top: 1px solid var(--sl-border);
  }
  {# 44px minimum target, bought with padding so the summary keeps
     display: list-item and its disclosure marker — display: flex here would
     silently delete the triangle in Chromium. Hover goes to trace, the shell's
     idiom for an interactive text colour, never to amber. #}
  .technical-details summary {
    min-height: 44px;
    padding: var(--sl-space-3) 0;
    color: var(--sl-ink-soft);
    cursor: pointer;
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-sm);
    font-weight: 500;
    letter-spacing: .04em;
  }
  .technical-details summary:hover { color: var(--sl-ink-hi); }
  .log {
    max-height: 240px;
    margin: var(--sl-space-3) 0 0;
    padding: var(--sl-space-4);
    overflow-y: auto;
    color: var(--sl-ink-soft);
    background: var(--sl-night);
    border: 1px solid var(--sl-border);
    border-radius: var(--sl-radius-sm);
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-xs);
    line-height: 1.65;
    white-space: pre-wrap;
  }

  {# ----------------------------------------------------------- the gear #}
  .gear-heading {
    margin: var(--sl-space-6) 0 0;
    color: var(--sl-ink);
    font-family: var(--sl-font-display);
    font-size: var(--sl-text-lg);
    font-weight: 600;
    text-transform: uppercase;
  }
  .gear {
    margin-top: var(--sl-space-3);
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
    gap: 1px;
    overflow: hidden;
    background: var(--sl-border);
    border: 1px solid var(--sl-border);
    border-radius: var(--sl-radius-md);
  }
  a.gear-item {
    padding: var(--sl-space-3);
    color: var(--sl-ink);
    text-decoration: none;
    background: var(--sl-bg-card);
    font-size: var(--sl-text-sm);
  }
  a.gear-item:hover { background: var(--sl-orange-soft); }
  a.gear-item img {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    background: var(--sl-night);
    border-radius: var(--sl-radius-sm);
  }
  {# The card kills the shell underline, so the title carries it instead —
     the shell's rule is that a bone link needs a second signal, and a bordered
     tile is not one on a page made entirely of bordered tiles. #}
  a.gear-item .name {
    display: block;
    margin-top: var(--sl-space-2);
    color: var(--sl-ink);
    text-decoration: underline;
    text-decoration-color: rgba(var(--sl-wash-rgb), .32);
    text-underline-offset: .2em;
  }
  a.gear-item:hover .name { text-decoration-color: currentColor; }
  {# A store price is not something the engine measured, so it stays bone mono.
     Spending the signal colour here would make a shop listing read as a swing
     metric — the exact confusion rule 1 exists to prevent. #}
  a.gear-item .price {
    display: block;
    margin-top: var(--sl-space-1);
    color: var(--sl-ink-soft);
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-sm);
    font-weight: 500;
  }

  @media (min-width: 560px) {
    .state-hero,
    .state-body { padding: var(--sl-space-6); }
  }
  @media (min-width: 1000px) {
    .state-hero { padding: var(--sl-space-7) var(--sl-space-6); }
  }
  @media (max-width: 749px) {
    .status-surface { border-radius: var(--sl-radius-md); }
    .coach-actions { align-items: stretch; flex-direction: column; }
    .coach-actions .button { width: 100%; }
  }
  .sl-reduced-motion .spinner,
  .sl-reduced-motion .status-progress.is-indeterminate .status-progress__fill { animation: none; }
  .sl-reduced-motion .status-progress.is-indeterminate .status-progress__fill {
    width: 100% !important;
    opacity: .42;
    transform: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .spinner, .status-progress.is-indeterminate .status-progress__fill { animation: none; }
    .status-progress.is-indeterminate .status-progress__fill { width: 100% !important; opacity: .42; transform: none; }
  }
{% endblock %}
{% block main %}
  <div class="card status-surface">
    {% if done %}
      {% if caddie_brief and caddie_brief.refilm_required %}
      <header class="state-hero state-hero--attention">
        <p class="result-kicker">Re-film needed · clip reviewed</p>
        <h1>Re-film before coaching</h1>
        <p class="state-summary">The clip was reviewed, but the measurements
          are not trustworthy enough to choose a swing change. Fix the capture
          first.</p>
      </header>
      {% elif caddie_brief %}
      <header class="state-hero">
        <p class="result-kicker">Results ready{% if job.swings_total %} ·
          {{ job.swings_total }} swing{{ "s" if job.swings_total != 1 }} measured{% endif %}</p>
        <h1>Your caddie's read</h1>
        <p class="state-summary">Start with one measured priority, follow its
          practice plan, then re-film with the same setup.</p>
      </header>
      {% elif legacy_report %}
      <header class="state-hero">
        <p class="result-kicker">Report available</p>
        <h1>Results ready</h1>
        <p class="state-summary">The original report is still available for
          this session. Its limits are explained below.</p>
      </header>
      {% else %}
      <header class="state-hero state-hero--attention">
        <p class="result-kicker">Re-film needed · clip reviewed</p>
        <h1>Re-film before coaching</h1>
        <p class="state-summary">This clip did not produce enough readable
          motion data to support a swing change.</p>
      </header>
      {% endif %}
    {% elif failed %}
      <header class="state-hero state-hero--attention">
        <p class="result-kicker">Analysis failed</p>
        <h1>We couldn’t finish this swing.</h1>
        <p class="state-summary">The analysis stopped before a coaching result
          was created. Use the visible next steps below and try again.</p>
      </header>
    {% else %}
      <header class="state-hero state-hero--waiting">
        <p class="result-kicker">{{ "Waiting in line" if queue_position else "Analysis in progress" }}</p>
        <h1 id="live-title"><span class="spinner" aria-hidden="true"></span>{% if queue_position %}Waiting in line…{% else %}Analyzing your swing…{% endif %}</h1>
        <p class="state-summary">{% if queue_position %}Your upload is queued
          and will start automatically.{% else %}The video is being read now.
          This page will move to your result when it is ready.{% endif %}</p>
      </header>
    {% endif %}

    <div class="state-body">
      {% if done %}
        {% if caddie_brief %}
          {% if caddie_brief.refilm_required %}
          <p class="coach-warning"><strong>Why this session stopped:</strong>
            {{ caddie_brief.warning }}</p>
          <div class="result-path">
            <section class="coach-block focus">
              <h2>Do this first</h2>
              <p class="coach-value"><strong>{{ caddie_brief.focus_name }}</strong></p>
              <p>{{ caddie_brief.why }}</p>
              <p><strong>Next:</strong> {{ caddie_brief.fix }}</p>
            </section>
          </div>
          <div class="coach-actions">
            <a class="button" href="/">Re-film with the checklist</a>
            {% if capture_report_available %}
            <a class="button secondary" href="/session/{{ job.id }}/report">Review capture details</a>
            {% endif %}
          </div>
          {% if require_account %}
          <p class="hint">The first rejected clip each month does not use an
            analysis. Every later upload uses the normal allowance, whether it
            produces coaching or needs another re-film.</p>
          {% endif %}
          {% else %}
          <p class="coach-intro">One clear next step from this session's actual
            measurements—not another wall of numbers.</p>

          {% if caddie_brief.warning %}
          <p class="coach-warning"><strong>Measurement note:</strong>
            {{ caddie_brief.warning }}</p>
          {% endif %}

          <div class="result-path">
            <section class="coach-block focus">
              <h2>{{ "Protect" if caddie_brief.clean else "Fix first" }}</h2>
              <p class="coach-value"><strong>{{ caddie_brief.focus_name }}</strong>
                {% if caddie_brief.focus_value %} — {{ caddie_brief.focus_value }}
                  {% if caddie_brief.benchmark_text %}
                  <span class="bench">({{ caddie_brief.benchmark_text }})</span>
                  {% endif %}
                {% endif %}
              </p>
              <p>{{ caddie_brief.why }}</p>
              <p><strong>Coach's cue:</strong> {{ caddie_brief.fix }}</p>
              {% if caddie_brief.recurring_sessions > 1 %}
              <p class="hint">This priority has appeared in
                {{ caddie_brief.recurring_sessions }} comparable sessions.</p>
              {% endif %}
              {% if caddie_brief.remaining_issues %}
              <p class="hint">{{ caddie_brief.remaining_issues }} other measured
                issue{{ "s" if caddie_brief.remaining_issues != 1 }} stays in the
                full report for later. Work on one thing first.</p>
              {% endif %}
            </section>

            <section class="coach-block">
              <h2>Practice this</h2>
              <p><strong>{{ caddie_brief.drill.name }}</strong> —
                {{ caddie_brief.drill.aim }}</p>
              <p><strong>Dosage:</strong> {{ caddie_brief.drill.dosage }}<br>
                <strong>Pass mark:</strong> {{ caddie_brief.drill.success_metric }}</p>
            </section>

            {% if caddie_brief.strength %}
            <section class="coach-block">
              <h2>Keep</h2>
              <p>{{ caddie_brief.strength }}</p>
            </section>
            {% endif %}
          </div>

          {% if proof_cycle or proof_cycle_practice %}<div class="proof-stack">{% endif %}
          {% if proof_cycle %}
          <section class="proof-cycle {{ proof_cycle.tone }}" data-proof-cycle>
            <p class="proof-cycle-kicker">Proof Cycle · {{ proof_cycle.target_name }}</p>
            <h2>{{ proof_cycle.heading }}</h2>
            <p><strong>{{ proof_cycle.summary }}</strong></p>
            <p>{{ proof_cycle.detail }}</p>
            <p><strong>Next:</strong> {{ proof_cycle.next_step }}</p>
            {% if proof_cycle.accepted_refilm_count %}
            <p class="hint">{{ proof_cycle.accepted_refilm_count }} matched follow-up{{ "s" if proof_cycle.accepted_refilm_count != 1 }} counted.</p>
            {% endif %}
          </section>
          {% endif %}

          {% if proof_cycle_practice %}
          <section class="proof-cycle {{ proof_cycle_practice.tone }}" data-proof-cycle-practice>
            <p class="proof-cycle-kicker">Practice-to-re-film context</p>
            <h2>{{ proof_cycle_practice.heading }}</h2>
            <p><strong>{{ proof_cycle_practice.summary }}</strong></p>
            <p>{{ proof_cycle_practice.detail }}</p>
            <p><strong>Next:</strong> {{ proof_cycle_practice.next_step }}</p>
            {% if proof_cycle_practice.practice_session_count %}
            <p class="hint">{{ proof_cycle_practice.practice_session_count }} self-reported practice receipt{{ "s" if proof_cycle_practice.practice_session_count != 1 }} · {{ proof_cycle_practice.practice_minutes }} minutes total.</p>
            {% endif %}
          </section>
          {% endif %}
          {% if proof_cycle or proof_cycle_practice %}</div>{% endif %}

          {% if caddie_brief.trend %}
          <p class="coach-trend"><strong>Your journal:</strong>
            {{ caddie_brief.trend }}.</p>
          {% endif %}

          <div class="coach-actions">
            {# With accounts on, practice lives on /today's practice panel;
               open instances have no /today, so the upload page stands in. #}
            <a class="button" href="{% if require_account %}/today#practice-plan{% else %}/{% endif %}">Practice, then re-film</a>
            <a class="button secondary" href="/session/{{ job.id }}/report">See your full coaching plan</a>
          </div>

          {% if gear %}
            <h2 class="gear-heading">Optional aid for {{ caddie_brief.focus_name }}</h2>
            <p class="hint">No purchase is required—the drill above is complete
              as written. This item appears only because its Shopify tag matches
              this session's first measured priority.</p>
            <div class="gear">
              {% for p in gear %}
                <a class="gear-item" href="{{ p.url }}" target="_blank" rel="noopener" data-gear-match data-session-id="{{ job.id }}">
                  {% if p.image %}<img src="{{ p.image }}" alt="{{ p.image_alt or p.title }}" loading="lazy">{% endif %}
                  <span class="name">{{ p.title }}</span>
                  <span class="price">{{ p.price_display }}</span>
                </a>
              {% endfor %}
            </div>
            <p><a href="/shop">Browse the full gear shop →</a></p>
          {% endif %}
          {% endif %}
        {% else %}
          {% if legacy_report %}
          {% if current_report_only %}
          <p>Your coaching report remains available. Its structured metrics
            could not be read, so progress comparisons stay paused for this
            session.</p>
          {% else %}
          <p>This session was created by an earlier CaddieInsight version.
            Its original report remains available.</p>
          {% endif %}
          <div class="coach-actions">
            <a class="button" href="/session/{{ job.id }}/report">View original report</a>
          </div>
          {% else %}
          <p>This clip did not produce enough readable motion data to choose a
            swing change. Re-film instead of practicing from incomplete
            measurements.</p>
          <div class="coach-actions">
            <a class="button" href="/">Re-film with the checklist</a>
            {% if capture_report_available %}
            <a class="button secondary" href="/session/{{ job.id }}/report">Review capture details</a>
            {% endif %}
          </div>
          {% endif %}
        {% endif %}
      {% elif failed %}
        <section class="failure-panel" aria-labelledby="failure-next-step">
          <h2 id="failure-next-step">What to do next</h2>
          <p class="error">{{ error_help.message if error_help else job.error }}</p>
          {% if error_help and error_help.tips %}
          <p><strong>Things to check:</strong></p>
          <ul>
            {% for tip in error_help.tips %}<li>{{ tip }}</li>{% endfor %}
          </ul>
          {% endif %}
          {% if error_help and error_help.checklist %}
          <p class="hint">The <a href="/#filming-checklist">filming checklist</a>
            covers all of this in one place.</p>
          {% endif %}
          <div class="coach-actions"><a class="button" href="/">Try again</a></div>
        </section>
      {% else %}
        <div class="status-progress{% if queue_position or not job.swings_total %} is-indeterminate{% endif %}"
             id="live-bar-wrap" role="progressbar" aria-labelledby="live-title"
             aria-describedby="live-label"{% if job.swings_total and not queue_position %}
             aria-valuemin="0" aria-valuemax="{{ job.swings_total }}"
             aria-valuenow="{{ job.swings_done }}"{% endif %}>
          <div class="status-progress__fill" id="live-bar"
               style="width: {{ (100 * job.swings_done / job.swings_total) | round(0, 'floor') | int if job.swings_total and not queue_position else 0 }}%"></div>
        </div>
        <p class="bar-label" id="live-label">
          {%- if queue_position -%}
            You are #{{ queue_position }} in line — the analysis starts automatically.
          {%- elif job.swings_total -%}
            Swing {{ [job.swings_done + 1, job.swings_total] | min }} of {{ job.swings_total }}
            {{- " — fast mode." if job.fast else " — slow motion rendering is the long step." }}
          {%- else -%}
            Reading the video and listening for ball strikes…
          {%- endif -%}
        </p>
        <p class="hint processing-note">This page updates live — no need to
          reload. You can also come back later; the link keeps working.</p>
      {% endif %}

      <details class="technical-details">
        <summary>Behind-the-scenes processing details</summary>
        <p class="hint">Raw processing messages are kept here in case support
          asks for them.</p>
        {% if job.log %}<div class="log" id="live-log">{{ job.log | join("\n") }}</div>
        {% else %}<div class="log" id="live-log" style="display:none"></div>{% endif %}
      </details>
    </div>
  </div>
{% endblock %}
{% block script %}
{% if not done and not failed %}
<script>
(function () {
  var title = document.getElementById("live-title");
  var barWrap = document.getElementById("live-bar-wrap");
  var bar = document.getElementById("live-bar");
  var label = document.getElementById("live-label");
  var logEl = document.getElementById("live-log");

  function apply(data) {
    if (data.status === "done" || data.status === "failed") {
      window.location.reload();  // server renders the final page
      return;
    }
    if (data.status === "queued" && data.queue_position) {
      title.innerHTML = '<span class="spinner" aria-hidden="true"></span>Waiting in line…';
      barWrap.style.display = "";
      barWrap.classList.add("is-indeterminate");
      barWrap.removeAttribute("aria-valuemin");
      barWrap.removeAttribute("aria-valuemax");
      barWrap.removeAttribute("aria-valuenow");
      bar.style.width = "0%";
      label.textContent = "You are #" + data.queue_position
        + " in line — the analysis starts automatically.";
    } else {
      title.innerHTML = '<span class="spinner" aria-hidden="true"></span>Analyzing your swing…';
      if (data.swings_total) {
        barWrap.style.display = "";
        barWrap.classList.remove("is-indeterminate");
        barWrap.setAttribute("aria-valuemin", "0");
        barWrap.setAttribute("aria-valuemax", data.swings_total);
        barWrap.setAttribute("aria-valuenow", data.swings_done);
        bar.style.width = Math.floor(100 * data.swings_done / data.swings_total) + "%";
        var current = Math.min(data.swings_done + 1, data.swings_total);
        label.textContent = "Swing " + current + " of " + data.swings_total
          + (data.fast ? " — fast mode." : " — slow motion rendering is the long step.");
      } else {
        barWrap.style.display = "";
        barWrap.classList.add("is-indeterminate");
        barWrap.removeAttribute("aria-valuemin");
        barWrap.removeAttribute("aria-valuemax");
        barWrap.removeAttribute("aria-valuenow");
        bar.style.width = "0%";
        label.textContent = "Reading the video and listening for ball strikes…";
      }
    }
    barWrap.setAttribute("aria-valuetext", label.textContent);
    if (data.log && data.log.length) {
      logEl.style.display = "";
      logEl.textContent = data.log.join("\n");
      logEl.scrollTop = logEl.scrollHeight;
    }
  }

  function poll() {
    fetch("/api/session/{{ job.id }}", { headers: { "Accept": "application/json" } })
      .then(function (resp) { return resp.json(); })
      .then(apply)
      .catch(function () { /* transient network/restart hiccup — keep polling */ });
  }
  poll();
  setInterval(poll, 1500);
})();
</script>
{% endif %}
{% if gear %}
<script>
  (function () {
    var items = document.querySelectorAll('[data-gear-match]');
    for (var i = 0; i < items.length; i++) {
      items[i].addEventListener('click', function () {
        fetch('/api/v1/events', {
          method: 'POST', credentials: 'same-origin',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ event: 'gear_match_clicked', session_id: this.getAttribute('data-session-id') })
        }).catch(function () { /* measurement must not interrupt the store link */ });
      });
    }
  })();
</script>
{% endif %}
{% endblock %}
