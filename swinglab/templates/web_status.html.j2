<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
{% if not done and not failed %}<meta http-equiv="refresh" content="2">{% endif %}
<title>{{ brand.name }} — {{ "Results ready" if done else ("Analysis failed" if failed else "Analyzing…") }}</title>
<style>
  :root { --primary: {{ brand.primary_color }}; --accent: {{ brand.accent_color }}; }
  body { font-family: -apple-system, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
         margin: 0; background: #fafafa; color: #1c1c1c; }
  header { background: var(--primary); color: white; padding: 20px 32px; }
  header h1 { margin: 0; font-size: 1.5rem; }
  main { max-width: 640px; margin: 40px auto; padding: 0 24px; }
  .card { background: white; border: 1px solid #e0e0e0; border-radius: 8px; padding: 24px; }
  .spinner { width: 28px; height: 28px; border: 4px solid #ddd;
             border-top-color: var(--accent); border-radius: 50%;
             animation: spin 0.9s linear infinite; display: inline-block;
             vertical-align: middle; margin-right: 12px; }
  @keyframes spin { to { transform: rotate(360deg); } }
  .log { background: #f4f4f4; border-radius: 6px; padding: 12px 16px;
         font-family: ui-monospace, monospace; font-size: 0.85rem;
         white-space: pre-wrap; margin-top: 16px; max-height: 240px; overflow-y: auto; }
  .bar { background: #e6e6e6; border-radius: 6px; height: 14px; margin: 14px 0 6px; }
  .bar > div { background: var(--accent); border-radius: 6px; height: 100%;
               transition: width 0.4s; }
  .bar-label { color: #555; font-size: 0.9rem; }
  .error { color: #b3261e; white-space: pre-wrap; }
  a.button { display: inline-block; margin-top: 16px; background: var(--accent);
             color: white; padding: 12px 28px; border-radius: 6px; text-decoration: none; }
  footer { text-align: center; color: #777; font-size: 0.85rem; padding: 24px; }
</style>
</head>
<body>
<header><h1>{{ brand.name }}</h1></header>
<main>
  <div class="card">
    {% if done %}
      <h2>Results ready</h2>
      <p>Your swing analysis is finished.</p>
      <a class="button" href="/session/{{ job.id }}/report">View report</a>
    {% elif failed %}
      <h2>Analysis failed</h2>
      <p class="error">{{ job.error }}</p>
      <p>If your clip does contain swings, try uploading again with manual
         strike times filled in.</p>
      <a class="button" href="/">Try again</a>
    {% else %}
      <h2><span class="spinner"></span>Analyzing your swing…</h2>
      {% if job.swings_total %}
        <div class="bar"><div style="width: {{ (100 * job.swings_done / job.swings_total) | round(0, 'floor') | int }}%"></div></div>
        <p class="bar-label">Swing {{ [job.swings_done + 1, job.swings_total] | min }} of {{ job.swings_total }}
           — each swing takes roughly a minute; slow motion rendering is the long step.</p>
      {% else %}
        <p class="bar-label">Reading the video and listening for ball strikes…</p>
      {% endif %}
      <p>This page refreshes automatically — no need to reload.</p>
    {% endif %}
    {% if job.log %}<div class="log">{{ job.log | join("\n") }}</div>{% endif %}
  </div>
</main>
<footer>{{ brand.footer_text }}</footer>
</body>
</html>
