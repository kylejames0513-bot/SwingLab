__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/

# Local environment files may contain credentials; commit names/examples only.
.env
.env.*
!.env.example

# downloaded pose model (fetched and cached on first run)
swinglab/models/

# analysis output
results/

# web app sessions (uploads, deliverables, job database)
sessions/

# operator-created backup and scratch-restore output must stay outside the repo
/backup-output/
/restore-scratch/

# store-asset fonts (fetched with the commands in store-assets/README.md)
store-assets/*.ttf
# Isolated implementation worktrees.
/.worktrees/

# Historical agent task notes (not product source).
.superpowers/

# Build output: the theme zip and its upload notes are regenerated by
# `make theme-zip` (scripts/package_theme.py). A tracked zip is the exact
# cruft docs/superpowers/specs/2026-08-08-tour-caddie-v3-revamp-design.md
# called out.
dist/
