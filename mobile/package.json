{
  "name": "caddieinsight",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.13 <23"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "expo:doctor": "npx expo-doctor",
    "api:generate": "openapi-typescript ../docs/api/openapi-v1.json -o src/api/schema.generated.ts",
    "api:check": "openapi-typescript ../docs/api/openapi-v1.json -o /tmp/caddieinsight-schema.generated.ts && cmp -s src/api/schema.generated.ts /tmp/caddieinsight-schema.generated.ts"
  },
  "dependencies": {
    "@expo/ui": "~57.0.9",
    "@preeternal/react-native-file-hash": "^2.0.8",
    "@tanstack/react-query": "^5.101.4",
    "expo": "~57.0.11",
    "expo-application": "~57.0.2",
    "expo-audio": "~57.0.3",
    "expo-build-properties": "~57.0.9",
    "expo-camera": "~57.0.3",
    "expo-constants": "~57.0.9",
    "expo-crypto": "~57.0.1",
    "expo-dev-client": "~57.0.10",
    "expo-device": "~57.0.1",
    "expo-file-system": "~57.0.2",
    "expo-font": "~57.0.1",
    "expo-glass-effect": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-image": "~57.0.2",
    "expo-image-picker": "~57.0.8",
    "expo-linking": "~57.0.5",
    "expo-network": "~57.0.1",
    "expo-notifications": "~57.0.9",
    "expo-router": "~57.0.11",
    "expo-screen-orientation": "~57.0.1",
    "expo-secure-store": "~57.0.1",
    "expo-sharing": "~57.0.10",
    "expo-splash-screen": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.2",
    "expo-system-ui": "~57.0.2",
    "expo-video": "~57.0.2",
    "expo-web-browser": "~57.0.2",
    "openapi-fetch": "^0.17.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.1",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.3",
    "openapi-typescript": "^7.13.0",
    "typescript": "~5.9.2"
  }
}
