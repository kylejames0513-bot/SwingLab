{
  "expo": {
    "name": "CaddieInsight",
    "slug": "caddieinsight",
    "scheme": "caddieinsight",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#06110c"
    },
    "ios": { "supportsTablet": true, "bundleIdentifier": "com.caddieinsight.app" },
    "android": {
      "package": "com.caddieinsight.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#0f3d28"
      }
    },
    "plugins": ["expo-router", "expo-secure-store"],
    "extra": { "apiBaseUrl": "https://app.caddieinsight.com" }
  }
}
