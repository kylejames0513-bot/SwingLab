{% doc %}
  Renders a merchant image or a striped placeholder when no image is set.

  @param {image} [image] - Shopify image to render.
  @param {number} [ratio_w] - Placeholder viewBox width; defaults to 400.
  @param {number} [ratio_h] - Placeholder viewBox height; defaults to 260.
  @param {string} [label] - Primary placeholder caption.
  @param {string} [sublabel] - Secondary placeholder caption.
  @param {boolean} [warm] - Uses the warm stripe variant when true.
  @param {boolean} [flush] - Removes the placeholder border and radius when true.
  @param {string} [alt] - Alternative text for a real image.

  @example
  {% render 'media-placeholder', image: section.settings.image, label: 'Product art', alt: 'Training aid' %}
{% enddoc %}
{%- liquid
  assign vw = ratio_w | default: 400
  assign vh = ratio_h | default: 260
  assign ph_class = 'sl-placeholder'
  if warm
    assign ph_class = ph_class | append: ' sl-placeholder--warm'
  endif
  if flush
    assign ph_class = ph_class | append: ' sl-placeholder--flush'
  endif
  assign fill = '#5f6b60'
  if warm
    assign fill = '#6b6350'
  endif
-%}
{%- if image != blank -%}
  <img
    src="{{ image | image_url: width: 1200 }}"
    srcset="{{ image | image_url: width: 600 }} 600w, {{ image | image_url: width: 1200 }} 1200w, {{ image | image_url: width: 1800 }} 1800w"
    sizes="(max-width: 900px) 100vw, 600px"
    width="{{ vw }}" height="{{ vh }}"
    alt="{{ alt | default: image.alt | escape }}"
    loading="lazy">
{%- else -%}
  <svg class="{{ ph_class }}" viewBox="0 0 {{ vw }} {{ vh }}" role="img"
       aria-label="{{ label | default: 'image placeholder' | escape }}"
       preserveAspectRatio="xMidYMid slice">
    {%- if sublabel != blank -%}
      <text x="{{ vw | divided_by: 2 }}" y="{{ vh | divided_by: 2 | minus: 12 }}" text-anchor="middle" font-size="16" fill="{{ fill }}">{{ label }}</text>
      <text x="{{ vw | divided_by: 2 }}" y="{{ vh | divided_by: 2 | plus: 12 }}" text-anchor="middle" font-size="13" fill="#8a948a">{{ sublabel }}</text>
    {%- else -%}
      <text x="{{ vw | divided_by: 2 }}" y="{{ vh | divided_by: 2 | plus: 4 }}" text-anchor="middle" font-size="14" fill="{{ fill }}">{{ label | default: 'image' }}</text>
    {%- endif -%}
  </svg>
{%- endif -%}
