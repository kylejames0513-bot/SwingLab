{%- comment -%}
  The standard section opening: eyebrow → title → one supporting line.
  Twelve sections used to hand-roll this trio with private classes and
  duplicated CSS; the styles live once in base.css (.sl-section-head).

  Accepts:
  - title        (string, required) the section heading
  - eyebrow      (string, optional) small mono label above the title
  - lede         (string, optional) one supporting sentence below it
  - center       (boolean, optional) center the block
  - heading_id   (string, optional) id for aria-labelledby wiring

  Usage (render args take no filters — assign translated strings first):
    {%- assign head_eyebrow = 'homepage.method.eyebrow' | t -%}
    {% render 'section-head',
      eyebrow: head_eyebrow,
      title: section.settings.heading,
      lede: section.settings.sub,
      center: true,
      heading_id: heading_id
    %}
{%- endcomment -%}
<header class="sl-section-head{% if center %} sl-section-head--center{% endif %}">
  {%- if eyebrow != blank -%}
    <p class="sl-eyebrow">{{ eyebrow }}</p>
  {%- endif -%}
  <h2{% if heading_id != blank %} id="{{ heading_id }}"{% endif %} class="sl-h2">{{ title }}</h2>
  {%- if lede != blank -%}
    <p class="sl-section-head__lede">{{ lede }}</p>
  {%- endif -%}
</header>
