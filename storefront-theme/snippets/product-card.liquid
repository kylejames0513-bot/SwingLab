{% doc %}
  Renders a product card for collection, search, and related-product grids.

  @param {product} product - Product displayed by the card.

  @example
  {% render 'product-card', product: product %}
{% enddoc %}
{%- liquid
  assign card_alt = product.featured_media.alt | default: product.title

  assign on_sale = false
  assign save_pct = 0
  if product.price_varies == false and product.compare_at_price > product.price
    assign on_sale = true
    assign save_pct = product.compare_at_price | minus: product.price | times: 100 | divided_by: product.compare_at_price
  endif

  assign flag_tag_str = ''
  for tag in product.tags
    assign t = tag | downcase | strip
    assign t_prefix = t | slice: 0, 9
    if t_prefix == 'swinglab:'
      assign flag_tag_str = flag_tag_str | append: t | append: ','
    endif
  endfor
  assign card_flag_tags = flag_tag_str | split: ','
-%}
<a href="{{ product.url }}" class="sl-pcard"{% if product.handle == 'swinglab-pro' %} data-app-pro-sales-link{% endif %}>
  <div class="sl-pcard-media">
    {%- if product.featured_media -%}
      {{ product.featured_media | image_url: width: 720 | image_tag: loading: 'lazy', alt: card_alt, class: 'sl-pcard-img', widths: '360, 540, 720', sizes: '(min-width: 1280px) 25vw, (min-width: 1000px) 33vw, (min-width: 560px) 50vw, calc(100vw - 48px)' }}
    {%- else -%}
      <div class="sl-placeholder sl-pcard-img" aria-hidden="true"></div>
    {%- endif -%}
    {%- if on_sale and product.available -%}
      <span class="sl-badge-save">Save {{ save_pct }}%</span>
    {%- endif -%}
    {%- unless product.available -%}
      <span class="sl-pcard-badge">Sold out</span>
    {%- endunless -%}
  </div>
  <h3 class="sl-pcard-title">{{ product.title }}</h3>
  <p class="sl-pcard-price">
    {%- render 'price', product: product -%}
  </p>
  {%- capture card_flag_chips -%}
    {%- for tag in card_flag_tags limit: 2 -%}
      {%- capture flag_label -%}
        {%- render 'swinglab-tag-label', tag: tag -%}
      {%- endcapture -%}
      {%- assign flag_label = flag_label | strip -%}
      {%- if flag_label != blank -%}
        <span class="sl-chip">{{ flag_label | escape }}</span>
      {%- endif -%}
    {%- endfor -%}
  {%- endcapture -%}
  {%- if card_flag_chips contains 'sl-chip' -%}
    <p class="sl-pcard-flags">
      {{- card_flag_chips -}}
    </p>
  {%- endif -%}
</a>
