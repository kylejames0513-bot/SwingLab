{%- liquid
  assign premium_chrome = false
  if request.page_type == 'index'
    assign premium_chrome = true
  elsif request.page_type == 'product' and product.handle == 'swinglab-pro'
    assign premium_chrome = true
  endif
  assign resolved_page_title = page_title
  assign resolved_page_description = page_description
  if request.page_type == 'index'
    assign resolved_page_title = 'seo.homepage_title' | t
    assign resolved_page_description = 'seo.homepage_description' | t
  endif
-%}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  {%- comment -%}
    Matches the app shell: cover lets the page paint to the hardware edges in
    landscape on a notched phone, and the sections re-inset with
    env(safe-area-inset-*) rather than leaving letterbox bars.
  {%- endcomment -%}
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <meta name="theme-color" content="{% if premium_chrome %}var(--sl-night){% else %}var(--sl-green){% endif %}">
  <link rel="canonical" href="{{ canonical_url }}">
  {% comment %}theme-check-disable RemoteAsset{% endcomment %}
  <link rel="preconnect" href="https://app.caddieinsight.com" crossorigin>
  {% comment %}theme-check-enable RemoteAsset{% endcomment %}

  <title>
    {{ resolved_page_title }}{% if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif %}
    {% if current_page != 1 %} &ndash; Page {{ current_page }}{% endif %}
    {% unless resolved_page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless %}
  </title>

  {% if resolved_page_description %}<meta name="description" content="{{ resolved_page_description | escape }}">{% endif %}

  <meta property="og:site_name" content="{{ shop.name }}">
  <meta property="og:type" content="{% if request.page_type == 'product' %}product{% else %}website{% endif %}">
  <meta property="og:title" content="{{ resolved_page_title | default: shop.name | escape }}">
  <meta property="og:url" content="{{ canonical_url }}">
  {% if resolved_page_description %}<meta property="og:description" content="{{ resolved_page_description | escape }}">{% endif %}
  {%- comment -%}
    Brand marks come from the theme, never from a Files lookup.

    The earlier version of this block resolved the og mark and the favicon
    through an images[…] Files lookup, treating a missing entry as falsey so
    the asset_url branch could take over. It cannot: a Files lookup for a name
    that is not there returns a *truthy* drop, not nil. So the guard always
    passed, `image_url` then threw on a drop with no source, and every page
    shipped a literal "Liquid error (…): invalid url input" into href/content
    — an unquoted one in the JSON-LD below, which invalidated the whole block.
    The fallback branches were unreachable the entire time they looked like a
    safety net.

    An unconditional asset_url has none of that failure mode: the file is
    packaged with the theme, so it resolves or the theme upload was wrong,
    and a theme upload alone is enough to ship the mark. It also sidesteps
    the Files-beats-theme trap that pushed these onto caddieinsight-* names
    in the first place — Shopify Files still holds og-swinglab.png and
    swinglab-favicon.png from v3, and no lookup here can be pinned to them.

    page_image stays: it is a genuine Shopify drop that really is nil off a
    product or article, so a product still shares its own photo, and this
    is the one branch where the else was ever reachable.
  {%- endcomment -%}
  {%- assign og_image = page_image -%}
  {%- if og_image -%}
    <meta property="og:image" content="https:{{ og_image | image_url: width: 1200 }}">
  {%- else -%}
    <meta property="og:image" content="{{ 'og-caddieinsight.png' | asset_url | prepend: 'https:' | split: '?' | first }}">
  {%- endif -%}
  <meta name="twitter:card" content="summary_large_image">
  {%- if og_image -%}
    <meta name="twitter:image" content="https:{{ og_image | image_url: width: 1200 }}">
  {%- else -%}
    <meta name="twitter:image" content="{{ 'og-caddieinsight.png' | asset_url | prepend: 'https:' | split: '?' | first }}">
  {%- endif -%}

  <link rel="icon" type="image/png" href="{{ 'caddieinsight-favicon.png' | asset_url }}">
  <link rel="apple-touch-icon" href="{{ 'caddieinsight-favicon.png' | asset_url }}">

  {%- comment -%}
    Self-hosted type. Google Fonts was a render-blocking THIRD-PARTY
    stylesheet loaded after base.css — the CSSOM waited on a cross-origin
    round trip before anything painted, for seven font files. These three
    latin-subset woff2 files total ~64 KB, ship inside the theme, and are
    preloaded so the swap window is as small as this connection allows.
    Archivo is one variable file covering every weight the theme uses
    (400-800); the app shell will move to the same files in the follow-up.
  {%- endcomment -%}
  {{ 'archivo-latin-var.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
  {{ 'plex-mono-latin-400.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
  {% style %}
    @font-face {
      font-family: "Archivo";
      font-style: normal;
      font-weight: 400 800;
      font-display: swap;
      src: url("{{ 'archivo-latin-var.woff2' | asset_url }}") format("woff2");
      unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
    }
    @font-face {
      font-family: "IBM Plex Mono";
      font-style: normal;
      font-weight: 400;
      font-display: swap;
      src: url("{{ 'plex-mono-latin-400.woff2' | asset_url }}") format("woff2");
      unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
    }
    @font-face {
      font-family: "IBM Plex Mono";
      font-style: normal;
      font-weight: 500;
      font-display: swap;
      src: url("{{ 'plex-mono-latin-500.woff2' | asset_url }}") format("woff2");
      unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
    }
  {% endstyle %}
  {{ 'base.css' | asset_url | stylesheet_tag }}
  {% style %}
    :root {
      --sl-font-sans: "Archivo", "Avenir Next", "Helvetica Neue", Helvetica, sans-serif;
      --sl-font-display: "Archivo", "Avenir Next", "Helvetica Neue", Helvetica, sans-serif;
      --sl-font-mono: "IBM Plex Mono", ui-monospace, SFMono-Regular, Consolas, "Liberation Mono", monospace;
      --sl-bg: {{ settings.color_page_bg }};
      --sl-green: {{ settings.color_green }};
      --sl-orange: {{ settings.color_accent }};
    }
  {% endstyle %}
  <noscript><style>.sl-reveal { opacity: 1; transform: none; }</style></noscript>

  {%- comment -%}
    Structured data is the worst place to take the images[] gamble, which is
    why this one hurt most: the Liquid error the missing lookup produced was
    interpolated *unquoted* into the logo value, so the JSON did not parse and
    Google discarded the entire Organization block — a silent total loss
    rather than a wrong picture.

    asset_url resolves against the theme, matching the header lockup exactly
    (v4, 1400x279) instead of the 1400x214 swinglab-logo.png v3 mark Files
    still holds. json does the quoting and escaping, so the value cannot break
    the document even if the filter chain ever yields something unexpected.
  {%- endcomment -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": "CaddieInsight",
      "url": {{ shop.url | json }},
      "logo": {{ 'caddieinsight-logo.png' | asset_url | prepend: 'https:' | json }}
    }
  </script>
  {%- comment -%}
    The SearchAction target is built in an assign tag: literal braces in
    the placeholder break Shopify's parser inside output markup.
  {%- endcomment -%}
  {%- assign search_action_target = shop.url | append: routes.search_url | append: '?q={search_term_string}' -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": {{ shop.name | json }},
      "url": {{ shop.url | json }},
      "potentialAction": {
        "@type": "SearchAction",
        "target": {{ search_action_target | json }},
        "query-input": "required name=search_term_string"
      }
    }
  </script>

  {{ content_for_header }}
</head>
<body class="template-{{ request.page_type | handle }}{% if premium_chrome %} sl-premium-chrome{% endif %}">
  <a class="sl-skip" href="#MainContent">{{ 'general.accessibility.skip_to_content' | t }}</a>

  {% sections 'header-group' %}

  <main id="MainContent" role="main">
    {{ content_for_layout }}
  </main>

  {% sections 'footer-group' %}

  <script>
    /* scroll reveal: adds .is-in to .sl-reveal elements as they enter the
       viewport. Elements are only ever hidden AFTER html gets .sl-js here,
       so a script that doesn't run can never leave blank sections; the
       shopify:section:load listener re-observes content the theme editor
       re-renders. Reduced motion and missing IO keep everything visible. */
    (function () {
      var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (reduce || !('IntersectionObserver' in window)) return;
      var io = new IntersectionObserver(function (entries) {
        for (var i = 0; i < entries.length; i++) {
          if (entries[i].isIntersecting) {
            entries[i].target.classList.add('is-in');
            io.unobserve(entries[i].target);
          }
        }
      }, { rootMargin: '0px 0px -10% 0px', threshold: 0.08 });
      function scan(root) {
        var els = (root || document).querySelectorAll('.sl-reveal:not(.is-in)');
        for (var i = 0; i < els.length; i++) io.observe(els[i]);
      }
      document.documentElement.classList.add('sl-js');
      scan(document);
      document.addEventListener('shopify:section:load', function (e) { scan(e.target); });
    })();
  </script>
</body>
</html>
