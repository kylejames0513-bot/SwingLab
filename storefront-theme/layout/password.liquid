<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ shop.name }}</title>
  <meta name="robots" content="noindex">
  <link rel="icon" type="image/png" href="{{ 'caddieinsight-favicon.png' | asset_url }}">
  <meta name="theme-color" content="#f2f2f3">
  {{ 'barlow-latin-400.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
  {{ 'barlow-condensed-latin-600.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
  {{ content_for_header }}
  {% style %}
    @font-face {
      font-family: "Barlow";
      font-style: normal;
      font-weight: 400;
      font-display: swap;
      src: url("{{ 'barlow-latin-400.woff2' | asset_url }}") format("woff2");
    }
    @font-face {
      font-family: "Barlow";
      font-style: normal;
      font-weight: 500;
      font-display: swap;
      src: url("{{ 'barlow-latin-500.woff2' | asset_url }}") format("woff2");
    }
    @font-face {
      font-family: "Barlow Condensed";
      font-style: normal;
      font-weight: 600;
      font-display: swap;
      src: url("{{ 'barlow-condensed-latin-600.woff2' | asset_url }}") format("woff2");
    }
    @font-face {
      font-family: "DM Mono";
      font-style: normal;
      font-weight: 500;
      font-display: swap;
      src: url("{{ 'dm-mono-latin-500.woff2' | asset_url }}") format("woff2");
    }
  {% endstyle %}
  {{ 'base.css' | asset_url | stylesheet_tag }}
</head>
<body class="sl-password-layout">
  <main>
    {{ content_for_layout }}
  </main>
  {% style %}
    /* The password wall shows the mark and the door — no navigation to
       pages that sit behind it. */
    .sl-password-layout {
      min-height: 100vh;
      display: grid;
      place-items: center;
    }
  {% endstyle %}
</body>
</html>
