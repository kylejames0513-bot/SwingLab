<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ shop.name }}</title>
  <meta name="robots" content="noindex">
  <link rel="icon" type="image/png" href="{{ 'caddieinsight-favicon.png' | asset_url }}">
  <link rel="preload" href="{{ 'archivo-latin-var.woff2' | asset_url }}" as="font" type="font/woff2" crossorigin>
  {{ content_for_header }}
  {% style %}
    @font-face {
      font-family: "Archivo";
      font-style: normal;
      font-weight: 400 800;
      font-display: swap;
      src: url("{{ 'archivo-latin-var.woff2' | asset_url }}") format("woff2");
    }
    @font-face {
      font-family: "IBM Plex Mono";
      font-style: normal;
      font-weight: 400;
      font-display: swap;
      src: url("{{ 'plex-mono-latin-400.woff2' | asset_url }}") format("woff2");
    }
  {% endstyle %}
  {{ 'base.css' | asset_url | stylesheet_tag }}
</head>
<body class="sl-password-layout">
  <main>
    {{ content_for_layout }}
  </main>
  {% style %}
    /* The password wall shows the mark and the door — no navigation to
       pages that sit behind it. */
    .sl-password-layout {
      min-height: 100vh;
      display: grid;
      place-items: center;
    }
  {% endstyle %}
</body>
</html>
