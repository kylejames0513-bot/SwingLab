<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ shop.name }}</title>
  <meta name="robots" content="noindex">
  <link rel="icon" type="image/png" href="{{ 'caddieinsight-favicon.png' | asset_url }}">
  {{ 'archivo-latin-var.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
  {{ 'oswald-latin-var.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
  {{ content_for_header }}
  {% style %}
    @font-face {
      font-family: "Oswald";
      font-style: normal;
      font-weight: 400 700;
      font-display: swap;
      src: url("{{ 'oswald-latin-var.woff2' | asset_url }}") format("woff2");
      unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
    }
    @font-face {
      font-family: "Archivo";
      font-style: normal;
      font-weight: 400 800;
      font-display: swap;
      src: url("{{ 'archivo-latin-var.woff2' | asset_url }}") format("woff2");
    }
    @font-face {
      font-family: "IBM Plex Mono";
      font-style: normal;
      font-weight: 400;
      font-display: swap;
      src: url("{{ 'plex-mono-latin-400.woff2' | asset_url }}") format("woff2");
    }
  {% endstyle %}
  {{ 'base.css' | asset_url | stylesheet_tag }}
</head>
<body class="sl-password-layout">
  <main>
    {{ content_for_layout }}
  </main>
  {% style %}
    /* The password wall shows the mark and the door — no navigation to
       pages that sit behind it. */
    .sl-password-layout {
      min-height: 100vh;
      display: grid;
      place-items: center;
    }
  {% endstyle %}
</body>
</html>
