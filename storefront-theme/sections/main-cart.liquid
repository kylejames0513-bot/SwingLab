{%- liquid
  assign returns_url = pages['shipping-returns'].url | default: '/pages/shipping-returns'
  assign has_membership_line = false
  for item in cart.items
    if item.product.type == 'Membership'
      assign has_membership_line = true
    endif
  endfor
-%}
<div class="sl-wrap sl-cartpage">
  <h1 class="sl-h2">{{ 'layout.cart.title' | t }}</h1>

  {%- if cart.item_count == 0 -%}
    <p class="sl-empty">Your cart is empty.</p>
    <a class="sl-btn sl-btn--primary" href="{{ routes.collections_url }}/swinglab-gear">Browse the gear</a>
  {%- else -%}
    <form action="{{ routes.cart_url }}" method="post" id="cart">
      <div class="sl-cart-lines" role="list">
        {%- for item in cart.items -%}
          {%- assign line_alt = item.image.alt | default: item.product.title -%}
          <div class="sl-cart-line" role="listitem">
            <a class="sl-cart-media" href="{{ item.url }}" tabindex="-1" aria-hidden="true">
              {%- if item.image -%}
                {{ item.image | image_url: width: 168 | image_tag: loading: 'lazy', alt: line_alt }}
              {%- else -%}
                <div class="sl-placeholder" aria-hidden="true"></div>
              {%- endif -%}
            </a>

            <div>
              <a class="sl-cart-title" href="{{ item.url }}">{{ item.product.title }}</a>
              {%- unless item.variant.title == 'Default Title' -%}
                <p class="sl-cart-variant">{{ item.variant.title }}</p>
              {%- endunless -%}
              {%- if item.selling_plan_allocation -%}
                <p class="sl-cart-variant">{{ item.selling_plan_allocation.selling_plan.name }}</p>
              {%- endif -%}
              <a class="sl-cart-remove" href="{{ item.url_to_remove }}">Remove</a>
            </div>

            <label class="visually-hidden" for="sl-cart-qty-{{ forloop.index }}">Quantity for {{ item.product.title }}</label>
            <input id="sl-cart-qty-{{ forloop.index }}" class="sl-qty" type="number"
                   name="updates[]" value="{{ item.quantity }}" min="0" inputmode="numeric">

            <div class="sl-cart-line-price">
              {{ item.final_line_price | money }}
              {%- if item.original_line_price > item.final_line_price -%}
                <s class="sl-price-compare">{{ item.original_line_price | money }}</s>
              {%- elsif item.variant.compare_at_price > item.variant.price -%}
                {%- assign compare_line = item.variant.compare_at_price | times: item.quantity -%}
                <s class="sl-price-compare">{{ compare_line | money }}</s>
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      </div>

      {%- if section.settings.promo_note != blank -%}
        <p class="sl-note sl-main-cart__promo">{{ section.settings.promo_note }}</p>
      {%- endif -%}

      {%- if has_membership_line -%}
        <div class="sl-note sl-main-cart__unlock">
          <strong>{{ 'products.product.unlock_heading' | t }}</strong>
          <p>{{ 'products.product.unlock_body' | t }}</p>
        </div>
      {%- endif -%}

      <div class="sl-cart-foot">
        <p class="sl-cart-subtotal"><span class="sl-mono-label">Subtotal</span> <strong>{{ cart.total_price | money }}</strong></p>
        <p class="sl-cart-hint">Taxes and shipping calculated at checkout.</p>
        <div class="sl-cart-actions">
          <a class="sl-btn sl-btn--outline" href="{{ routes.collections_url }}/swinglab-gear">Continue shopping</a>
          <button class="sl-btn sl-btn--outline" type="submit" name="update">Update cart</button>
          <button class="sl-btn sl-btn--primary" type="submit" name="checkout">Check out</button>
        </div>
        <ul class="sl-main-cart__trust" aria-label="Ordering assurance">
          <li><a href="{{ returns_url }}">30-day returns on unused gear</a></li>
          <li>Tracked shipping on every gear order</li>
          <li>14-day refunds on unused Pro</li>
        </ul>
      </div>
    </form>
  {%- endif -%}
</div>

{% stylesheet %}
.sl-main-cart__promo {
  max-width: 520px;
  margin: 24px 0 0;
  font-size: 14px;
}

.sl-main-cart__unlock {
  max-width: 520px;
  margin: 24px 0 0;
  font-size: 14px;
}

.sl-main-cart__unlock strong {
  color: var(--sl-green);
}

.sl-main-cart__unlock p {
  margin: 6px 0 0;
  line-height: 1.55;
}

.sl-cart-subtotal .sl-mono-label {
  margin-right: 8px;
}

/* compact reassurance row under the checkout actions */
.sl-main-cart__trust {
  list-style: none;
  margin: 14px 0 0;
  padding: 14px 0 0;
  border-top: 1px solid var(--sl-border);
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-end;
  gap: 8px 20px;
}

.sl-main-cart__trust li {
  position: relative;
  padding-left: 15px;
  font-family: var(--sl-font-mono);
  font-size: 11px;
  font-weight: 500;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--sl-ink-soft);
  line-height: 1.6;
}

.sl-main-cart__trust li::before {
  content: "";
  position: absolute;
  left: 0;
  top: 6px;
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: var(--sl-orange);
}

.sl-main-cart__trust a {
  color: inherit;
  text-underline-offset: 3px;
}

.sl-main-cart__trust a:hover {
  color: var(--sl-green-btn);
}

@media (max-width: 600px) {
  .sl-main-cart__trust {
    justify-content: flex-start;
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Cart page",
  "settings": [
    {
      "type": "text",
      "id": "promo_note",
      "label": "Promo note",
      "default": "Launch code RANGE15 takes 15% off training aids at checkout.",
      "info": "Quiet reminder above the subtotal. Clear the text to remove it."
    }
  ]
}
{% endschema %}
