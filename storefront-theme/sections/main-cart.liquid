{%- liquid
  assign returns_url = pages['shipping-returns'].url | default: '/pages/shipping-returns'
  assign has_membership_line = false
  for item in cart.items
    if item.product.type == 'Membership'
      assign has_membership_line = true
    endif
  endfor
-%}
<div class="sl-wrap sl-cartpage sl-main-cart">
  <h1 class="sl-h2">{{ 'layout.cart.title' | t }}</h1>

  {%- if cart.item_count == 0 -%}
    <div class="sl-main-cart__empty">
      <p class="sl-mono-label sl-main-cart__empty-kicker">Cart · 0 items</p>
      <p class="sl-main-cart__empty-lede">Your cart is empty.</p>
      <p class="sl-main-cart__empty-body">Add a training aid or a Pro plan and it will be waiting here.</p>
      <div class="sl-main-cart__empty-actions">
        <a class="sl-btn sl-btn--primary" href="{{ routes.collections_url }}/swinglab-gear">Browse the gear</a>
        <a class="sl-btn sl-btn--outline" href="{{ routes.root_url }}#plans">See membership plans</a>
      </div>
    </div>
  {%- else -%}
    <p class="sl-mono-label sl-main-cart__count">
      {{ cart.item_count }}
      {%- if cart.item_count == 1 %} item{% else %} items{% endif %} in the bag
    </p>
    <form action="{{ routes.cart_url }}" method="post" id="cart">
      <div class="sl-cart-lines" role="list">
        {%- for item in cart.items -%}
          {%- assign line_alt = item.image.alt | default: item.product.title -%}
          <div class="sl-cart-line" role="listitem">
            <a class="sl-cart-media" href="{{ item.url }}" tabindex="-1" aria-hidden="true">
              {%- if item.image -%}
                {{ item.image | image_url: width: 168 | image_tag: loading: 'lazy', alt: line_alt, widths: '84, 168', sizes: '84px' }}
              {%- else -%}
                <div class="sl-placeholder" aria-hidden="true"></div>
              {%- endif -%}
            </a>

            <div>
              <a class="sl-cart-title" href="{{ item.url }}">{{ item.product.title }}</a>
              {%- unless item.variant.title == 'Default Title' -%}
                <p class="sl-cart-variant">{{ item.variant.title }}</p>
              {%- endunless -%}
              {%- if item.selling_plan_allocation -%}
                <p class="sl-cart-variant">{{ item.selling_plan_allocation.selling_plan.name }}</p>
              {%- endif -%}
              <a class="sl-cart-remove" href="{{ item.url_to_remove }}">Remove</a>
            </div>

            <label class="visually-hidden" for="sl-cart-qty-{{ forloop.index }}">Quantity for {{ item.product.title }}</label>
            <input id="sl-cart-qty-{{ forloop.index }}" class="sl-qty" type="number"
                   name="updates[]" value="{{ item.quantity }}" min="0" inputmode="numeric">

            <div class="sl-cart-line-price">
              {{ item.final_line_price | money }}
              {%- if item.original_line_price > item.final_line_price -%}
                <s class="sl-price-compare">{{ item.original_line_price | money }}</s>
              {%- elsif item.variant.compare_at_price > item.variant.price -%}
                {%- assign compare_line = item.variant.compare_at_price | times: item.quantity -%}
                <s class="sl-price-compare">{{ compare_line | money }}</s>
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      </div>

      {%- if section.settings.promo_note != blank -%}
        <p class="sl-note sl-main-cart__promo">{{ section.settings.promo_note }}</p>
      {%- endif -%}

      {%- if has_membership_line -%}
        <aside class="sl-note sl-main-cart__unlock">
          <p class="sl-main-cart__unlock-label">Membership</p>
          <strong>{{ 'products.product.unlock_heading' | t }}</strong>
          <p>{{ 'products.product.unlock_body' | t }}</p>
        </aside>
      {%- endif -%}

      <div class="sl-cart-foot">
        <p class="sl-cart-subtotal"><span class="sl-mono-label">Subtotal</span> <strong>{{ cart.total_price | money }}</strong></p>
        <p class="sl-cart-hint">Taxes and shipping calculated at checkout.</p>
        <div class="sl-cart-actions">
          <a class="sl-btn sl-btn--outline" href="{{ routes.collections_url }}/swinglab-gear">Continue shopping</a>
          <button class="sl-btn sl-btn--outline" type="submit" name="update">Update cart</button>
          <button class="sl-btn sl-btn--primary" type="submit" name="checkout">Check out</button>
        </div>
        {%- assign cart_assurance_label = 'cart.general.assurance_label' | t -%}
        {%- assign cart_trust_returns = 'cart.general.returns' | t -%}
        {%- assign cart_trust_shipping = 'cart.general.shipping' | t -%}
        {%- assign cart_trust_refunds = 'cart.general.refunds' | t -%}
        {% render 'trust-rail',
          label: cart_assurance_label,
          icon_1: 'refresh',
          text_1: cart_trust_returns,
          url_1: returns_url,
          icon_2: 'box',
          text_2: cart_trust_shipping,
          icon_3: 'shield-check',
          text_3: cart_trust_refunds
        %}
      </div>
    </form>
  {%- endif -%}
</div>

{% stylesheet %}
/* empty cart: one deliberate, illustration-free composition */
.sl-main-cart__empty {
  max-width: 560px;
  margin: clamp(28px, 6vw, 52px) auto 0;
  padding: clamp(32px, 5vw, 48px) var(--sl-card-inset);
  text-align: center;
  border: 1px dashed var(--sl-border);
  border-radius: var(--sl-radius-lg);
  background: var(--sl-bg-card);
}

.sl-main-cart__empty-kicker {
  display: block;
  margin: 0;
}

.sl-main-cart__empty-lede {
  margin: 12px 0 0;
  font-size: var(--sl-text-2xl);
  font-weight: 500;
  letter-spacing: -0.02em;
  color: var(--sl-green);
}

.sl-main-cart__empty-body {
  max-width: 38ch;
  margin: 8px auto 0;
  font-size: var(--sl-text-base);
  line-height: 1.6;
  color: var(--sl-ink-soft);
}

.sl-main-cart__empty-actions {
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  gap: 12px;
  margin-top: 24px;
}

/* line-count evidence label under the title */
.sl-main-cart__count {
  display: flex;
  align-items: center;
  gap: 10px;
  margin: 14px 0 0;
  font-variant-numeric: tabular-nums;
}

.sl-main-cart__count::before {
  content: "";
  width: 26px;
  height: 1px;
  background: var(--sl-border);
}

/* line rows: variant context set in measured mono */
.sl-main-cart .sl-cart-variant {
  margin: 5px 0 0;
  font-family: var(--sl-font-mono);
  font-size: var(--sl-text-xs);
  font-weight: 500;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--sl-ink-muted);
}

.sl-main-cart .sl-cart-title {
  transition: color 0.18s ease;
}

.sl-main-cart .sl-cart-title:hover {
  color: var(--sl-green-btn);
}

.sl-main-cart .sl-cart-remove {
  font-family: var(--sl-font-mono);
  font-size: var(--sl-text-xs);
  font-weight: 500;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  text-underline-offset: 3px;
  transition: color 0.18s ease;
}

.sl-main-cart .sl-cart-remove:hover {
  color: var(--sl-orange);
}

.sl-main-cart .sl-cart-line-price {
  font-variant-numeric: tabular-nums;
}

.sl-main-cart__promo {
  max-width: 520px;
  margin: 24px 0 0;
  font-size: var(--sl-text-sm);
}

/* membership unlock: a designed notice, not a paragraph */
.sl-main-cart__unlock {
  max-width: 520px;
  margin: 24px 0 0;
  font-size: var(--sl-text-sm);
}

.sl-main-cart__unlock-label {
  margin: 0 0 6px;
  font-family: var(--sl-font-mono);
  font-size: var(--sl-text-xs);
  font-weight: 500;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: var(--sl-orange);
}

.sl-main-cart__unlock strong {
  display: block;
  color: var(--sl-green);
  font-size: var(--sl-text-base);
  letter-spacing: -0.01em;
}

.sl-main-cart__unlock p {
  margin: 6px 0 0;
  line-height: 1.55;
}

.sl-cart-subtotal .sl-mono-label {
  margin-right: 8px;
}

.sl-cart-subtotal strong {
  font-variant-numeric: tabular-nums;
}

@media (max-width: 749px) {
  .sl-main-cart:has(.sl-main-cart__empty) {
    text-align: center;
  }
  .sl-main-cart__count {
    justify-content: center;
  }
  .sl-main-cart__empty-actions .sl-btn {
    width: min(100%, 320px);
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Cart page",
  "settings": [
    {
      "type": "text",
      "id": "promo_note",
      "label": "Promo note",
      "default": "Launch code RANGE15 takes 15% off training aids at checkout.",
      "info": "Quiet reminder above the subtotal. Clear the text to remove it."
    }
  ]
}
{% endschema %}
