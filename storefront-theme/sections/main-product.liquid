{%- comment -%}
  Gear and apparel only. Membership products render through
  templates/product.membership.json -> main-product-membership.liquid.
{%- endcomment -%}
{%- assign current = product.selected_or_first_available_variant -%}
{%- assign main_alt = product.featured_media.alt | default: product.title -%}

{%- liquid
  # swing-report flag chips, parsed from tags of the form "swinglab:<flag>"
  assign flag_tag_str = ''
  for tag in product.tags
    assign t = tag | downcase | strip
    assign t_prefix = t | slice: 0, 9
    if t_prefix == 'swinglab:'
      assign flag_tag_str = flag_tag_str | append: t | append: ','
    endif
  endfor
  assign flag_tags = flag_tag_str | split: ','

  # compare-at state for the selected variant
  assign has_compare = false
  assign save_pct = 0
  if current.compare_at_price > current.price
    assign has_compare = true
    assign save_pct = current.compare_at_price | minus: current.price | times: 100 | divided_by: current.compare_at_price
  endif
-%}

<div class="sl-wrap sl-product">
  <div class="sl-product-media">
    <div class="sl-main-product__frame">
      {%- if product.featured_media -%}
        {{ product.featured_media | image_url: width: 1400 | image_tag: class: 'sl-product-img', alt: main_alt, id: 'sl-main-image', fetchpriority: 'high', widths: '480, 720, 960, 1400', sizes: '(min-width: 960px) min(50vw, 560px), calc(100vw - 48px)' }}
      {%- else -%}
        <div class="sl-placeholder sl-product-img" aria-hidden="true"></div>
      {%- endif -%}
      {%- if product.type != blank -%}
        <span class="sl-main-product__media-label" aria-hidden="true">{{ product.type | escape }}</span>
      {%- endif -%}
    </div>

    {%- if product.media.size > 1 -%}
      <div class="sl-product-thumbs sl-main-product__thumbs">
        {%- for media in product.media -%}
          {%- assign thumb_alt = media.alt | default: product.title -%}
          <button type="button" class="sl-thumb{% if media.id == product.featured_media.id %} is-active{% endif %}"
                  data-full="{{ media | image_url: width: 1400 }}"
                  data-srcset="{{ media | image_url: width: 480 }} 480w, {{ media | image_url: width: 720 }} 720w, {{ media | image_url: width: 960 }} 960w, {{ media | image_url: width: 1400 }} 1400w"
                  data-alt="{{ thumb_alt | escape }}"
                  aria-label="{{ 'products.product.show_image' | t: number: forloop.index }}"
                  aria-pressed="{% if media.id == product.featured_media.id %}true{% else %}false{% endif %}">
            {{ media | image_url: width: 200 | image_tag: loading: 'lazy', alt: thumb_alt, widths: '104, 144, 200', sizes: '66px' }}
          </button>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>

  <div class="sl-product-info">
    {%- if product.type != blank -%}<p class="sl-eyebrow">{{ product.type }}</p>{%- endif -%}
    <h1 class="sl-product-title">{{ product.title }}</h1>

      {%- capture flag_chips -%}
        {%- for tag in flag_tags -%}
          {%- capture flag_label -%}
            {%- render 'swinglab-tag-label', tag: tag -%}
          {%- endcapture -%}
          {%- assign flag_label = flag_label | strip -%}
          {%- if flag_label != blank -%}
            <span class="sl-chip">{{ flag_label | escape }}</span>
          {%- endif -%}
        {%- endfor -%}
      {%- endcapture -%}
      {%- if flag_chips contains 'sl-chip' -%}
        <div class="sl-main-product__flags">
          <span class="sl-mono-label">{{ section.settings.flags_label | default: 'Recommended for' }}:</span>
          {{- flag_chips -}}
        </div>
      {%- endif -%}

      <p class="sl-price sl-main-product__price" role="status" aria-live="polite" aria-atomic="true">
        <span id="sl-price-current">{{ current.price | money }}</span>
        <s class="sl-price-compare" id="sl-price-compare"{% unless has_compare %} hidden{% endunless %}>{%- if has_compare -%}{{ current.compare_at_price | money }}{%- endif -%}</s>
        <span class="sl-badge-save" id="sl-badge-save"{% unless has_compare %} hidden{% endunless %}>{%- if has_compare -%}Save {{ save_pct }}%{%- endif -%}</span>
      </p>

      {%- comment -%}
        The id exists so the sticky mobile bar's button can submit THIS form
        through a `form=` attribute instead of carrying a second copy of the
        variant select and quantity. Two forms would mean two sources of truth
        for what is being added, and they drift the moment someone changes the
        variant after scrolling.
      {%- endcomment -%}
      {% form 'product', product, class: 'sl-product-form sl-main-product__gear-form', id: 'sl-product-form' %}
        {%- if product.variants.size > 1 -%}
          <label class="sl-label" for="sl-variant">{{ 'products.product.options_label' | t }}</label>
          <select name="id" id="sl-variant" class="sl-select">
            {%- for variant in product.variants -%}
              {%- assign v_save = 0 -%}
              {%- if variant.compare_at_price > variant.price -%}
                {%- assign v_save = variant.compare_at_price | minus: variant.price | times: 100 | divided_by: variant.compare_at_price -%}
              {%- endif -%}
              <option value="{{ variant.id }}"
                      {% if variant.id == current.id %}selected{% endif %}
                      {% unless variant.available %}disabled{% endunless %}
                      data-price="{{ variant.price | money }}"
                      data-available="{{ variant.available }}"
                      {% if variant.compare_at_price > variant.price %}data-compare="{{ variant.compare_at_price | money }}" data-save="{{ v_save }}"{% endif %}>
                {{ variant.title }} – {{ variant.price | money }}{% unless variant.available %} ({{ 'products.product.sold_out' | t }}){% endunless %}
              </option>
            {%- endfor -%}
          </select>
        {%- else -%}
          <input type="hidden" name="id" value="{{ current.id }}">
        {%- endif -%}

        <div class="sl-main-product__buy">
          <div class="sl-main-product__qty">
            <label class="sl-label" for="sl-qty">{{ 'products.product.quantity_label' | t }}</label>
            <input id="sl-qty" class="sl-qty" type="number" name="quantity" value="1" min="1" inputmode="numeric">
          </div>

          <button type="submit" class="sl-btn sl-btn--primary sl-add"
                  data-add-label="{{ 'products.product.add_to_cart' | t | escape }}"
                  data-sold-out-label="{{ 'products.product.sold_out' | t | escape }}"
                  {% unless current.available %}disabled{% endunless %}>
            {% if current.available %}{{ 'products.product.add_to_cart' | t }}{% else %}{{ 'products.product.sold_out' | t }}{% endif %}
          </button>
        </div>
        {{ form | payment_button }}
      {% endform %}

      {%- comment -%}
        THE STICKY BUY BAR (mockup 2c), phones only.

        It carries a button and nothing else. No price, no quantity, no variant
        picker — those all live in the form above and a second copy of any of
        them is a second thing to keep in sync. The button reaches the real
        form through form="sl-product-form", so whatever is selected up the
        page is what gets added.

        It starts hidden and is revealed by an observer watching the real buy
        zone. If that script never runs the bar simply never appears and the
        page is exactly as it was — the sticky bar is an accelerator, never the
        only way to buy.
      {%- endcomment -%}
      <div class="sl-buybar" data-buybar hidden>
        <div class="sl-buybar__inner">
          <span class="sl-buybar__title">{{ product.title }}</span>
          <button type="submit"
                  form="sl-product-form"
                  class="sl-btn sl-btn--primary sl-buybar__add"
                  {% unless current.available %}disabled{% endunless %}>
            {% if current.available %}{{ 'products.product.add_to_cart' | t }}{% else %}{{ 'products.product.sold_out' | t }}{% endif %}
          </button>
        </div>
      </div>

      {%- assign product_trust_label = 'products.product.ordering_details' | t -%}
      {% render 'trust-rail',
        label: product_trust_label,
        class: 'sl-trust--stack',
        icon_1: 'box',
        text_1: section.settings.trust_1,
        icon_2: 'refresh',
        text_2: section.settings.trust_2,
        icon_3: 'target',
        text_3: section.settings.trust_3
      %}

    {%- if product.description != blank -%}
      <div class="sl-product-desc sl-main-product__desc">
        <p class="sl-mono-label sl-main-product__desc-label">{{ 'products.product.product_notes' | t }}</p>
        <div class="sl-rte">{{ product.description }}</div>
      </div>
    {%- endif -%}
  </div>
</div>

<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Product",
    "name": {{ product.title | json }},
    "description": {{ product.description | strip_html | truncatewords: 60 | json }},
    {%- if product.featured_media %}
    "image": {{ product.featured_media | image_url: width: 1400 | prepend: 'https:' | json }},
    {%- endif %}
    "brand": {
      "@type": "Brand",
      "name": "CaddieInsight"
    },
    "url": {{ request.origin | append: product.url | json }},
    "offers": [
      {%- for variant in product.variants %}
      {
        "@type": "Offer",
        "name": {{ variant.title | json }},
        "price": {{ variant.price | divided_by: 100.0 | json }},
        "priceCurrency": {{ cart.currency.iso_code | json }},
        "availability": {% if variant.available %}"https://schema.org/InStock"{% else %}"https://schema.org/OutOfStock"{% endif %},
        "url": {{ request.origin | append: variant.url | json }}
      }{% unless forloop.last %},{% endunless %}
      {%- endfor %}
    ]
  }
</script>

{%- assign crumb_collection = product.collections.first -%}
<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": {{ request.origin | append: routes.root_url | json }}
      },
      {%- if crumb_collection != blank %}
      {
        "@type": "ListItem",
        "position": 2,
        "name": {{ crumb_collection.title | json }},
        "item": {{ request.origin | append: crumb_collection.url | json }}
      },
      {
        "@type": "ListItem",
        "position": 3,
        "name": {{ product.title | json }},
        "item": {{ request.origin | append: product.url | json }}
      }
      {%- else %}
      {
        "@type": "ListItem",
        "position": 2,
        "name": {{ product.title | json }},
        "item": {{ request.origin | append: product.url | json }}
      }
      {%- endif %}
    ]
  }
</script>

<script>
  (function () {
    var select = document.getElementById('sl-variant');
    var priceCurrent = document.getElementById('sl-price-current');
    var priceCompare = document.getElementById('sl-price-compare');
    var saveBadge = document.getElementById('sl-badge-save');
    var addButton = document.querySelector('.sl-product-form .sl-add');

    function updateAddButton(option) {
      if (!addButton || !option) return;
      var available = option.dataset.available === 'true';
      addButton.disabled = !available;
      addButton.textContent = available
        ? addButton.getAttribute('data-add-label')
        : addButton.getAttribute('data-sold-out-label');
    }

    if (select) {
      select.addEventListener('change', function () {
        var opt = select.options[select.selectedIndex];
        if (!opt) return;
        updateAddButton(opt);
        if (priceCurrent && opt.dataset.price) priceCurrent.textContent = opt.dataset.price;
        if (priceCompare && saveBadge) {
          if (opt.dataset.compare) {
            priceCompare.textContent = opt.dataset.compare;
            priceCompare.hidden = false;
            saveBadge.textContent = 'Save ' + opt.dataset.save + '%';
            saveBadge.hidden = false;
          } else {
            priceCompare.hidden = true;
            saveBadge.hidden = true;
          }
        }
      });
    }
    var main = document.getElementById('sl-main-image');
    var thumbs = document.querySelectorAll('.sl-thumb');
    thumbs.forEach(function (btn) {
      btn.addEventListener('click', function () {
        if (!main) return;
        main.src = btn.dataset.full;
        main.alt = btn.dataset.alt || '';
        /* Swap the whole responsive candidate set. The old handler removed
           srcset/sizes, permanently downgrading the gallery to one fixed
           1400px download after the first thumbnail click. */
        if (btn.dataset.srcset) main.setAttribute('srcset', btn.dataset.srcset);
        thumbs.forEach(function (thumb) {
          var selected = thumb === btn;
          thumb.classList.toggle('is-active', selected);
          thumb.setAttribute('aria-pressed', selected ? 'true' : 'false');
        });
      });
    });
  })();
</script>

{% stylesheet %}
/* Gallery frame/thumbs and the description block are shared components in
   assets/base.css. This sheet holds only the gear buy box. */

.sl-main-product__media-label {
  position: absolute;
  z-index: 1;
  top: 14px;
  left: 14px;
  display: inline-flex;
  align-items: center;
  min-height: 29px;
  max-width: calc(100% - 28px);
  padding: 0 10px;
  overflow: hidden;
  border: 1px solid rgba(var(--sl-wash-rgb), 0.34);
  border-radius: var(--sl-radius-control);
  background: rgba(var(--sl-night-rgb), 0.78);
  box-shadow: 0 10px 24px -12px rgba(var(--sl-night-rgb), 0.9);
  color: var(--sl-cream);
  font-family: var(--sl-font-mono);
  font-size: var(--sl-text-xs);
  font-weight: 500;
  letter-spacing: 0.14em;
  line-height: 1;
  text-overflow: ellipsis;
  text-transform: uppercase;
  white-space: nowrap;
  pointer-events: none;
  -webkit-backdrop-filter: blur(8px);
  backdrop-filter: blur(8px);
}

/* ---- gear / apparel ---- */
.sl-main-product__flags {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 8px;
  margin: 4px 0 18px;
}

.sl-main-product__price {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  gap: 4px 10px;
  font-variant-numeric: tabular-nums;
}
.sl-main-product__price .sl-price-compare { margin-left: 0; }
.sl-main-product__price .sl-badge-save { align-self: center; }
/* the author display on .sl-badge-save would defeat [hidden]; restore it */
.sl-main-product__price [hidden] { display: none !important; }

/* The sticky buy bar, phones only. Hidden at every other width by the media
   query rather than by script, so a desktop visitor never has it flash in
   before JS decides. */
.sl-buybar { display: none; }
@media (max-width: 749px) {
  .sl-buybar {
    display: block;
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 40;
    background: var(--sl-bg);
    border-top: 1px solid var(--sl-border-strong);
    /* Above the home indicator on a notched phone, which is exactly where a
       fixed bottom bar otherwise puts its tap target. */
    padding-bottom: env(safe-area-inset-bottom, 0px);
  }
  .sl-buybar[hidden] { display: none; }
  .sl-buybar__inner {
    display: flex;
    align-items: center;
    gap: var(--sl-space-4);
    padding: var(--sl-space-3) var(--sl-pad-x);
  }
  .sl-buybar__title {
    flex: 1 1 auto;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: var(--sl-ink);
    font-family: var(--sl-font-display);
    font-size: var(--sl-text-base);
    font-weight: var(--sl-weight-display);
  }
  .sl-buybar__add { flex: 0 0 auto; min-height: 46px; }

  /* WCAG 2.2 SC 2.4.11, Focus Not Obscured. Once the bar is revealed it is
     fixed to the bottom for the rest of the page, so the last focusable things
     on it — the footer links, the final trust line — sat permanently behind it
     with no scroll left to clear them. Tabbing to them moved focus somewhere
     the visitor could not see.

     :has() so the reservation exists only while the bar does; reserving the
     space unconditionally would leave a dead strip under every product page on
     a desktop, where the bar never renders at all. */
  html:has(.sl-buybar:not([hidden])) {
    scroll-padding-bottom: 84px;
  }
  html:has(.sl-buybar:not([hidden])) body {
    padding-bottom: calc(84px + env(safe-area-inset-bottom, 0px));
  }
}

/* buy zone: quantity, add-to-cart, and the payment button share one column */
.sl-main-product__buy {
  display: flex;
  align-items: flex-end;
  gap: 12px;
  width: min(100%, 440px);
}
.sl-main-product__buy .sl-add {
  flex: 1 1 auto;
  min-width: 0;
}
.sl-main-product__qty .sl-qty {
  display: block;
  width: 84px;
}

@media (min-width: 750px) {
  .sl-main-product__gear-form .sl-select { width: min(100%, 440px); }
}

@media (max-width: 749px) {
  .sl-product-info > .sl-eyebrow,
  .sl-product-title {
    text-align: center;
  }
  .sl-product-form { align-items: center; }
  /* Full-width controls read as one column instead of a ragged center. */
  .sl-main-product__gear-form .sl-select,
  .sl-main-product__gear-form .sl-add {
    width: 100%;
    min-width: 0;
  }
  .sl-product-thumbs { justify-content: center; }
  .sl-trust--stack { margin-inline: auto; text-align: left; }
  .sl-main-product__flags,
  .sl-main-product__price {
    justify-content: center;
  }
  .sl-main-product__buy {
    flex-direction: column;
    align-items: center;
    gap: 14px;
    width: 100%;
  }
  .sl-main-product__qty {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .sl-main-product__media-label {
    top: 12px;
    left: 50%;
    max-width: calc(100% - 24px);
    transform: translateX(-50%);
    text-align: center;
  }
  .sl-main-product__desc-label { text-align: center; }
}
{% endstylesheet %}

{% javascript %}
// The sticky buy bar's reveal, and the one piece of state it has to borrow.
//
// The bar appears once the real buy zone has scrolled out of view and hides
// again when it comes back — otherwise it sits on top of the button it
// duplicates, which is how a sticky bar ends up covering the thing you already
// tapped.
//
// It also mirrors the main button's disabled state and label. The variant
// picker rewrites those when a sold-out option is chosen, and a sticky button
// still reading "Add to cart" for a variant that cannot be added is worse than
// no sticky button: it takes the tap and fails silently.
(function () {
  var bar = document.querySelector('[data-buybar]');
  var zone = document.querySelector('.sl-main-product__buy');
  if (!bar || !zone || !('IntersectionObserver' in window)) return;

  var source = zone.querySelector('.sl-add');
  var mirror = bar.querySelector('.sl-buybar__add');

  function sync() {
    if (!source || !mirror) return;
    mirror.disabled = source.disabled;
    mirror.textContent = source.textContent.trim();
  }

  new IntersectionObserver(function (entries) {
    entries.forEach(function (entry) {
      // Only reveal once the zone has gone past the TOP of the viewport. A
      // plain !isIntersecting also fires before the buy zone has been scrolled
      // to at all, which shows the bar on load.
      var scrolledPast = !entry.isIntersecting && entry.boundingClientRect.top < 0;
      bar.hidden = !scrolledPast;
      if (scrolledPast) sync();
    });
  }, { rootMargin: '0px' }).observe(zone);

  // The variant picker mutates the button rather than replacing it, so watch
  // the attributes and text rather than listening for a change event whose
  // ordering relative to the picker's own handler is not guaranteed.
  if (source && 'MutationObserver' in window) {
    new MutationObserver(sync).observe(source, {
      attributes: true,
      childList: true,
      characterData: true,
      subtree: true,
    });
  }
})();
{% endjavascript %}

{% schema %}
{
  "name": "Product page",
  "settings": [
    {
      "type": "header",
      "content": "Gear and apparel products"
    },
    {
      "type": "text",
      "id": "flags_label",
      "label": "Flag chips label",
      "default": "Recommended for",
      "info": "Shown before the swing-report flag chips parsed from swinglab: tags."
    },
    {
      "type": "text",
      "id": "trust_1",
      "label": "Trust line 1",
      "default": "Ships in 1–2 business days, tracked",
      "info": "Paired with the parcel icon."
    },
    {
      "type": "text",
      "id": "trust_2",
      "label": "Trust line 2",
      "default": "30-day returns on unused gear",
      "info": "Paired with the returns icon."
    },
    {
      "type": "text",
      "id": "trust_3",
      "label": "Trust line 3",
      "default": "Matched to your report’s practice focus",
      "info": "Paired with the target icon."
    }
  ]
}
{% endschema %}
