{%- liquid
  # Live plan pricing from the Pro product. Variants resolve by SKU —
  # lifetime access is always SKU SL-PRO-LIFE, never a title match — with
  # static text and deep-link fallbacks when the product cannot resolve.
  assign pro_product = all_products['swinglab-pro']
  assign monthly_cents = 0
  assign season_cents = 0
  assign monthly_live = ''
  assign season_live = ''
  assign founders_live = ''
  assign season_permo_live = ''
  assign monthly_live_url = ''
  assign season_live_url = ''
  assign founders_live_url = ''
  if pro_product != blank
    for variant in pro_product.variants
      if variant.sku == 'SL-PRO-LIFE'
        assign founders_live = variant.price | money
        assign founders_live_url = variant.url
      elsif variant.sku == 'SL-PRO-12MO'
        assign season_cents = variant.price
        assign season_live = variant.price | money
        assign season_permo_live = variant.price | divided_by: 12 | money
        assign season_live_url = variant.url
      elsif variant.sku == 'SL-PRO-1MO'
        assign monthly_cents = variant.price
        assign monthly_live = variant.price | money
        assign monthly_live_url = variant.url
      endif
    endfor
    if monthly_live == ''
      assign monthly_cents = pro_product.price_min
      assign monthly_live = pro_product.price_min | money
    endif
  endif

  assign save_pct = 42
  if monthly_cents > 0 and season_cents > 0
    assign yearly_equiv = monthly_cents | times: 12
    if yearly_equiv > season_cents
      assign save_pct = yearly_equiv | minus: season_cents | times: 100.0 | divided_by: yearly_equiv | round
    endif
  endif
-%}

<section id="{{ section.settings.anchor | default: 'plans' }}"
         class="sl-plans"{% if section.settings.membership_section %} data-app-upgrade-section{% endif %}>
  <span class="sl-plans__arc" aria-hidden="true"></span>
  <div class="sl-wrap">
    <header class="sl-plans__head sl-reveal">
      <p class="sl-plans__eyebrow">{{ 'homepage.plans.eyebrow' | t }}</p>
      <h2 class="sl-plans__title">
        {%- if section.settings.membership_section -%}
          <span data-app-auth-signed-out>{{ section.settings.heading | default: 'Start free. Go Pro when the reps matter.' }}</span>
          <span data-app-auth-signed-in hidden>{{ 'homepage.plans.member_heading' | t }}</span>
        {%- else -%}
          {{ section.settings.heading | default: 'Start free. Go Pro when the reps matter.' }}
        {%- endif -%}
      </h2>
      {%- if section.settings.subheading != blank -%}
        <p class="sl-plans__sub"{% if section.settings.membership_section %} data-app-auth-signed-out{% endif %}>{{ section.settings.subheading }}</p>
      {%- endif -%}
      {%- if section.settings.membership_section -%}
        <p class="sl-plans__sub" data-app-auth-signed-in hidden>{{ 'homepage.plans.member_subheading' | t }}</p>
      {%- endif -%}
    </header>

    <ul class="sl-plans__grid sl-reveal sl-reveal--d1">
      {%- for block in section.blocks -%}
        {%- if block.type == 'plan' -%}
          {%- liquid
            assign b = block.settings
            assign plan_price = ''
            assign plan_permo = ''
            assign plan_url = b.url
            if b.plan == 'season'
              assign plan_price = season_live
              assign plan_permo = season_permo_live
              if plan_url == blank
                assign plan_url = season_live_url
              endif
              if plan_url == blank
                assign plan_url = '/products/swinglab-pro?variant=46811170209964'
              endif
              if plan_permo == ''
                assign plan_permo = '$5.83'
              endif
            elsif b.plan == 'founders'
              assign plan_price = founders_live
              if plan_url == blank
                assign plan_url = founders_live_url
              endif
              if plan_url == blank
                assign plan_url = '/products/swinglab-pro?variant=46839745282220'
              endif
            else
              assign plan_price = monthly_live
              if plan_url == blank
                assign plan_url = monthly_live_url
              endif
              if plan_url == blank
                assign plan_url = '/products/swinglab-pro?variant=46811170177196'
              endif
            endif
            if plan_price == ''
              assign plan_price = b.price_text
            endif
            if plan_price == blank
              case b.plan
                when 'season'
                  assign plan_price = '$69.99'
                when 'founders'
                  assign plan_price = '$149'
                else
                  assign plan_price = '$9.99'
              endcase
            endif
            assign default_art = 'caddieinsight-pro-card-v2.png'
            if b.plan == 'founders'
              assign default_art = 'caddieinsight-founders-card-v2.png'
            endif
          -%}
          <li class="sl-plans__card{% if b.featured %} sl-plans__card--featured{% endif %}"{{ block.shopify_attributes }}>
            <div class="sl-plans__media">
              {%- if b.image -%}
                <img
                  src="{{ b.image | image_url: width: 720 }}"
                  srcset="{{ b.image | image_url: width: 480 }} 480w, {{ b.image | image_url: width: 720 }} 720w, {{ b.image | image_url: width: 1080 }} 1080w"
                  sizes="(max-width: 749px) calc(100vw - 50px), (max-width: 1019px) min(100vw - 50px, 560px), 396px"
                  width="{{ b.image.width }}"
                  height="{{ b.image.height }}"
                  alt=""
                  loading="lazy"
                  decoding="async">
              {%- else -%}
                <img
                  src="{{ default_art | asset_img_url: '720x' }}"
                  srcset="{{ default_art | asset_img_url: '480x' }} 480w, {{ default_art | asset_img_url: '720x' }} 720w, {{ default_art | asset_img_url: '1080x' }} 1080w"
                  sizes="(max-width: 749px) calc(100vw - 50px), (max-width: 1019px) min(100vw - 50px, 560px), 396px"
                  width="1536"
                  height="1024"
                  alt=""
                  loading="lazy"
                  decoding="async">
              {%- endif -%}
            </div>
            <div class="sl-plans__card-body">
              {%- if b.badge != blank -%}<p class="sl-plans__badge">{{ b.badge }}</p>{%- endif -%}
              <h3 class="sl-plans__name">{{ b.name | default: 'CaddieInsight Pro' }}</h3>
              <p class="sl-plans__price">
                <span class="sl-plans__amount">{{ plan_price }}</span>
                {%- if b.term != blank -%}<span class="sl-plans__term">{{ b.term }}</span>{%- endif -%}
                {%- if b.show_save -%}<span class="sl-badge-save">{{ 'homepage.plans.save_chip' | t: percent: save_pct }}</span>{%- endif -%}
              </p>
              {%- if b.plan == 'season' -%}
                <p class="sl-plans__permo">{{ 'homepage.plans.permo' | t: amount: plan_permo }}</p>
              {%- endif -%}
              {%- if b.description != blank -%}<p class="sl-plans__desc">{{ b.description }}</p>{%- endif -%}
              {%- if b.note != blank -%}<p class="sl-plans__note">{{ b.note }}</p>{%- endif -%}
              <a class="sl-btn{% if b.featured %} sl-plans__cta--featured{% else %} sl-btn--outline{% endif %} sl-plans__cta" href="{{ plan_url }}">{{ b.cta_label | default: 'Get Pro' }}</a>
            </div>
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>

    {%- for block in section.blocks -%}
      {%- if block.type == 'free_band' -%}
        {%- liquid
          assign fb = block.settings
          assign free_url = fb.url
          if free_url == blank
            assign free_url = 'https://app.caddieinsight.com/signup'
          endif
        -%}
        <aside class="sl-plans__free sl-reveal sl-reveal--d2"
               aria-labelledby="PlansFree-{{ section.id }}"
               {% if fb.member_visibility == 'signed_out' %}data-app-auth-signed-out{% endif %}{{ block.shopify_attributes }}>
          <div class="sl-plans__free-media" aria-hidden="true">
            {%- if fb.image -%}
              <img
                src="{{ fb.image | image_url: width: 320 }}"
                srcset="{{ fb.image | image_url: width: 320 }} 320w, {{ fb.image | image_url: width: 480 }} 480w"
                sizes="148px"
                width="{{ fb.image.width }}"
                height="{{ fb.image.height }}"
                alt=""
                loading="lazy"
                decoding="async">
            {%- else -%}
              <img
                src="{{ 'caddieinsight-free-card-v2.png' | asset_img_url: '320x' }}"
                srcset="{{ 'caddieinsight-free-card-v2.png' | asset_img_url: '320x' }} 320w, {{ 'caddieinsight-free-card-v2.png' | asset_img_url: '480x' }} 480w"
                sizes="148px"
                width="1536"
                height="1024"
                alt=""
                loading="lazy"
                decoding="async">
            {%- endif -%}
          </div>
          <div class="sl-plans__free-copy">
            <h3 id="PlansFree-{{ section.id }}" class="sl-plans__free-name">{{ fb.name | default: 'CaddieInsight Free' }}</h3>
            {%- if fb.description != blank -%}<p class="sl-plans__free-desc">{{ fb.description }}</p>{%- endif -%}
          </div>
          <div class="sl-plans__free-side">
            <p class="sl-plans__free-price">{{ fb.price_text | default: '$0' }}</p>
            {%- if fb.note != blank -%}<p class="sl-plans__free-note">{{ fb.note }}</p>{%- endif -%}
            <a class="sl-btn sl-plans__ghost" href="{{ free_url }}">{{ fb.cta_label | default: 'Start free' }}</a>
          </div>
        </aside>
      {%- endif -%}
    {%- endfor -%}

    {%- if section.settings.footnote != blank -%}
      <p class="sl-plans__footnote">{{ section.settings.footnote }}</p>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
.sl-plans {
  position: relative;
  overflow: clip;
  padding-top: var(--sl-section-space);
  padding-bottom: var(--sl-section-space);
  background:
    radial-gradient(circle at 16% 8%, rgba(37, 111, 70, 0.22), transparent 34%),
    #06110c;
  color: #f5f2e9;
}
/* one faint quarter-sweep, the same pendulum ghost the CTA banner carries */
.sl-plans__arc {
  position: absolute;
  top: -300px;
  right: -220px;
  width: 660px;
  aspect-ratio: 1;
  border: 1.5px solid transparent;
  border-bottom-color: rgba(245, 242, 233, 0.14);
  border-radius: 50%;
  transform: rotate(-12deg);
  pointer-events: none;
}
.sl-plans__head {
  position: relative;
  max-width: 720px;
  margin-inline: auto;
  text-align: center;
}
.sl-plans__eyebrow {
  margin: 0 0 14px;
  color: #ff9a42;
  font-family: var(--sl-font-mono);
  font-size: var(--sl-eyebrow-size);
  font-weight: 500;
  letter-spacing: var(--sl-eyebrow-track);
  text-transform: uppercase;
}
.sl-plans__title {
  max-width: 14ch;
  margin: 0 auto;
  color: #f5f2e9;
  font-family: var(--sl-font-display);
  font-size: var(--sl-heading-display);
  font-weight: 700;
  letter-spacing: -0.04em;
  line-height: 1.02;
  text-wrap: balance;
}
.sl-plans__sub {
  max-width: 42ch;
  margin: 14px auto 0;
  font-size: var(--sl-text-lg);
  font-weight: 400;
  line-height: 1.55;
  letter-spacing: -0.012em;
  color: rgba(245, 242, 233, 0.72);
  text-align: center;
  text-wrap: pretty;
}
.sl-plans__grid {
  margin: clamp(36px, 5vw, 56px) 0 0;
  padding: 0;
  list-style: none;
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  justify-items: center;
  align-items: stretch;
  gap: 18px;
}
.sl-plans__card {
  position: relative;
  width: min(100%, 560px);
  min-width: 0;
  height: 100%;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: var(--sl-bg-card);
  border: 1px solid rgba(245, 242, 233, 0.16);
  border-radius: var(--sl-radius-lg);
  color: var(--sl-ink);
  box-shadow: 0 34px 76px -38px rgba(0, 0, 0, 0.85);
}
.sl-plans__card--featured {
  border-color: rgba(240, 122, 24, 0.66);
  box-shadow: 0 44px 92px -36px rgba(0, 0, 0, 0.95);
}
/* the featured card's kinetic hairline, entering from the left edge */
.sl-plans__card--featured::before {
  content: "";
  display: block;
  flex: none;
  height: 3px;
  background: linear-gradient(90deg, #f07a18 0%, #f07a18 58%, rgba(240, 122, 24, 0) 100%);
}
.sl-plans .sl-plans__card :focus-visible { outline-color: var(--sl-green-btn); }
.sl-plans__media {
  position: relative;
  aspect-ratio: 3 / 2;
  overflow: hidden;
  line-height: 0;
  background: var(--sl-bg);
  border-bottom: 1px solid var(--sl-border);
}
.sl-plans__media img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center 42%;
  transform: scale(1.01);
}
.sl-plans__card-body {
  padding: var(--sl-card-inset);
  display: flex;
  flex-direction: column;
  align-items: stretch;
  justify-content: flex-start;
  gap: 8px;
  flex: 1;
  text-align: left;
}
.sl-plans__badge {
  margin: 0;
  font-family: var(--sl-font-mono);
  font-size: var(--sl-eyebrow-size);
  font-weight: 500;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--sl-orange);
}
.sl-plans__name {
  margin: 0;
  font-size: clamp(22px, 2vw, 26px);
  font-weight: 800;
  letter-spacing: -0.015em;
  color: var(--sl-green);
}
.sl-plans__price {
  margin: 2px 0 0;
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  gap: 8px 10px;
}
.sl-plans__amount {
  font-size: clamp(30px, 2.6vw, 38px);
  font-weight: 800;
  letter-spacing: -0.02em;
  line-height: 1;
  font-variant-numeric: tabular-nums;
  color: var(--sl-ink);
}
.sl-plans__term {
  font-family: var(--sl-font-mono);
  font-size: 12px;
  font-weight: 500;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--sl-ink-muted);
}
.sl-plans__price .sl-badge-save { transform: translateY(-3px); }
.sl-plans__permo {
  margin: 0;
  font-family: var(--sl-font-mono);
  font-size: 12px;
  font-weight: 500;
  letter-spacing: 0.04em;
  font-variant-numeric: tabular-nums;
  color: var(--sl-ink-soft);
}
.sl-plans__desc {
  margin: 6px 0 0;
  font-size: 15px;
  line-height: 1.55;
  color: var(--sl-ink-soft);
  flex: 1;
  text-wrap: pretty;
}
.sl-plans__note {
  margin: 14px 0 0;
  padding-top: 12px;
  border-top: 1px solid var(--sl-border);
  font-family: var(--sl-font-mono);
  font-size: 10.5px;
  font-weight: 500;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: var(--sl-ink-muted);
}
.sl-plans__cta {
  width: 100%;
  margin-top: 16px;
}
.sl-plans__cta--featured {
  border-color: #f07a18;
  background: #f07a18;
  color: #06110c;
  box-shadow: 0 16px 34px -20px rgba(240, 122, 24, 0.9);
}
.sl-plans__cta--featured:hover {
  border-color: #ff9a42;
  background: #ff9a42;
  color: #06110c;
}
.sl-plans__free {
  margin-top: clamp(26px, 4vw, 40px);
  display: flex;
  align-items: center;
  gap: clamp(18px, 3vw, 32px);
  padding: var(--sl-dense-inset) var(--sl-card-inset);
  border: 1px solid rgba(245, 242, 233, 0.16);
  border-radius: var(--sl-radius-lg);
  background: rgba(16, 40, 27, 0.55);
  -webkit-backdrop-filter: blur(14px);
  backdrop-filter: blur(14px);
}
.sl-plans__free-media {
  flex: 0 0 148px;
  overflow: hidden;
  border: 1px solid rgba(245, 242, 233, 0.18);
  border-radius: var(--sl-radius-sm);
  line-height: 0;
}
.sl-plans__free-media img {
  display: block;
  width: 100%;
  height: auto;
}
.sl-plans__free-copy {
  flex: 1;
  min-width: 0;
}
.sl-plans__free-name {
  margin: 0;
  font-size: 19px;
  font-weight: 800;
  letter-spacing: -0.01em;
  color: #f5f2e9;
}
.sl-plans__free-desc {
  margin: 6px 0 0;
  max-width: 58ch;
  font-size: 14.5px;
  line-height: 1.55;
  color: rgba(245, 242, 233, 0.7);
  text-wrap: pretty;
}
.sl-plans__free-side {
  flex: none;
  display: grid;
  gap: 8px;
  justify-items: end;
  text-align: right;
}
.sl-plans__free-price {
  margin: 0;
  font-size: 26px;
  font-weight: 800;
  line-height: 1;
  font-variant-numeric: tabular-nums;
  color: #ffffff;
}
.sl-plans__free-note {
  margin: 0;
  font-family: var(--sl-font-mono);
  font-size: 10.5px;
  font-weight: 500;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: rgba(245, 242, 233, 0.6);
}
.sl-plans__ghost {
  min-height: 44px;
  border-color: rgba(245, 242, 233, 0.45);
  background: transparent;
  color: #f5f2e9;
}
.sl-plans__ghost:hover {
  border-color: rgba(245, 242, 233, 0.85);
  background: rgba(245, 242, 233, 0.1);
  color: #ffffff;
}
.sl-plans__footnote {
  max-width: 62ch;
  margin: 18px auto 0;
  font-size: 13px;
  line-height: 1.55;
  color: rgba(245, 242, 233, 0.6);
  text-align: center;
}
@media (prefers-reduced-motion: no-preference) {
  .sl-plans__card {
    transition: transform 0.22s ease, box-shadow 0.22s ease, border-color 0.22s ease;
  }
  .sl-plans__card:hover {
    transform: translateY(-4px);
    box-shadow: 0 48px 96px -36px rgba(0, 0, 0, 0.98);
  }
}
@media (min-width: 1020px) {
  .sl-plans__grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
    justify-items: stretch;
    padding: 14px 0;
  }
  .sl-plans__card { width: auto; }
  .sl-plans__card--featured { margin-block: -14px; }
}
@media (max-width: 1019px) {
  .sl-plans__card--featured { order: -1; }
}
@media (max-width: 749px) {
  .sl-plans__card-body {
    align-items: center;
    text-align: center;
  }
  .sl-plans__price { justify-content: center; }
  .sl-plans__desc {
    max-width: 40ch;
    margin-inline: auto;
    text-align: center;
  }
  .sl-plans__note {
    width: 100%;
    text-align: center;
  }
  .sl-plans__free {
    flex-direction: column;
    padding: var(--sl-card-inset);
    text-align: center;
  }
  .sl-plans__free-media {
    flex-basis: auto;
    width: 148px;
  }
  .sl-plans__free-desc { margin-inline: auto; }
  .sl-plans__free-side {
    width: 100%;
    justify-items: center;
    text-align: center;
  }
  .sl-plans__ghost {
    width: min(100%, 320px);
    justify-content: center;
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Plans band",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Section anchor id", "default": "plans" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Start free. Go Pro when the reps matter." },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "The coaching engine stays the same. Pro removes the monthly limit and adds replay plus progress tracking." },
    { "type": "checkbox", "id": "membership_section", "label": "Personalize this as a membership section", "default": true },
    { "type": "textarea", "id": "footnote", "label": "Footnote", "default": "Pro connects to the CaddieInsight account linked to your purchase email. After checkout, open the app to sign in or finish account setup." }
  ],
  "blocks": [
    {
      "type": "plan",
      "name": "Paid plan card",
      "settings": [
        { "type": "select", "id": "plan", "label": "Plan", "options": [
          { "value": "monthly", "label": "Pro Monthly (SKU SL-PRO-1MO)" },
          { "value": "season", "label": "Season Pass (SKU SL-PRO-12MO)" },
          { "value": "founders", "label": "Founders Pass (SKU SL-PRO-LIFE)" }
        ], "default": "monthly", "info": "Chooses which live variant supplies the price and buy link." },
        { "type": "text", "id": "badge", "label": "Badge", "default": "MEMBERSHIP" },
        { "type": "text", "id": "name", "label": "Plan name", "default": "CaddieInsight Pro" },
        { "type": "text", "id": "price_text", "label": "Price fallback", "info": "Shown only when the live variant price cannot resolve." },
        { "type": "text", "id": "term", "label": "Price term", "default": "/mo", "info": "Small mono suffix after the price, e.g. /mo, /yr, one payment." },
        { "type": "textarea", "id": "description", "label": "Description" },
        { "type": "text", "id": "note", "label": "Mono note", "info": "Specimen-style terms line above the button, e.g. FIRST 100 MEMBERS · NEVER RENEWS." },
        { "type": "text", "id": "cta_label", "label": "Button label", "default": "Get Pro" },
        { "type": "url", "id": "url", "label": "Button link", "info": "Leave blank to deep-link the matching variant on the Pro product page." },
        { "type": "checkbox", "id": "featured", "label": "Feature this plan", "default": false },
        { "type": "checkbox", "id": "show_save", "label": "Show the savings chip", "default": false, "info": "Computed against twelve months of the monthly price." },
        { "type": "image_picker", "id": "image", "label": "Card art", "info": "Leave blank to use the packaged membership card artwork." }
      ]
    },
    {
      "type": "free_band",
      "name": "Free plan band",
      "settings": [
        { "type": "text", "id": "name", "label": "Plan name", "default": "CaddieInsight Free" },
        { "type": "textarea", "id": "description", "label": "Description", "default": "One full analysis and one matched re-film each month, with saved club context and a measurable practice plan." },
        { "type": "text", "id": "price_text", "label": "Price", "default": "$0" },
        { "type": "text", "id": "note", "label": "Mono note", "default": "NO CARD REQUIRED" },
        { "type": "text", "id": "cta_label", "label": "Button label", "default": "Start free" },
        { "type": "url", "id": "url", "label": "Button link", "info": "Leave blank to link the app signup." },
