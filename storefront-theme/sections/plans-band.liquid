    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "The coaching engine stays the same. Pro removes the monthly limit and adds replay plus progress tracking." },
    { "type": "checkbox", "id": "membership_section", "label": "Personalize this as a membership section", "default": true },
    { "type": "textarea", "id": "footnote", "label": "Footnote", "default": "Pro connects to the CaddieInsight account linked to your purchase email. After checkout, open the app to sign in or finish account setup." }
  ],
  "blocks": [
    {
      "type": "plan",
      "name": "Paid plan card",
      "settings": [
        { "type": "select", "id": "plan", "label": "Plan", "options": [
          { "value": "monthly", "label": "Pro Monthly (SKU SL-PRO-1MO)" },
          { "value": "season", "label": "Season Pass (SKU SL-PRO-12MO)" },
          { "value": "coach", "label": "Coach Monthly (SKU SL-COACH-1MO)" },
          { "value": "founders", "label": "Founders Pass (SKU SL-PRO-LIFE)" }
        ], "default": "monthly", "info": "Chooses which live variant supplies the price and buy link." },
        { "type": "text", "id": "badge", "label": "Badge", "default": "MEMBERSHIP" },
        { "type": "text", "id": "name", "label": "Plan name", "default": "CaddieInsight Pro" },
        { "type": "text", "id": "price_text", "label": "Price fallback", "info": "Shown only when the live variant price cannot resolve." },
        { "type": "text", "id": "term", "label": "Price term", "default": "/mo", "info": "Small mono suffix after the price, e.g. /mo, /yr, one payment." },
        { "type": "textarea", "id": "description", "label": "Description" },
        { "type": "text", "id": "note", "label": "Mono note", "info": "Specimen-style terms line above the button, e.g. FIRST 100 MEMBERS · NEVER RENEWS." },
        { "type": "text", "id": "cta_label", "label": "Button label", "default": "Get Pro" },
        { "type": "url", "id": "url", "label": "Button link", "info": "Leave blank to deep-link the matching variant on the Pro product page." },
        { "type": "checkbox", "id": "featured", "label": "Feature this plan", "default": false, "info": "Raises the card and inks its rule. Feature one card only." },
        { "type": "checkbox", "id": "show_save", "label": "Show the savings chip", "default": false, "info": "Computed against twelve months of the monthly price, and shown on the yearly line — the plan the saving belongs to." },
        { "type": "image_picker", "id": "image", "label": "Card art", "info": "Leave blank to use the packaged membership card artwork." }
      ]
    },
    {
      "type": "free_band",
      "name": "Free plan band",
      "settings": [
        { "type": "text", "id": "name", "label": "Plan name", "default": "CaddieInsight Free" },
        { "type": "textarea", "id": "description", "label": "Description", "default": "One full analysis and one matched re-film each month, with saved club context and a measurable practice plan." },
        { "type": "text", "id": "price_text", "label": "Price", "default": "$0" },
        { "type": "text", "id": "note", "label": "Mono note", "default": "NO CARD REQUIRED", "info": "Sits in the band's spec rail, beside the 00 index." },
        { "type": "text", "id": "cta_label", "label": "Button label", "default": "Start free" },
        { "type": "url", "id": "url", "label": "Button link", "info": "Leave blank to link the app signup." },
        { "type": "select", "id": "member_visibility", "label": "Member visibility", "options": [
          { "value": "all", "label": "Everyone" },
          { "value": "signed_out", "label": "Signed-out visitors only" }
        ], "default": "signed_out" },
        { "type": "image_picker", "id": "image", "label": "Band art", "info": "Leave blank to use the packaged Free membership card artwork." }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Plans band",
      "blocks": [
        { "type": "free_band" },
        {
          "type": "plan",
          "settings": {
            "plan": "monthly",
            "badge": "MEMBERSHIP · PRO",
            "name": "CaddieInsight Pro",
            "price_text": "$9.99",
            "term": "/mo",
