<div class="sl-wrap sl-auth">
  <header class="sl-page-hero">
    <p class="sl-eyebrow">Store account</p>
    <h1 class="sl-page-hero__title">Set a new password</h1>
  </header>

  <div class="sl-auth__card">
    {% form 'reset_customer_password', class: 'sl-auth__form' %}
      {%- if form.errors -%}
        <div class="sl-auth__errors" role="alert">{{ form.errors | default_errors }}</div>
      {%- endif -%}
      <div class="sl-auth__field">
        <label class="sl-label" for="sl-reset-password">New password</label>
        <input id="sl-reset-password" class="sl-input" type="password" name="customer[password]" autocomplete="new-password" required>
      </div>
      <div class="sl-auth__field">
        <label class="sl-label" for="sl-reset-confirm">Confirm password</label>
        <input id="sl-reset-confirm" class="sl-input" type="password" name="customer[password_confirmation]" autocomplete="new-password" required>
      </div>
      <button type="submit" class="sl-btn sl-btn--primary">Save password</button>
    {% endform %}
  </div>
</div>

{% schema %}
{
  "name": "Reset password",
  "settings": []
}
{% endschema %}
