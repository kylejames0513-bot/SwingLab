{%- liquid
  # Live Pro pricing for the "Price" row, with graceful fallback to the
  # static block text when the product or a named variant cannot resolve.
  # Variants match by SKU first; lifetime access is always SKU SL-PRO-LIFE.
  assign pro_product = all_products['swinglab-pro']
  assign live_pro_price = ''
  assign live_coach_price = ''
  if pro_product != blank
    assign monthly_price = pro_product.price_min | money
    assign yearly_price = ''
    assign founders_price = ''
    assign coach_monthly_price = ''
    assign coach_yearly_price = ''
    for variant in pro_product.variants
      assign variant_title = variant.title | downcase
      if variant.sku == 'SL-PRO-LIFE'
        assign founders_price = variant.price | money
      elsif variant.sku == 'SL-COACH-1MO'
        assign coach_monthly_price = variant.price | money
      elsif variant.sku == 'SL-COACH-12MO'
        assign coach_yearly_price = variant.price | money
      elsif variant.sku == 'SL-PRO-12MO'
        assign yearly_price = variant.price | money
      elsif yearly_price == '' and variant_title contains 'year' or variant_title contains 'annual' or variant_title contains 'season'
        assign yearly_price = variant.price | money
      endif
    endfor
    assign live_pro_price = monthly_price | append: '/mo'
    if yearly_price != blank
      assign live_pro_price = live_pro_price | append: ' · Season Pass ' | append: yearly_price | append: '/yr'
    endif
    if coach_monthly_price != blank
      assign live_coach_price = coach_monthly_price | append: '/mo'
      if coach_yearly_price != blank
        assign live_coach_price = live_coach_price | append: ' · ' | append: coach_yearly_price | append: '/yr'
      endif
      # Founders is Coach-for-life, so its price belongs to the Coach column
      # when that column renders...
      if founders_price != blank
        assign live_coach_price = live_coach_price | append: ' · Founders Pass ' | append: founders_price
      endif
    endif
    # ...and stays on the Pro line only for a two-column configuration.
    if founders_price != blank and section.settings.coach_label == blank
      assign live_pro_price = live_pro_price | append: ' · Founders Pass ' | append: founders_price
    endif
  endif
-%}
<section id="{{ section.settings.anchor | default: 'compare' }}" class="sl-compare" data-app-upgrade-section>
  <div class="sl-wrap sl-reveal">
    <div class="sl-compare__head">
      <p class="sl-eyebrow">{{ 'homepage.comparison.eyebrow' | t }}</p>
      <h2 class="sl-h2">
        <span data-app-auth-signed-out>{{ section.settings.heading | default: 'Compare Free and Pro.' }}</span>
        <span data-app-auth-signed-in hidden>{{ 'homepage.comparison.member_heading' | t }}</span>
      </h2>
      {%- if section.settings.sub != blank -%}
        <p class="sl-compare__sub" data-app-auth-signed-out>{{ section.settings.sub }}</p>
      {%- endif -%}
      <p class="sl-compare__sub" data-app-auth-signed-in hidden>{{ 'homepage.comparison.member_subheading' | t }}</p>
    </div>

    <div class="sl-compare__scroll">
      <table class="sl-compare__table">
        <thead>
          <tr>
            <th scope="col" class="sl-compare__feature-head"><span class="visually-hidden">Feature</span></th>
            <th scope="col" class="sl-compare__col">{{ section.settings.free_label | default: 'Free' }}</th>
            <th scope="col" class="sl-compare__col sl-compare__col--pro">{{ section.settings.pro_label | default: 'Pro' }}</th>
            {%- if section.settings.coach_label != blank -%}
              <th scope="col" class="sl-compare__col sl-compare__col--pro">{{ section.settings.coach_label }}</th>
            {%- endif -%}
          </tr>
        </thead>
        <tbody>
          {%- for block in section.blocks -%}
          {%- assign feature_key = block.settings.feature | downcase | strip -%}
          <tr {{ block.shopify_attributes }}>
              <th scope="row">{{ block.settings.feature }}</th>
              <td data-col="{{ section.settings.free_label | default: 'Free' | escape }}">{{ block.settings.free_value }}</td>
              <td class="sl-compare__pro" data-col="{{ section.settings.pro_label | default: 'Pro' | escape }}">
                {%- if feature_key == 'price' and live_pro_price != blank -%}
                  {{ live_pro_price }}
                {%- else -%}
                  {{ block.settings.pro_value }}
                {%- endif -%}
              </td>
              {%- if section.settings.coach_label != blank -%}
                <td class="sl-compare__pro" data-col="{{ section.settings.coach_label | escape }}">
                  {%- if feature_key == 'price' and live_coach_price != blank -%}
                    {{ live_coach_price }}
                  {%- else -%}
                    {{ block.settings.coach_value }}
                  {%- endif -%}
                </td>
              {%- endif -%}
            </tr>
          {%- endfor -%}
        </tbody>
      </table>
    </div>

    <div class="sl-compare__actions">
      {%- if section.settings.primary_label != blank -%}
        <a href="{{ section.settings.primary_url | default: '/products/swinglab-pro' }}"
           class="sl-btn sl-btn--primary"
           data-app-pro-sales-link>{{ section.settings.primary_label }}</a>
      {%- endif -%}
      {%- if section.settings.secondary_label != blank -%}
        <a href="{{ section.settings.secondary_url | default: '#' }}"
           class="sl-btn sl-btn--outline"
           data-app-primary-cta
           data-app-signed-out-label="{{ section.settings.secondary_label | escape }}"
           data-app-signed-out-url="{{ section.settings.secondary_url | default: '#' }}">
          <span data-app-cta-label>{{ section.settings.secondary_label }}</span>
        </a>
      {%- endif -%}
    </div>
    {%- if section.settings.footnote != blank -%}
      <p class="sl-compare__footnote">{{ section.settings.footnote }}</p>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
.sl-compare {
  padding-top: var(--sl-section-space);
  padding-bottom: var(--sl-section-space);
  background: #f0eee7;
}
.sl-compare__head {
  max-width: 880px;
  margin-inline: auto;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 18px;
  text-align: center;
}
.sl-compare__head .sl-eyebrow { margin: 0; }
.sl-compare .sl-h2 {
  max-width: 13ch;
  margin-inline: auto;
  font-size: var(--sl-heading-support);
  font-weight: 800;
  letter-spacing: -0.045em;
  line-height: 1;
  text-wrap: balance;
}
.sl-compare__sub {
  margin: 0 auto;
  font-size: var(--sl-text-base);
  line-height: 1.55;
  color: var(--sl-ink-soft);
  text-align: center;
  max-width: 60ch;
  text-wrap: pretty;
}
.sl-compare__scroll {
  margin-top: clamp(34px, 5vw, 54px);
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
  border: 1px solid #ded8cc;
  border-radius: var(--sl-radius-lg);
  background: rgba(255, 253, 249, 0.88);
  box-shadow: 0 24px 60px -46px rgba(var(--sl-night-rgb), 0.5);
}
.sl-compare__table {
  width: 100%;
  min-width: 640px;
  border-collapse: separate;
  border-spacing: 0;
}
.sl-compare__table th,
.sl-compare__table td {
  padding: var(--sl-dense-inset);
  border-bottom: 1px solid var(--sl-border);
  text-align: center;
  vertical-align: middle;
}
.sl-compare__table thead th {
  font-family: var(--sl-font-mono);
  font-size: var(--sl-text-xs);
  font-weight: 500;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: var(--sl-ink-muted);
}
/* empty corner cell above the feature column; align with the row headers */
.sl-compare__feature-head { padding: var(--sl-dense-inset); }
.sl-compare__col { text-align: center; width: 22%; }
.sl-compare__col--pro {
  background: var(--sl-orange-soft);
  color: var(--sl-green);
  border-radius: 10px 10px 0 0;
}
.sl-compare__table tbody th {
  font-weight: 600;
  font-size: var(--sl-text-base);
  color: var(--sl-ink);
  text-align: left;
}
.sl-compare__table tbody td {
  font-family: var(--sl-font-mono);
  font-size: var(--sl-text-sm);
  font-variant-numeric: tabular-nums;
  color: var(--sl-ink-soft);
  text-align: center;
}
.sl-compare__table tbody td.sl-compare__pro {
  background: rgba(var(--sl-accent-rgb), 0.045);
  color: var(--sl-ink);
}
.sl-compare__table tbody tr:last-child td.sl-compare__pro {
  border-radius: 0 0 10px 10px;
}
/* evidence-table reading: the row under the pointer lifts quietly */
.sl-compare__table tbody tr:hover th,
.sl-compare__table tbody tr:hover td {
  background: rgba(var(--sl-green-rgb), 0.05);
}
.sl-compare__table tbody tr:hover td.sl-compare__pro {
  background: rgba(var(--sl-accent-rgb), 0.1);
}
@media (prefers-reduced-motion: no-preference) {
  .sl-compare__table tbody th,
  .sl-compare__table tbody td {
    transition: background-color 0.14s ease;
  }
}
.sl-compare__actions {
  width: min(100%, 440px);
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14px;
  margin: 30px auto 0;
}
.sl-compare__footnote {
  margin: 16px auto 0;
  font-size: var(--sl-text-sm);
  line-height: 1.55;
  color: var(--sl-ink-muted);
  max-width: 62ch;
  text-align: left;
}
@media (max-width: 749px) {
  /* The desktop grid stack was built for two value columns and garbled the
     moment Coach made three. On phones each feature is a small card: the
     feature title, then one labeled row per plan — nothing wraps, nothing
     orphans. */
  .sl-compare__scroll { overflow-x: visible; }
  .sl-compare__table { display: block; min-width: 0; }
  .sl-compare__table thead { display: none; }
  .sl-compare__table tbody { display: block; }
  .sl-compare__table tbody tr {
    display: block;
    margin-bottom: var(--sl-space-3);
    border: 1px solid var(--sl-border);
    border-radius: var(--sl-radius-sm);
    background: var(--sl-bg-card);
    overflow: hidden;
  }
  .sl-compare__table tbody th {
    display: block;
    width: auto;
    padding: var(--sl-space-3) var(--sl-dense-inset);
    background: #f8f4eb;
    text-align: left;
  }
  .sl-compare__table tbody td {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--sl-space-3);
    width: auto;
    padding: var(--sl-space-2) var(--sl-dense-inset);
    text-align: right;
    border-top: 1px solid var(--sl-border);
    overflow-wrap: anywhere;
  }
  .sl-compare__table tbody td::before {
    content: attr(data-col);
    flex: none;
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-xs);
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--sl-ink-muted);
  }
  .sl-compare__actions { width: 100%; }
}
@media (max-width: 749px) {
  .sl-compare__head { gap: 18px; }
  .sl-compare__sub {
    margin-top: 0;
    text-align: center;
  }
  .sl-compare__table tbody th { text-align: center; }
  .sl-compare__footnote { text-align: center; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Free vs Pro",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Section anchor id", "default": "compare" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Compare Free and Pro." },
    { "type": "textarea", "id": "sub", "label": "Subheading", "default": "Both plans use the same coaching engine. Pro removes the monthly limit and adds replay plus progress tracking." },
    { "type": "text", "id": "free_label", "label": "Free column label", "default": "Free" },
    { "type": "text", "id": "pro_label", "label": "Pro column label", "default": "Pro" },
    { "type": "text", "id": "coach_label", "label": "Coach column label", "info": "Leave empty to hide the Coach column." },
    { "type": "text", "id": "primary_label", "label": "Primary button label", "default": "Get Pro" },
    { "type": "url", "id": "primary_url", "label": "Primary button link" },
    { "type": "text", "id": "secondary_label", "label": "Secondary button label", "default": "Start free" },
    { "type": "url", "id": "secondary_url", "label": "Secondary button link" },
    { "type": "textarea", "id": "footnote", "label": "Footnote", "default": "Pro connects to the CaddieInsight account linked to your purchase email. After checkout, open the app to sign in or finish account setup." }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Feature row",
      "settings": [
        { "type": "text", "id": "feature", "label": "Feature", "default": "Swing analyses" },
        { "type": "text", "id": "free_value", "label": "Free value", "default": "1 per month" },
        { "type": "text", "id": "pro_value", "label": "Pro value", "default": "Unlimited" }
      ]
    }
  ],
  "max_blocks": 10,
  "presets": [
    {
      "name": "Free vs Pro",
      "blocks": [
        { "type": "row", "settings": { "feature": "Swing analyses", "free_value": "1 per month", "pro_value": "Unlimited" } },
        { "type": "row", "settings": { "feature": "Full report — strip, overlay, slow motion", "free_value": "Included", "pro_value": "Included" } },
        { "type": "row", "settings": { "feature": "Coaching notes + practice plan", "free_value": "Included", "pro_value": "Included" } },
        { "type": "row", "settings": { "feature": "Private, per-account session history", "free_value": "Included", "pro_value": "Included" } },
        { "type": "row", "settings": { "feature": "Matched training-aid recommendations", "free_value": "Included", "pro_value": "Included" } },
        { "type": "row", "settings": { "feature": "Annotated coach replay video", "free_value": "—", "pro_value": "Included" } },
        { "type": "row", "settings": { "feature": "Progress dashboard and trends", "free_value": "—", "pro_value": "Included" } },
        { "type": "row", "settings": { "feature": "Price", "free_value": "$0", "pro_value": "$9.99/mo · $69.99/yr Season Pass · $249 Founders Pass" } }
      ]
    }
  ]
}
{% endschema %}
