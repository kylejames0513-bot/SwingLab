<section id="{{ section.settings.anchor | default: 'compare' }}" class="sl-compare">
  <div class="sl-wrap sl-reveal">
    <div class="sl-compare__head">
      <h2 class="sl-h2">{{ section.settings.heading | default: 'Free gets you started. Pro keeps score.' }}</h2>
      {%- if section.settings.sub != blank -%}
        <p class="sl-compare__sub">{{ section.settings.sub }}</p>
      {%- endif -%}
    </div>

    <div class="sl-compare__scroll">
      <table class="sl-compare__table">
        <thead>
          <tr>
            <th scope="col" class="sl-compare__feature-head"><span class="visually-hidden">Feature</span></th>
            <th scope="col" class="sl-compare__col">{{ section.settings.free_label | default: 'Free' }}</th>
            <th scope="col" class="sl-compare__col sl-compare__col--pro">{{ section.settings.pro_label | default: 'Pro' }}</th>
          </tr>
        </thead>
        <tbody>
          {%- for block in section.blocks -%}
          <tr {{ block.shopify_attributes }}>
              <th scope="row">{{ block.settings.feature }}</th>
              <td>{{ block.settings.free_value }}</td>
              <td class="sl-compare__pro">{{ block.settings.pro_value }}</td>
            </tr>
          {%- endfor -%}
        </tbody>
      </table>
    </div>

    <div class="sl-compare__actions">
      {%- if section.settings.primary_label != blank -%}
        <a href="{{ section.settings.primary_url | default: '/products/swinglab-pro' }}" class="sl-btn sl-btn--primary">{{ section.settings.primary_label }}</a>
      {%- endif -%}
      {%- if section.settings.secondary_label != blank -%}
        <a href="{{ section.settings.secondary_url | default: '#' }}" class="sl-btn sl-btn--outline">{{ section.settings.secondary_label }}</a>
      {%- endif -%}
    </div>
    {%- if section.settings.footnote != blank -%}
      <p class="sl-compare__footnote">{{ section.settings.footnote }}</p>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
.sl-compare {
  padding-top: clamp(76px, 8vw, 112px);
  padding-bottom: clamp(76px, 8vw, 112px);
  background: #f0eee7;
}
.sl-compare__head {
  max-width: none;
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(280px, 0.55fr);
  gap: clamp(28px, 6vw, 84px);
  align-items: end;
}
.sl-compare .sl-h2 {
  max-width: 13ch;
  font-size: clamp(38px, 4.8vw, 62px);
  font-weight: 900;
  letter-spacing: -0.045em;
  line-height: 1;
  text-wrap: balance;
}
.sl-compare__sub {
  margin: 0;
  font-size: 16px;
  line-height: 1.55;
  color: var(--sl-ink-soft);
  max-width: 60ch;
  text-wrap: pretty;
}
.sl-compare__scroll {
  margin-top: clamp(34px, 5vw, 54px);
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
  border: 1px solid #ded8cc;
  border-radius: 22px;
  background: rgba(255, 253, 249, 0.88);
  box-shadow: 0 24px 60px -46px rgba(15, 42, 27, 0.5);
}
.sl-compare__table {
  width: 100%;
  min-width: 560px;
  border-collapse: separate;
  border-spacing: 0;
}
.sl-compare__table th,
.sl-compare__table td {
  padding: 17px 20px;
  border-bottom: 1px solid var(--sl-border);
  text-align: left;
  vertical-align: top;
}
.sl-compare__table thead th {
  font-family: var(--sl-font-mono);
  font-size: 11.5px;
  font-weight: 500;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: var(--sl-ink-muted);
}
/* empty corner cell above the feature column; align with the row headers */
.sl-compare__feature-head { padding-left: 0; }
.sl-compare__col { text-align: center; width: 22%; }
.sl-compare__col--pro {
  background: var(--sl-orange-soft);
  color: var(--sl-green);
  border-radius: 10px 10px 0 0;
}
.sl-compare__table tbody th {
  font-weight: 600;
  font-size: 15.5px;
  color: var(--sl-ink);
  padding-left: 22px;
}
.sl-compare__table tbody td {
  font-family: var(--sl-font-mono);
  font-size: 13.5px;
  font-variant-numeric: tabular-nums;
  color: var(--sl-ink-soft);
  text-align: center;
}
.sl-compare__table tbody td.sl-compare__pro {
  background: rgba(232, 114, 12, 0.045);
  color: var(--sl-ink);
}
.sl-compare__table tbody tr:last-child td.sl-compare__pro {
  border-radius: 0 0 10px 10px;
}
.sl-compare__actions {
  display: flex;
  gap: 14px;
  flex-wrap: wrap;
  margin-top: 30px;
}
.sl-compare__footnote {
  margin: 16px 0 0;
  font-size: 13.5px;
  line-height: 1.55;
  color: var(--sl-ink-muted);
  max-width: 62ch;
}
@media (max-width: 749px) {
  .sl-compare__head { grid-template-columns: 1fr; gap: 18px; }
  .sl-compare .sl-h2 { font-size: clamp(38px, 11.5vw, 52px); }
  .sl-compare__sub { margin-top: 0; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Free vs Pro",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Section anchor id", "default": "compare" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Free gets you started. Pro keeps score." },
    { "type": "textarea", "id": "sub", "label": "Subheading", "default": "Both plans run the same analysis engine. Free is one full report a month; Pro is unlimited filming plus the annotated coach replay and the progress dashboard." },
    { "type": "text", "id": "free_label", "label": "Free column label", "default": "Free" },
    { "type": "text", "id": "pro_label", "label": "Pro column label", "default": "Pro" },
    { "type": "text", "id": "primary_label", "label": "Primary button label", "default": "Get Pro" },
    { "type": "url", "id": "primary_url", "label": "Primary button link" },
    { "type": "text", "id": "secondary_label", "label": "Secondary button label", "default": "Start free" },
    { "type": "url", "id": "secondary_url", "label": "Secondary button link" },
    { "type": "textarea", "id": "footnote", "label": "Footnote", "default": "Already use CaddieInsight? Keep signing in with your current account email. New here? Create your account with the email used at Shopify checkout." }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Feature row",
      "settings": [
        { "type": "text", "id": "feature", "label": "Feature", "default": "Swing analyses" },
        { "type": "text", "id": "free_value", "label": "Free value", "default": "1 per month" },
        { "type": "text", "id": "pro_value", "label": "Pro value", "default": "Unlimited" }
      ]
    }
  ],
  "max_blocks": 10,
  "presets": [
    {
      "name": "Free vs Pro",
      "blocks": [
        { "type": "row", "settings": { "feature": "Swing analyses", "free_value": "1 per month", "pro_value": "Unlimited" } },
        { "type": "row", "settings": { "feature": "Full report — strip, overlay, slow motion", "free_value": "Included", "pro_value": "Included" } },
        { "type": "row", "settings": { "feature": "Coaching notes + practice plan", "free_value": "Included", "pro_value": "Included" } },
        { "type": "row", "settings": { "feature": "Private, per-account session history", "free_value": "Included", "pro_value": "Included" } },
        { "type": "row", "settings": { "feature": "Matched training-aid recommendations", "free_value": "Included", "pro_value": "Included" } },
        { "type": "row", "settings": { "feature": "Annotated coach replay video", "free_value": "—", "pro_value": "Included" } },
        { "type": "row", "settings": { "feature": "Progress dashboard & trends", "free_value": "—", "pro_value": "Included" } },
        { "type": "row", "settings": { "feature": "Price", "free_value": "$0", "pro_value": "$4.99/mo · $39.99/yr · $79.99 lifetime" } }
      ]
    }
  ]
}
{% endschema %}
