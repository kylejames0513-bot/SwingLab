{%- liquid
  # The dusk-range campaign pair ships with the theme as immutable webp
  # assets; an image picker still lets a reviewed release swap the art.
  assign hero_image_label = 'homepage.hero.image_label' | t
  assign hero_image = section.settings.image
  assign hero_mobile_image = section.settings.mobile_image
  assign hero_image_alt = hero_image_label
-%}

<section id="home-hero" class="sl-hero" aria-labelledby="HeroTitle-{{ section.id }}">
  <figure class="sl-hero__backdrop{% if section.settings.video == blank %} sl-hero__backdrop--motion{% endif %}">
    {%- if section.settings.video != blank -%}
      {%- comment -%}
        A muted autoplaying loop. The photo below remains the fallback for
        installs without a clip — and the LCP either way, since video_tag
        ships its own poster frame.
      {%- endcomment -%}
      {{ section.settings.video | video_tag: autoplay: true, loop: true, muted: true, controls: false, playsinline: true, class: 'sl-hero__video', image_size: '1672x' }}
    {%- elsif hero_image -%}
      <picture>
        {%- if hero_mobile_image -%}
          <source
            media="(max-width: 749px)"
            srcset="{{ hero_mobile_image | image_url: width: 480 }} 480w, {{ hero_mobile_image | image_url: width: 750 }} 750w, {{ hero_mobile_image | image_url: width: 1000 }} 1000w, {{ hero_mobile_image | image_url: width: 1122 }} 1122w"
            sizes="100vw">
        {%- endif -%}
        {{ hero_image | image_url: width: 1672 | image_tag:
          class: 'sl-hero__image',
          widths: '750, 1100, 1400, 1672',
          sizes: '100vw',
          loading: 'eager',
          fetchpriority: 'high',
          alt: hero_image_alt }}
      </picture>
    {%- else -%}
      {%- comment -%}
        Theme webps are served whole via asset_url: the legacy sizing
        filter does not process webp and emits the no-image placeholder.
        Both files ship pre-optimized under ~110 KB.
      {%- endcomment -%}
      <picture>
        <source
          media="(max-width: 749px)"
          srcset="{{ 'caddieinsight-range-hero-mobile.webp' | asset_url }}">
        <img
          class="sl-hero__image"
          src="{{ 'caddieinsight-range-hero-desktop.webp' | asset_url }}"
          width="1672"
          height="941"
          alt="{{ hero_image_alt | escape }}"
          loading="eager"
          fetchpriority="high"
          decoding="async">
      </picture>
    {%- endif -%}
  </figure>

  <div class="sl-hero__inner sl-wrap">
    <div class="sl-hero__copy sl-reveal is-in">
      {%- if section.settings.eyebrow != blank -%}
        <p class="sl-hero__brand"><span aria-hidden="true"></span>{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h1 id="HeroTitle-{{ section.id }}" class="sl-hero__title">{{ section.settings.heading | default: 'Bring one clear move to the range.' }}</h1>
      {%- if section.settings.body != blank -%}
        <p class="sl-hero__body">{{ section.settings.body }}</p>
      {%- endif -%}

      <div class="sl-hero__actions">
        {%- if section.settings.primary_label != blank and section.settings.primary_url != blank -%}
          <a href="{{ section.settings.primary_url }}"
             class="sl-btn sl-hero__primary"
             data-app-primary-cta
             data-app-signed-out-label="{{ section.settings.primary_label | escape }}"
             data-app-signed-out-url="{{ section.settings.primary_url }}">
            <span data-app-cta-label>{{ section.settings.primary_label }}</span>
            <span aria-hidden="true">&rarr;</span>
          </a>
        {%- endif -%}
        {%- if section.settings.secondary_label != blank and section.settings.secondary_url != blank -%}
          <a href="{{ section.settings.secondary_url }}" class="sl-btn sl-hero__secondary">{{ section.settings.secondary_label }}</a>
        {%- endif -%}
      </div>

      {%- if section.settings.chip1 != blank or section.settings.chip2 != blank or section.settings.chip3 != blank -%}
        <ul class="sl-hero__proof" aria-label="{{ 'homepage.hero.proof_label' | t }}">
          {%- if section.settings.chip1 != blank -%}<li>{{ section.settings.chip1 }}</li>{%- endif -%}
          {%- if section.settings.chip2 != blank -%}<li>{{ section.settings.chip2 }}</li>{%- endif -%}
          {%- if section.settings.chip3 != blank -%}<li>{{ section.settings.chip3 }}</li>{%- endif -%}
        </ul>
      {%- endif -%}
      {%- if section.settings.fine_print != blank -%}
        <p class="sl-hero__fine">{{ section.settings.fine_print }}</p>
      {%- endif -%}
    </div>
  </div>

  <div class="sl-hero__signal-band sl-wrap">
    <aside class="sl-hero__signal sl-reveal sl-reveal--d1 is-in" aria-label="{{ 'homepage.hero.signal_label' | t }}">
      <div class="sl-hero__signal-head">
        <span>{{ 'homepage.hero.signal_status' | t }}</span>
        <span class="sl-hero__signal-live"><i aria-hidden="true"></i>{{ 'homepage.hero.signal_ready' | t }}</span>
      </div>
      <div class="sl-hero__trace" role="img" aria-label="{{ 'homepage.hero.trace_label' | t }}">
        <span class="sl-hero__trace-line" aria-hidden="true"></span>
        <span class="sl-hero__trace-dot sl-hero__trace-dot--one" aria-hidden="true"></span>
        <span class="sl-hero__trace-dot sl-hero__trace-dot--two" aria-hidden="true"></span>
        <span class="sl-hero__trace-dot sl-hero__trace-dot--three" aria-hidden="true"></span>
      </div>
      <dl class="sl-hero__signal-grid">
        <div><dt>{{ 'homepage.hero.club_label' | t }}</dt><dd>{{ section.settings.signal_club }}</dd></div>
        <div><dt>{{ 'homepage.hero.priority_label' | t }}</dt><dd>{{ section.settings.signal_priority }}</dd></div>
        <div><dt>{{ 'homepage.hero.target_label' | t }}</dt><dd>{{ section.settings.signal_target }}</dd></div>
      </dl>
      <p class="sl-hero__signal-note">{{ 'homepage.hero.signal_disclosure' | t }}</p>
    </aside>
  </div>
</section>

{% stylesheet %}
.sl-hero {
  position: relative;
  isolation: isolate;
  min-height: clamp(700px, 78svh, 860px);
  overflow: hidden;
  background: var(--sl-night);
  color: var(--sl-bg);
}
.sl-hero::before,
.sl-hero::after {
  content: "";
  position: absolute;
  inset: 0;
  pointer-events: none;
}
.sl-hero::before {
  z-index: 1;
  background:
    linear-gradient(105deg, rgba(4, 13, 9, 0.96) 0%, rgba(4, 13, 9, 0.84) 38%, rgba(4, 13, 9, 0.28) 64%, rgba(4, 13, 9, 0.12) 100%),
    linear-gradient(0deg, rgba(4, 13, 9, 0.88) 0%, transparent 42%, rgba(4, 13, 9, 0.14) 100%);
}
.sl-hero::after {
  z-index: 2;
  opacity: 0.2;
  background-image:
    linear-gradient(rgba(255, 255, 255, 0.03) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255, 255, 255, 0.03) 1px, transparent 1px);
  background-size: 64px 64px;
  -webkit-mask-image: linear-gradient(90deg, #000, transparent 74%);
  mask-image: linear-gradient(90deg, #000, transparent 74%);
}
.sl-hero__backdrop,
.sl-hero__backdrop picture {
  position: absolute;
  inset: 0;
  margin: 0;
}
.sl-hero__image {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
}
.sl-hero__video,
.sl-hero__video video,
video.sl-hero__video {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
}
/* With no video set, the photograph carries the motion: a slow drift,
   far side of the reduced-motion gate. Alternate keeps the loop seamless. */
@media (prefers-reduced-motion: no-preference) {
  .sl-hero__backdrop--motion .sl-hero__image {
    animation: sl-hero-drift 28s ease-in-out infinite alternate;
    will-change: transform;
  }
}
@keyframes sl-hero-drift {
  from { transform: scale(1) translateX(0); }
  to { transform: scale(1.08) translateX(-1.5%); }
}
.sl-hero__inner {
  position: relative;
  z-index: 4;
  min-height: clamp(700px, 78svh, 860px);
  padding-top: clamp(96px, 11vw, 140px);
  padding-bottom: clamp(72px, 9vw, 120px);
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  gap: 0;
  align-items: end;
}
.sl-hero__copy {
  width: 100%;
  max-width: 720px;
}
.sl-hero__signal-band {
  position: relative;
  z-index: 4;
  margin-top: 0;
  padding-top: clamp(8px, 1.5vw, 20px);
  padding-bottom: clamp(36px, 5vw, 64px);
  display: flex;
  justify-content: flex-end;
}
.sl-hero__brand {
  margin: 0 0 16px;
  display: inline-flex;
  align-items: center;
  gap: 12px;
  color: var(--sl-bg-card);
  font-family: var(--sl-font-display);
  font-size: var(--sl-text-3xl);
  font-weight: 700;
  letter-spacing: -0.04em;
  line-height: 1;
}
.sl-hero__brand span {
  width: 10px;
  height: 10px;
  border-radius: 50%;
  background: var(--sl-accent);
  box-shadow: 0 0 0 7px rgba(var(--sl-accent-rgb), 0.14);
  animation: sl-hero-pulse 2.4s ease-in-out infinite;
}
@keyframes sl-hero-pulse {
  0%, 100% { box-shadow: 0 0 0 6px rgba(var(--sl-accent-rgb), 0.1); }
  50% { box-shadow: 0 0 0 10px rgba(var(--sl-accent-rgb), 0.04); }
}
.sl-hero__title {
  max-width: 15ch;
  margin: 0;
  color: var(--sl-bg-card);
  font-family: var(--sl-font-display);
  font-size: var(--sl-text-4xl);
  font-weight: 700;
  letter-spacing: -0.042em;
  line-height: 1.02;
  text-align: left;
  text-wrap: balance;
}
.sl-hero__body {
  max-width: 40ch;
  margin: 18px 0 0;
  color: rgba(238, 242, 239, 0.78);
  font-size: var(--sl-text-lg);
  font-weight: 400;
  line-height: 1.55;
  letter-spacing: -0.01em;
  text-align: left;
  text-wrap: pretty;
}
.sl-hero__actions {
  margin: 28px 0 0;
  width: min(100%, 480px);
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12px;
}
.sl-hero__primary,
.sl-hero__secondary {
  min-height: 52px;
  padding: 14px 22px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--sl-radius-control);
}
.sl-hero__primary {
  border-color: var(--sl-accent);
  background: var(--sl-accent);
  color: var(--sl-night);
  box-shadow: 0 18px 38px -20px rgba(var(--sl-accent-rgb), 0.9);
}
.sl-hero__primary:hover {
  border-color: var(--sl-accent-hover);
  background: var(--sl-accent-hover);
  color: var(--sl-night);
}
.sl-hero__primary span:last-child { margin-left: 10px; transition: transform 0.2s ease; }
.sl-hero__primary:hover span:last-child { transform: translateX(4px); }
.sl-hero__secondary {
  border-color: rgba(238, 242, 239, 0.42);
  background: rgba(6, 17, 12, 0.36);
  color: var(--sl-bg);
  -webkit-backdrop-filter: blur(14px);
  backdrop-filter: blur(14px);
}
.sl-hero__secondary:hover {
  border-color: rgba(238, 242, 239, 0.8);
  background: rgba(238, 242, 239, 0.1);
  color: #ffffff;
}
.sl-hero__primary:focus-visible,
.sl-hero__secondary:focus-visible {
  outline: 3px solid var(--sl-focus-dark);
  outline-offset: 4px;
}
.sl-hero__proof {
  width: fit-content;
  max-width: 100%;
  margin: 22px 0 0;
  padding: 0;
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-start;
  gap: 8px 18px;
  list-style: none;
  border: 0;
  background: transparent;
}
.sl-hero__proof li {
  position: relative;
  padding-left: 14px;
  color: rgba(238, 242, 239, 0.62);
  font-family: var(--sl-font-mono);
  font-size: var(--sl-text-xs);
  font-weight: 500;
  letter-spacing: 0.12em;
  text-transform: uppercase;
}
.sl-hero__proof li::before {
  content: "";
  position: absolute;
  top: 0.42em;
  left: 0;
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: #75d59b;
}
.sl-hero__fine {
  margin: 14px 0 0;
  color: rgba(238, 242, 239, 0.58);
  font-size: var(--sl-text-xs);
  text-align: left;
}
.sl-hero__signal {
  width: min(100%, 320px);
  margin: 0;
  padding: 18px 18px 16px;
  text-align: left;
  border: 1px solid rgba(238, 242, 239, 0.16);
  border-radius: var(--sl-radius);
  background: rgba(5, 16, 10, 0.55);
  -webkit-backdrop-filter: blur(18px);
  backdrop-filter: blur(18px);
  box-shadow: 0 28px 64px -36px rgba(0, 0, 0, 0.85);
}
.sl-hero__signal-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 10px;
  color: rgba(238, 242, 239, 0.58);
  font-family: var(--sl-font-mono);
  font-size: var(--sl-text-xs);
  font-weight: 500;
  letter-spacing: 0.14em;
  text-transform: uppercase;
}
.sl-hero__signal-live { display: inline-flex; align-items: center; gap: 7px; color: #8be4ad; }
.sl-hero__signal-live i {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: currentColor;
  box-shadow: 0 0 0 5px rgba(139, 228, 173, 0.12);
}
.sl-hero__trace {
  position: relative;
  height: 88px;
  margin-top: 14px;
  overflow: hidden;
  border: 1px solid rgba(238, 242, 239, 0.1);
  border-radius: var(--sl-radius-sm);
  background:
    linear-gradient(rgba(255, 255, 255, 0.03) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255, 255, 255, 0.03) 1px, transparent 1px),
    rgba(255, 255, 255, 0.02);
  background-size: 24px 24px;
}
.sl-hero__trace-line {
  position: absolute;
  left: 14%;
  top: 24%;
  width: 74%;
  height: 90%;
  border-top: 2px solid #f28a32;
  border-radius: 50%;
  transform: rotate(-8deg);
  filter: drop-shadow(0 0 8px rgba(242, 138, 50, 0.45));
}
.sl-hero__trace-dot {
  position: absolute;
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: var(--sl-bg);
  box-shadow: 0 0 0 4px rgba(238, 242, 239, 0.12);
}
.sl-hero__trace-dot--one { left: 22%; top: 57%; }
.sl-hero__trace-dot--two { left: 52%; top: 30%; background: #f28a32; }
.sl-hero__trace-dot--three { right: 14%; top: 50%; }
.sl-hero__signal-grid {
  margin: 14px 0 0;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 0;
}
.sl-hero__signal-grid > div { min-width: 0; padding: 0 10px; }
.sl-hero__signal-grid > div:first-child { padding-left: 0; }
.sl-hero__signal-grid > div:last-child { padding-right: 0; }
.sl-hero__signal-grid > div + div { border-left: 1px solid rgba(238, 242, 239, 0.12); }
.sl-hero__signal-grid dt {
  color: rgba(238, 242, 239, 0.58);
  font-family: var(--sl-font-mono);
  font-size: var(--sl-text-xs);
  font-weight: 500;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  text-align: left;
}
.sl-hero__signal-grid dd {
  margin: 5px 0 0;
  color: var(--sl-bg);
  font-size: var(--sl-text-xs);
  font-weight: 700;
  line-height: 1.3;
  text-align: left;
}
.sl-hero__signal-note {
  margin: 12px 0 0;
  color: rgba(238, 242, 239, 0.58);
  font-size: var(--sl-text-xs);
  line-height: 1.4;
  text-align: left;
}
@media (max-width: 999px) {
  .sl-hero__title { font-size: var(--sl-text-4xl); }
}
@media (max-width: 749px) {
  .sl-hero {
    /* Roomy but not sprawling: the copy breathes and the compact signal
       card still lands within the first easy scroll. */
    --sl-mobile-hero-height: clamp(560px, calc(96svh - 180px), 660px);
    min-height: var(--sl-mobile-hero-height);
  }
  /* Bottom-anchored copy means the shade belongs at the BOTTOM. A modest
     band under the header keeps nav contrast, the middle opens up so the
     photograph actually shows, and the deep ramp starts where the type
     starts. The old gradient was 95% opaque at the top — a black field. */
  .sl-hero::before {
    background:
      linear-gradient(180deg, rgba(4, 13, 9, 0.6) 0%, rgba(4, 13, 9, 0.2) 26%, rgba(4, 13, 9, 0.34) 52%, rgba(4, 13, 9, 0.9) 100%),
      linear-gradient(90deg, rgba(4, 13, 9, 0.28), rgba(4, 13, 9, 0.04));
  }
  .sl-hero::after {
    background-size: 48px 48px;
    -webkit-mask-image: linear-gradient(180deg, #000, transparent 68%);
    mask-image: linear-gradient(180deg, #000, transparent 68%);
  }
  .sl-hero__image { object-position: 32% center; }
  .sl-hero__inner {
    min-height: var(--sl-mobile-hero-height);
    padding-top: clamp(52px, 8vw, 68px);
    padding-bottom: clamp(40px, 7vw, 56px);
    grid-template-columns: 1fr;
    align-content: end;
    justify-items: stretch;
    gap: 0;
  }
  /* The signal card stays on phones (the only visual showing what the
     product produces) — as a compact fact strip; rules further down. */
  .sl-hero__copy {
    margin-inline: 0;
    text-align: left;
  }
  .sl-hero__brand {
    font-size: var(--sl-text-2xl);
  }
  .sl-hero__title {
    max-width: 11ch;
    margin-inline: 0;
    font-size: var(--sl-text-4xl);
    line-height: 1.02;
  }
  .sl-hero__body {
    max-width: 36ch;
    margin-inline: 0;
    margin-top: 16px;
    font-size: var(--sl-text-base);
    line-height: 1.48;
    text-align: left;
  }
  .sl-hero__actions {
    width: min(100%, 320px);
    grid-template-columns: 1fr;
    gap: 10px;
    margin: 24px 0 0;
  }
  .sl-hero__primary { width: 100%; min-height: 48px; padding: 12px 18px; }
  .sl-hero__secondary {
    width: 100%;
    min-height: 44px;
    padding: 10px 16px;
    justify-self: stretch;
    justify-content: center;
    border: 1px solid rgba(238, 242, 239, 0.34);
    background: rgba(6, 17, 12, 0.42);
    text-decoration: none;
  }
  .sl-hero__secondary:hover { border-color: rgba(238, 242, 239, 0.72); background: rgba(238, 242, 239, 0.1); }
  /* One quiet mono line: the 2-column grid orphaned the third chip and
     its green dots fought the orange brand dot. Middots, one color. */
  .sl-hero__proof {
    width: 100%;
    margin: 18px 0 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-start;
    gap: 4px 0;
  }
  .sl-hero__proof li {
    padding-left: 0;
    color: rgba(var(--sl-cream-rgb), 0.55);
    font-size: var(--sl-text-xs);
    letter-spacing: 0.09em;
  }
  .sl-hero__proof li::before { display: none; }
  .sl-hero__proof li + li::before {
    content: "\00B7";
    display: inline;
    position: static;
    margin: 0 var(--sl-space-2);
    background: none;
    width: auto;
    height: auto;
  }
  .sl-hero__fine {
    max-width: 40ch;
    margin: 6px 0 0;
    color: rgba(var(--sl-cream-rgb), 0.45);
    text-align: left;
  }
  .sl-hero__signal {
    width: 100%;
    padding: var(--sl-space-4) var(--sl-space-4) var(--sl-space-3);
  }
  /* Compact fact strip: the arc chart stretched edge to edge and the three
     columns double-wrapped their labels. On phones the card is the facts —
     label left, value right, one hairline per row. */
  .sl-hero__trace { display: none; }
  .sl-hero__signal-grid {
    margin-top: var(--sl-space-2);
    display: block;
  }
  .sl-hero__signal-grid > div {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--sl-space-3);
    padding: var(--sl-space-2) 0;
  }
  .sl-hero__signal-grid > div + div {
    border-left: 0;
    border-top: 1px solid rgba(238, 242, 239, 0.12);
  }
  .sl-hero__signal-grid dt { letter-spacing: 0.08em; }
  .sl-hero__signal-grid dd { margin: 0; text-align: right; }
  .sl-hero__signal-note { margin-top: var(--sl-space-2); }
  .sl-hero__signal-band {
    padding-top: var(--sl-space-3);
    padding-bottom: var(--sl-space-6);
  }
}
@media (max-width: 559px) {
  .sl-hero__brand { font-size: var(--sl-text-xl); letter-spacing: -0.03em; }
  .sl-hero__title { max-width: 10ch; font-size: var(--sl-text-4xl); }
}
@media (prefers-reduced-motion: reduce) {
  .sl-hero__primary span { transition: none; }
  .sl-hero__brand span { animation: none; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Premium hero",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Brand wordmark", "default": "CaddieInsight" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Bring one clear move to the range." },
    { "type": "textarea", "id": "body", "label": "Body", "default": "Choose the club, film one repeatable view, and get one prioritized coaching plan with a pass mark for your next clip." },
    { "type": "text", "id": "primary_label", "label": "Primary button label", "default": "Analyze a swing free" },
    { "type": "url", "id": "primary_url", "label": "Primary button link" },
    { "type": "text", "id": "secondary_label", "label": "Secondary button label", "default": "Explore the sample report" },
    { "type": "url", "id": "secondary_url", "label": "Secondary button link" },
    { "type": "text", "id": "chip1", "label": "Proof point 1", "default": "1 REPORT / MONTH" },
    { "type": "text", "id": "chip2", "label": "Proof point 2", "default": "NO CARD" },
    { "type": "text", "id": "chip3", "label": "Proof point 3", "default": "CLUB SAVED" },
    { "type": "text", "id": "fine_print", "label": "Fine print", "default": "Supported 2D movement and timing estimates from phone video." },
    { "type": "video", "id": "video", "label": "Hero video (loops, muted)", "info": "A short 8–20s loop — filmed range or swing footage works best. No audio needed; it plays muted. Leave blank and the hero uses the photograph with a slow drift instead." },
