{%- liquid
  # The dusk-range campaign pair still ships with the theme, but it is no
  # longer the subject — it is atmosphere behind the readout. An image picker
  # still lets a reviewed release swap the art.
  #
  # hero_image_label / hero_image_alt are gone with it. The backdrop is
  # decorative now (empty alt, aria-hidden), so the description had no
  # consumer left — and theme-check's UnusedAssign is a WARNING, which
  # scripts/package_theme.py runs at --fail-level warning. One orphaned
  # assign therefore fails the whole theme-zip build, and with it all eight
  # test_theme_package tests at fixture time.
  assign hero_image = section.settings.image
  assign hero_mobile_image = section.settings.mobile_image
-%}

<section id="home-hero" class="sl-hero" aria-labelledby="HeroTitle-{{ section.id }}">
  {%- comment -%}
    The photograph is decoration now: it carries no information the copy does
    not, so it is aria-hidden and the alt text goes with it. The old markup
    gave a decorative backdrop a descriptive alt, which made a screen reader
    announce a stock photo before the headline.
  {%- endcomment -%}
  <figure class="sl-hero__backdrop{% if section.settings.video == blank %} sl-hero__backdrop--motion{% endif %}" aria-hidden="true">
    {%- if section.settings.video != blank -%}
      {{ section.settings.video | video_tag: autoplay: true, loop: true, muted: true, controls: false, playsinline: true, class: 'sl-hero__video', image_size: '1672x' }}
    {%- elsif hero_image -%}
      <picture>
        {%- if hero_mobile_image -%}
          <source
            media="(max-width: 749px)"
            srcset="{{ hero_mobile_image | image_url: width: 480 }} 480w, {{ hero_mobile_image | image_url: width: 750 }} 750w, {{ hero_mobile_image | image_url: width: 1000 }} 1000w, {{ hero_mobile_image | image_url: width: 1122 }} 1122w"
            sizes="100vw">
        {%- endif -%}
        {{ hero_image | image_url: width: 1672 | image_tag:
          class: 'sl-hero__image',
          widths: '750, 1100, 1400, 1672',
          sizes: '100vw',
          loading: 'eager',
          fetchpriority: 'high',
          alt: '' }}
      </picture>
    {%- else -%}
      {%- comment -%}
        Theme webps are served whole via asset_url: the legacy sizing filter
        does not process webp and emits the no-image placeholder.
      {%- endcomment -%}
      <picture>
        <source
          media="(max-width: 749px)"
          srcset="{{ 'caddieinsight-range-hero-mobile.webp' | asset_url }}">
        <img
          class="sl-hero__image"
          src="{{ 'caddieinsight-range-hero-desktop.webp' | asset_url }}"
          width="1672"
          height="941"
          alt=""
          loading="eager"
          fetchpriority="high"
          decoding="async">
      </picture>
    {%- endif -%}
  </figure>

  <div class="sl-hero__inner sl-wrap">
    <div class="sl-hero__copy">
      {%- if section.settings.eyebrow != blank -%}
        <p class="sl-hero__brand"><span class="sl-hero__brand-dot" aria-hidden="true"></span>{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h1 id="HeroTitle-{{ section.id }}" class="sl-hero__title">{{ section.settings.heading | default: 'Prove the fix held.' }}</h1>
      {%- if section.settings.body != blank -%}
        <p class="sl-hero__body">{{ section.settings.body }}</p>
      {%- endif -%}

      <div class="sl-hero__actions">
        {%- if section.settings.primary_label != blank and section.settings.primary_url != blank -%}
          <a href="{{ section.settings.primary_url }}"
             class="sl-btn sl-hero__primary"
             data-app-primary-cta
             data-app-signed-out-label="{{ section.settings.primary_label | escape }}"
             data-app-signed-out-url="{{ section.settings.primary_url }}">
            <span data-app-cta-label>{{ section.settings.primary_label }}</span>
            <span aria-hidden="true">&rarr;</span>
          </a>
        {%- endif -%}
        {%- if section.settings.secondary_label != blank and section.settings.secondary_url != blank -%}
          <a href="{{ section.settings.secondary_url }}" class="sl-btn sl-hero__secondary">{{ section.settings.secondary_label }}</a>
        {%- endif -%}
      </div>

      {%- if section.settings.chip1 != blank or section.settings.chip2 != blank or section.settings.chip3 != blank -%}
        <ul class="sl-hero__proof" aria-label="{{ 'homepage.hero.proof_label' | t }}">
          {%- if section.settings.chip1 != blank -%}<li>{{ section.settings.chip1 }}</li>{%- endif -%}
          {%- if section.settings.chip2 != blank -%}<li>{{ section.settings.chip2 }}</li>{%- endif -%}
          {%- if section.settings.chip3 != blank -%}<li>{{ section.settings.chip3 }}</li>{%- endif -%}
        </ul>
      {%- endif -%}
      {%- if section.settings.fine_print != blank -%}
        <p class="sl-hero__fine">{{ section.settings.fine_print }}</p>
      {%- endif -%}
    </div>

    {%- comment -%}
      The readout. This used to be a 320px card tucked into the corner of a
      photograph; it is the subject now, because it is the only thing on this
      page that shows what the product actually does.
    {%- endcomment -%}
    <aside class="sl-hero__readout" data-swing-readout aria-label="{{ 'homepage.hero.signal_label' | t }}">
      <div class="sl-hero__readout-head">
        <span class="sl-hero__readout-title">{{ 'homepage.hero.signal_status' | t }}</span>
        <span class="sl-hero__readout-live">
          <i aria-hidden="true"></i>
          {%- comment -%}
            The phase label is written by the canvas as it passes each stage.
            It ships with the ready string so a client that never runs the
            animation still reads a complete, truthful line rather than an
            empty one.
          {%- endcomment -%}
          <span data-swing-phase>{{ 'homepage.hero.signal_ready' | t }}</span>
        </span>
      </div>

      <div class="sl-hero__trace" role="img" aria-label="{{ 'homepage.hero.trace_label' | t }}">
        {%- comment -%}
          DEGRADATION IS THE CONTRACT. The SVG below is a complete, fully
          drawn still of the swing arc, visible by default. swing-trace.js
          hides it only after the canvas has successfully initialised, so
          no-JS, canvas-less, reduced-motion and screenshot clients all get a
          finished graphic instead of an empty box. Removing the [hidden]
          handshake means one of those cases silently renders nothing.
        {%- endcomment -%}
        <svg class="sl-hero__trace-still" data-swing-still viewBox="0 0 320 260" preserveAspectRatio="xMidYMid meet" aria-hidden="true" focusable="false">
          <path class="sl-hero__trace-arc"
                d="M 160 226 C 108 214, 74 176, 70 128 C 66 82, 98 44, 142 34 C 186 24, 226 48, 240 92 C 254 138, 236 190, 194 216"
                pathLength="100"/>
          <g class="sl-hero__trace-figure">
            <circle cx="160" cy="52" r="10"/>
            <path d="M 160 62 V 88 M 128 92 H 192 M 128 92 L 118 128 M 192 92 L 202 128 M 118 128 L 160 150 M 202 128 L 160 150 M 138 152 H 182 M 138 152 L 132 200 M 182 152 L 188 200 M 132 200 L 130 244 M 188 200 L 190 244"/>
          </g>
          <g class="sl-hero__trace-tick"><path d="M 155 226 H 165 M 160 221 V 231"/></g>
          <g class="sl-hero__trace-tick"><path d="M 137 34 H 147 M 142 29 V 39"/></g>
        </svg>
        <canvas class="sl-hero__trace-canvas" data-swing-trace></canvas>
      </div>

      <dl class="sl-hero__readout-grid">
        <div><dt>{{ 'homepage.hero.club_label' | t }}</dt><dd>{{ section.settings.signal_club }}</dd></div>
        <div><dt>{{ 'homepage.hero.priority_label' | t }}</dt><dd>{{ section.settings.signal_priority }}</dd></div>
        <div><dt>{{ 'homepage.hero.target_label' | t }}</dt><dd>{{ section.settings.signal_target }}</dd></div>
      </dl>
      <p class="sl-hero__readout-note">{{ 'homepage.hero.signal_disclosure' | t }}</p>
    </aside>
  </div>
</section>

{% stylesheet %}
.sl-hero {
  position: relative;
  isolation: isolate;
  overflow: hidden;
  background: var(--sl-bg);
  color: var(--sl-ink);
  border-bottom: 1px solid var(--sl-border);
}
/* The photograph is atmosphere: desaturated hard, dropped to a whisper, and
   masked away from the readout side so the trace never fights a tree line. */
.sl-hero::before,
.sl-hero::after {
  content: "";
  position: absolute;
  inset: 0;
  pointer-events: none;
}
/* Tuned against a render, not by eye: the first pass buried the photograph
   so completely that the page was paying 98 KB for a layer that could not be
   seen at all. It is a ghost now — present enough to place the product on a
   range at dusk, quiet enough that the trace never competes with a tree
   line. If it stops being visible, delete the image rather than ship it. */
.sl-hero::before {
  z-index: 1;
  background:
    linear-gradient(180deg, rgba(7, 15, 11, 0.72) 0%, rgba(7, 15, 11, 0.5) 46%, rgba(7, 15, 11, 0.94) 100%),
    linear-gradient(90deg, rgba(7, 15, 11, 0.9) 0%, rgba(7, 15, 11, 0.34) 54%, rgba(7, 15, 11, 0.82) 100%);
}
/* the 8px instrument grid, brightest at the readout edge */
.sl-hero::after {
  z-index: 2;
  opacity: 0.5;
  background-image:
    linear-gradient(rgba(var(--sl-cream-rgb), 0.03) 1px, transparent 1px),
    linear-gradient(90deg, rgba(var(--sl-cream-rgb), 0.03) 1px, transparent 1px);
  background-size: 8px 8px;
  -webkit-mask-image: linear-gradient(90deg, transparent, #000 62%);
  mask-image: linear-gradient(90deg, transparent, #000 62%);
}
.sl-hero__backdrop,
.sl-hero__backdrop picture {
  position: absolute;
  inset: 0;
  margin: 0;
}
.sl-hero__image,
.sl-hero__video,
.sl-hero__video video,
video.sl-hero__video {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
  filter: grayscale(0.72) contrast(1.08) brightness(0.66);
}
.sl-hero__video,
.sl-hero__video video,
video.sl-hero__video { position: absolute; inset: 0; }
@media (prefers-reduced-motion: no-preference) {
  .sl-hero__backdrop--motion .sl-hero__image {
    animation: sl-hero-drift 34s ease-in-out infinite alternate;
    will-change: transform;
  }
}
@keyframes sl-hero-drift {
  from { transform: scale(1) translateX(0); }
  to { transform: scale(1.07) translateX(-1.4%); }
}

.sl-hero__inner {
  position: relative;
  z-index: 4;
  padding-top: clamp(72px, 9vw, 116px);
  padding-bottom: clamp(56px, 7vw, 92px);
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  gap: clamp(36px, 5vw, 56px);
  align-items: center;
}
/* Asymmetric on purpose: the copy takes five columns and the readout seven,
   so the instrument is the larger object on the page. */
@media (min-width: 1000px) {
  .sl-hero__inner {
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(40px, 4vw, 72px);
    min-height: clamp(620px, 74svh, 800px);
  }
}

.sl-hero__copy { width: 100%; max-width: 620px; }
.sl-hero__brand {
  margin: 0 0 clamp(18px, 2vw, 26px);
  display: inline-flex;
  align-items: center;
  gap: 10px;
  color: var(--sl-ink-soft);
  font-family: var(--sl-font-mono);
  font-size: var(--sl-eyebrow-size);
  font-weight: 500;
  letter-spacing: var(--sl-eyebrow-track);
  line-height: 1;
  text-transform: uppercase;
}
.sl-hero__brand-dot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: var(--sl-trace);
  box-shadow: 0 0 0 4px rgba(var(--sl-trace-rgb), 0.14);
}
@media (prefers-reduced-motion: no-preference) {
  .sl-hero__brand-dot { animation: sl-hero-pulse 2.6s ease-in-out infinite; }
}
@keyframes sl-hero-pulse {
  0%, 100% { box-shadow: 0 0 0 3px rgba(var(--sl-trace-rgb), 0.16); }
  50% { box-shadow: 0 0 0 8px rgba(var(--sl-trace-rgb), 0.04); }
}
.sl-hero__title {
  max-width: 13ch;
  margin: 0;
  color: var(--sl-ink);
  font-family: var(--sl-font-display);
  font-size: var(--sl-heading-display);
  font-weight: 800;
  letter-spacing: -0.02em;
  line-height: 0.98;
  text-align: left;
  text-transform: uppercase;
  text-wrap: balance;
}
.sl-hero__body {
  max-width: 42ch;
  margin: clamp(18px, 2vw, 24px) 0 0;
  color: var(--sl-ink-soft);
  font-size: var(--sl-text-lg);
  line-height: 1.55;
  text-align: left;
  text-wrap: pretty;
}
.sl-hero__actions {
  margin: clamp(26px, 3vw, 34px) 0 0;
  display: flex;
  flex-wrap: wrap;
  gap: var(--sl-space-3);
}
.sl-hero__primary,
.sl-hero__secondary {
  min-height: 52px;
  padding: 14px 24px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  border: 1px solid transparent;
  border-radius: var(--sl-radius-control);
  font-weight: 600;
  text-decoration: none;
}
/* Bone, not amber. Amber marks a measured value; a button is not one. */
.sl-hero__primary {
  border-color: var(--sl-ink);
  background: var(--sl-ink);
  color: var(--sl-bg);
}
.sl-hero__primary:hover {
  border-color: var(--sl-trace);
  background: var(--sl-trace);
  color: var(--sl-bg);
}
.sl-hero__primary span:last-child { transition: transform 0.2s ease; }
.sl-hero__primary:hover span:last-child { transform: translateX(4px); }
.sl-hero__secondary {
  border-color: var(--sl-control-border);
  background: transparent;
  color: var(--sl-ink);
}
.sl-hero__secondary:hover {
  border-color: var(--sl-ink);
  background: rgba(var(--sl-cream-rgb), 0.06);
  color: var(--sl-ink);
}
.sl-hero__proof {
  margin: clamp(22px, 2.5vw, 28px) 0 0;
  padding: 0;
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-start;
  gap: 8px 20px;
  list-style: none;
}
.sl-hero__proof li {
  position: relative;
  padding-left: 14px;
  color: var(--sl-ink-muted);
  font-family: var(--sl-font-mono);
  font-size: var(--sl-text-xs);
  font-weight: 500;
  letter-spacing: 0.12em;
  text-transform: uppercase;
}
.sl-hero__proof li::before {
  content: "";
  position: absolute;
  top: 0.44em;
  left: 0;
  width: 5px;
  height: 5px;
  background: var(--sl-trace);
}
.sl-hero__fine {
  margin: 14px 0 0;
  max-width: 46ch;
  color: var(--sl-ink-muted);
  font-size: var(--sl-text-xs);
}

/* ---- the readout ---- */
.sl-hero__readout {
  width: 100%;
  padding: clamp(16px, 1.6vw, 22px);
  border: 1px solid var(--sl-border-strong);
  border-radius: var(--sl-radius-lg);
  background: rgba(4, 9, 7, 0.72);
  -webkit-backdrop-filter: blur(14px);
  backdrop-filter: blur(14px);
  box-shadow: var(--sl-shadow-deep);
}
.sl-hero__readout-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--sl-space-3);
  padding-bottom: var(--sl-space-3);
  border-bottom: 1px solid var(--sl-border);
  color: var(--sl-ink-muted);
  font-family: var(--sl-font-mono);
  font-size: var(--sl-text-xs);
  font-weight: 500;
  letter-spacing: 0.14em;
  text-transform: uppercase;
}
.sl-hero__readout-live { display: inline-flex; align-items: center; gap: 8px; color: var(--sl-trace); }
.sl-hero__readout-live i {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: currentColor;
  box-shadow: 0 0 0 4px rgba(var(--sl-trace-rgb), 0.12);
}
.sl-hero__trace {
  position: relative;
  margin-top: var(--sl-space-3);
  aspect-ratio: 5 / 4;
  overflow: hidden;
  border: 1px solid var(--sl-border);
  border-radius: var(--sl-radius-sm);
  background:
    linear-gradient(rgba(var(--sl-cream-rgb), 0.028) 1px, transparent 1px),
    linear-gradient(90deg, rgba(var(--sl-cream-rgb), 0.028) 1px, transparent 1px),
    var(--sl-night);
  background-size: 16px 16px;
}
@media (min-width: 1000px) { .sl-hero__trace { aspect-ratio: 16 / 11; } }
.sl-hero__trace-canvas,
.sl-hero__trace-still {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}
/* The still is the default state and the canvas paints over it. Both are
   present until JS confirms the canvas took, so there is never a frame in
   which this box is empty. */
.sl-hero__trace-still[hidden] { display: none; }
.sl-hero__trace-arc {
  fill: none;
  stroke: var(--sl-trace);
  stroke-width: 2;
  stroke-linecap: round;
  opacity: 0.85;
}
.sl-hero__trace-figure { fill: none; stroke: rgba(var(--sl-cream-rgb), 0.5); stroke-width: 1.6; stroke-linecap: round; }
.sl-hero__trace-tick { fill: none; stroke: var(--sl-accent); stroke-width: 1; }
.sl-hero__readout-grid {
  margin: var(--sl-space-4) 0 0;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 1px;
  background: var(--sl-border);
  border: 1px solid var(--sl-border);
}
.sl-hero__readout-grid > div { padding: var(--sl-space-3); background: var(--sl-bg-card); }
.sl-hero__readout-grid dt {
  margin: 0 0 6px;
  color: var(--sl-ink-muted);
  font-family: var(--sl-font-mono);
  font-size: var(--sl-text-xs);
  font-weight: 500;
  letter-spacing: 0.12em;
  text-transform: uppercase;
}
/* The values ARE measurements, so they are the amber. */
.sl-hero__readout-grid dd {
  margin: 0;
  color: var(--sl-accent);
  font-family: var(--sl-font-mono);
  font-size: var(--sl-text-sm);
  font-weight: 500;
  line-height: 1.3;
}
.sl-hero__readout-note {
  margin: var(--sl-space-3) 0 0;
  color: var(--sl-ink-muted);
  font-size: var(--sl-text-xs);
  line-height: 1.5;
}

@media (max-width: 749px) {
  /* One custom property drives every height on the phone hero, so the fold
     is tuned in one place instead of three. svh (not vh) is the whole point:
     vh is the LARGEST viewport on iOS, so a vh-sized hero is taller than the
     screen until the address bar retracts, and the CTA starts below the fold. */
  .sl-hero { --sl-mobile-hero-height: 88svh; }
  .sl-hero__inner {
    min-height: var(--sl-mobile-hero-height);
    align-content: end;
    justify-items: stretch;
    padding-top: clamp(56px, 18vw, 96px);
  }
  /* The portrait companion is framed on its subject rather than left to the
     default centre crop, which on a narrow screen cut the golfer in half.
     Not 58% — that was tuned for the old composition, where the copy sat on
     the left and the frame had to be pushed right to clear it. The copy is
     full-width here and the photograph is a ghost, so it centres. */
  .sl-hero__image { object-position: center 42%; }
  .sl-hero__copy { max-width: 100%; text-align: left; }
  .sl-hero__title { max-width: 100%; text-align: left; }
  .sl-hero__body { text-align: left; }
  .sl-hero__actions { margin: 24px 0 0; display: grid; grid-template-columns: minmax(0, 1fr); }
  /* The proof chips are one quiet mono line on phones. The dot markers fought
     the brand dot above them and a grid orphaned the third chip, so the
     separator is a middot between items and the markers are gone. */
  .sl-hero__proof { margin: 18px 0 0; display: flex; gap: 0 10px; }
  .sl-hero__proof li { padding-left: 0; }
  .sl-hero__proof li::before { display: none; }
  .sl-hero__proof li + li::after {
    content: "\00B7";
    position: absolute;
    left: -8px;
    color: var(--sl-ink-muted);
  }
  .sl-hero__trace { height: 64px; margin-top: 12px; }
  .sl-hero__readout-grid { grid-template-columns: minmax(0, 1fr); }
}
@media (max-width: 559px) {
  /* The narrowest supported phone. The display face is EXPANDED, so it eats
     line width far faster than the old condensed-neutral did — the headline
     needs its own rung here rather than riding the fluid clamp down. */
  .sl-hero__title { font-size: var(--sl-text-3xl); }
  .sl-hero__inner { min-height: var(--sl-mobile-hero-height); }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Premium hero",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "CaddieInsight" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Prove the fix held." },
    { "type": "textarea", "id": "body", "label": "Body", "default": "Film one repeatable view. Get one prioritized coaching plan with a drill and a pass mark for your next clip." },
    { "type": "text", "id": "primary_label", "label": "Primary button label", "default": "Analyze a swing free" },
    { "type": "url", "id": "primary_url", "label": "Primary button link" },
    { "type": "text", "id": "secondary_label", "label": "Secondary button label", "default": "Explore the sample report" },
    { "type": "url", "id": "secondary_url", "label": "Secondary button link" },
    { "type": "text", "id": "chip1", "label": "Proof chip 1", "default": "1 REPORT / MONTH" },
    { "type": "text", "id": "chip2", "label": "Proof chip 2", "default": "NO CARD" },
    { "type": "text", "id": "chip3", "label": "Proof chip 3", "default": "CLUB SAVED" },
    { "type": "text", "id": "fine_print", "label": "Fine print", "default": "Supported 2D movement and timing estimates from phone video." },
    { "type": "video", "id": "video", "label": "Background video" },
    { "type": "image_picker", "id": "image", "label": "Background image" },
    { "type": "image_picker", "id": "mobile_image", "label": "Mobile background image" },
    { "type": "text", "id": "signal_club", "label": "Readout: club", "default": "Iron" },
    { "type": "text", "id": "signal_priority", "label": "Readout: coaching priority", "default": "Lead-hip control" },
    { "type": "text", "id": "signal_target", "label": "Readout: practice target", "default": "One pass mark" }
  ],
  "presets": [{ "name": "Premium hero" }]
}
{% endschema %}
