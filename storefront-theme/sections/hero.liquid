{%- liquid
  # The dusk-range campaign pair ships with the theme as immutable webp
  # assets; an image picker still lets a reviewed release swap the art.
  assign hero_image_label = 'homepage.hero.image_label' | t
  assign hero_image = section.settings.image
  assign hero_mobile_image = section.settings.mobile_image
  assign hero_image_alt = hero_image_label
-%}

<section id="home-hero" class="sl-hero" aria-labelledby="HeroTitle-{{ section.id }}">
  <figure class="sl-hero__backdrop{% if section.settings.video == blank %} sl-hero__backdrop--motion{% endif %}">
    {%- if section.settings.video != blank -%}
      {%- comment -%}
        A muted autoplaying loop. The photo below remains the fallback for
        installs without a clip — and the LCP either way, since video_tag
        ships its own poster frame.
      {%- endcomment -%}
      {{ section.settings.video | video_tag: autoplay: true, loop: true, muted: true, controls: false, playsinline: true, class: 'sl-hero__video', image_size: '1672x' }}
    {%- elsif hero_image -%}
      <picture>
        {%- if hero_mobile_image -%}
          <source
            media="(max-width: 749px)"
            srcset="{{ hero_mobile_image | image_url: width: 480 }} 480w, {{ hero_mobile_image | image_url: width: 750 }} 750w, {{ hero_mobile_image | image_url: width: 1000 }} 1000w, {{ hero_mobile_image | image_url: width: 1122 }} 1122w"
            sizes="100vw">
        {%- endif -%}
        {{ hero_image | image_url: width: 1672 | image_tag:
          class: 'sl-hero__image',
          widths: '750, 1100, 1400, 1672',
          sizes: '100vw',
          loading: 'eager',
          fetchpriority: 'high',
          alt: hero_image_alt }}
      </picture>
    {%- else -%}
      {%- comment -%}
        Theme webps are served whole via asset_url: the legacy sizing
        filter does not process webp and emits the no-image placeholder.
        Both files ship pre-optimized under ~110 KB.
      {%- endcomment -%}
      <picture>
        <source
          media="(max-width: 749px)"
          srcset="{{ 'caddieinsight-range-hero-mobile.webp' | asset_url }}">
        <img
          class="sl-hero__image"
          src="{{ 'caddieinsight-range-hero-desktop.webp' | asset_url }}"
          width="1672"
          height="941"
          alt="{{ hero_image_alt | escape }}"
          loading="eager"
          fetchpriority="high"
          decoding="async">
      </picture>
    {%- endif -%}
  </figure>

  {%- comment -%}
    Shot tracers. The broadcast-golf visual, generated live: glowing ball
    flights arc from the golfer's corner of the photograph into the dusk
    sky every few seconds. Pure canvas, zero media bytes, and the script
    refuses to run under prefers-reduced-motion or Save-Data, parks
    itself offscreen via IntersectionObserver, and stops in hidden tabs
    (rAF). The hero remains complete without it — this layer is
    atmosphere, never content.
  {%- endcomment -%}
  <canvas class="sl-hero__tracers" aria-hidden="true"></canvas>

  <div class="sl-hero__inner sl-wrap">
    <div class="sl-hero__copy sl-reveal is-in">
      {%- if section.settings.eyebrow != blank -%}
        <p class="sl-hero__brand"><span aria-hidden="true"></span>{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h1 id="HeroTitle-{{ section.id }}" class="sl-hero__title">{{ section.settings.heading | default: 'Bring one clear move to the range.' }}</h1>
      {%- if section.settings.body != blank -%}
        <p class="sl-hero__body">{{ section.settings.body }}</p>
      {%- endif -%}

      <div class="sl-hero__actions">
        {%- if section.settings.primary_label != blank and section.settings.primary_url != blank -%}
          <a href="{{ section.settings.primary_url }}"
             class="sl-btn sl-hero__primary"
             data-app-primary-cta
             data-app-signed-out-label="{{ section.settings.primary_label | escape }}"
             data-app-signed-out-url="{{ section.settings.primary_url }}">
            <span data-app-cta-label>{{ section.settings.primary_label }}</span>
            <span aria-hidden="true">&rarr;</span>
          </a>
        {%- endif -%}
        {%- if section.settings.secondary_label != blank and section.settings.secondary_url != blank -%}
          <a href="{{ section.settings.secondary_url }}" class="sl-btn sl-hero__secondary">{{ section.settings.secondary_label }}</a>
        {%- endif -%}
      </div>

      {%- if section.settings.chip1 != blank or section.settings.chip2 != blank or section.settings.chip3 != blank -%}
        <ul class="sl-hero__proof" aria-label="{{ 'homepage.hero.proof_label' | t }}">
          {%- if section.settings.chip1 != blank -%}<li>{{ section.settings.chip1 }}</li>{%- endif -%}
          {%- if section.settings.chip2 != blank -%}<li>{{ section.settings.chip2 }}</li>{%- endif -%}
          {%- if section.settings.chip3 != blank -%}<li>{{ section.settings.chip3 }}</li>{%- endif -%}
        </ul>
      {%- endif -%}
      {%- if section.settings.fine_print != blank -%}
        <p class="sl-hero__fine">{{ section.settings.fine_print }}</p>
      {%- endif -%}
    </div>
  </div>

  {%- comment -%}
    The example-session card lived here through R7 and the owner's
    verdict was "it just looks too much" — it fought the tracers for the
    same corner. It now has its own section (example-session.liquid,
    after the report section); the hero is photograph, flight, and copy.
  {%- endcomment -%}
</section>

<script>
  (function () {
    'use strict';
    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
    var conn = navigator.connection;
    if (reduce.matches || (conn && conn.saveData)) return;
    var canvas = document.querySelector('.sl-hero__tracers');
    var hero = document.getElementById('home-hero');
    if (!canvas || !hero || !canvas.getContext) return;
    var ctx = canvas.getContext('2d');
    var dpr = Math.min(window.devicePixelRatio || 1, 2);
    var width = 0, height = 0, tracers = [], raf = 0, visible = false, nextAt = 0;

    function resize() {
      width = hero.clientWidth; height = hero.clientHeight;
      canvas.width = Math.round(width * dpr);
      canvas.height = Math.round(height * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    }

    /* The flight is anchored to the PHOTOGRAPH, not the viewport: the
       ball leaves the tee in front of the golfer and climbs down-range
       into the sunset, like the broadcast tracer it quotes. Anchors are
       image-space fractions mapped through the same object-fit: cover
       transform the browser applies to the backdrop, so the launch sits
       on the golfer at every viewport. The two packaged crops place him
       differently — measured, not guessed. */
    function coverMap(fx, fy, iw, ih, posX) {
      var scale = Math.max(width / iw, height / ih);
      var drawW = iw * scale, drawH = ih * scale;
      var offX = (width - drawW) * posX;
      var offY = (height - drawH) * 0.5;
      return { x: offX + fx * drawW, y: offY + fy * drawH };
    }
    function anchors() {
      var phone = width < 750;
      /* Mobile crop (1122x1402, object-position 32%): golfer center-right,
         ball at his stance, sun low right. Desktop (1672x941, centered):
         golfer at two-thirds, sun on the right horizon. */
      var iw = phone ? 1122 : 1672, ih = phone ? 1402 : 941, posX = phone ? 0.32 : 0.5;
      var ball = phone ? [0.60, 0.845] : [0.615, 0.745];
      var apex = phone ? [0.78, 0.52] : [0.77, 0.36];
      var land = phone ? [0.915, 0.665] : [0.905, 0.545];
      return {
        p0: coverMap(ball[0], ball[1], iw, ih, posX),
        p1: coverMap(apex[0], apex[1], iw, ih, posX),
        p2: coverMap(land[0], land[1], iw, ih, posX)
      };
    }

    /* One ball at a time — a shot every few seconds, not a fireworks
       show. The strike flash at launch is what sells "he hit that". */
    function spawn(now) {
      var a = anchors();
      var jx = (Math.random() - 0.5) * width * 0.02;
      var jy = (Math.random() - 0.5) * height * 0.015;
      tracers.push({
        x0: a.p0.x, y0: a.p0.y,
        x1: a.p1.x + jx * 3, y1: a.p1.y + jy * 3,
        x2: a.p2.x + jx, y2: a.p2.y + jy,
        born: now, flight: 2400 + Math.random() * 500, linger: 1400,
        hue: '255, 173, 98'
      });
    }

    function pointAt(t, p) {
      var u = 1 - t;
      return {
        x: u * u * p.x0 + 2 * u * t * p.x1 + t * t * p.x2,
        y: u * u * p.y0 + 2 * u * t * p.y1 + t * t * p.y2
      };
    }

    function frame(now) {
      raf = 0;
      if (!visible || reduce.matches) { ctx.clearRect(0, 0, width, height); return; }
      ctx.clearRect(0, 0, width, height);
      var phone = width < 750;
      if (now >= nextAt && tracers.length === 0) {
        spawn(now);
        nextAt = now + 5200 + Math.random() * 2400;
      }
      for (var i = tracers.length - 1; i >= 0; i--) {
        var tr = tracers[i];
        var age = now - tr.born;
        if (age > tr.flight + tr.linger) { tracers.splice(i, 1); continue; }
        var raw = Math.min(age / tr.flight, 1);
        var head = 1 - Math.pow(1 - raw, 2.4);
        var fade = age <= tr.flight ? 1 : 1 - (age - tr.flight) / tr.linger;
        /* Strike flash: a fast bright burst at the tee in the first
           220ms — the "he hit that" moment. */
        if (age < 220) {
          var ft = age / 220;
          var fr = (phone ? 10 : 16) * (0.4 + ft * 0.6);
          var flash = ctx.createRadialGradient(tr.x0, tr.y0, 0, tr.x0, tr.y0, fr);
          flash.addColorStop(0, 'rgba(255, 238, 210, ' + (0.9 * (1 - ft)).toFixed(3) + ')');
          flash.addColorStop(1, 'rgba(' + tr.hue + ', 0)');
          ctx.fillStyle = flash;
          ctx.beginPath();
          ctx.arc(tr.x0, tr.y0, fr, 0, Math.PI * 2);
          ctx.fill();
        }
        var steps = 34;
        for (var s = 1; s <= steps; s++) {
          var t1 = head * (s / steps);
          var t0 = head * ((s - 1) / steps);
          var a = pointAt(t0, tr), b = pointAt(t1, tr);
          ctx.beginPath();
          ctx.moveTo(a.x, a.y); ctx.lineTo(b.x, b.y);
          ctx.strokeStyle = 'rgba(' + tr.hue + ',' + (0.34 * fade * Math.pow(s / steps, 2.2)).toFixed(3) + ')';
          /* The trail thins with distance — perspective, not decoration. */
          ctx.lineWidth = (phone ? 2 : 2.4) * (1 - 0.65 * t1);
          ctx.lineCap = 'round';
          ctx.stroke();
        }
        if (age <= tr.flight) {
          var hp = pointAt(head, tr);
          var headR = (phone ? 6 : 9) * (1 - 0.5 * head);
          var glow = ctx.createRadialGradient(hp.x, hp.y, 0, hp.x, hp.y, headR);
          glow.addColorStop(0, 'rgba(255, 232, 200, ' + (0.9 * fade).toFixed(3) + ')');
          glow.addColorStop(1, 'rgba(' + tr.hue + ', 0)');
          ctx.fillStyle = glow;
          ctx.beginPath();
          ctx.arc(hp.x, hp.y, headR, 0, Math.PI * 2);
          ctx.fill();
        }
      }
      if (tracers.length || visible) raf = requestAnimationFrame(frame);
    }

    function wake() { if (!raf && visible) raf = requestAnimationFrame(frame); }
    var io = new IntersectionObserver(function (entries) {
      visible = entries[0].isIntersecting && !document.hidden;
      if (visible) { resize(); wake(); }
    });
    io.observe(hero);
    document.addEventListener('visibilitychange', function () {
      visible = !document.hidden && visible;
      if (!document.hidden) { visible = true; wake(); }
    });
    window.addEventListener('resize', function () { resize(); }, { passive: true });
    reduce.addEventListener('change', function () { tracers = []; });
    resize();
  })();
</script>

{% stylesheet %}
.sl-hero__tracers {
  position: absolute;
  inset: 0;
  z-index: 3;
  width: 100%;
  height: 100%;
  pointer-events: none;
}
@media (prefers-reduced-motion: reduce) {
  .sl-hero__tracers { display: none; }
}
.sl-hero {
  position: relative;
  isolation: isolate;
  min-height: clamp(700px, 78svh, 860px);
  overflow: hidden;
  background: var(--sl-night);
  color: var(--sl-bg);
}
.sl-hero::before,
.sl-hero::after {
  content: "";
  position: absolute;
  inset: 0;
  pointer-events: none;
}
.sl-hero::before {
  z-index: 1;
  background:
    linear-gradient(105deg, rgba(4, 13, 9, 0.96) 0%, rgba(4, 13, 9, 0.84) 38%, rgba(4, 13, 9, 0.28) 64%, rgba(4, 13, 9, 0.12) 100%),
    linear-gradient(0deg, rgba(4, 13, 9, 0.88) 0%, transparent 42%, rgba(4, 13, 9, 0.14) 100%);
}
.sl-hero::after {
  z-index: 2;
  opacity: 0.2;
  background-image:
    linear-gradient(rgba(255, 255, 255, 0.03) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255, 255, 255, 0.03) 1px, transparent 1px);
  background-size: 64px 64px;
  -webkit-mask-image: linear-gradient(90deg, #000, transparent 74%);
  mask-image: linear-gradient(90deg, #000, transparent 74%);
}
.sl-hero__backdrop,
.sl-hero__backdrop picture {
  position: absolute;
  inset: 0;
  margin: 0;
}
.sl-hero__image {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
}
.sl-hero__video,
.sl-hero__video video,
video.sl-hero__video {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
}
/* With no video set, the photograph carries the motion: a slow drift,
   far side of the reduced-motion gate. Alternate keeps the loop seamless. */
@media (prefers-reduced-motion: no-preference) {
  .sl-hero__backdrop--motion .sl-hero__image {
    animation: sl-hero-drift 28s ease-in-out infinite alternate;
    will-change: transform;
  }
  /* Load choreography: the copy stack rises line by line, once. */
  .sl-hero__copy > * { animation: sl-hero-rise 0.7s cubic-bezier(0.22, 0.8, 0.3, 1) both; }
  .sl-hero__copy > *:nth-child(2) { animation-delay: 0.07s; }
  .sl-hero__copy > *:nth-child(3) { animation-delay: 0.14s; }
  .sl-hero__copy > *:nth-child(4) { animation-delay: 0.21s; }
  .sl-hero__copy > *:nth-child(5) { animation-delay: 0.28s; }
  .sl-hero__copy > *:nth-child(6) { animation-delay: 0.35s; }
}
@keyframes sl-hero-rise {
  from { opacity: 0; transform: translateY(18px); }
}
@keyframes sl-hero-drift {
  from { transform: scale(1) translateX(0); }
  to { transform: scale(1.08) translateX(-1.5%); }
}
.sl-hero__inner {
  position: relative;
  z-index: 4;
  min-height: clamp(700px, 78svh, 860px);
  padding-top: clamp(96px, 11vw, 140px);
  padding-bottom: clamp(72px, 9vw, 120px);
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  gap: 0;
  align-items: end;
}
.sl-hero__copy {
  width: 100%;
  max-width: 720px;
}
.sl-hero__brand {
  margin: 0 0 16px;
  display: inline-flex;
  align-items: center;
  gap: 12px;
  color: var(--sl-bg-card);
  font-family: var(--sl-font-display);
  font-size: var(--sl-text-3xl);
  font-weight: 700;
  letter-spacing: -0.04em;
  line-height: 1;
}
.sl-hero__brand span {
  width: 10px;
  height: 10px;
  border-radius: 50%;
  background: var(--sl-accent);
  box-shadow: 0 0 0 7px rgba(var(--sl-accent-rgb), 0.14);
  animation: sl-hero-pulse 2.4s ease-in-out infinite;
}
@keyframes sl-hero-pulse {
  0%, 100% { box-shadow: 0 0 0 6px rgba(var(--sl-accent-rgb), 0.1); }
  50% { box-shadow: 0 0 0 10px rgba(var(--sl-accent-rgb), 0.04); }
}
.sl-hero__title {
  max-width: 15ch;
  margin: 0;
  color: var(--sl-bg-card);
  font-family: var(--sl-font-display);
  font-size: var(--sl-text-4xl);
  font-weight: 600;
  /* Condensed-gothic caps — the PLAY BETTER GOLF register. The face is
     tall and narrow, so caps at slight positive tracking stay legible
     where the old tight-tracked grotesque read cramped. */
  letter-spacing: 0.02em;
  line-height: 1.04;
  text-transform: uppercase;
  text-align: left;
  text-wrap: balance;
}
.sl-hero__body {
  max-width: 40ch;
  margin: 18px 0 0;
  color: rgba(238, 242, 239, 0.86);
  font-size: var(--sl-text-lg);
  font-weight: 400;
  line-height: 1.55;
  letter-spacing: -0.01em;
  text-align: left;
  text-wrap: pretty;
}
.sl-hero__actions {
  margin: 28px 0 0;
  width: min(100%, 480px);
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12px;
}
.sl-hero__primary,
.sl-hero__secondary {
  min-height: 52px;
  padding: 14px 22px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--sl-radius-control);
}
.sl-hero__primary {
  border-color: var(--sl-accent);
  background: var(--sl-accent);
  color: var(--sl-night);
  box-shadow: 0 18px 38px -20px rgba(var(--sl-accent-rgb), 0.9);
}
.sl-hero__primary:hover {
  border-color: var(--sl-accent-hover);
  background: var(--sl-accent-hover);
  color: var(--sl-night);
}
.sl-hero__primary span:last-child { margin-left: 10px; transition: transform 0.2s ease; }
.sl-hero__primary:hover span:last-child { transform: translateX(4px); }
.sl-hero__secondary {
  border-color: rgba(238, 242, 239, 0.42);
  background: rgba(6, 17, 12, 0.36);
  color: var(--sl-bg);
  -webkit-backdrop-filter: blur(14px);
  backdrop-filter: blur(14px);
}
.sl-hero__secondary:hover {
  border-color: rgba(238, 242, 239, 0.8);
  background: rgba(238, 242, 239, 0.1);
  color: #ffffff;
}
.sl-hero__primary:focus-visible,
.sl-hero__secondary:focus-visible {
  outline: 3px solid var(--sl-focus-dark);
  outline-offset: 4px;
}
.sl-hero__proof {
  width: fit-content;
  max-width: 100%;
  margin: 22px 0 0;
  padding: 0;
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-start;
  gap: 8px 18px;
  list-style: none;
  border: 0;
  background: transparent;
}
.sl-hero__proof li {
  position: relative;
  padding-left: 14px;
  color: rgba(238, 242, 239, 0.66);
  font-family: var(--sl-font-mono);
  font-size: var(--sl-text-xs);
  font-weight: 500;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}
.sl-hero__proof li::before {
  content: "";
  position: absolute;
  top: 0.42em;
  left: 0;
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: #75d59b;
}
.sl-hero__fine {
  margin: 14px 0 0;
  color: rgba(238, 242, 239, 0.58);
  font-size: var(--sl-text-xs);
  text-align: left;
}
@media (max-width: 999px) {
  .sl-hero__title { font-size: var(--sl-text-4xl); }
}
@media (max-width: 749px) {
  .sl-hero {
    /* Roomy but not sprawling: the copy breathes and the compact signal
       card still lands within the first easy scroll. */
    --sl-mobile-hero-height: clamp(560px, calc(96svh - 180px), 660px);
    min-height: var(--sl-mobile-hero-height);
  }
  /* Bottom-anchored copy means the shade belongs at the BOTTOM. A modest
     band under the header keeps nav contrast, the middle opens up so the
     photograph actually shows, and the deep ramp starts where the type
     starts. The old gradient was 95% opaque at the top — a black field. */
  .sl-hero::before {
    background:
      linear-gradient(180deg, rgba(4, 13, 9, 0.6) 0%, rgba(4, 13, 9, 0.2) 26%, rgba(4, 13, 9, 0.34) 52%, rgba(4, 13, 9, 0.9) 100%),
      linear-gradient(90deg, rgba(4, 13, 9, 0.28), rgba(4, 13, 9, 0.04));
  }
  .sl-hero::after {
    background-size: 48px 48px;
    -webkit-mask-image: linear-gradient(180deg, #000, transparent 68%);
    mask-image: linear-gradient(180deg, #000, transparent 68%);
  }
  .sl-hero__image { object-position: 32% center; }
  .sl-hero__inner {
    min-height: var(--sl-mobile-hero-height);
    padding-top: clamp(52px, 8vw, 68px);
    padding-bottom: clamp(40px, 7vw, 56px);
    grid-template-columns: 1fr;
    align-content: end;
    justify-items: stretch;
    gap: 0;
  }
  /* The signal card stays on phones (the only visual showing what the
     product produces) — as a compact fact strip; rules further down. */
  .sl-hero__copy {
    margin-inline: 0;
    text-align: left;
  }
  .sl-hero__brand {
    font-size: var(--sl-text-2xl);
  }
  .sl-hero__title {
    max-width: 11ch;
    margin-inline: 0;
    font-size: var(--sl-text-4xl);
    line-height: 1.02;
  }
  .sl-hero__body {
    max-width: 36ch;
    margin-inline: 0;
    margin-top: 16px;
    font-size: var(--sl-text-base);
    line-height: 1.48;
    text-align: left;
  }
  .sl-hero__actions {
    width: min(100%, 320px);
    grid-template-columns: 1fr;
    gap: 10px;
    margin: 24px 0 0;
  }
  .sl-hero__primary { width: 100%; min-height: 48px; padding: 12px 18px; }
  .sl-hero__secondary {
    width: 100%;
    min-height: 44px;
    padding: 10px 16px;
    justify-self: stretch;
    justify-content: center;
    border: 1px solid rgba(238, 242, 239, 0.34);
    background: rgba(6, 17, 12, 0.42);
    text-decoration: none;
  }
  .sl-hero__secondary:hover { border-color: rgba(238, 242, 239, 0.72); background: rgba(238, 242, 239, 0.1); }
  /* One quiet mono line: the 2-column grid orphaned the third chip and
     its green dots fought the orange brand dot. Middots, one color. */
  .sl-hero__proof {
    width: 100%;
    margin: 18px 0 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-start;
    gap: 4px 0;
  }
  .sl-hero__proof li {
    padding-left: 0;
    color: rgba(var(--sl-cream-rgb), 0.55);
    font-size: var(--sl-text-xs);
    letter-spacing: 0.09em;
  }
  .sl-hero__proof li::before { display: none; }
  .sl-hero__proof li + li::before {
    content: "\00B7";
    display: inline;
    position: static;
    margin: 0 var(--sl-space-2);
    background: none;
    width: auto;
    height: auto;
  }
  .sl-hero__fine {
    max-width: 40ch;
    margin: 6px 0 0;
    color: rgba(var(--sl-cream-rgb), 0.45);
    text-align: left;
  }
}
@media (max-width: 559px) {
  .sl-hero__brand { font-size: var(--sl-text-xl); letter-spacing: -0.03em; }
  .sl-hero__title { max-width: 10ch; font-size: var(--sl-text-4xl); }
}
@media (prefers-reduced-motion: reduce) {
  .sl-hero__primary span { transition: none; }
  .sl-hero__brand span { animation: none; }
}
{% endstylesheet %}

