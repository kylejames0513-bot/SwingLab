{%- liquid
  assign hero_image_label = 'homepage.hero.image_label' | t
  assign hero_image = section.settings.image | default: images['caddieinsight-premium-range-hero-0852e38d.png']
  assign hero_mobile_image = section.settings.mobile_image | default: images['caddieinsight-premium-range-hero-mobile-2e4ee946.png']
  assign hero_image_alt = hero_image_label
-%}

<section id="home-hero" class="sl-hero" aria-labelledby="HeroTitle-{{ section.id }}">
  <figure class="sl-hero__backdrop">
    {%- if hero_image -%}
      <picture>
        {%- if hero_mobile_image -%}
          <source
            media="(max-width: 749px)"
            srcset="{{ hero_mobile_image | image_url: width: 480 }} 480w, {{ hero_mobile_image | image_url: width: 750 }} 750w, {{ hero_mobile_image | image_url: width: 1000 }} 1000w, {{ hero_mobile_image | image_url: width: 1122 }} 1122w"
            sizes="100vw">
        {%- endif -%}
        {{ hero_image | image_url: width: 1672 | image_tag:
          class: 'sl-hero__image',
          widths: '750, 1100, 1400, 1672',
          sizes: '100vw',
          loading: 'eager',
          fetchpriority: 'high',
          alt: hero_image_alt }}
      </picture>
    {%- else -%}
      <div class="sl-hero__fallback" aria-hidden="true"></div>
    {%- endif -%}
  </figure>

  <div class="sl-hero__inner sl-wrap">
    <div class="sl-hero__copy sl-reveal is-in">
      {%- if section.settings.eyebrow != blank -%}
        <p class="sl-hero__eyebrow"><span aria-hidden="true"></span>{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h1 id="HeroTitle-{{ section.id }}" class="sl-hero__title">{{ section.settings.heading | default: 'Practice the move that matters.' }}</h1>
      {%- if section.settings.body != blank -%}
        <p class="sl-hero__body">{{ section.settings.body }}</p>
      {%- endif -%}

      <div class="sl-hero__actions">
        {%- if section.settings.primary_label != blank and section.settings.primary_url != blank -%}
          <a href="{{ section.settings.primary_url }}"
             class="sl-btn sl-hero__primary"
             data-app-primary-cta
             data-app-signed-out-label="{{ section.settings.primary_label | escape }}"
             data-app-signed-out-url="{{ section.settings.primary_url }}">
            <span data-app-cta-label>{{ section.settings.primary_label }}</span>
            <span aria-hidden="true">&rarr;</span>
          </a>
        {%- endif -%}
        {%- if section.settings.secondary_label != blank and section.settings.secondary_url != blank -%}
          <a href="{{ section.settings.secondary_url }}" class="sl-btn sl-hero__secondary">{{ section.settings.secondary_label }}</a>
        {%- endif -%}
      </div>

      {%- if section.settings.chip1 != blank or section.settings.chip2 != blank or section.settings.chip3 != blank -%}
        <ul class="sl-hero__proof" aria-label="{{ 'homepage.hero.proof_label' | t }}">
          {%- if section.settings.chip1 != blank -%}<li>{{ section.settings.chip1 }}</li>{%- endif -%}
          {%- if section.settings.chip2 != blank -%}<li>{{ section.settings.chip2 }}</li>{%- endif -%}
          {%- if section.settings.chip3 != blank -%}<li>{{ section.settings.chip3 }}</li>{%- endif -%}
        </ul>
      {%- endif -%}
      {%- if section.settings.fine_print != blank -%}
        <p class="sl-hero__fine">{{ section.settings.fine_print }}</p>
      {%- endif -%}
    </div>

    <aside class="sl-hero__signal sl-reveal sl-reveal--d1 is-in" aria-label="{{ 'homepage.hero.signal_label' | t }}">
      <div class="sl-hero__signal-head">
        <span>{{ 'homepage.hero.signal_status' | t }}</span>
        <span class="sl-hero__signal-live"><i aria-hidden="true"></i>{{ 'homepage.hero.signal_ready' | t }}</span>
      </div>
      <div class="sl-hero__trace" role="img" aria-label="{{ 'homepage.hero.trace_label' | t }}">
        <span class="sl-hero__trace-line" aria-hidden="true"></span>
        <span class="sl-hero__trace-dot sl-hero__trace-dot--one" aria-hidden="true"></span>
        <span class="sl-hero__trace-dot sl-hero__trace-dot--two" aria-hidden="true"></span>
        <span class="sl-hero__trace-dot sl-hero__trace-dot--three" aria-hidden="true"></span>
      </div>
      <dl class="sl-hero__signal-grid">
        <div><dt>{{ 'homepage.hero.club_label' | t }}</dt><dd>{{ section.settings.signal_club }}</dd></div>
        <div><dt>{{ 'homepage.hero.priority_label' | t }}</dt><dd>{{ section.settings.signal_priority }}</dd></div>
        <div><dt>{{ 'homepage.hero.target_label' | t }}</dt><dd>{{ section.settings.signal_target }}</dd></div>
      </dl>
      <p class="sl-hero__signal-note">{{ 'homepage.hero.signal_disclosure' | t }}</p>
    </aside>
  </div>
</section>

{% stylesheet %}
.sl-hero {
  position: relative;
  isolation: isolate;
  min-height: clamp(700px, 78svh, 860px);
  overflow: hidden;
  background: #07130d;
  color: #f5f2e9;
}
.sl-hero::before,
.sl-hero::after {
  content: "";
  position: absolute;
  inset: 0;
  pointer-events: none;
}
.sl-hero::before {
  z-index: 1;
  background:
    linear-gradient(90deg, rgba(4, 13, 9, 0.96) 0%, rgba(4, 13, 9, 0.87) 34%, rgba(4, 13, 9, 0.36) 61%, rgba(4, 13, 9, 0.18) 100%),
    linear-gradient(0deg, rgba(4, 13, 9, 0.86) 0%, transparent 38%, rgba(4, 13, 9, 0.16) 100%);
}
.sl-hero::after {
  z-index: 2;
  opacity: 0.24;
  background-image:
    linear-gradient(rgba(255, 255, 255, 0.025) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255, 255, 255, 0.025) 1px, transparent 1px);
  background-size: 72px 72px;
  -webkit-mask-image: linear-gradient(90deg, #000, transparent 72%);
  mask-image: linear-gradient(90deg, #000, transparent 72%);
}
.sl-hero__backdrop,
.sl-hero__backdrop picture {
  position: absolute;
  inset: 0;
  margin: 0;
}
.sl-hero__image,
.sl-hero__fallback {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
}
.sl-hero__fallback {
  background: radial-gradient(circle at 72% 42%, rgba(240, 122, 24, 0.22), transparent 24%), linear-gradient(135deg, #0f2d1e, #050c08);
}
.sl-hero__inner {
  position: relative;
  z-index: 4;
  min-height: clamp(700px, 78svh, 860px);
  padding-top: clamp(88px, 10vw, 132px);
  padding-bottom: clamp(88px, 10vw, 132px);
  display: grid;
  grid-template-columns: minmax(0, 1.05fr) minmax(280px, 0.6fr);
  gap: clamp(32px, 5vw, 76px);
  align-items: center;
}
.sl-hero__copy {
  width: 100%;
  max-width: 730px;
}
.sl-hero__eyebrow {
  margin: 0 auto 22px;
  display: inline-flex;
  align-items: center;
  gap: 10px;
  color: rgba(245, 242, 233, 0.74);
  font-family: var(--sl-font-mono);
  font-size: 11.5px;
  font-weight: 500;
  letter-spacing: 0.18em;
  text-transform: uppercase;
}
.sl-hero__eyebrow span {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: #f07a18;
  box-shadow: 0 0 0 6px rgba(240, 122, 24, 0.12);
}
.sl-hero__title {
  max-width: 850px;
  margin: 0 auto;
  color: #f8f6ef;
  font-size: clamp(54px, 6.8vw, 96px);
  font-weight: 900;
  letter-spacing: -0.058em;
  line-height: 0.91;
  text-align: center;
  text-wrap: balance;
  text-shadow: 0 22px 52px rgba(0, 0, 0, 0.3);
}
.sl-hero__body {
  max-width: 55ch;
  margin: 28px 0 0;
  color: rgba(245, 242, 233, 0.78);
  font-size: clamp(17px, 1.5vw, 20px);
  line-height: 1.58;
  text-align: left;
  text-wrap: pretty;
}
.sl-hero__actions {
  margin: 34px 0 0;
  width: min(100%, 570px);
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12px;
}
.sl-hero__primary,
.sl-hero__secondary {
  min-height: 54px;
  padding: 15px 24px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 999px;
}
.sl-hero__primary {
  border-color: #f07a18;
  background: #f07a18;
  color: #07130d;
  box-shadow: 0 18px 38px -20px rgba(240, 122, 24, 0.9);
}
.sl-hero__primary:hover {
  border-color: #ff9a42;
  background: #ff9a42;
  color: #07130d;
}
.sl-hero__primary span:last-child { margin-left: 10px; transition: transform 0.2s ease; }
.sl-hero__primary:hover span:last-child { transform: translateX(4px); }
.sl-hero__secondary {
  border-color: rgba(245, 242, 233, 0.42);
  background: rgba(7, 19, 13, 0.32);
  color: #f5f2e9;
  -webkit-backdrop-filter: blur(14px);
  backdrop-filter: blur(14px);
}
.sl-hero__secondary:hover {
  border-color: rgba(245, 242, 233, 0.8);
  background: rgba(245, 242, 233, 0.1);
  color: #ffffff;
}
.sl-hero__primary:focus-visible,
.sl-hero__secondary:focus-visible {
  outline: 3px solid #ffad62;
  outline-offset: 4px;
}
.sl-hero__proof {
  width: fit-content;
  max-width: 100%;
  margin: 26px 0 0;
  padding: 11px 14px;
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-start;
  gap: 10px 22px;
  list-style: none;
  border: 1px solid rgba(245, 242, 233, 0.14);
  border-radius: 12px;
  background: rgba(5, 16, 10, 0.46);
  -webkit-backdrop-filter: blur(12px);
  backdrop-filter: blur(12px);
}
.sl-hero__proof li {
  position: relative;
  padding-left: 16px;
  color: rgba(245, 242, 233, 0.68);
  font-family: var(--sl-font-mono);
  font-size: 10.5px;
  font-weight: 500;
  letter-spacing: 0.12em;
  text-transform: uppercase;
}
.sl-hero__proof li::before {
  content: "";
  position: absolute;
  top: 0.42em;
  left: 0;
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: #75d59b;
}
.sl-hero__fine {
  margin: 12px 0 0;
  color: rgba(245, 242, 233, 0.66);
  font-size: 12.5px;
  text-align: left;
}
.sl-hero__signal {
  width: min(100%, 360px);
  margin: 0 auto;
  padding: var(--sl-card-inset);
  align-self: center;
  text-align: center;
  border: 1px solid rgba(245, 242, 233, 0.2);
  border-radius: 22px;
  background: rgba(5, 16, 10, 0.68);
  -webkit-backdrop-filter: blur(20px);
  backdrop-filter: blur(20px);
  box-shadow: 0 34px 80px -34px rgba(0, 0, 0, 0.9);
}
.sl-hero__signal-head {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
  gap: 12px;
  color: rgba(245, 242, 233, 0.6);
  font-family: var(--sl-font-mono);
  font-size: 9.5px;
  font-weight: 500;
  letter-spacing: 0.14em;
  text-transform: uppercase;
}
.sl-hero__signal-live { display: inline-flex; align-items: center; gap: 7px; color: #8be4ad; }
.sl-hero__signal-live i {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: currentColor;
  box-shadow: 0 0 0 5px rgba(139, 228, 173, 0.12);
}
.sl-hero__trace {
  position: relative;
  height: 112px;
  margin-top: 16px;
  overflow: hidden;
  border: 1px solid rgba(245, 242, 233, 0.1);
  border-radius: 15px;
  background:
    linear-gradient(rgba(255, 255, 255, 0.035) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255, 255, 255, 0.035) 1px, transparent 1px),
    rgba(255, 255, 255, 0.025);
  background-size: 28px 28px;
}
.sl-hero__trace-line {
  position: absolute;
  left: 17%;
  top: 22%;
  width: 70%;
  height: 92%;
  border-top: 2px solid #f28a32;
  border-radius: 50%;
  transform: rotate(-8deg);
  filter: drop-shadow(0 0 8px rgba(242, 138, 50, 0.52));
}
.sl-hero__trace-dot {
  position: absolute;
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: #f5f2e9;
  box-shadow: 0 0 0 4px rgba(245, 242, 233, 0.12);
}
.sl-hero__trace-dot--one { left: 22%; top: 57%; }
.sl-hero__trace-dot--two { left: 52%; top: 30%; background: #f28a32; }
.sl-hero__trace-dot--three { right: 14%; top: 50%; }
.sl-hero__signal-grid {
  margin: 16px 0 0;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
}
.sl-hero__signal-grid > div { min-width: 0; padding: 0 var(--sl-dense-inset); }
.sl-hero__signal-grid > div:first-child { padding-left: 0; }
.sl-hero__signal-grid > div:last-child { padding-right: 0; }
.sl-hero__signal-grid > div + div { border-left: 1px solid rgba(245, 242, 233, 0.12); }
.sl-hero__signal-grid dt {
  color: rgba(245, 242, 233, 0.62);
  font-family: var(--sl-font-mono);
  font-size: 10.5px;
  font-weight: 500;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  text-align: center;
}
.sl-hero__signal-grid dd {
  margin: 6px 0 0;
  color: #f5f2e9;
  font-size: 11px;
  font-weight: 700;
  line-height: 1.35;
  text-align: center;
}
.sl-hero__signal-note {
  margin: 14px 0 0;
  color: rgba(245, 242, 233, 0.66);
  font-size: 12px;
  line-height: 1.45;
  text-align: center;
}
@media (max-width: 980px) {
  .sl-hero__inner { grid-template-columns: minmax(0, 1fr) minmax(250px, 0.48fr); }
  .sl-hero__title { font-size: clamp(50px, 7.8vw, 74px); }
}
@media (max-width: 749px) {
  .sl-hero {
    --sl-mobile-hero-height: clamp(600px, calc(100svh - 102px), 680px);
    min-height: var(--sl-mobile-hero-height);
  }
  .sl-hero::before {
    background:
      linear-gradient(180deg, rgba(4, 13, 9, 0.95) 0%, rgba(4, 13, 9, 0.82) 48%, rgba(4, 13, 9, 0.46) 76%, rgba(4, 13, 9, 0.72) 100%),
      linear-gradient(90deg, rgba(4, 13, 9, 0.72), rgba(4, 13, 9, 0.08));
  }
  .sl-hero::after {
    background-size: 48px 48px;
    -webkit-mask-image: linear-gradient(180deg, #000, transparent 68%);
    mask-image: linear-gradient(180deg, #000, transparent 68%);
  }
  .sl-hero__image { object-position: 32% center; }
  .sl-hero__inner {
    min-height: var(--sl-mobile-hero-height);
    padding-top: clamp(44px, 7vw, 60px);
    padding-bottom: clamp(44px, 7vw, 60px);
    grid-template-columns: 1fr;
    align-content: center;
    justify-items: center;
    gap: 0;
  }
  .sl-hero__copy {
    margin-inline: auto;
    text-align: center;
  }
  .sl-hero__title {
    max-width: 10.5ch;
    margin-inline: auto;
    font-size: clamp(42px, 11.5vw, 50px);
    line-height: 0.94;
  }
  .sl-hero__body {
    max-width: 36ch;
    margin-inline: auto;
    margin-top: 16px;
    font-size: 15.5px;
    line-height: 1.48;
    text-align: center;
  }
  .sl-hero__actions {
    width: min(100%, 310px);
    grid-template-columns: 1fr;
    gap: 10px;
    margin: 20px auto 0;
  }
  .sl-hero__primary { width: 100%; min-height: 48px; padding: 12px 18px; }
  .sl-hero__secondary {
    width: 100%;
    min-height: 44px;
    padding: 10px 16px;
    justify-self: stretch;
    justify-content: center;
    border: 1px solid rgba(245, 242, 233, 0.34);
    background: rgba(7, 19, 13, 0.42);
    text-decoration: none;
  }
  .sl-hero__secondary:hover { border-color: rgba(245, 242, 233, 0.72); background: rgba(245, 242, 233, 0.1); }
  .sl-hero__proof {
    width: fit-content;
    margin: 18px auto 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, max-content));
    justify-content: center;
    gap: 8px 16px;
  }
  .sl-hero__proof li { padding-left: 13px; font-size: 9.5px; letter-spacing: 0.09em; }
  .sl-hero__proof li::before { width: 5px; height: 5px; }
  .sl-hero__fine {
    max-width: 36ch;
    margin: 14px auto 0;
    text-align: center;
  }
  .sl-hero__signal { display: none; }
}
@media (max-width: 480px) {
  .sl-hero__eyebrow { font-size: 10px; letter-spacing: 0.13em; }
  .sl-hero__title { max-width: 10ch; font-size: clamp(40px, 11.5vw, 49px); }
}
@media (prefers-reduced-motion: reduce) {
  .sl-hero__primary span { transition: none; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Premium hero",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "PHONE-VIDEO COACHING · NO SENSORS" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Practice the move that matters." },
    { "type": "textarea", "id": "body", "label": "Body", "default": "Choose the club, film one repeatable view, and get one prioritized coaching plan with a pass mark for your next clip." },
    { "type": "text", "id": "primary_label", "label": "Primary button label", "default": "Analyze a swing free" },
    { "type": "url", "id": "primary_url", "label": "Primary button link" },
    { "type": "text", "id": "secondary_label", "label": "Secondary button label", "default": "Explore the sample report" },
    { "type": "url", "id": "secondary_url", "label": "Secondary button link" },
    { "type": "text", "id": "chip1", "label": "Proof point 1", "default": "1 REPORT / MONTH" },
    { "type": "text", "id": "chip2", "label": "Proof point 2", "default": "NO CARD" },
    { "type": "text", "id": "chip3", "label": "Proof point 3", "default": "CLUB SAVED" },
    { "type": "text", "id": "fine_print", "label": "Fine print", "default": "Supported 2D movement and timing estimates from phone video." },
    { "type": "image_picker", "id": "image", "label": "Desktop hero image", "info": "Use the approved wide premium range artwork." },
    { "type": "image_picker", "id": "mobile_image", "label": "Mobile hero image", "info": "Use the approved portrait companion artwork." },
    { "type": "text", "id": "signal_club", "label": "Sample club", "default": "Iron" },
    { "type": "text", "id": "signal_priority", "label": "Sample priority", "default": "Lead-hip control" },
    { "type": "text", "id": "signal_target", "label": "Sample target", "default": "One pass mark" }
  ],
  "presets": [{ "name": "Premium hero" }]
}
{% endschema %}
