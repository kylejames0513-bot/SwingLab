{%- comment -%}
  The example session, rehomed. R7 stacked it inside the hero and the
  owner's verdict was "it just looks too much" — the card fought the
  tracers for the same corner. Here it sits in the light part of the
  page as the bridge out of the report section: one dark chart window
  (the live trace read), the three facts inline, the disclosure line.
  One box, not three — the trace inset is the only bordered surface.
  The live-read animation carries the same contract as everywhere else:
  every default is the fully drawn still, and motion exists only inside
  the no-preference gate.
{%- endcomment -%}
<section class="sl-example" aria-label="{{ 'homepage.hero.signal_label' | t }}">
  <div class="sl-wrap sl-reveal">
    <div class="sl-example__head">
      <p class="sl-example__eyebrow">{{ 'homepage.hero.signal_status' | t }}</p>
      <span class="sl-example__live"><i aria-hidden="true"></i>{{ 'homepage.hero.signal_ready' | t }}</span>
    </div>
    <div class="sl-example__trace" role="img" aria-label="{{ 'homepage.hero.trace_label' | t }}">
      <svg class="sl-example__trace-svg" viewBox="0 0 280 88" preserveAspectRatio="xMidYMid meet" aria-hidden="true" focusable="false">
        <path class="sl-example__trace-arc" d="M 54 66 C 96 46, 148 10, 214 20" pathLength="100"/>
        <path class="sl-example__trace-strike" d="M 54 66 C 96 46, 148 10, 214 20" pathLength="100"/>
        <g class="sl-example__trace-tick sl-example__trace-tick--mid" transform="translate(125 32)">
          <path d="M -5 0 H 5 M 0 -5 V 5"/>
        </g>
        <g class="sl-example__trace-tick sl-example__trace-tick--top" transform="translate(214 20)">
          <path d="M -5 0 H 5 M 0 -5 V 5"/>
        </g>
        <circle class="sl-example__trace-impact" cx="54" cy="66" r="14"/>
        <circle class="sl-example__trace-ball" cx="54" cy="66" r="3.2"/>
      </svg>
    </div>
    <dl class="sl-example__facts">
      <div><dt>{{ 'homepage.hero.club_label' | t }}</dt><dd>{{ section.settings.signal_club }}</dd></div>
      <div><dt>{{ 'homepage.hero.priority_label' | t }}</dt><dd>{{ section.settings.signal_priority }}</dd></div>
      <div><dt>{{ 'homepage.hero.target_label' | t }}</dt><dd>{{ section.settings.signal_target }}</dd></div>
    </dl>
    <p class="sl-example__note">{{ 'homepage.hero.signal_disclosure' | t }}</p>
  </div>
</section>

{% stylesheet %}
.sl-example {
  padding-top: var(--sl-section-space-compact);
  padding-bottom: var(--sl-section-space-compact);
  border-top: 1px solid var(--sl-border);
}
.sl-example__head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: var(--sl-space-2) var(--sl-space-4);
}
.sl-example__eyebrow {
  margin: 0;
  color: var(--sl-ink-muted);
  font-family: var(--sl-font-mono);
  font-size: var(--sl-text-xs);
  font-weight: 500;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}
.sl-example__live {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  color: var(--sl-green-btn);
  font-family: var(--sl-font-mono);
  font-size: var(--sl-text-xs);
  font-weight: 500;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}
.sl-example__live i {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: currentColor;
}
/* The one box: a dark chart window in the light page — the report's
   world showing through. */
.sl-example__trace {
  position: relative;
  height: 96px;
  margin-top: var(--sl-space-3);
  overflow: hidden;
  border-radius: var(--sl-radius-sm);
  background:
    linear-gradient(rgba(255, 255, 255, 0.04) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255, 255, 255, 0.04) 1px, transparent 1px),
    var(--sl-night);
  background-size: 24px 24px;
}
.sl-example__trace-svg { position: absolute; inset: 0; width: 100%; height: 100%; }
.sl-example__trace-arc {
  fill: none;
  stroke: rgba(238, 242, 239, 0.45);
  stroke-width: 1.6;
  stroke-linecap: round;
  stroke-dasharray: 100;
  stroke-dashoffset: 0;
}
.sl-example__trace-strike {
  fill: none;
  stroke: #f28a32;
  stroke-width: 2.2;
  stroke-linecap: round;
  stroke-dasharray: 100;
  stroke-dashoffset: 0;
  filter: drop-shadow(0 0 7px rgba(242, 138, 50, 0.5));
}
.sl-example__trace-tick path { fill: none; stroke: rgba(238, 242, 239, 0.65); stroke-width: 1.2; }
.sl-example__trace-impact {
  fill: none;
  stroke: #f28a32;
  stroke-width: 1.4;
  opacity: 0;
  transform-box: fill-box;
  transform-origin: center;
}
.sl-example__trace-ball { fill: var(--sl-bg); opacity: 0.9; }
/* Same 9.2s read as ever: backswing 3%→32%, strike 35.6%→45% — the 3:1
   tempo benchmark. Defaults above are the drawn still. */
@media (prefers-reduced-motion: no-preference) {
  .sl-example__trace-arc { animation: sl-example-read 9.2s linear infinite; }
  .sl-example__trace-strike { animation: sl-example-strike 9.2s linear infinite; }
  .sl-example__trace-tick--mid { animation: sl-example-tick-mid 9.2s linear infinite; }
  .sl-example__trace-tick--top { animation: sl-example-tick-top 9.2s linear infinite; }
  .sl-example__trace-impact { animation: sl-example-impact 9.2s linear infinite; }
  .sl-example__trace-ball { animation: sl-example-anchor 9.2s linear infinite; }
  .sl-example__live i { animation: sl-example-blink 3.1s ease-in-out infinite; }
}
@keyframes sl-example-read {
  0%, 2.9% { stroke-dashoffset: 100; opacity: 0; }
  3% { stroke-dashoffset: 100; opacity: 1; animation-timing-function: cubic-bezier(0.33, 0, 0.45, 1); }
  32%, 69.9% { stroke-dashoffset: 0; opacity: 1; }
  76%, 76.9% { stroke-dashoffset: 0; opacity: 0; }
  77%, 100% { stroke-dashoffset: 100; opacity: 0; }
}
@keyframes sl-example-strike {
  0%, 35.5% { stroke-dashoffset: -100; opacity: 0; }
  35.6% { stroke-dashoffset: -100; opacity: 1; animation-timing-function: cubic-bezier(0.55, 0, 0.85, 0.6); }
  45%, 69.9% { stroke-dashoffset: 0; opacity: 1; }
  76%, 76.9% { stroke-dashoffset: 0; opacity: 0; }
  77%, 100% { stroke-dashoffset: -100; opacity: 0; }
}
@keyframes sl-example-tick-mid {
  0%, 17% { opacity: 0; } 20%, 69.9% { opacity: 0.75; } 76%, 100% { opacity: 0; }
}
@keyframes sl-example-tick-top {
  0%, 31% { opacity: 0; } 33%, 69.9% { opacity: 0.9; } 76%, 100% { opacity: 0; }
}
@keyframes sl-example-impact {
  0%, 44.9% { opacity: 0; transform: scale(0.25); }
  45% { opacity: 0.85; }
  53%, 100% { opacity: 0; transform: scale(1.15); }
}
@keyframes sl-example-anchor {
  0%, 3% { opacity: 0; } 8%, 69.9% { opacity: 0.9; } 76%, 100% { opacity: 0; }
}
@keyframes sl-example-blink { 0%, 100% { opacity: 1; } 50% { opacity: 0.35; } }
.sl-example__facts {
  margin: var(--sl-space-3) 0 0;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: var(--sl-space-3);
}
.sl-example__facts dt {
  color: var(--sl-ink-muted);
  font-family: var(--sl-font-mono);
  font-size: var(--sl-text-xs);
  font-weight: 500;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}
.sl-example__facts dd {
  margin: 4px 0 0;
  color: var(--sl-ink);
  font-size: var(--sl-text-sm);
  font-weight: 700;
}
.sl-example__note {
  margin: var(--sl-space-3) 0 0;
  color: var(--sl-ink-muted);
  font-size: var(--sl-text-xs);
  line-height: 1.5;
}
@media (max-width: 749px) {
  .sl-example__trace { height: 80px; }
  .sl-example__facts {
    grid-template-columns: minmax(0, 1fr);
    gap: 0;
  }
  .sl-example__facts > div {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--sl-space-3);
    padding: var(--sl-space-2) 0;
  }
  .sl-example__facts > div + div { border-top: 1px solid var(--sl-border); }
  .sl-example__facts dd { margin: 0; text-align: right; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Example session",
  "settings": [
    { "type": "text", "id": "signal_club", "label": "Sample club", "default": "Iron" },
    { "type": "text", "id": "signal_priority", "label": "Sample priority", "default": "Lead-hip control" },
    { "type": "text", "id": "signal_target", "label": "Sample target", "default": "One pass mark" }
  ],
  "presets": [{ "name": "Example session" }]
}
{% endschema %}
