<section class="sl-cta">
  <span class="sl-cta__arc" aria-hidden="true"></span>
  <div class="sl-wrap">
    <div class="sl-cta__inner sl-reveal">
      <h2 class="sl-cta__title">{{ section.settings.heading | default: 'Your next range session should count.' }}</h2>
      {%- if section.settings.sub != blank -%}
        <p class="sl-cta__sub">{{ section.settings.sub }}</p>
      {%- endif -%}
      <div class="sl-cta__actions">
        {%- if section.settings.primary_label != blank -%}
          <a href="{{ section.settings.primary_url | default: '#' }}"
             class="sl-btn sl-btn--light"
             data-app-primary-cta
             data-app-signed-out-label="{{ section.settings.primary_label | escape }}"
             data-app-signed-out-url="{{ section.settings.primary_url | default: '#' }}">
            <span data-app-cta-label>{{ section.settings.primary_label }}</span>
          </a>
        {%- endif -%}
        {%- if section.settings.secondary_label != blank -%}
          <a href="{{ section.settings.secondary_url | default: '/products/swinglab-pro' }}"
             class="sl-btn sl-cta__ghost"
             data-app-pro-sales-link>{{ section.settings.secondary_label }}</a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
.sl-cta {
  position: relative;
  overflow: clip;
  background: var(--sl-green);
  color: var(--sl-green-ink);
  padding: var(--sl-section-space-compact) 0;
}
/* one faint quarter-sweep, the pendulum's ghost */
.sl-cta__arc {
  position: absolute;
  left: -180px;
  bottom: -320px;
  width: 620px;
  aspect-ratio: 1;
  border: 1.5px solid transparent;
  border-top-color: rgba(233, 242, 236, 0.16);
  border-radius: 50%;
  transform: rotate(18deg);
  pointer-events: none;
}
.sl-cta__inner {
  position: relative;
  max-width: 720px;
  margin: 0 auto;
  text-align: left;
}
.sl-cta__title {
  margin: 0;
  font-size: clamp(30px, 4.2vw, 46px);
  font-weight: 800;
  letter-spacing: -0.02em;
  line-height: 1.08;
  color: #fdfcf9;
  text-align: center;
  text-wrap: balance;
}
.sl-cta__sub {
  margin: 16px auto 0;
  font-size: var(--sl-text-lg);
  line-height: 1.55;
  color: rgba(233, 242, 236, 0.8);
  max-width: 48ch;
  text-align: center;
  text-wrap: pretty;
}
.sl-cta__actions {
  width: min(100%, 460px);
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14px;
  margin: 32px auto 0;
}
.sl-cta__ghost {
  background: transparent;
  color: var(--sl-green-ink);
  border-color: rgba(233, 242, 236, 0.55);
}
.sl-cta__ghost:hover {
  background: var(--sl-bg);
  color: var(--sl-green);
  border-color: var(--sl-bg);
}
@media (max-width: 749px) {
  .sl-cta__inner { text-align: center; }
  .sl-cta__sub { text-align: center; }
}
@media (max-width: 479px) {
  .sl-cta__actions { grid-template-columns: 1fr; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "CTA banner",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Your next range session should count." },
    { "type": "textarea", "id": "sub", "label": "Subheading", "default": "Choose the club. Film the view. Work one measured plan. Re‑film by repeating the setup." },
    { "type": "text", "id": "primary_label", "label": "Primary button label", "default": "Analyze a swing free" },
    { "type": "url", "id": "primary_url", "label": "Primary button link" },
    { "type": "text", "id": "secondary_label", "label": "Secondary button label", "default": "Get Pro" },
    { "type": "url", "id": "secondary_url", "label": "Secondary button link" }
  ],
  "presets": [{ "name": "CTA banner" }]
}
{% endschema %}
