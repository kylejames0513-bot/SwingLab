{%- liquid
  assign cart_count = cart.item_count | default: 0
  assign app_url = section.settings.app_url
  assign app_history_url = app_url | append: '/sessions'
  assign app_progress_url = app_url | append: '/progress'
  assign app_drills_url = app_url | append: '/drills'
  assign app_account_url = app_url | append: '/account'
  assign app_login_url = app_url | append: '/login'
  assign app_signup_url = app_url | append: '/signup'
  assign app_session_url = app_url | append: '/auth/storefront/session'
  assign gear_url = routes.collections_url | append: '/swinglab-gear'
  assign pro_product = all_products['swinglab-pro']
  assign premium_header = false
  if request.page_type == 'index'
    assign premium_header = true
  elsif request.page_type == 'product' and product.handle == 'swinglab-pro'
    assign premium_header = true
  endif
  assign method_url = routes.root_url | append: '#how'
  assign sample_url = routes.root_url | append: '#report'
  assign plans_url = routes.root_url | append: '#plans'
  assign plans_link_url = plans_url
  if request.page_type == 'product' and product.handle == 'swinglab-pro'
    assign plans_link_url = product.url
  endif
  assign menu_id = 'sl-mobile-menu-' | append: section.id
  assign menu_title_id = menu_id | append: '-title'
  if cart_count == 1
    assign cart_aria = 'layout.cart.count_one' | t
  else
    assign cart_aria = 'layout.cart.count_other' | t: count: cart_count
  endif
-%}

<header class="sl-header{% if premium_header %} sl-header--premium{% endif %}"
        data-sl-header
        data-menu-id="{{ menu_id }}"
        {% if app_url != blank %}data-app-session-url="{{ app_session_url }}"
        data-app-account-label="{{ 'layout.navigation.account' | t | escape }}"
        data-app-welcome-label="{{ 'layout.navigation.welcome_back' | t | escape }}"
        data-app-signed-in-label="{{ 'layout.navigation.signed_in' | t | escape }}"
        data-app-pro-label="{{ 'layout.navigation.pro_member' | t | escape }}"{% endif %}>
  <div class="sl-header__inner">
    <a href="{{ routes.root_url }}" class="sl-header__logo" aria-label="{{ 'layout.navigation.caddieinsight_home' | t }}">
      {%- assign logo = section.settings.logo | default: images['swinglab-logo.png'] -%}
      {%- if logo -%}
        {{ logo | image_url: width: 480 | image_tag: class: 'sl-header__logo-img', alt: shop.name }}
      {%- else -%}
        {{ section.settings.logo_text | default: shop.name }}
      {%- endif -%}
    </a>

    <nav class="sl-header__desktop-nav" aria-label="{{ 'layout.navigation.main' | t }}">
      {%- if premium_header -%}
        <a href="{{ method_url }}" class="sl-header__link">{{ 'layout.navigation.method' | t }}</a>
        <a href="{{ sample_url }}" class="sl-header__link">{{ 'layout.navigation.sample_report' | t }}</a>
        <a href="{{ plans_link_url }}" class="sl-header__link{% if request.page_type == 'product' and product.handle == 'swinglab-pro' %} is-current{% endif %}"{% if request.page_type == 'product' and product.handle == 'swinglab-pro' %} aria-current="page"{% endif %}>{{ 'layout.navigation.plans' | t }}</a>
        <a href="{{ gear_url }}" class="sl-header__link">{{ 'layout.navigation.gear' | t }}</a>
      {%- else -%}
        {%- if app_url != blank -%}
          <details class="sl-header__dropdown" data-header-dropdown>
            <summary class="sl-header__dropdown-trigger">
              {{ 'layout.navigation.my_game' | t }}
              <span class="sl-header__chevron" aria-hidden="true"></span>
            </summary>
            <div class="sl-header__dropdown-menu">
              <a href="{{ app_history_url }}">{{ 'layout.navigation.history' | t }}</a>
              <a href="{{ app_progress_url }}">{{ 'layout.navigation.progress' | t }}</a>
              <a href="{{ app_drills_url }}">{{ 'layout.navigation.drills' | t }}</a>
            </div>
          </details>
        {%- endif -%}
        <a href="{{ gear_url }}" class="sl-header__link{% if request.page_type == 'collection' and collection.handle == 'swinglab-gear' %} is-current{% endif %}"{% if request.page_type == 'collection' and collection.handle == 'swinglab-gear' %} aria-current="page"{% endif %}>{{ 'layout.navigation.gear' | t }}</a>
        {%- if pro_product != blank -%}
          <a href="{{ pro_product.url }}" class="sl-header__link{% if request.page_type == 'product' and product.handle == 'swinglab-pro' %} is-current{% endif %}"{% if request.page_type == 'product' and product.handle == 'swinglab-pro' %} aria-current="page"{% endif %}>{{ 'layout.navigation.pro' | t }}</a>
        {%- endif -%}
      {%- endif -%}
    </nav>

    <div class="sl-header__actions">
      <details class="sl-header__dropdown sl-header__account" data-header-dropdown>
        <summary class="sl-header__dropdown-trigger">
          <span data-app-auth-summary>{{ 'layout.navigation.account' | t }}</span>
          <span class="sl-header__chevron" aria-hidden="true"></span>
        </summary>
        <div class="sl-header__dropdown-menu sl-header__dropdown-menu--right">
          {%- if app_url != blank -%}
            <div class="sl-app-auth__state" data-app-auth-signed-out>
              <a href="{{ app_login_url }}">{{ 'layout.navigation.app_sign_in' | t }}</a>
              <a href="{{ app_signup_url }}">{{ 'layout.navigation.create_free_account' | t }}</a>
            </div>
            <div class="sl-app-auth__state" data-app-auth-signed-in hidden>
              <span class="sl-app-auth__welcome" data-app-auth-welcome aria-live="polite"></span>
              <a href="{{ app_account_url }}">{{ 'layout.navigation.caddieinsight_profile' | t }}</a>
              {%- if premium_header -%}
                <a href="{{ app_history_url }}">{{ 'layout.navigation.history' | t }}</a>
                <a href="{{ app_progress_url }}">{{ 'layout.navigation.progress' | t }}</a>
                <a href="{{ app_drills_url }}">{{ 'layout.navigation.drills' | t }}</a>
              {%- endif -%}
              <form action="{{ app_session_url }}" method="post">
                <button class="sl-app-auth__logout" type="submit">{{ 'layout.navigation.log_out' | t }}</button>
              </form>
            </div>
          {%- endif -%}
          <a href="{{ routes.account_url }}">{{ 'layout.navigation.orders_subscriptions' | t }}</a>
        </div>
      </details>

      <a href="{{ routes.cart_url }}" class="sl-header__cart"
         aria-label="{{ cart_aria }}"
         data-cart-one="{{ 'layout.cart.count_one' | t }}"
         data-cart-other="{{ 'layout.cart.count_other' | t: count: '__COUNT__' }}">
        <span class="sl-header__cart-label">{{ 'layout.cart.title' | t }}</span>
        <span class="sl-header__cart-count" data-cart-count aria-hidden="true">{{ cart_count }}</span>
      </a>

      {%- if app_url != blank -%}
        <a href="{{ app_url }}" class="sl-header__cta sl-header__app">{% if premium_header %}{{ 'layout.navigation.analyze_free' | t }}{% else %}{{ 'layout.navigation.analyze_a_swing' | t }}{% endif %}</a>
      {%- endif -%}

      <button class="sl-header__toggle" type="button"
              aria-label="{{ 'layout.navigation.menu' | t }}"
              aria-expanded="false"
              aria-haspopup="dialog"
              aria-controls="{{ menu_id }}"
              data-menu-open>
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
</header>

<dialog class="sl-menu" id="{{ menu_id }}" aria-labelledby="{{ menu_title_id }}" data-sl-menu>
  <div class="sl-menu__panel">
    <div class="sl-menu__head">
      <h2 class="sl-menu__title" id="{{ menu_title_id }}">{{ 'layout.navigation.menu_title' | t }}</h2>
      <button class="sl-menu__close" type="button" aria-label="{{ 'layout.navigation.close_menu' | t }}" data-menu-close>
        <span aria-hidden="true"></span>
        <span aria-hidden="true"></span>
      </button>
    </div>

    <nav class="sl-menu__nav" aria-label="{{ 'layout.navigation.main' | t }}">
      {%- if app_url != blank -%}
        <a href="{{ app_url }}" class="sl-header__cta sl-menu__cta" data-menu-link>{% if premium_header %}{{ 'layout.navigation.analyze_free' | t }}{% else %}{{ 'layout.navigation.analyze_a_swing' | t }}{% endif %}</a>
      {%- endif -%}

      {%- if premium_header -%}
        <div class="sl-menu__group">
          <p class="sl-menu__eyebrow">{{ 'layout.navigation.explore' | t }}</p>
          <a href="{{ method_url }}" class="sl-menu__link" data-menu-link>
            <span>{{ 'layout.navigation.method' | t }}</span><span aria-hidden="true">&rarr;</span>
          </a>
          <a href="{{ sample_url }}" class="sl-menu__link" data-menu-link>
            <span>{{ 'layout.navigation.sample_report' | t }}</span><span aria-hidden="true">&rarr;</span>
          </a>
          <a href="{{ plans_link_url }}" class="sl-menu__link{% if request.page_type == 'product' and product.handle == 'swinglab-pro' %} is-current{% endif %}" data-menu-link{% if request.page_type == 'product' and product.handle == 'swinglab-pro' %} aria-current="page"{% endif %}>
            <span>{{ 'layout.navigation.plans' | t }}</span><span aria-hidden="true">&rarr;</span>
          </a>
          <a href="{{ gear_url }}" class="sl-menu__link" data-menu-link>
            <span>{{ 'layout.navigation.gear' | t }}</span><span aria-hidden="true">&rarr;</span>
          </a>
        </div>
      {%- endif -%}

      {%- if app_url != blank -%}
      <div class="sl-menu__group">
        <p class="sl-menu__eyebrow">{{ 'layout.navigation.my_game' | t }}</p>
        <a href="{{ app_history_url }}" class="sl-menu__link" data-menu-link>
          <span>{{ 'layout.navigation.history' | t }}</span><span aria-hidden="true">&rarr;</span>
        </a>
        <a href="{{ app_progress_url }}" class="sl-menu__link" data-menu-link>
          <span>{{ 'layout.navigation.progress' | t }}</span><span aria-hidden="true">&rarr;</span>
        </a>
        <a href="{{ app_drills_url }}" class="sl-menu__link" data-menu-link>
          <span>{{ 'layout.navigation.drills' | t }}</span><span aria-hidden="true">&rarr;</span>
        </a>
      </div>
      {%- endif -%}

      {%- unless premium_header -%}
        <div class="sl-menu__group">
          <p class="sl-menu__eyebrow">{{ 'layout.navigation.shop' | t }}</p>
          <a href="{{ gear_url }}" class="sl-menu__link{% if request.page_type == 'collection' and collection.handle == 'swinglab-gear' %} is-current{% endif %}" data-menu-link{% if request.page_type == 'collection' and collection.handle == 'swinglab-gear' %} aria-current="page"{% endif %}>
            <span>{{ 'layout.navigation.gear' | t }}</span><span aria-hidden="true">&rarr;</span>
          </a>
          {%- if pro_product != blank -%}
            <a href="{{ pro_product.url }}" class="sl-menu__link{% if request.page_type == 'product' and product.handle == 'swinglab-pro' %} is-current{% endif %}" data-menu-link{% if request.page_type == 'product' and product.handle == 'swinglab-pro' %} aria-current="page"{% endif %}>
              <span>{{ 'layout.navigation.pro' | t }}</span><span aria-hidden="true">&rarr;</span>
            </a>
          {%- endif -%}
        </div>
      {%- endunless -%}

      <div class="sl-menu__group">
        <p class="sl-menu__eyebrow">{{ 'layout.navigation.account' | t }}</p>
        {%- if app_url != blank -%}
        <div class="sl-app-auth__state" data-app-auth-signed-out>
          <a href="{{ app_login_url }}" class="sl-menu__link" data-menu-link>
            <span>{{ 'layout.navigation.app_sign_in' | t }}</span><span aria-hidden="true">&rarr;</span>
          </a>
          <a href="{{ app_signup_url }}" class="sl-menu__link" data-menu-link>
            <span>{{ 'layout.navigation.create_free_account' | t }}</span><span aria-hidden="true">&rarr;</span>
          </a>
        </div>
        <div class="sl-app-auth__state" data-app-auth-signed-in hidden>
          <span class="sl-app-auth__welcome" data-app-auth-welcome aria-live="polite"></span>
          <a href="{{ app_account_url }}" class="sl-menu__link" data-menu-link>
            <span>{{ 'layout.navigation.caddieinsight_profile' | t }}</span><span aria-hidden="true">&rarr;</span>
          </a>
          <form action="{{ app_session_url }}" method="post">
            <button class="sl-menu__link sl-app-auth__logout" type="submit">
              <span>{{ 'layout.navigation.log_out' | t }}</span><span aria-hidden="true">&rarr;</span>
            </button>
          </form>
        </div>
        {%- endif -%}
        <a href="{{ routes.account_url }}" class="sl-menu__link" data-menu-link>
          <span>{{ 'layout.navigation.orders_subscriptions' | t }}</span><span aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </nav>
  </div>
</dialog>

{% stylesheet %}
html.sl-menu-open { overflow: hidden; }
.sl-header {
  position: sticky;
  top: 0;
  z-index: 40;
  min-height: 72px;
  padding: 0 var(--sl-pad-x);
  background: rgba(247, 245, 240, 0.94);
  -webkit-backdrop-filter: blur(14px);
  backdrop-filter: blur(14px);
  border-bottom: 1px solid var(--sl-border);
}
@supports not ((-webkit-backdrop-filter: blur(1px)) or (backdrop-filter: blur(1px))) {
  .sl-header { background: var(--sl-bg); }
}
.sl-header__inner {
  width: 100%;
  max-width: 1280px;
  min-height: 72px;
  margin: 0 auto;
  display: flex;
  align-items: center;
  gap: clamp(16px, 2.5vw, 28px);
}
.sl-header__logo {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  color: var(--sl-green);
  font-size: 22px;
  font-weight: 900;
  letter-spacing: -0.02em;
  text-decoration: none;
}
.sl-header__logo-img { display: block; width: auto; height: 38px; }
.sl-header__desktop-nav {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-left: auto;
}
.sl-header__link,
.sl-header__dropdown-trigger {
  min-height: 38px;
  padding: 9px 12px;
  display: inline-flex;
  align-items: center;
  gap: 7px;
  border-radius: 999px;
  color: var(--sl-ink);
  font-size: 14px;
  font-weight: 600;
  line-height: 1;
  text-decoration: none;
  white-space: nowrap;
  cursor: pointer;
}
.sl-header__link:hover,
.sl-header__dropdown-trigger:hover,
.sl-header__dropdown[open] > .sl-header__dropdown-trigger {
  background: var(--sl-bg-card);
  color: var(--sl-green-btn);
}
.sl-header__link.is-current {
  background: var(--sl-orange-soft);
  color: var(--sl-green);
}
.sl-header__dropdown { position: relative; }
.sl-header__dropdown summary { list-style: none; }
.sl-header__dropdown summary::-webkit-details-marker { display: none; }
.sl-header__chevron {
  width: 7px;
  height: 7px;
  border-right: 1.5px solid currentColor;
  border-bottom: 1.5px solid currentColor;
  transform: translateY(-2px) rotate(45deg);
  transition: transform .18s ease;
}
.sl-header__dropdown[open] .sl-header__chevron { transform: translateY(2px) rotate(225deg); }
.sl-header__dropdown-menu {
  position: absolute;
  top: calc(100% + 10px);
  left: 0;
  z-index: 45;
  width: max-content;
  min-width: 210px;
  padding: 8px;
  display: grid;
  gap: 2px;
  background: var(--sl-bg-card);
  border: 1px solid var(--sl-border);
  border-radius: 14px;
  box-shadow: 0 18px 42px -24px rgba(15, 42, 27, 0.42);
}
.sl-header__dropdown-menu--right { right: 0; left: auto; }
.sl-header__dropdown-menu a {
  padding: 10px 12px;
  border-radius: 9px;
  color: var(--sl-ink);
  font-size: 14px;
  font-weight: 600;
  text-decoration: none;
}
.sl-header__dropdown-menu a:hover {
  background: var(--sl-orange-soft);
  color: var(--sl-green);
}
.sl-header__account .sl-header__dropdown-trigger { max-width: 210px; }
[data-app-auth-summary] {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.sl-app-auth__state {
  min-width: 0;
  display: grid;
  gap: 2px;
}
.sl-app-auth__state[hidden] { display: none; }
.sl-app-auth__welcome {
  min-width: 0;
  padding: 8px 12px 6px;
  overflow: hidden;
  color: var(--sl-ink-muted);
  font-family: var(--sl-font-mono);
  font-size: 10px;
  font-weight: 500;
  letter-spacing: .1em;
  text-overflow: ellipsis;
  text-transform: uppercase;
  white-space: nowrap;
}
.sl-header__dropdown-menu .sl-app-auth__logout {
  width: 100%;
  padding: 10px 12px;
  border: 0;
  border-radius: 9px;
  background: transparent;
  color: var(--sl-ink);
  font: inherit;
  font-size: 14px;
  font-weight: 600;
  text-align: left;
  cursor: pointer;
}
.sl-header__dropdown-menu .sl-app-auth__logout:hover {
  background: var(--sl-orange-soft);
  color: var(--sl-green);
}
.sl-header__actions {
  display: flex;
  align-items: center;
  gap: 10px;
  flex-shrink: 0;
}
.sl-header__cta {
  min-height: 40px;
  padding: 7px 16px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border: 1.5px solid var(--sl-green);
  border-radius: 999px;
  background: var(--sl-green);
  color: var(--sl-green-ink);
  font-size: 14px;
  font-weight: 700;
  line-height: 1;
  text-decoration: none;
  white-space: nowrap;
}
.sl-header__cta:hover { background: var(--sl-green-btn); color: #fff; }
.sl-header__app { white-space: nowrap; }
.sl-header__cart {
  min-height: 40px;
  padding: 6px 8px 6px 14px;
  display: inline-flex;
  align-items: center;
  gap: 8px;
  border: 1.5px solid var(--sl-green);
  border-radius: 999px;
  color: var(--sl-green);
  font-size: 14px;
  font-weight: 700;
  line-height: 1;
  text-decoration: none;
  white-space: nowrap;
  transition: border-color .15s ease, color .15s ease;
}
.sl-header__cart:hover { border-color: var(--sl-orange); color: var(--sl-orange); }
.sl-header__cart-count {
  min-width: 22px;
  padding: 5px 6px;
  border-radius: 999px;
  background: var(--sl-green);
  color: var(--sl-green-ink);
  font-family: var(--sl-font-mono);
  font-size: 12px;
  font-weight: 500;
  line-height: 1;
  text-align: center;
}
.sl-header__toggle {
  display: none;
  width: 44px;
  height: 44px;
  padding: 10px;
  flex-direction: column;
  align-items: stretch;
  justify-content: center;
  gap: 5px;
  border: 1.5px solid var(--sl-green);
  border-radius: 50%;
  background: transparent;
  color: var(--sl-green);
  cursor: pointer;
}
.sl-header__toggle span {
  display: block;
  width: 100%;
  height: 2px;
  border-radius: 2px;
  background: currentColor;
}
.sl-menu {
  width: 100vw;
  max-width: none;
  height: 100dvh;
  max-height: none;
  margin: 0;
  padding: 0;
  border: 0;
  background: transparent;
  overflow: hidden;
}
.sl-menu::backdrop { background: rgba(10, 28, 18, 0.46); }
.sl-menu__panel {
  width: min(88vw, 360px);
  height: 100dvh;
  margin-left: auto;
  padding: 20px;
  display: flex;
  flex-direction: column;
  gap: 20px;
  background: var(--sl-bg);
  border-left: 1px solid var(--sl-border);
  overflow-y: auto;
  overscroll-behavior: contain;
  box-shadow: -24px 0 60px -34px rgba(15, 42, 27, 0.55);
}
.sl-menu[open] .sl-menu__panel { animation: sl-menu-in .22s ease-out both; }
@keyframes sl-menu-in {
  from { opacity: .85; transform: translateX(28px); }
  to { opacity: 1; transform: translateX(0); }
}
.sl-menu__head {
  min-height: 44px;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.sl-menu__title {
  margin: 0;
  color: var(--sl-green);
  font-size: 20px;
  font-weight: 800;
  letter-spacing: -0.02em;
}
.sl-menu__close {
  position: relative;
  width: 44px;
  height: 44px;
  border: 1.5px solid var(--sl-border);
  border-radius: 50%;
  background: var(--sl-bg-card);
  color: var(--sl-ink);
  cursor: pointer;
}
.sl-menu__close span {
  position: absolute;
  top: 20px;
  left: 11px;
  width: 20px;
  height: 2px;
  border-radius: 2px;
  background: currentColor;
}
.sl-menu__close span:first-child { transform: rotate(45deg); }
.sl-menu__close span:last-child { transform: rotate(-45deg); }
.sl-menu__nav {
  display: flex;
  flex-direction: column;
  gap: 20px;
}
.sl-menu__cta {
  width: 100%;
  min-height: 48px;
  justify-content: center;
}
.sl-menu__group {
  padding-top: 18px;
  display: grid;
  gap: 2px;
  border-top: 1px solid var(--sl-border);
}
.sl-menu__eyebrow {
  margin: 0 0 7px;
  color: var(--sl-ink-muted);
  font-family: var(--sl-font-mono);
  font-size: 11px;
  font-weight: 500;
  letter-spacing: .12em;
  text-transform: uppercase;
}
.sl-menu__link {
  min-height: 46px;
  padding: 10px 4px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18px;
  border-radius: 8px;
  color: var(--sl-ink);
  font-size: 17px;
  font-weight: 600;
  text-decoration: none;
}
.sl-menu__link:hover { color: var(--sl-green-btn); }
.sl-menu__link.is-current {
  padding-inline: 10px;
  background: var(--sl-orange-soft);
  color: var(--sl-green);
}
.sl-menu__group .sl-app-auth__state { width: 100%; }
.sl-menu__group .sl-app-auth__welcome { padding-inline: 4px; }
.sl-menu__link.sl-app-auth__logout {
  width: 100%;
  border: 0;
  background: transparent;
  font-family: inherit;
  text-align: left;
  cursor: pointer;
}
.sl-header--premium {
  min-height: 76px;
  background: rgba(7, 19, 13, 0.94);
  border-bottom-color: rgba(239, 241, 232, 0.12);
  box-shadow: 0 18px 48px -32px rgba(0, 0, 0, 0.85);
}
.sl-header--premium .sl-header__inner { min-height: 76px; }
.sl-header--premium .sl-header__logo { color: #f5f2e9; }
.sl-header--premium .sl-header__logo-img {
  filter: brightness(0) invert(1);
  opacity: 0.96;
}
.sl-header--premium .sl-header__link,
.sl-header--premium .sl-header__dropdown-trigger {
  color: rgba(245, 242, 233, 0.78);
}
.sl-header--premium .sl-header__link:hover,
