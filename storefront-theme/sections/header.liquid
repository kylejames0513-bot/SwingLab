{%- liquid
  assign cart_count = cart.item_count | default: 0
  assign app_url = section.settings.app_url
  assign app_login_url = app_url | append: '/login'
  assign app_signup_url = app_url | append: '/signup'
  assign gear_url = routes.collections_url | append: '/swinglab-gear'
  assign pro_product = all_products['swinglab-pro']
  if cart_count == 1
    assign cart_aria = 'layout.cart.count_one' | t
  else
    assign cart_aria = 'layout.cart.count_other' | t: count: cart_count
  endif
-%}
<header class="sl-header" data-sl-header>
  <a href="{{ routes.root_url }}" class="sl-header__logo" aria-label="{{ 'layout.navigation.caddieinsight_home' | t }}">
    {%- assign logo = section.settings.logo | default: images['swinglab-logo.png'] -%}
    {%- if logo -%}
      {{ logo | image_url: width: 480 | image_tag: class: 'sl-header__logo-img', alt: shop.name }}
    {%- else -%}
      {{ section.settings.logo_text | default: shop.name }}
    {%- endif -%}
  </a>

  <nav class="sl-header__nav" id="sl-nav" aria-label="{{ 'layout.navigation.main' | t }}">
    <a href="{{ routes.root_url }}" class="sl-header__link{% if request.page_type == 'index' %} is-current{% endif %}"{% if request.page_type == 'index' %} aria-current="page"{% endif %}>{{ 'layout.navigation.home' | t }}</a>
    {%- if app_url != blank -%}
      <a href="{{ app_url }}" class="sl-header__link">{{ 'layout.navigation.analyze' | t }}</a>
    {%- endif -%}
    <a href="{{ gear_url }}" class="sl-header__link{% if request.page_type == 'collection' and collection.handle == 'swinglab-gear' %} is-current{% endif %}"{% if request.page_type == 'collection' and collection.handle == 'swinglab-gear' %} aria-current="page"{% endif %}>{{ 'layout.navigation.gear' | t }}</a>
    {%- if pro_product != blank -%}
      <a href="{{ pro_product.url }}" class="sl-header__link{% if request.page_type == 'product' and product.handle == 'swinglab-pro' %} is-current{% endif %}"{% if request.page_type == 'product' and product.handle == 'swinglab-pro' %} aria-current="page"{% endif %}>{{ 'layout.navigation.pro' | t }}</a>
    {%- endif -%}
    {%- if app_url != blank -%}
      <a href="{{ app_login_url }}" class="sl-header__link sl-header__mobile-only">{{ 'layout.navigation.app_sign_in' | t }}</a>
      <a href="{{ app_signup_url }}" class="sl-header__link sl-header__mobile-only">{{ 'layout.navigation.create_free_account' | t }}</a>
    {%- endif -%}
    <a href="{{ routes.account_url }}" class="sl-header__link sl-header__mobile-only">{{ 'layout.navigation.orders' | t }}</a>
    <a href="{{ routes.cart_url }}" class="sl-header__link sl-header__mobile-only">{{ 'layout.cart.title' | t }} ({{ cart_count }})</a>
  </nav>

  <div class="sl-header__actions">
    <a href="{{ routes.account_url }}" class="sl-header__signin">{{ 'layout.navigation.orders' | t }}</a>
    {%- if app_url != blank -%}
      <a href="{{ app_login_url }}" class="sl-header__signin">{{ 'layout.navigation.app_sign_in' | t }}</a>
      <a href="{{ app_signup_url }}" class="sl-btn sl-btn--sm sl-btn--primary sl-header__app">{{ 'layout.navigation.start_free' | t }}</a>
    {%- endif -%}
    <a href="{{ routes.cart_url }}" class="sl-header__cart"
       aria-label="{{ cart_aria }}"
       data-cart-one="{{ 'layout.cart.count_one' | t }}"
       data-cart-other="{{ 'layout.cart.count_other' | t: count: '__COUNT__' }}">
      <span class="sl-header__cart-label">{{ 'layout.cart.title' | t }}</span>
      <span class="sl-header__cart-count" data-cart-count aria-hidden="true">{{ cart_count }}</span>
    </a>
    <button class="sl-header__toggle" type="button" aria-label="{{ 'layout.navigation.menu' | t }}" aria-expanded="false" aria-controls="sl-nav" data-nav-toggle>
      <span></span><span></span><span></span>
    </button>
  </div>
</header>

{% stylesheet %}
.sl-header {
  position: sticky;
  top: 0;
  z-index: 40;
  display: flex;
  align-items: center;
  gap: clamp(16px, 3vw, 32px);
  height: 72px;
  padding: 0 var(--sl-pad-x);
  background: rgba(247, 245, 240, 0.82);
  -webkit-backdrop-filter: blur(12px);
  backdrop-filter: blur(12px);
  border-bottom: 1px solid var(--sl-border);
}
@supports not ((-webkit-backdrop-filter: blur(1px)) or (backdrop-filter: blur(1px))) {
  .sl-header { background: var(--sl-bg); }
}
.sl-header__logo {
  font-weight: 900;
  font-size: 22px;
  letter-spacing: -0.02em;
  color: var(--sl-green);
  text-decoration: none;
  display: flex;
  align-items: center;
  flex-shrink: 0;
}
.sl-header__logo-img { height: 38px; width: auto; display: block; }
.sl-header__nav {
  display: flex;
  gap: clamp(18px, 2.4vw, 30px);
  align-items: center;
  margin-left: auto;
}
.sl-header__link {
  color: var(--sl-ink);
  text-decoration: none;
  font-size: 15px;
  font-weight: 500;
  padding: 4px 0;
}
.sl-header__link:hover { color: var(--sl-green-btn); }
.sl-header__link.is-current {
  color: var(--sl-green);
  font-weight: 700;
  box-shadow: inset 0 -2px 0 var(--sl-orange);
}
.sl-header__mobile-only { display: none; }
.sl-header__actions {
  display: flex;
  align-items: center;
  gap: 12px;
  flex-shrink: 0;
}
.sl-header__app { white-space: nowrap; }
.sl-header__signin {
  color: var(--sl-ink);
  font-size: 14px;
  font-weight: 600;
  text-decoration: none;
  white-space: nowrap;
}
.sl-header__signin:hover { color: var(--sl-green-btn); }
.sl-header__cart {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  color: var(--sl-ink);
  text-decoration: none;
  font-size: 14px;
  font-weight: 600;
  border: 1.5px solid var(--sl-ink);
  border-radius: 999px;
  padding: 6px 8px 6px 15px;
  white-space: nowrap;
  transition: border-color .15s ease, color .15s ease;
}
.sl-header__cart:hover { border-color: var(--sl-green-btn); color: var(--sl-green-btn); }
.sl-header__cart-count {
  font-family: var(--sl-font-mono);
  font-size: 12px;
  font-weight: 500;
  line-height: 1;
  min-width: 22px;
  text-align: center;
  background: var(--sl-green);
  color: var(--sl-green-ink);
  border-radius: 999px;
  padding: 5px 6px;
}
.sl-header__toggle {
  display: none;
  flex-direction: column;
  justify-content: center;
  gap: 5px;
  width: 42px;
  height: 42px;
  background: none;
  border: 0;
  cursor: pointer;
  padding: 9px;
}
.sl-header__toggle span {
  display: block;
  height: 2px;
  width: 100%;
  background: var(--sl-ink);
  border-radius: 2px;
  transition: transform .2s ease, opacity .2s ease;
}
.sl-header__toggle[aria-expanded="true"] span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
.sl-header__toggle[aria-expanded="true"] span:nth-child(2) { opacity: 0; }
.sl-header__toggle[aria-expanded="true"] span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }
@media (prefers-reduced-motion: reduce) {
  .sl-header__toggle span { transition: none; }
}

@media (max-width: 980px) {
  .sl-header__toggle { display: flex; }
  .sl-header__nav {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    display: none;
    flex-direction: column;
    align-items: flex-start;
    gap: 2px;
    margin: 0;
    padding: 8px var(--sl-pad-x) 24px;
    background: var(--sl-bg);
    border-bottom: 1px solid var(--sl-border);
    box-shadow: 0 18px 30px -18px rgba(15, 42, 27, 0.25);
  }
  .sl-header__nav.is-open { display: flex; }
  .sl-header__link { font-size: 17px; padding: 12px 0; width: 100%; }
  .sl-header__link.is-current { box-shadow: none; color: var(--sl-orange); }
  .sl-header__mobile-only { display: block; }
  .sl-header__actions .sl-header__signin,
  .sl-header__actions .sl-header__app { display: none; }
  .sl-header__cart { padding: 5px 8px 5px 12px; }
}
@media (max-width: 480px) {
  .sl-header { height: 64px; gap: 10px; }
  .sl-header__logo-img { height: 26px; max-width: 165px; object-fit: contain; }
  .sl-header__logo { font-size: 18px; }
}
@media (max-width: 360px) {
  .sl-header { gap: 6px; padding-inline: 12px; }
  .sl-header__actions { gap: 6px; }
  .sl-header__logo-img { height: 22px; max-width: 132px; }
  .sl-header__cart { padding: 4px; }
  .sl-header__cart-label { display: none; }
}
{% endstylesheet %}

<script>
  (function () {
    var header = document.querySelector('[data-sl-header]');
    if (!header) return;
    var btn = header.querySelector('[data-nav-toggle]');
    var nav = header.querySelector('#sl-nav');

    function setOpen(open) {
      nav.classList.toggle('is-open', open);
      btn.setAttribute('aria-expanded', open ? 'true' : 'false');
    }

    if (btn && nav) {
      btn.addEventListener('click', function () {
        setOpen(!nav.classList.contains('is-open'));
      });
      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && nav.classList.contains('is-open')) {
          setOpen(false);
          btn.focus();
        }
      });
      document.addEventListener('click', function (e) {
        if (nav.classList.contains('is-open') && !header.contains(e.target)) setOpen(false);
      });
    }

    /* live cart count: refreshed on back/forward-cache restores, and on a
       "cart:change" event any section may dispatch after a fetch add-to-cart
       (detail.item_count optional — omitted means re-fetch) */
    var count = header.querySelector('[data-cart-count]');
    var cartLink = count && count.closest('.sl-header__cart');
    function setCount(value) {
      if (!count || !cartLink) return;
      var number = Number(value) || 0;
      count.textContent = number;
      var label = number === 1
        ? cartLink.getAttribute('data-cart-one')
        : cartLink.getAttribute('data-cart-other').replace('__COUNT__', number);
      cartLink.setAttribute('aria-label', label);
    }
    function refreshCount() {
      fetch('{{ routes.cart_url }}.js', { headers: { 'Accept': 'application/json' } })
        .then(function (r) { return r.ok ? r.json() : null; })
        .then(function (c) { if (c) setCount(c.item_count); })
        .catch(function () {});
    }
    window.addEventListener('pageshow', function (e) { if (e.persisted) refreshCount(); });
    document.addEventListener('cart:change', function (e) {
      if (e.detail && typeof e.detail.item_count !== 'undefined' && count) {
        setCount(e.detail.item_count);
      } else {
        refreshCount();
      }
    });
  })();
</script>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo image",
      "info": "Defaults to the swinglab-logo.png file already in Content → Files."
    },
    {
      "type": "text",
      "id": "logo_text",
      "label": "Logo wordmark (fallback)",
      "default": "CADDIEINSIGHT"
    },
    {
      "type": "text",
      "id": "app_url",
      "label": "App URL",
      "default": "https://app.caddieinsight.com",
      "info": "Analyze, sign-in, and free-account links use this origin. Leave empty to hide app links."
    }
  ]
}
{% endschema %}
