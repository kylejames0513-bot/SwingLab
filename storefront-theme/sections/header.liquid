<script>
  (function () {
    if (window.CaddieInsightHeader) {
      window.CaddieInsightHeader.init(document);
      return;
    }

    function findHeaders(root) {
      var headers = [];
      if (root && root.matches && root.matches('[data-sl-header]')) headers.push(root);
      if (root && root.querySelectorAll) {
        var descendants = root.querySelectorAll('[data-sl-header]');
        for (var i = 0; i < descendants.length; i++) headers.push(descendants[i]);
      }
      return headers;
    }

    function initHeader(header) {
      if (!header || header.dataset.slHeaderReady === 'true') return;

      var menu = document.getElementById(header.getAttribute('data-menu-id'));
      var openButton = header.querySelector('[data-menu-open]');
      if (!menu || !openButton) return;

      var controller = new AbortController();
      var listenerOptions = { signal: controller.signal };
      var closeButton = menu.querySelector('[data-menu-close]');
      var menuLinks = menu.querySelectorAll('[data-menu-link]');
      var desktopMenus = header.querySelectorAll('[data-header-dropdown]');
      var desktopQuery = window.matchMedia('(min-width: 981px)');
      var restoreMenuFocus = false;

      function finishMenuClose() {
        openButton.setAttribute('aria-expanded', 'false');
        document.documentElement.classList.remove('sl-menu-open');
        if (restoreMenuFocus && document.contains(openButton)) openButton.focus();
        restoreMenuFocus = false;
      }

      function closeMenu(restoreFocus) {
        if (!menu.hasAttribute('open')) return;
        restoreMenuFocus = restoreFocus;
        if (typeof menu.close === 'function') {
          menu.close();
        } else {
          menu.removeAttribute('open');
          finishMenuClose();
        }
      }

      function openMenu() {
        if (menu.hasAttribute('open')) return;
        if (typeof menu.showModal === 'function') {
          menu.showModal();
        } else {
          menu.setAttribute('open', '');
        }
        openButton.setAttribute('aria-expanded', 'true');
        document.documentElement.classList.add('sl-menu-open');
        if (closeButton) closeButton.focus();
      }

      function closeDesktopMenus() {
        for (var i = 0; i < desktopMenus.length; i++) {
          desktopMenus[i].removeAttribute('open');
        }
      }

      function closeOnBreakpointChange(event) {
        closeDesktopMenus();
        if (event.matches) closeMenu(false);
      }

      function setCount(value) {
        var count = header.querySelector('[data-cart-count]');
        var cartLink = count && count.closest('.sl-header__cart');
        if (!count || !cartLink) return;
        var number = Number(value) || 0;
        count.textContent = number;
        var label = number === 1
          ? cartLink.getAttribute('data-cart-one')
          : cartLink.getAttribute('data-cart-other').replace('__COUNT__', number);
        cartLink.setAttribute('aria-label', label);
      }

      function refreshCount() {
        fetch('{{ routes.cart_url }}.js', { headers: { 'Accept': 'application/json' } })
          .then(function (response) { return response.ok ? response.json() : null; })
          .then(function (cart) { if (cart) setCount(cart.item_count); })
          .catch(function () {});
      }

      function eachAppAuthNode(selector, callback) {
        var roots = [header, menu];
        for (var rootIndex = 0; rootIndex < roots.length; rootIndex++) {
          var nodes = roots[rootIndex].querySelectorAll(selector);
          for (var nodeIndex = 0; nodeIndex < nodes.length; nodeIndex++) {
            callback(nodes[nodeIndex]);
          }
        }
      }

      function setAppAuthState(payload) {
        var authenticated = Boolean(payload && payload.authenticated === true);
        var displayName = authenticated && typeof payload.display_name === 'string'
          ? payload.display_name.trim()
          : '';
        var summary = header.querySelector('[data-app-auth-summary]');
        var accountLabel = header.getAttribute('data-app-account-label')
          || (summary ? summary.textContent.trim() : '');
        var welcomeLabel = header.getAttribute('data-app-welcome-label') || accountLabel;
        var signedInLabel = header.getAttribute('data-app-signed-in-label') || accountLabel;
        var proLabel = header.getAttribute('data-app-pro-label') || '';
        var welcomeText = displayName ? welcomeLabel + ', ' + displayName : signedInLabel;
        if (authenticated && payload.is_pro === true && proLabel) {
          welcomeText += ' · ' + proLabel;
        }

        eachAppAuthNode('[data-app-auth-signed-out]', function (node) {
          node.hidden = authenticated;
        });
        eachAppAuthNode('[data-app-auth-signed-in]', function (node) {
          node.hidden = !authenticated;
        });
        eachAppAuthNode('[data-app-auth-welcome]', function (node) {
          node.textContent = authenticated ? welcomeText : '';
        });

        if (summary) {
          summary.textContent = authenticated
            ? (displayName ? welcomeLabel + ', ' + displayName : signedInLabel)
            : accountLabel;
        }
        header.dataset.appAuthenticated = authenticated ? 'true' : 'false';
      }

      function refreshAppSession() {
        var sessionUrl = header.getAttribute('data-app-session-url');
        if (!sessionUrl) return;
        fetch(sessionUrl, {
          cache: 'no-store',
          credentials: 'include',
          headers: { 'Accept': 'application/json' },
          signal: controller.signal
        })
          .then(function (response) {
            if (!response.ok) throw new Error('App session is unavailable.');
            return response.json();
          })
          .then(setAppAuthState)
          .catch(function (error) {
            if (error && error.name === 'AbortError') return;
          });
      }

      openButton.addEventListener('click', openMenu, listenerOptions);
      if (closeButton) {
        closeButton.addEventListener('click', function () { closeMenu(true); }, listenerOptions);
      }
      menu.addEventListener('cancel', function (event) {
        event.preventDefault();
        closeMenu(true);
      }, listenerOptions);
      menu.addEventListener('close', finishMenuClose, listenerOptions);
      menu.addEventListener('click', function (event) {
        if (event.target === menu) closeMenu(true);
      }, listenerOptions);
      for (var i = 0; i < menuLinks.length; i++) {
        menuLinks[i].addEventListener('click', function () { closeMenu(false); }, listenerOptions);
      }
      desktopQuery.addEventListener('change', closeOnBreakpointChange, listenerOptions);

      for (var j = 0; j < desktopMenus.length; j++) {
        desktopMenus[j].addEventListener('toggle', function (event) {
          if (!event.currentTarget.open) return;
          for (var k = 0; k < desktopMenus.length; k++) {
            if (desktopMenus[k] !== event.currentTarget) desktopMenus[k].removeAttribute('open');
          }
        }, listenerOptions);
        desktopMenus[j].addEventListener('focusout', function (event) {
          if (!event.currentTarget.contains(event.relatedTarget)) {
            event.currentTarget.removeAttribute('open');
          }
        }, listenerOptions);
      }
      document.addEventListener('click', function (event) {
        for (var i = 0; i < desktopMenus.length; i++) {
          if (!desktopMenus[i].contains(event.target)) desktopMenus[i].removeAttribute('open');
        }
      }, listenerOptions);
      document.addEventListener('keydown', function (event) {
        if (event.key !== 'Escape') return;
        for (var i = 0; i < desktopMenus.length; i++) {
          if (!desktopMenus[i].hasAttribute('open')) continue;
          desktopMenus[i].removeAttribute('open');
          var summary = desktopMenus[i].querySelector('summary');
          if (summary) summary.focus();
        }
      }, listenerOptions);
      window.addEventListener('pageshow', function (event) {
        if (event.persisted) {
          refreshCount();
          refreshAppSession();
        }
      }, listenerOptions);
      document.addEventListener('cart:change', function (event) {
        if (event.detail && typeof event.detail.item_count !== 'undefined') {
          setCount(event.detail.item_count);
        } else {
          refreshCount();
        }
      }, listenerOptions);

      refreshAppSession();

      header.dataset.slHeaderReady = 'true';
      header.slHeaderCleanup = function () {
        closeMenu(false);
        closeDesktopMenus();
        controller.abort();
        document.documentElement.classList.remove('sl-menu-open');
        delete header.dataset.slHeaderReady;
        delete header.slHeaderCleanup;
      };
    }

    function init(root) {
      var headers = findHeaders(root);
      for (var i = 0; i < headers.length; i++) initHeader(headers[i]);
    }

    function unload(root) {
      var headers = findHeaders(root);
      for (var i = 0; i < headers.length; i++) {
        if (headers[i].slHeaderCleanup) headers[i].slHeaderCleanup();
      }
    }

    window.CaddieInsightHeader = { init: init, unload: unload };
    init(document);
    document.addEventListener('shopify:section:load', function (event) { init(event.target); });
    document.addEventListener('shopify:section:unload', function (event) { unload(event.target); });
  })();
</script>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo image",
      "info": "Defaults to the swinglab-logo.png file already in Content → Files."
    },
    {
      "type": "text",
      "id": "logo_text",
      "label": "Logo wordmark (fallback)",
      "default": "CADDIEINSIGHT"
    },
    {
      "type": "text",
      "id": "app_url",
      "label": "App URL",
      "default": "https://app.caddieinsight.com",
      "info": "Analyze and My Game links use this origin. Leave empty to hide app links."
    }
  ]
}
{% endschema %}
