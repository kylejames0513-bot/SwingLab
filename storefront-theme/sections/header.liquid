{%- liquid
  assign cart_count = cart.item_count | default: 0
  assign app_url = section.settings.app_url
  assign app_history_url = app_url | append: '/sessions'
  assign app_progress_url = app_url | append: '/progress'
  assign app_drills_url = app_url | append: '/drills'
  assign app_account_url = app_url | append: '/account'
  assign app_login_url = app_url | append: '/login'
  assign app_signup_url = app_url | append: '/signup'
  assign app_session_url = app_url | append: '/auth/storefront/session'
  assign gear_url = routes.collections_url | append: '/swinglab-gear'
  assign pro_product = all_products['swinglab-pro']
  assign premium_header = false
  assign overlay_header = false
  if request.page_type == 'index'
    assign premium_header = true
    assign overlay_header = true
  elsif request.page_type == 'product' and product.handle == 'swinglab-pro'
    assign premium_header = true
  endif
  assign app_action_label = 'layout.navigation.analyze_a_swing' | t
  assign app_action_url = app_url
  if premium_header
    assign app_action_label = 'layout.navigation.analyze_free' | t
    assign app_action_url = app_signup_url
  endif
  assign method_url = routes.root_url | append: '#how'
  assign sample_url = routes.root_url | append: '#report'
  assign plans_url = routes.root_url | append: '#plans'
  assign plans_link_url = plans_url
  if request.page_type == 'product' and product.handle == 'swinglab-pro'
    assign plans_link_url = product.url
  endif
  assign menu_id = 'sl-mobile-menu-' | append: section.id
  assign menu_title_id = menu_id | append: '-title'
  if cart_count == 1
    assign cart_aria = 'layout.cart.count_one' | t
  else
    assign cart_aria = 'layout.cart.count_other' | t: count: cart_count
  endif
-%}

<header class="sl-header{% if premium_header %} sl-header--premium{% endif %}{% if overlay_header %} sl-header--overlay{% endif %}"
        data-sl-header
        data-menu-id="{{ menu_id }}"
        {% if app_url != blank %}data-app-session-url="{{ app_session_url }}"
        data-app-url="{{ app_url }}"
        data-app-account-label="{{ 'layout.navigation.account' | t | escape_once }}"
        data-app-welcome-label="{{ 'layout.navigation.welcome_back' | t | escape_once }}"
        data-app-signed-in-label="{{ 'layout.navigation.signed_in' | t | escape_once }}"
        data-app-pro-label="{{ 'layout.navigation.pro_member' | t | escape_once }}"
        data-app-free-label="{{ 'layout.navigation.free_plan' | t | escape_once }}"
        data-app-ready-label="{{ 'layout.navigation.game_plan_ready' | t | escape_once }}"
        data-app-analyze-label="{{ 'layout.navigation.analyze_a_swing' | t | escape_once }}"
        data-app-member-action-label="{{ 'layout.navigation.open_game_plan' | t | escape_once }}"
        data-app-pro-action-label="{{ 'layout.navigation.work_on_your_swing' | t | escape_once }}"{% endif %}>
  {%- if request.page_type == 'index' and app_url != blank -%}
    <aside class="sl-member-rail" data-app-member-rail data-app-pro="false" role="status" aria-label="{{ 'layout.navigation.membership_status' | t }}" aria-live="polite" aria-atomic="true" hidden>
      <div class="sl-member-rail__inner">
        <span class="sl-member-rail__dot" aria-hidden="true"></span>
        <span class="sl-member-rail__tier" data-app-member-tier></span>
        <span class="sl-member-rail__greeting" data-app-member-greeting></span>
        <a class="sl-member-rail__action" href="{{ app_url }}" data-app-member-action></a>
      </div>
    </aside>
  {%- endif -%}
  <div class="sl-header__inner">
    <a href="{{ routes.root_url }}" class="sl-header__logo" aria-label="{{ 'layout.navigation.caddieinsight_home' | t }}">
      {%- comment -%}
        Prefer the theme-packaged lockup so a revamp ships with the theme zip.
        Merchants can still override via the section logo picker; Shopify Files
        remain available as a secondary fallback for older installs.
      {%- endcomment -%}
      {%- if section.settings.logo != blank -%}
        {{ section.settings.logo | image_url: width: 480 | image_tag: class: 'sl-header__logo-img', alt: shop.name }}
      {%- else -%}
        <img
          class="sl-header__logo-img"
          src="{{ 'caddieinsight-logo.png' | asset_url }}"
          width="280"
          height="40"
          alt="{{ shop.name | escape }}"
          loading="eager"
          decoding="async">
      {%- endif -%}
    </a>

    <nav class="sl-header__desktop-nav" aria-label="{{ 'layout.navigation.main' | t }}">
      {%- if premium_header -%}
        <a href="{{ method_url }}" class="sl-header__link">{{ 'layout.navigation.method' | t }}</a>
        <a href="{{ sample_url }}" class="sl-header__link">{{ 'layout.navigation.sample_report' | t }}</a>
        <a href="{{ plans_link_url }}" class="sl-header__link{% if request.page_type == 'product' and product.handle == 'swinglab-pro' %} is-current{% endif %}" data-app-pro-sales-link{% if request.page_type == 'product' and product.handle == 'swinglab-pro' %} aria-current="page"{% endif %}>{{ 'layout.navigation.plans' | t }}</a>
        <a href="{{ gear_url }}" class="sl-header__link">{{ 'layout.navigation.gear' | t }}</a>
      {%- else -%}
        {%- if app_url != blank -%}
          <details class="sl-header__dropdown" data-header-dropdown>
            <summary class="sl-header__dropdown-trigger">
              {{ 'layout.navigation.my_game' | t }}
              <span class="sl-header__chevron" aria-hidden="true"></span>
            </summary>
            <div class="sl-header__dropdown-menu">
              <a href="{{ app_history_url }}">{{ 'layout.navigation.history' | t }}</a>
              <a href="{{ app_progress_url }}">{{ 'layout.navigation.progress' | t }}</a>
              <a href="{{ app_drills_url }}">{{ 'layout.navigation.drills' | t }}</a>
            </div>
          </details>
        {%- endif -%}
        <a href="{{ gear_url }}" class="sl-header__link{% if request.page_type == 'collection' and collection.handle == 'swinglab-gear' %} is-current{% endif %}"{% if request.page_type == 'collection' and collection.handle == 'swinglab-gear' %} aria-current="page"{% endif %}>{{ 'layout.navigation.gear' | t }}</a>
        {%- if pro_product != blank -%}
          <a href="{{ pro_product.url }}" class="sl-header__link{% if request.page_type == 'product' and product.handle == 'swinglab-pro' %} is-current{% endif %}" data-app-pro-sales-link{% if request.page_type == 'product' and product.handle == 'swinglab-pro' %} aria-current="page"{% endif %}>{{ 'layout.navigation.pro' | t }}</a>
        {%- endif -%}
      {%- endif -%}
    </nav>

    <div class="sl-header__actions">
      <a href="{{ routes.search_url }}" class="sl-header__search" aria-label="{{ 'layout.navigation.search' | t }}">
        <svg viewBox="0 0 20 20" width="17" height="17" fill="none" aria-hidden="true" focusable="false">
          <circle cx="8.5" cy="8.5" r="5.75" stroke="currentColor" stroke-width="1.8"></circle>
          <path d="m12.9 12.9 4.1 4.1" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
        </svg>
      </a>

      <details class="sl-header__dropdown sl-header__account" data-header-dropdown>
        <summary class="sl-header__dropdown-trigger">
          <span data-app-auth-summary>{{ 'layout.navigation.account' | t }}</span>
          <span class="sl-header__chevron" aria-hidden="true"></span>
        </summary>
        <div class="sl-header__dropdown-menu sl-header__dropdown-menu--right">
          {%- if app_url != blank -%}
            <div class="sl-app-auth__state" data-app-auth-signed-out>
              <a href="{{ app_login_url }}">{{ 'layout.navigation.app_sign_in' | t }}</a>
              <a href="{{ app_signup_url }}">{{ 'layout.navigation.create_free_account' | t }}</a>
            </div>
            <div class="sl-app-auth__state" data-app-auth-signed-in hidden>
              <span class="sl-app-auth__welcome" data-app-auth-welcome></span>
              <a href="{{ app_account_url }}">{{ 'layout.navigation.caddieinsight_profile' | t }}</a>
              {%- if premium_header -%}
                <a href="{{ app_history_url }}">{{ 'layout.navigation.history' | t }}</a>
                <a href="{{ app_progress_url }}">{{ 'layout.navigation.progress' | t }}</a>
                <a href="{{ app_drills_url }}">{{ 'layout.navigation.drills' | t }}</a>
              {%- endif -%}
              <form action="{{ app_session_url }}" method="post">
                <button class="sl-app-auth__logout" type="submit">{{ 'layout.navigation.log_out' | t }}</button>
              </form>
            </div>
          {%- endif -%}
          <a href="{{ routes.account_url }}">{{ 'layout.navigation.orders_subscriptions' | t }}</a>
        </div>
      </details>

      <a href="{{ routes.cart_url }}" class="sl-header__cart"
         aria-label="{{ cart_aria }}"
         data-cart-one="{{ 'layout.cart.count_one' | t }}"
         data-cart-other="{{ 'layout.cart.count_other' | t: count: '__COUNT__' }}">
        <span class="sl-header__cart-label">{{ 'layout.cart.title' | t }}</span>
        <span class="sl-header__cart-count" data-cart-count aria-hidden="true">{{ cart_count }}</span>
      </a>

      {%- if app_url != blank -%}
        <a href="{{ app_action_url }}" class="sl-header__cta sl-header__app" data-app-primary-cta data-app-signed-out-label="{{ app_action_label | escape_once }}" data-app-signed-out-url="{{ app_action_url }}">{{ app_action_label }}</a>
      {%- endif -%}

      <button class="sl-header__toggle" type="button"
              aria-label="{{ 'layout.navigation.menu' | t }}"
              aria-expanded="false"
              aria-haspopup="dialog"
              aria-controls="{{ menu_id }}"
              data-menu-open>
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
</header>

<dialog class="sl-menu" id="{{ menu_id }}" aria-labelledby="{{ menu_title_id }}" data-sl-menu>
  <div class="sl-menu__panel">
    <div class="sl-menu__head">
      <p class="sl-menu__title" id="{{ menu_title_id }}">{{ 'layout.navigation.menu_title' | t }}</p>
      <button class="sl-menu__close" type="button" aria-label="{{ 'layout.navigation.close_menu' | t }}" data-menu-close>
        <span aria-hidden="true"></span>
        <span aria-hidden="true"></span>
      </button>
    </div>

    <nav class="sl-menu__nav" aria-label="{{ 'layout.navigation.main' | t }}">
      {%- if app_url != blank -%}
        <a href="{{ app_action_url }}" class="sl-header__cta sl-menu__cta" data-app-primary-cta data-app-signed-out-label="{{ app_action_label | escape_once }}" data-app-signed-out-url="{{ app_action_url }}" data-menu-link>{{ app_action_label }}</a>
      {%- endif -%}

      {%- if premium_header -%}
        <div class="sl-menu__group">
          <p class="sl-menu__eyebrow">{{ 'layout.navigation.explore' | t }}</p>
          <a href="{{ method_url }}" class="sl-menu__link" data-menu-link>
            <span>{{ 'layout.navigation.method' | t }}</span><span aria-hidden="true">&rarr;</span>
          </a>
          <a href="{{ sample_url }}" class="sl-menu__link" data-menu-link>
            <span>{{ 'layout.navigation.sample_report' | t }}</span><span aria-hidden="true">&rarr;</span>
          </a>
          <a href="{{ plans_link_url }}" class="sl-menu__link{% if request.page_type == 'product' and product.handle == 'swinglab-pro' %} is-current{% endif %}" data-app-pro-sales-link data-menu-link{% if request.page_type == 'product' and product.handle == 'swinglab-pro' %} aria-current="page"{% endif %}>
            <span>{{ 'layout.navigation.plans' | t }}</span><span aria-hidden="true">&rarr;</span>
          </a>
          <a href="{{ gear_url }}" class="sl-menu__link" data-menu-link>
            <span>{{ 'layout.navigation.gear' | t }}</span><span aria-hidden="true">&rarr;</span>
          </a>
          <a href="{{ routes.search_url }}" class="sl-menu__link" data-menu-link>
            <span>{{ 'layout.navigation.search' | t }}</span><span aria-hidden="true">&rarr;</span>
          </a>
        </div>
      {%- endif -%}

      {%- if app_url != blank -%}
      <div class="sl-menu__group">
        <p class="sl-menu__eyebrow">{{ 'layout.navigation.my_game' | t }}</p>
        <a href="{{ app_history_url }}" class="sl-menu__link" data-menu-link>
          <span>{{ 'layout.navigation.history' | t }}</span><span aria-hidden="true">&rarr;</span>
        </a>
        <a href="{{ app_progress_url }}" class="sl-menu__link" data-menu-link>
          <span>{{ 'layout.navigation.progress' | t }}</span><span aria-hidden="true">&rarr;</span>
        </a>
        <a href="{{ app_drills_url }}" class="sl-menu__link" data-menu-link>
          <span>{{ 'layout.navigation.drills' | t }}</span><span aria-hidden="true">&rarr;</span>
        </a>
      </div>
      {%- endif -%}

      {%- unless premium_header -%}
        <div class="sl-menu__group">
          <p class="sl-menu__eyebrow">{{ 'layout.navigation.shop' | t }}</p>
          <a href="{{ gear_url }}" class="sl-menu__link{% if request.page_type == 'collection' and collection.handle == 'swinglab-gear' %} is-current{% endif %}" data-menu-link{% if request.page_type == 'collection' and collection.handle == 'swinglab-gear' %} aria-current="page"{% endif %}>
            <span>{{ 'layout.navigation.gear' | t }}</span><span aria-hidden="true">&rarr;</span>
          </a>
          {%- if pro_product != blank -%}
            <a href="{{ pro_product.url }}" class="sl-menu__link{% if request.page_type == 'product' and product.handle == 'swinglab-pro' %} is-current{% endif %}" data-app-pro-sales-link data-menu-link{% if request.page_type == 'product' and product.handle == 'swinglab-pro' %} aria-current="page"{% endif %}>
              <span>{{ 'layout.navigation.pro' | t }}</span><span aria-hidden="true">&rarr;</span>
            </a>
          {%- endif -%}
          <a href="{{ routes.search_url }}" class="sl-menu__link" data-menu-link>
            <span>{{ 'layout.navigation.search' | t }}</span><span aria-hidden="true">&rarr;</span>
          </a>
        </div>
      {%- endunless -%}

      <div class="sl-menu__group">
        <p class="sl-menu__eyebrow">{{ 'layout.navigation.account' | t }}</p>
        {%- if app_url != blank -%}
        <div class="sl-app-auth__state" data-app-auth-signed-out>
          <a href="{{ app_login_url }}" class="sl-menu__link" data-menu-link>
            <span>{{ 'layout.navigation.app_sign_in' | t }}</span><span aria-hidden="true">&rarr;</span>
          </a>
          <a href="{{ app_signup_url }}" class="sl-menu__link" data-menu-link>
            <span>{{ 'layout.navigation.create_free_account' | t }}</span><span aria-hidden="true">&rarr;</span>
          </a>
        </div>
        <div class="sl-app-auth__state" data-app-auth-signed-in hidden>
          <span class="sl-app-auth__welcome" data-app-auth-welcome></span>
          <a href="{{ app_account_url }}" class="sl-menu__link" data-menu-link>
            <span>{{ 'layout.navigation.caddieinsight_profile' | t }}</span><span aria-hidden="true">&rarr;</span>
          </a>
          <form action="{{ app_session_url }}" method="post">
            <button class="sl-menu__link sl-app-auth__logout" type="submit">
              <span>{{ 'layout.navigation.log_out' | t }}</span><span aria-hidden="true">&rarr;</span>
            </button>
          </form>
        </div>
        {%- endif -%}
        <a href="{{ routes.account_url }}" class="sl-menu__link" data-menu-link>
          <span>{{ 'layout.navigation.orders_subscriptions' | t }}</span><span aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </nav>
  </div>
</dialog>

{% stylesheet %}
/* ==========================================================================
   Header — one grid, four breakpoints.
   The previous sheet was 759 lines across 13 private breakpoint blocks,
   each patching the one before it; the primary CTA was display:none on
   every phone and tablet, and a 1024px desktop got a hamburger. This sheet
   is one layout with four system stops (560/750/1000/1280):

     base      logo · [CTA cart burger]           nav + search live in drawer
     ≥750      + search icon
     ≥1000     logo · nav · [search account cart CTA]   burger gone
     ≥1280     roomier gutters

   The signed-in contracts are unchanged and pinned by
   tests/test_storefront_header.py: the announcement bar hides for members,
   the account trigger truncates to the member's name, and the overlay
   header pulls the hero up under itself.
   ========================================================================== */

/* -- signed-in page chrome (contract) ------------------------------------ */
body:has(.sl-header[data-app-authenticated="true"]) .sl-announcement { display: none; }

/* -- member rail (index, signed-in) --------------------------------------- */
.sl-member-rail {
  width: calc(100% + var(--sl-pad-x) + var(--sl-pad-x));
  min-height: 52px;
  margin: 0 calc(-1 * var(--sl-pad-x));
  background: var(--sl-night);
  color: rgba(var(--sl-cream-rgb), 0.86);
}
/* One line at every width: the greeting is the only flexible item and it
   truncates, so the rail is always exactly 52px (4px padding + the 44px
   full-height action) and the overlay pull-up below never needs a
   per-width variant. The old sheet let this wrap to 72px on phones and
   chased it with patch media blocks. */
.sl-member-rail__inner {
  max-width: var(--sl-maxw);
  margin: 0 auto;
  padding: var(--sl-space-1) var(--sl-pad-x);
  min-height: 44px;
  display: flex;
  align-items: center;
  flex-wrap: nowrap;
  gap: var(--sl-space-3);
  font-family: var(--sl-font-mono);
  font-size: var(--sl-text-xs);
  letter-spacing: 0.08em;
}
.sl-member-rail__dot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: var(--sl-accent);
  box-shadow: 0 0 0 4px rgba(var(--sl-accent-rgb), 0.18);
}
.sl-member-rail[data-app-pro="true"] .sl-member-rail__dot { background: var(--sl-accent); }
.sl-member-rail__dot { flex: none; }
.sl-member-rail__tier {
  flex: none;
  text-transform: uppercase;
  white-space: nowrap;
  color: var(--sl-accent-hover);
}
.sl-member-rail__greeting {
  flex: 1 1 auto;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: rgba(var(--sl-cream-rgb), 0.7);
}
.sl-member-rail__action {
  flex: none;
  margin-left: auto;
  display: inline-flex;
  align-items: center;
  min-height: 44px;
  padding: 0 var(--sl-space-3);
  border: 1px solid rgba(var(--sl-cream-rgb), 0.28);
  border-radius: var(--sl-radius-control);
  color: var(--sl-cream);
  text-decoration: none;
  white-space: nowrap;
}
.sl-member-rail__action:hover { border-color: var(--sl-accent); color: var(--sl-accent-hover); }

/* -- overlay pull-up (contract) ------------------------------------------- */
.shopify-section:has(> .sl-header--overlay) { margin-bottom: -76px; }
.shopify-section:has(> .sl-header--overlay[data-app-authenticated="true"]) {
  margin-bottom: calc(-76px - 52px);
}
body:has(.sl-header[data-app-authenticated="true"]) .sl-hero__inner {
  padding-top: clamp(148px, 15vw, 192px);
}

/* -- the header bar -------------------------------------------------------- */
.sl-header {
  position: relative;
  z-index: 40;
  min-height: 64px;
  padding: 0 var(--sl-pad-x);
  background: var(--sl-bg-card);
  border-bottom: 1px solid var(--sl-border);
  color: var(--sl-ink);
}
.sl-header__inner {
  max-width: var(--sl-maxw);
  margin: 0 auto;
  min-height: 64px;
  display: grid;
  grid-template-columns: auto 1fr auto;
  grid-template-areas: "logo nav actions";
  align-items: center;
  column-gap: var(--sl-space-4);
}
.sl-header__logo { grid-area: logo; display: inline-flex; align-items: center; }
.sl-header__logo-img { height: 30px; width: auto; display: block; }

/* -- desktop nav (drawer below 1000) --------------------------------------- */
.sl-header__desktop-nav {
  grid-area: nav;
  display: none;
  align-items: center;
  justify-content: center;
  gap: var(--sl-space-5);
}
.sl-header__link,
.sl-header__dropdown-trigger {
  display: inline-flex;
  align-items: center;
  gap: var(--sl-space-1);
  min-height: 44px;
  font-size: var(--sl-text-sm);
  font-weight: 600;
  letter-spacing: -0.01em;
  color: inherit;
  text-decoration: none;
  cursor: pointer;
  list-style: none;
}
.sl-header__dropdown-trigger::-webkit-details-marker { display: none; }
.sl-header__link:hover,
.sl-header__dropdown-trigger:hover { color: var(--sl-orange); }
.sl-header__link.is-current {
  color: var(--sl-orange);
  text-decoration: underline;
  text-underline-offset: 6px;
  text-decoration-thickness: 2px;
  text-decoration-color: rgba(var(--sl-accent-rgb), 0.6);
}
.sl-header__chevron {
  width: 8px;
  height: 8px;
  border-right: 1.5px solid currentColor;
  border-bottom: 1.5px solid currentColor;
  transform: rotate(45deg) translateY(-2px);
}
.sl-header__dropdown { position: relative; }
.sl-header__dropdown[open] .sl-header__chevron { transform: rotate(225deg) translateY(-2px); }
.sl-header__dropdown-menu {
  position: absolute;
  top: calc(100% + var(--sl-space-2));
  left: 0;
  z-index: 50;
  min-width: 220px;
  display: grid;
  padding: var(--sl-space-2);
  background: var(--sl-bg-card);
  border: 1px solid var(--sl-border);
  border-radius: var(--sl-radius);
  box-shadow: var(--sl-shadow-card-hover);
}
.sl-header__dropdown-menu--right { left: auto; right: 0; }
.sl-header__dropdown-menu a,
.sl-app-auth__logout {
  display: flex;
  align-items: center;
  min-height: 44px;
  padding: 0 var(--sl-space-3);
  border: 0;
  border-radius: var(--sl-radius-sm);
  background: none;
  font: inherit;
  font-size: var(--sl-text-sm);
  color: var(--sl-ink);
  text-decoration: none;
  text-align: left;
  cursor: pointer;
}
.sl-header__dropdown-menu a:hover,
.sl-app-auth__logout:hover { background: var(--sl-orange-soft); color: var(--sl-green); }
.sl-app-auth__state { display: grid; }
.sl-app-auth__state[hidden] { display: none; }
.sl-app-auth__welcome {
  padding: var(--sl-space-2) var(--sl-space-3);
  font-family: var(--sl-font-mono);
  font-size: var(--sl-text-xs);
  letter-spacing: 0.06em;
  color: var(--sl-ink-muted);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* -- actions cluster -------------------------------------------------------- */
.sl-header__actions {
  grid-area: actions;
  display: flex;
  align-items: center;
  gap: var(--sl-space-2);
}
.sl-header__search {
  display: none;
  align-items: center;
  justify-content: center;
  width: 44px;
  height: 44px;
  border-radius: 50%;
  color: inherit;
}
.sl-header__search:hover { color: var(--sl-orange); background: var(--sl-orange-soft); }
.sl-header__account { display: none; }
.sl-header[data-app-authenticated="true"] .sl-header__account > summary,
.sl-header[data-app-authenticated="true"] .sl-header__account .sl-header__dropdown-trigger {
  max-width: 108px;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
/* The name span is a flex child of the summary — without min-width: 0 it
   refuses to shrink and the ellipsis above never engages. */
[data-app-auth-summary] {
  display: block;
  flex: 1 1 auto;
  min-width: 0;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.sl-header__cart {
  display: inline-flex;
  align-items: center;
  gap: var(--sl-space-1);
  min-height: 44px;
  padding: 0 var(--sl-space-2);
  font-size: var(--sl-text-sm);
  font-weight: 600;
  color: inherit;
  text-decoration: none;
}
.sl-header__cart:hover { color: var(--sl-orange); }
.sl-header__cart-count {
  display: inline-grid;
  place-items: center;
  min-width: 22px;
  height: 22px;
  padding: 0 var(--sl-space-1);
  border-radius: 11px;
  background: var(--sl-green-btn);
  color: var(--sl-green-ink);
  font-family: var(--sl-font-mono);
  font-size: var(--sl-text-xs);
}

/* The primary CTA is PRESENT at every width. The old sheet hid it below
   981px — the one action the whole storefront exists to produce, removed
   for every phone and tablet visitor. Compact on small screens, full at
   desktop. */
.sl-header__cta {
  display: inline-flex;
  align-items: center;
  min-height: 44px;
  padding: 0 var(--sl-space-4);
  border-radius: var(--sl-radius-control);
  background: var(--sl-green-btn);
  color: var(--sl-green-ink);
  font-size: var(--sl-text-sm);
  font-weight: 600;
  letter-spacing: -0.01em;
  text-decoration: none;
  white-space: nowrap;
}
.sl-header__cta:hover { background: var(--sl-green); color: var(--sl-green-ink); }

.sl-header__toggle {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 5px;
  width: 44px;
  height: 44px;
  border: 0;
  border-radius: var(--sl-radius-sm);
  background: none;
  cursor: pointer;
}
.sl-header__toggle span {
  width: 20px;
  height: 2px;
  border-radius: 1px;
  background: currentColor;
}
.sl-header__toggle:hover { color: var(--sl-orange); }

/* -- premium + overlay states ---------------------------------------------- */
.sl-header--premium {
  background: var(--sl-night);
  border-bottom-color: rgba(var(--sl-cream-rgb), 0.12);
  color: var(--sl-cream);
}
.sl-header--premium .sl-header__logo-img { filter: invert(1) hue-rotate(180deg) saturate(0.9) brightness(1.6); }
.sl-header--premium .sl-header__link:hover,
.sl-header--premium .sl-header__dropdown-trigger:hover,
.sl-header--premium .sl-header__cart:hover,
.sl-header--premium .sl-header__search:hover { color: var(--sl-accent-hover); background: none; }
.sl-header--premium .sl-header__link.is-current { color: var(--sl-accent-hover); }
.sl-header--premium .sl-header__dropdown-menu {
  background: var(--sl-night);
  border-color: rgba(var(--sl-cream-rgb), 0.16);
}
.sl-header--premium .sl-header__dropdown-menu a,
.sl-header--premium .sl-app-auth__logout { color: var(--sl-cream); }
.sl-header--premium .sl-header__dropdown-menu a:hover,
.sl-header--premium .sl-app-auth__logout:hover {
  background: rgba(var(--sl-cream-rgb), 0.08);
  color: var(--sl-accent-hover);
}
.sl-header--premium .sl-header__cta {
  background: var(--sl-accent);
  color: var(--sl-night);
}
.sl-header--premium .sl-header__cta:hover { background: var(--sl-accent-hover); color: var(--sl-night); }
.sl-header--premium .sl-header__cart-count { background: var(--sl-accent); color: var(--sl-night); }

.sl-header--overlay {
  position: relative;
  background: transparent;
  border-bottom-color: transparent;
}
.sl-header--overlay.is-scrolled,
.sl-header--overlay:has(.sl-header__dropdown[open]) {
  position: sticky;
  top: 0;
  background: rgba(var(--sl-night-rgb), 0.92);
  -webkit-backdrop-filter: blur(14px);
  backdrop-filter: blur(14px);
  border-bottom-color: rgba(var(--sl-cream-rgb), 0.1);
}

/* -- the drawer ------------------------------------------------------------- */
html.sl-menu-open { overflow: hidden; }
.sl-menu {
  width: min(420px, 100vw);
  max-width: 100vw;
  height: 100dvh;
  max-height: 100dvh;
  margin: 0 0 0 auto;
  padding: 0;
  border: 0;
  background: var(--sl-bg-card);
  color: var(--sl-ink);
}
.sl-menu::backdrop { background: rgba(var(--sl-night-rgb), 0.55); }
.sl-menu__panel {
  height: 100%;
  overflow-y: auto;
  padding: var(--sl-space-5) var(--sl-space-5) var(--sl-space-8);
  padding-top: calc(var(--sl-space-5) + env(safe-area-inset-top, 0px));
}
.sl-menu__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--sl-space-5);
}
.sl-menu__title {
  margin: 0;
  font-family: var(--sl-font-mono);
  font-size: var(--sl-text-xs);
  font-weight: 500;
  letter-spacing: var(--sl-eyebrow-track);
  text-transform: uppercase;
  color: var(--sl-ink-muted);
}
.sl-menu__close {
  position: relative;
  width: 44px;
  height: 44px;
  border: 1px solid var(--sl-border);
  border-radius: 50%;
  background: none;
  cursor: pointer;
  color: inherit;
}
.sl-menu__close span {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 16px;
  height: 2px;
  background: currentColor;
}
.sl-menu__close span:first-child { transform: translate(-50%, -50%) rotate(45deg); }
.sl-menu__close span:last-child { transform: translate(-50%, -50%) rotate(-45deg); }
.sl-menu__close:hover { color: var(--sl-orange); border-color: currentColor; }
.sl-menu__nav { display: grid; gap: var(--sl-space-6); }
.sl-menu__cta { justify-content: center; }
.sl-menu__group { display: grid; }
.sl-menu__eyebrow {
  margin: 0 0 var(--sl-space-2);
  font-family: var(--sl-font-mono);
  font-size: var(--sl-text-xs);
  font-weight: 500;
  letter-spacing: var(--sl-eyebrow-track);
  text-transform: uppercase;
  color: var(--sl-orange);
}
.sl-menu__link {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--sl-space-3);
  width: 100%;
  min-height: 46px;
  padding: 0 var(--sl-space-1);
  border: 0;
  border-bottom: 1px solid var(--sl-border);
  background: none;
  font: inherit;
  font-size: var(--sl-text-base);
  font-weight: 600;
  color: inherit;
  text-decoration: none;
  text-align: left;
  cursor: pointer;
}
.sl-menu__link:hover { color: var(--sl-orange); }
.sl-menu__link.is-current { color: var(--sl-orange); }
.sl-menu .sl-app-auth__welcome { padding-left: var(--sl-space-1); }

/* Premium pages get the night drawer (contract: .sl-premium-chrome .sl-menu) */
.sl-premium-chrome .sl-menu {
  background: var(--sl-night);
  color: var(--sl-cream);
}
.sl-premium-chrome .sl-menu .sl-menu__close { border-color: rgba(var(--sl-cream-rgb), 0.3); }
.sl-premium-chrome .sl-menu .sl-menu__link { border-bottom-color: rgba(var(--sl-cream-rgb), 0.12); }
.sl-premium-chrome .sl-menu .sl-menu__link:hover,
.sl-premium-chrome .sl-menu .sl-menu__link.is-current { color: var(--sl-accent-hover); }
.sl-premium-chrome .sl-menu .sl-menu__eyebrow { color: var(--sl-accent-hover); }
.sl-premium-chrome .sl-menu .sl-menu__title { color: rgba(var(--sl-cream-rgb), 0.6); }
.sl-premium-chrome .sl-menu .sl-app-auth__welcome { color: rgba(var(--sl-cream-rgb), 0.6); }

/* -- the four system stops -------------------------------------------------- */
@media (max-width: 559px) {
  /* Compact CTA keeps the primary action present on the smallest phones. */
  .sl-header__cta { padding: 0 var(--sl-space-3); font-size: var(--sl-text-xs); }
  .sl-header__cart-label {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }
  .sl-menu { width: 100vw; }
}
@media (min-width: 750px) {
  .sl-header__search { display: inline-flex; }
}
@media (min-width: 1000px) {
  .sl-header { min-height: 76px; }
  .sl-header__inner { min-height: 76px; column-gap: var(--sl-space-5); }
  .sl-header__logo-img { height: 34px; }
  .sl-header__desktop-nav { display: flex; }
  .sl-header__account { display: block; }
  .sl-header__toggle { display: none; }
  .sl-header[data-app-authenticated="true"] .sl-header__search { display: none; }
}
@media (max-width: 999px) {
  /* Below the desktop stop, header height is 64px — the overlay pull-up
     matches so the hero sits flush underneath. */
  .shopify-section:has(> .sl-header--overlay) { margin-bottom: -64px; }
  .shopify-section:has(> .sl-header--overlay[data-app-authenticated="true"]) {
    margin-bottom: calc(-64px - 52px);
  }
}
@media (min-width: 1280px) {
  .sl-header__desktop-nav { gap: var(--sl-space-6); }
}
@media (prefers-reduced-motion: no-preference) {
  .sl-header--overlay { transition: background-color 0.25s ease, border-color 0.25s ease; }
  .sl-header__chevron { transition: transform 0.15s ease; }
}
{% endstylesheet %}

<script>
  (function () {
    if (window.CaddieInsightHeader) {
      window.CaddieInsightHeader.init(document);
      return;
    }

    function findHeaders(root) {
      var headers = [];
      if (root && root.matches && root.matches('[data-sl-header]')) headers.push(root);
      if (root && root.querySelectorAll) {
        var descendants = root.querySelectorAll('[data-sl-header]');
        for (var i = 0; i < descendants.length; i++) headers.push(descendants[i]);
      }
      return headers;
    }

    function initHeader(header) {
      if (!header || header.dataset.slHeaderReady === 'true') return;

      var menu = document.getElementById(header.getAttribute('data-menu-id'));
      var openButton = header.querySelector('[data-menu-open]');
      if (!menu || !openButton) return;

      var controller = new AbortController();
      var listenerOptions = { signal: controller.signal };
      var closeButton = menu.querySelector('[data-menu-close]');
      var menuLinks = menu.querySelectorAll('[data-menu-link]');
      var desktopMenus = header.querySelectorAll('[data-header-dropdown]');
      var desktopQuery = window.matchMedia('(min-width: 1000px)');
      var overlayHeader = header.classList.contains('sl-header--overlay');
      var restoreMenuFocus = false;

      function updateHeaderSurface() {
        if (!overlayHeader) return;
        header.classList.toggle('is-scrolled', window.scrollY > 12);
      }

      function finishMenuClose() {
        openButton.setAttribute('aria-expanded', 'false');
        document.documentElement.classList.remove('sl-menu-open');
        if (restoreMenuFocus && document.contains(openButton)) openButton.focus();
        restoreMenuFocus = false;
      }

      function closeMenu(restoreFocus) {
        if (!menu.hasAttribute('open')) return;
        restoreMenuFocus = restoreFocus;
        if (typeof menu.close === 'function') {
          menu.close();
        } else {
          menu.removeAttribute('open');
          finishMenuClose();
        }
      }

      function openMenu() {
        if (menu.hasAttribute('open')) return;
        if (typeof menu.showModal === 'function') {
          menu.showModal();
        } else {
          menu.setAttribute('open', '');
        }
        openButton.setAttribute('aria-expanded', 'true');
        document.documentElement.classList.add('sl-menu-open');
        if (closeButton) closeButton.focus();
      }

      function closeDesktopMenus() {
        for (var i = 0; i < desktopMenus.length; i++) {
          desktopMenus[i].removeAttribute('open');
        }
      }

      function closeOnBreakpointChange(event) {
        closeDesktopMenus();
        if (event.matches) closeMenu(false);
      }

      function setCount(value) {
        var count = header.querySelector('[data-cart-count]');
        var cartLink = count && count.closest('.sl-header__cart');
        if (!count || !cartLink) return;
        var number = Number(value) || 0;
        count.textContent = number;
        var label = number === 1
          ? cartLink.getAttribute('data-cart-one')
          : cartLink.getAttribute('data-cart-other').replace('__COUNT__', number);
        cartLink.setAttribute('aria-label', label);
      }

      function refreshCount() {
        fetch('{{ routes.cart_url }}.js', { headers: { 'Accept': 'application/json' } })
          .then(function (response) { return response.ok ? response.json() : null; })
          .then(function (cart) { if (cart) setCount(cart.item_count); })
          .catch(function () {});
      }

      function eachAppAuthNode(selector, callback) {
        var nodes = document.querySelectorAll(selector);
        for (var nodeIndex = 0; nodeIndex < nodes.length; nodeIndex++) {
          callback(nodes[nodeIndex]);
        }
      }

      function setAppAuthState(payload) {
        var authenticated = Boolean(payload && payload.authenticated === true);
        var isPro = authenticated && payload.is_pro === true;
        var displayName = authenticated && typeof payload.display_name === 'string'
          ? payload.display_name.trim()
          : '';
        var summary = header.querySelector('[data-app-auth-summary]');
        var memberRail = header.querySelector('[data-app-member-rail]');
        var appUrl = header.getAttribute('data-app-url') || '';
        var accountLabel = header.getAttribute('data-app-account-label')
          || (summary ? summary.textContent.trim() : '');
        var welcomeLabel = header.getAttribute('data-app-welcome-label') || accountLabel;
        var signedInLabel = header.getAttribute('data-app-signed-in-label') || accountLabel;
        var proLabel = header.getAttribute('data-app-pro-label') || '';
        var freeLabel = header.getAttribute('data-app-free-label') || signedInLabel;
        var readyLabel = header.getAttribute('data-app-ready-label') || signedInLabel;
        var analyzeLabel = header.getAttribute('data-app-analyze-label') || signedInLabel;
        var proActionLabel = header.getAttribute('data-app-pro-action-label') || analyzeLabel;
        var memberActionLabel = header.getAttribute('data-app-member-action-label') || proActionLabel;
        var welcomeText = displayName ? welcomeLabel + ', ' + displayName : signedInLabel;
        var memberGreeting = displayName ? welcomeLabel + ', ' + displayName + '.' : readyLabel;
        var summaryText = accountLabel || signedInLabel;
        if (authenticated) {
          if (displayName) {
            summaryText = displayName.length > 18
              ? displayName.slice(0, 17) + '\u2026'
              : displayName;
          } else {
            summaryText = accountLabel || 'Account';
          }
        }
        if (isPro && proLabel) {
          welcomeText += ' · ' + proLabel;
        }

        eachAppAuthNode('[data-app-auth-signed-out]', function (node) {
          node.hidden = authenticated;
        });
        eachAppAuthNode('[data-app-auth-signed-in]', function (node) {
          node.hidden = !authenticated;
        });
        eachAppAuthNode('[data-app-auth-welcome]', function (node) {
          node.textContent = authenticated ? welcomeText : '';
        });
        eachAppAuthNode('[data-app-member-rail]', function (node) {
          node.hidden = !authenticated;
          node.dataset.appPro = isPro ? 'true' : 'false';
        });
        eachAppAuthNode('[data-app-member-tier]', function (node) {
          node.textContent = authenticated ? (isPro ? proLabel : freeLabel) : '';
        });
        eachAppAuthNode('[data-app-member-greeting]', function (node) {
          node.textContent = authenticated ? memberGreeting : '';
        });
        eachAppAuthNode('[data-app-member-action]', function (node) {
          node.textContent = authenticated ? (isPro ? memberActionLabel : analyzeLabel) + ' \u2192' : '';
        });
        eachAppAuthNode('[data-app-pro-sales-link]', function (node) {
          node.hidden = isPro;
        });
        eachAppAuthNode('[data-app-pro-member-only]', function (node) {
          node.hidden = !isPro;
        });
        eachAppAuthNode('[data-app-upgrade-section]', function (node) {
          node.hidden = isPro;
        });
        eachAppAuthNode('[data-app-primary-cta]', function (node) {
          var signedOutLabel = node.getAttribute('data-app-signed-out-label') || analyzeLabel;
          var signedOutUrl = node.getAttribute('data-app-signed-out-url') || appUrl;
          // Keep the long Pro rail line ("Let's work on your swing") out of the
          // compact header/menu CTA — that string is what crowded search/account.
          var resolvedLabel = authenticated ? analyzeLabel : signedOutLabel;
          var labelNode = node.querySelector('[data-app-cta-label]');
          if (labelNode) {
            labelNode.textContent = resolvedLabel;
          } else {
            node.textContent = resolvedLabel;
          }
          node.setAttribute('href', authenticated ? appUrl : signedOutUrl);
        });

        if (summary) {
          summary.textContent = summaryText;
        }
        header.dataset.appAuthenticated = authenticated ? 'true' : 'false';
        header.dataset.appPro = isPro ? 'true' : 'false';
        header.slAppAuthPayload = payload;
      }

      function refreshAppSession() {
        var sessionUrl = header.getAttribute('data-app-session-url');
        if (!sessionUrl) return;
        fetch(sessionUrl, {
          cache: 'no-store',
          credentials: 'include',
          headers: { 'Accept': 'application/json' },
          signal: controller.signal
        })
          .then(function (response) {
            if (!response.ok) throw new Error('App session is unavailable.');
            return response.json();
          })
          .then(setAppAuthState)
          .catch(function (error) {
            if (error && error.name === 'AbortError') return;
          });
      }

      openButton.addEventListener('click', openMenu, listenerOptions);
      if (closeButton) {
        closeButton.addEventListener('click', function () { closeMenu(true); }, listenerOptions);
      }
      menu.addEventListener('cancel', function (event) {
        event.preventDefault();
        closeMenu(true);
      }, listenerOptions);
      menu.addEventListener('close', finishMenuClose, listenerOptions);
      menu.addEventListener('click', function (event) {
        if (event.target === menu) closeMenu(true);
      }, listenerOptions);
      for (var i = 0; i < menuLinks.length; i++) {
        menuLinks[i].addEventListener('click', function () { closeMenu(false); }, listenerOptions);
      }
      desktopQuery.addEventListener('change', closeOnBreakpointChange, listenerOptions);
      if (overlayHeader) {
        updateHeaderSurface();
        window.addEventListener('scroll', updateHeaderSurface, { signal: controller.signal, passive: true });
      }

      for (var j = 0; j < desktopMenus.length; j++) {
        desktopMenus[j].addEventListener('toggle', function (event) {
          if (!event.currentTarget.open) return;
          for (var k = 0; k < desktopMenus.length; k++) {
            if (desktopMenus[k] !== event.currentTarget) desktopMenus[k].removeAttribute('open');
          }
        }, listenerOptions);
        desktopMenus[j].addEventListener('focusout', function (event) {
          if (!event.currentTarget.contains(event.relatedTarget)) {
            event.currentTarget.removeAttribute('open');
          }
        }, listenerOptions);
      }
      document.addEventListener('click', function (event) {
        for (var i = 0; i < desktopMenus.length; i++) {
          if (!desktopMenus[i].contains(event.target)) desktopMenus[i].removeAttribute('open');
        }
      }, listenerOptions);
      document.addEventListener('keydown', function (event) {
        if (event.key !== 'Escape') return;
        for (var i = 0; i < desktopMenus.length; i++) {
          if (!desktopMenus[i].hasAttribute('open')) continue;
          desktopMenus[i].removeAttribute('open');
          var summary = desktopMenus[i].querySelector('summary');
          if (summary) summary.focus();
        }
      }, listenerOptions);
      window.addEventListener('pageshow', function (event) {
        if (event.persisted) {
          refreshCount();
          refreshAppSession();
        }
      }, listenerOptions);
      document.addEventListener('cart:change', function (event) {
        if (event.detail && typeof event.detail.item_count !== 'undefined') {
          setCount(event.detail.item_count);
        } else {
          refreshCount();
        }
      }, listenerOptions);

      refreshAppSession();

      header.dataset.slHeaderReady = 'true';
      header.slApplyAppAuthState = setAppAuthState;
      header.slHeaderCleanup = function () {
        closeMenu(false);
        closeDesktopMenus();
        controller.abort();
        document.documentElement.classList.remove('sl-menu-open');
        delete header.dataset.slHeaderReady;
        delete header.slApplyAppAuthState;
        delete header.slAppAuthPayload;
        delete header.slHeaderCleanup;
      };
    }

    function init(root) {
      var headers = findHeaders(root);
      for (var i = 0; i < headers.length; i++) initHeader(headers[i]);
    }

    function unload(root) {
      var headers = findHeaders(root);
      for (var i = 0; i < headers.length; i++) {
        if (headers[i].slHeaderCleanup) headers[i].slHeaderCleanup();
      }
    }

    function reapplyAppState() {
      var headers = findHeaders(document);
      for (var i = 0; i < headers.length; i++) {
        var header = headers[i];
        if (header.slApplyAppAuthState && header.slAppAuthPayload) {
          header.slApplyAppAuthState(header.slAppAuthPayload);
        }
      }
    }

    window.CaddieInsightHeader = {
      init: init,
      unload: unload,
      reapplyAppState: reapplyAppState
    };
    init(document);
    document.addEventListener('shopify:section:load', function (event) {
      init(event.target);
      reapplyAppState();
    });
    document.addEventListener('shopify:section:unload', function (event) { unload(event.target); });
  })();
</script>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo image",
      "info": "Defaults to the theme's caddieinsight-logo.png. Do not point this at swinglab-logo.png — that Files entry is the retired v3 mark."
    },
    {
      "type": "text",
      "id": "logo_text",
      "label": "Logo wordmark (fallback)",
      "default": "CADDIEINSIGHT"
    },
    {
      "type": "text",
      "id": "app_url",
      "label": "App URL",
      "default": "https://app.caddieinsight.com",
      "info": "Analyze and My Game links use this origin. Leave empty to hide app links."
    }
  ]
}
{% endschema %}
