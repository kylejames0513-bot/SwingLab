<div class="sl-password">
  <p class="sl-eyebrow">{{ shop.name }}</p>
  <h1 class="sl-password__title">{{ section.settings.heading | default: 'Opening soon' }}</h1>
  {%- if shop.password_message != blank -%}
    <p class="sl-password__message">{{ shop.password_message }}</p>
  {%- endif -%}

  {% form 'storefront_password', class: 'sl-password__form' %}
    {%- if form.errors -%}
      <p class="sl-password__error" role="alert">That password didn't match. Try again.</p>
    {%- endif -%}
    <label class="sl-label" for="sl-store-password">Store password</label>
    <div class="sl-password__row">
      <input id="sl-store-password" class="sl-input" type="password" name="password" autocomplete="current-password" required>
      <button type="submit" class="sl-btn sl-btn--primary">Enter</button>
    </div>
  {% endform %}
</div>

{% stylesheet %}
.sl-password {
  width: min(100%, 480px);
  margin: 0 auto;
  padding: var(--sl-space-9) var(--sl-space-5);
  text-align: center;
}
.sl-password__title {
  margin: 0 0 var(--sl-space-3);
  font-size: var(--sl-text-4xl);
}
.sl-password__message {
  margin: 0 0 var(--sl-space-5);
  color: var(--sl-ink-soft);
  line-height: 1.6;
}
.sl-password__form { text-align: left; }
.sl-password__row {
  display: flex;
  gap: var(--sl-space-2);
  margin-top: var(--sl-space-2);
}
.sl-password__row .sl-input { flex: 1; min-width: 0; }
.sl-password__error { color: var(--sl-orange); }
{% endstylesheet %}

{% schema %}
{
  "name": "Password",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Opening soon" }
  ]
}
{% endschema %}
