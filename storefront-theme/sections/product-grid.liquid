<section id="{{ section.settings.anchor | default: 'shop' }}"
         class="sl-shop sl-wrap"{% if section.settings.membership_section %} data-app-upgrade-section{% endif %}>
  <div class="sl-shop__head sl-reveal">
    <p class="sl-shop__eyebrow">{{ 'homepage.plans.eyebrow' | t }}</p>
    <h2 class="sl-h2">
      {%- if section.settings.membership_section -%}
        <span data-app-auth-signed-out>{{ section.settings.heading | default: 'Shop CaddieInsight' }}</span>
        <span data-app-auth-signed-in hidden>{{ 'homepage.plans.member_heading' | t }}</span>
      {%- else -%}
        {{ section.settings.heading | default: 'Shop CaddieInsight' }}
      {%- endif -%}
    </h2>
    {%- if section.settings.subheading != blank -%}
      <p class="sl-shop__sub"{% if section.settings.membership_section %} data-app-auth-signed-out{% endif %}>{{ section.settings.subheading }}</p>
    {%- endif -%}
    {%- if section.settings.membership_section -%}
      <p class="sl-shop__sub" data-app-auth-signed-in hidden>{{ 'homepage.plans.member_subheading' | t }}</p>
    {%- endif -%}
  </div>

  <div class="sl-shop__grid sl-reveal sl-reveal--d1">
    {%- for block in section.blocks -%}
      {%- liquid
        assign b = block.settings
        assign title = b.title
        assign price = b.price_text
        assign compare_at = ''
        assign url = b.url
        assign is_pro_card = false
        assign image_label = b.image_label | default: title

        # If a real product is linked, let its data win over placeholder text.
        if b.product != blank
          assign p = b.product
          if title == blank
            assign title = p.title
          endif
          if url == blank
            assign url = p.url
          endif
          if b.use_product_price
            if p.price_varies
              assign price = p.price_min | money | prepend: 'From '
            else
              assign price = p.price | money
              if p.compare_at_price > p.price
                assign compare_at = p.compare_at_price | money
              endif
            endif
          endif
          if p.handle == 'swinglab-pro'
            assign is_pro_card = true
          endif
        endif
        assign url = url | default: '#'
      -%}
      <a href="{{ url }}"
         class="sl-card{% if b.featured %} sl-card--featured{% endif %}"
         {% if is_pro_card or b.member_visibility == 'pro_offer' %}data-app-pro-sales-link{% endif %}
         {% if b.member_visibility == 'signed_out' %}data-app-auth-signed-out{% endif %}{{ block.shopify_attributes }}>
        <div class="sl-card__media">
          {% render 'media-placeholder',
            image: b.image,
            ratio_w: 400, ratio_h: 260,
            label: b.placeholder_label,
            warm: b.warm_placeholder,
            flush: true,
            alt: title %}
          {%- if image_label != blank -%}
            <span class="sl-card__media-label" aria-hidden="true">{{ image_label | escape }}</span>
          {%- endif -%}
        </div>
        <div class="sl-card__body">
          {%- if b.badge != blank -%}<p class="sl-card__badge">{{ b.badge }}</p>{%- endif -%}
          <h3 class="sl-card__title">{{ title | default: 'Product' }}</h3>
          {%- if b.description != blank -%}<p class="sl-card__desc">{{ b.description }}</p>{%- endif -%}
          {%- if price != blank -%}
            <p class="sl-card__price">
              {{ price }}
              {%- if compare_at != blank %}
                <s class="sl-price-compare">{{ compare_at }}</s>
              {%- endif -%}
            </p>
          {%- endif -%}
          {%- if b.price_note != blank -%}<p class="sl-card__note">{{ b.price_note }}</p>{%- endif -%}
        </div>
      </a>
    {%- endfor -%}
  </div>
</section>

{% stylesheet %}
.sl-shop {
  padding-top: var(--sl-section-space);
  padding-bottom: var(--sl-section-space);
}
.sl-shop__head {
  max-width: 850px;
  margin-inline: auto;
  text-align: center;
}
.sl-shop__eyebrow {
  margin: 0 0 18px;
  color: var(--sl-orange);
  font-family: var(--sl-font-mono);
  font-size: var(--sl-text-xs);
  font-weight: 500;
  letter-spacing: 0.18em;
}
.sl-shop .sl-h2 {
  max-width: 13ch;
  margin-inline: auto;
  font-size: var(--sl-heading-display);
  font-weight: 800;
  letter-spacing: -0.05em;
  line-height: 0.98;
  text-wrap: balance;
}
.sl-shop__sub {
  max-width: 62ch;
  margin: 20px auto 0;
  font-size: var(--sl-text-base);
  line-height: 1.6;
  color: var(--sl-ink-soft);
  text-align: left;
}
.sl-shop__grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr));
  align-items: stretch;
  gap: 20px;
  margin-top: clamp(34px, 5vw, 56px);
}
.sl-card {
  min-width: 0;
  height: 100%;
  text-decoration: none;
  color: inherit;
  background: var(--sl-bg-card);
  border: 1px solid var(--sl-border);
  border-radius: var(--sl-radius-lg);
  overflow: hidden;
  display: flex;
  flex-direction: column;
  box-shadow: var(--sl-shadow-card);
}
.sl-card:hover { border-color: rgba(var(--sl-green-rgb), 0.35); }
.sl-card--featured {
  position: relative;
  border-color: rgba(var(--sl-cream-rgb), 0.14);
  background:
    radial-gradient(circle at 82% 6%, rgba(var(--sl-accent-rgb), 0.2), transparent 30%),
    #0a1e14;
  color: var(--sl-cream);
  box-shadow: 0 34px 76px -38px rgba(7, 19, 13, 0.82);
}
.sl-card--featured:hover { border-color: rgba(var(--sl-accent-rgb), 0.62); }
.sl-card--featured .sl-card__media {
  background: rgba(255, 255, 255, 0.035);
  border-bottom: 1px solid rgba(var(--sl-cream-rgb), 0.1);
}
.sl-card--featured .sl-card__media img { mix-blend-mode: screen; }
.sl-card--featured .sl-card__badge { color: var(--sl-accent-hover); }
.sl-card--featured .sl-card__title { color: var(--sl-cream); }
.sl-card--featured .sl-card__desc { color: rgba(var(--sl-cream-rgb), 0.68); }
.sl-card--featured .sl-card__price { color: #ffffff; }
.sl-card--featured .sl-card__note { color: rgba(var(--sl-cream-rgb), 0.52); }
.sl-card__media {
  position: relative;
  aspect-ratio: 20 / 13;
  overflow: hidden;
  line-height: 0;
}
.sl-card__media-label {
  position: absolute;
  z-index: 1;
  top: 14px;
  left: 14px;
  display: inline-flex;
  align-items: center;
  min-height: 29px;
  max-width: calc(100% - 28px);
  padding: 0 10px;
  overflow: hidden;
  border: 1px solid rgba(var(--sl-cream-rgb), 0.34);
  border-radius: var(--sl-radius-control);
  background: rgba(7, 19, 13, 0.78);
  box-shadow: 0 10px 24px -12px rgba(7, 19, 13, 0.9);
  color: var(--sl-cream);
  font-family: var(--sl-font-mono);
  font-size: var(--sl-text-xs);
  font-weight: 700;
  letter-spacing: 0.14em;
  line-height: 1;
  text-overflow: ellipsis;
  text-transform: uppercase;
  white-space: nowrap;
  pointer-events: none;
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
}
.sl-card--featured .sl-card__media-label {
  border-color: rgba(var(--sl-accent-rgb), 0.76);
  background: rgba(7, 19, 13, 0.72);
}
.sl-card__media img,
.sl-card__media .sl-placeholder {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
}
.sl-card__body {
  padding: var(--sl-card-inset);
  display: flex;
  flex-direction: column;
  align-items: stretch;
  justify-content: flex-start;
  gap: 6px;
  flex: 1;
  text-align: left;
}
.sl-card__badge {
  margin: 0;
  font-family: var(--sl-font-mono);
  font-size: var(--sl-text-xs);
  font-weight: 500;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--sl-orange);
  text-align: center;
}
.sl-card__title {
  position: relative;
  margin: 0;
  padding-bottom: 15px;
  font-size: var(--sl-text-2xl);
  font-weight: 800;
  letter-spacing: -0.01em;
  color: var(--sl-green);
  text-align: center;
}
/* card accent: quiet arc under the title, kinetic on hover */
.sl-card__title::after {
  content: "";
  position: absolute;
  left: 50%;
  bottom: 0;
  width: 34px;
  height: 7px;
  transform: translateX(-50%);
  border-top: 2px solid var(--sl-arc);
  border-radius: 50% 50% 0 0 / 100% 100% 0 0;
}
.sl-card--featured .sl-card__title::after {
  border-top-color: rgba(var(--sl-cream-rgb), 0.35);
}
.sl-card:hover .sl-card__title::after {
  width: 56px;
  border-top-color: var(--sl-orange);
}
.sl-card--featured:hover .sl-card__title::after {
  border-top-color: var(--sl-accent-hover);
}
.sl-card__desc {
  margin: 0;
  max-width: 46ch;
  font-size: var(--sl-text-base);
  line-height: 1.5;
  color: var(--sl-ink-soft);
  flex: 1;
}
.sl-card__price {
  margin: 6px 0 0;
  font-size: var(--sl-text-xl);
  font-weight: 700;
  font-variant-numeric: tabular-nums;
  text-align: center;
}
.sl-card__note {
  margin: 0;
  font-size: var(--sl-text-sm);
  color: var(--sl-ink-muted);
  text-align: center;
}
@media (prefers-reduced-motion: no-preference) {
  .sl-card { transition: transform .22s ease, box-shadow .22s ease, border-color .22s ease; }
  .sl-card__title::after { transition: width .22s ease, border-color .22s ease; }
  .sl-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--sl-shadow-card-hover);
  }
}
@media (max-width: 749px) {
  .sl-shop__sub { text-align: center; }
  .sl-shop__grid { grid-template-columns: 1fr; }
  .sl-card__media-label {
    top: 12px;
    left: 50%;
    max-width: calc(100% - 24px);
    transform: translateX(-50%);
    text-align: center;
  }
  .sl-card__body {
    align-items: center;
    text-align: center;
  }
  .sl-card__desc {
    max-width: 40ch;
    margin-inline: auto;
    text-align: center;
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Product grid",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Section anchor id", "default": "shop" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Start with CaddieInsight" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Buy Pro here, then open CaddieInsight to use it" },
    { "type": "checkbox", "id": "membership_section", "label": "Personalize this as a membership section", "default": false }
  ],
  "blocks": [
    {
      "type": "product_card",
      "name": "Product card",
      "settings": [
        { "type": "text", "id": "badge", "label": "Badge", "default": "MEMBERSHIP" },
        { "type": "text", "id": "title", "label": "Title", "default": "CaddieInsight Pro" },
        { "type": "textarea", "id": "description", "label": "Description", "default": "Unlimited swing analyses, an annotated coach replay for every swing, and progress tracking across sessions so each range visit builds on the last." },
        { "type": "text", "id": "price_text", "label": "Price text", "info": "Leave blank when using the linked product's live price." },
        { "type": "text", "id": "price_note", "label": "Price note", "info": "Small line under the price, e.g. plan lengths." },
        { "type": "url", "id": "url", "label": "Card link" },
        { "type": "product", "id": "product", "label": "Linked product (optional)", "info": "Link a real product to pull its title, URL and price." },
        { "type": "checkbox", "id": "use_product_price", "label": "Use the linked product's live price", "default": false },
        { "type": "select", "id": "member_visibility", "label": "Member visibility", "options": [
          { "value": "all", "label": "Everyone" },
          { "value": "signed_out", "label": "Signed-out visitors only" },
          { "value": "pro_offer", "label": "Hide from Pro members" }
        ], "default": "all" },
        { "type": "image_picker", "id": "image", "label": "Card image", "info": "Leave blank to show the striped placeholder." },
        { "type": "text", "id": "image_label", "label": "Image label", "info": "Short plan name shown over the image. Leave blank to use the card title." },
        { "type": "text", "id": "placeholder_label", "label": "Placeholder caption", "default": "product art" },
        { "type": "checkbox", "id": "warm_placeholder", "label": "Warm (tan) placeholder stripes", "default": false },
        { "type": "checkbox", "id": "featured", "label": "Feature this plan", "default": false }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Product grid",
      "blocks": [
        {
          "type": "product_card",
          "settings": {
            "badge": "MEMBERSHIP",
            "title": "CaddieInsight Pro",
            "description": "Unlimited swing analyses, an annotated coach replay for every swing, and progress tracking across sessions so each range visit builds on the last.",
            "use_product_price": true,
            "member_visibility": "pro_offer",
            "image_label": "CaddieInsight Pro",
            "placeholder_label": "pro membership art",
            "warm_placeholder": false
          }
        },
        {
          "type": "product_card",
          "settings": {
            "badge": "FREE PLAN",
            "title": "Try CaddieInsight Free",
            "description": "One complete swing analysis each month, with saved club context, coaching priorities, and a measurable practice plan. No card required.",
            "price_text": "$0",
            "price_note": "No card required",
            "member_visibility": "signed_out",
            "image_label": "CaddieInsight Free",
            "placeholder_label": "free plan report strip",
            "warm_placeholder": true
          }
        }
      ]
    }
  ]
}
{% endschema %}
