{%- liquid
  assign contact_form_id = 'sl-contact-form-' | append: section.id
  assign name_id = contact_form_id | append: '-name'
  assign email_id = contact_form_id | append: '-email'
  assign body_id = contact_form_id | append: '-body'
  assign order_id = contact_form_id | append: '-order'
  assign subject_name = 'contact[About]'

  # The routes are authored as one line so the set can change without a schema
  # migration. The FIRST route is the one that reveals the order-number field —
  # positional rather than matched on the word "order", because matching on
  # copy breaks the moment somebody rewords the label.
  assign routes = section.settings.routes | default: 'An order, My membership, A swing report, Something else' | split: ','
-%}

<div class="sl-wrap sl-main-contact">
  <header class="sl-main-contact__head">
    <p class="sl-eyebrow">{{ section.settings.eyebrow | default: 'Support' }}</p>
    <h1 class="sl-main-contact__title">{{ section.settings.heading | default: page.title }}</h1>
    {%- if section.settings.intro != blank -%}
      <p class="sl-main-contact__intro">{{ section.settings.intro }}</p>
    {%- endif -%}
  </header>

  {%- if page.content != blank -%}
    <div class="sl-main-contact__content sl-rte">{{ page.content }}</div>
  {%- endif -%}

  <div class="sl-main-contact__grid">
    <div class="sl-main-contact__col">
  {% form 'contact', class: 'sl-main-contact__form', id: contact_form_id %}
    {%- if form.posted_successfully? -%}
      <p class="sl-main-contact__success" role="status">
        {{ section.settings.success_text | default: 'Message received. A real person replies, usually within one business day.' }}
      </p>
    {%- else -%}
      <p class="sl-mono-label sl-main-contact__form-label">Send a message</p>
      {%- if form.errors -%}
        <p class="sl-main-contact__errors" role="alert">
          {{ section.settings.error_text | default: 'Your message could not be sent. Please fix the highlighted field and try again.' }}
        </p>
      {%- endif -%}

      {%- comment -%}
        The router. It is a real radio group in a fieldset rather than a
        <select>, because its second job is to reveal the order-number field
        and a native select cannot be styled or matched on without script.
        The value rides along in the notification email under "About", which
        is what makes one inbox behave like several.
      {%- endcomment -%}
      {%- if routes.size > 0 -%}
        <fieldset class="sl-main-contact__routes">
          <legend class="sl-label">{{ section.settings.routes_label | default: 'What is it about?' }}</legend>
          <div class="sl-main-contact__route-row">
            {%- for route in routes -%}
              {%- assign route_label = route | strip -%}
              {%- if route_label != blank -%}
                <label class="sl-main-contact__route"{% if forloop.first %} data-reveals-order{% endif %}>
                  <input type="radio"
                         name="{{ subject_name }}"
                         value="{{ route_label | escape }}"
                         {% if forloop.first %}checked{% endif %}>
                  <span>{{ route_label }}</span>
                </label>
              {%- endif -%}
            {%- endfor -%}
          </div>
        </fieldset>
      {%- endif -%}

      <div class="sl-main-contact__field">
        <label class="sl-label" for="{{ name_id }}">Name</label>
        <input
          id="{{ name_id }}"
          class="sl-input"
          type="text"
          name="contact[name]"
          value="{{ form.name | escape }}"
          autocomplete="name">
      </div>

      <div class="sl-main-contact__field">
        <label class="sl-label" for="{{ email_id }}">Email</label>
        <input
          id="{{ email_id }}"
          class="sl-input"
          type="email"
          name="contact[email]"
          value="{{ form.email | escape }}"
          autocomplete="email"
          autocorrect="off"
          autocapitalize="off"
          {% if form.errors contains 'email' %}aria-invalid="true" aria-describedby="{{ email_id }}-error"{% endif %}
          required>
        {%- if form.errors contains 'email' -%}
          <p id="{{ email_id }}-error" class="sl-main-contact__field-error">
            {{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}.
          </p>
        {%- endif -%}
      </div>

      {%- comment -%}
        Shown only for the order route, and hidden with display:none rather
        than opacity or visibility so it leaves the tab order too — a field
        nobody can see but keyboard users still land in is worse than no
        conditional at all. It is never required, so hiding it can never block
        a submit.

        :has() rather than script: the reveal is presentation, and a JS reveal
        would leave the field hidden for the seconds before hydration on the
        page most likely to be opened by somebody already annoyed.
      {%- endcomment -%}
      <div class="sl-main-contact__field sl-main-contact__order">
        <label class="sl-label" for="{{ order_id }}">Order number</label>
        <input
          id="{{ order_id }}"
          class="sl-input"
          type="text"
          name="contact[Order number]"
          placeholder="#CI-10482"
          autocomplete="off"
          aria-describedby="{{ order_id }}-hint">
        <p id="{{ order_id }}-hint" class="sl-main-contact__hint">On your confirmation email.</p>
      </div>

      <div class="sl-main-contact__field">
        <label class="sl-label" for="{{ body_id }}">Message</label>
        <textarea
          id="{{ body_id }}"
          class="sl-input sl-main-contact__textarea"
          name="contact[body]"
          rows="6"
          {% if form.errors contains 'body' %}aria-invalid="true" aria-describedby="{{ body_id }}-error"{% endif %}
          required>{{ form.body | escape }}</textarea>
        {%- if form.errors contains 'body' -%}
          <p id="{{ body_id }}-error" class="sl-main-contact__field-error">
            {{ form.errors.translated_fields.body | capitalize }} {{ form.errors.messages.body }}.
          </p>
        {%- endif -%}
      </div>

      <button type="submit" class="sl-btn sl-btn--primary sl-main-contact__submit">Send message</button>
      {%- if section.settings.privacy_note != blank -%}
        <p class="sl-main-contact__privacy">{{ section.settings.privacy_note }}</p>
      {%- endif -%}
    {%- endif -%}
  {% endform %}
    </div>

    {%- comment -%}
      The aside answers the message before it is written. Most first contacts
      are about filming setup, a swing that was not detected, or how Pro
      unlocks after checkout — all three are already answered in the FAQ, so
      the deflection card sits above the address rather than below it.
    {%- endcomment -%}
    <aside class="sl-main-contact__aside">
      {%- if section.settings.deflect_body != blank -%}
        <div class="sl-main-contact__card sl-blueprint">
          <i class="sl-corner sl-corner--tl" aria-hidden="true"></i>
          <i class="sl-corner sl-corner--tr" aria-hidden="true"></i>
          <i class="sl-corner sl-corner--bl" aria-hidden="true"></i>
          <i class="sl-corner sl-corner--br" aria-hidden="true"></i>
          <p class="sl-mono-label">{{ section.settings.deflect_label | default: 'Before you write' }}</p>
          <p class="sl-main-contact__card-body">{{ section.settings.deflect_body }}</p>
          {%- assign faq_page = pages['faq'] -%}
          {%- if faq_page.url != blank -%}
            <a class="sl-btn sl-btn--outline sl-btn--sm" href="{{ faq_page.url }}">Read the FAQ</a>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if section.settings.support_email != blank -%}
        <dl class="sl-main-contact__direct">
          <div>
            <dt>Everything</dt>
            <dd><a href="mailto:{{ section.settings.support_email }}">{{ section.settings.support_email }}</a></dd>
          </div>
          {%- if section.settings.hours != blank -%}
            <div>
              <dt>Hours</dt>
              <dd>{{ section.settings.hours }}</dd>
            </div>
          {%- endif -%}
        </dl>
      {%- endif -%}

      {%- if section.settings.returns_note != blank -%}
        <p class="sl-main-contact__warn">{{ section.settings.returns_note }}</p>
      {%- endif -%}
    </aside>
  </div>
</div>

{% stylesheet %}
.sl-main-contact {
  padding-top: 48px;
  padding-bottom: 72px;
}
/* The form column keeps the old 760px measure — a message box wider than that
   invites a wall of text nobody wants to read or write. The aside is what the
   extra width buys. */
.sl-main-contact__grid {
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  gap: var(--sl-space-7);
  align-items: start;
}
@media (min-width: 1000px) {
  .sl-main-contact__grid { grid-template-columns: minmax(0, 760px) minmax(0, 1fr); gap: var(--sl-space-8); }
}
.sl-main-contact__col { min-width: 0; }

.sl-main-contact__routes { margin: 0 0 var(--sl-space-5); padding: 0; border: 0; }
.sl-main-contact__route-row { display: flex; flex-wrap: wrap; gap: var(--sl-space-2); margin-top: var(--sl-space-2); }
.sl-main-contact__route { position: relative; }
.sl-main-contact__route input {
  position: absolute;
  opacity: 0;
  width: 0;
  height: 0;
  pointer-events: none;
}
.sl-main-contact__route span {
  display: inline-flex;
  align-items: center;
  min-height: 40px;
  padding: 0 var(--sl-space-4);
  border: 1px solid var(--sl-control-border);
  color: var(--sl-ink);
  font-size: var(--sl-text-sm);
  cursor: pointer;
}
.sl-main-contact__route:hover span { background: rgba(var(--sl-wash-rgb), 0.06); }
.sl-main-contact__route input:checked + span {
  background: var(--sl-green-btn);
  border-color: var(--sl-green-btn);
  color: var(--sl-green-ink);
}
/* The radio is visually hidden, so the ring has to be put back on something
   the eye can find — without this the group is unusable by keyboard. */
.sl-main-contact__route input:focus-visible + span {
  outline: 2px solid var(--sl-focus);
  outline-offset: 2px;
}

/* Hidden until the order route is chosen. display:none, so it leaves the tab
   order with it.

   BOTH CLASSES IN THE SELECTOR, deliberately. The element is
   `.sl-main-contact__field .sl-main-contact__order`, and __field sets
   `display: grid` further down this same stylesheet — equal specificity, later
   rule wins, so a single-class hide lost and the field stayed visible on every
   route. It looked like the :has() had failed; it had not. */
.sl-main-contact__field.sl-main-contact__order { display: none; }
.sl-main-contact__form:has([data-reveals-order] input:checked) .sl-main-contact__field.sl-main-contact__order { display: grid; }
.sl-main-contact__hint,
.sl-main-contact__privacy {
  margin: var(--sl-space-2) 0 0;
  color: var(--sl-ink-muted);
  font-size: var(--sl-text-xs);
}
.sl-main-contact__privacy { margin-top: var(--sl-space-4); }

.sl-main-contact__aside { display: grid; gap: var(--sl-space-5); }
.sl-main-contact__card { padding: var(--sl-card-inset); background: var(--sl-orange-soft); }
.sl-main-contact__card-body {
  margin: var(--sl-space-2) 0 var(--sl-space-4);
  color: var(--sl-ink);
  font-size: var(--sl-text-sm);
  line-height: 1.55;
}
.sl-main-contact__direct { margin: 0; border-top: 1px solid var(--sl-border-strong); }
.sl-main-contact__direct > div {
  display: grid;
  grid-template-columns: minmax(0, 110px) minmax(0, 1fr);
  gap: var(--sl-space-3);
  padding: var(--sl-space-3) 0;
  border-bottom: 1px solid var(--sl-border);
}
.sl-main-contact__direct dt {
  color: var(--sl-ink-muted);
  font-family: var(--sl-font-mono);
  font-size: var(--sl-text-xs);
  letter-spacing: 0.08em;
  text-transform: uppercase;
}
.sl-main-contact__direct dd { margin: 0; font-size: var(--sl-text-sm); word-break: break-word; }
.sl-main-contact__warn {
  margin: 0;
  color: var(--sl-ink-soft);
  font-size: var(--sl-text-xs);
  line-height: 1.55;
}

.sl-main-contact__head { margin: 0 0 8px; }


.sl-main-contact__title {
  margin: 0;
  font-size: var(--sl-text-3xl);
  font-weight: 600;
  letter-spacing: -0.02em;
  line-height: 1.1;
  color: var(--sl-green);
  text-wrap: balance;
}

.sl-main-contact__intro {
  max-width: 56ch;
  margin: 14px 0 0;
  font-size: var(--sl-text-base);
  line-height: 1.6;
  color: var(--sl-ink-soft);
  text-wrap: pretty;
}

.sl-main-contact__content { margin-top: 18px; }

.sl-main-contact__form {
  margin-top: 28px;
  padding: var(--sl-card-inset);
  display: grid;
  gap: 18px;
  background: var(--sl-bg-card);
  border: 1px solid var(--sl-border);
  border-radius: var(--sl-radius-lg);
}

/* mono specimen label with a trailing hairline, pinning the form card */
.sl-main-contact__form-label {
  display: flex;
  align-items: center;
  gap: 12px;
  margin: 0;
}

.sl-main-contact__form-label::after {
  content: "";
  flex: 1;
  height: 1px;
  background: var(--sl-border);
}

.sl-main-contact__field {
  display: grid;
  gap: 0;
  min-width: 0;
}

.sl-main-contact__field .sl-input { width: 100%; }

/* the focused field's label picks up the action green */
.sl-main-contact__field:focus-within .sl-label {
  color: var(--sl-green-btn);
}

.sl-main-contact__textarea {
  resize: vertical;
  min-height: 140px;
}

.sl-main-contact__submit {
  justify-self: start;
  min-width: min(100%, 220px);
}

.sl-main-contact__success {
  margin: 0;
  padding: 16px 18px;
  border: 1px solid rgba(26, 92, 56, 0.35);
  border-left: 4px solid var(--sl-green-btn);
  border-radius: var(--sl-radius-sm);
  background: rgba(26, 92, 56, 0.07);
  font-size: var(--sl-text-base);
  font-weight: 600;
  color: var(--sl-green);
  line-height: 1.55;
}

.sl-main-contact__errors {
  margin: 0;
  padding: 12px 14px;
  border-left: 4px solid var(--sl-orange);
  border-radius: var(--sl-radius-sm);
  background: #fff8ed;
  color: var(--sl-ink);
  font-size: var(--sl-text-sm);
  line-height: 1.5;
}

.sl-main-contact__field-error {
  margin: 6px 0 0;
  font-size: var(--sl-text-sm);
  color: #9c3518;
}

@media (max-width: 749px) {
  .sl-main-contact__head { text-align: center; }
  .sl-main-contact__intro { margin-inline: auto; }
  .sl-main-contact__submit {
    justify-self: center;
    width: min(100%, 320px);
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Contact page",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Support"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Leave blank to use the page title."
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Intro",
      "info": "Short line under the heading. Page content, if any, renders above the form."
    },
    { "type": "header", "content": "Routing" },
    { "type": "text", "id": "routes_label", "label": "Router label", "default": "What is it about?" },
    {
      "type": "text",
      "id": "routes",
      "label": "Routes",
      "info": "Comma separated. The value rides along in the notification email under \"About\". The FIRST route reveals the order-number field.",
      "default": "An order, My membership, A swing report, Something else"
    },
    { "type": "header", "content": "Aside" },
    { "type": "text", "id": "deflect_label", "label": "Deflection label", "default": "Before you write" },
    {
      "type": "textarea",
      "id": "deflect_body",
      "label": "Deflection body",
      "default": "Most first messages are about filming setup, why a swing was not detected, or how Pro unlocks after checkout. All three are answered in the FAQ."
    },
    {
      "type": "text",
      "id": "support_email",
      "label": "Support address",
      "info": "One inbox for orders, gear, memberships, returns and press.",
      "default": "inquiry@caddieinsight.com"
    },
    { "type": "text", "id": "hours", "label": "Hours", "default": "Mon–Fri, 09:00–17:00 ET" },
    {
      "type": "textarea",
      "id": "returns_note",
      "label": "Returns note",
      "default": "Do not ship gear back without a return authorisation — partner warehouses reject unlabelled parcels. Start a return from your order email."
    },
    { "type": "header", "content": "Messages" },
    {
      "type": "text",
      "id": "privacy_note",
      "label": "Privacy note",
      "default": "We never share your email."
    },
    {
      "type": "text",
      "id": "success_text",
      "label": "Success message",
      "default": "Message received. A real person replies, usually within one business day."
    },
    {
      "type": "text",
      "id": "error_text",
      "label": "Error message",
      "default": "Your message could not be sent. Please fix the highlighted field and try again."
    }
  ]
}
{% endschema %}
