{%- liquid
  assign menu = section.settings.menu
  assign app_url = section.settings.app_url
  assign gear_url = routes.collections_url | append: '/swinglab-gear'
  assign pro_product = all_products['swinglab-pro']
  assign cap_product = all_products['swinglab-performance-cap']
  assign method_page = pages['the-swinglab-method']
  assign how_page = pages['how-swinglab-works']
  assign faq_page = pages['faq']
  assign shipping_page = pages['shipping-returns']
  assign about_page = pages['about']
  assign newsletter_form_id = 'sl-footer-form-' | append: section.id
  assign newsletter_email_id = 'sl-footer-email-' | append: section.id
  assign newsletter_message_id = 'sl-footer-message-' | append: section.id

  comment
    A menu whose top-level links have children replaces the built-in
    Shop / Learn / Support columns. A flat menu keeps the built-in
    columns and renders as a compact link row above the fine print.
  endcomment
  assign menu_is_nested = false
  if menu != blank
    for link in menu.links
      if link.links.size > 0
        assign menu_is_nested = true
      endif
    endfor
  endif
-%}
<footer class="sl-footer">
  <div class="sl-wrap">
    <div class="sl-footer__grid">
      <div class="sl-footer__brand">
        <p class="sl-footer__wordmark">{{ section.settings.logo_text | default: 'CADDIEINSIGHT' }}</p>
        {%- if section.settings.tagline != blank -%}
          <p class="sl-footer__tagline">{{ section.settings.tagline }}</p>
        {%- endif -%}
        {%- if app_url != blank -%}
          <a class="sl-footer__applink" href="{{ app_url }}">Open CaddieInsight</a>
        {%- endif -%}
      </div>

      {%- if menu_is_nested -%}
        {%- for link in menu.links -%}
          {%- if link.links.size > 0 -%}
            <nav class="sl-footer__col" aria-label="{{ link.title | escape }}">
              <p class="sl-footer__head">{{ link.title }}</p>
              {%- for child in link.links -%}
                <a class="sl-footer__link" href="{{ child.url }}"{% if child.url contains '/products/swinglab-pro' %} data-app-pro-sales-link{% endif %}>{{ child.title }}</a>
              {%- endfor -%}
            </nav>
          {%- endif -%}
        {%- endfor -%}
      {%- else -%}
        <nav class="sl-footer__col" aria-label="Shop">
          <p class="sl-footer__head">Shop</p>
          <a class="sl-footer__link" href="{{ gear_url }}">Training gear</a>
          {%- if pro_product != blank -%}<a class="sl-footer__link" href="{{ pro_product.url }}" data-app-pro-sales-link>CaddieInsight Pro</a>{%- endif -%}
          {%- if cap_product != blank -%}<a class="sl-footer__link" href="{{ cap_product.url }}">Performance cap</a>{%- endif -%}
        </nav>
        <nav class="sl-footer__col" aria-label="Learn">
          <p class="sl-footer__head">Learn</p>
          {%- if method_page != blank -%}<a class="sl-footer__link" href="{{ method_page.url }}">The Method</a>{%- endif -%}
          {%- if how_page != blank -%}<a class="sl-footer__link" href="{{ how_page.url }}">How CaddieInsight works</a>{%- endif -%}
          {%- if faq_page != blank -%}<a class="sl-footer__link" href="{{ faq_page.url }}">FAQ</a>{%- endif -%}
        </nav>
        <nav class="sl-footer__col" aria-label="Support">
          <p class="sl-footer__head">Support</p>
          <a class="sl-footer__link" href="{{ routes.account_url }}">Orders and subscriptions</a>
          {%- if shipping_page != blank -%}<a class="sl-footer__link" href="{{ shipping_page.url }}">Shipping and returns</a>{%- endif -%}
          {%- if about_page != blank -%}<a class="sl-footer__link" href="{{ about_page.url }}">About</a>{%- endif -%}
        </nav>
      {%- endif -%}
    </div>

    <div class="sl-footer__newsletter">
      <div class="sl-footer__news-copy">
        <p class="sl-footer__head">{{ section.settings.newsletter_heading | default: 'The Practice Letter' }}</p>
        <p class="sl-footer__news-sub">{{ section.settings.newsletter_text | default: 'One practical drill each week.' }}</p>
      </div>
      {% form 'customer', class: 'sl-footer__form', id: newsletter_form_id %}
        <input type="hidden" name="contact[tags]" value="newsletter">
        {%- if form.posted_successfully? -%}
          <p id="{{ newsletter_message_id }}" class="sl-footer__form-ok" role="status" aria-live="polite" aria-atomic="true">You’re in. Look for the next Practice Letter in your inbox.</p>
        {%- else -%}
          <label class="visually-hidden" for="{{ newsletter_email_id }}">Email address</label>
          <input
            id="{{ newsletter_email_id }}"
            class="sl-footer__input"
            type="email"
            name="contact[email]"
            value="{{ form.email | escape }}"
            placeholder="you@example.com"
            autocomplete="email"
            autocorrect="off"
            autocapitalize="off"
            {% if form.errors %}aria-invalid="true" aria-describedby="{{ newsletter_message_id }}"{% endif %}
            required
          >
          <button type="submit" class="sl-btn sl-btn--sm sl-btn--light">Join the list</button>
          {%- if form.errors -%}
            <p id="{{ newsletter_message_id }}" class="sl-footer__form-err" role="alert" aria-live="assertive" aria-atomic="true">Please enter a valid email address.</p>
          {%- endif -%}
        {%- endif -%}
      {% endform %}
    </div>

    {%- if shop.policies.size > 0 -%}
      <nav class="sl-footer__policies" aria-label="Store policies">
        <ul class="sl-footer__policies-list">
          {%- for policy in shop.policies -%}
            {%- if policy != blank -%}
              <li><a class="sl-footer__link" href="{{ policy.url }}">{{ policy.title | escape }}</a></li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      </nav>
    {%- endif -%}

    <div class="sl-footer__fine">
      {%- if section.settings.disclaimer != blank -%}
        <p class="sl-footer__disclaimer">{{ section.settings.disclaimer }}</p>
      {%- endif -%}
      <p class="sl-footer__copyright">&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}</p>
    </div>
  </div>
</footer>

{% stylesheet %}
.sl-footer {
  background: var(--sl-footer);
  color: var(--sl-footer-ink);
  padding-top: clamp(48px, 7vw, 80px);
  padding-bottom: clamp(28px, 4vw, 40px);
  font-size: 14.5px;
}
.sl-footer__grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 36px;
  padding-bottom: clamp(32px, 5vw, 56px);
}
@media (min-width: 640px) {
  .sl-footer__grid { grid-template-columns: repeat(2, 1fr); }
}
@media (min-width: 980px) {
  .sl-footer__grid { grid-template-columns: 1.5fr 1fr 1fr 1fr; gap: 32px; }
}
.sl-footer__brand { max-width: 340px; }
.sl-footer__wordmark {
  margin: 0 0 12px;
  font-weight: 900;
  font-size: 19px;
  letter-spacing: 0.08em;
  color: var(--sl-green-ink);
}
.sl-footer__tagline {
  margin: 0 0 16px;
  line-height: 1.6;
  color: #a8b8ad;
}
.sl-footer__applink {
  display: inline-block;
  color: var(--sl-green-ink);
  text-decoration: none;
  font-weight: 600;
  font-size: 14px;
  border-bottom: 1px solid var(--sl-orange);
  padding-bottom: 2px;
}
.sl-footer__applink:hover { color: #ffffff; }
.sl-footer__col {
  display: flex;
  flex-direction: column;
  gap: 10px;
  align-items: flex-start;
}
.sl-footer__head {
  margin: 0 0 4px;
  font-family: var(--sl-font-mono);
  font-size: 11px;
  font-weight: 500;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: #a8b8ad;
}
.sl-footer__link {
  color: #b7c5ba;
  text-decoration: none;
  font-size: 14.5px;
}
.sl-footer__link:hover { color: var(--sl-green-ink); }
.sl-footer__newsletter {
  border-top: 1px solid rgba(159, 176, 164, 0.18);
  padding: 26px 0 28px;
  display: flex;
  flex-wrap: wrap;
  gap: 18px 40px;
  align-items: center;
  justify-content: space-between;
}
.sl-footer__news-copy .sl-footer__head { margin: 0 0 6px; }
.sl-footer__news-sub {
  margin: 0;
  color: var(--sl-green-ink);
  font-size: 16px;
  font-weight: 600;
}
.sl-footer__form {
  display: flex;
  gap: 10px;
  flex-wrap: wrap;
  align-items: center;
  flex: 0 1 420px;
  min-width: min(100%, 300px);
}
.sl-footer__input {
  flex: 1 1 200px;
  min-width: 0;
  font: inherit;
  font-size: 14.5px;
  color: var(--sl-green-ink);
  background: rgba(233, 242, 236, 0.06);
  border: 1px solid rgba(159, 176, 164, 0.35);
  border-radius: 999px;
  padding: 11px 18px;
}
.sl-footer__input::placeholder { color: #a8b8ad; }
.sl-footer__input:focus {
  outline: 3px solid #ffad62;
  outline-offset: 3px;
  border-color: transparent;
}
.sl-footer__form-ok { margin: 0; color: var(--sl-green-ink); }
.sl-footer__form-err {
  margin: 4px 0 0;
  width: 100%;
  font-size: 13px;
  color: #e8a06a;
}
.sl-footer__policies {
  border-top: 1px solid rgba(159, 176, 164, 0.18);
  padding: 20px 0 24px;
}
.sl-footer__policies-list {
  margin: 0;
  padding: 0;
  display: flex;
  flex-wrap: wrap;
  gap: 10px 22px;
  list-style: none;
}
.sl-footer__fine {
  border-top: 1px solid rgba(159, 176, 164, 0.18);
  padding-top: 22px;
  display: flex;
  flex-wrap: wrap;
  gap: 8px 32px;
  justify-content: space-between;
  align-items: baseline;
}
.sl-footer__disclaimer {
  margin: 0;
  font-size: 12.5px;
  font-style: italic;
  color: #a8b8ad;
  max-width: 640px;
}
.sl-footer__copyright {
  margin: 0;
  font-family: var(--sl-font-mono);
  font-size: 12px;
  letter-spacing: 0.06em;
  color: #a8b8ad;
  white-space: nowrap;
}
@media (max-width: 749px) {
  .sl-footer__grid {
    grid-template-columns: 1fr;
    gap: 30px;
    text-align: center;
  }
  .sl-footer__brand {
    margin-inline: auto;
    text-align: center;
  }
  .sl-footer__applink {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .sl-footer__col {
    align-items: center;
    gap: 0;
    text-align: center;
  }
  .sl-footer__col .sl-footer__link,
  .sl-footer__policies-list .sl-footer__link {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .sl-footer__newsletter {
    flex-direction: column;
    justify-content: center;
    text-align: center;
  }
  .sl-footer__form {
    width: 100%;
    max-width: 420px;
    margin-inline: auto;
    flex: 0 1 auto;
    flex-direction: column;
    justify-content: center;
  }
  .sl-footer__input {
    width: 100%;
    min-height: 44px;
    flex-basis: auto;
    text-align: center;
  }
  .sl-footer__form .sl-btn {
    width: min(100%, 320px);
    min-height: 44px;
    justify-content: center;
  }
  .sl-footer__form-ok,
  .sl-footer__form-err {
    text-align: center;
  }
  .sl-footer__policies-list { justify-content: center; }
  .sl-footer__fine {
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
  }
  .sl-footer__disclaimer { margin-inline: auto; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "text",
      "id": "logo_text",
      "label": "Wordmark",
      "default": "CADDIEINSIGHT"
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Positioning line",
      "default": "One priority. One practice plan. Proof when you re‑film."
    },
    {
      "type": "text",
      "id": "app_url",
      "label": "App URL",
      "default": "https://app.caddieinsight.com",
      "info": "The \"Open CaddieInsight\" link points here. Leave empty to hide it."
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Footer menu (optional)",
      "info": "A menu with nested links replaces the built-in Shop, Learn, and Support columns."
    },
    {
      "type": "text",
      "id": "newsletter_heading",
      "label": "Newsletter heading",
      "default": "The Practice Letter"
    },
    {
      "type": "text",
      "id": "newsletter_text",
      "label": "Newsletter supporting line",
      "default": "One practical drill each week."
    },
    {
      "type": "textarea",
      "id": "disclaimer",
      "label": "Disclaimer",
      "default": "Supported 2D movement and timing estimates from phone video. Face-on supports movement coaching; down-the-line currently supports timing only."
    }
  ]
}
{% endschema %}
