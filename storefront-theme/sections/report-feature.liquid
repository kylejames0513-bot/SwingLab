<section id="{{ section.settings.anchor | default: 'report' }}" class="sl-report">
  <div class="sl-report__inner sl-wrap">
  <div class="sl-report__copy sl-reveal">
    <p class="sl-report__eyebrow">{{ 'homepage.report.eyebrow' | t }}</p>
    <h2 class="sl-h2">{{ section.settings.heading | default: 'Numbers you can act on' }}</h2>
    {%- if section.settings.body != blank -%}
      <p class="sl-report__body">{{ section.settings.body }}</p>
    {%- endif -%}
    {%- if section.blocks.size > 0 -%}
      <ul class="sl-check-list sl-report__list">
        {%- for block in section.blocks -%}
          <li {{ block.shopify_attributes }}>{{ block.settings.text }}</li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>

  <div class="sl-report__media-wrap sl-reveal sl-reveal--d1">
    <div class="sl-report__card" aria-describedby="ReportDisclosure-{{ section.id }}">
      <div class="sl-report__head">
        <span class="sl-report__file">{{ 'homepage.report.file_label' | t }}</span>
        <span class="sl-report__sample">{{ 'homepage.report.sample_label' | t }}</span>
      </div>

      <dl class="sl-report__proof">
        <div>
          <dt>{{ 'homepage.report.club_label' | t }}</dt>
          <dd>{{ 'homepage.report.club_value' | t }}</dd>
        </div>
        <div>
          <dt>{{ 'homepage.report.coach_label' | t }}</dt>
          <dd>{{ 'homepage.report.coach_value' | t }}</dd>
        </div>
        <div>
          <dt>{{ 'homepage.report.practice_label' | t }}</dt>
          <dd>{{ 'homepage.report.practice_value' | t }}</dd>
        </div>
      </dl>

      {%- assign strip = section.settings.image | default: images['caddieinsight-report-preview-136534a.png'] -%}
      {%- if strip -%}
        <img
          class="sl-report__strip"
          src="{{ strip | image_url: width: 1200 }}"
          srcset="{{ strip | image_url: width: 800 }} 800w, {{ strip | image_url: width: 1200 }} 1200w, {{ strip | image_url: width: 1600 }} 1600w"
          sizes="(max-width: 749px) calc(100vw - 88px), 560px"
          width="{{ strip.width }}"
          height="{{ strip.height }}"
          alt="{{ 'homepage.report.image_alt' | t | escape }}"
          loading="lazy"
          decoding="async">
      {%- endif -%}

      <div class="sl-report__foot">
        <p class="sl-report__note">{{ 'homepage.report.priority_note' | t }}</p>
        <span class="sl-chip">{{ 'homepage.report.plan_chip' | t }}</span>
      </div>
    </div>

    {%- if section.settings.caption != blank -%}
      <p class="sl-report__caption sl-mono-label">{{ section.settings.caption }}</p>
    {%- endif -%}
    <p id="ReportDisclosure-{{ section.id }}" class="sl-report__disclosure">{{ 'homepage.report.disclosure' | t }}</p>
    {%- if section.settings.sample_url != blank and section.settings.cta_label != blank -%}
      <a class="sl-btn sl-btn--outline sl-report__cta" href="{{ section.settings.sample_url }}">{{ section.settings.cta_label }}</a>
    {%- endif -%}
  </div>
  </div>
</section>

{% stylesheet %}
.sl-report {
  position: relative;
  overflow: hidden;
  background:
    radial-gradient(circle at 80% 50%, rgba(37, 111, 70, 0.22), transparent 34%),
    #06110c;
  color: #f5f2e9;
}
.sl-report__inner {
  padding-top: var(--sl-section-space);
  padding-bottom: var(--sl-section-space);
  display: grid;
  grid-template-columns: minmax(0, 0.82fr) minmax(0, 1.18fr);
  gap: clamp(38px, 6vw, 86px);
  align-items: center;
}
.sl-report__copy {
  min-width: 0;
}
.sl-report__eyebrow {
  margin: 0 auto 18px;
  color: #ff9a42;
  font-family: var(--sl-font-mono);
  font-size: var(--sl-eyebrow-size);
  font-weight: 500;
  letter-spacing: var(--sl-eyebrow-track);
}
.sl-report .sl-h2 {
  max-width: 11ch;
  margin-inline: auto;
  color: #f5f2e9;
  font-size: var(--sl-heading-display);
  font-weight: 900;
  letter-spacing: -0.048em;
  line-height: 0.98;
  text-align: center;
  text-wrap: balance;
}
.sl-report__body {
  max-width: 48ch;
  margin: 24px 0 0;
  font-size: 17px;
  line-height: 1.65;
  color: rgba(245, 242, 233, 0.7);
  text-align: left;
  text-wrap: pretty;
}
.sl-report__list {
  margin-top: 20px;
}
.sl-report .sl-check-list li {
  color: rgba(245, 242, 233, 0.72);
  text-align: left;
}
.sl-report__media-wrap {
  position: relative;
  z-index: 1;
  min-width: 0;
  text-align: center;
}
.sl-report__media-wrap::before {
  content: "";
  position: absolute;
  z-index: -1;
  inset: 12% -8% -10% 18%;
  border-radius: 50%;
  background: rgba(240, 122, 24, 0.18);
  filter: blur(70px);
}

/* the report card: one clean native rendering of a session report */
.sl-report__card {
  position: relative;
  isolation: isolate;
  overflow: hidden;
  background: var(--sl-bg-card);
  border: 1px solid var(--sl-border);
  border-radius: var(--sl-radius-lg);
  box-shadow:
    0 1px 2px rgba(6, 17, 12, 0.04),
    0 44px 90px -40px rgba(0, 0, 0, 0.9);
  padding: var(--sl-card-inset);
}
/* faint quarter-arc — the movement's mark, kept subordinate */
.sl-report__card::before {
  content: "";
  position: absolute;
  z-index: -1;
  top: -160px;
  right: -160px;
  width: 260px;
  height: 260px;
  border: 1.5px solid #e9e4d6;
  border-radius: 50%;
  pointer-events: none;
}

.sl-report__head {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px 12px;
  flex-wrap: wrap;
  padding-bottom: 12px;
  border-bottom: 1px solid var(--sl-border);
  text-align: center;
}
.sl-report__file {
  flex: 1 1 150px;
  min-width: 0;
  font-family: var(--sl-font-mono);
  font-size: 11px;
  font-weight: 500;
  letter-spacing: 0.16em;
  color: var(--sl-green);
  overflow-wrap: anywhere;
  text-align: center;
}
.sl-report__sample {
  font-family: var(--sl-font-mono);
  font-size: 10px;
  font-weight: 500;
  letter-spacing: 0.14em;
  color: var(--sl-ink-muted);
  background: var(--sl-bg-card);
  border: 1px solid var(--sl-border);
  border-radius: var(--sl-radius-control);
  padding: 3px 10px;
  white-space: nowrap;
}

.sl-report__proof {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 0;
  margin: 0;
  border-bottom: 1px solid var(--sl-border);
}
.sl-report__proof > div {
  min-width: 0;
  min-height: 94px;
  padding: var(--sl-dense-inset);
  display: grid;
  align-content: center;
  justify-content: center;
  text-align: center;
}
.sl-report__proof > div + div {
  border-left: 1px solid var(--sl-border);
}
.sl-report__proof dt {
  font-family: var(--sl-font-mono);
  font-size: 10.5px;
  font-weight: 500;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--sl-ink-muted);
}
.sl-report__proof dd {
  margin: 7px 0 0;
  font-size: 13.5px;
  line-height: 1.4;
  font-weight: 700;
  color: var(--sl-green);
}

.sl-report__strip {
  display: block;
  width: 100%;
  height: auto;
  border-radius: 10px;
  margin-top: 16px;
}

.sl-report__foot {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10px 14px;
  flex-wrap: wrap;
  margin-top: 14px;
  text-align: center;
}
.sl-report__note {
  margin: 0;
  font-style: italic;
  font-size: 13.5px;
  line-height: 1.5;
  color: var(--sl-ink-soft);
  flex: 1 1 260px;
  max-width: 44ch;
  text-align: left;
  text-wrap: pretty;
}
.sl-report__foot .sl-chip { flex: 0 0 auto; }

.sl-report__caption {
  display: block;
  margin: 14px 0 0;
  color: rgba(245, 242, 233, 0.56);
  text-align: left;
}
.sl-report__disclosure {
  max-width: 62ch;
  margin: 9px 0 0;
  font-size: 13px;
  line-height: 1.55;
  color: rgba(245, 242, 233, 0.66);
  text-align: left;
}
.sl-report__cta {
  display: flex;
  width: fit-content;
  margin: 20px 0 0;
  border-color: rgba(245, 242, 233, 0.46);
  color: #f5f2e9;
}
.sl-report__cta:hover {
  border-color: #f07a18;
  background: #f07a18;
  color: #06110c;
}

@media (max-width: 749px) {
  .sl-report__inner {
    grid-template-columns: 1fr;
    gap: clamp(34px, 9vw, 48px);
  }
  .sl-report__copy { text-align: center; }
  .sl-report__body {
    margin: 20px auto 0;
    text-align: center;
  }
  .sl-report__list {
    width: min(100%, 38ch);
    margin: 20px auto 0;
  }
  .sl-report__proof { grid-template-columns: 1fr; }
  .sl-report__proof > div {
    min-height: 76px;
    padding: var(--sl-dense-inset);
  }
  .sl-report__proof > div + div {
    border-left: 0;
    border-top: 1px solid var(--sl-border);
  }
  .sl-report__note {
    margin-inline: auto;
    text-align: center;
  }
  .sl-report__caption,
  .sl-report__disclosure {
    margin-inline: auto;
    text-align: center;
  }
  .sl-report__cta {
    width: min(100%, 320px);
    min-height: 44px;
    margin: 20px auto 0;
    justify-content: center;
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Report feature",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Section anchor id", "default": "report" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "See the priority before you practice." },
    { "type": "textarea", "id": "body", "label": "Body", "default": "Explore a sample report to see how CaddieInsight turns phone-video evidence into one priority, a focused drill, and a measurable pass mark." },
    { "type": "image_picker", "id": "image", "label": "Key-position strip image", "info": "Shown inside the report card. Leave blank to use the versioned CaddieInsight report preview." },
    { "type": "image_picker", "id": "detail_image", "label": "Detail image (unused)", "info": "No longer shown — kept so older templates stay valid." },
    { "type": "text", "id": "caption", "label": "Mono caption under media", "default": "SAMPLE REPORT · DEMONSTRATION DATA" },
    { "type": "text", "id": "cta_label", "label": "Sample link label", "default": "View the sample report" },
    { "type": "url", "id": "sample_url", "label": "Sample report link" }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "Bullet point",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Labeled key-position strip: address, top, impact, finish" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Report feature",
      "blocks": [
        { "type": "point", "settings": { "text": "See the selected club and capture context" } },
        { "type": "point", "settings": { "text": "Understand why one coaching priority comes first" } },
        { "type": "point", "settings": { "text": "Leave with a focused drill and measurable pass mark" } }
      ]
    }
  ]
}
{% endschema %}
