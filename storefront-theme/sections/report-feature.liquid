<section class="sl-report sl-wrap">
  <div class="sl-report__copy sl-reveal">
    <h2 class="sl-h2">{{ section.settings.heading | default: 'Numbers you can act on' }}</h2>
    {%- if section.settings.body != blank -%}
      <p class="sl-report__body">{{ section.settings.body }}</p>
    {%- endif -%}
    {%- if section.blocks.size > 0 -%}
      <ul class="sl-check-list sl-report__list">
        {%- for block in section.blocks -%}
          <li {{ block.shopify_attributes }}>{{ block.settings.text }}</li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>

  <div class="sl-report__media-wrap sl-reveal sl-reveal--d1">
    <div class="sl-report__card" aria-describedby="ReportDisclosure-{{ section.id }}">
      <div class="sl-report__head">
        <span class="sl-report__file">{{ 'homepage.report.file_label' | t }}</span>
        <span class="sl-report__sample">{{ 'homepage.report.sample_label' | t }}</span>
      </div>

      <dl class="sl-report__proof">
        <div>
          <dt>{{ 'homepage.report.club_label' | t }}</dt>
          <dd>{{ 'homepage.report.club_value' | t }}</dd>
        </div>
        <div>
          <dt>{{ 'homepage.report.coach_label' | t }}</dt>
          <dd>{{ 'homepage.report.coach_value' | t }}</dd>
        </div>
        <div>
          <dt>{{ 'homepage.report.practice_label' | t }}</dt>
          <dd>{{ 'homepage.report.practice_value' | t }}</dd>
        </div>
      </dl>

      {%- assign strip = section.settings.image | default: images['caddieinsight-report-preview-136534a.png'] -%}
      {%- if strip -%}
        <img
          class="sl-report__strip"
          src="{{ strip | image_url: width: 1200 }}"
          srcset="{{ strip | image_url: width: 800 }} 800w, {{ strip | image_url: width: 1200 }} 1200w, {{ strip | image_url: width: 1600 }} 1600w"
          sizes="(max-width: 749px) calc(100vw - 88px), 560px"
          width="{{ strip.width }}"
          height="{{ strip.height }}"
          alt="{{ 'homepage.report.image_alt' | t | escape }}"
          loading="lazy"
          decoding="async">
      {%- endif -%}

      <div class="sl-report__foot">
        <p class="sl-report__note">{{ 'homepage.report.priority_note' | t }}</p>
        <span class="sl-chip">{{ 'homepage.report.plan_chip' | t }}</span>
      </div>
    </div>

    {%- if section.settings.caption != blank -%}
      <p class="sl-report__caption sl-mono-label">{{ section.settings.caption }}</p>
    {%- endif -%}
    <p id="ReportDisclosure-{{ section.id }}" class="sl-report__disclosure">{{ 'homepage.report.disclosure' | t }}</p>
    {%- if section.settings.sample_url != blank and section.settings.cta_label != blank -%}
      <a class="sl-btn sl-btn--outline sl-report__cta" href="{{ section.settings.sample_url }}">{{ section.settings.cta_label }}</a>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
.sl-report {
  padding-top: clamp(32px, 4.5vw, 56px);
  padding-bottom: clamp(32px, 4.5vw, 56px);
  display: grid;
  grid-template-columns: 0.9fr 1.1fr;
  gap: clamp(24px, 4vw, 56px);
  align-items: center;
}
.sl-report__copy { min-width: 0; }
.sl-report__body {
  margin: 16px 0 0;
  font-size: 16.5px;
  line-height: 1.6;
  color: var(--sl-ink-soft);
  text-wrap: pretty;
}
.sl-report__list { margin-top: 20px; }
.sl-report__media-wrap { position: relative; min-width: 0; }

/* the report card: one clean native rendering of a session report */
.sl-report__card {
  position: relative;
  isolation: isolate;
  overflow: hidden;
  background: var(--sl-bg-card);
  border: 1px solid var(--sl-border);
  border-radius: var(--sl-radius-lg);
  box-shadow: var(--sl-shadow-card);
  padding: clamp(18px, 2.4vw, 26px);
}
/* faint quarter-arc — the movement's mark, kept subordinate */
.sl-report__card::before {
  content: "";
  position: absolute;
  z-index: -1;
  top: -160px;
  right: -160px;
  width: 260px;
  height: 260px;
  border: 1.5px solid #e9e4d6;
  border-radius: 50%;
  pointer-events: none;
}

.sl-report__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px 12px;
  flex-wrap: wrap;
  padding-bottom: 12px;
  border-bottom: 1px solid var(--sl-border);
}
.sl-report__file {
  flex: 1 1 150px;
  min-width: 0;
  font-family: var(--sl-font-mono);
  font-size: 11px;
  font-weight: 500;
  letter-spacing: 0.16em;
  color: var(--sl-green);
  overflow-wrap: anywhere;
}
.sl-report__sample {
  font-family: var(--sl-font-mono);
  font-size: 10px;
  font-weight: 500;
  letter-spacing: 0.14em;
  color: var(--sl-ink-muted);
  background: var(--sl-bg-card);
  border: 1px solid var(--sl-border);
  border-radius: 999px;
  padding: 3px 10px;
  white-space: nowrap;
}

.sl-report__proof {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 0;
  margin: 0;
  border-bottom: 1px solid var(--sl-border);
}
.sl-report__proof > div {
  min-width: 0;
  padding: 14px 12px 14px 0;
}
.sl-report__proof > div + div {
  border-left: 1px solid var(--sl-border);
  padding-left: 14px;
}
.sl-report__proof dt {
  font-family: var(--sl-font-mono);
  font-size: 10.5px;
  font-weight: 500;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--sl-ink-muted);
}
.sl-report__proof dd {
  margin: 7px 0 0;
  font-size: 13.5px;
  line-height: 1.4;
  font-weight: 700;
  color: var(--sl-green);
}

.sl-report__strip {
  display: block;
  width: 100%;
  height: auto;
  border-radius: 10px;
  margin-top: 16px;
}

.sl-report__foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px 14px;
  flex-wrap: wrap;
  margin-top: 14px;
}
.sl-report__note {
  margin: 0;
  font-style: italic;
  font-size: 13.5px;
  line-height: 1.5;
  color: var(--sl-ink-soft);
  flex: 1 1 260px;
  text-wrap: pretty;
}
.sl-report__foot .sl-chip { flex: 0 0 auto; }

.sl-report__caption {
  display: block;
  margin: 14px 0 0;
}
.sl-report__disclosure {
  margin: 9px 0 0;
  font-size: 13px;
  line-height: 1.55;
  color: var(--sl-ink-muted);
}
.sl-report__cta { margin-top: 18px; }

@media (max-width: 749px) {
  .sl-report { grid-template-columns: 1fr; }
  .sl-report__proof { grid-template-columns: 1fr; }
  .sl-report__proof > div { padding: 12px 0; }
  .sl-report__proof > div + div {
    border-left: 0;
    border-top: 1px solid var(--sl-border);
    padding-left: 0;
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Report feature",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "See the product before you sign up" },
    { "type": "textarea", "id": "body", "label": "Body", "default": "Open a real-engine sample built from synthetic measurements. It shows how CaddieInsight turns supported phone-video evidence into one priority, one practice target, and a clearer next check." },
    { "type": "image_picker", "id": "image", "label": "Key-position strip image", "info": "Shown inside the report card. Leave blank to use the versioned CaddieInsight report preview." },
    { "type": "image_picker", "id": "detail_image", "label": "Detail image (unused)", "info": "No longer shown — kept so older templates stay valid." },
    { "type": "text", "id": "caption", "label": "Mono caption under media", "default": "ILLUSTRATED PREVIEW · LINKED REAL-ENGINE SAMPLE · SYNTHETIC INPUTS" },
    { "type": "text", "id": "cta_label", "label": "Sample link label", "default": "Open the full sample report" },
    { "type": "url", "id": "sample_url", "label": "Sample report link" }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "Bullet point",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Labeled key-position strip: address, top, impact, finish" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Report feature",
      "blocks": [
        { "type": "point", "settings": { "text": "The linked full report uses the same engine as customer sessions" } },
        { "type": "point", "settings": { "text": "The selected club and capture context stay with the report" } },
        { "type": "point", "settings": { "text": "One prioritized coaching card instead of a wall of observations" } },
        { "type": "point", "settings": { "text": "One measured practice plan with a pass mark for the next clip" } }
      ]
    }
  ]
}
{% endschema %}
