<section class="sl-stats" aria-label="{{ section.settings.aria_label | default: 'The CaddieInsight practice loop' }}">
  <div class="sl-wrap">
    <ul class="sl-stats__grid sl-reveal">
      {%- for block in section.blocks -%}
        <li class="sl-stats__cell"{{ block.shopify_attributes }}>
          <span class="sl-stats__value">{{ block.settings.value }}</span>
          <span class="sl-stats__label sl-mono-label">{{ block.settings.label }}</span>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% stylesheet %}
.sl-stats {
  position: relative;
  z-index: 6;
  padding-top: clamp(36px, 5vw, 64px);
  padding-bottom: clamp(64px, 8vw, 104px);
  background: var(--sl-night);
}
.sl-stats__grid {
  margin: 0;
  padding: 0;
  list-style: none;
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 0;
  overflow: hidden;
  border: 1px solid rgba(var(--sl-cream-rgb), 0.14);
  border-radius: var(--sl-radius-lg);
  background: rgba(16, 40, 27, 0.9);
  box-shadow: 0 34px 80px -42px rgba(0, 0, 0, 0.92);
  -webkit-backdrop-filter: blur(18px);
  backdrop-filter: blur(18px);
}
.sl-stats__cell {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: var(--sl-card-inset);
  text-align: center;
}
.sl-stats__cell::before {
  content: "";
  display: block;
  width: 22px;
  height: 2px;
  margin: 0 auto 8px;
  background: var(--sl-accent);
  box-shadow: 0 0 14px rgba(var(--sl-accent-rgb), 0.44);
}
.sl-stats__value {
  color: var(--sl-cream);
  font-family: var(--sl-font-display);
  font-size: var(--sl-text-2xl);
  font-weight: 700;
  letter-spacing: -0.03em;
  line-height: 1.05;
}
.sl-stats__label {
  color: rgba(var(--sl-cream-rgb), 0.66);
  line-height: 1.5;
}

@media (min-width: 1000px) {
  .sl-stats__grid { grid-template-columns: repeat(4, 1fr); }
  .sl-stats__cell + .sl-stats__cell { border-left: 1px solid rgba(var(--sl-cream-rgb), 0.12); }
}
@media (max-width: 999px) {
  .sl-stats__cell:nth-child(even) { border-left: 1px solid rgba(var(--sl-cream-rgb), 0.12); }
  .sl-stats__cell:nth-child(n+3) { border-top: 1px solid rgba(var(--sl-cream-rgb), 0.12); }
}
@media (max-width: 749px) {
  .sl-stats { padding-top: 28px; padding-bottom: 42px; }
  .sl-stats__grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
    padding: 0;
    overflow: visible;
    border: 0;
    border-radius: 0;
    background: transparent;
    box-shadow: none;
    -webkit-backdrop-filter: none;
    backdrop-filter: none;
  }
  .sl-stats__cell:nth-child(n) {
    min-height: 136px;
    padding: var(--sl-card-inset);
    border: 1px solid rgba(var(--sl-cream-rgb), 0.14);
    border-radius: var(--sl-radius);
    background: rgba(16, 40, 27, 0.94);
  }
  .sl-stats__cell::before { width: 18px; margin-bottom: 3px; }
  .sl-stats__value { font-size: var(--sl-text-lg); }
  .sl-stats__label { font-size: var(--sl-text-xs); letter-spacing: 0.1em; line-height: 1.4; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Stats band",
  "settings": [
    { "type": "text", "id": "aria_label", "label": "Accessibility label", "default": "The CaddieInsight practice loop" }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "settings": [
        { "type": "text", "id": "value", "label": "Value", "default": "3.0:1" },
        { "type": "text", "id": "label", "label": "Label", "default": "benchmark tempo ratio" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Stats band",
      "blocks": [
        { "type": "stat", "settings": { "value": "1 priority", "label": "ranked for the club you filmed" } },
        { "type": "stat", "settings": { "value": "1 pass mark", "label": "attached to the practice plan" } },
        { "type": "stat", "settings": { "value": "Same club", "label": "required for the next comparison" } },
        { "type": "stat", "settings": { "value": "Same selected view", "label": "saved before the next comparison" } }
      ]
    }
  ]
}
{% endschema %}
