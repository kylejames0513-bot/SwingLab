<section id="{{ section.settings.anchor | default: 'how' }}" class="sl-how">
  <div class="sl-wrap sl-reveal">
    <div class="sl-how__head">
      <p class="sl-how__eyebrow">{{ 'homepage.method.eyebrow' | t }}</p>
      <div class="sl-how__intro">
        <h2 class="sl-how__title">{{ section.settings.heading | default: 'A practice loop you can repeat.' }}</h2>
        <p>{{ 'homepage.method.intro' | t }}</p>
      </div>
    </div>
    <ol class="sl-how__grid">
      {%- for block in section.blocks -%}
        <li class="sl-step"{{ block.shopify_attributes }}>
          {%- assign step_num = block.settings.number | default: forloop.index -%}
          <p class="sl-step__num">{{ step_num }}</p>
          <h3 class="sl-step__title">{{ block.settings.title }}</h3>
          <p class="sl-step__body">{{ block.settings.body }}</p>
          {%- if block.settings.caption != blank -%}
            <p class="sl-step__caption">{{ block.settings.caption }}</p>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ol>
    {%- if section.settings.footer_note != blank -%}
      <div class="sl-how__foot">
        <p class="sl-how__foot-note">{{ section.settings.footer_note }}</p>
      </div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
.sl-how {
  background: #f0eee7;
  color: var(--sl-ink);
  padding: var(--sl-section-space) 0;
}
.sl-how__head {
  padding-bottom: clamp(28px, 4vw, 48px);
  border-bottom: 1px solid #d8d3c8;
  text-align: center;
}
.sl-how__eyebrow {
  margin: 0 0 18px;
  color: var(--sl-orange);
  font-family: var(--sl-font-mono);
  font-size: 11px;
  font-weight: 500;
  letter-spacing: 0.18em;
}
.sl-how__intro {
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  gap: clamp(16px, 2vw, 22px);
  max-width: 880px;
  margin-inline: auto;
}
.sl-how__title {
  margin: 0 auto;
  max-width: 15ch;
  color: #0d2d1d;
  font-size: var(--sl-heading-display);
  font-weight: 900;
  letter-spacing: -0.05em;
  line-height: 0.96;
  text-wrap: balance;
}
.sl-how__intro > p {
  margin: 0 auto;
  max-width: 58ch;
  color: var(--sl-ink-soft);
  font-size: clamp(16px, 1.5vw, 19px);
  line-height: 1.6;
  text-align: center;
  text-wrap: pretty;
}
.sl-how__grid {
  display: grid;
  grid-template-columns: 1fr;
  grid-auto-rows: 1fr;
  align-items: stretch;
  gap: 16px;
  margin-top: clamp(30px, 4vw, 48px);
  margin-bottom: 0;
  padding: 0;
  list-style: none;
}
.sl-step {
  position: relative;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  align-items: stretch;
  justify-content: flex-start;
  height: 100%;
  min-height: 0;
  border: 1px solid #ded9ce;
  border-radius: 20px;
  padding: clamp(24px, 2.5vw, 32px);
  text-align: left;
  background: rgba(255, 253, 249, 0.86);
  box-shadow: 0 22px 48px -40px rgba(15, 42, 27, 0.42);
}
.sl-step::after {
  content: "";
  position: absolute;
  right: -50px;
  bottom: -70px;
  width: 150px;
  height: 150px;
  border: 1px solid rgba(20, 71, 44, 0.1);
  border-radius: 50%;
}
.sl-step__num {
  margin: 0;
  width: 50px;
  height: 50px;
  display: grid;
  place-items: center;
  border: 1px solid rgba(232, 114, 12, 0.32);
  border-radius: 50%;
  background: #fff7ed;
  font-family: var(--sl-font-mono);
  font-size: 15px;
  font-weight: 500;
  letter-spacing: 0.08em;
  font-variant-numeric: tabular-nums;
  color: var(--sl-orange);
  align-self: flex-start;
}
.sl-step__title {
  margin: 26px 0 10px;
  color: var(--sl-green);
  font-size: 22px;
  font-weight: 800;
  letter-spacing: -0.02em;
  text-align: left;
}
.sl-step__body {
  margin: 0;
  max-width: 34ch;
  font-size: 15.5px;
  line-height: 1.62;
  color: var(--sl-ink-soft);
}
.sl-step__caption {
  width: 100%;
  margin: auto 0 0;
  padding-top: 14px;
  border-top: 1px solid #e3ded3;
  font-family: var(--sl-font-mono);
  font-size: 10.5px;
  font-weight: 500;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: var(--sl-ink-muted);
  text-align: left;
}
.sl-step__body { margin-bottom: 0; }
.sl-how__foot {
  margin-top: 32px;
  padding-top: 24px;
  border-top: 1px solid #d8d3c8;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 18px;
  flex-wrap: wrap;
  text-align: center;
}
.sl-how__foot-note {
  margin: 0 auto;
  max-width: 70ch;
  font-size: 15px;
  line-height: 1.6;
  color: var(--sl-ink-soft);
}
@media (min-width: 768px) {
  .sl-how__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
}
@media (min-width: 1100px) {
  .sl-how__grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }
}
@media (max-width: 767px) {
  .sl-how { padding: clamp(62px, 17vw, 76px) 0; }
  .sl-how__head { padding-bottom: 26px; }
  .sl-how__eyebrow { margin-bottom: 14px; }
  .sl-how__intro { gap: 16px; }
  .sl-how__intro > p { max-width: 34ch; }
  .sl-how__grid {
    gap: 12px;
    margin-top: 24px;
  }
  .sl-step {
    align-items: center;
    padding: 24px 22px;
    text-align: center;
  }
  .sl-step__num { align-self: center; }
  .sl-step__title {
    margin: 22px 0 9px;
    text-align: center;
  }
  .sl-step__body {
    margin-inline: auto;
    max-width: 34ch;
    text-align: center;
  }
  .sl-step__caption {
    padding-top: 12px;
    text-align: center;
  }
  .sl-how__foot {
    margin-top: 24px;
    padding-top: 20px;
  }
  .sl-how__foot-note {
    max-width: 36ch;
    text-align: center;
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "How it works",
  "settings": [
    { "type": "text", "id": "anchor", "label": "Section anchor id", "default": "how" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "A practice loop you can repeat." },
    { "type": "text", "id": "footer_note", "label": "Footer note", "default": "Face-on supports movement coaching; down-the-line currently supports timing only. CaddieInsight estimates supported 2D movement and timing from phone video—not club path, face angle, launch, spin, carry, strike, or ball flight." }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "text", "id": "number", "label": "Step number", "default": "01" },
        { "type": "text", "id": "title", "label": "Title", "default": "Choose the club" },
        { "type": "textarea", "id": "body", "label": "Body", "default": "Choose the club before upload—iron, wedge, hybrid, fairway wood, or driver. It stays with the report and your next comparison, so coaching reflects the equipment you actually used." },
        { "type": "text", "id": "caption", "label": "Caption (small mono line)", "info": "Optional specimen-style label under the body." }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "How it works",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "number": "01",
            "title": "Choose the club",
            "body": "Choose the club before upload—iron, wedge, hybrid, fairway wood, or driver. It stays with the report and your next comparison, so coaching reflects the equipment you actually used.",
            "caption": "CLUB CONTEXT IS REQUIRED"
          }
        },
        {
          "type": "step",
          "settings": {
            "number": "02",
            "title": "Film a repeatable view",
            "body": "Set your phone at hip height with your full body in frame, then select face-on or down-the-line before upload. Save that setup so your next clip is genuinely comparable.",
            "caption": "MATCH THE VIEW NEXT TIME"
          }
        },
        {
          "type": "step",
          "settings": {
            "number": "03",
            "title": "Work one plan",
            "body": "CaddieInsight ranks supported findings, brings one priority forward, and pairs it with a focused drill, clear dosage, and measurable pass mark—one practical job for your next range session.",
            "caption": "ONE PRIORITY · ONE PASS MARK"
          }
        },
        {
          "type": "step",
          "settings": {
            "number": "04",
            "title": "Re-film to prove it",
            "body": "Re-film with the same club and view. CaddieInsight verifies the saved club, handedness, and selected camera angle; height, distance, and framing remain part of your setup for a fair comparison.",
            "caption": "REPEAT THE CAPTURE SETUP"
          }
        }
      ]
    }
  ]
}
{% endschema %}
