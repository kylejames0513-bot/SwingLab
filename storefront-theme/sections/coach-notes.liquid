<section class="sl-coach" aria-labelledby="CoachNotes-{{ section.id }}">
  <div class="sl-wrap sl-reveal">
    {%- assign head_eyebrow = 'homepage.coach.eyebrow' | t -%}
    {%- assign head_title = section.settings.heading | default: 'Coaching that shows its work' -%}
    {%- assign head_id = 'CoachNotes-' | append: section.id -%}
    {% render 'section-head',
      eyebrow: head_eyebrow,
      title: head_title,
      lede: section.settings.sub,
      center: true,
      heading_id: head_id
    %}

    <div class="sl-coach__grid">
      {%- for block in section.blocks -%}
        <article class="sl-coach__card"{{ block.shopify_attributes }}>
          {%- if block.settings.label != blank -%}
            <h3 class="sl-coach__label">
              <span class="sl-chip sl-chip--accent">{{ block.settings.label }}</span>
            </h3>
          {%- endif -%}
          <p class="sl-coach__quote">{{ block.settings.quote }}</p>
        </article>
      {%- endfor -%}
    </div>

    {%- if section.settings.footnote != blank -%}
      <p class="sl-coach__footnote sl-mono-label">{{ section.settings.footnote }}</p>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
.sl-coach {
  padding-top: var(--sl-section-space-compact);
  padding-bottom: var(--sl-section-space-compact);
  border-top: 1px solid var(--sl-border);
}
.sl-coach__grid {
  display: grid;
  grid-template-columns: 1fr;
  align-items: stretch;
  gap: 20px;
  margin-top: 30px;
}
.sl-coach__card {
  margin: 0;
  display: flex;
  flex-direction: column;
  align-items: stretch;
  justify-content: flex-start;
  height: 100%;
  gap: 14px;
  background: var(--sl-bg-card);
  border: 1px solid var(--sl-border);
  border-radius: var(--sl-radius-lg);
  padding: var(--sl-card-inset);
  box-shadow: var(--sl-shadow-card);
  text-align: left;
}
.sl-coach__label { align-self: center; margin: 0; line-height: 1; }
.sl-coach__quote {
  margin: 0;
  font-size: var(--sl-text-base);
  line-height: 1.62;
  color: var(--sl-ink);
  text-wrap: pretty;
}
.sl-coach__footnote {
  display: block;
  margin: 22px auto 0;
  text-align: left;
}

@media (min-width: 560px) {
  .sl-coach__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
}
@media (min-width: 560px) and (max-width: 999px) {
  .sl-coach__card:last-child:nth-child(odd) {
    grid-column: 1 / -1;
    width: calc((100% - 20px) / 2);
    justify-self: center;
  }
}
@media (min-width: 1000px) {
  .sl-coach__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
}
@media (max-width: 749px) {
  .sl-coach__card {
    align-items: center;
    text-align: center;
  }
  .sl-coach__quote {
    max-width: 42ch;
    margin-inline: auto;
    text-align: center;
  }
  .sl-coach__footnote {
    max-width: 52ch;
    text-align: center;
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Coach notes",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Coaching that shows its work" },
    { "type": "textarea", "id": "sub", "label": "Subheading", "default": "The report keeps the decision legible: which club you filmed, which supported movement comes first, what to practice, and what must match on the next clip." },
    { "type": "text", "id": "footnote", "label": "Footnote", "default": "PRODUCT FEATURES SHOWN · NOT A CUSTOMER TESTIMONIAL" }
  ],
  "blocks": [
    {
      "type": "note",
      "name": "Report note",
      "settings": [
        { "type": "text", "id": "label", "label": "Decision chip", "default": "CLUB CONTEXT" },
        { "type": "textarea", "id": "quote", "label": "Card text", "default": "An iron and a driver ask different questions. Club selection is required before upload, stays attached to the report, and gives the next comparison the same equipment context." }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Coach notes",
      "blocks": [
        {
          "type": "note",
          "settings": {
            "label": "CLUB CONTEXT",
            "quote": "An iron and a driver ask different questions. Club selection is required before upload, stays attached to the report, and gives the next comparison the same equipment context."
          }
        },
        {
          "type": "note",
          "settings": {
            "label": "ONE PRIORITY",
            "quote": "Supported findings are ranked, then one movement is brought forward with a matching drill and pass mark, so the range session has one clear job instead of scattered advice."
          }
        },
        {
          "type": "note",
          "settings": {
            "label": "MATCHED RE-FILM",
            "quote": "Use the same club and selected view, then repeat the hip-height, full-body setup so the next clip can test whether the practiced movement held under comparable capture conditions."
          }
        }
      ]
    }
  ]
}
{% endschema %}
