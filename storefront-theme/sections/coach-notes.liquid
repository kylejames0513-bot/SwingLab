<section class="sl-coach">
  <div class="sl-wrap sl-reveal">
    <div class="sl-coach__head">
      <h2 class="sl-h2">{{ section.settings.heading | default: 'Straight from the reports' }}</h2>
      {%- if section.settings.sub != blank -%}
        <p class="sl-coach__sub">{{ section.settings.sub }}</p>
      {%- endif -%}
    </div>

    <div class="sl-coach__grid">
      {%- for block in section.blocks -%}
        <figure class="sl-coach__card"{{ block.shopify_attributes }}>
          {%- if block.settings.label != blank -%}
            <figcaption class="sl-coach__label">
              <span class="sl-chip sl-chip--accent">{{ block.settings.label }}</span>
            </figcaption>
          {%- endif -%}
          <blockquote class="sl-coach__quote">{{ block.settings.quote }}</blockquote>
        </figure>
      {%- endfor -%}
    </div>

    {%- if section.settings.footnote != blank -%}
      <p class="sl-coach__footnote sl-mono-label">{{ section.settings.footnote }}</p>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
.sl-coach {
  padding-top: clamp(32px, 4.5vw, 56px);
  padding-bottom: clamp(32px, 4.5vw, 56px);
  border-top: 1px solid var(--sl-border);
}
.sl-coach__head { max-width: 72ch; }
.sl-coach__sub {
  margin: 12px 0 0;
  font-size: 16px;
  line-height: 1.55;
  color: var(--sl-ink-soft);
  max-width: 60ch;
  text-wrap: pretty;
}
.sl-coach__grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 20px;
  margin-top: 30px;
}
.sl-coach__card {
  margin: 0;
  display: flex;
  flex-direction: column;
  gap: 14px;
  background: var(--sl-bg-card);
  border: 1px solid var(--sl-border);
  border-radius: var(--sl-radius-lg);
  padding: 24px;
  box-shadow: var(--sl-shadow-card);
}
.sl-coach__label { line-height: 1; }
.sl-coach__quote {
  margin: 0;
  font-size: 15.5px;
  line-height: 1.62;
  color: var(--sl-ink);
  text-wrap: pretty;
}
.sl-coach__footnote {
  display: block;
  margin: 22px 0 0;
}

@media (min-width: 700px) {
  .sl-coach__grid { grid-template-columns: repeat(3, 1fr); }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Coach notes",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Straight from the reports" },
    { "type": "textarea", "id": "sub", "label": "Subheading", "default": "SwingLab writes its coaching notes from your measured numbers, thresholds and all. These are the kinds of lines the engine produces." },
    { "type": "text", "id": "footnote", "label": "Footnote", "default": "GENERATED BY THE ANALYSIS ENGINE — NOT WRITTEN FOR THIS PAGE" }
  ],
  "blocks": [
    {
      "type": "note",
      "name": "Report note",
      "settings": [
        { "type": "text", "id": "label", "label": "Metric chip", "default": "TEMPO 2.2:1" },
        { "type": "textarea", "id": "quote", "label": "Note text", "default": "Tempo ratio 2.2:1 is quicker than the 2.4 threshold (tour average is about 3.0:1 with a downswing near 0.25 s). Let the backswing finish before starting down." }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Coach notes",
      "blocks": [
        {
          "type": "note",
          "settings": {
            "label": "TEMPO 2.2:1",
            "quote": "Tempo ratio 2.2:1 is quicker than the 2.4 threshold (tour average is about 3.0:1 with a downswing near 0.25 s). Let the backswing finish before starting down."
          }
        },
        {
          "type": "note",
          "settings": {
            "label": "SWAY 0.42 SW",
            "quote": "Head sways 0.42 shoulder widths away from the target going back (flagged beyond 0.35). Feel like the head stays inside the trail foot at the top."
          }
        },
        {
          "type": "note",
          "settings": {
            "label": "TEMPO SD 0.12",
            "quote": "Tempo is impressively consistent across swings (std dev 0.12). Consistency like this is a real asset — low variance is itself a finding worth keeping."
          }
        }
      ]
    }
  ]
}
{% endschema %}
