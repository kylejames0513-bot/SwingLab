# Value-free inventory only. The application reads process environment
# variables; it does not load this file automatically.

# Platform and canonical origin
PORT=
SWINGLAB_SECRET=
PUBLIC_BASE_URL=

# Shopify purchase bridge and Storefront catalog
SHOPIFY_STORE_DOMAIN=
SHOPIFY_WEBHOOK_SECRET=
SHOPIFY_STOREFRONT_TOKEN=
SHOPIFY_API_VERSION=

# Optional Stripe billing
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# Optional email, monitoring, and administration
SWINGLAB_SMTP_URL=
SWINGLAB_MAIL_FROM=
SENTRY_DSN=
SWINGLAB_ADMIN_TOKEN=

# Optional Litestream backup recipe
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=
