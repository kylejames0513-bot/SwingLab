# Value-free inventory only. The application reads process environment
# variables; it does not load this file automatically.

# Platform and canonical origin
PORT=
SWINGLAB_SECRET=
PUBLIC_BASE_URL=

# Shopify purchase bridge and Storefront catalog
SHOPIFY_STORE_DOMAIN=
SHOPIFY_WEBHOOK_SECRET=
SHOPIFY_API_VERSION=

# Optional Stripe billing
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# Optional email, monitoring, and administration
RESEND_API_KEY=
SWINGLAB_SMTP_URL=
SWINGLAB_MAIL_FROM=
SWINGLAB_MAIL_TRANSPORT=
SENTRY_DSN=
SWINGLAB_ADMIN_TOKEN=

# Optional Litestream backup recipe
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=

# Inactive Stage 0B backup and scratch-restore tooling
CADDIE_BACKUP_ENABLED=
CADDIE_RESTORE_ENABLED=
CADDIE_BACKUP_BUCKET=
CADDIE_BACKUP_PREFIX=
CADDIE_BACKUP_REGION=
CADDIE_BACKUP_ENDPOINT_URL=
CADDIE_BACKUP_ADDRESSING_STYLE=
CADDIE_BACKUP_SSE=
CADDIE_BACKUP_KMS_KEY_ID=
CADDIE_BACKUP_ACCESS_KEY_ID=
CADDIE_BACKUP_SECRET_ACCESS_KEY=
CADDIE_BACKUP_SESSION_TOKEN=
CADDIE_RESTORE_ACCESS_KEY_ID=
CADDIE_RESTORE_SECRET_ACCESS_KEY=
CADDIE_RESTORE_SESSION_TOKEN=
